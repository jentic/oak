  "paths": {
    "/price/quoter/{origin}/{destination}": {
      "get": {
        "tags": [
          "price"
        ],
        "summary": "obtener precios de emisi\u00f3n por talla [cotizador]",
        "description": "Obtiene el precio basado en `origin`, `destination`; usa el servicio **bx-srv-digpay-payments**",
        "operationId": "getEmissionQuoter",
        "parameters": [
          {
            "name": "origin",
            "in": "path",
            "description": "C\u00f3digo de comuna origen",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "LFD"
          },
          {
            "name": "destination",
            "in": "path",
            "description": "C\u00f3digo de comuna destino",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "PRO"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetEmissionQuoterOk"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestPrice"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/price/emission/{origin}/{destination}/{size}": {
      "get": {
        "tags": [
          "price"
        ],
        "summary": "obtener precio de emisi\u00f3n",
        "description": "Obtiene el precio basado en `origin`, `destination`, `size`; usa el servicio **bx-srv-digpay-payments**",
        "operationId": "getEmissionPrice",
        "parameters": [
          {
            "name": "origin",
            "in": "path",
            "description": "C\u00f3digo `agencyID` o geolocalizaci\u00f3n (Punto Copec) origen",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1020"
          },
          {
            "name": "destination",
            "in": "path",
            "description": "Geolocalizaci\u00f3n del destino [direcci\u00f3n / agencia] destino",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "-35.3842344,-72.5827554"
          },
          {
            "name": "size",
            "in": "path",
            "description": "Tama\u00f1o del paquete",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "XS",
                "S",
                "M",
                "L"
              ]
            },
            "example": "XS"
          },
          {
            "name": "copecId",
            "in": "query",
            "description": "ID del usuario Copec, requerido si coupon no es nulo",
            "schema": {
              "type": "string"
            },
            "example": "copec-user-123"
          },
          {
            "name": "paymentMethod",
            "in": "query",
            "description": "M\u00e9todo de pago",
            "schema": {
              "type": "string",
              "enum": [
                "WEBPAY",
                "ONECLICK",
                "COPEC_PAY",
                "BILLETERA",
                "RECEIVER",
                "ORIG_AGENCY_PAY",
                "DEST_AGENCY_PAY"
              ]
            },
            "example": "WEBPAY"
          },
          {
            "name": "warranty",
            "in": "query",
            "description": "Valor de garant\u00eda",
            "schema": {
              "type": "number"
            },
            "example": 1000
          },
          {
            "name": "coupon",
            "in": "query",
            "description": "C\u00f3digo de cup\u00f3n",
            "schema": {
              "type": "string"
            },
            "example": "REGIONESBLUE"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetEmissionPriceOk"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestPrice"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/price/user-emissions-counter/{coupon}": {
      "get": {
        "tags": [
          "price"
        ],
        "summary": "contador de emisiones del usuario por cup\u00f3n",
        "description": "Retorna las emisiones del usuario cuando un cup\u00f3n es v\u00e1lido",
        "operationId": "validateCoupon",
        "parameters": [
          {
            "name": "coupon",
            "in": "path",
            "description": "Nombre del cup\u00f3n",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "COPECXBLUEZON"
          },
          {
            "name": "userReference",
            "in": "query",
            "description": "ID de usuario (Copec ID)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1RTWeBKdNMK2L5qxaVRr7fsCSegW0X5uP11bg73k"
          },
          {
            "name": "resetMonthly",
            "in": "query",
            "description": "Define si el cup\u00f3n se reinicia mensualmente",
            "schema": {
              "type": "string"
            },
            "example": "true"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CouponCountersOk"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestPrice"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundCoupon"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
