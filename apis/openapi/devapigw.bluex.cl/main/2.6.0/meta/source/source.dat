{
  "openapi": "3.0.3",
  "info": {
    "title": "BFF App Copec - OpenAPI 3.0",
    "description": "API de emisi\u00f3n para la App Copec por Blue Express. This version has been refactored for clarity and reusability.",
    "contact": {
      "email": "john.doe@mail.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "2.6.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/IBIANCHI_1/bff-app-copec-openapi-30/2.6.0"
  },
  "externalDocs": {
    "description": "Documentaci\u00f3n",
    "url": "http://swagger.io"
  },
  "servers": [
    {
      "url": "https://devapigw.bluex.cl/api/onbemi/app-copec/v1",
      "description": "desarrollo"
    },
    {
      "url": "https://qaapigw.bluex.cl/api/onbemi/app-copec/v1",
      "description": "pruebas"
    },
    {
      "url": "https://apigw.bluex.cl/api/onbemi/app-copec/v1",
      "description": "producci\u00f3n"
    }
  ],
  "security": [
    {
      "apikey": []
    }
  ],
  "tags": [
    {
      "name": "price",
      "description": "Operaciones relacionadas con el c\u00e1lculo de **precio** y validaci\u00f3n de **cupones**"
    },
    {
      "name": "payment",
      "description": "Operaciones relacionadas con el pago de la emisi\u00f3n **(POS + Sckuba)**"
    },
    {
      "name": "emission",
      "description": "Operaciones relacionadas a **flujos cr\u00edticos** de una emisi\u00f3n"
    }
  ],
  "components": {
    "securitySchemes": {
      "apikey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey"
      }
    },
    "schemas": {
      "ValidateEmissionPayload": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "enum": [
              "S",
              "M"
            ]
          },
          "sizeLabel": {
            "type": "string",
            "enum": [
              "peque\u00f1a",
              "mediana"
            ]
          },
          "osType": {
            "type": "string",
            "enum": [
              "reserved",
              "normal"
            ]
          },
          "shipmentSize": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ActivateEmissionPayload": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string"
          },
          "paymentUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "GetPricePayload": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "enum": [
              "S",
              "M"
            ]
          },
          "paymentMethod": {
            "type": "string"
          },
          "coupon": {
            "type": "object",
            "nullable": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "percent": {
                "type": "boolean"
              }
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "service": {
                  "type": "string"
                },
                "sla": {
                  "type": "integer"
                },
                "slaTime": {
                  "type": "string"
                },
                "slaDate": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "percentage": {
                        "type": "number"
                      },
                      "value": {
                        "type": "number"
                      },
                      "subtotal": {
                        "type": "number"
                      }
                    }
                  }
                },
                "total": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "GetEmissionQuoterPayload": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Tipo de servicio de entrega (ej. BLUE_POINT, ADDRESS)"
                },
                "sla": {
                  "type": "integer",
                  "description": "Tiempo de entrega en d\u00edas"
                },
                "slaTime": {
                  "type": "string",
                  "description": "Descripci\u00f3n legible del tiempo de entrega"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "size": {
                        "type": "string",
                        "enum": [
                          "XS",
                          "S",
                          "M",
                          "L"
                        ],
                        "description": "Tama\u00f1o del paquete"
                      },
                      "value": {
                        "type": "number",
                        "description": "Precio para este tama\u00f1o"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "GetEmissionPayload": {
        "type": "object",
        "properties": {
          "os": {
            "type": "integer",
            "description": "N\u00famero de orden de servicio (OS)."
          },
          "type": {
            "type": "string",
            "enum": [
              "reserved",
              "normal"
            ],
            "description": "Tipo de emisi\u00f3n (reservada o normal)."
          },
          "status": {
            "type": "string",
            "enum": [
              null,
              "CREATED",
              "PENDING",
              "CONFIRMED",
              "ERROR"
            ],
            "nullable": true,
            "description": "Estado actual de la emisi\u00f3n."
          },
          "metadata": {
            "type": "object",
            "description": "Metadatos adicionales de la emisi\u00f3n.",
            "properties": {
              "dropOffCode": {
                "type": "string",
                "description": "C\u00f3digo de admisi\u00f3n de paquetes [PUDOS]",
                "enum": [
                  "RULES000",
                  "RULES001",
                  "RULES004",
                  "RULES005",
                  "RULES010",
                  "RULES011",
                  "RULES012",
                  "RULES013",
                  "RULES015"
                ]
              },
              "label": {
                "type": "string",
                "nullable": true,
                "description": "Etiqueta de la emisi\u00f3n (base64)."
              }
            }
          },
          "origin": {
            "type": "object",
            "description": "Informaci\u00f3n del origen del env\u00edo.",
            "properties": {
              "street": {
                "type": "string",
                "description": "Nombre de la calle del origen."
              },
              "streetNumber": {
                "type": "integer",
                "description": "N\u00famero de la calle del origen."
              },
              "geolocation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Coordenadas geogr\u00e1ficas del origen (latitud, longitud)."
              },
              "agencyId": {
                "type": "integer",
                "description": "Identificador de la agencia de origen."
              },
              "reference": {
                "type": "string",
                "nullable": true,
                "description": "Referencia adicional para la direcci\u00f3n de origen."
              },
              "deptoOrOffice": {
                "type": "string",
                "nullable": true,
                "description": "Departamento u oficina en la direcci\u00f3n de origen."
              }
            }
          },
          "destination": {
            "type": "object",
            "description": "Informaci\u00f3n del destino del env\u00edo.",
            "properties": {
              "street": {
                "type": "string",
                "description": "Nombre de la calle del destino."
              },
              "streetNumber": {
                "type": "integer",
                "description": "N\u00famero de la calle del destino."
              },
              "geolocation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Coordenadas geogr\u00e1ficas del destino (latitud, longitud)."
              },
              "agencyId": {
                "type": "integer",
                "description": "Identificador de la agencia de destino."
              },
              "reference": {
                "type": "string",
                "nullable": true,
                "description": "Referencia adicional para la direcci\u00f3n de destino."
              },
              "deptoOrOffice": {
                "type": "string",
                "nullable": true,
                "description": "Departamento u oficina en la direcci\u00f3n de destino."
              }
            }
          },
          "shipping": {
            "type": "object",
            "description": "Detalles del env\u00edo y pago.",
            "properties": {
              "size": {
                "type": "string",
                "enum": [
                  "XS",
                  "S",
                  "M",
                  "L"
                ],
                "description": "Tama\u00f1o del paquete."
              },
              "paymentMethod": {
                "type": "string",
                "enum": [
                  "WEBPAY",
                  "ONECLICK",
                  "COPEC_PAY",
                  "BILLETERA",
                  "RECEIVER",
                  "ORIG_AGENCY_PAY",
                  "DEST_AGENCY_PAY"
                ],
                "description": "M\u00e9todo de pago utilizado."
              },
              "paymentType": {
                "type": "string",
                "enum": [
                  "PP",
                  "EPP",
                  "PEPO",
                  "PEPD",
                  "SO"
                ],
                "description": "Tipo de pago."
              },
              "amount": {
                "type": "number",
                "description": "Monto del env\u00edo."
              },
              "coupon": {
                "type": "string",
                "nullable": true,
                "description": "C\u00f3digo del cup\u00f3n aplicado."
              },
              "discount": {
                "type": "number",
                "description": "Descuento aplicado."
              },
              "isPaid": {
                "type": "boolean",
                "description": "Indica si el env\u00edo est\u00e1 pagado."
              },
              "productDetail": {
                "type": "string",
                "description": "Descripci\u00f3n del producto enviado."
              },
              "productValue": {
                "type": "number",
                "description": "Valor del producto enviado."
              },
              "shipmentSize": {
                "type": "integer",
                "description": "Tama\u00f1o del env\u00edo (Multi OS)."
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora de creaci\u00f3n de la emisi\u00f3n."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora de la \u00faltima actualizaci\u00f3n de la emisi\u00f3n."
          }
        }
      },
      "GetEmissionByTransactionIdPayload": {
        "type": "object",
        "properties": {
          "os": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "PENDING",
              "CONFIRMED",
              "ERROR"
            ]
          },
          "allowDropOff": {
            "type": "boolean"
          }
        }
      },
      "CouponCountersPayload": {
        "type": "object",
        "properties": {
          "couponEmissions": {
            "type": "integer"
          },
          "userEmissions": {
            "type": "integer"
          },
          "userEmissionsWithCoupon": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "example": {
          "statusCode": 400,
          "message": "BAD_REQUEST",
          "description": "Petici\u00f3n incorrecta, intente nuevamente"
        }
      }
    },
    "parameters": {
      "OsPath": {
        "name": "os",
        "in": "path",
        "description": "Ingrese el n\u00famero de orden (9-10 d\u00edgitos)",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 9,
          "maximum": 10
        }
      },
      "TransactionIdPath": {
        "name": "transactionId",
        "in": "path",
        "description": "Ingrese el n\u00famero de transacci\u00f3n",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Solicitud Incorrecta",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequestEmission": {
        "description": "Solicitud Incorrecta",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "get-emission-by-os-invalid-error": {
                "$ref": "#/components/examples/get-emission-by-os-invalid-error"
              },
              "get-emission-by-os-format-error": {
                "$ref": "#/components/examples/get-emission-by-os-format-error"
              }
            }
          }
        }
      },
      "BadRequestTransaction": {
        "description": "Solicitud Incorrecta",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "emission-invalid-os": {
                "$ref": "#/components/examples/error-invalid-transaction"
              }
            }
          }
        }
      },
      "NotFoundEmission": {
        "description": "No Encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 404,
              "message": "OS_NOT_EXIST",
              "description": "Orden de servicio no encontrada, verifique la OS ingresada"
            }
          }
        }
      },
      "NotFoundTransaction": {
        "description": "No Encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 404,
              "message": "TRANSACTION_NOT_EXIST",
              "description": "Transacci\u00f3n no encontrada, verifique el identificador ingresado"
            }
          }
        }
      },
      "NotFoundCoupon": {
        "description": "No Encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 404,
              "message": "COUPON_NOT_EXIST",
              "description": "Cup\u00f3n no encontrado"
            }
          }
        }
      },
      "ValidateEmissionOk": {
        "description": "Validar Orden",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 200
                },
                "payload": {
                  "$ref": "#/components/schemas/ValidateEmissionPayload"
                }
              }
            },
            "examples": {
              "emission-ciclos-ok": {
                "$ref": "#/components/examples/validate-emission-ciclos"
              },
              "emission-pudos-ok": {
                "$ref": "#/components/examples/validate-emission-pudos"
              }
            }
          }
        }
      },
      "ActivateEmissionOk": {
        "description": "Emisi\u00f3n exitosa",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 201
                },
                "message": {
                  "type": "string",
                  "example": "Orden de servicio emitida correctamente"
                },
                "payload": {
                  "$ref": "#/components/schemas/ActivateEmissionPayload"
                }
              }
            },
            "examples": {
              "activate-emission-success-epp": {
                "$ref": "#/components/examples/activate-emission-success-epp"
              },
              "activate-emission-success-pp": {
                "$ref": "#/components/examples/activate-emission-success-pp"
              }
            }
          }
        }
      },
      "GetEmissionOk": {
        "description": "Detalle de emisi\u00f3n (OS) obtenido exitosamente",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 200
                },
                "payload": {
                  "$ref": "#/components/schemas/GetEmissionPayload"
                }
              }
            },
            "examples": {
              "get-emission-by-os": {
                "$ref": "#/components/examples/get-emission-by-os"
              },
              "get-emission-by-os-reserved": {
                "$ref": "#/components/examples/get-emission-by-os-reserved"
              },
              "get-emission-by-os-payment-pending": {
                "$ref": "#/components/examples/get-emission-by-os-payment-pending"
              }
            }
          }
        }
      },
      "GetEmissionByTransactionIdOk": {
        "description": "Retorno de numero de orden (OS) y estado obtenido exitosamente por transactionId",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 200
                },
                "payload": {
                  "$ref": "#/components/schemas/GetEmissionByTransactionIdPayload"
                }
              }
            },
            "examples": {
              "get-emission-by-transactionId": {
                "$ref": "#/components/examples/get-emission-by-transactionId"
              }
            }
          }
        }
      },
      "SavePaymentOk": {
        "description": "Pago de emisi\u00f3n (OS) guardado con \u00e9xito",
        "content": {
          "application/json": {
            "example": {
              "statusCode": 201,
              "message": "Pago registrado correctamente en la Orden de servicio"
            }
          }
        }
      },
      "BadRequestPrice": {
        "description": "Solicitud Incorrecta",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 400,
              "message": "INVALID_PARAMETERS",
              "description": "Par\u00e1metros inv\u00e1lidos, verifique los datos ingresados"
            }
          }
        }
      },
      "GetEmissionQuoterOk": {
        "description": "precios de emisi\u00f3n por talla",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 200
                },
                "payload": {
                  "$ref": "#/components/schemas/GetEmissionQuoterPayload"
                }
              }
            },
            "examples": {
              "emission-quoter": {
                "$ref": "#/components/examples/get-emission-quoter"
              }
            }
          }
        }
      },
      "GetEmissionPriceOk": {
        "description": "precio de emisi\u00f3n",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 200
                },
                "payload": {
                  "$ref": "#/components/schemas/GetPricePayload"
                }
              }
            },
            "examples": {
              "emission-price": {
                "$ref": "#/components/examples/get-emission-price"
              },
              "emission-price-with-valid-coupon": {
                "$ref": "#/components/examples/get-emission-price-with-coupon"
              }
            }
          }
        }
      },
      "CouponCountersOk": {
        "description": "Contadores de emisiones por cup\u00f3n",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 200
                },
                "payload": {
                  "$ref": "#/components/schemas/CouponCountersPayload"
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Error Interno del Servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 500,
              "message": "INTERNAL_SERVER_ERROR",
              "description": "Ocurri\u00f3 un error inesperado en el servidor"
            }
          }
        }
      }
    },
    "requestBodies": {
      "emissionBody": {
        "description": "cuerpo de emisi\u00f3n (nuevo formato por lote/unidad)",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "transactionId",
                "emitter",
                "origin",
                "emissions"
              ],
              "properties": {
                "transactionId": {
                  "type": "string",
                  "description": "Identificador \u00fanico de la transacci\u00f3n."
                },
                "coupon": {
                  "type": "string",
                  "nullable": true,
                  "description": "C\u00f3digo del cup\u00f3n aplicado a la emisi\u00f3n, si existe."
                },
                "emitter": {
                  "type": "object",
                  "required": [
                    "identifier",
                    "name",
                    "phone",
                    "email",
                    "copecId"
                  ],
                  "description": "Informaci\u00f3n del emisor de la emisi\u00f3n.",
                  "properties": {
                    "identifier": {
                      "type": "string",
                      "description": "Identificador \u00fanico del emisor (RUT)."
                    },
                    "email": {
                      "type": "string",
                      "description": "Correo electr\u00f3nico del emisor."
                    },
                    "name": {
                      "type": "string",
                      "description": "Nombre completo del emisor."
                    },
                    "phone": {
                      "type": "string",
                      "description": "N\u00famero de tel\u00e9fono del emisor."
                    },
                    "copecId": {
                      "type": "string",
                      "description": "Identificador del usuario en App Copec."
                    }
                  }
                },
                "origin": {
                  "type": "object",
                  "required": [
                    "agencyId",
                    "street",
                    "streetNumber",
                    "geolocation",
                    "agencyDropOff"
                  ],
                  "description": "Informaci\u00f3n del origen del env\u00edo.",
                  "properties": {
                    "street": {
                      "type": "string",
                      "description": "Nombre de la calle del origen."
                    },
                    "streetNumber": {
                      "type": "integer",
                      "description": "N\u00famero de la calle del origen."
                    },
                    "geolocation": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "description": "Coordenadas geogr\u00e1ficas del origen (latitud, longitud)."
                    },
                    "agencyId": {
                      "type": "integer",
                      "description": "Identificador de la agencia de origen."
                    },
                    "agencyDropOff": {
                      "type": "boolean",
                      "description": "Indica si el usuario se encuentra en la agencia de origen."
                    }
                  }
                },
                "emissions": {
                  "type": "array",
                  "description": "Lista de emisiones individuales en el lote (considerar s\u00f3lo una).",
                  "items": {
                    "type": "object",
                    "required": [
                      "receiver",
                      "destination",
                      "shipping"
                    ],
                    "description": "Detalles de una emisi\u00f3n individual.",
                    "properties": {
                      "os": {
                        "type": "number",
                        "nullable": true,
                        "description": "N\u00famero de orden de servicio (OS), si ya est\u00e1 asignado (opcional)."
                      },
                      "receiver": {
                        "type": "object",
                        "required": [
                          "email",
                          "name",
                          "phone"
                        ],
                        "description": "Informaci\u00f3n del receptor del env\u00edo.",
                        "properties": {
                          "email": {
                            "type": "string",
                            "description": "Correo electr\u00f3nico del receptor."
                          },
                          "name": {
                            "type": "string",
                            "description": "Nombre completo del receptor."
                          },
                          "phone": {
                            "type": "string",
                            "description": "N\u00famero de tel\u00e9fono del receptor."
                          }
                        }
                      },
                      "destination": {
                        "type": "object",
                        "required": [
                          "agencyId",
                          "street",
                          "streetNumber",
                          "geolocation",
                          "isCustomAddress"
                        ],
                        "description": "Informaci\u00f3n del destino del env\u00edo.",
                        "properties": {
                          "street": {
                            "type": "string",
                            "description": "Nombre de la calle del destino."
                          },
                          "streetNumber": {
                            "type": "integer",
                            "description": "N\u00famero de la calle del destino."
                          },
                          "geolocation": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "description": "Coordenadas geogr\u00e1ficas del destino (latitud, longitud)."
                          },
                          "agencyId": {
                            "type": "integer",
                            "description": "Identificador de la agencia de destino."
                          },
                          "reference": {
                            "type": "string",
                            "nullable": true,
                            "description": "Referencia adicional para la direcci\u00f3n de destino."
                          },
                          "deptoOrOffice": {
                            "type": "string",
                            "nullable": true,
                            "description": "Departamento u oficina en la direcci\u00f3n de destino."
                          },
                          "isCustomAddress": {
                            "type": "boolean",
                            "description": "Indica si la direcci\u00f3n de destino es personalizada (manual)."
                          }
                        }
                      },
                      "shipping": {
                        "type": "object",
                        "required": [
                          "size",
                          "amount",
                          "paymentMethod",
                          "productDetail",
                          "productValue"
                        ],
                        "description": "Detalles del env\u00edo y pago.",
                        "properties": {
                          "size": {
                            "type": "string",
                            "enum": [
                              "XS",
                              "S",
                              "M",
                              "L"
                            ],
                            "description": "Tama\u00f1o del paquete."
                          },
                          "amount": {
                            "type": "number",
                            "description": "Monto del env\u00edo."
                          },
                          "paymentMethod": {
                            "type": "string",
                            "enum": [
                              "WEBPAY",
                              "ONECLICK",
                              "COPEC_PAY",
                              "BILLETERA",
                              "RECEIVER",
                              "ORIG_AGENCY_PAY",
                              "DEST_AGENCY_PAY"
                            ],
                            "description": "M\u00e9todo de pago utilizado."
                          },
                          "productDetail": {
                            "type": "string",
                            "description": "Descripci\u00f3n del producto enviado."
                          },
                          "productValue": {
                            "type": "number",
                            "description": "Valor del producto enviado."
                          },
                          "paymentDate": {
                            "type": "string",
                            "format": "date",
                            "description": "Fecha de pago."
                          },
                          "warranty": {
                            "type": "boolean",
                            "description": "Indica si se incluye garant\u00eda en el env\u00edo."
                          }
                        }
                      },
                      "draftCreatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "Fecha y hora de creaci\u00f3n del borrador de la emisi\u00f3n."
                      },
                      "draftUpdatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "Fecha y hora de la \u00faltima actualizaci\u00f3n del borrador de la emisi\u00f3n."
                      }
                    }
                  }
                }
              }
            },
            "examples": {
              "reserved-emission-pp": {
                "$ref": "#/components/examples/reserved-emission-pp"
              },
              "normal-emission-pp": {
                "$ref": "#/components/examples/normal-emission-pp"
              },
              "normal-emission-pp-with-coupon": {
                "$ref": "#/components/examples/normal-emission-pp-with-coupon"
              }
            }
          }
        }
      },
      "dropoffBody": {
        "description": "cuerpo de admisi\u00f3n de paquetes (OS)",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "osList"
              ],
              "properties": {
                "email": {
                  "type": "string"
                },
                "osList": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            "example": {
              "email": "copec@app.com",
              "osList": [
                6610670614,
                6610670615,
                6610670616
              ]
            }
          }
        }
      },
      "paymentBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "os",
                "paymentMethod",
                "amount",
                "date",
                "transactionId",
                "collector"
              ],
              "properties": {
                "os": {
                  "type": "number"
                },
                "paymentMethod": {
                  "type": "string",
                  "enum": [
                    "CA",
                    "CH",
                    "WP",
                    "CP",
                    "SV",
                    "DC",
                    "CC",
                    "OC",
                    "BL",
                    "BE"
                  ]
                },
                "amount": {
                  "type": "number"
                },
                "transactionId": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "collector": {
                  "type": "string",
                  "enum": [
                    "COPEC-SCKUBA"
                  ]
                }
              }
            },
            "examples": {
              "payment-method-credit": {
                "$ref": "#/components/examples/payment-method-credit"
              }
            }
          }
        }
      }
    },
