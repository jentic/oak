            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "access_level": {
                    "type": "string",
                    "enum": [
                      "readonly",
                      "members",
                      "everyone"
