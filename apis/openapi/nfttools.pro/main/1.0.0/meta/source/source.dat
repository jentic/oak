{
  "openapi": "3.0.3",
  "info": {
    "title": "NFTTOOLS API DOCS FOR SATFLOW",
    "description": "API documentation for accessing Satflow Bitcoin Ordinals & Runes marketplace via NFTTools proxy.\n\n## Backend tRPC API\nThe backend uses tRPC with batch support. Query procedures use GET with URL-encoded JSON input params.\nMutation procedures use POST with JSON body. All tRPC calls support batching via `?batch=1`.\n\n### tRPC Input Format\nFor GET queries, input is passed as URL-encoded JSON in the `input` query parameter:\n```\n?batch=1&input={\"0\":{\"json\":{...}}}\n```\nFor POST mutations, input is sent as JSON body:\n```json\n{\"json\": {...}}\n```\n\n### tRPC Response Format\nResponses are wrapped in tRPC result envelope: `{\"result\":{\"data\":{\"json\":{...}}}}`\nBatch responses return arrays of these. The `_meta.ms` field in each response indicates server processing time.\n\n## Memflow API\nREST API for mempool flow data, charts, and collection analytics.\nMemflow endpoints use a separate base URL (see per-path server overrides).\n",
    "version": "1.0.0",
    "contact": {
      "name": "Satflow",
      "url": "https://www.satflow.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/nfttools-d58/satflow/1.0.0"
  },
  "servers": [
    {
      "url": "https://nfttools.pro/satflow",
      "description": "Production server"
    },
    {
      "url": "https://nfttools.pro/kong/satflow",
      "description": "Production Kong server"
    }
  ],
  "security": [
    {
      "NFTTools_API_Key": []
    },
    {
      "NFTTools_Kong_API_Key": []
    }
  ],
  "tags": [
    {
      "name": "Address",
      "description": "Bitcoin address operations (balance, UTXOs, bidding wallet)"
    },
    {
      "name": "Authentication",
      "description": "Challenge-based wallet authentication"
    },
    {
      "name": "Collections",
      "description": "Collection metadata and details"
    },
    {
      "name": "Collection Stats",
      "description": "Collection floor prices, history, and memflow data"
    },
    {
      "name": "Inscriptions",
      "description": "Ordinal inscriptions browsing"
    },
    {
      "name": "Holders",
      "description": "Collection holder analysis"
    },
    {
      "name": "Wallet",
      "description": "Wallet contents, bids, and portfolio"
    },
    {
      "name": "Orders",
      "description": "Order management (bids, cancellations)"
    },
    {
      "name": "PSBT",
      "description": "Partially Signed Bitcoin Transaction creation and submission"
    },
    {
      "name": "Rankings & Rewards",
      "description": "Season rankings, rewards, and leaderboards"
    },
    {
      "name": "Feature Flags",
      "description": "Feature flag management"
    },
    {
      "name": "Whitelist",
      "description": "Satflow whitelist status"
    },
    {
      "name": "Favorites",
      "description": "User favorites management"
    },
    {
      "name": "BNPL",
      "description": "Buy Now Pay Later portfolio"
    },
    {
      "name": "Memflow",
      "description": "Mempool flow data and analytics"
    }
  ],
  "paths": {
    "/trpc/address.getSpendableBalance": {
      "get": {
        "tags": [
          "Address"
        ],
        "operationId": "addressGetSpendableBalance",
        "summary": "Get spendable balance for a Bitcoin address",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Spendable balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "confirmedSpendable": 0.0004,
                          "unconfirmedSpendable": 0,
                          "totalSpendable": 0.0004,
                          "spendableUtxoCount": 1,
                          "_meta": {
                            "ms": 89
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/address.listUtxos": {
      "get": {
        "tags": [
          "Address"
        ],
        "operationId": "addressListUtxos",
        "summary": "List UTXOs for a Bitcoin address",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "List of UTXOs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": [
                          {
                            "txid": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2",
                            "vout": 0,
                            "status": {
                              "confirmed": true,
                              "block_height": 850000,
                              "block_hash": "0000000000000000000abc123def456789abcdef0123456789abcdef01234567",
                              "block_time": 1700000000
                            },
                            "spend": null,
                            "value": 40000
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/address.checkDummyUtxos": {
      "get": {
        "tags": [
          "Address"
        ],
        "operationId": "addressCheckDummyUtxos",
        "summary": "Check dummy UTXOs availability for ordinal transactions",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123\",\"utxoCount\":10}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Dummy UTXO check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "address": "bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123",
                          "utxoTotal": 0,
                          "_meta": {
                            "ms": 31
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/address.getBiddingWallet": {
      "post": {
        "tags": [
          "Address"
        ],
        "operationId": "addressGetBiddingWallet",
        "summary": "Get or create multisig bidding wallet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetBiddingWalletInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bidding wallet info with multisig address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcResult"
                },
                "example": {
                  "result": {
                    "data": {
                      "json": {
                        "multiSig": {
                          "address": "bc1qmultisigescrow9xk4e2nf7h5jp0wqa8yz3m60r2tvl8c5pn7sgqqdef456",
                          "userPaymentAddress": "bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123"
                        },
                        "_meta": {
                          "ms": 12
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trpc/challenge.get": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "operationId": "challengeGet",
        "summary": "Get authentication challenge for wallet signing",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Challenge message to sign",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "challenge": "Welcome to Satflow!\n\nThis request will not trigger a blockchain transaction or cost any gas fees, and is used to verify your wallet address.\n\n[f0e1d2c3b4a596870fedcba9876543210abcdef0123456789abcdef01234567]",
                          "_meta": {
                            "ms": 1
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/challenge.verify": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "operationId": "challengeVerify",
        "summary": "Verify signed authentication challenge",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123\",\"signature\":\"AkgwRQ...\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "validity": true,
                          "publicKey": "02a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2",
                          "_meta": {
                            "ms": 10
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/collections.get": {
      "get": {
        "tags": [
          "Collections"
        ],
        "operationId": "collectionsGet",
        "summary": "Get a single collection by ID with full stats",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"collectionId\":\"bitcoin-puppets\",\"includeAttributes\":true}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Collection details with volume stats, metadata, and floor listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "id": 12,
                          "metaType": "ordinals",
                          "totalVolume": 411296836657,
                          "totalListed": 37,
                          "holderCount": 0,
                          "slug": "bitcoin-puppets",
                          "volume6h": 14376383,
                          "volume1d": 70422437,
                          "volume7d": 244747929,
                          "volume30d": 588114803,
                          "averagePrice6h": 958426,
                          "sales6h": 15,
                          "sales1d": 68,
                          "sales7d": 182,
                          "sales30d": 520,
                          "marketCap": "120.0120",
                          "floorPrice": 1200000,
                          "metadata": {
                            "_id": "60a1b2c3d4e5f6a7b8c9d0e1",
                            "id": "bitcoin-puppets",
                            "name": "Bitcoin Puppets",
