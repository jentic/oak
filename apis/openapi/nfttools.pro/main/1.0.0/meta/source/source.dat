    "/api/v1/charts": {
      "get": {
        "tags": [
          "Memflow"
        ],
        "operationId": "memflowGetCharts",
        "summary": "Get sales chart data for a collection",
        "parameters": [
          {
            "name": "metaType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ordinals",
                "runes"
              ]
            }
          },
          {
            "name": "collection",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "bitcoin-puppets"
          },
          {
            "name": "afterUnix",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 1700000000.0
          },
          {
            "name": "beforeUnix",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 1700000000
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10000
          }
        ],
        "responses": {
          "200": {
            "description": "Sales chart data with inscription details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemflowCharts"
                },
                "example": {
                  "sales": [
                    {
                      "time": 1700050000,
                      "marketplace": "magiceden",
                      "price": 1094505,
                      "inscription": {
                        "name": "Bitcoin Puppet #4924",
                        "item_id": "4924",
                        "image_url": "https://ord.satflow.com/content/abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234i0",
                        "inscription_id": "abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234i0",
                        "inscription_number": 53147828,
                        "content_type": "image/webp"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/collections": {
      "get": {
        "tags": [
          "Memflow"
        ],
        "operationId": "memflowGetCollections",
        "summary": "Get collections with volume stats and sorting",
        "parameters": [
          {
            "name": "metaType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ordinals",
                "runes"
              ]
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "volume_7d",
                "volume_24h",
                "volume_30d",
                "floor_price"
              ]
            },
            "example": "volume_7d"
          },
          {
            "name": "sortDirection",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "example": "desc"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "description": "Collection list with full volume analytics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemflowCollection"
                  }
                },
                "example": [
                  {
                    "id": 7,
                    "metaType": "ordinals",
                    "totalVolume": 556888623389,
                    "totalListed": 94,
                    "holderCount": 0,
                    "slug": "runestone",
                    "volume6h": 8444351,
                    "volume1d": 40087295,
                    "volume7d": 555243116,
                    "volume30d": 742559959,
                    "averagePrice6h": 162391,
                    "sales6h": 52,
                    "sales1d": 247,
                    "sales7d": 2759,
                    "sales30d": 4556,
                    "marketCap": "25.0000",
                    "floorPrice": 250000,
                    "mempoolVolume": 156255,
                    "metadata": {
                      "id": "runestone",
                      "name": "Runestone",
                      "image_url": "https://media.cdn.magiceden.dev/ordinals-collection-img/runestone.avif",
                      "total_items": 10000
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "NFTTools_API_Key": {
        "type": "apiKey",
        "name": "X-NFT-API-Key",
        "in": "header"
      },
      "NFTTools_Kong_API_Key": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      }
    },
    "parameters": {
      "BatchParam": {
        "name": "batch",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "description": "tRPC batch mode (always 1)"
      }
    },
    "schemas": {
      "TrpcBatchResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TrpcResult"
        }
      },
      "TrpcResult": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "json": {
                    "description": "Actual response payload"
                  }
                }
              }
            }
          }
        }
      },
      "TrpcErrorResult": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "code": {
                "type": "integer"
              },
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "NOT_FOUND",
                      "BAD_REQUEST",
                      "UNAUTHORIZED",
                      "INTERNAL_SERVER_ERROR"
                    ]
                  },
                  "httpStatus": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "GetBiddingWalletInput": {
        "type": "object",
        "required": [
          "json"
        ],
        "properties": {
          "json": {
            "type": "object",
            "required": [
              "ordinalsAddress",
              "paymentAddress",
              "paymentPubkey"
            ],
            "properties": {
              "ordinalsAddress": {
                "type": "string",
                "example": "bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123"
              },
              "paymentAddress": {
                "type": "string",
                "example": "bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123"
              },
              "paymentPubkey": {
                "type": "string",
                "description": "Hex public key",
                "example": "02a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2"
              }
            }
          }
        }
      },
      "CancelBidInput": {
        "type": "object",
        "required": [
          "json"
        ],
        "properties": {
          "json": {
            "type": "object",
            "required": [
              "makerAddress",
              "_id",
              "signature"
            ],
            "properties": {
              "makerAddress": {
                "type": "string",
                "example": "bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123"
              },
              "_id": {
                "type": "string",
                "description": "Order/bid MongoDB ID",
                "example": "507f1f77bcf86cd799439011"
              },
              "signature": {
                "type": "string",
                "description": "Wallet signature for auth"
              }
            }
          }
        }
      },
      "NonCustodialBidDepositInput": {
        "type": "object",
        "required": [
          "json"
        ],
        "properties": {
          "json": {
            "type": "object",
            "required": [
              "senderAddress",
              "senderPublicKey",
              "receiveAddress",
              "amount"
            ],
            "properties": {
              "senderAddress": {
                "type": "string",
                "example": "bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123"
              },
              "senderPublicKey": {
                "type": "string",
                "example": "02a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2"
              },
              "receiveAddress": {
                "type": "string",
                "description": "Multisig escrow address",
                "example": "bc1qmultisigescrow9xk4e2nf7h5jp0wqa8yz3m60r2tvl8c5pn7sgqqdef456"
              },
              "amount": {
                "type": "integer",
                "description": "Amount in satoshis",
                "example": 10000
              }
            }
          }
        }
      },
      "PlaceBidInput": {
        "type": "object",
        "required": [
          "json"
        ],
        "properties": {
          "json": {
            "type": "object",
            "required": [
              "price",
              "collectionSlug",
              "bidderAddress",
              "bidderTokenReceiveAddress",
              "bidderAddressPublicKey",
              "signedBiddingPSBT",
              "quantity",
              "metaType",
              "signedBiddingMessage",
              "timestamp",
              "bidExpiry",
              "signedDepositPSBTBase64",
              "signedDepositWithFeePSBTBase64"
            ],
            "properties": {
              "price": {
                "type": "integer",
                "description": "Bid price in satoshis",
                "example": 10000
              },
              "inscriptionId": {
                "type": "string",
                "description": "Specific inscription (empty for collection bids)",
                "example": ""
              },
              "collectionSlug": {
                "type": "string",
                "example": "bitcoin-puppets"
              },
              "bidderAddress": {
                "type": "string"
              },
              "bidderTokenReceiveAddress": {
                "type": "string"
              },
              "bidderAddressPublicKey": {
                "type": "string"
              },
              "signedBiddingPSBT": {
                "type": "string",
                "description": "Base64 signed PSBT"
              },
              "quantity": {
                "type": "integer",
                "example": 1
              },
              "metaType": {
                "type": "string",
                "enum": [
                  "ordinals",
                  "runes"
                ]
              },
              "signedBiddingMessage": {
                "type": "string"
              },
              "timestamp": {
                "type": "integer",
                "format": "int64",
                "description": "Unix ms"
              },
              "bidExpiry": {
                "type": "integer",
                "format": "int64",
                "description": "Expiry Unix ms"
              },
              "signedDepositPSBTBase64": {
                "type": "string"
              },
              "signedDepositWithFeePSBTBase64": {
                "type": "string"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "trait_type": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MemflowAddress": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "chain_stats": {
            "$ref": "#/components/schemas/TxoStats"
          },
          "mempool_stats": {
            "$ref": "#/components/schemas/TxoStats"
          }
        }
      },
      "TxoStats": {
        "type": "object",
        "properties": {
          "funded_txo_count": {
            "type": "integer"
          },
          "funded_txo_sum": {
            "type": "integer",
            "description": "Sum in satoshis"
          },
          "spent_txo_count": {
            "type": "integer"
          },
          "spent_txo_sum": {
            "type": "integer",
            "description": "Sum in satoshis"
          },
          "tx_count": {
            "type": "integer"
          }
        }
      },
      "MemflowCharts": {
        "type": "object",
        "properties": {
          "sales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleEntry"
            }
          }
        }
      },
      "SaleEntry": {
        "type": "object",
        "properties": {
          "time": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "marketplace": {
            "type": "string",
            "example": "magiceden"
          },
          "price": {
            "type": "integer",
            "description": "Price in satoshis"
          },
          "inscription": {
            "$ref": "#/components/schemas/InscriptionInfo"
          }
        }
      },
      "InscriptionInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bitcoin Puppet #4924"
          },
          "item_id": {
            "type": "string",
            "example": "4924"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          },
          "inscription_id": {
            "type": "string",
            "example": "abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234abcd1234i0"
          },
          "inscription_number": {
            "type": "integer",
            "example": 53147828
          },
          "content_type": {
            "type": "string",
            "example": "image/webp"
          }
        }
      },
      "MemflowCollection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "metaType": {
            "type": "string",
            "enum": [
              "ordinals",
              "runes"
            ]
          },
          "totalVolume": {
            "type": "integer",
            "description": "All-time volume in satoshis"
          },
          "totalListed": {
            "type": "integer"
          },
          "holderCount": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "lastSalePrice": {
            "type": "integer"
          },
          "volume6h": {
            "type": "integer"
          },
          "volume6hChange": {
            "type": "integer"
          },
          "volume6hChangePercent": {
            "type": "string"
          },
          "volume1d": {
            "type": "integer"
          },
          "volume1dChange": {
            "type": "integer"
          },
          "volume1dChangePercent": {
            "type": "string"
          },
          "volume7d": {
            "type": "integer"
          },
          "volume7dChange": {
            "type": "integer"
          },
          "volume7dChangePercent": {
            "type": "string"
          },
          "volume30d": {
            "type": "integer"
          },
          "volume30dChange": {
            "type": "integer"
          },
          "volume30dChangePercent": {
            "type": "string"
          },
          "averagePrice6h": {
            "type": "integer"
          },
          "averagePrice1d": {
            "type": "string"
          },
          "averagePrice7d": {
            "type": "string"
          },
          "averagePrice30d": {
            "type": "string"
          },
          "sales6h": {
            "type": "integer"
          },
          "sales1d": {
            "type": "integer"
          },
          "sales7d": {
            "type": "integer"
          },
          "sales30d": {
            "type": "integer"
          },
          "statisticsUpdatedAt": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "marketCap": {
            "type": "string"
          },
          "washTrading": {
            "type": "integer"
          },
          "floor6hChangePercent": {
            "type": "string"
          },
          "floor1dChangePercent": {
            "type": "string"
          },
          "floor7dChangePercent": {
            "type": "string"
          },
          "floor30dChangePercent": {
            "type": "string"
          },
          "mempoolVolume": {
            "type": "integer"
          },
          "floorPrice": {
            "type": "integer",
            "description": "Floor price in satoshis"
          },
          "metadata": {
            "$ref": "#/components/schemas/CollectionMetadata"
          }
        }
      },
      "CollectionMetadata": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          },
          "image_url_content_type": {
            "type": "string"
          },
          "total_items": {
            "type": "integer"
          },
          "inscription_min": {
            "type": "integer"
          },
          "inscription_max": {
            "type": "integer"
          },
          "twitter_username": {
            "type": "string",
            "nullable": true
          },
          "external_url": {
            "type": "string",
            "nullable": true
          },
          "discord_url": {
            "type": "string",
            "nullable": true
          },
          "creator_tips_address": {
            "type": "string"
          },
          "royalties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "category_attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Trait category name"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "supportsLiquidiumLoans": {
            "type": "boolean"
          }
        }
      }
    }
  }
}