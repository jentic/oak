    "/trpc/wallet.showContents": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "operationId": "walletShowContents",
        "summary": "Show wallet contents (inscriptions and runes)",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1q...\",\"connectedAddress\":\"bc1q...\",\"itemType\":\"inscription\",\"collection\":null,\"listedOnly\":false,\"bidsOnly\":false,\"direction\":\"forward\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet contents with optional filtering",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "results": {
                            "ordinals": [],
                            "runes": []
                          },
                          "pending_orders": [],
                          "nextCursor": null,
                          "_meta": {
                            "ms": 22
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/wallet.showSummary": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "operationId": "walletShowSummary",
        "summary": "Show wallet portfolio summary with rewards info",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet summary including ordinals/runes ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "results": {
                            "ordinals": [
                              {
                                "collection": {
                                  "id": null,
                                  "name": "All Ordinals",
                                  "image": null
                                },
                                "ownership": {
                                  "tokenCount": 0,
                                  "onSaleCount": 0
                                }
                              }
                            ],
                            "runes": [],
                            "listingsCount": 0,
                            "feeAnalysis": {
                              "totalFeesSaved": 0,
                              "totalMagicEdenSpent": 0,
                              "satflowTransactions": 0,
                              "magicEdenTransactions": 0
                            }
                          },
                          "_meta": {
                            "ms": 67
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/wallet.listBids": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "operationId": "walletListBids",
        "summary": "List active bids for an address",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"address\":\"bc1qexampleaddr7xmkr9t5nzg8r3hj0wdecabc123\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "List of active bids with collection metadata",
            "content": {
              "application/json": {
                "schema": {
