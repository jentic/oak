              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"type\":\"ordinals\",\"slugs\":[\"nodemonkes\"]}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Floor price data per collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trpc/collectionStats.floorHistory": {
      "get": {
        "tags": [
          "Collection Stats"
        ],
        "operationId": "collectionStatsFloorHistory",
        "summary": "Get historical floor prices",
        "description": "Returns time-series floor price data. Scale options are 6h, 1d, 7d, 30d.",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"type\":\"ordinals\",\"slug\":\"bitcoin-puppets\",\"scale\":\"1d\"}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Floor price history time series",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                },
                "example": [
                  {
                    "result": {
                      "data": {
                        "json": {
                          "slug": "bitcoin-puppets",
                          "type": "ordinals",
                          "floorHistory": [
                            {
                              "ts": 1700000000000,
                              "f": 1200000
                            },
                            {
                              "ts": 1700003600000,
                              "f": 1200000
                            }
                          ],
                          "_meta": {
                            "ms": 19
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
