      }
    },
    "/trpc/inscriptions.getInscriptions": {
      "get": {
        "tags": [
          "Inscriptions"
        ],
        "operationId": "inscriptionsGetInscriptions",
        "summary": "Get inscriptions for a collection",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"collection_id\":\"nodemonkes\",\"limit\":50,\"attributes\":null,\"unlisted\":true,\"direction\":\"forward\"},\"meta\":{\"values\":{\"attributes\":[\"undefined\"]}}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of inscriptions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                }
              }
            }
          }
        }
      }
    },
