                            "discord_url": "https://discord.gg/F2BBWn2mzP",
                            "category_attributes": [
                              {
                                "key": "Attributes",
                                "values": [
                                  {
                                    "key": "None",
                                    "count": 5159
                                  },
                                  {
                                    "key": "Cigarette",
                                    "count": 1947
                                  }
                                ]
                              }
                            ],
                            "supportsLiquidiumLoans": true
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/trpc/collections.getMany": {
      "get": {
        "tags": [
          "Collections"
        ],
        "operationId": "collectionsGetMany",
        "summary": "Get multiple collections by IDs",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{\"0\":{\"json\":{\"collectionIds\":[\"runestone\",\"nodemonkes\",\"bitcoin-puppets\"],\"includeAttributes\":false}}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of collection objects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrpcBatchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trpc/collectionStats.collectionFloors": {
      "get": {
        "tags": [
          "Collection Stats"
        ],
        "operationId": "collectionStatsCollectionFloors",
        "summary": "Get current floor prices for collections",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchParam"
          },
          {
            "name": "input",
            "in": "query",
