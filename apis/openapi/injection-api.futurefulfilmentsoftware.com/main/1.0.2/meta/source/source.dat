{
  "openapi": "3.1.0",
  "info": {
    "title": "Future Fulfilment Direct Injection - v3.1",
    "description": "This is the API spec for direct injection with Future Fulfilment in AU.\n\nAll requests must use basic authentication and require your account number as a header.",
    "version": "1.0.2",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/futurefulfilment/DirectInjectionAPI/1.0.2"
  },
  "servers": [
    {
      "url": "https://injection-api.futurefulfilmentsoftware.com/v3.1"
    }
  ],
  "tags": [
    {
      "name": "shipments",
      "description": "Create and validate shipments for carrier injection"
    },
    {
      "name": "labels",
      "description": "Label generation and label retrieval"
    },
    {
      "name": "rates",
      "description": "Get rates for a prescribed shipment"
    },
    {
      "name": "manifests",
      "description": "Manifest shipments"
    }
  ],
  "security": [
    {
      "basicAuth": [],
      "accountNumber": []
    }
  ],
  "paths": {
    "/shipments/validate": {
      "post": {
        "tags": [
          "shipments"
        ],
        "summary": "Validate a shipment request",
        "description": "Validates the shipment payload for service without creating a shipment.",
        "operationId": "validateShipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "example1": {
                  "summary": "Standard validation request",
                  "value": {
                    "serviceCode": "STD",
                    "shipmentReference": "SPY-6151097712710",
                    "brandName": "Sender Company",
                    "brandPhone": "61400000000",
                    "brandEmail": "sender@example.com",
                    "to": {
                      "name": "Receiver Name",
                      "company": "Receiver Company",
                      "line1": "2 Example St",
                      "line2": "",
                      "suburb": "Sydney",
                      "state": "NSW",
                      "postcode": "2000",
                      "country": "AU",
                      "phone": "61400000001",
                      "email": "receiver@example.com"
                    },
                    "packages": [
                      {
                        "lengthCm": 10,
                        "widthCm": 10,
                        "heightCm": 10,
                        "weightKg": 1
                      }
                    ],
                    "options": {
                      "authorityToLeave": true,
                      "signatureRequired": false,
                      "attemptRedelivery": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation completed (valid or invalid)",
            "content": {
              "application/json": {
                "examples": {
                  "valid": {
                    "summary": "Valid shipment",
                    "value": {
                      "valid": true,
                      "errors": [],
                      "warnings": []
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (malformed payload)",
            "content": {
              "application/json": {
                "examples": {
                  "valid": {
                    "summary": "Invalid shipment/request",
                    "value": {
                      "valid": false,
                      "errors": [
                        {
                          "code": "VALIDATION_ERROR",
                          "message": "Postcode is invalid for state",
                          "field": "to.postcode"
                        }
                      ],
                      "warnings": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "Your request could not be authenticated"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Forbidden",
                    "value": {
                      "message": "You do not have access to this resource"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "We ran into an error processing your request. Please try again and contact support if this error persists."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/shipments/create": {
      "post": {
        "tags": [
          "shipments"
        ],
        "summary": "Create a shipment",
        "description": "Creates a carrier shipment.\nThis call will return per-package tracking numbers.",
        "operationId": "createShipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "example1": {
                  "summary": "Basic create request with labels",
                  "value": {
                    "serviceCode": "STD",
                    "shipmentReference": "SPY-6151097712710",
                    "brandName": "Sender Company",
                    "brandPhone": "61400000000",
                    "brandEmail": "sender@example.com",
                    "to": {
                      "name": "Receiver Name",
                      "company": "Receiver Company",
                      "line1": "2 Example St",
                      "line2": "",
                      "suburb": "Sydney",
                      "state": "NSW",
                      "postcode": "2000",
                      "country": "AU",
                      "phone": "61400000001",
                      "email": "receiver@example.com"
                    },
                    "packages": [
                      {
                        "lengthCm": 10,
                        "widthCm": 10,
                        "heightCm": 10,
                        "weightKg": 1
                      }
                    ],
                    "options": {
                      "authorityToLeave": true,
                      "signatureRequired": false,
                      "attemptRedelivery": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Shipment created",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Created shipment with per-package label URLs",
                    "value": {
                      "shipmentId": "01HZGGDZFYRFDASDZZ",
                      "serviceCode": "STD",
                      "shipmentReference": "SPY-6151097712710",
                      "masterTrackingNumber": "FF-361288192",
                      "packages": [
                        {
                          "trackingNumber": "FF-361288192213921021301",
                          "trackingUrl": "https://tracking.futurefulfilment.com/track/FF-361288192213921021301",
                          "rateDetail": {
                            "shipping": 12.1,
                            "shippingExGST": 11.0,
                            "shippingGST": 1.1,
                            "fuelSurcharge": 1.32,
                            "fuelSurchargeExGST": 1.2,
                            "fuelSurchargeGST": 0.12
                          }
                        }
                      ],
                      "shippingTotal": 12.1,
                      "shippingTotalExGST": 11.0,
                      "shippingTotalGST": 1.1,
                      "fuelSurchargeTotal": 1.32,
                      "fuelSurchargeTotalExGST": 1.2,
                      "fuelSurchargeTotalGST": 0.12,
                      "currency": "AUD"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (malformed payload)",
            "content": {
              "application/json": {
                "examples": {
                  "valid": {
                    "summary": "Invalid shipment/request",
                    "value": {
                      "valid": false,
                      "errors": [
                        {
                          "code": "VALIDATION_ERROR",
                          "message": "Postcode is invalid for state",
                          "field": "to.postcode"
                        }
                      ],
                      "warnings": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "Your request could not be authenticated"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Forbidden",
                    "value": {
                      "message": "You do not have access to this resource"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "We ran into an error processing your request. Please try again and contact support if this error persists."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/shipments/{shipmentId}/void": {
      "post": {
        "tags": [
          "shipments"
        ],
        "summary": "Void a shipment",
        "description": "Voids a previously created shipment where supported by the carrier.",
        "operationId": "voidShipment",
        "parameters": [
          {
            "name": "shipmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shipment voided (or already voided)",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Voided",
                    "value": {
                      "message": "The shipment is voided"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "Your request could not be authenticated"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Forbidden",
                    "value": {
                      "message": "You do not have access to this resource"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Shipment not found",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Shipment not found",
                    "value": {
                      "message": "Shipment not found"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Cannot void in current state",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Invalid state",
                    "value": {
                      "message": "Cannot void in current state"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Unexpected error",
                    "value": {
                      "message": "Unexpected error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/labels/{shipmentId}": {
      "get": {
        "tags": [
          "labels"
        ],
        "summary": "Get label",
        "description": "Returns label URLs.",
        "operationId": "getLabels",
        "parameters": [
          {
            "name": "shipmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Label request status",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Label response",
                    "value": {
                      "url": "https://cdn.futurefulfilmentsoftware.com/example/FF-361288192213921021301-69b9756f-a8c7-4cfe-ac39-c54dd04b676d.pdf"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "Your request could not be authenticated"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Forbidden",
                    "value": {
                      "message": "You do not have access to this resource"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Shipment not found",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Shipment not found",
                    "value": {
                      "message": "Shipment not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Unexpected error",
                    "value": {
                      "message": "Unexpected error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rates": {
      "get": {
        "tags": [
          "rates"
        ],
        "summary": "Get Rate",
        "description": "Returns rates for the provided shipment details.",
        "operationId": "getRate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "example1": {
                  "summary": "Standard validation request",
                  "value": {
                    "serviceCode": "STD",
                    "shipmentReference": "SPY-6151097712710",
                    "brandName": "Sender Company",
                    "brandPhone": "61400000000",
                    "brandEmail": "sender@example.com",
                    "to": {
                      "name": "Receiver Name",
                      "company": "Receiver Company",
                      "line1": "2 Example St",
                      "line2": "",
                      "suburb": "Sydney",
                      "state": "NSW",
                      "postcode": "2000",
                      "country": "AU",
                      "phone": "61400000001",
                      "email": "receiver@example.com"
                    },
                    "packages": [
                      {
                        "lengthCm": 10,
                        "widthCm": 10,
                        "heightCm": 10,
                        "weightKg": 1
                      }
                    ],
                    "options": {
                      "authorityToLeave": true,
                      "signatureRequired": false,
                      "attemptRedelivery": false
                    }
                  }
