    "/manifests/create": {
      "post": {
        "tags": [
          "manifests"
        ],
        "summary": "Manifest shipment(s)",
        "description": "Manifests a previously created shipment where supported by the carrier.",
        "operationId": "manifestShipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "example1": {
                  "summary": "Standard validation request",
                  "value": {
                    "shipmentIDs": [
                      "01HZGGDZFYRFDASDZZ",
                      "01HZGGDZFYRFDASDZY"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipments manifested",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Manifest response",
                    "value": {
                      "manifestID": "MAN-FF-3612-342312353",
                      "manifestedShipments": [
                        "01HZGGDZFYRFDASDZZ"
                      ],
                      "erroredShipments": [
                        "01HZGGDZFYRFDASDZY"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (malformed payload)",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "No shipments were manifested"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Bad request",
                    "value": {
                      "message": "Your request could not be authenticated"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Forbidden",
                    "value": {
                      "message": "You do not have access to this resource"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Unexpected error",
                    "value": {
                      "message": "Unexpected error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "accountNumber": {
        "type": "apiKey",
        "name": "accountNumber",
        "in": "header"
      }
    }
  }
}