                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "summary": "Forbidden",
                    "value": {
                      "message": "You do not have access to this resource"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
