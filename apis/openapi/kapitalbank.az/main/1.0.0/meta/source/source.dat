{
  "openapi": "3.0.3",
  "info": {
    "title": "Marketplace & Partner Management API",
    "description": "Kapital Bank \u2014 Marketplace platformas\u0131nda partnyor v\u0259 ma\u011faza idar\u0259etm\u0259 funksionall\u0131\u011f\u0131 \u00fc\u00e7\u00fcn API s\u0259n\u0259dl\u0259\u015fm\u0259si. Bu API, LDAP autentifikasiyas\u0131, rol \u0259sasl\u0131 icaz\u0259l\u0259r (RBAC) v\u0259 t\u0259sdiq ax\u0131n\u0131n\u0131 (approve/reject/deactivate) d\u0259st\u0259kl\u0259yir.",
    "version": "1.0.0",
    "contact": {
      "name": "IT Business Analysis Team",
      "email": "itba@kapitalbank.az"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/iflingo/marketplace-partner-management-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.kapitalbank.az/marketplace/v1",
      "description": "Production"
    },
    {
      "url": "https://sandbox.kapitalbank.az/marketplace/v1",
      "description": "Sandbox"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Partner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "AzMarket MMC"
          },
          "voen": {
            "type": "string",
            "example": "1306548971"
          },
          "discount_rate": {
            "type": "number",
            "format": "float",
            "example": 7.5
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "phone_number": {
            "type": "string",
            "example": "+994502001122"
          },
          "website_url": {
            "type": "string",
            "example": "https://azmarket.az"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Marketplace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "partner_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "AzMarket Yasamal Branch"
          },
          "address": {
            "type": "string",
            "example": "Yasamal, H\u00fcseyn Cavid prospekti 112"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "inactive"
            ],
            "example": "pending"
          },
          "created_by": {
            "type": "string",
            "example": "ldap:m.shixiyev"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "modified_by": {
            "type": "string",
            "example": "ldap:a.admin"
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MarketplaceContact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "marketplace_id": {
            "type": "string",
            "format": "uuid"
          },
          "contact_type": {
            "type": "string",
            "example": "sat\u0131\u015f \u015f\u00f6b\u0259si"
          },
          "contact_number": {
            "type": "string",
            "example": "+994555551212"
          },
          "is_primary": {
            "type": "boolean",
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApprovalAction": {
        "type": "object",
        "properties": {
          "performed_by": {
            "type": "string",
            "example": "ldap:a.admin"
          },
          "performed_at": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "deactivate"
            ]
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/partners": {
      "get": {
        "summary": "B\u00fct\u00fcn partnyorlar\u0131n siyah\u0131s\u0131",
        "tags": [
          "Partners"
        ],
        "responses": {
          "200": {
            "description": "U\u011furlu cavab",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Partner"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Yeni partnyor yarat",
        "tags": [
          "Partners"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Partner"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Partnyor yarad\u0131ld\u0131"
          }
        }
      }
    },
    "/partners/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Partnyor detallar\u0131",
        "tags": [
          "Partners"
        ],
        "responses": {
          "200": {
            "description": "U\u011furlu cavab",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Partner"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Partnyor m\u0259lumat\u0131n\u0131 yenil\u0259",
        "tags": [
          "Partners"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Partner"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Yenil\u0259m\u0259 u\u011furlu oldu"
          }
        }
      },
      "delete": {
        "summary": "Partnyoru deaktiv et",
        "tags": [
          "Partners"
        ],
        "responses": {
          "204": {
            "description": "Silindi"
          }
        }
      }
    },
    "/marketplaces": {
      "get": {
        "summary": "B\u00fct\u00fcn ma\u011fazalar",
        "tags": [
          "Marketplaces"
        ],
        "responses": {
          "200": {
            "description": "U\u011furlu cavab",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Marketplace"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Yeni ma\u011faza \u0259lav\u0259 et (yaln\u0131z sat\u0131\u015f \u0259m\u0259kda\u015f\u0131)",
        "tags": [
          "Marketplaces"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Marketplace"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ma\u011faza yarad\u0131ld\u0131 v\u0259 t\u0259sdiq g\u00f6zl\u0259yir"
          }
        }
      }
    },
    "/marketplaces/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Ma\u011faza detallar\u0131",
        "tags": [
          "Marketplaces"
        ],
        "responses": {
          "200": {
            "description": "U\u011furlu cavab",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Marketplace"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Ma\u011faza m\u0259lumat\u0131n\u0131 yenil\u0259 (yaln\u0131z sat\u0131\u015f \u0259m\u0259kda\u015f\u0131)",
        "tags": [
          "Marketplaces"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Marketplace"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Yenil\u0259m\u0259 u\u011furlu oldu"
          }
        }
      }
    },
    "/marketplaces/{id}/approve": {
      "post": {
        "summary": "Ma\u011fazan\u0131 t\u0259sdiql\u0259",
        "tags": [
          "Approval Actions"
        ],
        "description": "Sat\u0131\u015f admin v\u0259 ya super admin t\u0259r\u0259find\u0259n ma\u011fazan\u0131n t\u0259sdiql\u0259nm\u0259si.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ma\u011faza u\u011furla t\u0259sdiql\u0259ndi"
          },
          "403": {
            "description": "\u0130caz\u0259 yoxdur"
          },
          "404": {
            "description": "Ma\u011faza tap\u0131lmad\u0131"
          }
        }
      }
    },
    "/marketplaces/{id}/reject": {
      "post": {
        "summary": "Ma\u011fazan\u0131 r\u0259dd et",
        "tags": [
          "Approval Actions"
        ],
        "description": "Yaln\u0131z sat\u0131\u015f admin v\u0259 ya super admin t\u0259r\u0259find\u0259n icra edilir.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "example": "M\u0259lumat natamam daxil edilib"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ma\u011faza r\u0259dd edildi"
          },
          "403": {
            "description": "\u0130caz\u0259 yoxdur"
          }
        }
      }
    },
    "/marketplaces/{id}/deactivate": {
      "post": {
        "summary": "Ma\u011fazan\u0131 deaktiv et",
        "tags": [
          "Approval Actions"
        ],
        "description": "Admin v\u0259 ya super admin t\u0259r\u0259find\u0259n ma\u011faza deaktiv edilir.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ma\u011faza deaktiv edildi"
          },
          "403": {
            "description": "\u0130caz\u0259 yoxdur"
          }
        }
      }
    },
    "/marketplaces/{id}/contacts": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Ma\u011fazaya aid \u0259laq\u0259 n\u00f6mr\u0259l\u0259ri",
        "tags": [
          "Marketplace Contacts"
        ],
        "responses": {
          "200": {
            "description": "U\u011furlu cavab",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MarketplaceContact"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Ma\u011fazaya yeni \u0259laq\u0259 n\u00f6mr\u0259si \u0259lav\u0259 et",
        "tags": [
          "Marketplace Contacts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketplaceContact"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "\u018flaq\u0259 n\u00f6mr\u0259si \u0259lav\u0259 olundu"
          }
        }
      }
    }
  }
}