{
  "openapi": "3.0.1",
  "info": {
    "title": "Inflection AI API",
    "version": "1.0.0",
    "description": "API for Inflection AI language models including chat completions, embeddings, and discovery endpoints.",
    "x-jentic-source-url": "https://developers.inflection.ai/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.inflection.ai",
      "description": "Inflection AI API"
    },
    {
      "url": "https://gateway.inf7cw9.com",
      "description": "Inflection AI Gateway (legacy)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "operationId": "chatCompletions",
        "summary": "Chat Completions",
        "description": "Chat Completions endpoint for latest Inflection models.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model to use for completion"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "system",
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "max_tokens": {
                    "type": "integer"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "stream": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful completion response"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/v1/chat/attributes": {
      "post": {
        "operationId": "chatAttributes",
        "summary": "Chat Attributes",
        "description": "Evaluates message attributes with scoring (experimental).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attribute evaluation response"
          }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "operationId": "createEmbeddings",
        "summary": "Create Embeddings",
        "description": "Generates embeddings for text inputs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Embeddings response"
          }
        }
      }
    },
    "/v1/discovery/configs": {
      "get": {
        "operationId": "getConfigs",
        "summary": "Discovery Configs",
        "description": "Lists available model configurations and their default parameters.",
        "responses": {
          "200": {
            "description": "Model configurations list"
          }
        }
      }
    },
    "/external/api/inference": {
      "post": {
        "operationId": "legacyInference",
        "summary": "Legacy Inference",
        "description": "Legacy chat API using custom format.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "context",
                  "config"
                ],
                "properties": {
                  "context": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "AI",
                            "Human",
                            "Instruction"
                          ]
                        },
                        "text": {
                          "type": "string"
                        },
                        "timestamp": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "config": {
                    "type": "string",
                    "enum": [
                      "inflection_3_pi",
                      "inflection_3_productivity"
                    ]
                  },
                  "metadata": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inference response"
          },
          "400": {
            "description": "Unexpected error"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/external/api/inference/streaming": {
      "post": {
        "operationId": "legacyInferenceStreaming",
        "summary": "Legacy Streaming Inference",
        "description": "Legacy streaming chat endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming response"
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Service Status",
        "description": "Service status endpoint.",
        "security": [],
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Inflection AI API key"
      }
    }
  }
}