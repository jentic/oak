              "longitude"
            ]
          }
        ]
      },
      "InlineKeyboardAttachment": {
        "description": "\u041a\u043d\u043e\u043f\u043a\u0438 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0438",
        "allOf": [
