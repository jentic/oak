              "user": {
                "description": "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c, \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0439 \u0438\u0437 \u0447\u0430\u0442\u0430",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/User"
                  }
                ]
              },
              "admin_id": {
                "description": "\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0434\u0430\u043b\u0438\u043b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0438\u0437 \u0447\u0430\u0442\u0430. \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c `null`, \u0435\u0441\u043b\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043f\u043e\u043a\u0438\u043d\u0443\u043b \u0447\u0430\u0442 \u0441\u0430\u043c",
                "type": "integer",
                "format": "int64",
                "readOnly": false
              },
              "is_channel": {
                "description": "\u0423\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0431\u044b\u043b \u043b\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0443\u0434\u0430\u043b\u0435\u043d \u0438\u0437 \u043a\u0430\u043d\u0430\u043b\u0430 \u0438\u043b\u0438 \u043d\u0435\u0442",
