{
  "openapi": "3.0.3",
  "info": {
    "title": "Power Automate Management API",
    "description": "Power Automate Management connector enables interaction with Power Automate Management service, including creating, editing, and updating flows.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://learn.microsoft.com/en-us/connectors/flowmanagement/",
    "contact": {
      "name": "Microsoft",
      "url": "https://make.powerautomate.com/"
    }
  },
  "servers": [
    {
      "url": "https://api.flow.microsoft.com",
      "description": "Power Automate API"
    }
  ],
  "security": [
    {
      "OAuth2": []
    }
  ],
  "tags": [
    {
      "name": "Environments",
      "description": "Environment management"
    },
    {
      "name": "Flows",
      "description": "Flow management"
    },
    {
      "name": "Admin",
      "description": "Admin operations"
    },
    {
      "name": "Connectors",
      "description": "Connector management"
    },
    {
      "name": "Connections",
      "description": "Connection management"
    }
  ],
  "paths": {
    "/providers/Microsoft.ProcessSimple/environments": {
      "get": {
        "operationId": "ListUserEnvironments",
        "summary": "List My Environments",
        "description": "List the environments you have access to.",
        "tags": [
          "Environments"
        ],
        "responses": {
          "200": {
            "description": "List of environments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Environment"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/providers/Microsoft.ProcessSimple/environments/{environmentName}/flows": {
      "get": {
        "operationId": "ListMyFlows",
        "summary": "List My Flows",
        "description": "List all flows you created in the given environment.",
        "tags": [
          "Flows"
        ],
        "parameters": [
          {
            "name": "environmentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Environment name"
          }
        ],
        "responses": {
          "200": {
            "description": "List of flows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CreateFlow",
        "summary": "Create Flow",
        "description": "Create a new flow in an environment.",
        "tags": [
          "Flows"
        ],
        "parameters": [
          {
            "name": "environmentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlowCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                }
              }
            }
          }
        }
      }
    },
    "/providers/Microsoft.ProcessSimple/environments/{environmentName}/flows/{flowName}": {
      "get": {
        "operationId": "GetFlow",
        "summary": "Get Flow",
        "description": "Get the given flow in an environment.",
        "tags": [
          "Flows"
        ],
        "parameters": [
          {
            "name": "environmentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flowName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "UpdateFlow",
        "summary": "Update Flow",
        "description": "Update the given flow in an environment.",
        "tags": [
          "Flows"
        ],
        "parameters": [
          {
            "name": "environmentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flowName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlowCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flow updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "DeleteFlow",
        "summary": "Delete Flow",
        "description": "Delete the given flow in an environment.",
        "tags": [
          "Flows"
        ],
        "parameters": [
          {
            "name": "environmentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flowName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Flow deleted"
          }
        }
      }
    },
