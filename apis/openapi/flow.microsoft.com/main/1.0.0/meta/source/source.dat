    "/providers/Microsoft.ProcessSimple/scopes/admin/environments/{environmentName}/flows/{flowName}": {
      "get": {
        "operationId": "AdminGetFlow",
        "summary": "Get Flow as Admin",
        "description": "Get the given flow from an environment you have admin access to.",
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "environmentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flowName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeFlowDefinition",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow details"
          }
        }
      }
    },
    "/providers/Microsoft.ProcessSimple/scopes/admin/environments/{environmentName}/v2/flows": {
      "get": {
        "operationId": "ListFlowsInEnvironment_V2",
        "summary": "List Flows as Admin (V2)",
        "description": "List all flows in the given environment you have admin access to.",
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "environmentName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "expandSuspensionInfo",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "includeSoftDeletedFlows",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of flows"
          }
        }
      }
    },
