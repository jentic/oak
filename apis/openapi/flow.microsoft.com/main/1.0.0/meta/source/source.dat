            "schema": {
              "type": "string"
            }
          },
          {
            "name": "triggerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flow resubmitted"
          }
