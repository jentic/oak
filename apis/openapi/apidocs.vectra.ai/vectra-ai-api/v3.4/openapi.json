  SingleHostOnlySerializerV3_3:
    properties:
      account_access_history:
        description: Returns information on the account access history for the host.
          Always returned unless the query param include_access_history is false.
        type: array
        items:
          type: object
          properties:
            id:
             type: integer
             example: 1
            uid:
              type: sting
              example: "example@domain.com"
            privilege:
              type: integer
              example: 1
            privilege_category:
              type: string
              example: Low
            last_seen: 
              type: string
              format: date-time
              example: "2025-03-06T17:07:53Z"
      campaign_summaries:
        type: array
        description: Summary of campaigns associated with the host.
        example: []
      carbon_black:
        type: object
        description: Information on the EDR Carbon Black.
          Only returned when the query param include_edrs is true.
        example:
          is_connected: false
      crowdstrike:
        type: object
        description: Information on the EDR CrowdStrike.
        example:
          is_connected: false
        x-nullable: true
      edrs:
        type: array
        description: List of EDRs associated with the host.
          Only returned when the query param include_edrs is true.
        items:
          type: string
          example: CrowdStrike
      has_shell_knocker_learnings:
        type: boolean
        description: Flags if the host has shell knocker learnings.
        example: true
      last_seen:
        description: The last seen packet capture of the host's latest host session.
        type: string
        format: date-time
      ldap:
        description: Information about the LDAP server this host came from (if applicable).
          Only retuend if the include_ldap query param is set to true.
        type: object
        example: 
          pwdLastSet: "2019-07-31 18:23:39.419313+00:00"
        x-nullable: true
      roles:
        type: array
        description: Roles associated with the host.
        items:
          type: string
          example: Proxy Server 
      service_access_history:
        description: Returns information on the access history for the host.
          Always returned unless the query param include_access_history is false.
        type: array
        items:
          type: object
          properties:
            id:
             type: integer
             example: 1
            uid:
              type: sting
              example: "lmttgt/example@domain.com"
            privilege:
              type: integer
              example: 1
            privilege_category:
              type: string
              example: Low
            last_seen: 
              type: string
              format: date-time
              example: "2025-03-06T17:07:53Z"
      suspicious_admin_learnings:
        type: object
        description: Managers and managees of a given host.
        example:
          managers_of_host: []
          host_manages: []
      shell_knocker:
        description: The list of shellknocker ports on this host.        
        type: array
        items:
          type: object
          properties:
            port:
              type: integer
              example: 53
            protocol:
              type: string
              example: dns
      vcenter:
        type: object
        description: Information on the external connector vCenter. 
          Only returned when the query param include_external is true.
        example:
          is_connected: false
        x-nullable: true
