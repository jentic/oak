  /api/v3.4/hosts/{id}/close/:
    patch:
      summary: Close Single Host
      description: |
        Host objects contain all the information related to hosts observed in the environment.

        Closing a host indicates that some remedial action was taken based upon the host.
        Active detections associated with the host will be closed resulting in the detections no longer contributing to the scoring.
      parameters:
      - description: A unique integer value identifying this host.
        in: path
        name: id
        required: true
        type: integer
      - in: body
        name: data
        required: true
        schema:
          properties:
            reason:
              description: Reason for closing the host.
              type: string
              example: remediated
              enum:
              - remediated
              - benign
          type: object
      responses:
        '200':
          description: 'Returned when a host has been closed'
          schema:
            properties:
              _meta:
                type: object
                properties:
                  level:
                    type: string
                    description: Success flag for patch.
                    example: success
                  message:
                    type: string
                    example:  Successfully closed host as remediated
              detections_closed:
                type: list
                description: The list of IDs of detections associated with the host that were closed.
                example: [123, 456, 789]
