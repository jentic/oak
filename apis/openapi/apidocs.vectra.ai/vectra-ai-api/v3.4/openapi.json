  RuleRequestBodyV3:
    type: object
    properties:
      description:
        type: string
        description: A description of the Triage rule. 
        example: Example description
      detection_category:
        type: string
        description: The original detection category. 
        example: "COMMAND & CONTROL"
      triage_category:
        type: string
        description: Custom Triage label used to categorize specified detections. 
        example: Benign Detection
      detection:
        type: string
        description: The original detection type. 
        example: "Peer-to-Peer"
      is_whitelist:
        type: boolean
        description: Flag whether the triage rule whitelists all detections for this
          activity. 
        example: false
      source_conditions:
        type: object
        x-nullable: true
        description: |
          Specifies the entity this Triage rule applies to.
          Here 'source_conditions' represents the conditions that can be applied to
          the source of a detection, including host, account, IP, and sensor.  
        example:
          OR:
            - AND:
              - ANY_OF:
                  label: "IP"
                  field: "ip"
                  values:
                  - value: "1.2.3.5"
                    label: "1.2.3.5"
                    url: null
                  groups: []
      additional_conditions:
        type: object
        description: |
          Specifies additional matching criteria for this Triage rule.
          Here 'additional_conditions' are other conditions that are different on a
          per-detection-type basis. 
        x-nullable: true
        example:
          OR:
            - AND:
              - ANY_OF:
                  label: "Domain"
                  field: "remote1_dns"
                  values:
                  - value: "test.com"
                    label: "test.com"
                    url: null
                  groups: []
  RuleSerializerV3:
    type: object
    properties:
