              type: string
              example: "email@domain.com"
            timestamp:
              type: string
              format: date-time
        type: array
      rules_to_devices_map:
        description: List of objects, each of which represents a rules file, providing
          information about which devices that ruleset is being run on, and other
          metadata about the file 
        items:
          type: object
          properties:
            uuid:
              type: string
              example: "8cc9a23f-76e4-3035-8h5f-d4728d8g3h76"
            name:
              type: string
              example: new_8_13_2023.rules
            device_serials:
              type: array
              items:
                type: string
                example: L839261748511729ceace80jh2g46f12ff
            notes:
              type: object
              properties:
                creator:
                  type: string
                  example: vectra
                description:
                  type: string
                  example: Example description
            hashsum:
              type: string
              example: f5a5fd42d16a20302798ef6ed309979b431a4a57f5a50090f1f6c4b0dff5a3b4
            timestamp:
              type: string
              format: date-time
        type: array
