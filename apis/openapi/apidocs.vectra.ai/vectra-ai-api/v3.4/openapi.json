  /api/v3.4/health/external_connectors/:
    get:
      summary: Get Health External Connectors
      description: |
        Returns health information for external connectors. 
        Includes connection status, authentication status, lockdown status, and available error states. 
        Health information can be queried for the following external connectors:     
          * Active Directory and Lockdown
          * Azure AD Lockdown
          * AWS
          * Azure
          * Google Cloud
          * Reverse DNS Lookup
          * SIEM
          * vCenter
          * Windows Event Log Ingestion
          * Zscaler Private Access (ZPA)
        
        Health information is refreshed every 10 minutes. To get health information at the current time, use the ‘live’ query parameter. If refreshing health data takes more than 30 seconds, results will be stored and can be accessed by calling the endpoint without the ‘live’ parameter.
      operationId: v3.4_health_external_connectors_list
      parameters:
      - description: Filter on connector_type. Accepts comma-separated list.
        in: query
        name: connector_type
        enum:
        - active_directory
        - azure_ad_lockdown
        - aws
        - azure
        - google_cloud
        - reverse_lookup_dns
        - siem
        - vcenter
        - windows_event_log_ingestion
        - zscaler_private_access
        required: false
        type: string
      - description: Filter on data type. Accepts a comma-separated list.
        in: query
        name: data_type
        required: false
        enum:
        - connection_status
        - lockdown_status
        - auth_status
        - error_states
        type: string
      - description: If true, will refresh health information at the current time.
        in: query
        name: live
        required: false
        type: bool
      responses:
        '400':
          description: 'Invalid query parameter or parameter value.'
          schema:
            oneOf:
