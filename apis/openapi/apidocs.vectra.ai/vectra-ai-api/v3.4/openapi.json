  /api/v3.4/accounts/{id}/close:
    patch:
      summary: Close Single Account
      description: |
        Account objects contain information related to accounts observed in the environment.

        Closing an account indicates that some remedial action was taken based upon the account.
        Active detections associated with the account will be closed resulting in the detections no longer contributing to the scoring.
      parameters:
        - in: path
          name: id
          required: true
          type: integer
        - in: body
          name: data
          required: true
          schema:
            properties:
              reason:
                description: Reason for closing the account.
                type: string
                example: remediated
                enum:
                - remediated
                - benign
            type: object
      responses:
        '400':
          description: Bad request
          schema:
            oneOf:
              - $ref: '#/definitions/Error400MissingReasonParam'
              - $ref: '#/definitions/Error400JsonParse'
        '401':
          description: 'Authentication error.'
          schema:
            $ref: '#/definitions/Error401'
        '403':
          description: 'Authorization error.'
          schema:
            $ref: '#/definitions/Error403'
        '404':
          description: 'Not found error.'
          schema:
            $ref: '#/definitions/Error404Generic'
        '413':
          description: 'Response too large error.'
          schema:
            $ref: '#/definitions/Error413'
        '422':
          description: Returned when request body is missing.
          schema:
            $ref: '#/definitions/Error422InvalidReason'
        '429':
          description: 'Too many requests error.'
          schema:
            $ref: '#/definitions/Error429'
        '500':
          description: 'Unexpected error.'
          schema:
            $ref: '#/definitions/Error500'
        '503':
          description: 'Service unavailable error.'
          schema:
            $ref: '#/definitions/Error503'
        '504':
          description: 'Time out error.'
          schema:
            $ref: '#/definitions/Error504'
        '200':
          description: 'Returned when a detection has been closed'
          schema:
            properties:
              _meta:
                type: object
                properties:
                  level:
                    type: string
                    description: Success flag for patch.
                    example: Success
                  message:
                    type: object
                    properties:
                      reason:
                        type: string
                        description: Operation message
                        example: Successfully closed account as remediated
              detections_closed:
                type: array
                items:
                  type: integer
                  description: List of detection IDs that were closed.
                example: [1, 2, 3]
      tags:
