                description: Query link to search on the detection's host over a certain timerange.
              query_link:
                type: string
                format: url
                example: https://falcon.crowdstrike.com/investigate/network/
                description: Link to the query used to search for process context data.
          date_created:
            type: string
            format: date-time
            description: The date the EDR query was created.
          query_status:
            type: string
            enum:
            - done
            - inflight
