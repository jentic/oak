      type:
        type: string
        enum:
        - aws
        - o365
        - azure-cp
        - defender
        - crowdstrike
        - sentinelone
        - network
        example:
        - o365
      connection_name:
        type: string
        example: ingest-prod-trail
      connection_id:
        type: string
        example: "k13bdhz0"
  UniqueHostObservedSerializerV3_4:
    type: object
    properties:
