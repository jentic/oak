  /api/v3.4/detections/:
    get:
      summary: Get Detection List
      description: |
        Detection objects contain all the information related to security events detected in the environment.

        Detections are grouped into one of the following categories:
        | Detection Category  | URL |
        | -------- | ------- |
        | Command & Control  | /detections?detection_category=command    |
        | Botnet | /detections?detection_category=botnet     |
        | Reconnaissance    | /detections?detection_category=reconnaissance    |
        | Lateral Movement    | /detections?detection_category=lateral    |
        | Exfiltration    | /detections?detection_category=exfiltration    |
        | Info    | /detections?detection_category=info    |

        The API query performs partial word match. For example, you can use /detections?
        detection_category=recon to query all Reconnaissance category detections.
        
        Please note that AWS imposes a 30 second timeout window for all requests. As a result, this endpoint may timeout when trying to query large amounts of complex detection data. If experiencing 504 responses, please try to adjust the number of detections returned by using the 'page_size' query parameter.

        Starting in API Version 3.4, INFO detections are filtered out by default. To include INFO detections in the response, use the include_info_category query param.

      operationId: v3.4_detections_list
      parameters:
      - $ref: '#/components/parameters/DetectionsParamsV3/ordering'
      - $ref: '#/components/parameters/DetectionsParamsV3/page'
      - $ref: '#/components/parameters/DetectionsParamsV3/page_size'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/canonicalize'
      - $ref: '#/components/parameters/DetectionsParamsV3/certainty'
      - $ref: '#/components/parameters/DetectionsParamsV3/certainty_gte'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/created_timestamp_gte'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/created_timestamp_lte'
      - $ref: '#/components/parameters/DetectionsParamsV3/description'
      - $ref: '#/components/parameters/DetectionsParamsV3/detection'
      - $ref: '#/components/parameters/DetectionsParamsV3/detection_type'
      - $ref: '#/components/parameters/DetectionsParamsV3/detection_category'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/entity_id'
      - $ref: '#/components/parameters/DetectionsParamsV3/exclude_fields'
      - $ref: '#/components/parameters/DetectionsParamsV3/fields'
      - $ref: '#/components/parameters/DetectionsParamsV3/host_id'
      - $ref: '#/components/parameters/DetectionsParamsV3/id'
      - $ref: '#/components/parameters/DetectionsParamsV3.4/include_info_category'
      - $ref: '#/components/parameters/DetectionsParamsV3/is_targeting_key_asset'
      - $ref: '#/components/parameters/DetectionsParamsV3/is_triaged'
      - $ref: '#/components/parameters/DetectionsParamsV3/last_timestamp'
      - $ref: '#/components/parameters/DetectionsParamsV3/last_timestamp_gte'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/last_timestamp_lte'
      - $ref: '#/components/parameters/DetectionsParamsV3/min_id'
      - $ref: '#/components/parameters/DetectionsParamsV3/max_id'
      - $ref: '#/components/parameters/DetectionsParamsV3/note_modified_timestamp_gte'
      - $ref: '#/components/parameters/DetectionsParamsV3.4/reason'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/src_account'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/src_account_id'
      - $ref: '#/components/parameters/DetectionsParamsV3/src_ip'
      - $ref: '#/components/parameters/DetectionsParamsV3/state'
      - $ref: '#/components/parameters/DetectionsParamsV3/tags'
      - $ref: '#/components/parameters/DetectionsParamsV3/threat'
      - $ref: '#/components/parameters/DetectionsParamsV3/threat_gte'
      - $ref: '#/components/parameters/DetectionsParamsV3.3/type'
      - name: include_info_category
        required: false
        type: boolean
        description: Boolean to include 'info' type detections. By default this is false.
        in: query
      - name: include_src_dst_groups
        required: false
        type: boolean
        description: Boolean to include source and destination groups in the response. By default this is false.
        in: query
      responses:
        '400':
          description: 'Invalid query parameter or parameter value.'
          schema:
            oneOf:
              - $ref: '#/definitions/Error400InvalidParams'
              - $ref: '#/definitions/Error400InvalidParamValue'
        '401':
          description: 'Authentication error.'
          schema:
            $ref: '#/definitions/Error401'
        '403':
          description: 'Authorization error.'
          schema:
            $ref: '#/definitions/Error403'
        '413':
          description: 'Response too large error.'
          schema:
            $ref: '#/definitions/Error413'
        '429':
          description: 'Too many requests error.'
          schema:
            $ref: '#/definitions/Error429'
        '500':
          description: 'Unexpected error.'
          schema:
            $ref: '#/definitions/Error500'
        '503':
          description: 'Service unavailable error.'
          schema:
            $ref: '#/definitions/Error503'
        '504':
          description: 'Time out error.'
          schema:
            $ref: '#/definitions/Error504'
        '200':
          description: ''
          schema:
            properties:
              count:
                type: integer
                example: 1
              next:
                format: uri
                type: string
                x-nullable: true
                example: https://VECTRA_PORTAL_URL/api/v3.4/detections?page=3&page_size=1
              previous:
                format: uri
                type: string
                x-nullable: true
                example: https://VECTRA_PORTAL_URL/api/v3.4/detections?page=1&page_size=1
              results:
                items:
                  $ref: '#/definitions/DetectionSerializerV3_4'
                type: array
            required:
