      content:
        application/json:
          schema:
            type: object
            properties:
              title:
                type: string
                description: The title of the outcome.
                example:  Benign True Positive
              category:
                type: string
                description: The outcome category.
                enum:
                - benign_true_positive
                - malicious_true_positive
                - false_positive
                - internal
                example: benign_true_positive
              builtin:
                type: boolean
                x-nullable: true
                description: Whether the outcome is a Vectra builtin outcome.
                example: false
              user_selectable:
                type: boolean
                x-nullable: true
                description: Whether the outcome can be selected by GUI users.
                example: false
