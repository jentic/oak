              type: integer
              example: 1
            privilege_category:
              type: string
              example: Low
            last_seen:
              type: string
              format: date-time
              example: "2025-03-06T16:00:00Z"
  DetectionSummary:
    type: object
    properties:
      detection_id: 
        type: integer
        example: 1
      detection_url: 
        type: string
        format: url
        example: "https://exampleurl.vectra.ai/api/v3/detections/1"
      detection_type: 
        type: string
        example: AWS Suspect External Access Granting
      detection_category: 
        type: string
        example: EXFILTRATION
      is_targeting_key_asset: 
        type: boolean
        example: false
      state: 
        type: string
        example: active
      threat: 
        type: integer
        example: 90
      certainty: 
        type: integer
        example: 10
      is_triaged: 
        type: boolean
        example: false
      tags: 
        type: array
        items: 
          type: string
          example: Example tag
      summary: 
        type: object
        example: 
          event_names:
          - UpdateAssumeRolePolicy
          num_events: 5
          src_external_hosts:
            - ip: 100.100.100.100
              name: null
          identity_type: "AWS External Account"
          assumed_roles:
          - developers
          user_agents:
          - "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)"
          aws_account_ids: 123456789012
          aws_regions: us-east-1
          description: "AWS control plane APIs enabled external access to AWS resources through an IAM role."
      assigned_to: 
        type: string
        example: "email@domain.com"
      assigned_date: 
        type: string
        format: date-time
        example: "2025-03-05T21:53:01Z"
  DataSource:
    type: object
