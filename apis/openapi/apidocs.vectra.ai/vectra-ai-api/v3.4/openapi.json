  /api/v3.4/events/health/:
    get:
      summary: Get Health Events
      description: |
        Health Events are generated when health checks are performed on your appliance, sensors, and cloud connectors.
        Cloud connector health events are available for AWS, Azure, O365, CrowdStrike, Defender, and SentinelOne connectors.
        Example URL to retrieve health events from the last checkpoint is
        `https://VECTRA_PORTAL_URL/api/v3.4/events/health?from=101`.
        Example URL to retrieve cloud connector health events:
        `https://VECTRA_PORTAL_URL/api/v3.4/events/health?entity_type=cloud/aws/connector&health_check_name=cloud/connector-state`.
      operationId: v3.4_events_health_list
      tags:
        - v3.4/events
      parameters:
        - name: event_timestamp_gte
          in: query
          description: Filter on event timestamps greater than or equal to the provided time. (UTC) in ISO-8601 format (ex. 2019-08-27T20:55:29Z)
          required: false
          type: string
          format: date-time
        - name: event_timestamp_lte
          in: query
          description: Filter on event timestamps less than or equal to the provided time. (UTC) in ISO-8601 format (ex. 2019-08-27T20:55:29Z)
          required: false
          type: string
          format: date-time
        - name: from
          in: query
          description: Filter to provide a checkpoint for event ids. Depending on ordering scheme, returns ids greater than or less than the value, inclusive.
          required: false
          type: integer
          minimum: 1
        - name: limit
          in: query
          description: Maximum number of results to return (overrides pagination, must be > 0).
          required: false
          type: integer
          minimum: 1
        - name: ordering
          in: query
          description: Which field to use when ordering the results.
          required: false
          type: string
          enum:
            - event_timestamp
            - -event_timestamp
            - event_health_check_name
            - -event_health_check_name
