                name:
                  type: string
                  example: V9e15efry3b8934123b8d3e66b79ghj45
                serial_number:
                  type: string
                  example: V9e15efry3b8934123b8d3e66b79ghj45
                luid:
                  type: string
                  example: "h9ki54x5"
                ip_address:
                  type: string
                  example: 100.100.100.100
                  format: ipv4
      sensors:
