swagger: '2.0'
info:
  contact:
    email: support@vectra.ai
  description: |
    ## Overview

    A REST API is available for administrators and developers to integrate
    Vectra's breach detection data into their applications.
    Vectra RESTful API provides access to security event data, platform configuration,
     and health information via URI paths.

    Vectra REST API is based on open standards.
    You can use any web development language to access
     and retrieve information via the API. A common use-case would be to retrieve security event information
     generated by the Vectra platform and supply this information to a security operations dashboard or
     incident response and ticketing systems.

    The REST API can be accessed via HTTPS connection to the interface IP address of the Vectra brain.
     The data in the response to the API query is in JSON format.

    Examples of security event data that can be integrated into your application:

      * Security event type detected
      * Account information associated with the security event
      * Severity of the Account activities

    The Vectra REST API is accessible using OAuth2 authentication.

    ## Security Detection Data

    The "Detections" and "Accounts" elements retrieve security events that can be inserted into external
    applications. The REST API provides filtering options to extract data. Advanced parsing of the data can
    be performed after data has been retrieved and saved into your target application. Order of the response
    data returned is latest first.
  license:
    name: Proprietary
  termsOfService: https://www.vectra.ai/legal/terms-of-service
  title: REST API Documentation
  version: v3.4
servers:
- url: https://{apiBaseUrl}/
  variables:
    apiBaseUrl:
      default: VECTRA_PORTAL_URL
      description: The FQDN or IP for the specific Vectra tenant you want to use for
        testing.
basePath: /api
consumes:
- application/json
produces:
- application/json
schemes:
- https
security:
- OAuth2: []
securityDefinitions:
  Basic:
    type: basic
  OAuth2:
    authorizationUrl: https://VECTRA_PORTAL_URL/oauth2/token
    flow: application
    scopes:
      read: Grants read access
    tokenUrl: https://VECTRA_PORTAL_URL/oauth2/token
    type: oauth2
paths:
  /oauth2/token:
    post:
      summary: Create Oauth2 Token
      consumes:
      - application/x-www-form-urlencoded
      description: |
        Endpoint for retrieving authentication token.

        This endpoint uses HTTP Basic Authentication. The username and password must be base64 encoded
        and included in the Authorization header as: `Authorization: Basic <base64(username:password)>`
        
        Example:
        - Username: `myuser`
        - Password: `mypassword`
        - Base64 encoded credentials: `bXl1c2VyOm15cGFzc3dvcmQ=`
        - Authorization header: `Authorization: Basic bXl1c2VyOm15cGFzc3dvcmQ=`
        
        Note: The base64 encoding should be of the format `username:password` (with a colon separator).

        Refer to the Resource tab for more information on authentication.
      operationId: oauth2_token
      parameters:
      - default: client_credentials
        description: The authorization grant used to obtain a new access token.
        enum:
        - refresh_token
        - client_credentials
        in: formData
        name: grant_type
        required: true
        example: client_credentials
      - name: refresh_token
        in: formData
        type: string
        x-nullable: true
        example: null
      responses:
        '401':
          description: 'Authentication error.'
          schema:
            $ref: '#/definitions/Error401'
        '400':
          description: 'Invalid input error.'
          schema:
            $ref: '#/definitions/Error400Ouath2'
        '429':
          description: 'Too many requests error.'
          schema:
            $ref: '#/definitions/Error429'
        '500':
          description: 'Unexpected error.'
          schema:
            $ref: '#/definitions/Error500'
        '503':
          description: 'Service unavailable error.'
          schema:
            $ref: '#/definitions/Error503'
        '504':
          description: 'Time out error.'
          schema:
            $ref: '#/definitions/Error504'
        '200':
          description: ''
          schema:
            oneOf:
              - type: object
                title: Client credentials response
                description: The response for requests with client credentials as the grant type. 
                properties:
                  access_token:
                    type: string
                    description: Auth access token. 
                  expires_in:
                    type: integer
                    description: The seconds until the access token expires. 
                  refresh_expires_in:
                    type: integer
                    description: The seconds until the refresh token expires. 
                  refresh_token:
                    type: string
                    description: Auth refresh token.
                  token_type:
                    type: string
                    description: The token type, returns a value of Bearer. 
              - type: object
                title: Refresh token response
                description: The response for requests with refresh token as the grant type. 
                properties:
                  access_token:
                    type: string
                    description: Auth access token. 
                  expires_in:
                    type: integer
                    description: The seconds until the access token expires. 
                  token_type:
                    type: string
                    description: The token type, returns a value of Bearer. 
      security:
      - Basic: []
      tags:
      - auth
