        format: date-time
        description: Starting month of data list.
        example: '2024-11'
      end: 
        name: end
        in: query
        type: string
        format: date-time
        description: Ending month of data list.
        example: '2025-01'
      offset:  
        name: offset
        in: query
        type: string
        description: |
          The timezone offset applied to the start and end dates queried for host counts. 
          The value must be in ISO 8601 format (+HHMM or -HHMM), representing the difference from UTC.  
        example: '+0500'
