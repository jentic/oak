  SAMLProfileSerializerV3_4:
    properties:
      id:
        description: The unique identifier of the SAML profile.
        type: integer
        readOnly: true
        example: 1
      profile_name:
        description: The display name of the SAML profile.
        type: string
        readOnly: false
        example: "Corporate SSO"
      sp_entity_identifier:
        description: The Service Provider entity identifier. This is used to configure SAML on the Identity Provider side.
        type: string
        readOnly: true
        example: "urn:amazon:cognito:sp:us-west-2_XXXXXXXXX"
      sp_acs_url:
        description: The Service Provider ACS URL. This is used to configure SAML on the Identity Provider side.
        type: string
        readOnly: true
        example: "https://vui-XXXX.auth.us-west-2.amazoncognito.com/saml2/idpresponse"
      idp_metadata_url:
        description: The URL to fetch IdP metadata. This is provided by the Identity Provider.
        type: string
        readOnly: true
        example: "https://idp.example.com/metadata"
      last_login:
        description: The most recent login timestamp for any user via this SAML profile.
        format: date-time
        type: string
        readOnly: true
        x-nullable: true
        example: "2025-03-04T16:00:00Z"
      user_count:
        description: The number of users seen logging in with this SAML profile.
        type: integer
        readOnly: true
        example: 10
      domains:
        description: List of email domains associated with this SAML profile.
        type: array
        items:
          type: string
        readOnly: false
        example: ["example.com", "corp.example.com"]
    type: object
