                    type: string
                    description: IP address of the proxy
                    example: 192.168.1.1
                    required: true
                  considerProxy:
                    type: boolean
                    description: Whether to consider the object as a proxy or not. Proxies auto detected by Cognito which have source value as "Cognito" will always have this field set to "true". User defined proxies can be "true" or "false"
