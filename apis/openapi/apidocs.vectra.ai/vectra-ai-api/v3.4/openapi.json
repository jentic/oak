            $ref: '#/definitions/Error401'
        '403':
          description: 'Authorization error.'
          schema:
            $ref: '#/definitions/Error403'
        '429':
          description: 'Too many requests error.'
          schema:
            $ref: '#/definitions/Error429'
        '500':
          description: 'Unexpected error.'
          schema:
            $ref: '#/definitions/Error500'
        '200':
          description: ''
          schema:
            properties:
              count:
                type: integer
              next:
                format: uri
                type: string
                x-nullable: true
              previous:
                format: uri
                type: string
                x-nullable: true
              results:
                items:
                  $ref: '#/definitions/SAMLProfileSerializerV3_4'
                type: array
            required:
            - count
            - results
            type: object
      tags:
      - v3.4/configuration/saml_profiles
    post:
      summary: Create SAML Profile
      description: |
        Create a new SAML profile with profile name, IdP metadata URL, and domains.
        At least one domain is required per profile. Domains may not be associated with more than one profile at a time.
        A maximum of 10 profiles at one time is enforced.

        **Note** about configuring multiple SAML profiles:
        Legacy SAML Profiles do not require domains to be specified; **however**, when a second profile is configured along an existing profile, **both profiles need at least one domain configured for SSO to function.** 

        Please configure domains for existing profiles when using more than one SAML profile for SSO.
      operationId: v3.4_configuration_saml_profiles_create
      parameters:
        - in: body
          name: body
          required: true
          schema:
            type: object
            required:
            - profile_name
            - metadata_url
            - domains
            properties:
              profile_name:
                type: string
                description: Display name for the SAML profile.
                example: "Corporate SSO"
              metadata_url:
                type: string
                format: uri
                description: HTTPS URL to the IdP metadata XML. This is provided by the Identity Provider. 
                example: "https://idp.example.com/metadata.xml"
              domains:
                type: string
                description: Email domains associated with this profile. At least one is required per profile. Domains may not be associated with more than one profile at a time.
                example: "example.com, corp.example.com"
      responses:
        '201':
          description: 'SAML profile created.'
          schema:
            $ref: '#/definitions/SAMLProfileSerializerV3_4'
        '400':
          description: 'Bad request or validation error.'
          schema:
            type: object
            properties:
              profile_name:
                type: array
                items:
                  type: string
              metadata_url:
                type: array
                items:
                  type: string
              domains:
                type: array
                items:
                  type: string
              _meta:
                type: array
                items:
                  type: string
        '401':
          description: 'Authentication error.'
          schema:
            $ref: '#/definitions/Error401'
        '403':
          description: 'Authorization error.'
          schema:
            $ref: '#/definitions/Error403'
        '409':
          description: 'SAML profile limit reached (maximum number of profiles already exist).'
          schema:
            type: object
            properties:
              _meta:
                type: array
                items:
                  type: string
            example:
              _meta: ["Maximum number of SAML profiles reached."]
        '422':
          description: 'Validation error (e.g. invalid profile name, duplicate domains).'
          schema:
            type: object
            properties:
              profile_name:
                type: array
                items:
                  type: string
              domains:
                type: array
                items:
                  type: string
        '429':
          description: 'Too many requests error.'
          schema:
            $ref: '#/definitions/Error429'
        '500':
          description: 'Unexpected error.'
          schema:
            $ref: '#/definitions/Error500'
      tags:
      - v3.4/configuration/saml_profiles
      consumes:
      - application/json
      produces:
      - application/json
