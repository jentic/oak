        description: List of detection summaries associated with the host. This is only included when 
          the param include_detection_summaries is set to true.
        type: array
        items: 
          $ref: '#/definitions/DetectionSummary'
          example: 
            detection_id: 1
            detection_url: "https://exampleurl.vectra.ai/api/v3.3/detections/1"
            detection_type: "Novel External Destination Port"
            detection_category: "INFO"
            is_targeting_key_asset: false
            state": "active"
            threat: 0
            certainty: 0
            is_triaged: false
            tags: []
            summary:
              target_domains: []
              dst_ips:
                - 100.100.100.100
              protocol_ports:
                - udp:8080
              description: "This host was seen making an outbound connection on a destination port that is rare for the environment and lasted longer than 5 minutes."
            assigned_to: null
            assigned_date: null
      groups:
        description: List of groups associated with the host. 
        items:
          $ref: '#/definitions/GroupDetections'
          example:
            id: 100
            name: Example host group
            description: Example description
            last_modified: "2024-01-23T21:22:49Z"
            last_modified_by: "email@domain.com"
            type: host
        type: array
      has_active_traffic:
        description: Whether a host has active traffic. 
        type: boolean
        example: true
      has_custom_model:
        description: Whether the host has a custom model. 
        type: boolean
        example: false
      host_artifact_set:
        description: A list of associated artifacts. 
        items:
          $ref: '#/definitions/HostArtifact'
        type: array
      host_luid:
        description: Luid associated with host. 
        type: string
        example: "KLOZdusj"
      host_session_luids:
        description: List of luids for corresponding host sessions. 
        items:
          type: string
          example: Bt972vKL
        type: array
      id:
        description: Host id.
        type: integer
        example: 1
        minimum: 1
      ip:
        description: IP address for the host. 
        type: string
        format: ipv4
        example: 100.100.100.100
      is_key_asset:
        description: Whether the host is a key asset. 
        type: boolean
        example: false
      is_targeting_key_asset:
        description: Whether the host is targeting a key asset. 
        type: boolean
        example: false
      key_asset:
        description: Whether the host is a key asset. 
        type: boolean
        example: false
      last_detection_timestamp:
        description: Last detection activity from this host.
        format: date-time
        type: string
        example: '2025-03-03T10:46:38Z'
      last_modified:
        description: Time the host was last modified. 
        format: date-time
        type: string
        example: '2025-03-03T10:46:38Z'
      last_source:
        description: Last source IP associated with host. 
        type: string
        example: 100.100.100.100
      name:
        description: The name associated with the host.    
        type: string
        example: "jl-lopspec-12"
      note:
        description: Note attached to the host. 
        type: string
        example: Example note
      note_modified_by:
        description: Last user to modify note for host. 
        type: string
        example: "email@domain.com"
      note_modified_timestamp:
        description: Last time the note was modified.
        format: date-time
        type: string
        example: '2025-03-03T10:46:38Z'
      notes:
        description: A list of all notes on the host. List of Note objects.
        items:
          $ref: '#/definitions/NoteSerializerV2_2'
        type: array
      past_assignments:
        description: List of past assignments. 
        items:
          $ref: '#/definitions/Assignment'
          example: 
            id: 100
            assigned_by: 
              username: "email@domain.com"
              id: 20
            date_assigned: "2024-10-23T16:09:36Z"
            date_resolved: "2025-01-15T07:37:54Z"
            events:
              assignment_id: 100
              actor: 50
              event_type: resolved
              datetime: "2025-01-15T07:37:54Z"
              context:
                entity_t_score: 100
                entity_c_score: 85
                to: 26
              outcome:
                id: 1
                builtin: true 
                user_selectable: true 
                title: "Benign True Positive"
                category: benign_true_positive
              resolved_by:
                id: 20
                username: "email@domain.com"
              triaged_detections: []
              host_id: 1
              account_id: null
              assigned_to:
                username: "email@domain.com"
                id: 20
        type: array
      previous_ips:
        description: Previously associated IP addresses. 
        items:
          type: string
          example: 101.101.101.101
          format: ipv4
        type: array
      privilege_category:
        description: A string to represent how privileged this host is, related
          to privilege level. Either Low (1-2), Medium (3-7), or High (8-10).
        type: string
        enum:
        - Low
        - Medium
        - High
        example: Low
      privilege_level:
        description: An integer from 1-10 to represent how privileged this host
          is. 
        type: integer
        example: 1
        minimum: 1
        maximum: 10
      probable_owner:
        description: User associated with host. 
        type: string
        example: "email@domain.com"
      sensor:
        description: Sensor associated with host. 
        type: string
        example: fLJrtq7u
      sensor_name:
        description: Name of the associated sensor. 
        type: string
        example: Vectra Z
      severity:
        description: Host severity, e.g., 'Low', 'Medium', 'High'. 
        type: string
        example: Low
        enum:
        - Low
        - Medium
        - High
      state:
        description: State of the host, e.g., 'active' or 'inactive'. 
        type: string
        example: active
        enum:
        - active
        - inactive
      t_score:
        description: Same as 'threat'. 
        type: integer
        example: 10
        minimum: 0
        maximum: 100
      tags:
        description: User-defined tags added to the host. 
        items:
          type: string
          example: Example tag
        type: array
      targets_key_asset:
        description: Whether host is targeting a key asset. 
        type: boolean
        example: false
      threat:
        description: The calculated threat level of the host. 
        type: integer
        example: 10
        minimum: 0
        maximum: 100
      url:
        description: The URL link directly to this host. 
        type: string
        example: "https://exampleurl.vectra.ai/api/v3.x/hosts/1"
    type: object
  LockdownSerializerV3_4:
    properties:
      entity_id:
        description: ID of related entity. 
        type: integer
        example: 1
        minimum: 1
      entity_name:
        description: Name of related entity. 
        type: string
        example: "jl-lopspec-12"
      id:
        description: Autoincrementing ID. 
        type: integer
        example: 1
        minimum: 1
      locked_by:
        description: User who issued the lockdown.
        type: string
        example: "email@domain.com"
      lock_event_timestamp:
        description: Time when lockdown occurred. 
        format: date-time
        type: string
        example: "2025-03-04T16:00:00Z"
      type:
        description: Type of related entity. 
        type: string
        example: host
      unlock_event_timestamp:
        description: Time when lockdown expires. 
        format: date-time
        type: string
        example: "2025-03-06T16:00:00Z"
