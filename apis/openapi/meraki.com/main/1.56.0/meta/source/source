        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "asNumber": 64515,
                  "enabled": true,
                  "ibgpHoldTimer": 120,
                  "neighbors": [
                    {
                      "allowTransit": true,
                      "authentication": {
                        "password": "abc123"
                      },
