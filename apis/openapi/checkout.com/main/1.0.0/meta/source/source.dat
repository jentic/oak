{
  "openapi": "3.0.3",
  "info": {
    "title": "Checkout.com Payment Platform API",
    "description": "Checkout.com is a comprehensive payment platform API that enables merchants to accept payments, manage customers, handle disputes, issue cards, and orchestrate complex payment workflows. It supports multiple payment methods including cards, mobile wallets, bank transfers, and alternative payment methods across global markets.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api-reference.checkout.com/"
  },
  "servers": [
    {
      "url": "https://api.checkout.com",
      "description": "Production"
    },
    {
      "url": "https://api.sandbox.checkout.com",
      "description": "Sandbox"
    }
  ],
  "security": [
    {
      "SecretApiKey": []
    }
  ],
  "paths": {
    "/tokens": {
      "post": {
        "operationId": "requestToken",
        "summary": "Request a payment token",
        "description": "Exchange card details or digital wallet payment data for a reference token that can be used to request a payment.",
        "tags": ["Tokens"],
        "security": [
          {
            "PublicApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["card", "applepay", "googlepay"],
                    "description": "The type of token to create"
                  },
                  "number": {
                    "type": "string",
                    "description": "The card number (required for card type)"
                  },
                  "expiry_month": {
                    "type": "integer",
                    "description": "The expiry month of the card"
                  },
                  "expiry_year": {
                    "type": "integer",
                    "description": "The four-digit expiry year of the card"
                  },
                  "cvv": {
                    "type": "string",
                    "description": "The card verification value"
                  },
                  "name": {
                    "type": "string",
                    "description": "The cardholder name"
                  },
                  "billing_address": {
                    "$ref": "#/components/schemas/Address"
                  },
                  "phone": {
                    "$ref": "#/components/schemas/Phone"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "expires_on": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expiry_month": {
                      "type": "integer"
                    },
                    "expiry_year": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "scheme": {
                      "type": "string"
                    },
                    "last4": {
                      "type": "string"
                    },
                    "bin": {
                      "type": "string"
                    },
                    "card_type": {
                      "type": "string"
                    },
                    "card_category": {
                      "type": "string"
                    },
                    "issuer": {
                      "type": "string"
                    },
                    "issuer_country": {
                      "type": "string"
                    },
                    "product_id": {
                      "type": "string"
                    },
                    "product_type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid card details or missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments": {
      "post": {
        "operationId": "requestPayment",
        "summary": "Request a payment",
        "description": "Send a payment request to charge a payment source (token, card, customer, or instrument).",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["source", "currency"],
                "properties": {
                  "source": {
                    "type": "object",
                    "description": "The payment source",
                    "required": ["type"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "The payment source type (token, id, card, customer)"
                      },
                      "token": {
                        "type": "string",
                        "description": "The token (for token source type)"
                      },
                      "id": {
                        "type": "string",
                        "description": "The source or customer ID"
                      },
                      "number": {
                        "type": "string",
                        "description": "Full card number (for card source type)"
                      },
                      "expiry_month": {
                        "type": "integer"
                      },
                      "expiry_year": {
                        "type": "integer"
                      },
                      "cvv": {
                        "type": "string"
                      }
                    }
                  },
                  "amount": {
                    "type": "integer",
                    "description": "The payment amount in minor units of the currency"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Three-letter ISO 4217 currency code",
                    "minLength": 3,
                    "maxLength": 3
                  },
                  "payment_type": {
                    "type": "string",
                    "enum": ["Regular", "Recurring", "MOTO", "Installment", "Unscheduled"],
                    "description": "The type of payment"
                  },
                  "reference": {
                    "type": "string",
                    "description": "A reference for the payment"
                  },
                  "description": {
                    "type": "string",
                    "description": "A description of the payment"
                  },
                  "capture": {
                    "type": "boolean",
                    "description": "Whether to capture the payment automatically",
                    "default": true
                  },
                  "capture_on": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp to capture the payment"
                  },
                  "customer": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  "billing_descriptor": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      }
                    }
                  },
                  "shipping": {
                    "type": "object",
                    "properties": {
                      "address": {
                        "$ref": "#/components/schemas/Address"
                      },
                      "phone": {
                        "$ref": "#/components/schemas/Phone"
                      }
                    }
                  },
                  "3ds": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "attempt_n3d": {
                        "type": "boolean"
                      },
                      "eci": {
                        "type": "string"
                      },
                      "cryptogram": {
                        "type": "string"
                      },
                      "xid": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    }
                  },
                  "processing_channel_id": {
                    "type": "string",
                    "description": "The processing channel to use for this payment"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "success_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Redirect URL for successful 3DS payments"
                  },
                  "failure_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Redirect URL for failed 3DS payments"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "202": {
            "description": "Payment accepted - pending 3DS or asynchronous processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable entity - payment declined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getPaymentsList",
        "summary": "Get payment list",
        "description": "Retrieve a list of payments filtered by various criteria.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of results to return"
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Number of results to skip"
          },
          {
            "name": "reference",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by payment reference"
          }
        ],
        "responses": {
          "200": {
            "description": "Payments retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "limit": {
                      "type": "integer"
                    },
                    "skip": {
                      "type": "integer"
                    },
                    "total_count": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PaymentResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "operationId": "getPaymentDetails",
        "summary": "Get payment details",
        "description": "Retrieve full details of a payment by its identifier.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payment identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/actions": {
      "get": {
        "operationId": "getPaymentActions",
        "summary": "Get payment actions",
        "description": "Retrieve the actions (authorization, capture, refund, void) performed on a payment.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payment identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment actions retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": ["Authorization", "Capture", "Refund", "Void"]
                      },
                      "processed_on": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "amount": {
                        "type": "integer"
                      },
                      "approved": {
                        "type": "boolean"
                      },
                      "response_code": {
                        "type": "string"
                      },
                      "response_summary": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/captures": {
      "post": {
        "operationId": "capturePayment",
        "summary": "Capture a payment",
        "description": "Capture an authorized payment in full or partially.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payment identifier"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "The amount to capture in minor units. If not specified, the full authorized amount is captured."
                  },
                  "reference": {
                    "type": "string",
                    "description": "A reference for the capture"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Capture accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action_id": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "_links": {
                      "type": "object",
                      "properties": {
                        "payment": {
                          "type": "object",
                          "properties": {
                            "href": {
                              "type": "string",
                              "format": "uri"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/refunds": {
      "post": {
        "operationId": "refundPayment",
        "summary": "Refund a payment",
        "description": "Refund a captured payment in full or partially.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payment identifier"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "The amount to refund in minor units"
                  },
                  "reference": {
                    "type": "string",
                    "description": "A reference for the refund"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Refund accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action_id": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "_links": {
                      "type": "object",
                      "properties": {
                        "payment": {
                          "type": "object",
                          "properties": {
                            "href": {
                              "type": "string",
                              "format": "uri"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/voids": {
      "post": {
        "operationId": "voidPayment",
        "summary": "Void a payment",
        "description": "Void an authorized payment that has not yet been captured.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payment identifier"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string",
                    "description": "A reference for the void"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Void accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action_id": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "_links": {
                      "type": "object",
                      "properties": {
                        "payment": {
                          "type": "object",
                          "properties": {
                            "href": {
                              "type": "string",
                              "format": "uri"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/reversals": {
      "post": {
        "operationId": "reversePayment",
        "summary": "Reverse a payment",
        "description": "Reverse a payment that has been captured.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payment identifier"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "The amount to reverse"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Reversal accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action_id": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/customers": {
      "post": {
        "operationId": "createCustomer",
        "summary": "Create a customer",
        "description": "Create a new customer to associate with payments and instruments.",
        "tags": ["Customers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The customer email address"
                  },
                  "name": {
                    "type": "string",
                    "description": "The customer full name"
                  },
                  "phone": {
                    "$ref": "#/components/schemas/Phone"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "getCustomerDetails",
        "summary": "Get customer details",
        "description": "Retrieve details of a customer and their associated instruments.",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The customer identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
