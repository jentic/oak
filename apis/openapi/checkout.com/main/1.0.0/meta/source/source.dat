    "/access/access_tokens": {
      "post": {
        "operationId": "requestAccessToken",
        "summary": "Request an OAuth access token",
        "description": "Exchange your client credentials for an OAuth 2.0 access token.",
        "tags": ["Access"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["grant_type", "client_id", "client_secret", "scope"],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": ["client_credentials"],
                    "description": "The grant type"
                  },
                  "client_id": {
                    "type": "string",
                    "description": "Your client ID"
                  },
                  "client_secret": {
                    "type": "string",
                    "description": "Your client secret"
                  },
                  "scope": {
                    "type": "string",
                    "description": "Space-separated list of scopes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "enum": ["Bearer"]
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "Token expiry in seconds"
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SecretApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-to-server API key. Format: sk_sbox_... (sandbox) or sk_... (production)"
      },
      "PublicApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Client-side public API key. Format: pk_sbox_... (sandbox) or pk_... (production)"
      },
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.checkout.com/access/access_tokens",
            "scopes": {
              "gateway": "Access gateway resources",
              "vault": "Access vault resources"
            }
          }
        }
      }
    },
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "address_line1": {
            "type": "string"
          },
          "address_line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "Two-letter ISO 3166-1 country code",
            "minLength": 2,
            "maxLength": 2
          }
        }
      },
      "Phone": {
        "type": "object",
        "properties": {
          "country_code": {
            "type": "string",
            "description": "International dialing code"
          },
          "number": {
            "type": "string",
            "description": "Phone number"
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique payment identifier"
          },
          "action_id": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["Authorized", "Captured", "Partially Captured", "Voided", "Partially Refunded", "Refunded", "Declined", "Expired", "Pending"]
          },
          "auth_code": {
            "type": "string"
          },
          "response_code": {
            "type": "string"
          },
          "response_summary": {
            "type": "string"
          },
          "3ds": {
            "type": "object",
            "properties": {
              "enrolled": {
                "type": "string"
              },
              "pares_status": {
                "type": "string"
              },
              "eci": {
                "type": "string"
              },
              "cryptogram": {
                "type": "string"
              },
              "xid": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "scheme": {
                "type": "string"
              },
              "last4": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string"
              },
              "bin": {
                "type": "string"
              },
              "card_type": {
                "type": "string"
              },
              "card_category": {
                "type": "string"
              },
              "issuer": {
                "type": "string"
              },
              "issuer_country": {
                "type": "string"
              },
              "avs_check": {
                "type": "string"
              },
              "cvv_check": {
                "type": "string"
              },
              "expiry_month": {
                "type": "integer"
              },
              "expiry_year": {
                "type": "integer"
              }
            }
          },
          "customer": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "processed_on": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": "string"
          },
          "processing": {
            "type": "object",
            "properties": {
              "acquirer_transaction_id": {
                "type": "string"
              },
              "retrieval_reference_number": {
                "type": "string"
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "_links": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "PaymentAcceptedResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["Pending"]
          },
          "reference": {
            "type": "string"
          },
          "_links": {
            "type": "object",
            "properties": {
              "redirect": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      },
      "CustomerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "$ref": "#/components/schemas/Phone"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "instruments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstrumentResponse"
            }
          },
          "default": {
            "type": "string",
            "description": "Default instrument ID"
          }
        }
      },
      "InstrumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "expiry_month": {
            "type": "integer"
          },
          "expiry_year": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "scheme": {
            "type": "string"
          },
          "last4": {
            "type": "string"
          },
          "bin": {
            "type": "string"
          },
          "card_type": {
            "type": "string"
          },
          "card_category": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "issuer_country": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "product_type": {
            "type": "string"
          }
        }
      },
      "DisputeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["evidence_required", "evidence_under_review", "resolved", "won", "lost", "expired", "accepted", "arbitration_under_review", "arbitration_won", "arbitration_lost"]
          },
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "payment_id": {
            "type": "string"
          },
          "payment_action_id": {
            "type": "string"
          },
          "payment_method": {
            "type": "string"
          },
          "payment_arn": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "received_on": {
            "type": "string",
            "format": "date-time"
          },
          "last_update": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_required_by": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WorkflowResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "_links": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Unique identifier for the request"
          },
          "error_type": {
            "type": "string",
            "description": "The error type"
          },
          "error_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of error codes"
          }
        }
      }
    }
  }
}