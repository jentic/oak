    "/hosted-payments": {
      "post": {
        "operationId": "createHostedPaymentsPage",
        "summary": "Create a hosted payments page",
        "description": "Create a hosted payments page session for collecting payment details.",
        "tags": ["Hosted Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency", "billing", "success_url", "cancel_url", "failure_url"],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "The payment amount in minor units"
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  },
                  "payment_type": {
                    "type": "string",
                    "enum": ["Regular", "Recurring"]
                  },
                  "reference": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "customer": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  "billing": {
                    "type": "object",
                    "required": ["address"],
                    "properties": {
                      "address": {
                        "$ref": "#/components/schemas/Address"
                      }
                    }
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer"
                        },
                        "price": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "success_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "cancel_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "failure_url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hosted payments page created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "_links": {
                      "type": "object",
                      "properties": {
                        "redirect": {
                          "type": "object",
                          "properties": {
                            "href": {
                              "type": "string",
                              "format": "uri"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
