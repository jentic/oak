    "/sessions": {
      "post": {
        "operationId": "requestAuthenticationSession",
        "summary": "Request a 3DS authentication session",
        "description": "Create a 3DS authentication session for a payment.",
        "tags": ["Sessions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["source", "amount", "currency", "authentication_type", "authentication_category", "challenge_indicator", "reference", "transaction_type", "protocol_version", "success_url", "failure_url"],
                "properties": {
                  "source": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "token": {
                        "type": "string"
                      },
                      "scheme": {
                        "type": "string"
                      },
                      "number": {
                        "type": "string"
                      },
                      "expiry_month": {
                        "type": "integer"
                      },
                      "expiry_year": {
                        "type": "integer"
                      }
                    }
                  },
                  "amount": {
                    "type": "integer"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "authentication_type": {
                    "type": "string",
                    "enum": ["regular", "recurring", "installment", "add_card", "maintain_card"]
                  },
                  "authentication_category": {
                    "type": "string",
                    "enum": ["payment", "non_payment"]
                  },
                  "challenge_indicator": {
                    "type": "string",
                    "enum": ["no_preference", "no_challenge_requested", "challenge_requested", "challenge_requested_mandate"]
                  },
                  "reference": {
                    "type": "string"
                  },
                  "transaction_type": {
                    "type": "string",
                    "enum": ["goods_service", "check_acceptance", "account_funding", "quasi_cash_transaction", "prepaid_activation_and_load"]
                  },
                  "protocol_version": {
                    "type": "string",
                    "enum": ["1", "2"]
                  },
                  "success_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "failure_url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "session_secret": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "authentication_type": {
                      "type": "string"
                    },
                    "protocol_version": {
                      "type": "string"
                    },
                    "_links": {
                      "type": "object",
                      "properties": {
                        "self": {
                          "type": "object",
                          "properties": {
                            "href": {
                              "type": "string",
                              "format": "uri"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
