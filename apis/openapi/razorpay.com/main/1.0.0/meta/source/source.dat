    "/payments/qr_codes": {
      "post": {
        "operationId": "createQRCode",
        "summary": "Create a QR code",
        "description": "Creates a new QR code for accepting payments.",
        "tags": ["QR Codes"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "name", "usage", "payment_amount"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["upi_qr", "bharat_qr"],
                    "description": "Type of QR code",
                    "example": "upi_qr"
                  },
                  "name": {
                    "type": "string",
                    "description": "Name for the QR code",
                    "example": "Store Front Display"
                  },
                  "usage": {
                    "type": "string",
                    "enum": ["single_use", "multiple_use"],
                    "description": "Whether the QR can be used once or multiple times",
                    "example": "single_use"
                  },
                  "fixed_amount": {
                    "type": "boolean",
                    "description": "If true, QR accepts only exact amount"
                  },
                  "payment_amount": {
                    "type": "integer",
                    "description": "Amount in paise",
                    "example": 30000
                  },
                  "description": {
                    "type": "string"
                  },
                  "customer_id": {
                    "type": "string",
                    "description": "Customer ID"
                  },
