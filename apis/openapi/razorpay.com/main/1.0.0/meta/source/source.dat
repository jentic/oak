    "/fund_accounts": {
      "post": {
        "operationId": "createFundAccount",
        "summary": "Create a fund account",
        "description": "Creates a fund account for a contact to which payouts can be made.",
        "tags": ["Fund Accounts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["contact_id", "account_type"],
                "properties": {
                  "contact_id": {
                    "type": "string",
                    "description": "Contact ID for the fund account",
                    "example": "cont_FgR9UMzgmKDvRH"
                  },
                  "account_type": {
                    "type": "string",
                    "enum": ["bank_account", "vpa"],
                    "description": "Type of fund account",
                    "example": "bank_account"
                  },
                  "bank_account": {
                    "type": "object",
                    "description": "Bank account details (required if account_type is bank_account)",
                    "properties": {
                      "name": { "type": "string", "example": "Gaurav Kumar" },
                      "ifsc": { "type": "string", "example": "HDFC0000053" },
                      "account_number": { "type": "string", "example": "1234567890123456789" }
                    }
                  },
                  "vpa": {
                    "type": "object",
                    "description": "VPA details (required if account_type is vpa)",
                    "properties": {
                      "address": { "type": "string", "example": "gaurav@upi" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fund account created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FundAccount" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
