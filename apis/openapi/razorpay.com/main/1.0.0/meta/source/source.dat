                "schema": { "$ref": "#/components/schemas/Subscription" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "operationId": "updateSubscription",
        "summary": "Update a subscription",
        "description": "Updates an existing subscription. Can change plan, quantity, or other details.",
        "tags": ["Subscriptions"],
        "parameters": [
          { "$ref": "#/components/parameters/subscriptionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "plan_id": {
                    "type": "string",
                    "description": "New plan ID"
                  },
                  "quantity": {
                    "type": "integer"
                  },
                  "remaining_count": {
                    "type": "integer",
                    "description": "Remaining billing cycles"
                  },
                  "offer_id": {
                    "type": "string"
                  },
                  "schedule_change_at": {
                    "type": "string",
                    "enum": ["now", "cycle_end"],
                    "description": "When to apply changes"
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subscription" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/subscriptions/{id}/cancel": {
      "post": {
        "operationId": "cancelSubscription",
        "summary": "Cancel a subscription",
        "description": "Cancels a subscription. Can cancel at cycle end or immediately.",
        "tags": ["Subscriptions"],
        "parameters": [
          { "$ref": "#/components/parameters/subscriptionId" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cancel_at_cycle_end": {
                    "type": "integer",
                    "enum": [0, 1],
                    "description": "If 1, subscription is cancelled at end of current billing cycle. If 0, cancelled immediately.",
                    "default": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription cancelled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subscription" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
