    "/settlements/recon/combined": {
      "get": {
        "operationId": "getSettlementRecon",
        "summary": "Get combined settlement reconciliation report",
        "description": "Retrieves a combined reconciliation report for settlements within a given period.",
        "tags": ["Settlements"],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "description": "Year for the report",
            "schema": { "type": "integer", "example": 2024 }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "description": "Month for the report (1-12)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 12, "example": 6 }
          },
          {
            "name": "day",
            "in": "query",
            "description": "Day for the report (optional)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 31 }
          },
          { "$ref": "#/components/parameters/count" },
          { "$ref": "#/components/parameters/skip" }
        ],
        "responses": {
          "200": {
            "description": "Settlement reconciliation data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "entity_type": { "type": "string" },
                          "payment_id": { "type": "string" },
                          "type": { "type": "string" },
                          "debit": { "type": "integer" },
                          "credit": { "type": "integer" },
                          "amount": { "type": "integer" },
                          "currency": { "type": "string" },
                          "fee": { "type": "integer" },
                          "tax": { "type": "integer" },
                          "on_hold": { "type": "boolean" },
                          "settled": { "type": "boolean" },
                          "created_at": { "type": "integer" },
                          "settled_at": { "type": "integer" },
                          "settlement_id": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payment_links": {
      "post": {
        "operationId": "createPaymentLink",
        "summary": "Create a payment link",
        "description": "Creates a new payment link that can be shared with customers.",
        "tags": ["Payment Links"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Amount in paise",
                    "example": 100000
                  },
                  "currency": {
                    "type": "string",
                    "example": "INR"
                  },
                  "accept_partial": {
                    "type": "boolean",
                    "description": "Whether to accept partial payments",
                    "default": false
                  },
                  "first_min_partial_amount": {
                    "type": "integer",
                    "description": "Minimum amount for first partial payment in paise"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the payment link",
                    "example": "Payment for order #123"
                  },
                  "customer": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "email": { "type": "string", "format": "email" },
                      "contact": { "type": "string" }
                    }
                  },
                  "notify": {
                    "type": "object",
                    "properties": {
                      "sms": { "type": "boolean" },
                      "email": { "type": "boolean" }
                    }
                  },
                  "reminder_enable": {
                    "type": "boolean",
                    "description": "Enable reminders"
                  },
                  "expire_by": {
                    "type": "integer",
                    "description": "Unix timestamp for link expiry"
                  },
                  "reference_id": {
                    "type": "string",
                    "description": "Unique reference ID"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL to redirect after payment"
                  },
                  "callback_method": {
                    "type": "string",
                    "enum": ["get"],
                    "description": "HTTP method for callback redirect"
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment link created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentLink" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "get": {
        "operationId": "listPaymentLinks",
        "summary": "List all payment links",
        "description": "Retrieves a list of all payment links.",
        "tags": ["Payment Links"],
        "parameters": [
          { "$ref": "#/components/parameters/count" },
          { "$ref": "#/components/parameters/skip" },
          {
            "name": "payment_id",
            "in": "query",
            "description": "Filter by associated payment ID",
            "schema": { "type": "string" }
          },
          {
            "name": "reference_id",
            "in": "query",
            "description": "Filter by reference ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of payment links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/PaymentLink" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
