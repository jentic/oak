        "description": "Retrieves details of a specific addon.",
        "tags": ["Addons"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Addon ID",
            "schema": { "type": "string", "example": "ao_FgR9UMzgmKDvRH" }
          }
        ],
        "responses": {
          "200": {
            "description": "Addon details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Addon" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteAddon",
        "summary": "Delete an addon",
        "description": "Deletes an addon from a subscription.",
        "tags": ["Addons"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Addon ID",
            "schema": { "type": "string", "example": "ao_FgR9UMzgmKDvRH" }
          }
        ],
        "responses": {
          "200": {
            "description": "Addon deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string" },
                    "id": { "type": "string" },
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tokens": {
      "post": {
        "operationId": "createToken",
        "summary": "Create a token",
        "description": "Creates a token for storing customer payment method details.",
        "tags": ["Tokens"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_id", "method", "token"],
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Customer ID",
                    "example": "cust_FgR9UMzgmKDvRH"
                  },
                  "method": {
                    "type": "string",
                    "enum": ["card", "emandate", "nach", "upi"],
                    "description": "Payment method"
                  },
                  "token": {
                    "type": "string",
                    "description": "Token value from authorization"
                  },
                  "max_amount": {
                    "type": "integer",
                    "description": "Maximum amount in paise that can be debited"
                  },
                  "expire_at": {
                    "type": "integer",
                    "description": "Unix timestamp for token expiry"
                  },
                  "frequency": {
                    "type": "string",
                    "enum": ["as_presented", "monthly", "yearly"],
                    "description": "Debit frequency"
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Token" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{id}/tokens": {
      "get": {
        "operationId": "listCustomerTokens",
        "summary": "List tokens for a customer",
        "description": "Retrieves all tokens saved for a customer.",
        "tags": ["Tokens"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" }
        ],
        "responses": {
          "200": {
            "description": "List of tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Token" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{id}/tokens/{token_id}": {
      "get": {
        "operationId": "getCustomerToken",
        "summary": "Fetch a specific token for a customer",
        "description": "Retrieves details of a specific token saved for a customer.",
        "tags": ["Tokens"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "token_id",
            "in": "path",
            "required": true,
            "description": "Token ID",
            "schema": { "type": "string", "example": "token_FgR9UMzgmKDvRH" }
          }
        ],
        "responses": {
          "200": {
            "description": "Token details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Token" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteCustomerToken",
        "summary": "Delete a token for a customer",
        "description": "Deletes a saved token for a customer.",
        "tags": ["Tokens"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "token_id",
            "in": "path",
            "required": true,
            "description": "Token ID",
            "schema": { "type": "string", "example": "token_FgR9UMzgmKDvRH" }
          }
        ],
        "responses": {
          "200": {
            "description": "Token deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Use your Razorpay key_id as the username and key_secret as the password for Basic Auth."
      }
    },
    "parameters": {
      "from": {
        "name": "from",
        "in": "query",
        "description": "Unix timestamp to filter from (start of range)",
        "schema": { "type": "integer" }
      },
      "to": {
        "name": "to",
        "in": "query",
        "description": "Unix timestamp to filter to (end of range)",
        "schema": { "type": "integer" }
      },
      "count": {
        "name": "count",
        "in": "query",
        "description": "Number of records to fetch (default 10, max 100)",
        "schema": { "type": "integer", "default": 10, "maximum": 100 }
      },
      "skip": {
        "name": "skip",
        "in": "query",
        "description": "Number of records to skip for pagination",
        "schema": { "type": "integer", "default": 0 }
      },
      "paymentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Payment ID",
        "schema": { "type": "string", "example": "pay_FgR9UMzgmKDvRH" }
      },
      "orderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Order ID",
        "schema": { "type": "string", "example": "order_FgR9UMzgmKDvRH" }
      },
      "customerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Customer ID",
        "schema": { "type": "string", "example": "cust_FgR9UMzgmKDvRH" }
      },
      "invoiceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Invoice ID",
        "schema": { "type": "string", "example": "inv_FgR9UMzgmKDvRH" }
      },
      "subscriptionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Subscription ID",
        "schema": { "type": "string", "example": "sub_FgR9UMzgmKDvRH" }
      },
      "virtualAccountId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Virtual Account ID",
        "schema": { "type": "string", "example": "va_FgR9UMzgmKDvRH" }
      }
    },
    "schemas": {
      "Notes": {
        "type": "object",
        "description": "Key-value pairs for storing additional information. Maximum 15 key-value pairs, 256 characters each.",
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "note_key": "note_value"
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Unique payment identifier", "example": "pay_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "payment" },
          "amount": { "type": "integer", "description": "Payment amount in paise", "example": 50000 },
          "currency": { "type": "string", "example": "INR" },
          "status": {
            "type": "string",
            "enum": ["created", "authorized", "captured", "refunded", "failed"],
            "description": "Payment status"
          },
          "order_id": { "type": "string", "description": "Associated order ID", "example": "order_FgR9UMzgmKDvRH" },
          "invoice_id": { "type": "string", "nullable": true },
          "international": { "type": "boolean", "description": "Whether the payment is international" },
          "method": {
            "type": "string",
            "enum": ["card", "netbanking", "wallet", "emi", "upi", "bank_transfer"],
            "description": "Payment method used"
          },
          "amount_refunded": { "type": "integer", "description": "Amount refunded in paise", "example": 0 },
          "refund_status": {
            "type": "string",
            "nullable": true,
            "enum": ["null", "partial", "full"]
          },
          "captured": { "type": "boolean", "description": "Whether the payment has been captured" },
          "description": { "type": "string", "description": "Payment description" },
          "card_id": { "type": "string", "nullable": true },
          "bank": { "type": "string", "nullable": true, "description": "Bank code for netbanking payments" },
          "wallet": { "type": "string", "nullable": true, "description": "Wallet name" },
          "vpa": { "type": "string", "nullable": true, "description": "UPI VPA" },
          "email": { "type": "string", "format": "email", "description": "Payer email" },
          "contact": { "type": "string", "description": "Payer phone number" },
          "customer_id": { "type": "string", "nullable": true },
          "fee": { "type": "integer", "description": "Razorpay fees in paise" },
          "tax": { "type": "integer", "description": "GST on fees in paise" },
          "error_code": { "type": "string", "nullable": true },
          "error_description": { "type": "string", "nullable": true },
          "error_source": { "type": "string", "nullable": true },
          "error_step": { "type": "string", "nullable": true },
          "error_reason": { "type": "string", "nullable": true },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer", "description": "Unix timestamp of creation" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "order_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "order" },
          "amount": { "type": "integer", "description": "Order amount in paise", "example": 50000 },
          "amount_paid": { "type": "integer", "description": "Amount paid in paise", "example": 0 },
          "amount_due": { "type": "integer", "description": "Amount due in paise", "example": 50000 },
          "currency": { "type": "string", "example": "INR" },
          "receipt": { "type": "string", "example": "receipt_1" },
          "offer_id": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": ["created", "attempted", "paid"],
            "description": "Order status"
          },
          "attempts": { "type": "integer", "description": "Number of payment attempts" },
          "partial_payment": { "type": "boolean" },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "rfnd_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "refund" },
          "amount": { "type": "integer", "description": "Refund amount in paise", "example": 20000 },
          "currency": { "type": "string", "example": "INR" },
          "payment_id": { "type": "string", "example": "pay_FgR9UMzgmKDvRH" },
          "receipt": { "type": "string", "nullable": true },
          "speed_requested": { "type": "string", "enum": ["normal", "optimum"] },
          "speed_processed": { "type": "string", "enum": ["normal", "instant"] },
          "status": {
            "type": "string",
            "enum": ["pending", "processed", "failed"],
            "description": "Refund status"
          },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "cust_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "customer" },
          "name": { "type": "string", "example": "Gaurav Kumar" },
          "email": { "type": "string", "format": "email", "example": "gaurav@example.com" },
          "contact": { "type": "string", "example": "9876543210" },
          "gstin": { "type": "string", "nullable": true },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "inv_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "invoice" },
          "type": { "type": "string", "enum": ["invoice", "link"] },
          "invoice_number": { "type": "string", "nullable": true },
          "customer_id": { "type": "string" },
          "customer_details": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "email": { "type": "string" },
              "contact": { "type": "string" },
              "billing_address": { "type": "object" },
              "shipping_address": { "type": "object" }
            }
          },
          "order_id": { "type": "string", "nullable": true },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "item_id": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "amount": { "type": "integer" },
                "unit_amount": { "type": "integer" },
                "gross_amount": { "type": "integer" },
                "tax_amount": { "type": "integer" },
                "net_amount": { "type": "integer" },
                "currency": { "type": "string" },
                "quantity": { "type": "integer" }
              }
            }
          },
          "payment_id": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": ["draft", "issued", "partially_paid", "paid", "cancelled", "expired", "deleted"]
          },
          "expire_by": { "type": "integer", "nullable": true },
          "issued_at": { "type": "integer", "nullable": true },
          "paid_at": { "type": "integer", "nullable": true },
          "cancelled_at": { "type": "integer", "nullable": true },
          "expired_at": { "type": "integer", "nullable": true },
          "sms_status": { "type": "string", "nullable": true },
          "email_status": { "type": "string", "nullable": true },
          "date": { "type": "integer", "nullable": true },
          "gross_amount": { "type": "integer" },
          "tax_amount": { "type": "integer" },
          "taxable_amount": { "type": "integer" },
          "amount": { "type": "integer", "description": "Total amount in paise" },
          "amount_paid": { "type": "integer" },
          "amount_due": { "type": "integer" },
          "currency": { "type": "string" },
          "currency_symbol": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "short_url": { "type": "string", "format": "uri", "description": "Short URL for the invoice" },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "sub_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "subscription" },
          "plan_id": { "type": "string" },
          "customer_id": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": ["created", "authenticated", "active", "pending", "halted", "cancelled", "completed", "expired", "paused"]
          },
          "current_start": { "type": "integer", "nullable": true },
          "current_end": { "type": "integer", "nullable": true },
          "ended_at": { "type": "integer", "nullable": true },
          "quantity": { "type": "integer" },
          "total_count": { "type": "integer" },
          "paid_count": { "type": "integer" },
          "remaining_count": { "type": "integer" },
          "customer_notify": { "type": "integer" },
          "start_at": { "type": "integer", "nullable": true },
          "expire_by": { "type": "integer", "nullable": true },
          "short_url": { "type": "string", "format": "uri" },
          "has_scheduled_changes": { "type": "boolean" },
          "change_scheduled_at": { "type": "integer", "nullable": true },
          "offer_id": { "type": "string", "nullable": true },
          "charge_at": { "type": "integer", "nullable": true },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "plan_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "plan" },
          "interval": { "type": "integer", "example": 1 },
          "period": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] },
          "item": { "$ref": "#/components/schemas/Item" },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "Settlement": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "setl_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "settlement" },
          "amount": { "type": "integer", "description": "Settlement amount in paise" },
          "status": {
            "type": "string",
            "enum": ["created", "processed", "failed"]
          },
          "fees": { "type": "integer", "description": "Total fees in paise" },
          "tax": { "type": "integer", "description": "Total tax in paise" },
          "utr": { "type": "string", "description": "Unique transaction reference" },
          "created_at": { "type": "integer" }
        }
      },
      "PaymentLink": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "plink_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "payment_link" },
          "amount": { "type": "integer", "description": "Amount in paise" },
          "currency": { "type": "string" },
          "accept_partial": { "type": "boolean" },
          "first_min_partial_amount": { "type": "integer", "nullable": true },
          "description": { "type": "string" },
          "customer": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" },
              "contact": { "type": "string" }
            }
          },
          "order_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["created", "partially_paid", "paid", "cancelled", "expired"]
          },
          "reference_id": { "type": "string", "nullable": true },
          "short_url": { "type": "string", "format": "uri" },
          "expire_by": { "type": "integer", "nullable": true },
          "reminder_enable": { "type": "boolean" },
          "callback_url": { "type": "string", "nullable": true },
          "callback_method": { "type": "string", "nullable": true },
          "amount_paid": { "type": "integer" },
          "cancelled_at": { "type": "integer", "nullable": true },
          "expired_at": { "type": "integer", "nullable": true },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" },
          "updated_at": { "type": "integer" }
        }
      },
      "QRCode": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "qr_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "qr_code" },
          "name": { "type": "string" },
          "usage": { "type": "string", "enum": ["single_use", "multiple_use"] },
          "type": { "type": "string", "enum": ["upi_qr", "bharat_qr"] },
          "fixed_amount": { "type": "boolean" },
          "payment_amount": { "type": "integer", "description": "Amount in paise" },
          "description": { "type": "string", "nullable": true },
          "customer_id": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": ["active", "closed"]
          },
          "image_url": { "type": "string", "format": "uri", "description": "URL of the QR code image" },
          "payments_amount_received": { "type": "integer" },
          "payments_count_received": { "type": "integer" },
          "close_by": { "type": "integer", "nullable": true },
          "closed_at": { "type": "integer", "nullable": true },
          "close_reason": { "type": "string", "nullable": true },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "VirtualAccount": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "va_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "virtual_account" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "amount_expected": { "type": "integer", "description": "Expected amount in paise" },
          "amount_paid": { "type": "integer", "description": "Amount paid in paise" },
          "customer_id": { "type": "string", "nullable": true },
          "receivers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "entity": { "type": "string" },
                "ifsc": { "type": "string" },
                "bank_name": { "type": "string" },
                "name": { "type": "string" },
                "account_number": { "type": "string" },
                "address": { "type": "string", "description": "VPA address if receiver type is vpa" }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["active", "closed", "paid"]
          },
          "close_by": { "type": "integer", "nullable": true },
          "closed_at": { "type": "integer", "nullable": true },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "item_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "item" },
          "active": { "type": "boolean" },
          "amount": { "type": "integer", "description": "Amount in paise" },
          "unit_amount": { "type": "integer" },
          "currency": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "hsn_code": { "type": "string", "nullable": true },
          "sac_code": { "type": "string", "nullable": true },
          "tax_inclusive": { "type": "boolean" },
          "tax_id": { "type": "string", "nullable": true },
          "tax_group_id": { "type": "string", "nullable": true },
          "created_at": { "type": "integer" }
        }
      },
      "FundAccount": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "fa_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "fund_account" },
          "contact_id": { "type": "string" },
          "account_type": { "type": "string", "enum": ["bank_account", "vpa"] },
          "bank_account": {
            "type": "object",
            "nullable": true,
            "properties": {
              "ifsc": { "type": "string" },
              "bank_name": { "type": "string" },
              "name": { "type": "string" },
              "account_number": { "type": "string" }
            }
          },
          "vpa": {
            "type": "object",
            "nullable": true,
            "properties": {
              "address": { "type": "string" }
            }
          },
          "active": { "type": "boolean" },
          "batch_id": { "type": "string", "nullable": true },
          "created_at": { "type": "integer" }
        }
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "trf_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "transfer" },
          "source": { "type": "string", "description": "Source of the transfer (account or payment ID)" },
          "recipient": { "type": "string", "description": "Linked account ID" },
          "amount": { "type": "integer", "description": "Transfer amount in paise" },
          "currency": { "type": "string" },
          "amount_reversed": { "type": "integer" },
          "on_hold": { "type": "boolean" },
          "on_hold_until": { "type": "integer", "nullable": true },
          "recipient_settlement_id": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": ["created", "pending", "processed", "failed", "reversed", "partially_reversed"]
          },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "fees": { "type": "integer" },
          "tax": { "type": "integer" },
          "created_at": { "type": "integer" }
        }
      },
      "Addon": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "ao_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "addon" },
          "subscription_id": { "type": "string" },
          "item": { "$ref": "#/components/schemas/Item" },
          "quantity": { "type": "integer" },
          "created_at": { "type": "integer" },
          "invoice_id": { "type": "string", "nullable": true }
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "token_FgR9UMzgmKDvRH" },
          "entity": { "type": "string", "example": "token" },
          "token": { "type": "string", "description": "Token value" },
          "customer_id": { "type": "string" },
          "method": { "type": "string", "enum": ["card", "emandate", "nach", "upi"] },
          "card": {
            "type": "object",
            "nullable": true,
            "properties": {
              "name": { "type": "string" },
              "network": { "type": "string" },
              "issuer": { "type": "string" },
              "international": { "type": "boolean" },
              "emi": { "type": "boolean" },
              "last4": { "type": "string" },
              "type": { "type": "string", "enum": ["credit", "debit", "prepaid"] }
            }
          },
          "recurring": { "type": "boolean" },
          "recurring_details": {
            "type": "object",
            "nullable": true,
            "properties": {
              "status": { "type": "string" },
              "failure_reason": { "type": "string", "nullable": true }
            }
          },
          "auth_type": { "type": "string", "nullable": true },
          "mrn": { "type": "string", "nullable": true },
          "used_at": { "type": "integer", "nullable": true },
          "max_payment_amount": { "type": "integer", "nullable": true },
          "expired_at": { "type": "integer", "nullable": true },
          "dcc_enabled": { "type": "boolean" },
          "bank": { "type": "string", "nullable": true },
          "wallet": { "type": "string", "nullable": true },
          "notes": { "$ref": "#/components/schemas/Notes" },
          "created_at": { "type": "integer" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code",
                "example": "BAD_REQUEST_ERROR"
              },
              "description": {
                "type": "string",
                "description": "Human-readable error description",
                "example": "The amount must be at least INR 1.00."
              },
              "source": {
                "type": "string",
                "description": "Error source",
                "example": "business"
              },
              "step": {
                "type": "string",
                "description": "Error step",
                "example": "payment_initiation"
              },
              "reason": {
                "type": "string",
                "description": "Error reason",
                "example": "input_validation_failed"
              },
              "metadata": {
                "type": "object",
                "description": "Additional metadata about the error",
                "additionalProperties": true
              },
              "field": {
                "type": "string",
                "nullable": true,
                "description": "Field that caused the error"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - invalid parameters or business rule violation",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed - invalid API key or secret",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
