    "/virtual_accounts": {
      "post": {
        "operationId": "createVirtualAccount",
        "summary": "Create a virtual account",
        "description": "Creates a new virtual account for receiving payments.",
        "tags": ["Virtual Accounts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["receivers", "description", "amount_expected"],
                "properties": {
                  "receivers": {
                    "type": "object",
                    "description": "Receiver configuration",
                    "properties": {
                      "types": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["bank_account", "vpa"]
                        },
                        "example": ["bank_account"]
                      }
                    }
                  },
                  "description": {
                    "type": "string",
                    "description": "Description for the virtual account",
                    "example": "Virtual Account for order"
                  },
                  "customer_id": {
                    "type": "string",
                    "description": "Existing customer ID"
                  },
                  "close_by": {
                    "type": "integer",
                    "description": "Unix timestamp to auto-close the virtual account"
                  },
                  "amount_expected": {
                    "type": "integer",
                    "description": "Expected payment amount in paise",
                    "example": 100000
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Virtual account created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VirtualAccount" }
