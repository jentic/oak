{
  "openapi": "3.0.3",
  "info": {
    "title": "Razorpay API",
    "description": "Razorpay APIs allow you to accept payments, manage refunds, customers, orders, invoices, subscriptions, transfers, virtual accounts, QR codes, payment links, and more. All amounts are in paise (smallest currency unit, integer).",
    "version": "1.0.0",
    "contact": {
      "name": "Razorpay Support",
      "url": "https://razorpay.com/support",
      "email": "support@razorpay.com"
    },
    "license": {
      "name": "Razorpay Terms of Use",
      "url": "https://razorpay.com/terms"
    },
    "x-jentic-source-url": "https://razorpay.com/docs/api"
  },
  "servers": [
    {
      "url": "https://api.razorpay.com/v1",
      "description": "Razorpay Production API"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    { "name": "Payments", "description": "Payment capture and retrieval" },
    { "name": "Orders", "description": "Order creation and management" },
    { "name": "Refunds", "description": "Refund creation and retrieval" },
    { "name": "Customers", "description": "Customer management" },
    { "name": "Invoices", "description": "Invoice lifecycle management" },
    { "name": "Subscriptions", "description": "Recurring subscription management" },
    { "name": "Plans", "description": "Subscription plan management" },
    { "name": "Settlements", "description": "Settlement retrieval and reconciliation" },
    { "name": "Payment Links", "description": "Payment link creation and management" },
    { "name": "QR Codes", "description": "QR code payment management" },
    { "name": "Virtual Accounts", "description": "Virtual account management" },
    { "name": "Items", "description": "Item management for invoices" },
    { "name": "Fund Accounts", "description": "Fund account management" },
    { "name": "Transfers", "description": "Route transfers and reversals" },
    { "name": "Addons", "description": "Subscription addon management" },
    { "name": "Tokens", "description": "Token and saved card management" }
  ],
  "paths": {
    "/payments": {
      "get": {
        "operationId": "listPayments",
        "summary": "List all payments",
        "description": "Retrieves a list of all payments with optional filtering by time range and count.",
        "tags": ["Payments"],
        "parameters": [
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          { "$ref": "#/components/parameters/count" },
          { "$ref": "#/components/parameters/skip" }
        ],
        "responses": {
          "200": {
            "description": "List of payments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Payment" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "summary": "Fetch a payment by ID",
        "description": "Retrieves details of a specific payment by its identifier.",
        "tags": ["Payments"],
        "parameters": [
          { "$ref": "#/components/parameters/paymentId" }
        ],
        "responses": {
          "200": {
            "description": "Payment details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Payment" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payments/{id}/capture": {
      "post": {
        "operationId": "capturePayment",
        "summary": "Capture a payment",
        "description": "Captures an authorized payment. The amount must match the authorized amount or be less for partial capture.",
        "tags": ["Payments"],
        "parameters": [
          { "$ref": "#/components/parameters/paymentId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Amount to capture in paise",
                    "example": 50000
                  },
                  "currency": {
                    "type": "string",
                    "description": "ISO currency code",
                    "example": "INR"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment captured",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Payment" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payments/{id}/refund": {
      "post": {
        "operationId": "refundPayment",
        "summary": "Refund a payment",
        "description": "Creates a normal refund for a captured payment. Omit amount for full refund.",
        "tags": ["Payments"],
        "parameters": [
          { "$ref": "#/components/parameters/paymentId" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Refund amount in paise. Omit for full refund.",
                    "example": 20000
                  },
                  "speed": {
                    "type": "string",
                    "enum": ["normal", "optimum"],
                    "description": "Speed of refund processing",
                    "example": "normal"
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  },
                  "receipt": {
                    "type": "string",
                    "description": "Unique receipt identifier for internal reference",
                    "maxLength": 40
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Refund" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order",
        "description": "Creates a new order. Every payment in Razorpay must be associated with an order.",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Order amount in paise",
                    "example": 50000
                  },
                  "currency": {
                    "type": "string",
                    "description": "ISO currency code",
                    "example": "INR"
                  },
                  "receipt": {
                    "type": "string",
                    "description": "Receipt number for internal reference",
                    "maxLength": 40,
                    "example": "receipt_1"
                  },
                  "partial_payment": {
                    "type": "boolean",
                    "description": "Allow partial payments",
                    "default": false
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "get": {
        "operationId": "listOrders",
        "summary": "List all orders",
        "description": "Retrieves a list of all orders with optional filtering.",
        "tags": ["Orders"],
        "parameters": [
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          { "$ref": "#/components/parameters/count" },
          { "$ref": "#/components/parameters/skip" },
          {
            "name": "authorized",
            "in": "query",
            "description": "Filter by authorization status (1 for authorized, 0 for unauthorized)",
            "schema": { "type": "integer", "enum": [0, 1] }
          },
          {
            "name": "receipt",
            "in": "query",
            "description": "Filter by receipt number",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Order" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Fetch an order by ID",
        "description": "Retrieves details of a specific order.",
        "tags": ["Orders"],
        "parameters": [
          { "$ref": "#/components/parameters/orderId" }
        ],
        "responses": {
          "200": {
            "description": "Order details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/{id}/payments": {
      "get": {
        "operationId": "listOrderPayments",
        "summary": "List payments for an order",
        "description": "Retrieves all payment attempts for a given order.",
        "tags": ["Orders"],
        "parameters": [
          { "$ref": "#/components/parameters/orderId" }
        ],
        "responses": {
          "200": {
            "description": "List of payments for the order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Payment" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/refunds": {
      "post": {
        "operationId": "createRefund",
        "summary": "Create a standalone refund",
        "description": "Creates a refund. Requires payment_id in the request body.",
        "tags": ["Refunds"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["payment_id"],
                "properties": {
                  "payment_id": {
                    "type": "string",
                    "description": "ID of the payment to refund",
                    "example": "pay_FgR9UMzgmKDvRH"
                  },
                  "amount": {
                    "type": "integer",
                    "description": "Refund amount in paise. Omit for full refund.",
                    "example": 10000
                  },
                  "speed": {
                    "type": "string",
                    "enum": ["normal", "optimum"],
                    "example": "normal"
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  },
                  "receipt": {
                    "type": "string",
                    "maxLength": 40
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Refund" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "get": {
        "operationId": "listRefunds",
        "summary": "List all refunds",
        "description": "Retrieves a list of all refunds.",
        "tags": ["Refunds"],
        "parameters": [
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          { "$ref": "#/components/parameters/count" },
          { "$ref": "#/components/parameters/skip" }
        ],
        "responses": {
          "200": {
            "description": "List of refunds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Refund" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/refunds/{id}": {
      "get": {
        "operationId": "getRefund",
        "summary": "Fetch a refund by ID",
        "description": "Retrieves details of a specific refund.",
        "tags": ["Refunds"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Refund ID",
            "schema": { "type": "string", "example": "rfnd_FgR9UMzgmKDvRH" }
          }
        ],
        "responses": {
          "200": {
            "description": "Refund details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Refund" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers": {
      "post": {
        "operationId": "createCustomer",
        "summary": "Create a customer",
        "description": "Creates a new customer record.",
        "tags": ["Customers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "contact", "email"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Customer name",
                    "example": "Gaurav Kumar"
                  },
                  "contact": {
                    "type": "string",
                    "description": "Customer phone number",
                    "example": "9876543210"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Customer email address",
                    "example": "gaurav@example.com"
                  },
                  "fail_existing": {
                    "type": "integer",
                    "enum": [0, 1],
                    "description": "If 1, the request throws an exception if a customer with same details exists. If 0, returns existing customer.",
                    "default": 1
                  },
                  "gstin": {
                    "type": "string",
                    "description": "GSTIN of the customer"
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Customer" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "get": {
        "operationId": "listCustomers",
        "summary": "List all customers",
        "description": "Retrieves a list of all customers.",
        "tags": ["Customers"],
        "parameters": [
          { "$ref": "#/components/parameters/count" },
          { "$ref": "#/components/parameters/skip" }
        ],
        "responses": {
          "200": {
            "description": "List of customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Customer" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "Fetch a customer by ID",
        "description": "Retrieves details of a specific customer.",
        "tags": ["Customers"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" }
        ],
        "responses": {
          "200": {
            "description": "Customer details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Customer" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "operationId": "updateCustomer",
        "summary": "Update a customer",
        "description": "Updates an existing customer's details.",
        "tags": ["Customers"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Gaurav Kumar" },
                  "contact": { "type": "string", "example": "9876543210" },
                  "email": { "type": "string", "format": "email", "example": "gaurav@example.com" },
                  "gstin": { "type": "string" },
                  "notes": { "$ref": "#/components/schemas/Notes" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Customer" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/invoices": {
      "post": {
        "operationId": "createInvoice",
        "summary": "Create an invoice",
        "description": "Creates a new invoice. Can be of type invoice or link.",
        "tags": ["Invoices"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["invoice", "link"],
                    "description": "Type of the invoice",
                    "example": "invoice"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the invoice",
                    "example": "Invoice for October"
                  },
                  "customer_id": {
                    "type": "string",
                    "description": "Existing customer ID"
                  },
                  "customer": {
                    "type": "object",
                    "description": "Customer details if creating inline",
                    "properties": {
                      "name": { "type": "string" },
                      "email": { "type": "string", "format": "email" },
                      "contact": { "type": "string" },
                      "billing_address": {
                        "type": "object",
                        "properties": {
                          "line1": { "type": "string" },
                          "line2": { "type": "string" },
                          "city": { "type": "string" },
                          "state": { "type": "string" },
                          "zipcode": { "type": "string" },
                          "country": { "type": "string" }
                        }
                      }
                    }
                  },
                  "line_items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "item_id": { "type": "string" },
                        "name": { "type": "string" },
                        "description": { "type": "string" },
                        "amount": { "type": "integer", "description": "Amount in paise" },
                        "currency": { "type": "string" },
                        "quantity": { "type": "integer" }
                      }
                    }
                  },
                  "draft": {
                    "type": "integer",
                    "enum": [0, 1],
                    "description": "If 1, invoice is created in draft state"
                  },
                  "date": {
                    "type": "integer",
                    "description": "Unix timestamp for the invoice date"
                  },
                  "expire_by": {
                    "type": "integer",
                    "description": "Unix timestamp for invoice expiry"
                  },
                  "sms_notify": {
                    "type": "integer",
                    "enum": [0, 1],
                    "description": "Whether to send SMS notification"
                  },
                  "email_notify": {
                    "type": "integer",
                    "enum": [0, 1],
                    "description": "Whether to send email notification"
                  },
                  "currency": {
                    "type": "string",
                    "example": "INR"
                  },
                  "notes": {
                    "$ref": "#/components/schemas/Notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Invoice" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "get": {
        "operationId": "listInvoices",
        "summary": "List all invoices",
        "description": "Retrieves a list of all invoices.",
        "tags": ["Invoices"],
        "parameters": [
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          { "$ref": "#/components/parameters/count" },
          { "$ref": "#/components/parameters/skip" },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by type (invoice or link)",
            "schema": { "type": "string", "enum": ["invoice", "link"] }
          },
          {
            "name": "payment_id",
            "in": "query",
            "description": "Filter by payment ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of invoices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string", "example": "collection" },
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Invoice" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/invoices/{id}": {
      "get": {
        "operationId": "getInvoice",
        "summary": "Fetch an invoice by ID",
        "description": "Retrieves details of a specific invoice.",
        "tags": ["Invoices"],
        "parameters": [
          { "$ref": "#/components/parameters/invoiceId" }
        ],
        "responses": {
          "200": {
            "description": "Invoice details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Invoice" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteInvoice",
        "summary": "Delete an invoice",
        "description": "Deletes a draft invoice.",
        "tags": ["Invoices"],
        "parameters": [
          { "$ref": "#/components/parameters/invoiceId" }
        ],
        "responses": {
          "200": {
            "description": "Invoice deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": { "type": "string" },
                    "id": { "type": "string" },
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          },
