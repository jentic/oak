              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/load/{loadID}/offer/": {
      "parameters": [
        {
          "in": "path",
          "name": "loadID",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        }
      ],
      "get": {
        "summary": "Get the Spot Market offer history for the load.",
        "description": "This endpoint allows carriers to retrieve information about previous offers on a specific Spot Market load. The response is limited to the first 100 offers. An offset value may be set to retrieve values beyond the first 100. The results for this request can include offers made by other carriers (your_bid = false).",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "description": "Used to retrieve offers beyond the first 100.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpotMarketOfferResponse"
                },
                "examples": {
