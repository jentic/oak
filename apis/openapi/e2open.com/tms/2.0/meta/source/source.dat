{
  "openapi": "3.0.0",
  "info": {
    "title": "TM-Shippers: Spot Market API",
    "description": "Endpoints to allow carriers to retrieve Spot Market postings and retrieve and update offers. This API only supports offers for Truckload loads. This API supports both basic, detailed, and contract offers. A basic offer is one with a single total charge. A detailed offer supports a single base charge and multiple accessorial charges metered to a variety of load metrics (weight, distance et al.). Contract offers are pre-defined by the TMS and can contain multiple base, tax, and accessorial charges. Basic, contract, and detailed offers may be submitted when the requires_detailed_offer field of the SpotMarket load is set to true. In this situation a basic offer would be converted by this API to a detailed offer containing a FLAT base rate. When the requires_detailed_offer field of the SpotMarket load is set to false, only basic and contract offers may be submitted.",
    "version": "2.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/e2open/spot-market_api/2.0"
  },
  "servers": [
    {
      "url": "https://na-api.tms.e2open.com/tmsapi/v2/spotmarket",
      "description": "NA Production server"
    },
    {
      "url": "https://oc-api.tms.eu.e2open.com/tmsapi/v2/spotmarket",
      "description": "OC Production server"
    },
    {
      "description": "NA Red Sandbox Server",
      "url": "https://red-sandbox-tms-api.e2open.com/tmsapi/v2/spotmarket"
    },
    {
      "description": "NA Orange Sandbox Server",
      "url": "https://orange-sandbox-tms-api.e2open.com/tmsapi/v2/spotmarket"
    },
    {
      "description": "NA Yellow Sandbox Server",
      "url": "https://yellow-sandbox-tms-api.e2open.com/tmsapi/v2/spotmarket"
    },
    {
      "description": "OC Green Sandbox Server",
      "url": "https://green-sandbox-api.tms.eu.e2open.com/tmsapi/v2/spotmarket"
    },
    {
      "description": "OC Blue Sandbox Server",
      "url": "https://blue-sandbox-api.tms.eu.e2open.com/tmsapi/v2/spotmarket"
    },
    {
      "description": "OC Violet Sandbox Server",
      "url": "https://violet-sandbox-api.tms.eu.e2open.com/tmsapi/v2/spotmarket"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Search for Spot Market loads by query.",
        "description": "This endpoint allows carriers to retrieve information about active Spot Market loads. The response is limited to 100 loads. An offset value may be sent to retrieve loads beyond the first 100.",
        "parameters": [
          {
            "name": "shipper_company",
            "in": "query",
            "description": "The name of the shipper company.",
            "schema": {
              "type": "string",
              "maxLength": 50
            }
          },
          {
            "name": "offer_group",
            "in": "query",
            "description": "The name of the offer group.",
            "schema": {
              "type": "string",
              "maxLength": 15
            }
          },
          {
            "name": "my_offers",
            "in": "query",
            "description": "Loads that the user has an offer on.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "transportation_mode",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TransportationMode"
              }
            }
          },
          {
            "name": "equipment_type",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EquipmentType"
              }
            }
          },
          {
            "name": "pick_start_date",
            "description": "If pick_end_date is submitted, this field must also be sent.",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "yyyy-MM-dd'T'HH:mm:ssZ",
              "example": "1970-01-01T23:59:59-04:00"
            }
          },
          {
            "name": "pick_end_date",
            "description": "If pick_start_date is submitted, this field must also be sent.",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "yyyy-MM-dd'T'HH:mm:ssZ",
              "example": "1970-01-01T23:59:59-04:00"
            }
          },
          {
            "name": "last_offer_start_date",
            "description": "If last_offer_end_date is submitted, this field must also be sent.",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "yyyy-MM-dd'T'HH:mm:ssZ",
              "example": "1970-01-01T23:59:59-04:00"
            }
          },
          {
            "name": "last_offer_end_date",
            "description": "If last_offer_start_date is submitted, this field must also be sent.",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "yyyy-MM-dd'T'HH:mm:ssZ",
              "example": "1970-01-01T23:59:59-04:00"
            }
          },
          {
            "name": "location_stop_type",
            "description": "If this field is submitted, one of the following fields must also be sent - location_name, location_city, location_state, location_postal_code, or location_country.",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/StopType"
            }
          },
          {
            "name": "location_name",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 50
            }
          },
          {
            "name": "location_city",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 50
            }
          },
          {
            "name": "location_state",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 4
            }
          },
          {
            "name": "location_postal_code",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 15
            }
          },
          {
            "name": "location_country",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2
            }
          },
          {
            "name": "offset",
            "description": "Used to retrieve loads beyond the first 100.",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An array of Spot Market loads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpotMarketLoadQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "User Not Authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "Precondition Required. Carrier is not assigned to any shippers' Spot Markets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected Error"
          }
        }
      }
    },
    "/load/{loadID}/": {
      "parameters": [
        {
          "in": "path",
          "name": "loadID",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        }
      ],
      "get": {
        "summary": "Get a specific Spot Market load.",
        "description": "This endpoint allows carriers to retrieve information about a specific Spot Market load.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpotMarketLoad"
                }
              }
            }
          },
          "204": {
            "description": "No Content. Requested load is no longer on the Spot Market or does not exist."
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid Credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "User Not Authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "Precondition Required. Carrier is not assigned to any shippers' Spot Markets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/load/{loadID}/chargecodes": {
      "parameters": [
        {
          "in": "path",
          "name": "loadID",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        }
