      "SpotMarketLoad": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "shipper_name": {
            "type": "string"
          },
          "last_offer_date": {
            "type": "string",
            "format": "yyyy-MM-dd'T'HH:mm:ssZ",
            "example": "1970-01-01T23:59:59-04:00"
          },
          "number_stops": {
            "description": "The number of stops on the load.",
            "type": "integer",
            "format": "int32"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpotMarketLoadStop"
            }
          },
          "distance": {
            "$ref": "#/components/schemas/Distance"
          },
          "weight": {
            "$ref": "#/components/schemas/Weight"
          },
          "volume": {
            "$ref": "#/components/schemas/Volume"
          },
          "service_requests": {
            "nullable": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRequest"
            }
          },
          "load_comment": {
            "nullable": true,
            "type": "string",
            "maxLength": 999
          },
          "spot_market_comment": {
            "description": "This field provides any comments entered by the shipper for the Spot Market in which the load is posted.",
            "type": "string",
            "maxLength": 1000
          },
          "low_offer_interval": {
            "description": "The offer decrement value on the load.",
            "type": "number",
            "format": "double"
          },
          "low_offer": {
            "$ref": "#/components/schemas/Amount"
          },
          "you_are_low_offer": {
            "description": "Indicates that the user's company currently has the low bid for this load. This value will be null if the user does not have permission to view this value.",
            "nullable": true,
            "type": "boolean"
          },
          "number_offers": {
            "description": "The current number of offers on the load. This value will be null if the user does not have permission to view this value.",
            "nullable": true,
            "type": "integer",
            "format": "int32"
          },
          "reserve_price": {
            "$ref": "#/components/schemas/Amount"
          },
          "pieces": {
            "type": "integer",
            "format": "int32"
          },
          "pallets": {
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.9999
          },
          "pallet_spaces": {
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.9999
          },
          "pallet_exchange": {
            "type": "boolean"
          },
          "hazmat": {
            "type": "boolean"
          },
          "allowed_currencies": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "USD"
            }
          },
          "allowed_rate_type": {
            "$ref": "#/components/schemas/RateType"
          },
          "requires_detailed_offer": {
            "type": "boolean"
          },
          "taxes_apply": {
            "description": "This field indicates if the load is posted to a Spot Market configured to pay taxes to carriers. If your company is configured by the shipper to be paid tax charges and this field is set to \"true\", any detailed offers submitted for the load will have the applicable tax charges calculated and added to the offer. Refer to the body of responses sent from the POST endpoint once an offer has been successfully submitted to see how/if these taxes were applied to your offer.",
            "type": "boolean"
          },
          "mode": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpotMarketMode"
            }
          },
          "temperature": {
            "nullable": true,
            "type": "string"
          },
          "temperature_class": {
            "$ref": "#/components/schemas/TemperatureClass"
          }
        }
      },
      "SpotMarketLoadStop": {
        "type": "object",
