  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "OfferStatus": {
        "type": "string",
        "enum": [
          "ACCEPTED",
          "ACTIVE",
          "EXPIRED",
          "LOAD_EXPIRED",
          "LOAD_REMOVED",
          "OLD",
          "REJECTED",
          "WITHDRAWN"
        ]
      },
      "DistanceUOM": {
        "type": "string",
        "enum": [
          "MILES",
          "KILOMETERS"
        ],
        "default": "MILES"
      },
      "EquipmentType": {
        "type": "string",
        "enum": [
          "VAN",
          "REEFER",
          "BULK",
          "FLATBED",
          "CONTAINER",
          "OTHER"
        ]
      },
      "TransportationMode": {
        "type": "string",
        "enum": [
          "LESS_THAN_TRUCKLOAD",
          "TRUCKLOAD",
          "INTERMODAL"
        ]
      },
      "StopType": {
        "type": "string",
        "enum": [
          "PICKUP",
          "DELIVERY"
        ]
      },
      "VolumeUOM": {
        "type": "string",
        "enum": [
          "CUBIC_FEET",
          "CUBIC_METERS"
        ],
        "default": "CUBIC_FEET"
      },
      "WeightUOM": {
        "type": "string",
        "enum": [
          "POUNDS",
          "KILOGRAMS"
        ],
        "default": "POUNDS"
      },
      "RateType": {
        "type": "string",
        "enum": [
          "CONTRACT",
          "NONCONTRACT",
          "BOTH"
        ]
      },
      "CounterofferStatus": {
        "type": "string",
        "enum": [
          "ACCEPT",
          "REJECT"
        ]
      },
      "CreateOffer": {
        "type": "object",
        "properties": {
          "offer_amount": {
            "description": "The amount to be paid. Required only for basic Spot Market offers.",
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "example": "USD"
          },
          "expiration_date": {
            "description": "The date the offer will expire at.",
            "type": "string",
            "format": "yyyy-MM-dd'T'HH:mm:ssZ",
            "example": "1970-01-01T23:59:59-04:00"
          },
          "offer_group": {
            "description": "If multiple offers are placed referencing the same offer group and one of those offers is accepted by a shipper, the remaining outstanding offers in the Offer Group will automatically expire.",
            "type": "string",
            "maxLength": 15
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          },
          "use_contract_rate": {
            "description": "Create an offer using contract rate if this is true. \"Currency\" is required if the offer does not use a contract rate.",
            "type": "boolean"
          },
          "detailed": {
            "type": "boolean",
            "default": false,
            "description": "Whether this offer is a detailed offer. If this is true, then exactly one base charge is required, along with any number of accessorial charges. In addition, the offer_amount field will be ignored."
          },
          "apply_contract_fuel": {
            "type": "boolean",
            "default": false,
            "description": "This field indicates if you would like a contract fuel rate to apply to your offer in addition to the base charge and accessorial(s) in the offer. Once a detailed offer is submitted successfully with this field set to \u201ctrue\u201d, use the GET current offers endpoint to retrieve the fuel rate that was applied as a Fuel Surcharge accessorial. If the use_contract_rate flag is set to true, this flag is ignored, and a contract fuel rate will be added to the offer if it exists. Only allowed on detailed offers."
          },
          "base_discount": {
            "type": "number",
            "description": "The discount percent for the base charge on the offer. Only allowed on detailed offers.",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 100
          },
          "accessorial_discount": {
            "type": "number",
            "description": "The discount percent for all accessorial charges on the offer. Only allowed on detailed offers.",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 100
          },
          "mode": {
            "$ref": "#/components/schemas/SpotMarketLoadMode"
          },
          "equipment": {
            "$ref": "#/components/schemas/SpotMarketLoadEquipment"
          },
          "base_charges": {
            "type": "array",
            "description": "A list containing exactly one base charge. Only allowed on detailed offers.",
            "items": {
              "$ref": "#/components/schemas/DetailedOfferCharge"
            }
          },
          "accessorial_charges": {
            "type": "array",
            "description": "An array of detailed charges. Only allowed on detailed offers.",
            "items": {
              "$ref": "#/components/schemas/DetailedOfferCharge"
            }
          }
        }
      },
      "DetailedOfferCharge": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "number",
            "description": "The rate used to calculate the total price of this charge.",
            "format": "double",
            "default": 0
          },
          "charge_basis": {
            "type": "string",
            "description": "The charge basis used to calculate the total price of this charge. Base charges cannot be \"PCT\". The charge basis values that a shipper supports may be retrieved using the ratebasis endpoint described above.",
            "maxLength": 4
          },
          "quantity": {
            "type": "number",
            "description": "The quantity associated with the given charge basis. Only used when charge basis is \"ECH\", in which case the gross charge amount will be equal to rate * quantity. Otherwise, the quantity will be overridden using the load's values such as distance (CPM, CPKM), weight (CWT, CPKG, CHKG, CST), pallets (PLT), pallet spaces (CPPS), or pieces (CPP).",
            "format": "int32",
            "default": 0
          },
          "apply_discount": {
            "type": "boolean",
            "default": false,
            "description": "Whether the specified discount amount applies to this charge."
          },
          "charge_code": {
            "type": "string",
            "description": "The EDI code for this charge's accessorial charge code. Ignored for base charges."
          },
          "stop_sequence": {
            "type": "number",
            "default": 0,
            "description": "The stop number that this charge will apply to. When charge basis is \"CPP\", the charge's quantity will be equal to the number of pieces on the stop associated with this number."
          },
          "detail_id": {
            "description": "The identifier associated with this charge. This value is required when performing an update for a contract offer, and ignored in any other situation."
          }
        }
      },
      "ModifyOffer": {
        "type": "object",
        "properties": {
          "offer_amount": {
            "description": "The amount to be paid - the currency will be that of the offer being modified.",
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "expiration_date": {
            "description": "The date the offer will expire at.",
            "type": "string",
            "format": "yyyy-MM-dd'T'HH:mm:ssZ",
            "example": "1970-01-01T23:59:59-04:00"
          },
          "offer_group": {
            "description": "If multiple offers are placed referencing the same offer group and one of those offers is accepted by a shipper, the remaining outstanding offers in the Offer Group will automatically expire.",
            "type": "string",
            "maxLength": 15
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          },
          "use_contract_rate": {
            "description": "Update an offer using the contract rate if this is true. If true and not converting a non-contract offer to a contract offer, every charge in the contract offer must be present along with its associated detail ID (may be obtained using a get offer API call). Nocharges may be added or removed. The only changes that are allowed for existing contract offers are related to discounts. Any other changes will be rejected. If converting a detailed offer to a contract offer, submit a request with this flag set to true with no charges listed. Then after retrieving the offer details, you may update discounts with a subsequent call to this endpoint. When updating a contract offer, the following fields within the base, tax, and accessorial charges may not be changed and may be omitted&#58; rate, charge_basis, quantity, charge_code, and stop_sequence.",
            "type": "boolean"
          },
          "detailed": {
            "type": "boolean",
            "default": false,
            "description": "Whether this offer is a detailed offer. If this is true and not a contract offer, then exactly one base charge is required, along with any number of accessorial charges. In addition, the offer_amount field will be ignored."
          },
          "apply_contract_fuel": {
            "type": "boolean",
            "default": false,
            "description": "This field indicates if you would like a contract fuel rate to apply to your offer in addition to the base charge and accessorial(s) in the offer. Once a detailed offer is submitted successfully with this field set to \u201ctrue\u201d, use the GET current offers endpoint to retrieve the fuel rate that was applied as a Fuel Surcharge accessorial. If the use_contract_rate flag is set to true, this flag is ignored, and a contract fuel rate will be added to the offer if it exists. To remove a previously-added contract fuel rate, it must be removed from the accessorial_charges of the request when this field is set to \"false\". Only allowed on detailed offers."
          },
          "base_discount": {
            "type": "number",
            "description": "The discount percent for the base charge on the offer. This value will only be saved if a base charge has its discount enabled.",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 100
          },
          "accessorial_discount": {
            "type": "number",
            "description": "The discount percent for all accessorial and tax charges on the offer. This value will only be saved if an accessorial or tax charge has its discount enabled.",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 100
          },
          "mode": {
            "$ref": "#/components/schemas/SpotMarketLoadMode"
          },
          "equipment": {
            "$ref": "#/components/schemas/SpotMarketLoadEquipment"
          },
          "base_charges": {
            "type": "array",
            "description": "A list containing base charges. Only a single base charge may be submitted for a non-contract detailed offer. This field is not allowed for basic offers.",
            "items": {
              "$ref": "#/components/schemas/DetailedOfferCharge"
            }
          },
          "tax_charges": {
            "type": "array",
            "description": "A list containing tax charges. Only allowed for contract offers and must include the detail ID.",
            "items": {
              "$ref": "#/components/schemas/DetailedOfferCharge"
            }
          },
          "accessorial_charges": {
            "type": "array",
            "description": "An array of detailed charges. Only allowed on contract and detailed offers. Contract charges require the detail ID.",
            "items": {
              "$ref": "#/components/schemas/DetailedOfferCharge"
            }
          }
        }
      },
      "SpotMarketOffer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/OfferStatus"
          },
          "offer_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "counteroffer_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "offer_date": {
            "description": "The date the offer was created.",
            "type": "string",
            "format": "yyyy-MM-dd'T'HH:mm:ssZ",
            "example": "1970-01-01T23:59:59-04:00"
          },
          "expiration_date": {
            "nullable": true,
            "description": "The date the offer will expire at.",
            "type": "string",
            "format": "yyyy-MM-dd'T'HH:mm:ssZ",
            "example": "1970-01-01T23:59:59-04:00"
          },
          "offer_group": {
            "nullable": true,
            "type": "string",
            "maxLength": 15
          },
          "comment": {
            "nullable": true,
            "type": "string",
            "maxLength": 1000
          },
          "mode": {
            "$ref": "#/components/schemas/SpotMarketLoadMode"
          },
          "equipment": {
            "$ref": "#/components/schemas/SpotMarketLoadEquipment"
          },
          "lowest_offer": {
            "nullable": true,
            "description": "Whether this offer is the current lowest offer. This value will be null if the user does not have permission to view this value.",
            "type": "boolean"
          },
          "your_bid": {
            "description": "Whether this offer was submitted by your company.",
            "type": "boolean"
          },
          "contract_rate": {
            "description": "Whether this offer is a contract rate.",
            "type": "boolean"
          },
          "detailed_offer": {
            "description": "Whether this offer is a detailed offer. This field is only provided for detailed offers.",
            "type": "boolean"
          },
          "currency": {
            "description": "The currency code for all price fields in this offer. This field is only provided for detailed offers.",
            "type": "string",
            "example": "USD"
          },
          "base_discount": {
            "description": "The percent discount to be applied to base charges when the apply_discount flag is enabled for the charge.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 100.0
          },
          "accessorial_discount": {
            "description": "The percent discount to be applied to tax and accessorial charges when the apply_discount flag is enabled for the charge.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 100.0
          },
          "total_base_gross": {
            "description": "The total of all base charges prior to applying any discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "total_base_discount": {
            "description": "The total of all base discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "total_base_net": {
            "description": "The total of all base charges after applying discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "total_accessorial_gross": {
            "description": "The total of all accessorial charges prior to applying any discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "total_accessorial_discount": {
            "description": "The total of all accessorial discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "total_accessorial_net": {
            "description": "The total of all accessorial charges after applying discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "total_gross": {
            "description": "The sum of all charges prior to applying any discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "total_net": {
            "description": "The sum of charges after applying discounts. This field is only provided for detailed offers.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "base_charges": {
            "description": "An array of base rate charges. If not using a contract rate, only a single base rate will be listed. This field is only provided for detailed offers.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpotmarketCharge"
            }
          },
          "tax_charges": {
            "description": "An array of tax rate charges. This field will only be populated for some contract rates. This field is only provided for detailed offers.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpotmarketCharge"
            }
          },
          "accessorial_charges": {
            "description": "An array of accessorial rate charges. This field is only provided for detailed offers.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpotmarketCharge"
            }
          }
        }
      },
      "SpotMarketOfferResponse": {
        "type": "object",
        "properties": {
          "offers": {
            "type": "array",
