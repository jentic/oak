      "Location": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50
          },
          "address1": {
            "type": "string",
            "maxLength": 50
          },
          "address2": {
            "type": "string",
            "maxLength": 50
          },
          "address3": {
            "type": "string",
            "maxLength": 50
          },
          "city": {
            "type": "string",
            "maxLength": 50
          },
          "state": {
            "nullable": true,
            "type": "string",
            "maxLength": 4
          },
          "postal_code": {
            "nullable": true,
            "type": "string",
            "maxLength": 15
          },
          "country": {
            "type": "string",
            "maxLength": 2
          }
        }
      },
      "Amount": {
        "nullable": true,
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "example": "USD"
          }
        }
      },
      "Distance": {
        "nullable": true,
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.9999
          },
          "unit_of_measure": {
            "$ref": "#/components/schemas/DistanceUOM"
          }
        }
      },
      "Volume": {
        "nullable": true,
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.9999
          },
          "unit_of_measure": {
            "$ref": "#/components/schemas/VolumeUOM"
          }
        }
      },
      "Weight": {
        "nullable": true,
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "format": "double",
            "default": 0,
            "minimum": 0,
            "maximum": 9999999999.9999
          },
          "unit_of_measure": {
            "$ref": "#/components/schemas/WeightUOM"
          }
        }
      },
      "SpotmarketCharge": {
        "nullable": true,
        "type": "object",
        "properties": {
          "apply_discount": {
            "description": "Does a discount apply to this charge.",
            "type": "boolean"
          },
          "charge_basis": {
            "description": "The charge basis used to calculate the total price of this charge. Base charges cannot be \"PCT\". The charge basis values that a shipper supports may be retrieved using the ratebasis endpoint described above.",
            "type": "string",
            "maxLength": 4
          },
          "quantity": {
            "description": "The number of units that are multiplied by the rate to calculate the gross charge amount.",
            "type": "number",
            "format": "double"
          },
          "rate": {
            "description": "The amount charged per quantity 'unit'.",
            "type": "number",
            "format": "double"
          },
          "gross": {
            "description": "The gross amount for this charge.",
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "charge_code": {
            "description": "The EDI charge code that applies to this charge. See the chargecodes endpoint described elsewhere in this document to retrieve a list of the shipper's charge codes. This field applies only to tax and accessorial charges.",
            "type": "string",
            "maxLength": 4
          },
          "stop_sequence": {
            "description": "The sequence value of the stop. A value of zero indicates the accessorial charge applies to all stops. This field applies only to accessorial charges.",
            "type": "integer",
            "format": "int32"
          },
          "detail_id": {
            "description": "The identifier associated with this charge. This value must be sent when performing an update for a contract offer."
          }
        }
      },
      "Counteroffer": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CounterofferStatus"
          },
          "reject_reason": {
            "type": "string",
            "example": "Amount is high"
          }
        }
      },
      "TemperatureClass": {
        "type": "object",
        "properties": {
          "temperature_range": {
            "$ref": "#/components/schemas/TemperatureRange"
          },
          "carrier_instructions": {
            "description": "carrier instructions that are configured in temperature class setup",
            "type": "string",
            "nullable": true,
            "example": "Maintain temperature between 7-22 FA"
          }
        }
      },
      "TemperatureRange": {
        "description": "temperature class range configured for a shipper",
        "type": "object",
        "properties": {
          "min_temperature": {
            "description": "minimum temperature",
            "type": "integer",
            "example": 7
          },
          "max_temperature": {
            "description": "maximum temperature",
            "type": "integer",
            "example": 22
          },
          "temperature_uom": {
            "description": "The unit of measurement for the temperature - CE(Celsius), FA(Fahrenheit)",
            "type": "string",
            "enum": [
              "FA",
              "CE"
            ],
            "example": "FA"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "description": "A message explaining the error.",
            "type": "string"
          },
          "status": {
            "description": "The response code returned.",
            "type": "string"
          }
        }
      }
    }
  }
}