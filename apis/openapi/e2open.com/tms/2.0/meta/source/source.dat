      "post": {
        "summary": "Create a Spot Market offer on the load.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOffer"
              },
              "examples": {
                "Basic Non-Contract Offer": {
                  "value": {
                    "offer_amount": 350.23,
                    "currency": "USD",
                    "expiration_date": "2024-06-10T16:08:02.390Z",
                    "comment": "A comment for the offer",
                    "offer_group": "Offer Group 1",
                    "use_contract_rate": false,
                    "mode": {
                      "trans_mode": "TL",
                      "service_level": "TL STANDARAD"
                    },
                    "equipment": {
                      "description": "VAN 2",
                      "type": "VAN"
                    }
                  }
                },
                "Detailed Non-Contract Offer": {
                  "value": {
                    "currency": "USD",
                    "expiration_date": "2024-06-10T16:08:02.390Z",
                    "comment": "A comment for the offer",
                    "offer_group": "Offer Group 1",
                    "use_contract_rate": false,
                    "apply_contract_fuel": false,
                    "base_discount": 0.0,
                    "accessorial_discount": 10.0,
                    "base_charges": [
                      {
                        "rate": 45.33,
                        "charge_basis": "CPM",
                        "quantity": 1.0,
                        "apply_discount": true
                      }
                    ],
                    "accessorial_charges": [
                      {
                        "rate": 8.56,
                        "charge_basis": "CPM",
                        "apply_discount": true,
                        "charge_code": "405",
                        "stop_sequence": 1
                      },
                      {
                        "rate": 5.0,
                        "charge_basis": "PCT",
                        "apply_discount": true,
                        "charge_code": "DTU"
                      }
                    ],
                    "detailed": true,
                    "mode": {
                      "trans_mode": "TL",
                      "service_level": "TL STANDARAD"
                    },
                    "equipment": {
                      "description": "VAN 2",
                      "type": "VAN"
                    }
                  }
                },
                "Basic/Detailed Contract Offer": {
                  "value": {
                    "currency": "USD",
                    "expiration_date": "2024-06-10T16:08:02.390Z",
                    "comment": "A comment for the offer",
                    "offer_group": "Offer Group 1",
                    "use_contract_rate": true,
                    "mode": {
                      "trans_mode": "TL",
                      "service_level": "TL STANDARAD"
                    },
                    "equipment": {
                      "description": "VAN 2",
                      "type": "VAN"
                    }
                  }
                }
              }
            }
          }
        },
