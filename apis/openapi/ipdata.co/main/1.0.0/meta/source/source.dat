{
  "openapi": "3.0.3",
  "info": {
    "title": "ipdata.co IP Enrichment API",
    "description": "IP geolocation, threat intelligence, mobile carrier, timezone, currency, and ASN data for any IP address. Supports single and bulk lookups with field filtering.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.ipdata.co/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.ipdata.co",
      "description": "Primary API endpoint"
    },
    {
      "url": "https://eu-api.ipdata.co",
      "description": "EU-only routing endpoint"
    }
  ],
  "security": [
    {
      "apiKeyQuery": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api-key",
        "description": "API key passed as query parameter"
      }
    },
    "schemas": {
      "IpData": {
        "type": "object",
        "properties": {
          "ip": { "type": "string" },
          "is_eu": { "type": "boolean" },
          "city": { "type": "string" },
          "region": { "type": "string" },
          "region_code": { "type": "string" },
          "region_type": { "type": "string" },
          "country_name": { "type": "string" },
          "country_code": { "type": "string" },
          "continent_name": { "type": "string" },
          "continent_code": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "postal": { "type": "string" },
          "calling_code": { "type": "string" },
          "flag": { "type": "string" },
          "emoji_flag": { "type": "string" },
          "emoji_unicode": { "type": "string" },
          "asn": {
            "type": "object",
            "properties": {
              "asn": { "type": "string" },
              "name": { "type": "string" },
              "domain": { "type": "string" },
              "route": { "type": "string" },
              "type": { "type": "string" }
            }
          },
          "carrier": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "mcc": { "type": "string" },
              "mnc": { "type": "string" }
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "native": { "type": "string" },
                "code": { "type": "string" }
              }
            }
          },
          "currency": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "code": { "type": "string" },
              "symbol": { "type": "string" },
              "native": { "type": "string" },
              "plural": { "type": "string" }
            }
          },
          "time_zone": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "abbr": { "type": "string" },
              "offset": { "type": "string" },
              "is_dst": { "type": "boolean" },
              "current_time": { "type": "string" }
            }
          },
          "threat": {
            "type": "object",
            "properties": {
              "is_tor": { "type": "boolean" },
              "is_icloud_relay": { "type": "boolean" },
              "is_proxy": { "type": "boolean" },
              "is_datacenter": { "type": "boolean" },
              "is_anonymous": { "type": "boolean" },
              "is_known_attacker": { "type": "boolean" },
              "is_known_abuser": { "type": "boolean" },
              "is_threat": { "type": "boolean" },
              "blocklists": {
                "type": "array",
                "items": { "type": "object" }
              }
            }
          },
          "count": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "lookupCallerIp",
        "summary": "Look up the calling device's IP address",
        "description": "Returns geolocation and enrichment data for the IP address of the requesting device.",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to return (e.g., ip,city,country_name)"
          }
        ],
        "responses": {
          "200": {
            "description": "IP enrichment data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IpData" }
              }
            }
          },
          "401": { "description": "Invalid API key" },
          "403": { "description": "API key quota exceeded" }
        }
      }
    },
    "/{ip_address}": {
      "get": {
        "operationId": "lookupIpAddress",
        "summary": "Look up a specific IP address",
        "description": "Returns geolocation, threat intelligence, ASN, carrier, timezone, currency, and other enrichment data for the specified IP address.",
        "parameters": [
          {
            "name": "ip_address",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "IPv4 or IPv6 address to look up"
          },
          {
            "name": "fields",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to return"
          }
        ],
        "responses": {
          "200": {
            "description": "IP enrichment data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IpData" }
              }
            }
          },
          "400": { "description": "Invalid IP address" },
          "401": { "description": "Invalid API key" },
          "403": { "description": "API key quota exceeded" }
        }
      }
    },
    "/{ip_address}/{field}": {
      "get": {
        "operationId": "lookupIpField",
        "summary": "Look up a single field for an IP address",
        "description": "Returns a single data field for the specified IP address (e.g., /8.8.8.8/country_name).",
        "parameters": [
          {
            "name": "ip_address",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "IPv4 or IPv6 address"
          },
          {
            "name": "field",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["ip", "city", "region", "country_name", "country_code", "continent_name", "continent_code", "latitude", "longitude", "postal", "calling_code", "flag", "emoji_flag", "asn", "carrier", "languages", "currency", "time_zone", "threat"]
            },
            "description": "The specific field to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Single field value",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "400": { "description": "Invalid IP address or field" },
          "401": { "description": "Invalid API key" }
        }
      }
    },
    "/bulk": {
      "post": {
        "operationId": "bulkLookup",
        "summary": "Bulk IP address lookup",
        "description": "Look up enrichment data for up to 100 IP addresses in a single request. Available to paid plans only.",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to return"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "type": "string" },
                "maxItems": 100,
                "description": "Array of IP addresses to look up",
                "example": ["1.1.1.1", "8.8.8.8", "9.9.9.9"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array of IP enrichment data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IpData" }
                }
              }
            }
          },
          "400": { "description": "Invalid request body or too many IPs" },
          "401": { "description": "Invalid API key" },
          "403": { "description": "Bulk lookup not available on free plan" }
        }
      }
    }
  },
  "tags": [
    {
      "name": "IP Lookup",
      "description": "IP address geolocation and enrichment"
    }
  ]
}
