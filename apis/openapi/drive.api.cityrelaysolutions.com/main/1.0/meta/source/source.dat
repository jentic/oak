    "/createService": {
      "post": {
        "summary": "Create a new service",
        "description": "Submit a request to create a new service. Refer to the schema for field requirements, constraints, and valid values.",
        "operationId": "createService",
        "tags": [
          "Services"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createServiceRequest"
              },
              "example": {
                "flat_id": 190,
                "service_type_id": 1,
                "comment": "COMMENT",
                "quantity": 1.0,
                "start_date": "2023-01-01",
                "end_date": "2023-01-10",
                "start_time": "12:30",
                "end_time": "11:00",
                "next_checkin_date": "2023-01-01",
                "next_checkin_time": "10:00",
                "previous_checkout_date": "2022-12-31",
                "previous_checkout_time": "13:30",
                "related_issue": {
                  "issue_id": 1,
                  "availability_time_slots": {
                    "start_date": "2023-01-01",
                    "end_date": "2023-01-03",
                    "time_slot_range_value": "09:00_12:00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Service successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/serviceResponse"
                }
              }
            }
          }
        },
        "deprecated": false,
        "servers": [
          {
            "url": "https://drive.api.cityrelaysolutions.com/public",
            "description": "Production server"
          },
          {
            "url": "https://drive.sandbox.api.cityrelaysolutions.com/public",
            "description": "Sandbox server"
          }
        ]
      }
    },
    "/updateService": {
      "patch": {
        "summary": "Update an existing service",
        "description": "Update details of an existing service using its ID. Refer to the schema for field requirements and validation rules.",
        "operationId": "updateService",
        "tags": [
          "Services"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The unique identifier of the service to update.",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/updateServiceRequest"
              },
              "example": {
                "start_date": "2023-01-01",
                "end_date": "2023-01-10",
                "status": "RECEIVED",
                "comment": "this service is now updated",
                "start_time": "10:30",
                "end_time": "11:00",
                "next_checkin_date": "2023-01-01",
                "next_checkin_time": "10:00",
                "previous_checkout_date": "2022-12-31",
                "previous_checkout_time": "13:30"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Service successfully updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/serviceResponse"
                }
              }
            }
          }
        },
        "deprecated": false,
        "servers": [
          {
            "url": "https://drive.api.cityrelaysolutions.com/public",
            "description": "Production server"
          },
          {
            "url": "https://drive.sandbox.api.cityrelaysolutions.com/public",
