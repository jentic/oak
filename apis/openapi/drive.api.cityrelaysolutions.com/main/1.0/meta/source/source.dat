        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "name": "fromDate",
            "in": "query",
            "description": "Start date of the check-in date range (YYYY-MM-DD).",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "2020-03-30"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "description": "End date of the check-in date range (YYYY-MM-DD).",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "2020-03-30"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Results are paginated with 50 records per page.",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookings with check-in dates in the given range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bookingListResponse"
                }
              }
            }
          }
        },
        "deprecated": false,
        "servers": [
          {
            "url": "https://drive.api.cityrelaysolutions.com/public",
