              "7+BR-2BTH",
              "7+BR-3BTH",
              "7+BR-4BTH",
              "7+BR-5BTH",
              "7+BR-6BTH",
              "7+BR-7BTH",
              "7+BR-7+BTH"
            ]
          },
          "floor": {
            "type": "string"
          },
          "picture": {
            "type": "string",
            "description": "Provide a valid image URL."
          },
          "living_room": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "bedroom": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "- Auto-filled based on property_type like \"?BR\" or \"?BR-?BTH\".\n- If not match, request value is used.\n"
          },
          "bathroom": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "- Auto-filled based on property_type like \"?BR-?BTH\".\n- If not match, request value is used.\n"
          },
          "kitchen": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "balcony": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "terracy": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "patio": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "communal_garden": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "addTaskToScheduleRequest": {
        "type": "object",
        "required": [
          "task_id",
          "employee_id",
          "schedule_start_time"
        ],
        "properties": {
          "task_id": {
            "type": "integer",
            "format": "int32",
            "description": "The task must have a future due date, a status of either NEW_TASK or RECEIVED, and must not already be scheduled."
          },
          "employee_id": {
            "type": "integer",
            "format": "int32",
            "description": "The employee must belong to the same department as the task."
          },
          "schedule_start_time": {
            "type": "string",
            "format": "HH:mm",
            "description": "Scheduled start time in 24-hour format."
          }
        },
        "example": {
          "task_id": 1,
          "employee_id": 1,
          "schedule_start_time": "14:00"
        }
      },
      "updateScheduleTaskRequest": {
        "type": "object",
        "properties": {
          "employee_id": {
            "type": "integer",
            "format": "int32",
            "description": "The employee must belong to the same department as the task."
          },
          "schedule_start_time": {
            "type": "string",
            "format": "HH:mm",
            "description": "Scheduled start time in 24-hour format."
          }
        },
        "example": {
          "employee_id": 1,
          "schedule_start_time": "14:00"
        }
      },
      "updateTaskOvertimeRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ],
            "description": "Status of the overtime request."
          },
          "reason": {
            "type": "string",
            "enum": [
              "PROPERTY_DIRTY_MORE_THAN_USUAL",
              "WAITING_LINEN",
              "EXTRA_SERVICE_ON_DESCRIPTION",
              "PROPERTY_NEED_DEEP_CLEANING",
              "KEYS_ISSUE",
              "DIRTY_FLAT",
              "ACCESS_ISSUE",
              "WRONG_DEFAULT_TIME",
              "TRAVEL_TIME",
              "AI_KEYNEST",
              "AI_MISSING",
              "AL_DAMAGED",
              "EC_MAINTENANCE",
              "EC_PARTY",
              "EC_KITCHEN",
              "EC_BATHROOM",
              "EC_BEDROOM",
              "EC_PROPERTY",
              "WI_GUEST",
              "WI_HOST",
              "WI_DRIVERI",
              "WI_DRIVERR",
              "OTHER"
            ],
            "description": "Reason code for requesting overtime."
          },
          "comment": {
            "type": "string",
            "description": "Additional context or notes for the request."
          },
          "extra_time": {
            "type": "integer",
            "format": "int32",
            "description": "Extra time in minutes."
          }
        }
      },
      "createExtraServicesRequest": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "integer",
            "format": "int32"
          },
