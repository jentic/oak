                },
                "comment": {
                  "type": "string"
                },
                "extra_service_type_id": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      },
      "updateExtraServiceRequest": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "double",
            "minimum": 1.0
          },
          "comment": {
            "type": "string"
          }
        },
        "example": {
          "quantity": 2.0,
          "comment": "COMMENT"
        }
      },
      "updateCheckInInformationRequest": {
