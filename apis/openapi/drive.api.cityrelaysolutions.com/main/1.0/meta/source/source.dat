    "/updateBooking": {
      "patch": {
        "tags": [
          "Bookings"
        ],
        "summary": "Update an existing booking",
        "operationId": "updateBooking",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The unique ID of the booking to update.",
            "required": true,
            "style": "form",
            "explode": true,
