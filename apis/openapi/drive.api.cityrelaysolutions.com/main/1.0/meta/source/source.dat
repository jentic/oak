    "/createBooking": {
      "post": {
        "summary": "Create a new booking",
        "description": "Submit a new booking for a flat. Refer to the schema for required and optional fields, and input validation rules.",
        "operationId": "createBooking",
        "tags": [
          "Bookings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createBookingRequest"
              },
              "example": {
                "flat_id": 190,
                "check_in_date": "2023-01-01",
                "check_out_date": "2023-01-10",
                "number_of_people": 3,
                "guest_id": 1,
                "full_amount": 1000.0,
                "payment_method": "CC"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking successfully created.",
            "content": {
