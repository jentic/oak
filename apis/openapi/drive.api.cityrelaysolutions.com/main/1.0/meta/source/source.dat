              "image_Order": 1
            }
          ]
        }
      },
      "thirdPartyUserAuthCredentialsResponse": {
        "type": "object",
        "description": "Response containing third-party-user authentication credentials.\n\n**Note:** Not all fields will be returned for every third-party-user. \nThe presence of each field depends on the specific third-party-user's configuration.\n",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "moduleType": {
            "type": "string"
          },
          "grant_type": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "x_userId": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          }
        },
        "example": {
          "access_token": "ACCESS_TOKEN",
          "token": "TOKEN",
          "username": "thirdpartyuser123",
          "email": "thirdparty@example.com",
          "scope": "read:all",
          "moduleType": "partner",
          "grant_type": "authorization_code",
          "accountId": "acc_98765",
          "agentId": "agent_54321",
          "clientId": "client_12345",
          "user_id": "user_11111",
          "x_userId": "x_user_22222",
          "tenant_id": "tenant_33333"
        }
      },
      "relatedIssue": {
        "type": "object",
        "description": "Optional issue association with availability constraints.",
        "required": [
          "issue_id",
          "availability_time_slots"
        ],
        "properties": {
          "issue_id": {
            "type": "integer",
            "format": "int32",
            "description": "Must reference a valid issue ID and belong to the same flat."
          },
          "availability_time_slots": {
            "type": "array",
            "min_items": 1,
            "items": {
              "$ref": "#/components/schemas/availabilityTimeSlot"
            }
          }
        }
      },
      "availabilityTimeSlot": {
        "type": "object",
        "required": [
          "start_date",
          "end_date",
          "time_slot_range_value"
        ],
        "properties": {
          "start_date": {
            "type": "string",
            "format": "date",
            "example": "2023-01-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "example": "2023-01-03"
          },
          "time_slot_range_value": {
            "type": "string",
            "description": "Logical time range mapped internally to start_time and end_time.",
            "enum": [
              "09:00_12:00",
              "12:00_15:00",
              "15:00_18:00",
              "09:00_18:00",
              "18:00_23:00"
            ],
            "example": "09:00_12:00"
          }
        }
      }
