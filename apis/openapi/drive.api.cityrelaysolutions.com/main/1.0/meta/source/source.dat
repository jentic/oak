      "serviceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "RECEIVED",
              "REJECTED",
              "SCHEDULED",
              "ON_THE_WAY",
              "IN_PROGRESS",
              "DONE-CORRECT",
              "DONE-TO_BE_CHECKED",
              "DONE-QUOTE_TO_BE_CHECKED",
              "DONE-ISSUE-TO_BE_REVIEWED_BY_OPS",
              "DONE-ISSUE-OPS_CHECKED",
              "REVISIT_NEEDED",
              "CANCELLED",
              "LATE_CANCELLED"
            ]
          },
          "comment": {
            "type": "string"
          },
          "finished_comment": {
            "type": "string"
          },
          "final_price": {
            "type": "number",
            "format": "double"
          },
          "currency_code": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "The start date of the service (format: YYYY-MM-dd).\n",
            "example": "2023-01-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "The end date of the service (format: YYYY-MM-dd).\n",
            "example": "2023-01-01"
          },
          "start_time": {
            "type": "string",
            "description": "The service start time (format: HH:mm).\n",
            "example": "10:00"
          },
          "end_time": {
            "type": "string",
            "description": "The service end time (format: HH:mm).\n",
            "example": "15:00"
          },
          "next_checkin_date": {
            "type": "string",
            "format": "date",
            "description": "The checkin date of the next booking (format: YYYY-MM-dd).\n",
            "example": "2023-01-01"
          },
          "next_checkin_time": {
            "type": "string",
            "description": "The checkin time of the next booking (format: HH:mm).\n",
            "example": "15:00"
          },
          "previous_checkout_date": {
            "type": "string",
            "format": "date",
            "description": "The checkout date of the previous booking (format: YYYY-MM-dd).\n",
            "example": "2022-12-31"
          },
          "previous_checkout_time": {
            "type": "string",
            "description": "The checkout time of the pervious booking (format: HH:mm).\n",
            "example": "13:30"
          },
          "flat_id": {
            "type": "integer",
            "format": "int32"
          },
          "linked_booking_id": {
            "type": "integer",
            "format": "int32"
          },
          "service_type_id": {
            "type": "integer",
            "format": "int32"
          },
          "service_type_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Service creation timestamp (format: yyyy-MM-dd HH:mm:ss, UTC).\n",
            "example": "2023-01-01 00:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last updated timestamp (format: yyyy-MM-dd HH:mm:ss, UTC).\n",
            "example": "2023-01-01 00:00:00"
          }
        },
        "example": {
          "id": 1,
          "status": "NEW",
          "comment": "COMMENT",
          "finished_comment": "FINISHED_COMMENT",
          "final_price": 50.0,
          "currency_code": "GBP",
          "start_date": "2023-01-01",
          "end_date": "2023-01-10",
          "start_time": "12:30",
          "end_time": "11:00",
          "flat_id": 1,
          "linked_booking_id": 1,
          "service_type_id": 1,
          "service_type_name": "SERVICE_TYPE_NAME",
          "created_at": "2023-01-01 00:00:00",
          "updated_at": "2023-01-01 00:00:00"
        }
      },
