            "description": "Sandbox server"
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "loginRequest": {
        "type": "object",
        "required": [
          "clientId",
          "clientSecret"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "clientSecret": {
            "type": "string"
          }
        },
        "example": {
          "clientId": "CLIENT_ID",
          "clientSecret": "CLIENT_SECRET"
        }
      },
      "refreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "example": {
          "refreshToken": "REFRESH_TOKEN"
        }
      },
      "createServiceRequest": {
        "type": "object",
        "required": [
          "flat_id",
          "service_type_id",
          "comment",
          "quantity",
          "end_date"
        ],
        "description": "The start date/time must not be later than the end date/time.",
        "properties": {
          "flat_id": {
            "type": "integer",
            "format": "int32"
          },
          "service_type_id": {
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "format": "double",
            "description": "Ignored if the service's charge type is \"PER BR\" or \"PER TIME\" or \"PER BED\"."
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Service due date. Format: YYYY-MM-DD\n",
            "example": "2023-01-10"
          },
          "start_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "12:30"
          },
          "end_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "11:00"
          },
          "next_checkin_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-01"
          },
          "next_checkin_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "10:00"
          },
          "previous_checkout_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2022-12-31"
          },
          "previous_checkout_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "13:30"
          },
          "related_issue": {
            "$ref": "#/components/schemas/relatedIssue"
          }
        },
        "example": {
          "flat_id": 190,
          "service_type_id": 1,
          "comment": "COMMENT",
          "quantity": 1.0,
          "start_date": "2023-01-01",
          "end_date": "2023-01-10",
          "start_time": "12:30",
          "end_time": "11:00",
          "next_checkin_date": "2023-01-01",
          "next_checkin_time": "10:00",
          "previous_checkout_date": "2022-12-31",
          "previous_checkout_time": "13:30",
          "related_issue": {
            "issue_id": 1,
            "availability_time_slots": [
              {
                "start_date": "2023-01-01"
              }
            ],
            "end_date": "2023-01-03",
            "time_slot_range_value": "09:00_12:00"
          }
        }
      },
      "updateServiceRequest": {
        "type": "object",
        "description": "Cannot update services marked as DONE-CORRECT, CANCELLED, or LATE_CANCELLED.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "REJECTED",
              "DONE-CORRECT",
              "DONE-TO_BE_CHECKED",
              "DONE-ISSUE-TO_BE_REVIEWED_BY_OPS",
              "DONE-ISSUE-OPS_CHECKED",
              "CANCELLED",
              "LATE_CANCELLED"
            ],
            "description": "Status update rules:\n1. Cannot update CANCELLED, LATE_CANCELLED, DONE-QUOTE_TO_BE_CHECKED.\n2. NEW \u279d RECEIVED, REJECTED, CANCELLED\n3. RECEIVED \u279d REJECTED, CANCELLED\n4. REJECTED \u279d RECEIVED, CANCELLED\n5. SCHEDULED \u279d LATE_CANCELLED\n6. ON_THE_WAY \u279d LATE_CANCELLED\n7. IN_PROGRESS \u279d LATE_CANCELLED\n8. REVISIT_NEEDED \u279d DONE-CORRECT\n9. DONE-TO_BE_CHECKED \u279d DONE-CORRECT, DONE-ISSUE-TO_BE_REVIEWED_BY_OPS, DONE-ISSUE-OPS_CHECKED\n10. DONE-ISSUE-TO_BE_REVIEWED_BY_OPS \u279d DONE-CORRECT, DONE-TO_BE_CHECKED, DONE-ISSUE-OPS_CHECKED\n11. DONE-ISSUE-OPS_CHECKED \u279d DONE-CORRECT, DONE-TO_BE_CHECKED, DONE-ISSUE-TO_BE_REVIEWED_BY_OPS\n"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Service due date. Format: YYYY-MM-DD\n",
            "example": "2023-01-10"
          },
          "start_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "10:30"
          },
          "end_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "11:00"
          },
          "next_checkin_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-01"
          },
          "next_checkin_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "10:00"
          },
          "previous_checkout_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2022-12-31"
          },
          "previous_checkout_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "13:30"
          }
        },
        "example": {
          "id": 123,
          "comment": "Service updated successfully",
          "status": "RECEIVED",
          "start_date": "2023-01-01",
          "end_date": "2023-01-10",
          "start_time": "10:30",
          "end_time": "11:00"
        }
      },
      "createBookingRequest": {
        "type": "object",
        "required": [
          "flat_id",
          "guest_id",
          "check_in_date",
          "check_out_date",
          "number_of_people",
          "payment_method"
        ],
        "properties": {
          "flat_id": {
            "type": "integer",
            "format": "int32"
          },
          "guest_id": {
            "type": "integer",
            "format": "int32"
          },
          "check_in_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-01"
          },
          "check_out_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-10"
          },
          "number_of_people": {
            "type": "integer",
            "format": "int32"
          },
          "full_amount": {
            "type": "number",
            "format": "double"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "CC",
              "BANK"
            ]
          },
          "external_id": {
            "type": "string"
          }
        },
        "example": {
          "flat_id": 190,
          "guest_id": 1,
          "check_in_date": "2023-01-01",
          "check_out_date": "2023-01-10",
          "number_of_people": 3,
          "full_amount": 1000.0,
          "payment_method": "BANK"
        }
      },
      "updateBookingRequest": {
        "type": "object",
        "properties": {
          "guest_id": {
            "type": "integer",
            "format": "int32"
          },
          "full_amount": {
            "type": "number",
            "format": "double"
          },
          "check_in_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-01"
          },
          "check_out_date": {
            "type": "string",
            "format": "date",
            "description": "Format: YYYY-MM-DD\n",
            "example": "2023-01-10"
          },
          "check_in_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "12:00"
          },
          "check_out_time": {
            "type": "string",
            "description": "Format: HH:mm\n",
            "example": "12:30"
          },
          "check_in_comment": {
            "type": "string"
          },
          "check_out_comment": {
            "type": "string"
          },
          "check_in_time_type": {
            "type": "string",
            "enum": [
              "EARLY",
              "LATE",
              "NORMAL",
              "UNCONFIRMED"
            ]
          },
          "check_out_time_type": {
            "type": "string",
            "enum": [
              "EARLY",
              "LATE",
              "NORMAL",
              "UNCONFIRMED"
            ]
          },
          "check_in_type": {
            "type": "string",
            "enum": [
              "MEET_AND_GREET",
              "SELF_CHECK_IN",
              "UNCONFIRMED"
            ]
          },
          "extra_time_comment": {
            "type": "string"
          },
          "booking_notes": {
            "type": "string"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "CC",
              "BANK"
            ]
          },
          "number_of_people": {
            "type": "integer",
            "format": "int32"
          },
          "external_id": {
            "type": "string"
          }
        },
        "example": {
          "guest_id": 1,
          "full_amount": 1000.0,
          "check_in_date": "2023-01-01",
          "check_out_date": "2023-01-10",
          "check_in_time": "12:00",
          "check_out_time": "12:30",
          "check_in_comment": "check in comment",
          "check_out_comment": "CHECK",
          "check_in_time_type": "EARLY",
          "check_out_time_type": "LATE",
          "check_in_type": "MEET_AND_GREET",
          "extra_time_comment": "extra time comment",
          "booking_notes": "booking notes"
        }
      },
      "checkIfBookingOverlapsRequest": {
        "type": "object",
        "required": [
          "flat_id",
          "check_in_date",
          "check_out_date"
        ],
        "properties": {
          "flat_id": {
            "type": "integer",
            "format": "int32"
          },
          "check_in_date": {
            "type": "string",
            "format": "date",
            "example": "2023-01-01"
          },
          "check_out_date": {
            "type": "string",
            "format": "date",
            "example": "2023-01-10"
          }
        },
        "example": {
          "flat_id": 190,
          "check_in_date": "2023-01-01",
          "check_out_date": "2023-01-10"
        }
      },
      "createFlatRequest": {
        "required": [
          "code",
          "name",
          "type",
          "status",
          "standard_guest",
          "property_type",
          "square_meters",
          "flat_number",
          "address",
          "floor",
          "area_id",
          "strategy",
          "host_id",
          "city_id"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Each unit must have a UNIQUE code."
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "APARTMENT",
              "HOUSE",
              "VIRTUAL",
              "COMMUNAL",
              "HOTEL_ROOM",
              "CANAL_BOAT",
              "COMMERCIAL",
              "MAISONETTE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "LIVE",
              "BLOCKED",
              "CHURNED",
              "ONBOARDING",
              "PAUSED"
            ]
          },
          "churn_reason": {
            "type": "string",
            "description": "Required only if the status is 'CHURNED'.",
            "enum": [
              "UNKNOWN",
              "CR_NOTICE",
              "B2B_CHURNED",
              "GUEST_RELATED",
              "HOLIDAY_HOST",
              "HOST_MOVING_BACK",
              "LONG_LET_MID_LET",
              "HOST_NOT_ALLOWED_TO_SHORT_LET",
              "OPAGO_SERVICE",
              "REJECTED_BY_CR",
              "PROPERTY_MAINTENANCE",
              "REVENUE/PERFORMANCE",
              "SELLING_OR_SOLD",
              "UNHAPPY_SERVICE",
              "HOST_UNRESPONSIVE"
            ]
          },
          "standard_guest": {
            "type": "integer",
            "format": "int32"
          },
          "extra_guest": {
            "type": "integer",
            "format": "int32"
          },
          "property_type": {
            "type": "string",
            "description": "1. **For types with \"BR\":**\n   - \"bedroom\" is auto-calculated from property_type and will override the input.\n   - \"bedroom_info\" is generated accordingly.\n2. **For types with \"BTH\":**\n   - \"bathroom\" is auto-calculated from property_type and will override the input.\n   - \"bathrooms_info\" is generated accordingly.\n",
            "enum": [
              "VIRTUAL",
              "STUDIO",
              "OFFICE",
              "COMMUNAL",
              "COMMUNAL_LARGE",
              "PRIVATE_ROOM",
              "COMMERCIAL",
              "OTHER",
              "1BR",
              "1BR-1BTH",
              "1BR-2BTH",
              "1BR-2+BTH",
              "2BR",
              "2BR-1BTH",
              "2BR-2BTH",
              "2BR-3BTH",
              "2BR-3+BTH",
              "3BR",
              "3BR-1BTH",
              "3BR-2BTH",
              "3BR-3BTH",
              "3BR-4BTH",
              "3BR-4+BTH",
              "4BR",
              "4BR-1BTH",
              "4BR-2BTH",
              "4BR-3BTH",
              "4BR-4BTH",
              "4BR-5BTH",
              "4BR-5+BTH",
              "5BR",
              "5BR-1BTH",
              "5BR-2BTH",
              "5BR-3BTH",
              "5BR-4BTH",
              "5BR-5BTH",
              "5BR-6BTH",
              "5BR-6+BTH",
              "6BR",
              "6BR-1BTH",
              "6BR-2BTH",
              "6BR-3BTH",
              "6BR-4BTH",
              "6BR-5BTH",
              "6BR-6BTH",
              "6BR-7BTH",
              "6BR-7+BTH",
              "7BR",
              "7BR-1BTH",
              "7BR-2BTH",
              "7BR-3BTH",
              "7BR-4BTH",
              "7BR-5BTH",
              "7BR-6BTH",
              "7BR-7BTH",
              "7BR-7+BTH",
              "7+BR",
              "7+BR-1BTH",
              "7+BR-2BTH",
              "7+BR-3BTH",
              "7+BR-4BTH",
              "7+BR-5BTH",
              "7+BR-6BTH",
              "7+BR-7BTH",
              "7+BR-7+BTH"
            ]
          },
          "square_meters": {
            "type": "number"
          },
          "flat_number": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "floor": {
            "type": "string"
          },
          "area_id": {
            "type": "integer",
            "format": "int32",
            "description": "Get from 'getAreas' endpoint. Must match the selected city."
          },
          "strategy": {
            "type": "string",
            "enum": [
              "90_DAYS",
              "180_DAYS",
              "365_DAYS",
              "MID_LONG_LET",
              "LONG_LET"
            ]
          },
          "host_id": {
            "type": "integer",
            "format": "int32",
            "description": "Get from 'getHosts' endpoint. Host must have access to the selected city."
          },
          "building_id": {
            "type": "integer",
            "format": "int32",
            "description": "Optional. Use 'getBuildings' endpoint. Must belong to the same city."
          },
          "city_id": {
            "type": "integer",
            "format": "int32",
            "description": "Get from 'getAvailableCities' endpoint."
          },
          "external_id": {
            "type": "string"
          },
          "picture": {
            "type": "string",
            "description": "Provide a valid image URL."
          },
          "living_room": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "bedroom": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "- Will be auto-filled based on property_type like \"?BR\" or \"?BR-?BTH\".\n- If pattern doesn\u2019t match, value from request will be used.\n"
          },
          "bathroom": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "- Will be auto-filled based on property_type like \"?BR-?BTH\".\n- If pattern doesn\u2019t match, value from request will be used.\n"
          },
          "kitchen": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "balcony": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "terracy": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "patio": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "communal_garden": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "example": {
          "code": "CODE",
          "name": "name",
          "type": "HOUSE",
          "status": "LIVE",
          "churn_reason": "UNKNOWN",
          "standard_guest": 1,
          "extra_guest": 1,
          "property_type": "1BR-2BTH",
          "square_meters": 104.3,
          "flat_number": "flat number",
          "address": "address of the flat",
          "floor": "GROUND",
          "area_id": 1,
          "strategy": "180_DAYS",
          "host_id": 23,
          "building_id": 12,
          "city_id": 7917,
          "picture": "https://storage.googleapis.com/cro_storage/general/default-flat-picture.jpg",
          "living_room": 1,
          "bedroom": 2,
          "bathroom": 3,
          "kitchen": 1,
          "balcony": 2,
          "terracy": 0,
          "patio": 0,
          "communal_garden": 1
        }
      },
