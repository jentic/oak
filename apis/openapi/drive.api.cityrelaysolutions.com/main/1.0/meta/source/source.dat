{
  "openapi": "3.0.0",
  "info": {
    "title": "Opago API Documentation",
    "version": "1.0",
    "description": "Welcome to the **Opago API Documentation**.\nPlease review the following authentication and authorization rules:\n1. To register and obtain login credentials, contact: **antanas@cityrelay.com**\n2. Use the `**/login**` endpoint to retrieve your **access_token** and **refresh_token**.\n3. If your **access_token** has expired, retrieve a new one using the `**/refresh**` endpoint.\n4. For all endpoints (except `**/login**`), include your **access_token** in the Authorization header.\n5. Use the format: `Authorization: Bearer {{access_token}}`\nThis API is designed to provide secure and streamlined integration with the Opago platform.\n",
    "contact": {
      "name": "City Relay API Support",
      "email": "antanas@cityrelay.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/City_Relay/drive-api_documentation/1.0"
  },
  "servers": [
    {
      "url": "https://drive.api.cityrelaysolutions.com/public",
      "description": "Production Server"
    },
    {
      "url": "https://drive.sandbox.api.cityrelaysolutions.com/public",
      "description": "Sandbox Server"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Retrieve access and refresh tokens",
        "description": "Logs in using client credentials to retrieve tokens for accessing the API.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "description": "Provide your client ID and client secret to obtain access and refresh tokens.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/loginRequest"
              },
              "example": {
                "clientId": "CLIENT_ID",
                "clientSecret": "CLIENT_SECRET"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully retrieved tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/loginResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh access token",
        "description": "Use a valid refresh token to obtain a new access token.",
        "operationId": "refresh",
        "requestBody": {
          "required": true,
          "description": "Provide your refresh token to renew your access token.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/refreshRequest"
              },
              "example": {
                "refreshToken": "REFRESH_TOKEN"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully refreshed access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/refreshResponse"
                }
              }
            }
          }
        }
      }
    },
    "/getServiceTypes": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "List all service-types",
        "description": "Retrieves a paginated list of all service-types supported by the platform.",
        "operationId": "getServiceTypes",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "description": "Page number (50 records per page).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of available service-types.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/serviceTypeListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/getServicesByFlatId": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "Retrieve services for a specific flat",
        "description": "Fetches a paginated list of services associated with a given flat ID.",
        "operationId": "getServicesByFlat",
        "parameters": [
          {
            "name": "flatId",
            "in": "query",
            "required": true,
            "description": "Unique identifier of the flat.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "description": "Page number (50 records per page).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of services for the given flat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/serviceListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/getServicesByDateDue": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "Retrieve services by due date",
        "description": "Lists services that are due on a specific date.",
        "operationId": "getServicesByDueDate",
        "parameters": [
          {
            "name": "dueDate",
            "in": "query",
            "required": true,
            "description": "Date in YYYY-MM-DD format to filter services due on that day.",
            "schema": {
              "type": "string",
              "example": "2020-03-30"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "description": "Page number (50 records per page).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of services due on the specified date.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/serviceListResponse"
                }
              }
            }
          }
        }
      }
    },
