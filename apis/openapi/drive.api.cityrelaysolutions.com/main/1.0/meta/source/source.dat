    "/checkIfBookingOverlaps": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Check if booking dates overlap with existing bookings",
        "operationId": "checkIfBookingOverlaps",
        "requestBody": {
          "description": "Provide check-in and check-out dates to verify booking conflicts.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/checkIfBookingOverlapsRequest"
              },
              "example": {
                "flat_id": 1,
                "check_in_date": "2023-01-01",
                "check_out_date": "2023-01-10"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Overlap check result",
