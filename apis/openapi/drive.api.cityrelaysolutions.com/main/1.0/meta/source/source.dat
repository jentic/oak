      "createIssueRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "suggested_quote": {
            "type": "string"
          },
          "issue_type_id": {
            "type": "integer",
            "format": "int32"
          },
          "flat_id": {
            "type": "integer",
            "format": "int32"
          },
          "related_images": {
            "type": "array",
            "description": "List of related images for the issue.\nA maximum of 20 images will be processed. If more than 20 images are provided,\nonly the first 20 will be accepted and the rest will be ignored.\n",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "image_link": {
                  "type": "string",
                  "format": "uri",
                  "example": "https://storage.googleapis.com/cro_storage/issue/95111/e3dcd939-5ecf-453a-bfdb-fa388ee70aaa.jpg"
                }
              }
            }
          }
        },
        "example": {
          "id": 123,
          "location": "Kitchen",
          "suggested_quote": "Plumber",
          "comment": "This issue is now fixed",
          "issue_type_id": 2,
          "flat_id": 5,
          "related_images": [
            {
              "image_link": "https://storage.googleapis.com/cro_storage/issue/95111/e3dcd939-5ecf-453a-bfdb-fa388ee70aaa.jpg"
            },
            {
              "image_link": "https://storage.googleapis.com/cro_storage/issue/95111/f4ff167b-f15f-4a87-bae8-30d652f6a8d9.jpg"
            }
          ]
        }
      },
      "updateIssueRequest": {
        "type": "object",
        "description": "Issues marked as DELETED cannot be updated.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "WAITING_FOR_QUOTE",
              "WAITING_FOR_APPROVAL",
              "DISAPPROVED",
              "APPROVED",
              "SERVICE_RAISED",
              "RESOLVED",
              "CANCELLED",
              "TBF_BY_HOST",
              "IN_PROGRESS",
              "CLIENT_INFORMED",
              "NEEDS_REVISIT",
              "DUPLICATE"
            ]
          },
          "location": {
            "type": "string"
          },
          "suggested_quote": {
            "type": "string"
          },
          "issue_type_id": {
            "type": "integer",
            "format": "int32"
          }
        },
        "example": {
          "id": 123,
          "status": "APPROVED",
          "location": "Kitchen",
          "suggested_quote": "Plumber",
          "comment": "This issue is now fixed",
          "issue_type_id": 2
        }
      },
