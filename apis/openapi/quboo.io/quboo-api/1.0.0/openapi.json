              }
            }
          }
        }
      }
    },
    "/leaderboards": {
      "get": {
        "operationId": "listLeaderboards",
        "summary": "List leaderboards",
        "tags": [
          "Leaderboards"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
