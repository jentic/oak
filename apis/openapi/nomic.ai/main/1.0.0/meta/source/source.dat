{
  "openapi": "3.0.3",
  "info": {
    "title": "Nomic AI Embedding API",
    "description": "Generate text and image embeddings using Nomic's embedding models. Supports multiple task types for search, classification, and clustering use cases.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.nomic.ai/reference",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api-atlas.nomic.ai"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/embedding/text": {
      "post": {
        "operationId": "embedText",
        "summary": "Generate embeddings for text inputs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["texts", "model", "task_type"],
                "properties": {
                  "texts": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of text strings to embed"
                  },
                  "model": {
                    "type": "string",
                    "description": "Model to use for embeddings",
                    "enum": ["nomic-embed-text-v1", "nomic-embed-text-v1.5"],
                    "example": "nomic-embed-text-v1.5"
                  },
                  "task_type": {
                    "type": "string",
                    "description": "Task type that determines how embeddings are optimized",
                    "enum": ["search_document", "search_query", "classification", "clustering"],
                    "default": "search_document"
                  },
                  "dimensionality": {
                    "type": "integer",
                    "description": "Optional output dimensionality (for Matryoshka embedding models)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Embeddings generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "embeddings": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": { "type": "number" }
                      },
                      "description": "Array of embedding vectors"
                    },
                    "model": { "type": "string" },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "prompt_tokens": { "type": "integer" },
                        "total_tokens": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/v1/embedding/image": {
      "post": {
        "operationId": "embedImage",
        "summary": "Generate embeddings for image inputs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["images", "model"],
                "properties": {
                  "images": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of image URLs or base64-encoded image data"
                  },
                  "model": {
                    "type": "string",
                    "description": "Vision model for image embeddings",
                    "enum": ["nomic-embed-vision-v1", "nomic-embed-vision-v1.5"],
                    "example": "nomic-embed-vision-v1.5"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image embeddings generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "embeddings": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": { "type": "number" }
                      }
                    },
                    "model": { "type": "string" },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "prompt_tokens": { "type": "integer" },
                        "total_tokens": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "List available embedding models",
        "responses": {
          "200": {
            "description": "List of available models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "type": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Nomic API key (Bearer token). Obtain from the Nomic developer console."
      }
    }
  }
}
