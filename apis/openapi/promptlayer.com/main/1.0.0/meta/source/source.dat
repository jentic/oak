    },
    "/api/public/v2/evaluations/{evaluation_id}/rows": {
      "get": {
        "operationId": "getEvaluationRows",
        "summary": "Get Evaluation Rows",
        "description": "Get rows from an evaluation.",
        "parameters": [
          {
            "name": "evaluation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
