{
  "openapi": "3.0.3",
  "info": {
    "title": "PromptLayer API",
    "description": "PromptLayer prompt management and observability API. Manage prompt templates, track requests, log metadata, run evaluations, and manage datasets.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.promptlayer.com/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.promptlayer.com",
      "description": "PromptLayer API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/prompt-templates/{identifier}": {
      "get": {
        "operationId": "getPromptTemplateRaw",
        "summary": "Get Prompt Template Raw Data",
        "description": "Retrieve raw data for a prompt template by identifier.",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The prompt template identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Prompt template data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Template not found"
          }
        }
      },
      "post": {
        "operationId": "getPromptTemplate",
        "summary": "Get Prompt Template",
        "description": "Get prompt template by identifier with additional options.",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "description": "Specific version number to retrieve"
                  },
                  "label": {
                    "type": "string",
                    "description": "Label name to retrieve"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prompt template data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/prompt-templates/{identifier}/labels": {
      "get": {
        "operationId": "getPromptTemplateLabels",
        "summary": "Get Prompt Template Labels",
        "description": "Retrieve all labels for a prompt template.",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of labels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/prompts/{prompt_id}/label": {
      "post": {
        "operationId": "createPromptLabel",
        "summary": "Create Prompt Label",
        "description": "Create a new label for a prompt.",
        "parameters": [
          {
            "name": "prompt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  }
                },
                "required": ["label"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Label created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/prompt-labels/{prompt_label_id}": {
      "patch": {
        "operationId": "movePromptTemplateLabel",
        "summary": "Move Prompt Template Label",
        "description": "Move a prompt template label to a different version.",
        "parameters": [
          {
            "name": "prompt_label_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Label updated"
          }
        }
      },
      "delete": {
        "operationId": "deletePromptTemplateLabel",
        "summary": "Delete Prompt Template Label",
        "description": "Delete a prompt template label.",
        "parameters": [
          {
            "name": "prompt_label_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Label deleted"
          }
        }
      }
    },
    "/rest/prompt-templates": {
      "post": {
        "operationId": "publishPromptTemplate",
        "summary": "Publish Prompt Template",
        "description": "Publish a new prompt template.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt_name": {
                    "type": "string"
                  },
                  "prompt_template": {
                    "type": "object"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["prompt_name", "prompt_template"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template published",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/rest/prompt-templates/{identifier}": {
      "patch": {
        "operationId": "patchPromptTemplateVersion",
        "summary": "Patch Prompt Template Version",
        "description": "Update a prompt template version.",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template version updated"
          }
        }
      }
    },
    "/rest/track-metadata": {
      "post": {
        "operationId": "trackMetadata",
        "summary": "Track Metadata",
        "description": "Track metadata associated with a request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "integer"
                  },
                  "metadata": {
                    "type": "object"
                  }
                },
                "required": ["request_id", "metadata"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Metadata tracked"
          }
        }
      }
    },
    "/rest/track-group": {
      "post": {
        "operationId": "trackGroup",
        "summary": "Track Group",
        "description": "Track group association for a request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "integer"
                  },
                  "group_id": {
                    "type": "string"
                  }
                },
                "required": ["request_id", "group_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Group tracked"
          }
        }
      }
    },
    "/rest/track-prompt": {
      "post": {
        "operationId": "trackPrompt",
        "summary": "Track Prompt",
        "description": "Associate a request with a prompt template.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "integer"
                  },
                  "prompt_name": {
                    "type": "string"
                  },
                  "prompt_input_variables": {
                    "type": "object"
                  }
                },
                "required": ["request_id", "prompt_name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prompt tracked"
          }
        }
      }
    },
    "/rest/track-score": {
      "post": {
        "operationId": "trackScore",
        "summary": "Track Score",
        "description": "Track a score for a request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "integer"
                  },
                  "score": {
                    "type": "number"
                  },
                  "score_name": {
                    "type": "string"
                  }
                },
                "required": ["request_id", "score"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score tracked"
          }
        }
      }
    },
    "/reports": {
      "post": {
        "operationId": "createEvaluationPipeline",
        "summary": "Create Evaluation Pipeline",
        "description": "Create a new evaluation pipeline (report).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluation pipeline created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{report_id}": {
      "get": {
        "operationId": "getReport",
        "summary": "Get Evaluation",
        "description": "Get evaluation pipeline details.",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteReport",
        "summary": "Delete Evaluation Pipeline",
        "description": "Delete an evaluation pipeline.",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation pipeline deleted"
          }
        }
      }
    },
    "/reports/name/{report_name}": {
      "delete": {
        "operationId": "deleteReportsByName",
        "summary": "Delete Reports by Name",
        "description": "Delete evaluation pipelines by name.",
        "parameters": [
          {
            "name": "report_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reports deleted"
          }
        }
      }
    },
    "/reports/{report_id}/run": {
      "post": {
        "operationId": "runReport",
        "summary": "Run Full Evaluation",
        "description": "Run a full evaluation on the pipeline.",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation run started"
          }
        }
      }
    },
    "/reports/{report_id}/score": {
      "get": {
        "operationId": "getReportScore",
        "summary": "Get Evaluation Score",
        "description": "Get the evaluation score for a pipeline.",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation score",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{report_id}/rename": {
      "patch": {
        "operationId": "renameReport",
        "summary": "Rename Evaluation Pipeline",
        "description": "Rename an evaluation pipeline.",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pipeline renamed"
          }
        }
      }
    },
    "/report-columns": {
      "post": {
        "operationId": "addReportColumn",
        "summary": "Add Column to Evaluation Pipeline",
        "description": "Add a new column to an evaluation pipeline.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "report_id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": ["report_id", "name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Column added"
          }
        }
      }
    },
    "/report-columns/{report_column_id}": {
      "patch": {
        "operationId": "editReportColumn",
        "summary": "Edit Evaluation Pipeline Column",
        "description": "Edit a column in an evaluation pipeline.",
        "parameters": [
          {
            "name": "report_column_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Column updated"
          }
        }
      },
      "delete": {
        "operationId": "deleteReportColumn",
        "summary": "Delete Evaluation Pipeline Column",
        "description": "Delete a column from an evaluation pipeline.",
        "parameters": [
          {
            "name": "report_column_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Column deleted"
          }
        }
      }
    },
    "/api/public/v2/datasets": {
      "get": {
        "operationId": "listDatasets",
        "summary": "List Datasets",
        "description": "List all datasets in the workspace.",
        "responses": {
          "200": {
            "description": "List of datasets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v2/datasets/{dataset_id}/rows": {
      "get": {
        "operationId": "getDatasetRows",
        "summary": "Get Dataset Rows",
        "description": "Get rows from a dataset.",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dataset rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v2/requests/{request_id}": {
      "get": {
        "operationId": "getRequest",
        "summary": "Get Request",
        "description": "Get details of a logged request.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v2/traces/{trace_id}": {
      "get": {
        "operationId": "getTrace",
        "summary": "Get Trace",
        "description": "Get trace details by ID.",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trace details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
