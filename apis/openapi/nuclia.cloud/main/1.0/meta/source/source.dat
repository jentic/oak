{
  "openapi": "3.0.3",
  "info": {
    "title": "Nuclia API",
    "version": "1.0",
    "description": "Nuclia provides an AI-powered search and knowledge management platform (Agentic RAG). The API enables creation and management of knowledge boxes, document ingestion, semantic search, and AI-powered question answering.",
    "contact": {
      "url": "https://nuclia.cloud"
    },
    "x-jentic-source-url": "https://docs.nuclia.dev/docs/api"
  },
  "servers": [
    {
      "url": "https://nuclia.cloud/api/v1",
      "description": "Nuclia Cloud API"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Nuclia API key or service account token"
      }
    },
    "schemas": {
      "KnowledgeBox": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "Resource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "modified": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page_number": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "min_score": {
            "type": "number"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "paragraph",
                "document",
                "vector",
                "relations"
              ]
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "object"
          },
          "sentences": {
            "type": "object"
          },
          "paragraphs": {
            "type": "object"
          },
          "fulltext": {
            "type": "object"
          },
          "relations": {
            "type": "object"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/kb": {
      "get": {
        "summary": "List Knowledge Boxes",
        "operationId": "listKnowledgeBoxes",
        "responses": {
          "200": {
            "description": "Knowledge boxes list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "kbs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/KnowledgeBox"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Knowledge Box",
        "operationId": "createKnowledgeBox",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug",
                  "title"
                ],
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Knowledge box created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeBox"
                }
              }
            }
          }
        }
      }
    },
    "/kb/{kbid}": {
      "get": {
        "summary": "Get Knowledge Box",
        "operationId": "getKnowledgeBox",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Knowledge box details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeBox"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Knowledge Box",
        "operationId": "updateKnowledgeBox",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "summary": "Delete Knowledge Box",
        "operationId": "deleteKnowledgeBox",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/kb/{kbid}/resources": {
      "get": {
        "summary": "List Resources",
        "operationId": "listResources",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resources list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Resource"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Resource",
        "operationId": "createResource",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "texts": {
                    "type": "object"
                  },
                  "links": {
                    "type": "object"
                  },
                  "files": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resource created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          }
        }
      }
    },
    "/kb/{kbid}/resource/{rid}": {
      "get": {
        "summary": "Get Resource",
        "operationId": "getResource",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Resource",
        "operationId": "updateResource",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "texts": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "summary": "Delete Resource",
        "operationId": "deleteResource",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/kb/{kbid}/search": {
      "post": {
        "summary": "Search Knowledge Box",
        "operationId": "search",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/kb/{kbid}/find": {
      "post": {
        "summary": "Find in Knowledge Box",
        "operationId": "find",
        "description": "Semantic search with AI-powered retrieval.",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "features": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "min_score": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Find results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/kb/{kbid}/ask": {
      "post": {
        "summary": "Ask Question",
        "operationId": "ask",
        "description": "AI-powered question answering over knowledge box contents.",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "context": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "features": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string"
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/kb/{kbid}/suggest": {
      "get": {
        "summary": "Get Suggestions",
        "operationId": "suggest",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suggestions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/kb/{kbid}/labels": {
      "get": {
        "summary": "Get Labels",
        "operationId": "getLabels",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Labels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Label Set",
        "operationId": "createLabelSet",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Label set created"
          }
        }
      }
    },
    "/kb/{kbid}/upload": {
      "post": {
        "summary": "Upload File",
        "operationId": "uploadFile",
        "parameters": [
          {
            "name": "kbid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded and resource created"
          }
        }
      }
    }
  }
}