                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listTransactionResponseResources",
        "summary": "Retrieve transaction response resources",
        "description": "Retrieves the response resources associated with a transaction.",
        "tags": ["Transactions"],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "description": "Unique transaction identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction response resources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Resource"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transactionId}/events": {
      "post": {
        "operationId": "createTransactionEvent",
        "summary": "Create a transaction event",
        "description": "Creates a new event within a transaction to communicate status updates or actions to Encompass.",
        "tags": ["Transaction Events"],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "description": "Unique transaction identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionEventRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction event created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionEvent"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listTransactionEvents",
        "summary": "Retrieve all transaction events",
        "description": "Retrieves all events for a specific transaction.",
        "tags": ["Transaction Events"],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "description": "Unique transaction identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of transaction events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionEvent"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transactionId}/events/{eventId}": {
      "get": {
        "operationId": "getTransactionEvent",
        "summary": "Retrieve a specific transaction event",
        "description": "Retrieves details of a specific event within a transaction.",
        "tags": ["Transaction Events"],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "description": "Unique transaction identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "description": "Unique event identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction event details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionEvent"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Transaction or event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "OAuth2",
        "description": "OAuth 2.0 Bearer token obtained via the /oauth/token endpoint"
      }
    },
    "schemas": {
      "AccessToken": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "OAuth 2.0 access token"
          },
          "token_type": {
            "type": "string",
            "description": "Token type (bearer)"
          },
          "expires_in": {
            "type": "integer",
            "description": "Token expiration time in seconds"
          },
          "scope": {
            "type": "string",
            "description": "Granted scope"
          }
        }
      },
      "TokenIntrospection": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean",
            "description": "Whether the token is currently active"
          },
          "client_id": {
            "type": "string",
            "description": "Client identifier the token was issued to"
          },
          "token_type": {
            "type": "string",
            "description": "Token type"
          },
          "exp": {
            "type": "integer",
            "description": "Token expiration timestamp (epoch seconds)"
          },
          "scope": {
            "type": "string",
            "description": "Token scope"
          }
        }
      },
      "ProductRequest": {
        "type": "object",
        "required": ["name", "listingName", "requestTypes", "interfaceUrl", "webhooks", "entitlements"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique name for the product"
          },
          "listingName": {
            "type": "string",
            "description": "Display name shown in Encompass application"
          },
          "requestTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestType"
            },
            "description": "Transaction request types lenders/borrowers can initiate"
          },
          "interfaceUrl": {
            "type": "string",
            "format": "uri",
            "description": "UI URL for borrowers/lenders during manual ordering workflows"
          },
          "adminInterfaceUrl": {
            "type": "string",
            "format": "uri",
            "description": "UI URL for administrators during automated order setup"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Product tags"
          },
          "credentials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialSchema"
            },
            "description": "User/organization credential schema requirements"
          },
          "webhooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Webhook"
            },
            "description": "Transaction webhooks the product subscribes to"
          },
          "extensionLimit": {
            "type": "integer",
            "description": "Number of allowed custom extensions"
          },
          "entitlements": {
            "type": "object",
            "description": "Data and access entitlements for the product",
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": true,
                "description": "Data access entitlements"
              },
              "access": {
                "type": "object",
                "additionalProperties": true,
                "description": "Feature access entitlements"
              }
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique product identifier"
          },
          "name": {
            "type": "string",
            "description": "Product name"
          },
          "listingName": {
            "type": "string",
            "description": "Display name in Encompass"
          },
          "requestTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestType"
            }
          },
          "interfaceUrl": {
            "type": "string",
            "format": "uri"
          },
          "adminInterfaceUrl": {
            "type": "string",
            "format": "uri"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "credentials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialSchema"
            }
          },
          "webhooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Webhook"
            }
          },
          "extensionLimit": {
            "type": "integer"
          },
          "entitlements": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": true
              },
              "access": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "Product creation timestamp"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "description": "Product last update timestamp"
          }
        }
      },
      "RequestType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Request type name"
          },
          "description": {
            "type": "string",
            "description": "Request type description"
          }
        }
      },
      "CredentialSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Credential field name"
          },
          "label": {
            "type": "string",
            "description": "Display label"
          },
          "type": {
            "type": "string",
            "description": "Credential type (text, password, etc.)"
          },
          "required": {
            "type": "boolean",
            "description": "Whether the credential is required"
          }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook callback URL"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Event types to subscribe to"
          },
          "signingKey": {
            "type": "string",
            "description": "Key for webhook signature verification"
          }
        }
      },
      "Origin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Origin identifier"
          },
          "entityId": {
            "type": "string",
            "description": "Associated entity identifier"
          },
          "entityType": {
            "type": "string",
            "description": "Entity type (e.g., urn:elli:encompass:loan)"
          },
          "partnerAccessToken": {
            "type": "string",
            "description": "Partner access token for the origin"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Transaction identifier"
          },
          "productName": {
            "type": "string",
            "description": "Associated product name"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "completed"],
            "description": "Transaction status"
          },
          "requestType": {
            "type": "string",
            "description": "Type of transaction request"
          },
          "entityId": {
            "type": "string",
            "description": "Originating entity identifier"
          },
          "entityType": {
            "type": "string",
            "description": "Entity type"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "Transaction creation timestamp"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "description": "Transaction last update timestamp"
          },
          "request": {
            "type": "object",
            "additionalProperties": true,
            "description": "Transaction request data"
          },
          "response": {
            "type": "object",
            "additionalProperties": true,
            "description": "Transaction response data"
          }
        }
      },
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["completed"],
            "description": "Response status"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Response payload data"
          }
        }
      },
      "Resource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Resource identifier"
          },
          "name": {
            "type": "string",
            "description": "Resource file name"
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of the resource"
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          }
        }
      },
      "TransactionEventRequest": {
        "type": "object",
        "required": ["text", "type", "from"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Event title/description"
          },
          "type": {
            "type": "string",
            "description": "Event type URN (e.g., urn:elli:epc:partner:appraisal:scheduled)"
          },
          "from": {
            "type": "string",
            "description": "Sender identifier"
          },
          "comments": {
            "type": "string",
            "description": "Detailed event information"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "description": "File attachments"
          }
        }
      },
      "TransactionEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Event identifier"
          },
          "text": {
            "type": "string",
            "description": "Event title/description"
          },
          "type": {
            "type": "string",
            "description": "Event type URN"
          },
          "from": {
            "type": "string",
            "description": "Sender identifier"
          },
          "sent": {
            "type": "string",
            "format": "date-time",
            "description": "Event sent timestamp"
          },
          "comments": {
            "type": "string",
            "description": "Detailed event information"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "description": "Associated file resources"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code"
          },
          "error_description": {
            "type": "string",
            "description": "Human-readable error description"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "description": "Detailed field-level errors"
          }
        }
      }
    }
  }
}