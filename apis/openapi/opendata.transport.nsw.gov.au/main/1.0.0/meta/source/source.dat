{
  "openapi": "3.0.3",
  "info": {
    "title": "Transport for NSW Open Data API",
    "description": "Transport for NSW Open Data provides real-time and static transport data for New South Wales, Australia. Includes GTFS and GTFS-realtime feeds for public transport, trip planning, and departure information. Requires API key registration via the developer portal.",
    "version": "1.0.0",
    "contact": {
      "name": "Transport for NSW Open Data",
      "email": "OpenDataHelp@transport.nsw.gov.au",
      "url": "https://opendata.transport.nsw.gov.au"
    },
    "x-jentic-source-url": "https://opendata.transport.nsw.gov.au/developers",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.transport.nsw.gov.au/v1",
      "description": "Transport NSW API v1"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/tp/departure_mon": {
      "get": {
        "operationId": "getDepartures",
        "summary": "Get real-time departure information",
        "description": "Returns real-time departure information for a given stop, including delays and platform changes.",
        "parameters": [
          {
            "name": "outputFormat",
            "in": "query",
            "required": true,
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["rapidJSON"],
              "default": "rapidJSON"
            }
          },
          {
            "name": "coordOutputFormat",
            "in": "query",
            "description": "Coordinate output format",
            "schema": {
              "type": "string",
              "enum": ["EPSG:4326"],
              "default": "EPSG:4326"
            }
          },
          {
            "name": "type_dm",
            "in": "query",
            "required": true,
            "description": "Type of departure monitor location",
            "schema": {
              "type": "string",
              "enum": ["stop", "platform", "poi", "coord"]
            }
          },
          {
            "name": "name_dm",
            "in": "query",
            "required": true,
            "description": "Stop ID or location identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depArrMacro",
            "in": "query",
            "description": "Departure or arrival mode",
            "schema": {
              "type": "string",
              "enum": ["dep", "arr"],
              "default": "dep"
            }
          },
          {
            "name": "itdDate",
            "in": "query",
            "description": "Date in YYYYMMDD format",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "itdTime",
            "in": "query",
            "description": "Time in HHMM format",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Departure information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key"
          }
        }
      }
    },
    "/tp/trip": {
      "get": {
        "operationId": "planTrip",
        "summary": "Plan a trip between two locations",
        "description": "Calculates public transport trip options between an origin and destination, including transfers and real-time information.",
        "parameters": [
          {
            "name": "outputFormat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["rapidJSON"],
              "default": "rapidJSON"
            }
          },
          {
            "name": "coordOutputFormat",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "EPSG:4326"
            }
          },
          {
            "name": "type_origin",
            "in": "query",
            "required": true,
            "description": "Origin location type",
            "schema": {
              "type": "string",
              "enum": ["stop", "poi", "coord", "any"]
            }
          },
          {
            "name": "name_origin",
            "in": "query",
            "required": true,
            "description": "Origin stop ID or search term",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type_destination",
            "in": "query",
            "required": true,
            "description": "Destination location type",
            "schema": {
              "type": "string",
              "enum": ["stop", "poi", "coord", "any"]
            }
          },
          {
            "name": "name_destination",
            "in": "query",
            "required": true,
            "description": "Destination stop ID or search term",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "itdDate",
            "in": "query",
            "description": "Date in YYYYMMDD format",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "itdTime",
            "in": "query",
            "description": "Time in HHMM format",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depArrMacro",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["dep", "arr"],
              "default": "dep"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trip planning results"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/tp/stop_finder": {
      "get": {
        "operationId": "findStops",
        "summary": "Search for stops by name or coordinates",
        "description": "Finds public transport stops matching a search query or near given coordinates.",
        "parameters": [
          {
            "name": "outputFormat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["rapidJSON"],
              "default": "rapidJSON"
            }
          },
          {
            "name": "type_sf",
            "in": "query",
            "required": true,
            "description": "Search type",
            "schema": {
              "type": "string",
              "enum": ["stop", "any", "poi", "coord"]
            }
          },
          {
            "name": "name_sf",
            "in": "query",
            "required": true,
            "description": "Search term or stop name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "coordOutputFormat",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "EPSG:4326"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stop search results"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/gtfs/schedule/buses": {
      "get": {
        "operationId": "getGtfsScheduleBuses",
        "summary": "Download GTFS static schedule for buses",
        "description": "Returns the GTFS static schedule data for NSW bus services as a ZIP file.",
        "responses": {
          "200": {
            "description": "GTFS ZIP file",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/gtfs/realtime/buses": {
      "get": {
        "operationId": "getGtfsRealtimeBuses",
        "summary": "Get GTFS-realtime feed for buses",
        "description": "Returns real-time position and trip update data for NSW bus services in GTFS-realtime protobuf format.",
        "responses": {
          "200": {
            "description": "GTFS-realtime protobuf feed",
            "content": {
              "application/x-protobuf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/gtfs/realtime/sydneytrains": {
      "get": {
        "operationId": "getGtfsRealtimeSydneyTrains",
        "summary": "Get GTFS-realtime feed for Sydney Trains",
        "description": "Returns real-time position and trip update data for Sydney Trains services.",
        "responses": {
          "200": {
            "description": "GTFS-realtime protobuf feed",
            "content": {
              "application/x-protobuf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API key obtained from the Transport NSW Open Data developer portal. Format: 'apikey {your_api_key}'"
      }
    }
  }
}
