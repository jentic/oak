{
  "openapi": "3.0.3",
  "info": {
    "title": "ntfy API",
    "description": "Open-source push notification service. Send and receive notifications via simple HTTP requests. Supports publishing messages with titles, priorities, tags, actions, attachments, and scheduled delivery. Can be used without auth for public topics.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.ntfy.sh",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://ntfy.sh"
    }
  ],
  "security": [],
  "paths": {
    "/{topic}": {
      "post": {
        "operationId": "publishMessage",
        "summary": "Publish a notification message to a topic",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "description": "Target topic name",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Title",
            "in": "header",
            "description": "Notification title",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Priority",
            "in": "header",
            "description": "Message priority (1=min, 2=low, 3=default, 4=high, 5=max/urgent)",
            "schema": { "type": "string", "enum": ["1", "2", "3", "4", "5", "min", "low", "default", "high", "max", "urgent"] }
          },
          {
            "name": "X-Tags",
            "in": "header",
            "description": "Comma-separated emoji tags or labels",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Click",
            "in": "header",
            "description": "URL to open when notification is tapped",
            "schema": { "type": "string", "format": "uri" }
          },
          {
            "name": "X-Attach",
            "in": "header",
            "description": "URL of external file to attach",
            "schema": { "type": "string", "format": "uri" }
          },
          {
            "name": "X-Filename",
            "in": "header",
            "description": "Override filename for attachment",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Delay",
            "in": "header",
            "description": "Delay delivery (e.g. '30m', 'tomorrow 10am', unix timestamp)",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Email",
            "in": "header",
            "description": "Forward notification to email address",
            "schema": { "type": "string", "format": "email" }
          },
          {
            "name": "X-Icon",
            "in": "header",
            "description": "URL of custom notification icon",
            "schema": { "type": "string", "format": "uri" }
          },
          {
            "name": "X-Markdown",
            "in": "header",
            "description": "Enable markdown formatting (yes/1)",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Actions",
            "in": "header",
            "description": "Define action buttons (view, http, broadcast)",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "description": "Message body as plain text",
          "content": {
            "text/plain": {
              "schema": { "type": "string" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message published successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "time": { "type": "integer" },
                    "event": { "type": "string" },
                    "topic": { "type": "string" },
                    "message": { "type": "string" },
                    "title": { "type": "string" },
                    "priority": { "type": "integer" },
                    "tags": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "publishMessagePut",
        "summary": "Publish a notification message to a topic (PUT variant)",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "description": "Binary file content for attachment upload",
          "content": {
            "application/octet-stream": {
              "schema": { "type": "string", "format": "binary" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message/file published successfully"
          }
        }
      }
    },
    "/": {
      "post": {
        "operationId": "publishJsonMessage",
        "summary": "Publish a notification using a JSON payload",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["topic"],
                "properties": {
                  "topic": { "type": "string" },
                  "message": { "type": "string" },
                  "title": { "type": "string" },
                  "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "tags": { "type": "array", "items": { "type": "string" } },
                  "click": { "type": "string", "format": "uri" },
                  "attach": { "type": "string", "format": "uri" },
                  "filename": { "type": "string" },
                  "icon": { "type": "string", "format": "uri" },
                  "email": { "type": "string", "format": "email" },
                  "delay": { "type": "string" },
                  "markdown": { "type": "boolean" },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "action": { "type": "string", "enum": ["view", "http", "broadcast"] },
                        "label": { "type": "string" },
                        "url": { "type": "string" },
                        "method": { "type": "string" },
                        "headers": { "type": "object" },
                        "body": { "type": "string" },
                        "clear": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message published successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "time": { "type": "integer" },
                    "event": { "type": "string" },
                    "topic": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{topic}/json": {
      "get": {
        "operationId": "subscribeJson",
        "summary": "Subscribe to messages on a topic via JSON stream",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "poll",
            "in": "query",
            "description": "Return cached messages and close connection (set to 1)",
            "schema": { "type": "integer", "enum": [1] }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Return cached messages since duration, timestamp, ID, or 'all'",
            "schema": { "type": "string" }
          },
          {
            "name": "scheduled",
            "in": "query",
            "description": "Include scheduled messages (set to 1)",
            "schema": { "type": "integer", "enum": [1] }
          },
          {
            "name": "priority",
            "in": "query",
            "description": "Filter by priority (comma-separated)",
            "schema": { "type": "string" }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Filter by tags (comma-separated, AND logic)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "NDJSON stream of messages",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "time": { "type": "integer" },
                    "event": { "type": "string", "enum": ["open", "message", "keepalive", "poll_request"] },
                    "topic": { "type": "string" },
                    "message": { "type": "string" },
                    "title": { "type": "string" },
                    "priority": { "type": "integer" },
                    "tags": { "type": "array", "items": { "type": "string" } },
                    "click": { "type": "string" },
                    "attachment": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "type": { "type": "string" },
                        "size": { "type": "integer" },
                        "expires": { "type": "integer" },
                        "url": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{topic}/sse": {
      "get": {
        "operationId": "subscribeSse",
        "summary": "Subscribe to messages on a topic via Server-Sent Events",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "poll",
            "in": "query",
            "schema": { "type": "integer", "enum": [1] }
          },
          {
            "name": "since",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-Sent Events stream",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/{topic}/raw": {
      "get": {
        "operationId": "subscribeRaw",
        "summary": "Subscribe to messages on a topic via raw text stream (message body only)",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "poll",
            "in": "query",
            "schema": { "type": "integer", "enum": [1] }
          },
          {
            "name": "since",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Raw text stream, one message per line",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/{topic}/ws": {
      "get": {
        "operationId": "subscribeWebsocket",
        "summary": "Subscribe to messages on a topic via WebSocket",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "since",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket connection upgraded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Optional username/password authentication"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional access token authentication"
      }
    }
  }
}
