                  "type": "string"
                },
                "anzP": {
                  "description": "Anzahl Personen",
                  "type": "string"
                },
                "page": {
                  "description": "Aktuelle Ergebnisseite",
                  "type": "string"
                },
                "size": {
                  "description": "Max. Anzahl der Datens\u00e4tze pro Ergebnisseite",
