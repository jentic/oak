      "SearchFiOPT": {
        "properties": {
          "optionen": {
            "description": "\n**M\u00f6gliche Werte:**\n\n- asp (Nur Datens\u00e4tze mit Ansprechpartner)\n- ust (Nur Datens\u00e4tze mit Umsatzsteuer-ID)\n- tel (Nur Datens\u00e4tze mit Telefonnummer)\n- fax (Nur Datens\u00e4tze mit Faxnummer)\n- mrv (Nur marketingrelevante Datens\u00e4tze)\n- wv0 (Werbeverweigerer ausschlie\u00dfen)\n- web1 (Nur Datens\u00e4tze mit Webseite)\n- web0 (Nur Datens\u00e4tze ohne Webseite)\n- mal1 (Nur Datens\u00e4tze mit E-Mail)\n- mal0 (Nur Datens\u00e4tze ohne E-Mail)\n- exp1 (Nur Datens\u00e4tze die bereits vom Nutzer exportiert wurden)\n- exp0 (Nur Datens\u00e4tze die noch nicht vom Nutzer exportiert wurden)\n- exg1 (Nur Datens\u00e4tze die bereits von allen Nutzern exportiert wurden)\n- exg0 (Nur Datens\u00e4tze die noch von keinem Nutzern exportiert wurden)\n- sm1 (Nur Datens\u00e4tze mit SalesManager-Eintrag)\n- sm0 (Nur Datens\u00e4tze ohne SalesManager-Eintrag)\n- dn1 (Nur Datens\u00e4tze mit Datensatznotizen)\n- dn0 (Nur Datens\u00e4tze ohne Datensatznotizen)\n",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "asp",
                "ust",
                "tel",
                "fax",
                "mrv",
                "wv0",
                "web1",
                "web0",
                "mal1",
                "mal0",
                "exp1",
                "exp0",
                "exg1",
                "exg0",
                "sm1",
                "sm0",
                "dn1",
                "dn0"
              ]
            }
          }
        },
        "type": "object"
      },
      "ResultFiData": {
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "properties": {
                "firmen_id": {
                  "type": "string",
                  "example": "00987654321"
                },
                "land_kz": {
                  "type": "string",
                  "example": "49"
                },
                "firma": {
                  "type": "string",
                  "example": "Muster GmbH"
                },
                "register_nr": {
                  "type": "string",
                  "example": "976431"
                },
                "register_art": {
                  "type": "string",
                  "example": "HRB"
                },
                "register_ger": {
                  "type": "string",
                  "example": "Musterstadt"
                },
                "plz": {
                  "type": "string",
                  "example": "12345"
                },
                "ort": {
                  "type": "string",
                  "example": "Musterstadt"
                },
                "hinweis": {
