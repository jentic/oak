    "/datamatch/create": {
      "post": {
        "tags": [
          "DataMatch"
        ],
        "summary": "1. Projekt erstellen",
        "description": "\nLegt ein neues DataMatch-Projekt an und gibt die Projekt-ID zur\u00fcck. Den Parameter 'name' k\u00f6nnen Sie frei vergeben. Der Parameter 'type' steuert den Abgleich-Typ f\u00fcr das Projekt. Hier k\u00f6nnen Sie die folgenden Werte \u00fcbertragen:\n\n- exakt (Exakter Abgleich der Eingabedaten. Qualitativ sehr hochwertige Treffer)\n- weich (Weicher Abgleich der Eingabedaten. Qualit\u00e4t kann geringer ausfallen)\n",
        "operationId": "datamatch_1_create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "exakt",
                      "weich"
                    ]
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
