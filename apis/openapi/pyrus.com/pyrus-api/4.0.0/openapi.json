    "/auth": {
      "post": {
        "operationId": "authenticate",
        "summary": "Authenticate",
        "tags": [
          "Auth"
        ],
        "servers": [
          {
            "url": "https://accounts.pyrus.com/api/v4"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "login",
                  "security_key"
                ],
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "security_key": {
                    "type": "string"
                  },
                  "person_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auth successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
