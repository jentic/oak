  "components": {
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "api_url": {
            "type": "string"
          },
          "files_url": {
            "type": "string"
          }
        }
      },
      "TaskCreate": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "responsible": {
            "type": "object"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "subject": {
            "type": "string"
          },
          "form_id": {
            "type": "integer"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "CommentCreate": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "finished",
              "reopened"
            ]
          },
          "approval_choice": {
            "type": "string",
            "enum": [
              "approved",
              "acknowledged",
              "rejected",
              "revoked"
            ]
          }
        }
      },
      "CatalogCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "catalog_headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "MemberCreate": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "position": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}