{
  "openapi": "3.0.3",
  "info": {
    "title": "Pyrus API",
    "version": "4.0.0",
    "description": "Pyrus is a workflow automation and task management platform. The API provides endpoints for managing tasks, forms, catalogs, files, members, contacts, announcements, and lists.",
    "x-jentic-source-url": "https://pyrus.com/en/help/api"
  },
  "servers": [
    {
      "url": "https://api.pyrus.com/v4"
    }
