{
  "openapi": "3.0.3",
  "info": {
    "title": "EIA Open Data API",
    "description": "Access U.S. Energy Information Administration data including electricity, natural gas, petroleum, coal, renewable energy, and related statistics. Version 2 API with RESTful hierarchy structure.",
    "version": "2.1.11",
    "contact": {
      "name": "U.S. Energy Information Administration",
      "url": "https://www.eia.gov/opendata/"
    },
    "x-jentic-source-url": "https://www.eia.gov/opendata/documentation.php"
  },
  "x-jentic-provenance": "jentic-generated",
  "servers": [
    {
      "url": "https://api.eia.gov/v2",
      "description": "EIA Open Data API v2"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getRootCategories",
        "summary": "List top-level data categories",
        "description": "Returns the root-level categories of the EIA data hierarchy including electricity, natural gas, petroleum, coal, and more.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "description": "EIA API key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Root category listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "403": {
            "description": "Invalid API key"
          }
        }
      }
    },
    "/electricity": {
      "get": {
        "operationId": "getElectricityMetadata",
        "summary": "List electricity data subcategories",
        "description": "Returns metadata and subcategories for the electricity data route.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Electricity metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/electricity/retail-sales/data": {
      "get": {
        "operationId": "getElectricityRetailSales",
        "summary": "Retrieve electricity retail sales data",
        "description": "Returns electricity retail sales data including revenue, sales volume, prices, and customer counts filterable by state, sector, and time period.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "frequency",
            "in": "query",
            "required": false,
            "description": "Data frequency",
            "schema": {
              "type": "string",
              "enum": [
                "monthly",
                "quarterly",
                "annual"
              ]
            }
          },
          {
            "name": "data[]",
            "in": "query",
            "required": false,
            "description": "Data columns to return (e.g., revenue, sales, price, customers)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "facets[stateid][]",
            "in": "query",
            "required": false,
            "description": "Filter by state ID",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "facets[sectorid][]",
            "in": "query",
            "required": false,
            "description": "Filter by sector (RES, COM, IND, TRA, OTH, ALL)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "Start date (YYYY-MM or YYYY)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "description": "End date (YYYY-MM or YYYY)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort[0][column]",
            "in": "query",
            "required": false,
            "description": "Sort column name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort[0][direction]",
            "in": "query",
            "required": false,
            "description": "Sort direction",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of rows to skip",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "length",
            "in": "query",
            "required": false,
            "description": "Number of rows to return (max 5000)",
            "schema": {
              "type": "integer",
              "default": 5000,
              "maximum": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Electricity retail sales data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "403": {
            "description": "Invalid API key"
          }
        }
      }
    },
    "/petroleum/pri/gnd/data": {
      "get": {
        "operationId": "getPetroleumPrices",
        "summary": "Retrieve petroleum gasoline and diesel prices",
        "description": "Returns weekly retail gasoline and diesel prices by region and grade.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "frequency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "weekly",
                "monthly",
                "annual"
              ]
            }
          },
          {
            "name": "data[]",
            "in": "query",
            "required": false,
            "description": "Data columns to return (e.g., value)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "facets[duoarea][]",
            "in": "query",
            "required": false,
            "description": "Filter by area code",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "facets[product][]",
            "in": "query",
            "required": false,
            "description": "Filter by product type",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "length",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5000,
              "maximum": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Petroleum price data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/natural-gas/pri/sum/data": {
      "get": {
        "operationId": "getNaturalGasPrices",
        "summary": "Retrieve natural gas price summary data",
        "description": "Returns natural gas prices by type of consumer and region.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "frequency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "monthly",
                "annual"
              ]
            }
          },
          {
            "name": "data[]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "facets[duoarea][]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "facets[process][]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "length",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5000,
              "maximum": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Natural gas price data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/coal/shipments/receipts/data": {
      "get": {
        "operationId": "getCoalShipments",
        "summary": "Retrieve coal shipment receipt data",
        "description": "Returns coal shipment data including receipts, quantities, and prices.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "frequency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "quarterly",
                "annual"
              ]
            }
          },
          {
            "name": "data[]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "length",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5000,
              "maximum": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Coal shipment data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/total-energy/data": {
      "get": {
        "operationId": "getTotalEnergyData",
        "summary": "Retrieve total energy statistics",
        "description": "Returns comprehensive energy production, consumption, and trade data from the Monthly Energy Review.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "frequency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "monthly",
                "annual"
              ]
            }
          },
          {
            "name": "data[]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "facets[msn][]",
            "in": "query",
            "required": false,
            "description": "Filter by MSN code (Monthly Series Number)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "length",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5000,
              "maximum": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Total energy data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/seriesid/{seriesId}": {
      "get": {
        "operationId": "getLegacySeriesById",
        "summary": "Retrieve data by legacy v1 series ID",
        "description": "Legacy compatibility endpoint that maps v1 series IDs to v2 data routes. Useful for migrating from EIA API v1.",
        "parameters": [
          {
            "name": "seriesId",
            "in": "path",
            "required": true,
            "description": "Legacy EIA v1 series identifier",
            "schema": {
              "type": "string"
            },
            "example": "ELEC.GEN.ALL-99.A"
          },
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Series data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          },
          "404": {
            "description": "Series not found"
          }
        }
      }
    },
    "/electricity/retail-sales/facet/{facetId}": {
      "get": {
        "operationId": "getElectricityFacetValues",
        "summary": "List available facet values for electricity retail sales",
        "description": "Returns all valid values for a specific facet dimension in the electricity retail sales dataset.",
        "parameters": [
          {
            "name": "facetId",
            "in": "path",
            "required": true,
            "description": "Facet identifier (e.g., stateid, sectorid)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of facet values",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "response": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "facets": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "alias": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "EIA API key. Register for free at https://www.eia.gov/opendata/"
      }
    },
    "schemas": {
      "DataResponse": {
        "type": "object",
        "properties": {
          "response": {
            "type": "object",
            "properties": {
              "total": {
                "type": "string",
                "description": "Total number of matching rows"
              },
              "dateFormat": {
                "type": "string",
                "description": "Date format string (e.g., YYYY-MM, YYYY)"
              },
              "frequency": {
                "type": "string",
                "description": "Data frequency"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "period": {
                      "type": "string"
                    },
                    "stateid": {
                      "type": "string"
                    },
                    "stateDescription": {
                      "type": "string"
                    },
                    "sectorid": {
                      "type": "string"
                    },
                    "sectorName": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number",
                      "nullable": true
                    },
                    "units": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "description": {
                "type": "string"
              }
            }
          },
          "request": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "params": {
                "type": "object"
              }
            }
          },
          "apiVersion": {
            "type": "string"
          }
        }
      },
      "MetadataResponse": {
        "type": "object",
        "properties": {
          "response": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "frequency": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    }
                  }
                }
              },
              "facets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "data": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "alias": {
                      "type": "string"
                    },
                    "units": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "apiVersion": {
            "type": "string"
          }
        }
      }
    }
  }
}
