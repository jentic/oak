openapi: 3.0.3
info:
  title: Fantasy Premier League API
  version: "1.0.0"
  description: |
    The official Fantasy Premier League (FPL) game API served from
    fantasy.premierleague.com/api. It exposes Premier League fantasy football
    data: all players (elements) with prices, form, points and expected-goals
    stats; the 20 Premier League clubs; the 38 gameweeks (events) with deadlines;
    fixtures and fixture difficulty ratings; live gameweek scoring; individual FPL
    managers (entries), their squads, picks, transfers and season history; and
    classic and head-to-head mini-league standings.

    This API is public and undocumented by the Premier League. Read-only GET
    endpoints require no authentication. The spec is hand-authored from the live
    endpoints and is not an official Premier League publication. Note that every
    path ends in a trailing slash — omitting it triggers a redirect.
servers:
  - url: https://fantasy.premierleague.com/api
    description: Production FPL game API
# Every operation below is public and unauthenticated. An explicit empty
# global `security` says so unambiguously, rather than leaving it unstated;
# `/me/` overrides it with the session cookie it actually requires.
security: []
tags:
  - name: Game data
    description: Static and live game-wide data — players, teams, gameweeks, fixtures
  - name: Managers
    description: Individual FPL manager (entry) squads, picks, transfers and history
  - name: Leagues
    description: Classic and head-to-head mini-league standings
paths:
  /bootstrap-static/:
    get:
      operationId: getBootstrapStatic
      tags: [Game data]
      summary: Get all core game data — players, teams, gameweeks and settings
      description: |
        The main FPL data dump and the starting point for almost any query. Returns
        every Premier League player (elements) with price, position, ownership,
        form, total points, goals, assists, clean sheets, expected goals/assists
        and injury news; all 20 teams with attack/defence strength ratings; all 38
        gameweeks (events) with deadline times and average scores; player positions
        (element_types); chips; phases; and game settings. Use this to look up
        player IDs, team IDs and the current gameweek before calling other
        endpoints.
      responses:
        "200":
          description: Core game data
          content:
            application/json:
              schema:
                type: object
                properties:
                  events:
                    type: array
                    description: The 38 gameweeks, with deadlines and which one is current/next
                    items: { $ref: "#/components/schemas/Event" }
                  teams:
                    type: array
                    description: The 20 Premier League clubs
                    items: { $ref: "#/components/schemas/Team" }
                  elements:
                    type: array
                    description: Every player in the game, with prices and season stats
                    items: { $ref: "#/components/schemas/Element" }
                  element_types:
                    type: array
                    description: Player positions (Goalkeeper, Defender, Midfielder, Forward)
                    items: { $ref: "#/components/schemas/ElementType" }
                  element_stats:
                    type: array
                    items:
                      type: object
                      properties:
                        label: { type: string }
                        name: { type: string }
                  chips:
                    type: array
                    items: { type: object, additionalProperties: true }
                  phases:
                    type: array
                    items: { type: object, additionalProperties: true }
                  game_settings: { type: object, additionalProperties: true }
                  game_config: { type: object, additionalProperties: true }
                  total_players:
                    type: integer
                    description: Total number of FPL managers registered this season
  /fixtures/:
    get:
      operationId: getFixtures
      tags: [Game data]
      summary: List Premier League fixtures and results
      description: |
        Returns Premier League fixtures with kickoff times, scores, whether the
        match has finished, per-match stats (goals, assists, bonus, BPS) and the
        fixture difficulty rating for the home and away side. Filter to a single
        gameweek with the event parameter, or to unplayed matches with future=1.
      parameters:
        - name: event
          in: query
          required: false
          description: Return only fixtures in this gameweek (1-38)
          schema: { type: integer, minimum: 1, maximum: 38 }
        - name: future
          in: query
          required: false
          description: Set to 1 to return only fixtures that have not kicked off yet
          schema: { type: integer, enum: [0, 1] }
      responses:
        "200":
          description: Fixture list
          content:
            application/json:
              schema:
                type: array
                items: { $ref: "#/components/schemas/Fixture" }
  /element-summary/{element_id}/:
    get:
      operationId: getElementSummary
      tags: [Game data]
      summary: Get one player's detailed gameweek-by-gameweek history
      description: |
        Detailed history for a single player. Returns their score and stats for
        every gameweek played this season (history), their totals in previous
        seasons (history_past), and their remaining fixtures with difficulty
        ratings. Use the player id from the elements list in bootstrap-static.
      parameters:
        - name: element_id
          in: path
          required: true
          description: Player (element) id from bootstrap-static
          schema: { type: integer }
      responses:
        "200":
          description: Player detail
          content:
            application/json:
              schema:
                type: object
                properties:
                  fixtures:
                    type: array
                    description: The player's upcoming fixtures with difficulty ratings
                    items: { type: object, additionalProperties: true }
                  history:
                    type: array
                    description: This season's per-gameweek performance
                    items: { $ref: "#/components/schemas/ElementHistory" }
                  history_past:
                    type: array
                    description: Season-by-season totals for previous seasons
                    items: { type: object, additionalProperties: true }
        "404": { $ref: "#/components/responses/NotFound" }
  /event/{event_id}/live/:
    get:
      operationId: getEventLive
      tags: [Game data]
      summary: Get live points and stats for every player in a gameweek
      description: |
        Live scoring feed for a gameweek. Returns every player with the minutes,
        goals, assists, clean sheets, bonus, BPS and total FPL points they have
        accumulated in that gameweek, plus a per-fixture breakdown. Updates during
        matches, so this is the endpoint to poll for live scores.
      parameters:
        - name: event_id
          in: path
          required: true
          description: Gameweek number (1-38)
          schema: { type: integer, minimum: 1, maximum: 38 }
      responses:
        "200":
          description: Live gameweek data
          content:
            application/json:
              schema:
                type: object
                properties:
                  elements:
                    type: array
                    items:
                      type: object
                      properties:
                        id: { type: integer, description: Player id }
                        stats: { type: object, additionalProperties: true }
                        explain:
                          type: array
                          items: { type: object, additionalProperties: true }
        "404": { $ref: "#/components/responses/NotFound" }
  /event-status/:
    get:
      operationId: getEventStatus
      tags: [Game data]
      summary: Check whether the current gameweek's points and bonus are final
      description: |
        Reports, per day of the current gameweek, whether points have been added,
        bonus points confirmed and league standings updated. Use it to tell
        whether live scores are provisional or final.
      responses:
        "200":
          description: Gameweek processing status
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: array
                    items: { type: object, additionalProperties: true }
                  leagues:
                    type: string
                    description: Whether mini-league standings have been updated
  /dream-team/{event_id}/:
    get:
      operationId: getDreamTeam
      tags: [Game data]
      summary: Get the highest-scoring XI of a gameweek
      description: |
        The FPL "dream team" for a completed gameweek — the eleven highest-scoring
        players and the top scorer of the week. Returns 404 for a gameweek that
        has not finished.
      parameters:
        - name: event_id
          in: path
          required: true
          description: Gameweek number (1-38)
          schema: { type: integer, minimum: 1, maximum: 38 }
      responses:
        "200":
          description: Dream team
          content:
            application/json:
              schema:
                type: object
                properties:
                  top_player: { type: object, additionalProperties: true }
                  team:
                    type: array
                    items: { type: object, additionalProperties: true }
        "404": { $ref: "#/components/responses/NotFound" }
  /team/set-piece-notes/:
    get:
      operationId: getSetPieceNotes
      tags: [Game data]
      summary: Get penalty and set-piece taker notes for every club
      description: |
        Editorial notes maintained by FPL on which players take penalties, free
        kicks and corners at each of the 20 clubs.
      responses:
        "200":
          description: Set-piece notes by team
          content:
            application/json:
              schema:
                type: object
                properties:
                  last_updated: { type: string, format: date-time }
                  teams:
                    type: array
                    items:
                      type: object
                      properties:
                        id: { type: integer }
                        notes:
                          type: array
                          items: { type: object, additionalProperties: true }
  /entry/{entry_id}/:
    get:
      operationId: getEntry
      tags: [Managers]
      summary: Get an FPL manager's profile, overall rank and leagues
      description: |
        Public profile for one FPL manager (an "entry"): team name, manager name,
        region, overall points and rank, current gameweek points and rank, squad
        value, money in the bank, and every classic, head-to-head and cup league
        they are a member of.
      parameters:
        - $ref: "#/components/parameters/EntryId"
      responses:
        "200":
          description: Manager profile
          content:
            application/json:
              schema: { $ref: "#/components/schemas/Entry" }
        "404": { $ref: "#/components/responses/NotFound" }
  /entry/{entry_id}/history/:
    get:
      operationId: getEntryHistory
      tags: [Managers]
      summary: Get a manager's gameweek-by-gameweek and past-season history
      description: |
        Season history for one FPL manager. Returns their points, overall rank,
        squad value, bank, transfers made and points hits for every gameweek this
        season (current), their finishing points and rank in each previous season
        (past), and which chips they have played and when.
      parameters:
        - $ref: "#/components/parameters/EntryId"
      responses:
        "200":
          description: Manager history
          content:
            application/json:
              schema:
                type: object
                properties:
                  current:
                    type: array
                    description: This season's per-gameweek results
                    items: { $ref: "#/components/schemas/EntryHistoryEvent" }
                  past:
                    type: array
                    description: Final points and rank in previous seasons
                    items: { type: object, additionalProperties: true }
                  chips:
                    type: array
                    description: Chips played (wildcard, bench boost, triple captain, free hit)
                    items: { type: object, additionalProperties: true }
        "404": { $ref: "#/components/responses/NotFound" }
  /entry/{entry_id}/transfers/:
    get:
      operationId: getEntryTransfers
      tags: [Managers]
      summary: List every transfer a manager has made this season
      description: |
        All transfers made by one manager this season — which player was
        transferred in and out, in which gameweek, at what prices, and when.
      parameters:
        - $ref: "#/components/parameters/EntryId"
      responses:
        "200":
          description: Transfer list
          content:
            application/json:
              schema:
                type: array
                items: { type: object, additionalProperties: true }
        "404": { $ref: "#/components/responses/NotFound" }
  /entry/{entry_id}/event/{event_id}/picks/:
    get:
      operationId: getEntryPicks
      tags: [Managers]
      summary: Get a manager's squad and captain for a given gameweek
      description: |
        The fifteen players a manager picked in a particular gameweek, in bench
        order, with the captain and vice-captain flagged, any chip played, and
        that gameweek's points, rank, transfer cost and squad value. Returns 404
        for a gameweek whose deadline has not passed.
      parameters:
        - $ref: "#/components/parameters/EntryId"
        - name: event_id
          in: path
          required: true
          description: Gameweek number (1-38)
          schema: { type: integer, minimum: 1, maximum: 38 }
      responses:
        "200":
          description: Squad picks
          content:
            application/json:
              schema:
                type: object
                properties:
                  active_chip:
                    type: string
                    nullable: true
                    description: Chip played this gameweek, if any
                  automatic_subs:
                    type: array
                    items: { type: object, additionalProperties: true }
                  entry_history: { $ref: "#/components/schemas/EntryHistoryEvent" }
                  picks:
                    type: array
                    items: { $ref: "#/components/schemas/Pick" }
        "404": { $ref: "#/components/responses/NotFound" }
  /leagues-classic/{league_id}/standings/:
    get:
      operationId: getClassicLeagueStandings
      tags: [Leagues]
      summary: Get the standings table of a classic mini-league
      description: |
        Paginated standings for a classic (total-points) league, including the
        global "Overall" league (id 314). Each row gives the manager's entry id,
        team name, manager name, gameweek points, total points and current and
        previous rank. Results are 50 per page.
      parameters:
        - $ref: "#/components/parameters/LeagueId"
        - name: page_standings
          in: query
          required: false
          description: Page of the standings table to return (50 entries per page)
          schema: { type: integer, minimum: 1, default: 1 }
        - name: page_new_entries
          in: query
          required: false
          description: Page of recently joined entries to return
          schema: { type: integer, minimum: 1, default: 1 }
        - name: phase
          in: query
          required: false
          description: Scoring phase (1 = overall season, 2+ = individual months)
          schema: { type: integer, minimum: 1, default: 1 }
      responses:
        "200":
          description: League standings
          content:
            application/json:
              schema:
                type: object
                properties:
                  league: { $ref: "#/components/schemas/League" }
                  standings: { $ref: "#/components/schemas/StandingsPage" }
                  new_entries: { $ref: "#/components/schemas/StandingsPage" }
                  last_updated_data:
                    type: string
                    format: date-time
                    nullable: true
        "404": { $ref: "#/components/responses/NotFound" }
  /leagues-h2h/{league_id}/standings/:
    get:
      operationId: getH2HLeagueStandings
      tags: [Leagues]
      summary: Get the standings table of a head-to-head mini-league
      description: |
        Paginated standings for a head-to-head league, where managers play weekly
        fixtures against each other. Each row gives wins, draws, losses, league
        points and total FPL points.
      parameters:
        - $ref: "#/components/parameters/LeagueId"
        - name: page_standings
          in: query
          required: false
          description: Page of the standings table to return
          schema: { type: integer, minimum: 1, default: 1 }
        - name: page_new_entries
          in: query
          required: false
          description: Page of recently joined entries to return
          schema: { type: integer, minimum: 1, default: 1 }
      responses:
        "200":
          description: Head-to-head league standings
          content:
            application/json:
              schema:
                type: object
                properties:
                  league: { $ref: "#/components/schemas/League" }
                  standings: { $ref: "#/components/schemas/StandingsPage" }
                  new_entries: { $ref: "#/components/schemas/StandingsPage" }
        "404": { $ref: "#/components/responses/NotFound" }
  /leagues-h2h-matches/league/{league_id}/:
    get:
      operationId: getH2HLeagueMatches
      tags: [Leagues]
      summary: List the head-to-head match results of a league
      description: |
        The weekly head-to-head fixtures in a H2H league — who played whom in each
        gameweek, their scores and who won. Optionally filter to one manager.
      parameters:
        - $ref: "#/components/parameters/LeagueId"
        - name: page
          in: query
          required: false
          description: Page of matches to return
          schema: { type: integer, minimum: 1, default: 1 }
        - name: event
          in: query
          required: false
          description: Return only matches in this gameweek
          schema: { type: integer, minimum: 1, maximum: 38 }
        - name: entry
          in: query
          required: false
          description: Return only matches involving this manager's entry id
          schema: { type: integer }
      responses:
        "200":
          description: Head-to-head matches
          content:
            application/json:
              schema:
                type: object
                properties:
                  has_next: { type: boolean }
                  page: { type: integer }
                  results:
                    type: array
                    items: { type: object, additionalProperties: true }
        "404": { $ref: "#/components/responses/NotFound" }
  /me/:
    get:
      operationId: getMe
      tags: [Managers]
      summary: Get the signed-in manager's own account
      description: |
        Returns the account and entry details of the logged-in FPL user. Unlike
        every other endpoint here, this one requires an authenticated FPL session
        cookie; without one it returns an unauthenticated player object.
      security:
        - fplSessionCookie: []
      responses:
        "200":
          description: Signed-in user
          content:
            application/json:
              schema: { type: object, additionalProperties: true }
        "403": { $ref: "#/components/responses/NotFound" }
components:
  securitySchemes:
    fplSessionCookie:
      type: apiKey
      in: cookie
      name: sessionid
      description: |
        FPL session cookie issued by the Premier League login flow. Only required
        by /me/; all other endpoints in this spec are public.
  parameters:
    EntryId:
      name: entry_id
      in: path
      required: true
      description: FPL manager (entry) id — the number in the manager's team URL
      schema: { type: integer }
    LeagueId:
      name: league_id
      in: path
      required: true
      description: Mini-league id (314 is the global Overall league)
      schema: { type: integer }
  responses:
    NotFound:
      description: The requested resource does not exist or is not yet available
      content:
        application/json:
          schema:
            type: object
            properties:
              detail: { type: string }
  schemas:
    Event:
      type: object
      description: A gameweek
      properties:
        id: { type: integer, description: "Gameweek number, 1-38" }
        name: { type: string, example: "Gameweek 1" }
        deadline_time: { type: string, format: date-time }
        average_entry_score: { type: integer }
        highest_score: { type: integer, nullable: true }
        finished: { type: boolean }
        data_checked: { type: boolean }
        is_previous: { type: boolean }
        is_current: { type: boolean }
        is_next: { type: boolean }
        most_selected: { type: integer, nullable: true }
        most_transferred_in: { type: integer, nullable: true }
        most_captained: { type: integer, nullable: true }
        transfers_made: { type: integer }
      additionalProperties: true
    Team:
      type: object
      description: A Premier League club
      properties:
        id: { type: integer }
        name: { type: string, example: "Arsenal" }
        short_name: { type: string, example: "ARS" }
        code: { type: integer }
        position: { type: integer }
        played: { type: integer }
        win: { type: integer }
        draw: { type: integer }
        loss: { type: integer }
        points: { type: integer }
        strength: { type: integer }
        strength_overall_home: { type: integer }
        strength_overall_away: { type: integer }
        strength_attack_home: { type: integer }
        strength_attack_away: { type: integer }
        strength_defence_home: { type: integer }
        strength_defence_away: { type: integer }
      additionalProperties: true
    Element:
      type: object
      description: A player
      properties:
        id: { type: integer }
        web_name: { type: string, description: 'Display name, e.g. "Saka"' }
        first_name: { type: string }
        second_name: { type: string }
        team: { type: integer, description: Team id }
        element_type: { type: integer, description: "Position: 1 GK, 2 DEF, 3 MID, 4 FWD" }
        now_cost: { type: integer, description: Current price in tenths of a million (55 = 5.5m) }
        cost_change_start: { type: integer }
        total_points: { type: integer }
        event_points: { type: integer }
        points_per_game: { type: string }
        form: { type: string }
        selected_by_percent: { type: string, description: Ownership percentage }
        status: { type: string, description: "a available, d doubtful, i injured, s suspended, u unavailable" }
        news: { type: string }
        chance_of_playing_next_round: { type: integer, nullable: true }
        minutes: { type: integer }
        goals_scored: { type: integer }
        assists: { type: integer }
        clean_sheets: { type: integer }
        goals_conceded: { type: integer }
        saves: { type: integer }
        bonus: { type: integer }
        bps: { type: integer }
        yellow_cards: { type: integer }
        red_cards: { type: integer }
        expected_goals: { type: string }
        expected_assists: { type: string }
        expected_goal_involvements: { type: string }
        transfers_in_event: { type: integer }
        transfers_out_event: { type: integer }
      additionalProperties: true
    ElementType:
      type: object
      description: A playing position
      properties:
        id: { type: integer }
        singular_name: { type: string, example: "Midfielder" }
        singular_name_short: { type: string, example: "MID" }
        plural_name: { type: string }
        squad_select: { type: integer }
        squad_min_play: { type: integer }
        squad_max_play: { type: integer }
      additionalProperties: true
    ElementHistory:
      type: object
      description: One player's performance in one gameweek
      properties:
        element: { type: integer }
        fixture: { type: integer }
        opponent_team: { type: integer }
        round: { type: integer, description: Gameweek number }
        total_points: { type: integer }
        was_home: { type: boolean }
        kickoff_time: { type: string, format: date-time }
        minutes: { type: integer }
        goals_scored: { type: integer }
        assists: { type: integer }
        clean_sheets: { type: integer }
        bonus: { type: integer }
        bps: { type: integer }
        value: { type: integer, description: Player price that gameweek }
        selected: { type: integer }
      additionalProperties: true
    Fixture:
      type: object
      description: A Premier League match
      properties:
        id: { type: integer }
        code: { type: integer }
        event: { type: integer, nullable: true, description: Gameweek number }
        kickoff_time: { type: string, format: date-time, nullable: true }
        started: { type: boolean, nullable: true }
        finished: { type: boolean }
        minutes: { type: integer }
        team_h: { type: integer, description: Home team id }
        team_a: { type: integer, description: Away team id }
        team_h_score: { type: integer, nullable: true }
        team_a_score: { type: integer, nullable: true }
        team_h_difficulty: { type: integer, description: Fixture difficulty rating 1-5 }
        team_a_difficulty: { type: integer, description: Fixture difficulty rating 1-5 }
        stats:
          type: array
          description: Per-match goals, assists, cards, saves, bonus and BPS
          items: { type: object, additionalProperties: true }
      additionalProperties: true
    Entry:
      type: object
      description: An FPL manager
      properties:
        id: { type: integer }
        name: { type: string, description: Team name }
        player_first_name: { type: string }
        player_last_name: { type: string }
        player_region_name: { type: string }
        started_event: { type: integer }
        current_event: { type: integer, nullable: true }
        summary_overall_points: { type: integer, nullable: true }
        summary_overall_rank: { type: integer, nullable: true }
        summary_event_points: { type: integer, nullable: true }
        summary_event_rank: { type: integer, nullable: true }
        last_deadline_value: { type: integer, nullable: true, description: Squad value in tenths of a million }
        last_deadline_bank: { type: integer, nullable: true, description: Money in the bank in tenths of a million }
        last_deadline_total_transfers: { type: integer }
        favourite_team: { type: integer, nullable: true }
        leagues: { type: object, additionalProperties: true }
      additionalProperties: true
    EntryHistoryEvent:
      type: object
      description: One manager's result in one gameweek
      properties:
        event: { type: integer }
        points: { type: integer }
        total_points: { type: integer }
        rank: { type: integer, nullable: true }
        overall_rank: { type: integer, nullable: true }
        bank: { type: integer }
        value: { type: integer }
        event_transfers: { type: integer }
        event_transfers_cost: { type: integer, description: Points deducted for extra transfers }
        points_on_bench: { type: integer }
      additionalProperties: true
    Pick:
      type: object
      description: One player in a manager's gameweek squad
      properties:
        element: { type: integer, description: Player id }
        position: { type: integer, description: "1-11 starting XI, 12-15 bench order" }
        multiplier: { type: integer, description: "0 benched, 1 playing, 2 captain, 3 triple captain" }
        is_captain: { type: boolean }
        is_vice_captain: { type: boolean }
      additionalProperties: true
    League:
      type: object
      properties:
        id: { type: integer }
        name: { type: string }
        created: { type: string, format: date-time }
        closed: { type: boolean }
        league_type: { type: string }
        scoring: { type: string }
        start_event: { type: integer }
        admin_entry: { type: integer, nullable: true }
        rank: { type: integer, nullable: true }
      additionalProperties: true
    StandingsPage:
      type: object
      properties:
        has_next: { type: boolean }
        page: { type: integer }
        results:
          type: array
          items:
            type: object
            properties:
              id: { type: integer }
              entry: { type: integer, description: Manager entry id }
              entry_name: { type: string, description: Team name }
              player_name: { type: string }
              event_total: { type: integer }
              total: { type: integer }
