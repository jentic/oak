        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PickupPoint"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MybringAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Mybring-API-Key",
        "description": "Mybring API key. Also requires X-Mybring-API-Uid header."
      }
    },
    "schemas": {
      "ShippingGuideRequest": {
        "type": "object",
        "properties": {
          "consignments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "language": {
            "type": "string"
          },
          "withPrice": {
            "type": "boolean"
          },
          "withExpectedDelivery": {
            "type": "boolean"
          },
          "withEnvironmentalData": {
            "type": "boolean"
          }
        }
      },
      "ShippingGuideResponse": {
        "type": "object",
        "properties": {
          "consignments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "TrackingResponse": {
        "type": "object",
        "properties": {
          "consignmentSet": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "BookingRequest": {
        "type": "object",
        "properties": {
          "consignments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schemaVersion": {
            "type": "integer"
          },
          "testIndicator": {
            "type": "boolean"
          }
        }
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "consignments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "PickupPoint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "openingHours": {
            "type": "object"
          }
        }
      },
      "PickupPointListResponse": {
        "type": "object",
        "properties": {
          "pickupPoint": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PickupPoint"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "MybringAuth": []
    }
  ]
}