        ],
        "parameters": [
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "NO",
                "DK",
                "SE",
                "FI"
              ]
            }
          },
          {
            "name": "latitude",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "longitude",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numberOfResponses",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pickupPointType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "manned",
                "locker"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
