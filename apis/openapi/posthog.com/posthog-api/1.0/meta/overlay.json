{
  "overlay": "1.0.0",
  "info": {
    "title": "Overlay for the PostHog API",
    "version": "1.0.0"
  },
  "actions": [
    {
      "description": "Remove the existing single-host servers array (https://app.posthog.com), which points at the deprecated app.posthog.com host and offers no region choice.",
      "target": "$.servers",
      "remove": true
    },
    {
      "description": "Add a region-templated server so the API can route to either PostHog Cloud region. The `region` server variable enumerates the EU and US hosts (eu.posthog.com / us.posthog.com) and defaults to eu.",
      "target": "$",
      "update": {
        "servers": [
          {
            "url": "https://{region}.posthog.com",
            "description": "PostHog Cloud. Choose the region matching your project: EU (eu.posthog.com) or US (us.posthog.com).",
            "variables": {
              "region": {
                "default": "eu",
                "enum": [
                  "eu",
                  "us"
                ],
                "description": "PostHog Cloud region host prefix. `eu` -> eu.posthog.com (EU Cloud), `us` -> us.posthog.com (US Cloud)."
              }
            }
          }
        ]
      }
    },
    {
      "description": "Add the project query endpoint (POST /api/projects/{project_id}/query/), which the curated PostHog spec omits. This is the endpoint that runs HogQL and insight (Trends/Funnels/etc.) queries and returns computed results — required to read insight data programmatically rather than only listing/creating insights.",
      "target": "$.paths",
      "update": {
        "/api/projects/{project_id}/query": {
          "post": {
            "operationId": "createQuery",
            "summary": "Run a query",
            "description": "Executes a query (HogQL or a typed insight query such as TrendsQuery, FunnelsQuery, EventsQuery) against the project and returns the computed results.",
            "tags": [
              "Query"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "query"
                    ],
                    "properties": {
                      "query": {
                        "type": "object",
                        "description": "The query node. Use `{\"kind\": \"HogQLQuery\", \"query\": \"SELECT ...\"}` for HogQL, or a typed insight query node (e.g. `{\"kind\": \"TrendsQuery\", ...}`, `{\"kind\": \"FunnelsQuery\", ...}`).",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "description": "The query node kind, e.g. HogQLQuery, TrendsQuery, FunnelsQuery, EventsQuery."
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": true
                      },
                      "client_query_id": {
                        "type": "string",
                        "description": "Optional client-provided ID to track the query."
                      },
                      "refresh": {
                        "description": "Refresh mode: whether to use cached results or recompute (e.g. \"blocking\", \"async\", \"force_cache\").",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "Query result.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "400": {
                "description": "Malformed query."
              },
              "403": {
                "description": "Authentication or permission error."
              }
            }
          }
        }
      }
    },
    {
      "description": "Add PATCH to the single-insight path (PATCH /api/projects/{project_id}/insights/{id}), which the curated PostHog spec omits (it only defines GET). Required to update an existing insight's name, description, or query in place.",
      "target": "$.paths['/api/projects/{project_id}/insights/{id}']",
      "update": {
        "patch": {
          "operationId": "updateInsight",
          "summary": "Update an insight",
          "description": "Partially updates an existing insight (e.g. its name, description, favorited flag, or query definition).",
          "tags": ["Insights"],
          "parameters": [
            {
              "name": "project_id",
              "in": "path",
              "required": true,
              "description": "The project (team) ID.",
              "schema": { "type": "string" }
            },
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "The numeric insight ID.",
              "schema": { "type": "string" }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Any subset of the insight's writable fields. Common fields: name, description, favorited, query (an InsightVizNode wrapping a typed source query), tags.",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "favorited": { "type": "boolean" },
                    "query": {
                      "type": "object",
                      "description": "The insight query node, typically {\"kind\": \"InsightVizNode\", \"source\": { ... }}.",
                      "additionalProperties": true
                    },
                    "tags": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The updated insight.",
              "content": {
                "application/json": {
                  "schema": { "type": "object", "additionalProperties": true }
                }
              }
            },
            "400": { "description": "Malformed request." },
            "403": { "description": "Authentication or permission error." },
            "404": { "description": "Insight not found." }
          }
        }
      }
    }
  ]
}
