{
  "overlay": "1.0.0",
  "info": {
    "title": "Overlay for the PostHog API",
    "version": "1.0.0"
  },
  "actions": [
    {
      "description": "Remove the existing single-host servers array (https://app.posthog.com), which points at the deprecated app.posthog.com host and offers no region choice.",
      "target": "$.servers",
      "remove": true
    },
    {
      "description": "Add a region-templated server so the API can route to either PostHog Cloud region. The `region` server variable enumerates the EU and US hosts (eu.posthog.com / us.posthog.com) and defaults to eu.",
      "target": "$",
      "update": {
        "servers": [
          {
            "url": "https://{region}.posthog.com",
            "description": "PostHog Cloud. Choose the region matching your project: EU (eu.posthog.com) or US (us.posthog.com).",
            "variables": {
              "region": {
                "default": "eu",
                "enum": [
                  "eu",
                  "us"
                ],
                "description": "PostHog Cloud region host prefix. `eu` -> eu.posthog.com (EU Cloud), `us` -> us.posthog.com (US Cloud)."
              }
            }
          }
        ]
      }
    },
    {
      "description": "Declare the `Query` tag used by the added POST /api/projects/{project_id}/query operation. The curated spec has no Query tag, so append it to the document-level tags list to keep the tag the operation references defined.",
      "target": "$.tags",
      "update": [
        {
          "name": "Query",
          "description": "Run HogQL and insight queries and retrieve computed results."
        },
        {
          "name": "Data Warehouse",
          "description": "Data Warehouse external data sources: list, inspect, and manage scheduled syncs (e.g. Stripe, GitHub, Postgres) and view their sync jobs/status."
        }
      ]
    },
    {
      "description": "Add the project query endpoint (POST /api/projects/{project_id}/query), which the curated PostHog spec omits. This is the endpoint that runs HogQL and insight (Trends/Funnels/etc.) queries and returns computed results — required to read insight data programmatically rather than only listing/creating insights.",
      "target": "$.paths",
      "update": {
        "/api/projects/{project_id}/query": {
          "post": {
            "operationId": "createQuery",
            "summary": "Run a query",
            "description": "Executes a query (HogQL or a typed insight query such as TrendsQuery, FunnelsQuery, EventsQuery) against the project and returns the computed results.",
            "tags": [
              "Query"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "query"
                    ],
                    "properties": {
                      "query": {
                        "type": "object",
                        "description": "The query node. Use `{\"kind\": \"HogQLQuery\", \"query\": \"SELECT ...\"}` for HogQL, or a typed insight query node (e.g. `{\"kind\": \"TrendsQuery\", ...}`, `{\"kind\": \"FunnelsQuery\", ...}`).",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "description": "The query node kind, e.g. HogQLQuery, TrendsQuery, FunnelsQuery, EventsQuery."
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": true
                      },
                      "client_query_id": {
                        "type": "string",
                        "description": "Optional client-provided ID to track the query."
                      },
                      "refresh": {
                        "description": "Refresh mode: whether to use cached results or recompute (e.g. \"blocking\", \"async\", \"force_cache\").",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "Query result.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "400": {
                "description": "Malformed query."
              },
              "403": {
                "description": "Authentication or permission error."
              }
            }
          }
        }
      }
    },
    {
      "description": "Add PATCH to the single-insight path (PATCH /api/projects/{project_id}/insights/{id}), which the curated PostHog spec omits (it only defines GET). Required to update an existing insight's name, description, or query in place.",
      "target": "$.paths['/api/projects/{project_id}/insights/{id}']",
      "update": {
        "patch": {
          "operationId": "updateInsight",
          "summary": "Update an insight",
          "description": "Partially updates an existing insight (e.g. its name, description, favorited flag, or query definition).",
          "tags": [
            "Insights"
          ],
          "parameters": [
            {
              "name": "project_id",
              "in": "path",
              "required": true,
              "description": "The project (team) ID.",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "The numeric insight ID.",
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Any subset of the insight's writable fields. Common fields: name, description, favorited, query (an InsightVizNode wrapping a typed source query), tags.",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "favorited": {
                      "type": "boolean"
                    },
                    "query": {
                      "type": "object",
                      "description": "The insight query node, typically {\"kind\": \"InsightVizNode\", \"source\": { ... }}.",
                      "additionalProperties": true
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The updated insight.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            },
            "400": {
              "description": "Malformed request."
            },
            "403": {
              "description": "Authentication or permission error."
            },
            "404": {
              "description": "Insight not found."
            }
          }
        }
      }
    },
    {
      "description": "Add the Data Warehouse external data sources collection endpoints (GET/POST /api/projects/{project_id}/external_data_sources), which the curated PostHog spec omits. GET lists configured warehouse sources with their sync status, latest_error, and schemas; POST creates a source. Requires external_data_source:read for GET. Path has no trailing slash (PostHog accepts both via redirect).",
      "target": "$.paths",
      "update": {
        "/api/projects/{project_id}/external_data_sources": {
          "get": {
            "operationId": "listExternalDataSources",
            "summary": "List external data sources",
            "description": "Lists the Data Warehouse external data sources configured for the project, including each source's sync status, most recent error, and schemas. Use this to check whether a scheduled warehouse sync (e.g. a GitHub or Stripe source) has fetched fresh data or is failing.",
            "tags": [
              "Data Warehouse"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "A paginated list of external data sources.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "next": {
                          "type": "string",
                          "nullable": true
                        },
                        "previous": {
                          "type": "string",
                          "nullable": true
                        },
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "description": "An external data source. Key status fields: status (e.g. Running, Completed, Error, Paused), latest_error, prefix, source_type, and schemas (per-table sync state).",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "source_type": {
                                "type": "string"
                              },
                              "prefix": {
                                "type": "string",
                                "nullable": true
                              },
                              "status": {
                                "type": "string"
                              },
                              "latest_error": {
                                "type": "string",
                                "nullable": true
                              },
                              "created_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "schemas": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": true
                                }
                              }
                            },
                            "additionalProperties": true
                          }
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              },
              "403": {
                "description": "Authentication or permission error (missing external_data_source:read scope)."
              }
            }
          },
          "post": {
            "operationId": "createExternalDataSource",
            "summary": "Create an external data source",
            "description": "Creates a new Data Warehouse external data source for the project.",
            "tags": [
              "Data Warehouse"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "description": "The source definition. Common fields: source_type, prefix, and a payload object with connection/credential details specific to the source type.",
                    "properties": {
                      "source_type": {
                        "type": "string"
                      },
                      "prefix": {
                        "type": "string"
                      },
                      "payload": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": true
                  }
                }
              }
            },
            "responses": {
              "201": {
                "description": "The created external data source.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "400": {
                "description": "Malformed request."
              },
              "403": {
                "description": "Authentication or permission error."
              }
            }
          }
        }
      }
    },
    {
      "description": "Add the single external data source endpoints (GET/PATCH/DELETE /api/projects/{project_id}/external_data_sources/{id}). GET returns detailed status and schemas for one source.",
      "target": "$.paths",
      "update": {
        "/api/projects/{project_id}/external_data_sources/{id}": {
          "get": {
            "operationId": "getExternalDataSource",
            "summary": "Retrieve an external data source",
            "description": "Retrieves a single Data Warehouse external data source, including its current sync status, latest error, and per-table schemas.",
            "tags": [
              "Data Warehouse"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "The external data source ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "The external data source.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "403": {
                "description": "Authentication or permission error."
              },
              "404": {
                "description": "Source not found."
              }
            }
          },
          "patch": {
            "operationId": "updateExternalDataSource",
            "summary": "Update an external data source",
            "description": "Partially updates an external data source's configuration.",
            "tags": [
              "Data Warehouse"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "The external data source ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "The updated external data source.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "400": {
                "description": "Malformed request."
              },
              "403": {
                "description": "Authentication or permission error."
              },
              "404": {
                "description": "Source not found."
              }
            }
          },
          "delete": {
            "operationId": "deleteExternalDataSource",
            "summary": "Delete an external data source",
            "description": "Deletes an external data source.",
            "tags": [
              "Data Warehouse"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "The external data source ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "204": {
                "description": "Deleted."
              },
              "403": {
                "description": "Authentication or permission error."
              },
              "404": {
                "description": "Source not found."
              }
            }
          }
        }
      }
    },
    {
      "description": "Add the sync-jobs listing for an external data source (GET /api/projects/{project_id}/external_data_sources/{id}/jobs). Lists individual sync runs with status and timestamps — the authoritative way to see when a warehouse source last fetched data and whether the run succeeded or errored.",
      "target": "$.paths",
      "update": {
        "/api/projects/{project_id}/external_data_sources/{id}/jobs": {
          "get": {
            "operationId": "listExternalDataSourceJobs",
            "summary": "List sync jobs for an external data source",
            "description": "Lists the individual sync jobs (runs) for a Data Warehouse external data source, each with its status and timestamps. This is the authoritative way to determine when the source last fetched data and whether the most recent run completed or errored.",
            "tags": [
              "Data Warehouse"
            ],
            "parameters": [
              {
                "name": "project_id",
                "in": "path",
                "required": true,
                "description": "The project (team) ID.",
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "The external data source ID.",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "A list of sync jobs.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "next": {
                          "type": "string",
                          "nullable": true
                        },
                        "previous": {
                          "type": "string",
                          "nullable": true
                        },
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "description": "A sync job run. Key fields: status (e.g. Running, Completed, Failed), created_at, finished_at, rows_synced, and latest_error.",
                            "additionalProperties": true
                          }
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              },
              "403": {
                "description": "Authentication or permission error."
              },
              "404": {
                "description": "Source not found."
              }
            }
          }
        }
      }
    }
  ]
}
