        "region": {
          "default": "eu",
          "enum": [
            "eu",
            "us"
          ],
          "description": "PostHog Cloud region host prefix. `eu` -> eu.posthog.com (EU Cloud), `us` -> us.posthog.com (US Cloud)."
        }
      }
    }
  ],
