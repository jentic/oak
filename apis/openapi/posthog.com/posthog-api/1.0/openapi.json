    "/api/projects/{project_id}/query": {
      "post": {
        "operationId": "createQuery",
        "summary": "Run a query",
        "description": "Executes a query (HogQL or a typed insight query such as TrendsQuery, FunnelsQuery, EventsQuery) against the project and returns the computed results.",
        "tags": [
          "Query"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "The project (team) ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "object",
                    "description": "The query node. Use `{\"kind\": \"HogQLQuery\", \"query\": \"SELECT ...\"}` for HogQL, or a typed insight query node (e.g. `{\"kind\": \"TrendsQuery\", ...}`, `{\"kind\": \"FunnelsQuery\", ...}`).",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "description": "The query node kind, e.g. HogQLQuery, TrendsQuery, FunnelsQuery, EventsQuery."
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": true
                  },
                  "client_query_id": {
                    "type": "string",
                    "description": "Optional client-provided ID to track the query."
                  },
                  "refresh": {
                    "description": "Refresh mode: whether to use cached results or recompute (e.g. \"blocking\", \"async\", \"force_cache\").",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed query."
          },
          "403": {
            "description": "Authentication or permission error."
          }
        }
      }
    },
    "/api/projects/{project_id}/external_data_sources": {
      "get": {
        "operationId": "listExternalDataSources",
        "summary": "List external data sources",
        "description": "Lists the Data Warehouse external data sources configured for the project, including each source's sync status, most recent error, and schemas. Use this to check whether a scheduled warehouse sync (e.g. a GitHub or Stripe source) has fetched fresh data or is failing.",
        "tags": [
          "Data Warehouse"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "The project (team) ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of external data sources.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "type": "string",
                      "nullable": true
                    },
                    "previous": {
                      "type": "string",
                      "nullable": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "An external data source. Key status fields: status (e.g. Running, Completed, Error, Paused), latest_error, prefix, source_type, and schemas (per-table sync state).",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "source_type": {
                            "type": "string"
                          },
                          "prefix": {
                            "type": "string",
                            "nullable": true
                          },
                          "status": {
                            "type": "string"
                          },
                          "latest_error": {
                            "type": "string",
                            "nullable": true
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "schemas": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Authentication or permission error (missing external_data_source:read scope)."
          }
        }
      },
