      "patch": {
        "operationId": "updateInsight",
        "summary": "Update an insight",
        "description": "Partially updates an existing insight (e.g. its name, description, favorited flag, or query definition).",
        "tags": [
          "Insights"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "The project (team) ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The numeric insight ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Any subset of the insight's writable fields. Common fields: name, description, favorited, query (an InsightVizNode wrapping a typed source query), tags.",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "favorited": {
                    "type": "boolean"
                  },
                  "query": {
                    "type": "object",
                    "description": "The insight query node, typically {\"kind\": \"InsightVizNode\", \"source\": { ... }}.",
                    "additionalProperties": true
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated insight.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed request."
          },
          "403": {
            "description": "Authentication or permission error."
          },
          "404": {
            "description": "Insight not found."
          }
        }
      }
    },
