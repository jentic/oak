{
  "openapi": "3.0.3",
  "info": {
    "title": "FreeCurrencyAPI",
    "description": "Free currency conversion and exchange rate API. Provides latest rates, historical rates, currency metadata, and account status.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://freecurrencyapi.com/docs",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.freecurrencyapi.com/v1",
      "description": "FreeCurrencyAPI v1"
    }
  ],
  "security": [
    {
      "apiKeyQuery": []
    }
  ],
  "paths": {
    "/latest": {
      "get": {
        "operationId": "getLatestRates",
        "summary": "Get latest exchange rates",
        "parameters": [
          {
            "name": "base_currency",
            "in": "query",
            "required": false,
            "description": "Base currency code (default: USD)",
            "schema": {
              "type": "string",
              "default": "USD"
            }
          },
          {
            "name": "currencies",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of target currency codes (e.g., EUR,USD,CAD). Returns all if omitted.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Currency code to rate mapping"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid API key"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/historical": {
      "get": {
        "operationId": "getHistoricalRates",
        "summary": "Get historical exchange rates for a specific date",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Date for historical rates (format: YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "base_currency",
            "in": "query",
            "required": false,
            "description": "Base currency code (default: USD)",
            "schema": {
              "type": "string",
              "default": "USD"
            }
          },
          {
            "name": "currencies",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of target currency codes",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/currencies": {
      "get": {
        "operationId": "getCurrencies",
        "summary": "Get list of all available currencies with metadata",
        "parameters": [
          {
            "name": "currencies",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of currency codes to filter. Returns all if omitted.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Currency metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Currency"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Get API account status and quota usage (does not count against quota)",
        "responses": {
          "200": {
            "description": "Account status and quota information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quotas": {
                      "type": "object",
                      "properties": {
                        "month": {
                          "type": "object",
                          "properties": {
                            "total": {
                              "type": "integer"
                            },
                            "used": {
                              "type": "integer"
                            },
                            "remaining": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apikey",
        "description": "API key passed as query parameter. Can also be passed as 'apikey' HTTP header."
      }
    },
    "schemas": {
      "Currency": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "symbol_native": {
            "type": "string"
          },
          "decimal_digits": {
            "type": "integer"
          },
          "rounding": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name_plural": {
            "type": "string"
          }
        }
      }
    }
  }
}
