        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GoogleAdsRow" },
            "description": "Array of result rows."
          },
          "nextPageToken": {
            "type": "string",
            "description": "Token for the next page."
          },
          "totalResultsCount": {
            "type": "string",
            "description": "Total number of results matching the query."
          },
          "fieldMask": {
            "type": "string",
            "description": "FieldMask describing which fields were requested."
          },
          "summaryRow": { "$ref": "#/components/schemas/GoogleAdsRow" },
          "requestId": { "type": "string" }
        }
      },
      "SearchGoogleAdsStreamResponse": {
        "type": "object",
        "properties": {
