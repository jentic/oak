  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth 2.0 authentication for Google Ads API. Access tokens should be passed in the Authorization header as Bearer tokens.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
            "tokenUrl": "https://oauth2.googleapis.com/token",
            "refreshUrl": "https://oauth2.googleapis.com/token",
            "scopes": {
              "https://www.googleapis.com/auth/adwords": "Full access to Google Ads accounts"
            }
          }
        }
      },
      "developerToken": {
        "type": "apiKey",
        "in": "header",
        "name": "developer-token",
        "description": "Google Ads API developer token. Required for all API requests."
      }
    },
    "parameters": {
      "customerId": {
        "name": "customerId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "The Google Ads customer ID (without hyphens), e.g. 1234567890."
      },
      "developerToken": {
        "name": "developer-token",
        "in": "header",
        "required": true,
        "schema": { "type": "string" },
        "description": "Google Ads API developer token."
      },
      "loginCustomerId": {
        "name": "login-customer-id",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "The customer ID of the manager account making the request on behalf of a client. Required when authenticating as a manager account."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request. The request was malformed or contained invalid parameters.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleAdsFailure" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized. The request is missing or has invalid authentication credentials.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleAdsFailure" }
          }
        }
      }
    },
    "schemas": {
      "GoogleAdsFailure": {
        "type": "object",
        "description": "Error response from the Google Ads API.",
        "properties": {
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GoogleAdsError" }
          },
          "requestId": {
            "type": "string",
            "description": "Unique ID of the request for debugging."
          }
        }
      },
      "GoogleAdsError": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "object",
            "description": "Error code with the specific error type.",
            "additionalProperties": { "type": "string" }
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message."
          },
          "trigger": {
            "type": "object",
            "description": "The value that triggered the error.",
            "properties": {
              "stringValue": { "type": "string" }
            }
          },
          "location": {
            "type": "object",
            "properties": {
              "fieldPathElements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fieldName": { "type": "string" },
                    "index": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "Customer": {
        "type": "object",
        "description": "A Google Ads customer account.",
        "properties": {
          "resourceName": { "type": "string", "description": "The resource name of the customer, e.g. customers/1234567890." },
          "id": { "type": "string", "description": "The ID of the customer." },
          "descriptiveName": { "type": "string", "description": "Descriptive name of the customer." },
          "currencyCode": { "type": "string", "description": "The currency code (ISO 4217) for the account." },
          "timeZone": { "type": "string", "description": "The local timezone ID of the customer." },
          "autoTaggingEnabled": { "type": "boolean" },
          "manager": { "type": "boolean", "description": "Whether the customer is a manager account." },
          "testAccount": { "type": "boolean", "description": "Whether the customer is a test account." },
          "status": { "type": "string", "enum": ["UNSPECIFIED", "UNKNOWN", "ENABLED", "CANCELED", "SUSPENDED", "CLOSED"] }
        }
      },
      "Campaign": {
        "type": "object",
        "description": "A Google Ads campaign.",
        "properties": {
          "resourceName": { "type": "string", "description": "The resource name, e.g. customers/1234567890/campaigns/111." },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["UNSPECIFIED", "UNKNOWN", "ENABLED", "PAUSED", "REMOVED"] },
          "advertisingChannelType": { "type": "string", "enum": ["UNSPECIFIED", "UNKNOWN", "SEARCH", "DISPLAY", "SHOPPING", "HOTEL", "VIDEO", "MULTI_CHANNEL", "LOCAL", "SMART", "PERFORMANCE_MAX", "LOCAL_SERVICES", "DISCOVERY", "TRAVEL", "DEMAND_GEN"] },
          "advertisingChannelSubType": { "type": "string" },
          "biddingStrategyType": { "type": "string" },
          "biddingStrategy": { "type": "string", "description": "Resource name of the portfolio bidding strategy." },
          "campaignBudget": { "type": "string", "description": "Resource name of the campaign budget." },
          "startDate": { "type": "string", "description": "Start date in yyyy-MM-dd format." },
          "endDate": { "type": "string", "description": "End date in yyyy-MM-dd format." },
          "targetCpa": {
            "type": "object",
            "properties": {
              "targetCpaMicros": { "type": "string" }
            }
          },
          "targetRoas": {
            "type": "object",
            "properties": {
              "targetRoas": { "type": "number" }
            }
          },
          "maximizeConversions": {
            "type": "object",
            "properties": {
              "targetCpaMicros": { "type": "string" }
            }
          },
          "maximizeConversionValue": {
            "type": "object",
            "properties": {
              "targetRoas": { "type": "number" }
            }
          },
          "manualCpc": {
            "type": "object",
            "properties": {
              "enhancedCpcEnabled": { "type": "boolean" }
            }
          },
          "networkSettings": {
            "type": "object",
            "properties": {
              "targetGoogleSearch": { "type": "boolean" },
              "targetSearchNetwork": { "type": "boolean" },
              "targetContentNetwork": { "type": "boolean" },
              "targetPartnerSearchNetwork": { "type": "boolean" }
            }
          },
          "geoTargetTypeSetting": {
            "type": "object",
            "properties": {
              "positiveGeoTargetType": { "type": "string" },
              "negativeGeoTargetType": { "type": "string" }
            }
          }
        }
      },
      "AdGroup": {
        "type": "object",
        "description": "A Google Ads ad group.",
        "properties": {
          "resourceName": { "type": "string" },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["UNSPECIFIED", "UNKNOWN", "ENABLED", "PAUSED", "REMOVED"] },
          "campaign": { "type": "string", "description": "Resource name of the parent campaign." },
