{
  "openapi": "3.0.3",
  "info": {
    "title": "Google Ads API",
    "description": "The Google Ads API lets developers build tools and integrations that manage Google Ads accounts, campaigns, ads, keywords, bidding strategies, budgets, reporting, and conversions. The REST interface mirrors the gRPC API with resource-oriented URL patterns using custom methods such as :mutate, :search, and :searchStream.",
    "version": "v17",
    "contact": {
      "name": "Google Ads API Support",
      "url": "https://developers.google.com/google-ads/api/support"
    },
    "license": {
      "name": "Google APIs Terms of Service",
      "url": "https://developers.google.com/terms"
    },
    "x-jentic-source-url": "https://developers.google.com/google-ads/api/docs/start"
  },
  "servers": [
    {
      "url": "https://googleads.googleapis.com/v17",
      "description": "Google Ads API v17 production server"
    }
  ],
  "security": [
    {
      "oauth2": ["https://www.googleapis.com/auth/adwords"],
      "developerToken": []
    }
  ],
  "tags": [
    { "name": "Customers", "description": "Customer account management" },
    { "name": "Campaigns", "description": "Campaign management including create, update, remove, and list" },
    { "name": "Ad Groups", "description": "Ad group management within campaigns" },
    { "name": "Ads", "description": "Ad creative management within ad groups" },
    { "name": "Keywords", "description": "Keyword criteria management for ad groups" },
    { "name": "Budgets", "description": "Campaign budget management" },
    { "name": "Bidding Strategies", "description": "Bidding strategy management" },
    { "name": "Reporting", "description": "Search queries and reporting via GoogleAdsService" },
    { "name": "Conversions", "description": "Conversion upload and tracking" },
    { "name": "Targeting", "description": "Audience, demographic, and location targeting" },
    { "name": "Assets", "description": "Asset and asset set management" },
    { "name": "Batch Jobs", "description": "Batch processing of mutate operations" }
  ],
  "paths": {
    "/customers/{customerId}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "Get a customer account",
        "description": "Returns the requested customer account resource.",
        "tags": ["Customers"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "responses": {
          "200": {
            "description": "Customer resource returned successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Customer" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers:listAccessibleCustomers": {
      "get": {
        "operationId": "listAccessibleCustomers",
        "summary": "List all accessible customer accounts",
        "description": "Returns resource names of all customers directly accessible by the authenticated user. No customer ID is needed in the request path.",
        "tags": ["Customers"],
        "parameters": [
          { "$ref": "#/components/parameters/developerToken" }
        ],
        "responses": {
          "200": {
            "description": "List of accessible customer resource names.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resourceNames": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Resource name of each accessible customer, e.g. customers/1234567890."
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/googleAds:search": {
      "post": {
        "operationId": "searchGoogleAds",
        "summary": "Search Google Ads resources using GAQL",
        "description": "Executes a Google Ads Query Language (GAQL) query and returns paginated results. Use this for reporting and retrieving campaigns, ad groups, ads, keywords, metrics, and other resources.",
        "tags": ["Reporting"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchGoogleAdsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results returned successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchGoogleAdsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/googleAds:searchStream": {
      "post": {
        "operationId": "searchStreamGoogleAds",
        "summary": "Stream Google Ads search results",
        "description": "Executes a GAQL query and streams the entire result set in a single response. More efficient than paginated search for large result sets.",
        "tags": ["Reporting"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The GAQL query string."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streamed search results returned as a JSON array.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SearchGoogleAdsStreamResponse" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/googleAds:mutate": {
      "post": {
        "operationId": "mutateGoogleAds",
        "summary": "Mutate multiple resource types atomically",
        "description": "Performs a batch of create, update, and remove operations across multiple resource types in a single atomic request via GoogleAdsService.",
        "tags": ["Reporting"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateGoogleAdsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mutate results returned successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateGoogleAdsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/campaigns:mutate": {
      "post": {
        "operationId": "mutateCampaigns",
        "summary": "Create, update, or remove campaigns",
        "description": "Performs mutate operations (create, update, remove) on campaigns. Operations within a single request are executed atomically.",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateCampaignsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateCampaignsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/campaigns/{campaignId}": {
      "get": {
        "operationId": "getCampaign",
        "summary": "Get a campaign",
        "description": "Returns the requested campaign resource by its resource name.",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the campaign."
          },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "responses": {
          "200": {
            "description": "Campaign resource returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Campaign" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/adGroups:mutate": {
      "post": {
        "operationId": "mutateAdGroups",
        "summary": "Create, update, or remove ad groups",
        "description": "Performs mutate operations on ad groups. Ad groups belong to a campaign and contain ads and targeting criteria.",
        "tags": ["Ad Groups"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateAdGroupsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ad group mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateAdGroupsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/adGroups/{adGroupId}": {
      "get": {
        "operationId": "getAdGroup",
        "summary": "Get an ad group",
        "description": "Returns the requested ad group resource.",
        "tags": ["Ad Groups"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "adGroupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the ad group."
          },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "responses": {
          "200": {
            "description": "Ad group resource returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdGroup" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/adGroupAds:mutate": {
      "post": {
        "operationId": "mutateAdGroupAds",
        "summary": "Create, update, or remove ads",
        "description": "Performs mutate operations on ad group ads. Each ad belongs to an ad group.",
        "tags": ["Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateAdGroupAdsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ad group ad mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateAdGroupAdsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/adGroupAds/{adGroupId}~{adId}": {
      "get": {
        "operationId": "getAdGroupAd",
        "summary": "Get an ad group ad",
        "description": "Returns the requested ad group ad resource.",
        "tags": ["Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "adGroupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the ad group."
          },
          {
            "name": "adId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the ad."
          },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "responses": {
          "200": {
            "description": "Ad group ad resource returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdGroupAd" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/adGroupCriteria:mutate": {
      "post": {
        "operationId": "mutateAdGroupCriteria",
        "summary": "Create, update, or remove ad group criteria (keywords)",
        "description": "Performs mutate operations on ad group criteria including keywords, placements, audiences, and other targeting criteria.",
        "tags": ["Keywords"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateAdGroupCriteriaRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ad group criteria mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateAdGroupCriteriaResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/adGroupCriteria/{adGroupId}~{criterionId}": {
      "get": {
        "operationId": "getAdGroupCriterion",
        "summary": "Get an ad group criterion",
        "description": "Returns the requested ad group criterion (keyword or other targeting criterion).",
        "tags": ["Keywords"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "adGroupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the ad group."
          },
          {
            "name": "criterionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the criterion."
          },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "responses": {
          "200": {
            "description": "Ad group criterion resource returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdGroupCriterion" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/campaignBudgets:mutate": {
      "post": {
        "operationId": "mutateCampaignBudgets",
        "summary": "Create or update campaign budgets",
        "description": "Performs mutate operations on campaign budgets. Budgets are shared resources that can be linked to one or more campaigns.",
        "tags": ["Budgets"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateCampaignBudgetsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign budget mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateCampaignBudgetsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/campaignBudgets/{campaignBudgetId}": {
      "get": {
        "operationId": "getCampaignBudget",
        "summary": "Get a campaign budget",
        "description": "Returns the requested campaign budget resource.",
        "tags": ["Budgets"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "campaignBudgetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the campaign budget."
          },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "responses": {
          "200": {
            "description": "Campaign budget resource returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CampaignBudget" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/biddingStrategies:mutate": {
      "post": {
        "operationId": "mutateBiddingStrategies",
        "summary": "Create, update, or remove bidding strategies",
        "description": "Performs mutate operations on bidding strategies. Bidding strategies control how bids are set for campaigns and ad groups.",
        "tags": ["Bidding Strategies"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateBiddingStrategiesRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bidding strategy mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateBiddingStrategiesResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/biddingStrategies/{biddingStrategyId}": {
      "get": {
        "operationId": "getBiddingStrategy",
        "summary": "Get a bidding strategy",
        "description": "Returns the requested bidding strategy resource.",
        "tags": ["Bidding Strategies"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          {
            "name": "biddingStrategyId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The ID of the bidding strategy."
          },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "responses": {
          "200": {
            "description": "Bidding strategy resource returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BiddingStrategy" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/conversionActions:mutate": {
      "post": {
        "operationId": "mutateConversionActions",
        "summary": "Create, update, or remove conversion actions",
        "description": "Performs mutate operations on conversion actions which define the types of conversions to track.",
        "tags": ["Conversions"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateConversionActionsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversion action mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateConversionActionsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}:uploadClickConversions": {
      "post": {
        "operationId": "uploadClickConversions",
        "summary": "Upload click conversions",
        "description": "Uploads click conversions to Google Ads. Each conversion is associated with a click via its gclid or user identifiers.",
        "tags": ["Conversions"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UploadClickConversionsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Click conversion upload results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UploadClickConversionsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}:uploadCallConversions": {
      "post": {
        "operationId": "uploadCallConversions",
        "summary": "Upload call conversions",
        "description": "Uploads call conversions to Google Ads. Each conversion is associated with a caller ID and call start time.",
        "tags": ["Conversions"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UploadCallConversionsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call conversion upload results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UploadCallConversionsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/campaignCriteria:mutate": {
      "post": {
        "operationId": "mutateCampaignCriteria",
        "summary": "Create, update, or remove campaign-level targeting criteria",
        "description": "Performs mutate operations on campaign criteria including location targeting, language targeting, and negative keywords at the campaign level.",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/customerId" },
          { "$ref": "#/components/parameters/developerToken" },
          { "$ref": "#/components/parameters/loginCustomerId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MutateCampaignCriteriaRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign criteria mutate results.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MutateCampaignCriteriaResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers/{customerId}/campaignCriteria/{campaignId}~{criterionId}": {
      "get": {
        "operationId": "getCampaignCriterion",
