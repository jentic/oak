{
  "openapi": "3.1.0",
  "info": {
    "title": "Mumzworld Gift Registry Service API",
    "description": "API for managing gift registries, including creation, updating, and sharing of registries.\nThis service allows users to create gift registries for various events, add items to their registry,\nand share them with friends and family.\n",
    "version": "1.0",
    "contact": {
      "name": "Mumzworld Tech Team",
      "email": "tech@mumzworld.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/qwerty123-05c/Registry/1.0"
  },
  "servers": [
    {
      "url": "https://api.mumzworld.com/registry",
      "description": "Production server"
    },
    {
      "url": "https://api-staging.mumzworld.com/registry",
      "description": "Staging server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check operations"
    },
    {
      "name": "Registries",
      "description": "Operations related to gift registries"
    },
    {
      "name": "Registry Items",
      "description": "Operations related to items in registries"
    },
    {
      "name": "Shared Registries",
      "description": "Operations related to shared registries"
    },
    {
      "name": "Photos",
      "description": "Operations related to registry photos"
    },
    {
      "name": "Admin - Registries",
      "description": "Administrative operations for registry management"
    },
    {
      "name": "Admin - Registry Items",
      "description": "Administrative operations for registry items"
    },
    {
      "name": "Admin - Shared Registries",
      "description": "Administrative operations for shared registries"
    },
    {
      "name": "Admin - Photos",
      "description": "Administrative operations for registry photos"
    },
    {
      "name": "Webhooks",
      "description": "Webhook operations for order events"
    }
  ],
  "security": [
    {
      "userAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "userAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id",
        "description": "User ID header for authenticated requests"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "details": {
            "type": "object",
            "description": "Additional error details"
          }
        }
      },
      "Product": {
        "type": "object",
        "description": "Product details from Algolia/Magento2",
        "properties": {
          "objectID": {
            "type": "string",
            "description": "Unique product identifier (used as item_id in registry)"
          },
          "name": {
            "type": "string",
            "description": "Product name"
          },
          "sku": {
            "type": "string",
            "description": "Product SKU"
          },
          "url_key": {
            "type": "string",
            "description": "URL-friendly product identifier"
          },
          "description": {
            "type": "string",
            "description": "Product description"
          },
          "short_description": {
            "type": "string",
            "description": "Short product description"
          },
          "price": {
            "type": "object",
            "properties": {
              "USD": {
                "type": "object",
                "properties": {
                  "default": {
                    "type": "number",
                    "format": "float",
                    "description": "Default price in USD"
                  },
                  "default_formated": {
                    "type": "string",
                    "description": "Formatted default price"
                  }
                }
              }
            }
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "Main product image URL"
          },
          "thumbnail_url": {
            "type": "string",
            "format": "uri",
            "description": "Product thumbnail image URL"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "objectID": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            },
            "description": "Product categories"
          },
          "brand": {
            "type": "string",
            "description": "Product brand"
          },
          "in_stock": {
            "type": "boolean",
            "description": "Product availability status"
          },
          "visibility_search": {
            "type": "integer",
            "description": "Search visibility setting"
          },
          "created_at": {
            "type": "string",
            "description": "Product creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "description": "Product last update timestamp"
          },
          "type_id": {
            "type": "string",
            "description": "Magento product type (simple, configurable, etc.)"
          },
          "stock": {
            "type": "object",
            "properties": {
              "qty": {
                "type": "number",
                "description": "Available quantity"
              },
              "is_in_stock": {
                "type": "boolean",
                "description": "Stock status"
              }
            }
          },
          "ordered_qty": {
            "type": "number",
            "description": "Quantity ordered"
          },
          "total_ordered": {
            "type": "number",
            "description": "Total quantity ever ordered"
          },
          "rating_summary": {
            "type": "number",
            "description": "Average rating summary"
          },
          "reviews_count": {
            "type": "integer",
            "description": "Total number of reviews"
          },
          "color": {
            "type": "string",
            "description": "Product color"
          },
          "size": {
            "type": "string",
            "description": "Product size"
          },
          "age_range": {
            "type": "string",
            "description": "Age range for baby/child products"
          },
          "gender": {
            "type": "string",
            "description": "Target gender"
          },
          "material": {
            "type": "string",
            "description": "Product material"
          },
          "weight": {
            "type": "number",
            "description": "Product weight"
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "length": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Product tags"
          },
          "special_price": {
            "type": "number",
            "format": "float",
            "description": "Special/discounted price"
          },
          "special_from_date": {
            "type": "string",
            "description": "Special price start date"
          },
          "special_to_date": {
            "type": "string",
            "description": "Special price end date"
          },
          "meta_title": {
            "type": "string",
            "description": "SEO meta title"
          },
          "meta_description": {
            "type": "string",
            "description": "SEO meta description"
          },
          "country": {
            "type": "string",
            "description": "Country code for localization"
          },
          "language": {
            "type": "string",
            "description": "Language code for localization"
          }
        }
      },
      "GiftRegistry": {
        "type": "object",
        "required": [
          "registry_id",
          "user_id",
          "title",
          "event_type"
        ],
        "properties": {
          "registry_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the registry"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "Owner of the registry"
          },
          "title": {
            "type": "string",
            "description": "Title of the registry"
          },
          "event_type": {
            "type": "string",
            "description": "Type of event (Wedding, Birthday, Baby Shower, etc.)"
          },
          "event_date": {
            "type": "string",
            "format": "date-time",
            "description": "Date of the event"
          },
          "description": {
            "type": "string",
            "description": "Description of the registry"
          },
          "is_public": {
            "type": "boolean",
            "description": "Whether the registry is public"
          },
          "share_hash": {
            "type": "string",
            "description": "Hash for sharing the registry"
          },
          "shipping_address_id": {
            "type": "string",
            "description": "ID reference to shipping address"
          },
          "event_location": {
            "oneOf": [
              {
                "type": "string",
                "description": "Event location as a string"
              },
              {
                "type": "object",
                "properties": {
                  "venue": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistryItem"
            }
          },
          "photo_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to the registry photo"
          },
          "photo_thumbnail_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to the registry photo thumbnail"
          },
          "photo_caption": {
            "type": "string",
            "description": "Caption for the registry photo"
          },
          "photo_uploaded_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the photo was uploaded"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegistryItem": {
        "type": "object",
        "required": [
          "item_id",
          "product_sku",
          "product_type",
          "desired_quantity"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "description": "Unique identifier for the registry item"
          },
          "product_sku": {
            "type": "string",
            "description": "SKU of the product"
          },
          "product_type": {
            "type": "string",
            "enum": [
              "simple",
              "simple_custom",
              "configurable",
              "config_custom",
              "bundle",
              "bundle_custom"
            ],
            "description": "Type of product"
          },
          "desired_quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Desired quantity of the product"
          },
          "purchased_quantity": {
            "type": "integer",
            "minimum": 0,
            "description": "Quantity already purchased"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "description": "Priority of the item"
          },
          "notes": {
            "type": "string",
            "maxLength": 500,
            "description": "Notes about the item"
          },
          "selected_config": {
            "type": "object",
            "properties": {
              "configurable_options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attribute_code": {
                      "type": "string"
                    },
                    "option_id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "selected_sku": {
                      "type": "string"
                    },
                    "selected_product_id": {
                      "type": "string"
                    }
                  }
                }
              },
              "custom_options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "option_id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              },
              "bundle_selections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "option_id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "selection_id": {
                      "type": "string"
                    },
                    "selected_sku": {
                      "type": "string"
                    },
                    "selected_product_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "added_at": {
            "type": "string",
            "description": "ISO 8601 date string when item was added"
          },
          "product": {
            "$ref": "#/components/schemas/Product",
            "description": "Product details from Algolia when included"
          }
        }
      },
      "PhotoInfo": {
        "type": "object",
        "properties": {
          "photo_url": {
            "type": "string",
            "format": "uri"
          },
          "photo_thumbnail_url": {
            "type": "string",
            "format": "uri"
          },
          "photo_caption": {
            "type": "string"
          },
          "photo_uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Response message"
          }
        }
      },
      "WebhookResult": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "registry_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "item_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "success",
                    "failed"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "purchased_quantity": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/registries/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns the health status of the gift registry service",
        "operationId": "healthCheck",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2024-01-15 10:30:00"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/registries": {
      "get": {
        "summary": "Get user's registries",
        "description": "Retrieve all registries for the authenticated user",
        "operationId": "getUserRegistries",
        "tags": [
          "Registries"
        ],
        "security": [
          {
            "userAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GiftRegistry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new registry",
        "description": "Create a new gift registry for the authenticated user",
        "operationId": "createRegistry",
        "tags": [
          "Registries"
        ],
        "security": [
          {
            "userAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "event_type",
                  "event_date"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Title of the registry"
                  },
                  "event_type": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Type of event"
                  },
                  "event_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Date of the event"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the registry"
                  },
                  "is_public": {
                    "type": "boolean",
                    "description": "Whether the registry is public"
                  },
                  "event_location": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Event location"
                  },
                  "shipping_address_id": {
                    "type": "string",
                    "description": "ID reference to shipping address"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registry created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiftRegistry"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/registries/{id}": {
      "get": {
        "summary": "Get a specific registry",
        "description": "Retrieve a specific registry by ID",
        "operationId": "getRegistry",
        "tags": [
          "Registries"
        ],
        "security": [
          {
            "userAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiftRegistry"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Unauthorized access to registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registry not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a registry",
        "description": "Update a specific registry by ID",
        "operationId": "updateRegistry",
        "tags": [
          "Registries"
        ],
        "security": [
          {
            "userAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "event_type": {
                    "type": "string",
                    "maxLength": 50
                  },
                  "event_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "description": {
                    "type": "string"
                  },
                  "event_location": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "shipping_address_id": {
                    "type": "string",
                    "description": "ID reference to shipping address"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registry updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiftRegistry"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Unauthorized to update this registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registry not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a registry",
        "description": "Delete a specific registry by ID",
        "operationId": "deleteRegistry",
        "tags": [
          "Registries"
        ],
        "security": [
          {
            "userAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registry deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Unauthorized to delete this registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registry not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/registries/{id}/privacy": {
      "put": {
        "summary": "Update registry privacy",
        "description": "Update the privacy settings of a registry",
        "operationId": "updatePrivacy",
        "tags": [
          "Registries"
        ],
        "security": [
          {
            "userAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
