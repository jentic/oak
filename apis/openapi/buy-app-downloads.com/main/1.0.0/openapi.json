                  },
                  {
                    "id": 14,
                    "iso": "AU",
                    "name": "Australia"
                  }
                ]
              }
            }
          }
        },
        "tags": [
          "countries"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "App": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "package": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "app_id": {
            "type": "integer"
          },
          "country_id": {
            "type": "integer"
          },
          "keyword": {
            "type": "string"
          },
          "installs": {
            "type": "integer"
          },
          "installs_completed": {
            "type": "string"
          },
          "ratings": {
            "type": "string"
          },
          "ratings_completed": {
            "type": "string"
          },
          "reviews": {
            "type": "string"
          },
          "reviews_completed": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          },
          "custom_reviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderReview"
            }
          },
          "status": {
            "type": "string",
            "example": [
              "pending",
              "active",
              "completed",
              "cancelled"
            ]
          },
          "completion_date": {
            "type": "string"
          }
        },
        "xml": {
          "name": "Order"
        }
      },
      "Country": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "iso": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "xml": {
          "name": "Tag"
        }
      },
      "OrderReview": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
