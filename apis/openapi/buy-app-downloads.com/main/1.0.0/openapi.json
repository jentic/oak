                  ]
                }
              }
            }
          }
        },
        "tags": [
          "orders"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Cancel the specific Order",
        "operationId": "deleteOrder",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "ID of the specific Order."
          }
        ],
        "responses": {
          "204": {
            "description": "Empty return."
          },
          "404": {
            "description": "Order not found.",
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    "Order not found."
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "orders"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/countries": {
      "get": {
        "summary": "Get a list of all Countries available for orders",
        "operationId": "listCountries",
        "responses": {
          "200": {
            "description": "Full Countries list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Country"
                  }
                },
                "example": [
                  {
                    "id": 4,
                    "iso": "DZ",
                    "name": "Algeria"
                  },
                  {
                    "id": 8,
                    "iso": "AI",
                    "name": "Anguilla"
                  },
                  {
                    "id": 11,
