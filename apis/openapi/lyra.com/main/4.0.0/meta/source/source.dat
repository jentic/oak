{
  "openapi": "3.0.3",
  "info": {
    "title": "Lyra Payment REST API",
    "description": "Lyra is a French payment processing platform providing a comprehensive REST API (V4) for creating payments, managing transactions, handling tokens for recurring payments, subscriptions, and risk management. The API follows a resource/action pattern where all requests are POST calls with JSON bodies.",
    "version": "4.0.0",
    "x-jentic-source-url": "https://docs.lyra.com/"
  },
  "servers": [
    {
      "url": "https://api.lyra.com/api-payment/V4",
      "description": "Production API server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/Charge/CreatePayment": {
      "post": {
        "operationId": "createPayment",
        "summary": "Create a payment",
        "description": "Creates a new payment transaction. This is the primary endpoint for initiating a payment. It returns a form token that can be used with the JavaScript client to display a payment form, or processes the payment directly when card data is provided (PCI mode).",
        "tags": ["Charge"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePaymentRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Charge/CreateTokenFromTransaction": {
      "post": {
        "operationId": "createTokenFromTransaction",
        "summary": "Create a token from a transaction",
        "description": "Creates a payment token from an existing successful transaction, enabling future payments without requiring the customer to re-enter card details.",
        "tags": ["Charge"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": {
                    "type": "string",
                    "description": "UUID of the original transaction"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/Get": {
      "post": {
        "operationId": "getTransaction",
        "summary": "Retrieve a transaction",
        "description": "Returns the details of a specific transaction identified by its UUID.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": {
                    "type": "string",
                    "description": "UUID of the transaction to retrieve"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/Update": {
      "post": {
        "operationId": "updateTransaction",
        "summary": "Update a transaction",
        "description": "Updates an existing transaction, for example to modify the amount before capture.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": { "type": "string" },
                  "cardUpdate": {
                    "type": "object",
                    "properties": {
                      "amount": { "type": "integer", "description": "Amount in smallest currency unit" },
                      "currency": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/Cancel": {
      "post": {
        "operationId": "cancelTransaction",
        "summary": "Cancel a transaction",
        "description": "Cancels an authorized transaction that has not yet been captured.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": { "type": "string", "description": "UUID of the transaction to cancel" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction cancelled successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/Capture": {
      "post": {
        "operationId": "captureTransaction",
        "summary": "Capture a transaction",
        "description": "Captures an authorized transaction, finalizing the charge to the customer's card.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": { "type": "string" },
                  "amount": { "type": "integer", "description": "Amount to capture in smallest currency unit" },
                  "currency": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction captured successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/Refund": {
      "post": {
        "operationId": "refundTransaction",
        "summary": "Refund a transaction",
        "description": "Creates a refund for a captured transaction. Can be a full or partial refund.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": { "type": "string" },
                  "amount": { "type": "integer", "description": "Amount to refund in smallest currency unit" },
                  "currency": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/Duplicate": {
      "post": {
        "operationId": "duplicateTransaction",
        "summary": "Duplicate a transaction",
        "description": "Creates a new transaction based on an existing one, reusing the stored payment method.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid", "amount", "currency"],
                "properties": {
                  "uuid": { "type": "string" },
                  "amount": { "type": "integer" },
                  "currency": { "type": "string" },
                  "orderId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction duplicated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/Validate": {
      "post": {
        "operationId": "validateTransaction",
        "summary": "Validate a transaction",
        "description": "Validates a transaction, typically used after manual review of a flagged payment.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction validated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Transaction/CancelOrRefund": {
      "post": {
        "operationId": "cancelOrRefundTransaction",
        "summary": "Cancel or refund a transaction",
        "description": "Automatically determines whether to cancel or refund a transaction based on its current state.",
        "tags": ["Transaction"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uuid"],
                "properties": {
                  "uuid": { "type": "string" },
                  "amount": { "type": "integer" },
                  "currency": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction cancelled or refunded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Token/Get": {
      "post": {
        "operationId": "getToken",
        "summary": "Retrieve a token",
        "description": "Returns the details of a saved payment token.",
        "tags": ["Token"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paymentMethodToken"],
                "properties": {
                  "paymentMethodToken": { "type": "string", "description": "The payment method token to retrieve" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Token/Cancel": {
      "post": {
        "operationId": "cancelToken",
        "summary": "Cancel a token",
        "description": "Cancels (deactivates) a saved payment token so it can no longer be used for payments.",
        "tags": ["Token"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paymentMethodToken"],
                "properties": {
                  "paymentMethodToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token cancelled successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Token/Reactivate": {
      "post": {
        "operationId": "reactivateToken",
        "summary": "Reactivate a token",
        "description": "Reactivates a previously cancelled payment token.",
        "tags": ["Token"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paymentMethodToken"],
                "properties": {
                  "paymentMethodToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token reactivated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Token/Update": {
      "post": {
        "operationId": "updateToken",
        "summary": "Update a token",
        "description": "Updates the details of a saved payment token.",
        "tags": ["Token"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paymentMethodToken"],
                "properties": {
                  "paymentMethodToken": { "type": "string" },
                  "cardUpdate": {
                    "type": "object",
                    "properties": {
                      "expiryMonth": { "type": "integer" },
                      "expiryYear": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Subscription/Get": {
      "post": {
        "operationId": "getSubscription",
        "summary": "Retrieve a subscription",
        "description": "Returns the details of a recurring payment subscription.",
        "tags": ["Subscription"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subscriptionId", "paymentMethodToken"],
                "properties": {
                  "subscriptionId": { "type": "string" },
                  "paymentMethodToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubscriptionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Subscription/Update": {
      "post": {
        "operationId": "updateSubscription",
        "summary": "Update a subscription",
        "description": "Updates the parameters of an existing subscription (amount, frequency, etc.).",
        "tags": ["Subscription"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subscriptionId", "paymentMethodToken"],
                "properties": {
                  "subscriptionId": { "type": "string" },
                  "paymentMethodToken": { "type": "string" },
                  "amount": { "type": "integer" },
                  "currency": { "type": "string" },
                  "effectDate": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubscriptionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Subscription/Cancel": {
      "post": {
        "operationId": "cancelSubscription",
        "summary": "Cancel a subscription",
        "description": "Cancels an active recurring payment subscription.",
        "tags": ["Subscription"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subscriptionId", "paymentMethodToken"],
                "properties": {
                  "subscriptionId": { "type": "string" },
                  "paymentMethodToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription cancelled successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubscriptionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Order/Get": {
      "post": {
        "operationId": "getOrder",
        "summary": "Retrieve an order",
        "description": "Returns the details of an order including all its associated transactions.",
        "tags": ["Order"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["orderId"],
                "properties": {
                  "orderId": { "type": "string", "description": "The order identifier" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Charge/CreateToken": {
      "post": {
        "operationId": "createToken",
        "summary": "Create a payment token",
        "description": "Creates a new payment token for saving card details for future use, without charging the card.",
        "tags": ["Charge"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currency"],
                "properties": {
                  "currency": { "type": "string", "description": "ISO 4217 currency code" },
                  "orderId": { "type": "string" },
                  "formAction": { "type": "string", "enum": ["REGISTER"] },
                  "customer": { "$ref": "#/components/schemas/Customer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token creation initiated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/Charge/CreateSubscription": {
      "post": {
        "operationId": "createSubscription",
        "summary": "Create a subscription",
        "description": "Creates a new recurring payment subscription using a saved payment token.",
        "tags": ["Charge"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency", "paymentMethodToken", "subscriptionRules"],
                "properties": {
                  "amount": { "type": "integer", "description": "Amount in smallest currency unit" },
                  "currency": { "type": "string" },
                  "paymentMethodToken": { "type": "string" },
                  "orderId": { "type": "string" },
                  "subscriptionRules": {
                    "type": "object",
                    "properties": {
                      "initialAmount": { "type": "integer" },
                      "initialAmountNumber": { "type": "integer" },
                      "rrule": { "type": "string", "description": "Recurrence rule in iCal RRULE format" }
                    }
                  },
                  "customer": { "$ref": "#/components/schemas/Customer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubscriptionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Use your shop ID as username and your REST API key (test or production) as password."
      }
    },
    "schemas": {
      "CreatePaymentRequest": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": {
            "type": "integer",
            "description": "Payment amount in the smallest currency unit (e.g., cents for EUR)"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code (e.g., EUR, USD)"
          },
          "orderId": {
            "type": "string",
            "description": "Merchant order reference"
          },
          "formAction": {
            "type": "string",
            "enum": ["PAYMENT", "REGISTER", "REGISTER_PAY", "REGISTER_UPDATE_PAY", "REGISTER_SUBSCRIBE", "SUBSCRIBE"],
            "description": "Type of form action"
          },
          "paymentMethodToken": {
            "type": "string",
            "description": "Token for recurring payment"
          },
          "customer": { "$ref": "#/components/schemas/Customer" },
          "transactionOptions": {
            "type": "object",
            "properties": {
              "cardOptions": {
                "type": "object",
                "properties": {
                  "captureDelay": { "type": "integer" },
                  "manualValidation": { "type": "string", "enum": ["YES", "NO"] },
                  "paymentSource": { "type": "string" }
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Custom metadata key-value pairs"
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "reference": { "type": "string" },
          "billingDetails": {
            "type": "object",
            "properties": {
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "phoneNumber": { "type": "string" },
              "address": { "type": "string" },
              "zipCode": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "country": { "type": "string", "description": "ISO 3166 alpha-2 country code" }
            }
          },
          "shippingDetails": {
            "type": "object",
            "properties": {
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "phoneNumber": { "type": "string" },
              "address": { "type": "string" },
              "zipCode": { "type": "string" },
              "city": { "type": "string" },
              "country": { "type": "string" }
            }
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["SUCCESS", "ERROR"] },
          "answer": {
            "type": "object",
            "properties": {
              "formToken": { "type": "string" },
              "shopId": { "type": "string" },
              "orderCycle": { "type": "string" },
              "orderStatus": { "type": "string" },
              "serverDate": { "type": "string", "format": "date-time" },
              "orderDetails": {
                "type": "object",
                "properties": {
                  "orderId": { "type": "string" },
                  "orderTotalAmount": { "type": "integer" },
                  "orderCurrency": { "type": "string" },
                  "mode": { "type": "string", "enum": ["TEST", "PRODUCTION"] }
                }
              },
              "transactions": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Transaction" }
              },
              "customer": { "$ref": "#/components/schemas/Customer" }
            }
          },
          "ticket": { "type": "string", "description": "Unique request ticket ID" },
          "serverDate": { "type": "string", "format": "date-time" },
          "applicationVersion": { "type": "string" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string" },
          "shopId": { "type": "string" },
          "status": { "type": "string", "enum": ["PAID", "UNPAID", "RUNNING", "PARTIALLY_PAID", "REFUSED", "ERROR", "CANCELLED"] },
          "detailedStatus": { "type": "string" },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "creationDate": { "type": "string", "format": "date-time" },
          "operationType": { "type": "string", "enum": ["DEBIT", "CREDIT", "VERIFICATION"] },
          "paymentMethodToken": { "type": "string" },
          "transactionDetails": {
            "type": "object",
            "properties": {
              "cardDetails": {
                "type": "object",
                "properties": {
                  "effectiveBrand": { "type": "string" },
                  "pan": { "type": "string", "description": "Masked card number" },
                  "expiryMonth": { "type": "integer" },
                  "expiryYear": { "type": "integer" },
                  "country": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["SUCCESS", "ERROR"] },
          "answer": {
            "type": "object",
            "properties": {
              "paymentMethodToken": { "type": "string" },
              "tokenStatus": { "type": "string", "enum": ["ACTIVE", "CANCELLED"] },
              "creationDate": { "type": "string", "format": "date-time" },
              "cancellationDate": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "SubscriptionResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["SUCCESS", "ERROR"] },
          "answer": {
            "type": "object",
            "properties": {
              "subscriptionId": { "type": "string" },
              "subscriptionStatus": { "type": "string", "enum": ["ACTIVE", "CANCELLED", "EXPIRED"] },
              "paymentMethodToken": { "type": "string" },
              "orderId": { "type": "string" },
              "pastPaymentsNumber": { "type": "integer" },
              "totalPaymentsNumber": { "type": "integer" },
              "effectDate": { "type": "string", "format": "date-time" },
              "cancelDate": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["SUCCESS", "ERROR"] },
          "answer": {
            "type": "object",
            "properties": {
              "orderId": { "type": "string" },
              "orderStatus": { "type": "string" },
              "orderTotalAmount": { "type": "integer" },
              "orderCurrency": { "type": "string" },
              "transactions": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Transaction" }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ERROR"] },
          "answer": {
            "type": "object",
            "properties": {
              "errorCode": { "type": "string" },
              "errorMessage": { "type": "string" },
              "detailedErrorCode": { "type": "string" },
              "detailedErrorMessage": { "type": "string" }
            }
          },
          "ticket": { "type": "string" },
          "serverDate": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - invalid parameters or missing required fields",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - invalid shop ID or REST API key",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}