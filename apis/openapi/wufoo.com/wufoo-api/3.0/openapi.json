    "/forms/{identifier}/webhooks.json": {
      "get": {
        "operationId": "getWebhooks",
        "summary": "Get webhooks for a form",
        "description": "Returns the webhooks configured for a specific form.",
        "tags": ["Webhooks"],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "description": "The form hash or URL-friendly title.",
            "schema": {
