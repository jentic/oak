    "/forms/{identifier}/entries.json": {
      "get": {
        "operationId": "getFormEntries",
        "summary": "Get form entries",
        "description": "Returns entries submitted to a specific form.",
        "tags": ["Entries"],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "description": "The form hash or URL-friendly title.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "system",
            "in": "query",
            "description": "Include system metadata fields.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "pageStart",
            "in": "query",
            "description": "Starting entry index for pagination.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of entries per page (max 100).",
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 100
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Field ID to sort results by (e.g. Field105, EntryId, DateCreated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "description": "Sort direction.",
            "schema": {
              "type": "string",
              "enum": ["ASC", "DESC"],
              "default": "ASC"
            }
          },
          {
            "name": "Filter1",
            "in": "query",
            "description": "Filter expression in format FieldID+Operator+Value (e.g. Field105+Contains+text). Operators: Contains, Does_not_contain, Begins_with, Ends_with, Is_less_than, Is_greater_than, Is_equal_to, Is_not_equal_to, Is_on, Is_before, Is_after, Is_not_NULL.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Filter2",
            "in": "query",
            "description": "Additional filter expression.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Filter3",
            "in": "query",
            "description": "Additional filter expression.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "match",
            "in": "query",
            "description": "How to combine multiple filters.",
            "schema": {
              "type": "string",
              "enum": ["AND", "OR"]
            }
          },
          {
            "name": "pretty",
            "in": "query",
            "description": "Pretty-print the JSON response.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Entries": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Entry"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failure"
          }
        }
      },
      "post": {
        "operationId": "submitFormEntry",
        "summary": "Submit a form entry",
        "description": "Submit a new entry to a specific form. Fields are submitted as form-encoded key-value pairs where keys are the field identifiers (e.g. Field1, Field2).",
        "tags": ["Entries"],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "description": "The form hash or URL-friendly title.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Key-value pairs where keys are field identifiers (e.g. Field1, Field105) and values are the submitted data."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Entry successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryPostSuccess"
                }
              }
            }
          },
          "200": {
            "description": "Entry submission failed (validation errors)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryPostFailure"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failure"
          },
          "429": {
            "description": "Rate limit exceeded (50 submissions per user per 5 minutes)"
          }
        }
      }
    },
