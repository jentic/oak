          }
        }
      },
      "put": {
        "operationId": "addWebhook",
        "summary": "Add a webhook to a form",
        "description": "Adds a new webhook to a specific form. When an entry is submitted, Wufoo will POST the data to the specified URL.",
        "tags": ["Webhooks"],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "description": "The form hash or URL-friendly title.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["url", "handshakeKey"],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "The callback URL where Wufoo will POST entry data."
                  },
                  "handshakeKey": {
                    "type": "string",
