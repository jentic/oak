              "default": false
            }
          },
          {
            "name": "includeTodayCount",
            "in": "query",
            "description": "Include today's entry count in the response.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Forms": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Form"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failure"
          }
        }
      }
    },
