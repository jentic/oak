{
  "openapi": "3.0.3",
  "info": {
    "title": "Wufoo API",
    "description": "Wufoo is an online form builder. The Wufoo REST API v3 allows you to manage forms, retrieve entries, access reports, manage users, and configure webhooks.",
    "version": "3.0",
    "contact": {
      "name": "Wufoo",
      "url": "https://wufoo.github.io/docs/"
    }
  },
  "servers": [
    {
      "url": "https://{subdomain}.wufoo.com/api/v3",
      "description": "Wufoo API server",
      "variables": {
        "subdomain": {
          "default": "fishbowl",
          "description": "Your Wufoo account subdomain"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/forms.json": {
      "get": {
        "operationId": "getForms",
        "summary": "Get all forms",
        "description": "Returns a list of all forms for the authenticated user.",
        "tags": ["Forms"],
        "parameters": [
          {
            "name": "pretty",
            "in": "query",
            "description": "Pretty-print the JSON response.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "includeTodayCount",
            "in": "query",
            "description": "Include today's entry count in the response.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Forms": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Form"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failure"
          }
        }
      }
    },
    "/forms/{identifier}.json": {
