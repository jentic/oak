{
  "openapi": "3.0.3",
  "info": {
    "title": "Clearpay API",
    "description": "Clearpay (Afterpay's EU/UK brand) API for buy-now-pay-later payment processing. Enables merchants to create checkouts, process payments, issue refunds, and manage orders. Clearpay shares the Afterpay developer portal and API infrastructure.",
    "version": "2.0.0",
    "contact": {
      "name": "Clearpay Developer Support",
      "url": "https://developers.afterpay.com"
    },
    "x-jentic-source-url": "https://developers.afterpay.com/afterpay-online-developer/api-reference/reference/introduction",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://global-api.afterpay.com",
      "description": "Production (Global - includes UK/EU Clearpay)"
    },
    {
      "url": "https://global-api-sandbox.afterpay.com",
      "description": "Sandbox (Global - includes UK/EU Clearpay)"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/v2/configuration": {
      "get": {
        "operationId": "getConfiguration",
        "summary": "Get merchant configuration",
        "description": "Retrieves the merchant's Afterpay/Clearpay configuration including order limits (minimum and maximum amounts) and other settings for the authenticated merchant.",
        "tags": ["Configuration"],
        "responses": {
          "200": {
            "description": "Merchant configuration retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "minimumAmount": {
                      "$ref": "#/components/schemas/Money"
                    },
                    "maximumAmount": {
                      "$ref": "#/components/schemas/Money"
                    },
                    "name": {
                      "type": "string",
                      "description": "Merchant name"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid credentials"
          }
        }
      }
    },
    "/v2/checkouts": {
      "post": {
        "operationId": "createCheckout",
        "summary": "Create a checkout",
        "description": "Creates a new Clearpay/Afterpay checkout and returns a token that is used to redirect the consumer to the Clearpay/Afterpay checkout flow.",
        "tags": ["Checkouts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "consumer", "merchant"],
                "properties": {
                  "amount": {
                    "$ref": "#/components/schemas/Money"
                  },
                  "consumer": {
                    "$ref": "#/components/schemas/Consumer"
                  },
                  "merchant": {
                    "type": "object",
                    "required": ["redirectConfirmUrl", "redirectCancelUrl"],
                    "properties": {
                      "redirectConfirmUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "URL to redirect consumer to after they confirm payment"
                      },
                      "redirectCancelUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "URL to redirect consumer to if they cancel"
                      },
                      "name": {
                        "type": "string",
                        "description": "Merchant name to display"
                      },
                      "popupOriginUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "Origin URL for popup mode"
                      }
                    }
                  },
                  "merchantReference": {
                    "type": "string",
                    "description": "Merchant's order reference"
                  },
                  "taxAmount": {
                    "$ref": "#/components/schemas/Money"
                  },
                  "shippingAmount": {
                    "$ref": "#/components/schemas/Money"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/OrderItem"
                    }
                  },
                  "shipping": {
                    "$ref": "#/components/schemas/Contact"
                  },
                  "billing": {
                    "$ref": "#/components/schemas/Contact"
                  },
                  "description": {
                    "type": "string",
                    "description": "Order description"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Checkout created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token to use for redirecting the consumer to the Clearpay payment flow"
                    },
                    "expires": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Checkout expiration timestamp in ISO 8601 format"
                    },
                    "redirectCheckoutUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL to redirect the consumer to complete payment"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Unprocessable Entity - validation error"
          }
        }
      }
    },
    "/v2/checkouts/{token}": {
      "get": {
        "operationId": "getCheckout",
        "summary": "Get checkout details",
        "description": "Retrieves checkout details using the checkout token.",
        "tags": ["Checkouts"],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The checkout token"
          }
        ],
        "responses": {
          "200": {
            "description": "Checkout details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "amount": {
                      "$ref": "#/components/schemas/Money"
                    },
                    "consumer": {
                      "$ref": "#/components/schemas/Consumer"
                    },
                    "expires": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Checkout not found"
          }
        }
      }
    },
    "/v2/payments/capture": {
      "post": {
        "operationId": "capturePayment",
        "summary": "Capture full payment (immediate flow)",
        "description": "Captures the full payment amount immediately using the checkout token. Used in the immediate payment flow where the full amount is captured at the time of order placement.",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "The checkout token returned from the Create Checkout endpoint"
                  },
                  "merchantReference": {
                    "type": "string",
                    "description": "Merchant's order reference"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment captured successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "402": {
            "description": "Payment declined"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/v2/payments/auth": {
      "post": {
        "operationId": "authorizePayment",
        "summary": "Authorize payment (deferred flow)",
        "description": "Authorizes the full payment amount up front without capturing. The authorized payment can later be captured or voided. Used in the auth/capture payment flow.",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "The checkout token"
                  },
                  "merchantReference": {
                    "type": "string",
                    "description": "Merchant's order reference"
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Idempotency key"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment authorized successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "402": {
            "description": "Payment declined"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/v2/payments/{orderId}/capture": {
      "post": {
        "operationId": "captureAuthorizedPayment",
        "summary": "Capture authorized payment",
        "description": "Captures a full or partial amount of a previously authorized payment. An authorized payment can be captured multiple times as long as the total does not exceed the authorized amount.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The Clearpay/Afterpay order ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": {
                  "amount": {
                    "$ref": "#/components/schemas/Money"
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Idempotency key"
                  },
                  "merchantReference": {
                    "type": "string",
                    "description": "Merchant's reference for this capture"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment captured successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "402": {
            "description": "Payment declined"
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/v2/payments/{orderId}/void": {
      "post": {
        "operationId": "voidPayment",
        "summary": "Void an authorized payment",
        "description": "Voids a previously authorized payment that has not yet been fully captured.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The Clearpay/Afterpay order ID"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Idempotency key"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment voided successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/v2/payments/{orderId}/refund": {
      "post": {
        "operationId": "refundPayment",
        "summary": "Refund a payment",
        "description": "Issues a full or partial refund for a captured payment.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The Clearpay/Afterpay order ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": {
                  "amount": {
                    "$ref": "#/components/schemas/Money"
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Idempotency key"
                  },
                  "merchantReference": {
                    "type": "string",
                    "description": "Merchant's reference for this refund"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Refund processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          },
          "422": {
            "description": "Unprocessable Entity - e.g. refund exceeds captured amount"
          }
        }
      }
    },
    "/v2/payments/{orderId}": {
      "get": {
        "operationId": "getPaymentByOrderId",
        "summary": "Get payment by order ID",
        "description": "Retrieves payment details using the Clearpay/Afterpay order ID.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The Clearpay/Afterpay order ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found"
          }
        }
      }
    },
    "/v2/payments/token:{token}": {
      "get": {
        "operationId": "getPaymentByToken",
        "summary": "Get payment by token",
        "description": "Retrieves payment details using the checkout token.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The checkout token"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found"
          }
        }
      }
    },
    "/v2/payments": {
      "get": {
        "operationId": "listPayments",
        "summary": "List payments",
        "description": "Lists payments for the authenticated merchant. Supports pagination.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "fromCreatedDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter payments created on or after this date (ISO 8601)"
          },
          {
            "name": "toCreatedDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter payments created on or before this date (ISO 8601)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Number of results per page"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Pagination offset"
          },
          {
            "name": "orderBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["createdAt", "updatedAt"]
            },
            "description": "Sort field"
          },
          {
            "name": "ascending",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Sort direction"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["APPROVED", "DECLINED", "VOIDED"]
            },
            "description": "Filter by payment status"
          }
        ],
        "responses": {
          "200": {
            "description": "List of payments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalResults": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Payment"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/payments/{orderId}/update-shipping": {
      "put": {
        "operationId": "updateShipping",
        "summary": "Update order shipping details",
        "description": "Updates the shipping information for an existing order.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The Clearpay/Afterpay order ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Shipping courier name"
                  },
                  "trackingNumber": {
                    "type": "string",
                    "description": "Tracking number"
                  },
                  "trackingUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL to track the shipment"
                  },
                  "shippedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the order was shipped"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipping details updated successfully"
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Authentication using Merchant ID as username and Secret Key as password. Credentials are Base64 encoded in the Authorization header."
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Decimal amount as string (e.g. '100.00')"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code (e.g. GBP, EUR, AUD, NZD, CAD)"
          }
        }
      },
      "Consumer": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string"
          },
          "givenNames": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "area1": {
            "type": "string",
            "description": "City or suburb"
          },
          "area2": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "description": "State or region"
          },
          "postcode": {
            "type": "string"
          },
          "countryCode": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code"
          },
          "phoneNumber": {
            "type": "string"
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "pageUrl": {
            "type": "string",
            "format": "uri"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "estimatedShipmentDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Clearpay/Afterpay order ID"
          },
          "token": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["APPROVED", "DECLINED", "VOIDED"]
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "originalAmount": {
            "$ref": "#/components/schemas/Money"
          },
          "openToCaptureAmount": {
            "$ref": "#/components/schemas/Money"
          },
          "paymentState": {
            "type": "string",
            "enum": ["AUTH_APPROVED", "AUTH_DECLINED", "PARTIALLY_CAPTURED", "CAPTURED", "VOIDED"]
          },
          "merchantReference": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentEvent"
            }
          },
          "refunds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Refund"
            }
          }
        }
      },
      "PaymentEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "expires": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": ["AUTH_APPROVED", "AUTH_DECLINED", "CAPTURE", "VOID", "REFUND"]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "paymentEventMerchantReference": {
            "type": "string"
          }
        }
      },
      "Refund": {
        "type": "object",
        "properties": {
          "refundId": {
            "type": "string"
          },
          "refundedAt": {
            "type": "string",
            "format": "date-time"
          },
          "merchantReference": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Configuration",
      "description": "Merchant configuration endpoints"
    },
    {
      "name": "Checkouts",
      "description": "Checkout creation and retrieval"
    },
    {
      "name": "Payments",
      "description": "Payment processing, capture, refund, and management"
    }
  ]
}