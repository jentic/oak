{
  "openapi": "3.0.0",
  "info": {
    "title": "PitchYes API",
    "version": "1.1",
    "description": "API de Integra\u00e7\u00e3o da PitchYes para envio de liga\u00e7\u00f5es, gerenciamento de contatos, agentes e recebimento de webhooks.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/pitchyes/PitchYes/1.1"
  },
  "servers": [
    {
      "url": "https://api.pitchyes.com.br:443"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CallCRMRequest": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "telefone",
          "data_evento"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "data_evento": {
            "type": "string",
            "example": "2025-01-01 15:30:00"
          }
        }
      },
      "CallSendRequest": {
        "type": "object",
        "required": [
          "assistant_id",
          "telefone"
        ],
        "properties": {
          "assistant_id": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "nome": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "custom_fields": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CallItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "resultado": {
            "type": "string"
          },
          "duracao_segundos": {
            "type": "number"
          },
          "horario": {
            "type": "string"
          },
          "gravacao_url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CallDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "resultado": {
            "type": "string"
          },
          "duracao_segundos": {
            "type": "number"
          },
          "gravacao_url": {
            "type": "string",
            "nullable": true
          },
          "horario_finalizacao": {
            "type": "string"
          }
        }
      },
      "ContactCreate": {
        "type": "object",
        "required": [
          "telefone"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "custom_fields": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ContactListImport": {
        "type": "object",
        "properties": {
          "contatos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactCreate"
            }
          }
        }
      },
      "ContactItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ContactSearchResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "pagina": {
            "type": "number"
          },
          "contatos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactItem"
            }
          }
        }
      },
      "AgentCreate": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "voz": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "AgentItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "voz": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WebhookCallFinished": {
        "type": "object",
        "properties": {
          "ligacao_id": {
            "type": "string"
          },
          "agente": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "duracao_segundos": {
            "type": "number"
          },
          "resultado": {
            "type": "string"
          },
          "gravacao_url": {
            "type": "string",
            "nullable": true
          },
          "horario_finalizacao": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/calls/crm/{assistantId}": {
      "post": {
        "summary": "Disparar nova liga\u00e7\u00e3o via CRM",
        "parameters": [
          {
            "name": "assistantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallCRMRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Liga\u00e7\u00e3o enviada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/calls/send": {
      "post": {
        "summary": "Enviar liga\u00e7\u00e3o com metadados",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallSendRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Envio realizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "call_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/calls/historico": {
      "get": {
        "summary": "Buscar hist\u00f3rico de liga\u00e7\u00f5es",
        "parameters": [
          {
            "name": "telefone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data_inicio",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data_fim",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resultado",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de liga\u00e7\u00f5es",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CallItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/calls/get/{id}": {
      "get": {
        "summary": "Buscar liga\u00e7\u00e3o por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes da liga\u00e7\u00e3o",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallDetail"
                }
              }
            }
          }
        }
      }
    },
    "/contatos/buscar": {
      "get": {
        "summary": "Buscar contatos",
        "parameters": [
          {
            "name": "telefone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nome",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados da busca",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contatos/criar": {
      "post": {
        "summary": "Criar contato",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contato criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contatos/lista": {
      "post": {
        "summary": "Importar lista de contatos",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactListImport"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lista importada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "importados": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contatos/atualizar/{id}": {
      "put": {
        "summary": "Atualizar contato",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contatos/deletar/{id}": {
      "delete": {
        "summary": "Deletar contato",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/create": {
      "post": {
        "summary": "Criar agente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agente criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/edit/{id}": {
      "put": {
        "summary": "Atualizar agente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/getall": {
      "get": {
        "summary": "Buscar todos os agentes",
        "responses": {
          "200": {
            "description": "Lista de agentes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agent/get/{id}": {
      "get": {
        "summary": "Buscar agente por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do agente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentItem"
                }
              }
            }
          }
        }
      }
    },
    "/agent/delete/{id}": {
      "delete": {
        "summary": "Deletar agente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}