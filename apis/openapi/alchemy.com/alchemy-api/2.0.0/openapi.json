{
  "openapi": "3.0.3",
  "info": {
    "title": "Alchemy Data API",
    "version": "2.0.0",
    "description": "Alchemy's enhanced Data APIs for blockchain development. Provides higher-level abstractions over raw JSON-RPC including NFT API, Token API, Transfers API, Transaction Receipts, Webhooks, and more. Supports Ethereum, Polygon, Arbitrum, Optimism, Base, and other EVM chains.",
    "x-jentic-source-url": "https://docs.alchemy.com/"
  },
  "servers": [
    {
      "url": "https://{network}.g.alchemy.com",
      "description": "Alchemy API endpoint",
      "variables": {
        "network": {
          "default": "eth-mainnet",
          "description": "Network identifier (eth-mainnet, eth-sepolia, polygon-mainnet, arb-mainnet, opt-mainnet, base-mainnet, etc.)"
        }
      }
    }
  ],
  "paths": {
    "/v2/{apiKey}": {
      "post": {
        "operationId": "jsonRpcCall",
        "summary": "JSON-RPC endpoint",
        "description": "Send JSON-RPC requests for standard Ethereum methods and Alchemy enhanced methods. Supports: eth_blockNumber, eth_getBalance, eth_getTransactionReceipt, eth_call, eth_estimateGas, eth_getBlockByNumber, eth_getBlockByHash, eth_getLogs, eth_getTransactionByHash, alchemy_getTokenBalances, alchemy_getTokenMetadata, alchemy_getAssetTransfers, alchemy_simulateAssetChanges, alchemy_simulateExecution, and many more.",
        "tags": [
          "Core JSON-RPC"
        ],
        "parameters": [
          {
            "name": "apiKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Alchemy API key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/nft/v3/{apiKey}/getNFTsForOwner": {
      "get": {
        "operationId": "getNFTsForOwner",
        "summary": "Get NFTs for owner",
        "description": "Gets all NFTs currently owned by a given address. Supports ERC-721 and ERC-1155 tokens.",
        "tags": [
          "NFT API"
        ],
        "parameters": [
          {
            "name": "apiKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "owner",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Owner wallet address"
          },
          {
            "name": "contractAddresses[]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Filter by contract addresses"
          },
          {
            "name": "pageKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pagination key"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 100
            }
          },
          {
            "name": "withMetadata",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "tokenUriTimeoutInMs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "transferTime"
              ]
            }
          },
          {
            "name": "excludeFilters[]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "SPAM",
                  "AIRDROPS"
                ]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ownedNfts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NftMetadata"
                      }
                    },
                    "totalCount": {
                      "type": "integer"
                    },
                    "pageKey": {
                      "type": "string"
                    },
                    "validAt": {
                      "type": "object",
                      "properties": {
                        "blockNumber": {
                          "type": "integer"
                        },
                        "blockHash": {
                          "type": "string"
                        },
                        "blockTimestamp": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
