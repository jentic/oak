{
  "openapi": "3.0.3",
  "info": {
    "title": "MagicBell API",
    "description": "MagicBell is a notification inbox API that supports broadcasts, push token management (APNs, FCM, Expo), web push, Slack, Teams, in-app inbox channels, and user notification preferences. Uses JWT-based authentication with project-level and user-level tokens.",
    "version": "2.0.0",
    "contact": {
      "name": "MagicBell",
      "url": "https://www.magicbell.com"
    },
    "x-jentic-source-url": "https://www.magicbell.com/docs/api/reference",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.magicbell.com/v2",
      "description": "MagicBell API v2"
    }
  ],
  "security": [
    {
      "projectJwt": []
    }
  ],
  "paths": {
    "/broadcasts": {
      "get": {
        "operationId": "listBroadcasts",
        "summary": "List all broadcasts",
        "description": "Returns a paginated list of all broadcasts.",
        "tags": ["Broadcasts"],
        "security": [{ "projectJwt": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 50 },
            "description": "Number of items to return"
          },
          {
            "name": "starting_after",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Cursor for forward pagination"
          },
          {
            "name": "ending_before",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Cursor for backward pagination"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of broadcasts",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BroadcastList" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createBroadcast",
        "summary": "Create a broadcast",
        "description": "Creates a new broadcast notification sent to specified recipients.",
        "tags": ["Broadcasts"],
        "security": [{ "projectJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BroadcastCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Broadcast created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Broadcast" }
              }
            }
          },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/broadcasts/{broadcast_id}": {
      "get": {
        "operationId": "getBroadcast",
        "summary": "Fetch a broadcast",
        "description": "Retrieves a specific broadcast by ID.",
        "tags": ["Broadcasts"],
        "security": [{ "projectJwt": [] }],
        "parameters": [
          {
            "name": "broadcast_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Broadcast details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Broadcast" }
              }
            }
          },
          "404": { "description": "Broadcast not found" }
        }
      }
    },
    "/channels/mobile_push/apns/tokens": {
      "get": {
        "operationId": "listApnsTokens",
        "summary": "List APNs tokens",
        "tags": ["Mobile Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "starting_after", "in": "query", "schema": { "type": "string" } },
          { "name": "ending_before", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of APNs tokens",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenList" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveApnsToken",
        "summary": "Save an APNs token",
        "tags": ["Mobile Push"],
        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["device_token"],
                "properties": {
                  "device_token": { "type": "string", "minLength": 64 },
                  "app_id": { "type": "string" },
                  "installation_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token saved" }
        }
      }
    },
    "/channels/mobile_push/apns/tokens/{token_id}": {
      "get": {
        "operationId": "getApnsToken",
        "summary": "Fetch an APNs token",
        "tags": ["Mobile Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "APNs token details" },
          "404": { "description": "Token not found" }
        }
      },
      "delete": {
        "operationId": "deleteApnsToken",
        "summary": "Delete an APNs token",
        "tags": ["Mobile Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token deleted" }
        }
      }
    },
