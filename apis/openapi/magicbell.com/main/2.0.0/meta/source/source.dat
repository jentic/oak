        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["device_token"],
                "properties": {
                  "device_token": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token saved" }
        }
      }
    },
    "/channels/mobile_push/expo/tokens/{token_id}": {
