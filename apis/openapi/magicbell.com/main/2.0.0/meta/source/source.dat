          "200": { "description": "Inbox token details" }
        }
      },
      "delete": {
        "operationId": "deleteInboxToken",
        "summary": "Delete an inbox token",
        "tags": ["In-App"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token deleted" }
        }
      }
    },
    "/channels/slack/tokens": {
      "get": {
        "operationId": "listSlackTokens",
        "summary": "List Slack tokens",
        "tags": ["Slack"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "starting_after", "in": "query", "schema": { "type": "string" } },
          { "name": "ending_before", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of Slack tokens" }
        }
      },
      "put": {
        "operationId": "saveSlackToken",
        "summary": "Save a Slack token",
        "tags": ["Slack"],
        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "webhook": {
                    "type": "object",
                    "required": ["url"],
                    "properties": {
                      "url": { "type": "string", "format": "uri" }
                    }
                  },
                  "oauth": {
                    "type": "object",
                    "properties": {
                      "channel_id": { "type": "string" },
                      "installation_id": { "type": "string" },
                      "scope": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token saved" }
        }
      }
    },
    "/channels/slack/tokens/{token_id}": {
      "get": {
        "operationId": "getSlackToken",
        "summary": "Fetch a Slack token",
        "tags": ["Slack"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Slack token details" }
        }
      },
      "delete": {
        "operationId": "deleteSlackToken",
        "summary": "Delete a Slack token",
        "tags": ["Slack"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token deleted" }
        }
      }
    },
    "/channels/teams/tokens": {
      "get": {
        "operationId": "listTeamsTokens",
        "summary": "List Teams tokens",
        "tags": ["Teams"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "starting_after", "in": "query", "schema": { "type": "string" } },
          { "name": "ending_before", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of Teams tokens" }
        }
      },
      "put": {
        "operationId": "saveTeamsToken",
        "summary": "Save a Teams token",
        "tags": ["Teams"],
        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "webhook": {
                    "type": "object",
                    "properties": {
                      "url": { "type": "string", "format": "uri" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token saved" }
        }
      }
    },
    "/channels/teams/tokens/{token_id}": {
      "get": {
        "operationId": "getTeamsToken",
        "summary": "Fetch a Teams token",
        "tags": ["Teams"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Teams token details" }
        }
      },
      "delete": {
        "operationId": "deleteTeamsToken",
        "summary": "Delete a Teams token",
        "tags": ["Teams"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token deleted" }
        }
      }
    },
    "/channels/user_preferences": {
      "get": {
        "operationId": "getUserPreferences",
        "summary": "Fetch channel preferences",
        "description": "Returns the user's notification channel preferences.",
        "tags": ["Preferences"],
        "security": [{ "userJwt": [] }],
        "responses": {
          "200": {
            "description": "User preferences",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserPreferences" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveUserPreferences",
        "summary": "Save channel preferences",
        "description": "Updates the user's notification channel preferences.",
        "tags": ["Preferences"],
        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPreferences" }
            }
          }
        },
        "responses": {
          "200": { "description": "Preferences saved" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "projectJwt": {
        "type": "http",
        "scheme": "bearer",
        "description": "Project-level JWT token for server-side operations (broadcasts, admin)"
      },
      "userJwt": {
        "type": "http",
        "scheme": "bearer",
        "description": "User-level JWT token for user-scoped operations (tokens, preferences)"
      }
    },
    "schemas": {
      "Broadcast": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string", "nullable": true },
          "action_url": { "type": "string", "nullable": true },
          "category": { "type": "string", "nullable": true },
          "topic": { "type": "string", "nullable": true },
          "status": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "BroadcastCreate": {
        "type": "object",
        "required": ["title", "recipients"],
        "properties": {
          "title": { "type": "string", "description": "Notification title" },
          "content": { "type": "string", "description": "Notification body content" },
          "action_url": { "type": "string", "format": "uri", "description": "URL to link to" },
          "category": { "type": "string", "description": "Notification category" },
          "topic": { "type": "string", "description": "Notification topic" },
          "custom_attributes": { "type": "object", "additionalProperties": true },
          "recipients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": { "type": "string" },
                "external_id": { "type": "string" }
              }
            },
            "description": "List of recipients"
          },
          "overrides": {
            "type": "object",
            "additionalProperties": true,
            "description": "Channel-specific overrides"
          }
        }
      },
      "BroadcastList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Broadcast" }
          },
          "links": { "$ref": "#/components/schemas/PaginationLinks" }
        }
      },
      "TokenList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "device_token": { "type": "string" },
                "created_at": { "type": "string", "format": "date-time" }
              }
            }
          },
          "links": { "$ref": "#/components/schemas/PaginationLinks" }
        }
      },
      "UserPreferences": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "channels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "enabled": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": { "type": "string", "nullable": true },
          "next": { "type": "string", "nullable": true },
          "prev": { "type": "string", "nullable": true }
        }
      }
    }
  }
}