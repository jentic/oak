    "/channels/web_push/tokens": {
      "get": {
        "operationId": "listWebPushTokens",
        "summary": "List web push tokens",
        "tags": ["Web Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "starting_after", "in": "query", "schema": { "type": "string" } },
          { "name": "ending_before", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of web push tokens" }
        }
      },
      "put": {
        "operationId": "saveWebPushToken",
        "summary": "Save a web push token",
        "tags": ["Web Push"],
        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["endpoint", "keys"],
                "properties": {
                  "endpoint": { "type": "string", "format": "uri" },
                  "keys": {
                    "type": "object",
                    "required": ["auth", "p256dh"],
                    "properties": {
                      "auth": { "type": "string" },
                      "p256dh": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token saved" }
        }
      }
    },
    "/channels/web_push/tokens/{token_id}": {
      "get": {
        "operationId": "getWebPushToken",
        "summary": "Fetch a web push token",
        "tags": ["Web Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Web push token details" }
        }
      },
      "delete": {
        "operationId": "deleteWebPushToken",
        "summary": "Delete a web push token",
        "tags": ["Web Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token deleted" }
        }
      }
    },
