    "/channels/mobile_push/fcm/tokens/{token_id}": {
      "get": {
        "operationId": "getFcmToken",
        "summary": "Fetch an FCM token",
        "tags": ["Mobile Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
