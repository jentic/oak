          "200": { "description": "Expo token details" }
        }
      },
      "delete": {
        "operationId": "deleteExpoToken",
        "summary": "Delete an Expo token",
        "tags": ["Mobile Push"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "token_id", "in": "path", "required": true, "schema": { "type": "string" } }
