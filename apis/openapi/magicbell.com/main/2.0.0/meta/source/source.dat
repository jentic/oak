        "tags": ["In-App"],
        "security": [{ "userJwt": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "starting_after", "in": "query", "schema": { "type": "string" } },
          { "name": "ending_before", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of inbox tokens" }
        }
      },
      "put": {
        "operationId": "saveInboxToken",
        "summary": "Save an inbox token",
        "tags": ["In-App"],
        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string", "minLength": 64 },
                  "connection_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token saved" }
        }
      }
    },
