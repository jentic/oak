{
  "openapi": "3.0.3",
  "info": {
    "title": "MiniMax API",
    "description": "MiniMax provides AI model APIs including text generation (abab models), text-to-speech, video generation, image generation, and music generation. China-focused AI platform with multilingual support.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://platform.minimaxi.com/document/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.minimaxi.com",
      "description": "MiniMax API (Global)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/text/chatcompletion_v2": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "Create a chat completion",
        "description": "Generate text responses using MiniMax's language models. Supports streaming, system prompts, conversation history, and multiple role types.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Options include MiniMax-M2.7, M2.7-highspeed, M2.5, M2.5-highspeed, M2.1, M2.1-highspeed, M2, M2-her"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["system", "user", "assistant", "user_system", "group", "sample_message_user", "sample_message_ai"],
                          "description": "The role of the message sender"
                        },
                        "content": {
                          "type": "string",
                          "description": "Message content"
                        },
                        "name": {
                          "type": "string",
                          "description": "Sender identifier for distinguishing multiple roles"
                        }
                      }
                    },
                    "description": "Conversation history"
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable streaming responses"
                  },
                  "max_completion_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2048,
                    "description": "Maximum tokens in the response"
                  },
                  "temperature": {
                    "type": "number",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Sampling temperature. Default 1.0 for M2-her"
                  },
                  "top_p": {
                    "type": "number",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Nucleus sampling. Default 0.95 for M2-her"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful completion",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique response identifier"
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "finish_reason": {
                            "type": "string",
                            "enum": ["stop", "length"]
                          },
                          "index": {
                            "type": "integer"
                          },
                          "message": {
                            "type": "object",
                            "properties": {
                              "content": {
                                "type": "string"
                              },
                              "role": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "created": {
                      "type": "integer",
                      "description": "Unix timestamp"
                    },
                    "model": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "enum": ["chat.completion", "chat.completion.chunk"]
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "prompt_tokens": {
                          "type": "integer"
                        },
                        "completion_tokens": {
                          "type": "integer"
                        },
                        "total_tokens": {
                          "type": "integer"
                        }
                      }
                    },
                    "input_sensitive": {
                      "type": "boolean"
                    },
                    "output_sensitive": {
                      "type": "boolean"
                    },
                    "base_resp": {
                      "type": "object",
                      "properties": {
                        "status_code": {
                          "type": "integer"
                        },
                        "status_msg": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/t2a_v2": {
      "post": {
        "operationId": "createSpeech",
        "summary": "Convert text to speech",
        "description": "Synthesize speech from text with configurable voice, speed, pitch, emotion, and audio format. Supports streaming and 300+ system voices.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "text"],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": ["speech-2.8-hd", "speech-2.8-turbo"],
                    "description": "TTS model version"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 10000,
                    "description": "Input text, max 10,000 characters"
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable streaming output"
                  },
                  "voice_setting": {
                    "type": "object",
                    "properties": {
                      "voice_id": {
                        "type": "string",
                        "description": "Voice ID to use"
                      },
                      "speed": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2,
                        "description": "Speech speed multiplier"
                      },
                      "vol": {
                        "type": "number",
                        "exclusiveMinimum": true,
                        "minimum": 0,
                        "maximum": 10,
                        "description": "Volume level"
                      },
                      "pitch": {
                        "type": "integer",
                        "minimum": -12,
                        "maximum": 12,
                        "description": "Pitch adjustment in semitones"
                      },
                      "emotion": {
                        "type": "string",
                        "description": "Emotion for the voice"
                      }
                    }
                  },
                  "audio_setting": {
                    "type": "object",
                    "properties": {
                      "sample_rate": {
                        "type": "integer",
                        "description": "Audio sample rate"
                      },
                      "bitrate": {
                        "type": "integer",
                        "description": "Audio bitrate"
                      },
                      "format": {
                        "type": "string",
                        "enum": ["mp3", "pcm", "flac", "wav"],
                        "description": "Audio output format"
                      },
                      "channel": {
                        "type": "integer",
                        "description": "Number of audio channels"
                      }
                    }
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["url", "hex"],
                    "description": "Output format for non-streaming responses"
                  },
                  "subtitle_enable": {
                    "type": "boolean",
                    "description": "Enable subtitle generation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Speech generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "audio": {
                          "type": "string",
                          "description": "Hex-encoded audio data or URL"
                        },
                        "status": {
                          "type": "integer",
                          "description": "2 for complete"
                        }
                      }
                    },
                    "extra_info": {
                      "type": "object",
                      "properties": {
                        "audio_length": {
                          "type": "number"
                        },
                        "audio_sample_rate": {
                          "type": "integer"
                        },
                        "audio_size": {
                          "type": "integer"
                        }
                      }
                    },
                    "base_resp": {
                      "type": "object",
                      "properties": {
                        "status_code": {
                          "type": "integer"
                        },
                        "status_msg": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/v1/video_generation": {
      "post": {
        "operationId": "createVideoGeneration",
        "summary": "Generate a video from text",
        "description": "Create an asynchronous video generation task from a text prompt. Returns a task_id for status polling.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "prompt"],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": ["MiniMax-Hailuo-2.3", "MiniMax-Hailuo-2.3-Fast", "MiniMax-Hailuo-02", "T2V-01-Director", "T2V-01"],
                    "description": "Video generation model"
                  },
                  "prompt": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Text description of the video to generate"
                  },
                  "prompt_optimizer": {
                    "type": "boolean",
                    "default": true,
                    "description": "Auto-optimize prompt"
                  },
                  "fast_pretreatment": {
                    "type": "boolean",
                    "default": false,
                    "description": "Reduce optimization time"
                  },
                  "duration": {
                    "type": "integer",
                    "enum": [6, 10],
                    "description": "Video length in seconds"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["720P", "768P", "1080P"],
                    "description": "Video resolution"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Webhook URL for status updates"
                  },
                  "aigc_watermark": {
                    "type": "boolean",
                    "default": false,
                    "description": "Add watermark to video"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string",
                      "description": "Task identifier for status polling"
                    },
                    "base_resp": {
                      "type": "object",
                      "properties": {
                        "status_code": {
                          "type": "integer"
                        },
                        "status_msg": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/music_generation": {
      "post": {
        "operationId": "createMusicGeneration",
        "summary": "Generate music from a description",
        "description": "Create a music track from a text prompt and optional lyrics using the music-2.6 model.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "prompt"],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": ["music-2.6"],
                    "description": "Music generation model"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Description of the music to generate"
                  },
                  "lyrics": {
                    "type": "string",
                    "description": "Lyrics for the vocal track"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Music generation task created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "base_resp": {
                      "type": "object",
                      "properties": {
                        "status_code": {
                          "type": "integer"
                        },
                        "status_msg": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/v1/files/upload": {
      "post": {
        "operationId": "uploadFile",
        "summary": "Upload a file",
        "description": "Upload documents (PDF, DOCX, TXT, JSONL) or audio files (MP3, M4A, WAV). Max single file: 512MB, total capacity: 100GB.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "File to upload"
                  },
                  "purpose": {
                    "type": "string",
                    "description": "Purpose of the file upload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file_id": {
                      "type": "string",
                      "description": "Unique file identifier"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/v1/files": {
      "get": {
        "operationId": "listFiles",
        "summary": "List uploaded files",
        "description": "Retrieve a list of all uploaded files.",
        "responses": {
          "200": {
            "description": "List of files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "file_id": {
                            "type": "string"
                          },
                          "filename": {
                            "type": "string"
                          },
                          "purpose": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "MiniMax API key passed as Bearer token. Obtain from platform.minimaxi.com account settings."
      }
    }
  }
}