{
  "openapi": "3.0.3",
  "info": {
    "title": "UN Comtrade API",
    "description": "The United Nations Comtrade database provides international trade statistics. The API allows programmatic access to query trade data by reporter, partner, commodity classification, trade flow, and time period. A subscription key is required for full access; limited preview data is available without authentication.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://comtradeapi.un.org/files/v1/app/reference/ListofReferences.json",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://comtradeapi.un.org"
    }
  ],
  "security": [
    {
      "subscriptionKey": []
    }
  ],
  "paths": {
    "/data/v1/get/{typeCode}/{freqCode}/{clCode}": {
      "get": {
        "operationId": "getTradeData",
        "summary": "Get trade data",
        "description": "Retrieve trade data by type (commodities/services), frequency (annual/monthly), and classification system. Requires subscription key for full access.",
        "parameters": [
          {
            "name": "typeCode",
            "in": "path",
            "required": true,
            "description": "Type of trade: C for commodities, S for services.",
            "schema": { "type": "string", "enum": ["C", "S"] }
          },
          {
            "name": "freqCode",
            "in": "path",
            "required": true,
            "description": "Frequency: A for annual, M for monthly.",
            "schema": { "type": "string", "enum": ["A", "M"] }
          },
          {
            "name": "clCode",
            "in": "path",
            "required": true,
            "description": "Classification code (e.g., HS, H6, SITC, BEC, EB10, EB02).",
            "schema": { "type": "string" }
          },
          {
            "name": "reporterCode",
            "in": "query",
            "required": false,
            "description": "Reporter country/area code (e.g., 842 for USA). Use comma-separated for multiple.",
            "schema": { "type": "string" }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "Time period (year for annual, YYYYMM for monthly). Comma-separated for multiple.",
            "schema": { "type": "string" }
          },
          {
            "name": "partnerCode",
            "in": "query",
            "required": false,
            "description": "Partner country/area code (0 for World). Comma-separated for multiple.",
            "schema": { "type": "string" }
          },
          {
            "name": "partner2Code",
            "in": "query",
            "required": false,
            "description": "Second partner code for re-export analysis.",
            "schema": { "type": "string" }
          },
          {
            "name": "cmdCode",
            "in": "query",
            "required": false,
            "description": "Commodity code. Comma-separated for multiple.",
            "schema": { "type": "string" }
          },
          {
            "name": "flowCode",
            "in": "query",
            "required": false,
            "description": "Trade flow code: M (imports), X (exports), re-exports, re-imports.",
            "schema": { "type": "string" }
          },
          {
            "name": "customsCode",
            "in": "query",
            "required": false,
            "description": "Customs procedure code.",
            "schema": { "type": "string" }
          },
          {
            "name": "motCode",
            "in": "query",
            "required": false,
            "description": "Mode of transport code.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Trade data response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "elapsedTime": { "type": "string" },
                    "count": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TradeRecord" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - subscription key required." },
          "429": { "description": "Rate limit exceeded." }
        }
      }
    },
    "/public/v1/preview/{typeCode}/{freqCode}/{clCode}": {
      "get": {
        "operationId": "previewTradeData",
        "summary": "Preview trade data (no auth required, limited results)",
        "description": "Preview trade data with limited results. Does not require a subscription key but returns a maximum of 500 records.",
        "security": [],
        "parameters": [
          {
            "name": "typeCode",
            "in": "path",
            "required": true,
            "description": "Type of trade: C for commodities, S for services.",
            "schema": { "type": "string", "enum": ["C", "S"] }
          },
          {
            "name": "freqCode",
            "in": "path",
            "required": true,
            "description": "Frequency: A for annual, M for monthly.",
            "schema": { "type": "string", "enum": ["A", "M"] }
          },
          {
            "name": "clCode",
            "in": "path",
            "required": true,
            "description": "Classification code.",
            "schema": { "type": "string" }
          },
          {
            "name": "reporterCode",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "partnerCode",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "cmdCode",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "flowCode",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Preview trade data (max 500 records).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "elapsedTime": { "type": "string" },
                    "count": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TradeRecord" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/v1/getDA/{typeCode}/{freqCode}/{clCode}": {
      "get": {
        "operationId": "getDataAvailability",
        "summary": "Get data availability",
        "description": "Retrieve data availability information showing which reporter countries have data for which periods and classifications.",
        "security": [],
        "parameters": [
          {
            "name": "typeCode",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["C", "S"] }
          },
          {
            "name": "freqCode",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["A", "M"] }
          },
          {
            "name": "clCode",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "reporterCode",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Data availability information.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "elapsedTime": { "type": "string" },
                    "count": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "datasetCode": { "type": "string" },
                          "period": { "type": "integer" },
                          "reporterCode": { "type": "integer" },
                          "reporterISO": { "type": "string" },
                          "classificationCode": { "type": "string" },
                          "totalRecords": { "type": "integer" },
                          "firstReleased": { "type": "string" },
                          "lastReleased": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/files/v1/app/reference/ListofReferences.json": {
      "get": {
        "operationId": "getListOfReferences",
        "summary": "Get list of reference data files",
        "description": "Returns a catalog of all available reference data files including classifications, reporters, partners, and other code lists.",
        "security": [],
        "responses": {
          "200": {
            "description": "List of reference data files.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": { "type": "string" },
                      "fileuri": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "subscriptionKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Ocp-Apim-Subscription-Key",
        "description": "UN Comtrade subscription key. Required for full data access. Preview endpoints are available without authentication."
      }
    },
    "schemas": {
      "TradeRecord": {
        "type": "object",
        "properties": {
          "typeCode": { "type": "string" },
          "freqCode": { "type": "string" },
          "refPeriodId": { "type": "integer" },
          "refYear": { "type": "integer" },
          "refMonth": { "type": "integer" },
          "period": { "type": "string" },
          "reporterCode": { "type": "integer" },
          "partnerCode": { "type": "integer" },
          "partner2Code": { "type": "integer" },
          "flowCode": { "type": "string" },
          "cmdCode": { "type": "string" },
          "classificationCode": { "type": "string" },
          "customsCode": { "type": "string" },
          "motCode": { "type": "string" },
          "mosCode": { "type": "string" },
          "qty": { "type": "number", "nullable": true },
          "qtyUnitCode": { "type": "integer", "nullable": true },
          "isQtyEstimated": { "type": "boolean" },
          "altQty": { "type": "number", "nullable": true },
          "altQtyUnitCode": { "type": "integer", "nullable": true },
          "isAltQtyEstimated": { "type": "boolean" },
          "netWgt": { "type": "number", "nullable": true },
          "grossWgt": { "type": "number", "nullable": true },
          "cifvalue": { "type": "number", "nullable": true },
          "fobvalue": { "type": "number", "nullable": true },
          "primaryValue": { "type": "number" },
          "isReported": { "type": "boolean" },
          "isAggregate": { "type": "boolean" },
          "legacyEstimationFlag": { "type": "integer" }
        }
      }
    }
  }
}
