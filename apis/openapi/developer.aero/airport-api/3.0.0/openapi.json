{
  "openapi": "3.0.3",
  "info": {
    "title": "SITA Airport API",
    "version": "3.0.0",
    "description": "The SITA Airport API provides access to comprehensive airport reference data including IATA/ICAO codes, locations, distances, and nearest airport lookups. It covers global airport information for aviation and travel applications.",
    "x-jentic-source-url": "https://www.developer.aero/api-catalog/airport-api-overview"
  },
  "servers": [
    {
      "url": "https://data-qa.api.aero/data"
    }
  ],
  "paths": {
    "/v3/airports/match/{airportNamePartial}": {
      "get": {
        "operationId": "matchAirports",
        "summary": "Match airports by partial name",
        "description": "Recommends airports based on partial user inputs such as airport name, IATA/ICAO code, or city name.",
        "tags": ["Airports"],
        "parameters": [
          {
            "name": "airportNamePartial",
            "in": "path",
            "required": true,
            "description": "Partial airport name, IATA/ICAO code, or city name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with matching airports",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirportListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/airports/{code}": {
      "get": {
        "operationId": "getAirport",
        "summary": "Get airport by code",
        "description": "Retrieve a specific airport by its IATA or ICAO code.",
        "tags": ["Airports"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "IATA or ICAO airport code",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with airport details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Airport"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/airports": {
      "get": {
        "operationId": "listAirports",
        "summary": "List all airports",
        "description": "Returns data for every airport in the database.",
        "tags": ["Airports"],
        "responses": {
          "200": {
            "description": "Successful response with all airports",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirportListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/airports/distance/{code1}/{code2}": {
      "get": {
        "operationId": "getAirportDistance",
        "summary": "Calculate distance between airports",
        "description": "Calculate the distance between two airports using their IATA or ICAO codes.",
        "tags": ["Airports"],
        "parameters": [
          {
            "name": "code1",
            "in": "path",
            "required": true,
            "description": "IATA or ICAO code of the first airport",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code2",
            "in": "path",
            "required": true,
            "description": "IATA or ICAO code of the second airport",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with distance data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/airports/nearest/{latitude}/{longitude}": {
      "get": {
        "operationId": "getNearestAirport",
        "summary": "Find nearest airport",
        "description": "Find the nearest airport to the given geographic coordinates.",
        "tags": ["Airports"],
        "parameters": [
          {
            "name": "latitude",
            "in": "path",
            "required": true,
            "description": "Latitude coordinate",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "longitude",
            "in": "path",
            "required": true,
            "description": "Longitude coordinate",
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with nearest airport",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Airport"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/airports/samecountry/{code1}/{code2}": {
      "get": {
        "operationId": "checkSameCountry",
        "summary": "Check if airports are in same country",
        "description": "Check whether two airports are located in the same country.",
        "tags": ["Airports"],
        "parameters": [
          {
            "name": "code1",
            "in": "path",
            "required": true,
            "description": "IATA or ICAO code of the first airport",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code2",
            "in": "path",
            "required": true,
            "description": "IATA or ICAO code of the second airport",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with same country check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SameCountryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Airport": {
        "type": "object",
        "properties": {
          "iata": {
            "type": "string",
            "description": "IATA airport code"
          },
          "icao": {
            "type": "string",
            "description": "ICAO airport code"
          },
          "name": {
            "type": "string",
            "description": "Airport name"
          },
          "city": {
            "type": "string",
            "description": "City name"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitude coordinate"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude coordinate"
          },
          "timezone": {
            "type": "string",
            "description": "Timezone identifier"
          },
          "elevation": {
            "type": "number",
            "description": "Elevation in feet"
          },
          "continent": {
            "type": "string",
            "description": "Continent code"
          },
          "countryCode": {
            "type": "string",
            "description": "ISO country code"
          },
          "countryName": {
            "type": "string",
            "description": "Country name"
          },
          "region": {
            "type": "string",
            "description": "Region name"
          },
          "airportType": {
            "type": "string",
            "description": "Type of airport"
          },
          "sitaIdentifier": {
            "type": "string",
            "description": "SITA identifier"
          },
          "localCode": {
            "type": "string",
            "description": "Local airport code"
          }
        }
      },
      "AirportListResponse": {
        "type": "object",
        "properties": {
          "airports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Airport"
            }
          }
        }
      },
      "DistanceResponse": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Origin airport code"
          },
          "to": {
            "type": "string",
            "description": "Destination airport code"
          },
          "distance": {
            "type": "number",
            "description": "Distance between airports"
          },
          "unit": {
            "type": "string",
            "description": "Unit of distance measurement"
          }
        }
      },
      "SameCountryResponse": {
        "type": "object",
        "properties": {
          "code1": {
            "type": "string",
            "description": "First airport code"
          },
          "code2": {
            "type": "string",
            "description": "Second airport code"
          },
          "sameCountry": {
            "type": "boolean",
            "description": "Whether both airports are in the same country"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["error"]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OAuth 2.0 Bearer token obtained via client credentials flow from https://sitaopen.api.aero/data/oauth/token"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}