{
  "openapi": "3.0.3",
  "info": {
    "title": "SITA Aero Flight Schedule API",
    "description": "Provides flight schedule data including routes between airports, airline schedules, and airport-specific departure/arrival information. Supports filtering by airline, flight number, and date range with detailed schedule attributes including aircraft type, terminal assignments, meal service, and on-time performance.",
    "version": "1.2.5",
    "x-jentic-source-url": "https://www.developer.aero/api-catalog/flight-schedule-overview"
  },
  "servers": [
    {
      "url": "https://sitaopen.api.aero/schedule/v1",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "oauth2": []
    }
  ],
  "paths": {
    "/route/departure/{departureAirport}/arrival/{arrivalAirport}": {
      "get": {
        "operationId": "getScheduleByRoute",
        "summary": "Get flight schedules by route",
        "description": "Returns flight schedules between two airports specified by IATA or ICAO codes.",
        "parameters": [
          {
            "name": "departureAirport",
            "in": "path",
            "required": true,
            "description": "Departure airport IATA or ICAO code",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 4
            }
          },
          {
            "name": "arrivalAirport",
            "in": "path",
            "required": true,
            "description": "Arrival airport IATA or ICAO code",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 4
            }
          },
          {
            "name": "operationDateFrom",
            "in": "query",
            "required": false,
            "description": "Start date for operation period filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "operationDateTo",
            "in": "query",
            "required": false,
            "description": "End date for operation period filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupMarketingCarriers",
            "in": "query",
            "required": false,
            "description": "Whether to group codeshare flights under marketing carriers",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with flight schedule data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlightSchedule"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or expired OAuth2 token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No schedules found for the specified route"
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Rate limit ceiling"
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Remaining requests"
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Reset time in epoch seconds"
              }
            }
          }
        }
      }
    },
    "/route/departure/{departureAirport}/arrival/{arrivalAirport}/airline/{airline}": {
      "get": {
        "operationId": "getScheduleByRouteAndAirline",
        "summary": "Get flight schedules by route and airline",
        "description": "Returns flight schedules between two airports filtered by a specific airline.",
        "parameters": [
          {
            "name": "departureAirport",
            "in": "path",
            "required": true,
            "description": "Departure airport IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "arrivalAirport",
            "in": "path",
            "required": true,
            "description": "Arrival airport IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "airline",
            "in": "path",
            "required": true,
            "description": "Airline IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operationDateFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "operationDateTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupMarketingCarriers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with filtered flight schedule data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlightSchedule"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/route/departure/{departureAirport}/arrival/{arrivalAirport}/airline/{airline}/flightNumber/{flightNumber}": {
      "get": {
        "operationId": "getScheduleByRouteAirlineAndFlight",
        "summary": "Get flight schedule by route, airline, and flight number",
        "description": "Returns flight schedules for a specific flight number on a specific route.",
        "parameters": [
          {
            "name": "departureAirport",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "arrivalAirport",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "airline",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flightNumber",
            "in": "path",
            "required": true,
            "description": "Flight number",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operationDateFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "operationDateTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupMarketingCarriers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlightSchedule"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/airline/{airline}": {
      "get": {
        "operationId": "getScheduleByAirline",
        "summary": "Get all schedules for an airline",
        "description": "Retrieves all active flight schedules for a specified airline.",
        "parameters": [
          {
            "name": "airline",
            "in": "path",
            "required": true,
            "description": "Airline IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operationDateFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "operationDateTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupMarketingCarriers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with airline schedule data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlightSchedule"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/airline/{airline}/flightNumber/{flightNumber}": {
      "get": {
        "operationId": "getScheduleByAirlineAndFlight",
        "summary": "Get schedule by airline and flight number",
        "description": "Returns schedules for a specific flight number across all routes for the given airline.",
        "parameters": [
          {
            "name": "airline",
            "in": "path",
            "required": true,
            "description": "Airline IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flightNumber",
            "in": "path",
            "required": true,
            "description": "Flight number",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operationDateFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "operationDateTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupMarketingCarriers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlightSchedule"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/airport/{airportCode}/direction/{adi}": {
      "get": {
        "operationId": "getScheduleByAirportDirection",
        "summary": "Get airport arrivals or departures schedule",
        "description": "Retrieves departure or arrival schedules for a specific airport.",
        "parameters": [
          {
            "name": "airportCode",
            "in": "path",
            "required": true,
            "description": "Airport IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "adi",
            "in": "path",
            "required": true,
            "description": "Direction indicator: A for arrivals, D for departures",
            "schema": {
              "type": "string",
              "enum": ["A", "D"]
            }
          },
          {
            "name": "operationDateFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "operationDateTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupMarketingCarriers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with airport schedule data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlightSchedule"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth2 authentication with 1-hour token expiry",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://sitaopen.api.aero/auth/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "FlightSchedule": {
        "type": "object",
        "properties": {
          "departureAirport": {
            "type": "string",
            "description": "Departure airport IATA code"
          },
          "arrivalAirport": {
            "type": "string",
            "description": "Arrival airport IATA code"
          },
          "airline": {
            "type": "string",
            "description": "Operating airline IATA code"
          },
          "flightNumber": {
            "type": "string",
            "description": "Flight number"
          },
          "aircraftType": {
            "type": "string",
            "description": "IATA aircraft type code"
          },
          "operationDays": {
            "type": "string",
            "description": "Days of operation (1=Monday through 7=Sunday)"
          },
          "operationDateFrom": {
            "type": "string",
            "format": "date",
            "description": "Start of operation period"
          },
          "operationDateTo": {
            "type": "string",
            "format": "date",
            "description": "End of operation period"
          },
          "departureTime": {
            "type": "string",
            "description": "Scheduled departure time (local)"
          },
          "arrivalTime": {
            "type": "string",
            "description": "Scheduled arrival time (local)"
          },
          "departureTerminal": {
            "type": "string",
            "description": "Departure terminal"
          },
          "arrivalTerminal": {
            "type": "string",
            "description": "Arrival terminal"
          },
          "elapsedTime": {
            "type": "integer",
            "description": "Flight duration in minutes"
          },
          "marketingCarriers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "airline": {
                  "type": "string"
                },
                "flightNumber": {
                  "type": "string"
                }
              }
            },
            "description": "Codeshare marketing carriers"
          },
          "cabinClasses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string"
                },
                "mealService": {
                  "type": "string"
                }
              }
            },
            "description": "Available cabin classes and meal service"
          },
          "inFlightServices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Available in-flight services"
          },
          "onTimePerformance": {
            "type": "number",
            "format": "double",
            "description": "On-time performance indicator"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "description": "Error code"
          },
          "errorDescription": {
            "type": "string",
            "description": "Error description"
          },
          "invalidParameterName": {
            "type": "string",
            "description": "Name of the invalid parameter"
          },
          "suggestedValue": {
            "type": "string",
            "description": "Suggested valid value"
          }
        }
      }
    }
  }
}