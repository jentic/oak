{
  "openapi": "3.0.3",
  "info": {
    "title": "SITA Aero Airport API",
    "description": "Provides airport reference data including airport details by code or name, distance calculations between airports, nearest airport lookups by coordinates, and country comparison. Supports IATA and ICAO airport codes with comprehensive airport metadata.",
    "version": "3.0.0",
    "x-jentic-source-url": "https://www.developer.aero/api-catalog/airport-api-overview"
  },
  "servers": [
    {
      "url": "https://sitaopen.api.aero/data/v3",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "oauth2": []
    }
  ],
  "paths": {
    "/airports": {
      "get": {
        "operationId": "getAllAirports",
        "summary": "Get all airports",
        "description": "Returns data for all airports available in the database.",
        "responses": {
          "200": {
            "description": "Successful response with all airport data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Airport"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or expired OAuth2 token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              },
              "retry-after": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/airports/{airportCode}": {
      "get": {
        "operationId": "getAirportByCode",
        "summary": "Get airport by code",
        "description": "Retrieves detailed information for a specific airport using its IATA or ICAO code.",
        "parameters": [
          {
            "name": "airportCode",
            "in": "path",
            "required": true,
            "description": "Airport IATA (3-letter) or ICAO (4-letter) code",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 4
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with airport details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Airport"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid airport code format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Airport not found"
          }
        }
      }
    },
    "/airports/match/{airportNamePartial}": {
      "get": {
        "operationId": "matchAirportsByName",
        "summary": "Search airports by name or code",
        "description": "Locates airports matching partial text against IATA/ICAO codes, city names, or airport names.",
        "parameters": [
          {
            "name": "airportNamePartial",
            "in": "path",
            "required": true,
            "description": "Partial airport name, city name, or code to search for",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with matching airports",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Airport"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/airports/distance/{airport1}/{airport2}": {
      "get": {
        "operationId": "calculateDistanceBetweenAirports",
        "summary": "Calculate distance between airports",
        "description": "Computes the distance between two airports using Great Circle Mileage methodology.",
        "parameters": [
          {
            "name": "airport1",
            "in": "path",
            "required": true,
            "description": "First airport IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "airport2",
            "in": "path",
            "required": true,
            "description": "Second airport IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with distance calculation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistanceResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid airport codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/airports/nearest/{latitude}/{longitude}": {
      "get": {
        "operationId": "findNearestAirport",
        "summary": "Find nearest airport",
        "description": "Identifies the closest airport to the provided geographic coordinates.",
        "parameters": [
          {
            "name": "latitude",
            "in": "path",
            "required": true,
            "description": "Latitude coordinate",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "longitude",
            "in": "path",
            "required": true,
            "description": "Longitude coordinate",
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with nearest airport",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Airport"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid coordinates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/airports/samecountry/{airport1}/{airport2}": {
      "get": {
        "operationId": "checkSameCountry",
        "summary": "Check if airports are in same country",
        "description": "Determines whether two airports are located in the same country.",
        "parameters": [
          {
            "name": "airport1",
            "in": "path",
            "required": true,
            "description": "First airport IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "airport2",
            "in": "path",
            "required": true,
            "description": "Second airport IATA or ICAO code",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with country comparison result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SameCountryResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth2 authentication with 1-hour token expiry",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://sitaopen.api.aero/data/oauth/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "Airport": {
        "type": "object",
        "properties": {
          "iataCode": {
            "type": "string",
            "description": "IATA 3-letter airport code"
          },
          "icaoCode": {
            "type": "string",
            "description": "ICAO 4-letter airport code"
          },
          "name": {
            "type": "string",
            "description": "Airport name"
          },
          "city": {
            "type": "string",
            "description": "City name"
          },
          "country": {
            "type": "string",
            "description": "Country name"
          },
          "continent": {
            "type": "string",
            "description": "Continent identifier"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Airport latitude"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Airport longitude"
          },
          "elevation": {
            "type": "number",
            "format": "double",
            "description": "Airport elevation"
          },
          "timezone": {
            "type": "string",
            "description": "Airport timezone (IANA format)"
          }
        }
      },
      "DistanceResult": {
        "type": "object",
        "properties": {
          "airport1": {
            "type": "string",
            "description": "First airport code"
          },
          "airport2": {
            "type": "string",
            "description": "Second airport code"
          },
          "distance": {
            "type": "number",
            "format": "double",
            "description": "Distance value"
          },
          "unit": {
            "type": "string",
            "description": "Distance unit (km by default)",
            "default": "km"
          }
        }
      },
      "SameCountryResult": {
        "type": "object",
        "properties": {
          "airport1": {
            "type": "string",
            "description": "First airport code"
          },
          "airport2": {
            "type": "string",
            "description": "Second airport code"
          },
          "sameCountry": {
            "type": "boolean",
            "description": "Whether both airports are in the same country"
          },
          "country1": {
            "type": "string",
            "description": "Country of first airport"
          },
          "country2": {
            "type": "string",
            "description": "Country of second airport"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "description": "Error code"
          },
          "errorDescription": {
            "type": "string",
            "description": "Error description"
          }
        }
      }
    }
  }
}