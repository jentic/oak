                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "referenceExpired": {
                    "value": {
                      "error": {
                        "code": "REFERENCE_EXPIRED",
                        "message": "Offer expired or already converted",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Hotel not found",
