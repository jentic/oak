            "schema": {
              "type": "integer"
            },
            "description": "Hotel ID"
          },
          {
            "name": "checkin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Check-in date (YYYY-MM-DD)"
          },
          {
            "name": "checkout",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Check-out date (YYYY-MM-DD)"
          },
          {
            "name": "guests",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]([0-9\\-,]*[0-9])?$"
            },
            "description": "Occupancy for one room (same format as search). Multi-room not supported in v1."
          },
          {
            "name": "nationality",
            "in": "query",
