                },
                "examples": {
                  "validationError": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Invalid booking reference",
                        "details": null
                      }
                    }
                  },
                  "referenceInvalid": {
                    "value": {
                      "error": {
                        "code": "REFERENCE_INVALID",
                        "message": "Numeric ID sent instead of ref_xxxx",
                        "details": null
                      }
                    }
                  },
                  "bookingNotFound": {
                    "value": {
                      "error": {
                        "code": "BOOKING_NOT_FOUND",
                        "message": "Booking doesn't exist or already cancelled",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bookings/cancelBooking": {
      "post": {
        "summary": "Cancel booking",
        "description": "Cancels a confirmed booking. Supports simulation mode with isTest=true.",
        "operationId": "cancelBooking",
        "tags": [
          "Cancellation"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKeyHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelBookingRequest"
              },
              "examples": {
                "realCancellation": {
                  "value": {
                    "bookingNumber": "ref_bk9876"
                  }
                },
                "testCancellation": {
                  "value": {
                    "bookingNumber": "ref_bk9876",
                    "isTest": "true"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelBookingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation or reference error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "bookingNotFound": {
                    "value": {
                      "error": {
                        "code": "BOOKING_NOT_FOUND",
                        "message": "Booking doesn't exist, not yours, or already cancelled",
                        "details": null
                      }
                    }
                  },
                  "validationError": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Cannot cancel a booking in the past",
                        "details": null
                      }
                    }
                  },
                  "referenceInvalid": {
                    "value": {
                      "error": {
                        "code": "REFERENCE_INVALID",
                        "message": "Numeric ID sent instead of ref_xxxx",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from /auth/login or /auth/signup.\n\n**Important:** Distributor accounts must be **activated** by the platform before they can call protected endpoints. If the account is not yet activated, requests return **403** with code `ACCOUNT_NOT_ACTIVATED`.\n"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "User ID"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "User name"
          },
          "surname": {
            "type": "string",
            "nullable": true,
            "description": "User surname"
          },
          "username": {
            "type": "string",
            "description": "Username"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          },
          "isActivated": {
            "type": "boolean",
            "description": "Whether the account is activated"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "description": "JWT authentication token"
              },
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      },
      "RefreshTokenResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "description": "Refreshed JWT authentication token"
              }
            }
          }
        }
      },
      "InvalidateTokenResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "examples": [
                  "Token invalidated successfully."
                ]
              }
            }
          }
        }
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "description": "JWT authentication token"
              },
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code",
                "enum": [
                  "INVALID_CREDENTIALS",
                  "TOKEN_EXPIRED",
                  "TOKEN_INVALID",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "ACCOUNT_NOT_ACTIVATED",
                  "NOT_FOUND",
                  "HOTEL_NOT_FOUND",
                  "BOOKING_NOT_FOUND",
                  "VALIDATION_ERROR",
                  "REFERENCE_INVALID",
                  "REFERENCE_EXPIRED",
                  "SEARCH_SESSION_EXPIRED",
                  "RATE_LIMIT_EXCEEDED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable description"
              },
              "details": {
                "nullable": true,
                "description": "Additional error details"
              }
            }
          }
        }
      },
      "HotelDetailsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "hotel": {
                "$ref": "#/components/schemas/Hotel"
              },
              "rooms": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Room"
                }
              },
              "ratePlans": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RatePlan"
                }
              },
              "mealPlans": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MealPlan"
                }
              },
              "hotelExtras": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HotelExtra"
                }
              },
              "pricingInfo": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/RatePlanPricing"
                }
              }
            }
          }
        }
      },
      "Hotel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Hotel ID"
          },
          "name": {
            "type": "string",
            "description": "Hotel name"
          },
          "address": {
            "type": "string",
            "description": "Street address"
          },
          "city": {
            "type": "string",
            "description": "City name"
          },
          "postalCode": {
            "type": "string",
            "description": "Postal code"
          },
          "country": {
            "type": "string",
            "description": "Country code (ISO 3166-1 alpha-2)"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitude coordinate"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude coordinate"
          },
          "description": {
            "type": "string",
            "description": "Hotel description"
          },
          "stars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Hotel star rating"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ],
            "description": "Hotel operational status"
          },
          "giata": {
            "type": "string",
            "nullable": true,
            "description": "GIATA code"
          },
          "contact": {
            "$ref": "#/components/schemas/HotelContact"
          },
          "checkInOut": {
            "$ref": "#/components/schemas/CheckInOut"
          },
          "childAges": {
            "$ref": "#/components/schemas/AgeRange"
          },
          "taxesAndFees": {
            "type": "string",
            "nullable": true,
            "description": "Information about taxes and fees"
          },
          "amenities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Amenity"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Hotel image URLs"
          }
        }
      },
      "HotelContact": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "person": {
            "type": "string",
            "nullable": true,
            "description": "Contact person name"
          },
          "reservationEmail": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "tel1": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CheckInOut": {
        "type": "object",
        "properties": {
          "checkInFrom": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Check-in start time (HH:mm format)"
          },
          "checkInTo": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Check-in end time (HH:mm format)"
          },
          "checkOutFrom": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Check-out start time (HH:mm format)"
          },
          "checkOutTo": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Check-out end time (HH:mm format)"
          }
        }
      },
      "AgeRange": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer"
          }
        }
      },
      "Amenity": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "roomCode": {
            "type": "string",
            "description": "Unique room code"
          },
          "type": {
            "type": "string",
            "description": "Room type name"
          },
          "adultsNumber": {
            "type": "integer",
            "description": "Standard number of adults"
          },
          "childrenNumber": {
            "type": "integer",
            "description": "Standard number of children"
          },
          "minOccupancy": {
            "type": "integer",
            "description": "Minimum occupancy"
          },
          "maxOccupancy": {
            "type": "integer",
            "description": "Maximum occupancy"
          },
          "childAges": {
            "$ref": "#/components/schemas/ChildAges"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "amenities": {
            "nullable": true
          }
        }
      },
      "ChildAges": {
        "type": "object",
        "properties": {
          "child1Min": {
            "type": "integer",
            "nullable": true
          },
          "child1Max": {
            "type": "integer",
            "nullable": true
          },
          "child2Min": {
            "type": "integer",
            "nullable": true
          },
          "child2Max": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "RatePlan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Rate plan ID"
          },
          "code": {
            "type": "string",
            "description": "Rate plan code"
          },
          "description": {
            "type": "string",
            "description": "Rate plan description"
          },
          "boardCode": {
            "type": "string",
            "description": "Board type code (e.g., RO, BB, HB, FB)"
          },
          "boardDescription": {
            "type": "string",
            "description": "Board type description"
          },
          "currency": {
            "type": "string",
            "description": "Currency code (ISO 4217)"
          },
          "mlos": {
            "type": "integer",
            "description": "Minimum length of stay"
          },
          "releaseDays": {
            "type": "integer",
            "description": "Release days before check-in"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ]
          },
          "bookingWindow": {
            "$ref": "#/components/schemas/DateRange"
          },
          "cancellationPolicies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CancellationPolicy"
            }
          }
        }
      },
      "DateRange": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CancellationPolicy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "daysBefore": {
            "type": "integer",
            "description": "Days before check-in when penalty applies"
          },
          "penaltyType": {
            "type": "string",
            "enum": [
              "amount",
              "percentage"
            ]
          },
          "amount": {
            "type": "string",
            "description": "Penalty amount (if penaltyType is 'amount')"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "MealPlan": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Meal plan code"
          },
          "name": {
            "type": "string",
            "description": "Meal plan name"
          }
        }
      },
      "HotelExtra": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Extra service name"
          },
          "adultPrice": {
            "type": "string",
            "description": "Price per adult"
          },
          "childPrice": {
            "type": "string",
            "description": "Price per child"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "chargeType": {
            "type": "string",
            "enum": [
              "per_person",
              "per_room",
              "per_stay"
            ]
          },
          "isRequired": {
            "type": "boolean"
          }
        }
      },
      "RatePlanPricing": {
        "type": "object",
        "properties": {
