          },
          "404": {
            "description": "Session does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "value": {
                      "error": {
                        "code": "NOT_FOUND",
                        "message": "Session does not exist",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Search session expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "sessionExpired": {
                    "value": {
                      "error": {
                        "code": "SEARCH_SESSION_EXPIRED",
                        "message": "Session expired",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bookings/prebook": {
      "post": {
        "summary": "Create temporary offer",
        "description": "Creates a **temporary offer** from a selected option. The offer has a limited validity window (**10 minutes**) during which you must confirm the booking.\n\n**Important:** Do not send `packagePrice`, `rooms`, or `cancelPolicy`. The server retrieves these from the search cache.\n",
        "operationId": "createPrebook",
        "tags": [
          "Prebooking"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrebookRequest"
              },
              "examples": {
                "basicPrebook": {
                  "value": {
                    "optionRefId": "ref_a1b2c3",
                    "hotelRemarks": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Prebook created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrebookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "validationError": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "optionRefId not provided",
                        "details": null
                      }
                    }
                  },
                  "referenceInvalid": {
                    "value": {
                      "error": {
                        "code": "REFERENCE_INVALID",
                        "message": "Reference expired or cannot be resolved \u2014 perform a new search",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bookings/create/simulate": {
      "post": {
        "summary": "Simulate booking creation",
        "description": "Validates all booking data **without creating a reservation**. Use this to check guest data, availability, pricing, and extras before confirming.",
        "operationId": "simulateBooking",
        "tags": [
          "Booking"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingSimulateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingSimulateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation or reference error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "referenceInvalid": {
                    "value": {
                      "error": {
                        "code": "REFERENCE_INVALID",
                        "message": "Numeric offerId sent instead of ref_xxxx",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "referenceExpired": {
                    "value": {
                      "error": {
                        "code": "REFERENCE_EXPIRED",
                        "message": "Offer expired or already used",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Hotel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bookings/create": {
      "post": {
        "summary": "Confirm booking",
        "description": "Confirms a reservation from a prebooked offer.",
