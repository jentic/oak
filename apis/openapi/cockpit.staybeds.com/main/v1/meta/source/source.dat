        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "adults": {
            "type": "integer"
          },
          "children": {
            "type": "integer"
          },
          "paxType": {
            "type": "string",
            "description": "Passenger configuration (e.g., \"2+0\", \"2+1\")"
          },
          "price": {
            "type": "string",
            "description": "Price amount"
          },
          "currency": {
            "type": "string",
            "description": "Currency code (ISO 4217)"
          },
          "mealPlan": {
            "type": "string",
            "description": "Meal plan code"
          },
          "roomId": {
            "type": "string",
            "description": "Room code"
          },
          "minStay": {
            "type": "integer",
            "description": "Minimum stay requirement"
          },
          "allotment": {
            "type": "integer",
            "description": "Available rooms"
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "Limited",
              "Unavailable"
            ]
          }
        }
      },
      "HotelsListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "currentPage": {
                "type": "integer",
                "description": "Current page number"
              },
              "hotels": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HotelListItem"
                }
              },
              "firstPageUrl": {
                "type": "string",
                "format": "uri",
                "description": "URL to first page"
              },
              "lastPageUrl": {
                "type": "string",
                "format": "uri",
                "description": "URL to last page"
              },
              "perPage": {
                "type": "integer",
                "description": "Items per page"
              },
              "total": {
                "type": "integer",
                "description": "Total number of hotels"
              }
            }
          }
        }
      },
      "HotelListItem": {
        "type": "object",
        "properties": {
          "hotelId": {
            "type": "integer",
            "description": "Hotel ID"
          },
          "hotelName": {
            "type": "string",
            "description": "Hotel name"
          }
        }
      },
      "HotelAutocompleteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "hotels": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HotelAutocompleteItem"
                }
              }
            }
          }
        }
      },
      "HotelAutocompleteItem": {
        "type": "object",
        "properties": {
          "hotelId": {
            "type": "integer",
            "description": "Hotel ID"
          },
          "hotelName": {
            "type": "string",
            "nullable": true,
            "description": "Hotel name"
          },
          "city": {
            "type": "string",
            "nullable": true,
            "description": "City where the hotel is located"
          },
          "countryCode": {
            "type": "string",
            "nullable": true,
            "description": "ISO 3166-1 alpha-2 country code (e.g. ES)"
          }
        }
      },
      "CitiesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "cities": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CityItem"
                }
              },
              "total": {
                "type": "integer",
                "description": "Total number of cities"
              },
              "countryFilter": {
                "type": "string",
                "nullable": true,
                "description": "Applied country filter (if any)"
              }
            }
          }
        }
      },
      "CityItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "City name"
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code"
          },
          "hotelCount": {
            "type": "integer",
            "description": "Number of active hotels in this city"
          }
        }
      },
      "CountriesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "countries": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CountryItem"
                }
              },
              "total": {
                "type": "integer",
                "description": "Total number of countries"
              }
            }
          }
        }
      },
      "CountryItem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code"
          },
          "hotelCount": {
            "type": "integer",
            "description": "Number of active hotels in this country"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "searchId": {
                "type": "string",
                "format": "uuid",
                "description": "Search session ID for pagination and pricing"
              },
              "hotels": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HotelSearchResult"
                }
              },
              "pagination": {
                "$ref": "#/components/schemas/SearchPagination"
              },
              "metadata": {
                "$ref": "#/components/schemas/SearchMetadata"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "description": "When search results expire"
              }
            }
          }
