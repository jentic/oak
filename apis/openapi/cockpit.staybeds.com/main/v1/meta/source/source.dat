    "/prices/search/{searchId}": {
      "get": {
        "summary": "Retrieve cached search results",
        "description": "Retrieve a cached page of results from a previous search session.",
        "operationId": "getSearchResults",
        "tags": [
          "Search & Availability"
        ],
        "parameters": [
          {
            "name": "searchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search session ID from a search endpoint"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Page number (\u2265 1)"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "description": "Results per page (1\u2013100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Cached search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "validationError": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Invalid page or pageSize",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Session does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "value": {
                      "error": {
                        "code": "NOT_FOUND",
                        "message": "Session does not exist",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Search session expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "sessionExpired": {
                    "value": {
                      "error": {
                        "code": "SEARCH_SESSION_EXPIRED",
                        "message": "Session expired \u2014 perform a new search",
                        "details": null
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/prices/pricing/{searchId}": {
      "get": {
        "summary": "Fetch on-demand pricing",
        "description": "Fetches on-demand pricing for hotels with pricingStatus pending.",
        "operationId": "fetchPricing",
        "tags": [
