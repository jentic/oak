      "WorkspaceListResponse": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "count": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "currentPage": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "header": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "QueryFilters": {
        "type": "object",
        "description": "QueryFilterProcessor filter object.",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryFilterItem"
            }
          }
        }
      },
      "QueryFilterItem": {
        "type": "object",
        "description": "Filter unit. Use grouped form (`type` + `items`) or leaf form (`field` + `operator` + payload) or (`fieldId` + `operator` + payload).",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "and",
              "or",
              "custom"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "field": {
            "type": "string",
            "description": "Friendly field name (information.displayName) or standard alias (recommended)."
          },
          "fieldId": {
            "type": "string",
            "description": "Legacy field key (standard field alias or information.id)."
          },
          "operator": {
            "type": "string",
            "description": "Operator name. Recommended names by type:\nText: `is`, `not`, `contains`, `excludes`, `startsWith`, `endsWith`\nNumber: `min` (>=), `above` (>), `max` (<=), `below` (<), `between`\nDate: `after` (>=), `before` (<=), `between`\nNull: `empty` (is null), `exists` (has value)\nBoolean: `yes`, `no`\nSpecial: `me` (current user), `in` (time window)\nAll operator names are case-insensitive with 60+ aliases accepted."
          },
          "payload": {
            "description": "Operator payload. Format depends on operator type. For state filters, supports either state name string (recommended) or object payload with `id`.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "formula": {
            "type": "string"
          },
          "script": {
            "type": "string"
          }
        }
      },
      "QuerySort": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "Friendly field name (information.displayName) or standard alias (recommended)."
              },
              "fieldId": {
                "type": "string",
                "description": "Legacy field key (standard alias or information.id)."
              },
              "direction": {
                "type": "integer",
                "enum": [
                  1,
                  -1
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "enum": [
                1,
                -1
              ]
            }
          }
        ],
        "description": "Sort definition. Preferred format is `{ field, direction }` (or `{ fieldId, direction }` for compatibility). Legacy map style `{ \"<field>\": 1|-1 }` is also supported."
      },
      "ModuleDiscoveryItem": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          }
        }
      },
      "ModuleDiscoveryDetail": {
        "type": "object",
        "properties": {
          "module": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "emoji": {
                "type": "string"
              },
              "isUserCollection": {
                "type": "boolean"
              },
              "workspaceId": {
                "type": "integer",
                "nullable": true
              },
              "workspaceName": {
                "type": "string",
                "nullable": true
              },
              "updatedOn": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          },
          "information": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "standardActivities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "listings": {
            "type": "array",
            "description": "Available listings (menus) for this module. Use listings[].id as listingId in POST /api/m/list.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "flows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "permissions": {
            "type": "object",
            "properties": {
              "read": {
                "type": "boolean"
              },
              "write": {
                "type": "boolean"
              },
              "execute": {
                "type": "boolean"
              }
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "studioMobile": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Use \"fsk {your api key}\". API key location: https://community.inistate.com/t/api-key-location-instructions/62"
      },
      "oAuth": {
        "type": "oauth2",
        "flows": {
          "password": {
            "tokenUrl": "/token",
            "scopes": {}
          }
        }
      }
    }
  }
}