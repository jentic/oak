{
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "https://api.inistate.com"
    }
  ],
  "info": {
    "version": "1.0.0",
    "title": "Inistate API Documentation",
    "description": "This is the official API documentation for Inistate. <br> Inistate is a progressive business app builder for growing business <br> Supercharged with workflow, automation, integration<br><br> For more information, please visit [Inistate](https://inistate.com) or contact <sales@inistate.com>",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Inistate/InistateAPI/1.0.0"
  },
  "security": [
    {
      "apiKey": []
    },
    {
      "oAuth": []
    }
  ],
  "tags": [
    {
      "name": "Workspace"
    },
    {
      "name": "Activity"
    },
    {
      "name": "ModuleDiscovery"
    },
    {
      "name": "MCP",
      "description": "MCP-dedicated endpoints for AI/LLM integration"
    }
  ],
  "paths": {
    "/api/workspace": {
      "description": "Public workspace search.",
      "get": {
        "tags": [
          "Workspace"
        ],
        "security": [],
        "summary": "Retrieve list of workspaces",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "description": "Name of the workspace",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkspaceListItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/{workspaceId}": {
      "get": {
        "tags": [
          "Workspace"
        ],
        "summary": "Get detail of a workspace",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/list": {
      "post": {
        "tags": [
          "Workspace"
        ],
        "summary": "Retrieve entries from a listing",
        "description": "Retrieves listing data with pagination, runtime filtering and sorting. Filtering follows QueryFilterProcessor format (`filters.items`). Filter leaves support both `field` (friendly name/alias) and legacy `fieldId`. State filters support both payload styles: state name string or `{ id }`. If `listingId` is provided, listing-level authorization and base filter rules are applied before runtime filters.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListRequest"
              },
              "examples": {
                "filteredByStateAndDate": {
                  "value": {
                    "moduleId": "3818",
                    "listingId": "allLeave",
                    "currentPage": 0,
                    "pageSize": 20,
                    "filters": {
                      "items": [
                        {
                          "field": "state",
                          "operator": "is",
                          "payload": "Approved"
                        },
                        {
                          "field": "createdDate",
                          "operator": "between",
                          "payload": {
                            "startDate": "2026-02-01T00:00:00Z",
                            "endDate": "2026-02-28T00:00:00Z"
                          }
                        }
                      ]
                    },
                    "sorts": [
                      {
                        "field": "createdDate",
                        "direction": -1
                      }
                    ]
                  }
                },
                "textSearchAndStateExclude": {
                  "value": {
                    "moduleId": "3818",
                    "listingId": "allLeave",
                    "currentPage": 0,
                    "pageSize": 20,
                    "filters": {
                      "items": [
                        {
                          "field": "documentId",
                          "operator": "contains",
                          "payload": "LV-2026"
                        },
                        {
                          "field": "state",
                          "operator": "not",
                          "payload": "Cancelled"
                        }
                      ]
                    },
                    "sorts": [
                      {
                        "field": "createdDate",
                        "direction": -1
                      }
                    ]
                  }
                },
                "myTasksDueSoon": {
                  "value": {
                    "moduleId": "3818",
                    "listingId": "myTasks",
                    "currentPage": 0,
                    "pageSize": 50,
                    "filters": {
                      "items": [
                        {
                          "field": "assignTo",
                          "operator": "me"
                        },
                        {
                          "field": "due",
                          "operator": "in",
                          "payload": {
                            "duration": "day",
                            "offset": 7
                          }
                        }
                      ]
                    }
                  }
                },
                "legacyFieldIdAndStateId": {
                  "value": {
                    "moduleId": "3818",
                    "listingId": "allLeave",
                    "currentPage": 0,
                    "pageSize": 20,
                    "filters": {
                      "items": [
                        {
                          "fieldId": "state",
                          "operator": "is",
                          "payload": {
                            "id": "approved"
                          }
                        },
                        {
                          "fieldId": "createdDate",
                          "operator": "between",
                          "payload": {
                            "startDate": "2026-02-01T00:00:00Z",
                            "endDate": "2026-02-28T00:00:00Z"
                          }
                        }
                      ]
                    },
                    "sorts": [
                      {
                        "field": "createdDate",
                        "direction": -1
                      }
                    ]
                  }
                },
                "tableNestedFilter": {
                  "value": {
                    "moduleId": "5001",
                    "listingId": "purchaseOrders",
                    "filters": {
                      "items": [
                        {
                          "fieldId": "linesTableId",
                          "operator": "contains",
                          "items": [
                            {
                              "fieldId": "quantityFieldId",
                              "operator": "min",
                              "payload": {
                                "min": 2
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "sorts": [
                      {
                        "field": "date",
                        "direction": -1
                      }
                    ]
                  }
                },
                "sortOnly": {
                  "value": {
                    "moduleId": "3818",
                    "listingId": "allLeave",
                    "currentPage": 0,
                    "pageSize": 20,
                    "sorts": [
                      {
                        "field": "state",
                        "direction": 1
                      },
                      {
                        "field": "createdDate",
                        "direction": -1
                      }
                    ]
                  }
                },
                "legacySortMapStyle": {
                  "value": {
                    "moduleId": "3818",
                    "listingId": "allLeave",
                    "currentPage": 0,
                    "pageSize": 20,
                    "sorts": [
                      {
                        "state": 1
                      },
                      {
                        "createdDate": -1
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/activity/form": {
      "post": {
        "tags": [
          "Activity"
        ],
        "summary": "Retrieve activity form definition and initial payload",
        "description": "Returns activity form configuration for create/edit/view/custom activity. `moduleId` and `activityId` are required. `entryId` is required for edit/view-like operations.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FormRequest"
              },
              "examples": {
                "create": {
                  "value": {
                    "moduleId": "3818",
                    "activityId": "create",
                    "listingId": "list1"
                  }
                },
                "edit": {
                  "value": {
                    "moduleId": "3818",
                    "activityId": "edit",
                    "entryId": 12034,
                    "listingId": "list1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityFormResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/activity": {
      "post": {
        "tags": [
          "Activity"
        ],
        "summary": "Perform an activity for an entry",
        "description": "Submits an activity payload. For create, omit `entryId`. For edit/view/custom actions on an existing entry, include `entryId`. MCP-friendly `input` is supported as an alias to `payload`. When using `input`, top-level keys may use `CanvasGuard.Information[].displayName` and will be mapped to canonical `fieldName`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FormSubmission"
              },
              "examples": {
                "create": {
                  "value": {
                    "moduleId": "3818",
                    "activityId": "create",
                    "payload": {
                      "title": "Leave request",
                      "startDate": "2026-02-14",
                      "endDate": "2026-02-15"
                    }
                  }
                },
                "approve": {
                  "value": {
                    "moduleId": "3818",
                    "entryId": 12034,
                    "activityId": "approve",
                    "payload": {
                      "remarks": "Approved"
                    }
                  }
                },
                "createWithInputFriendlyNames": {
                  "value": {
                    "moduleId": "3818",
                    "activityId": "Create",
                    "input": {
                      "Leave Type": "Annual Leave",
                      "Start Date": "2026-02-14",
                      "End Date": "2026-02-15"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/m/discovery": {
      "get": {
        "tags": [
          "ModuleDiscovery"
        ],
        "summary": "List discoverable modules for current workspace context",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModuleDiscoveryItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/m/{moduleId}/discovery": {
      "get": {
        "tags": [
          "ModuleDiscovery"
        ],
        "summary": "Get module/canvas discovery payload",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          },
          {
            "in": "path",
            "name": "moduleId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tier",
            "required": false,
            "description": "Discovery detail level. `basic` returns module + information only. `extended` returns full discovery payload. Both tiers return JSON.",
            "schema": {
              "type": "string",
              "enum": [
                "basic",
                "extended"
              ],
              "default": "basic"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDiscoveryDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/m/list": {
      "post": {
        "tags": [
          "MCP"
        ],
        "summary": "List entries with flat MCP filters",
        "description": "MCP-dedicated listing endpoint. Accepts flat filter properties (state, documentId, createdBy, assignee, search, createdAfter/Before, updatedAfter/Before) and module-specific `filters` object. Internally transforms to FilterProcessor schema via McpFilterTransformer.\n**Standard filters** (flat string properties):\n| Property      | Matches field    | Operator | |---------------|------------------|----------| | state         | state            | is       | | documentId    | documentId       | contains | | createdBy     | createdBy        | contains | | assignee      | assignTo         | contains | | search        | documentId       | contains | | createdAfter  | createdDate      | min      | | createdBefore | createdDate      | max      | | updatedAfter  | lastChangeDate   | min      | | updatedBefore | lastChangeDate   | max      |\n**Module-specific filters** (`filters` object, keyed by display name):\nSimple value = equality (`is`). Object value = operator(s). See `McpFilters` schema for all supported operators.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpListRequest"
              },
              "examples": {
                "basicList": {
                  "summary": "Simple paginated list",
                  "value": {
                    "moduleId": "3818",
                    "pageSize": 20
                  }
                },
                "filteredByState": {
                  "summary": "Filter by state",
                  "value": {
                    "moduleId": "3818",
                    "state": "Approved",
                    "pageSize": 20
                  }
                },
                "dateRange": {
                  "summary": "Entries created in a date range",
                  "value": {
                    "moduleId": "3818",
                    "createdAfter": "2026-01-01",
                    "createdBefore": "2026-01-31",
                    "pageSize": 50
                  }
                },
                "customFilters": {
                  "summary": "Module-specific filters with operators",
                  "value": {
                    "moduleId": "3818",
                    "filters": {
                      "Priority": "High",
                      "Score": {
                        "min": 80,
                        "max": 100
                      },
                      "Due Date": {
                        "after": "2026-03-01",
                        "before": "2026-03-31"
                      },
                      "Status": {
                        "not": "Cancelled"
                      }
                    },
                    "pageSize": 20
                  }
                },
                "nullAndBooleanFilters": {
                  "summary": "Null checks and boolean filters",
                  "value": {
                    "moduleId": "3818",
                    "filters": {
                      "Notes": {
                        "exists": true
                      },
                      "Verified": {
                        "yes": true
                      }
                    },
                    "pageSize": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/m/form": {
      "post": {
        "tags": [
          "MCP"
        ],
        "summary": "Get activity form definition (MCP)",
        "description": "MCP-dedicated form endpoint. Returns form definition and initial payload for a given activity. Equivalent to POST /api/activity/form.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FormRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityFormResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/m": {
      "post": {
        "tags": [
          "MCP"
        ],
        "summary": "Create a new entry (MCP)",
        "description": "MCP-dedicated create endpoint. Uses `input` (keyed by displayName) which is mapped to canonical fieldName via McpModuleInputGuard. Equivalent to POST /api/activity with activityId=\"create\".",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpCreateRequest"
              },
              "examples": {
                "create": {
                  "value": {
                    "moduleId": "3818",
                    "activityId": "Create",
                    "input": {
                      "Leave Type": "Annual Leave",
                      "Start Date": "2026-02-14",
                      "End Date": "2026-02-15"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/m/{entryId}": {
      "put": {
        "tags": [
          "MCP"
        ],
        "summary": "Update an existing entry (MCP)",
        "description": "MCP-dedicated update endpoint. Uses `input` (keyed by displayName) which is mapped to canonical fieldName via McpModuleInputGuard. Equivalent to POST /api/activity with entryId and activityId.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          },
          {
            "in": "path",
            "name": "entryId",
            "required": true,
            "schema": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpUpdateRequest"
              },
              "examples": {
                "update": {
                  "value": {
                    "moduleId": "3818",
                    "activityId": "Edit",
                    "input": {
                      "Leave Type": "Sick Leave",
                      "Remarks": "Updated leave type"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/m/activity": {
      "post": {
        "tags": [
          "MCP"
        ],
        "summary": "Perform an activity on an entry (MCP)",
        "description": "MCP-dedicated activity endpoint. Performs workflow actions (approve, reject, assign, etc.) on existing entries.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FormSubmission"
              },
              "examples": {
                "approve": {
                  "value": {
                    "moduleId": "3818",
                    "entryId": 12034,
                    "activityId": "Approve",
                    "input": {
                      "Remarks": "Approved"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/m/history": {
      "post": {
        "tags": [
          "MCP"
        ],
        "summary": "Get entry activity history (MCP)",
        "description": "Returns the activity/change history for a specific entry.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WsIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "moduleId",
                  "entryId"
                ],
                "properties": {
                  "moduleId": {
                    "type": "string"
                  },
                  "entryId": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "WsIdHeader": {
        "in": "header",
        "name": "wsId",
        "required": false,
        "description": "Workspace ID (required in multi-workspace context)",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ListRequest": {
        "title": "Listing request",
        "type": "object",
        "required": [
          "moduleId"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "description": "Module ID"
          },
          "listingId": {
            "type": "string",
            "description": "Listing ID"
          },
          "withHeader": {
            "type": "boolean",
            "description": "Include header information"
          },
          "currentPage": {
            "type": "integer",
            "minimum": 0,
            "description": "Current page number (starts from 0)"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Page size (0 for all entries)"
          },
          "filters": {
            "$ref": "#/components/schemas/QueryFilters"
          },
          "sorts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuerySort"
            },
            "description": "Optional sort definitions"
          }
        }
      },
      "McpListRequest": {
        "title": "MCP listing request",
        "type": "object",
        "required": [
          "moduleId"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "description": "Module ID"
          },
          "listingId": {
            "type": "string",
            "description": "Listing ID (from discovery.listings[].id)"
          },
          "currentPage": {
            "type": "integer",
            "minimum": 0,
            "description": "Page number (starts from 0)"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Page size (default 20)"
          },
          "state": {
            "type": "string",
            "description": "Filter by state name (exact match)"
          },
          "documentId": {
            "type": "string",
            "description": "Filter by document ID (partial match)"
          },
          "createdBy": {
            "type": "string",
            "description": "Filter by creator (partial match)"
          },
          "assignee": {
            "type": "string",
            "description": "Filter by assignee (partial match)"
          },
          "search": {
            "type": "string",
            "description": "Search by document ID (partial match)"
          },
          "createdAfter": {
            "type": "string",
            "description": "Entries created on or after this date (ISO 8601)"
          },
          "createdBefore": {
            "type": "string",
            "description": "Entries created on or before this date (ISO 8601)"
          },
          "updatedAfter": {
            "type": "string",
            "description": "Entries updated on or after this date (ISO 8601)"
          },
          "updatedBefore": {
            "type": "string",
            "description": "Entries updated on or before this date (ISO 8601)"
          },
          "filters": {
            "$ref": "#/components/schemas/McpFilters"
          }
        }
      },
      "McpFilters": {
        "title": "MCP module-specific filters",
        "type": "object",
        "additionalProperties": true,
        "description": "Module-specific filters keyed by field display name. Each value can be a simple value (equality) or an operator object.\n\n**Simple value** (equality): `\"Priority\": \"High\"` or `\"Score\": 95`\n\n**Operator object** (one or more operators per field):\n\n*Text operators:*\n| Operator    | Description              | Example                     | |-------------|--------------------------|-----------------------------| | contains    | Partial match            | `{ \"contains\": \"val\" }`     | | startsWith  | Starts with              | `{ \"startsWith\": \"val\" }`   | | endsWith    | Ends with                | `{ \"endsWith\": \"val\" }`     | | is          | Exact match              | `{ \"is\": \"val\" }`           | | not         | Not equal                | `{ \"not\": \"val\" }`          | | excludes    | Does not contain         | `{ \"excludes\": \"val\" }`     |\n\n*Number operators:*\n| Operator | Description            | Example                                  | |----------|------------------------|------------------------------------------| | min      | Greater than or equal   | `{ \"min\": 80 }`                          | | above    | Greater than            | `{ \"above\": 80 }`                        | | max      | Less than or equal      | `{ \"max\": 100 }`                         | | below    | Less than               | `{ \"below\": 100 }`                       | | between  | Range (inclusive)        | `{ \"between\": { \"min\": 1, \"max\": 10 } }` |\n\n*Date operators:*\n| Operator | Description          | Example                       | |----------|----------------------|-------------------------------| | after    | On or after date     | `{ \"after\": \"2026-01-01\" }`   | | before   | On or before date    | `{ \"before\": \"2026-12-31\" }`  |\n\n*Null check operators:*\n| Operator | Description          | Example              | |----------|----------------------|----------------------| | empty    | Field is null/empty  | `{ \"empty\": true }`  | | exists   | Field has a value    | `{ \"exists\": true }` |\n\n*Boolean operators:*\n| Operator | Description    | Example            | |----------|----------------|--------------------| | yes      | Field is true  | `{ \"yes\": true }`  | | no       | Field is false | `{ \"no\": true }`   |\n\nAll operator names are case-insensitive. Over 60 aliases are accepted (e.g. `gte` for `min`, `isNot` for `not`, `none` for `empty`, `any` for `exists`). See MCP_FILTERING.md for the full alias list."
      },
      "McpCreateRequest": {
        "title": "MCP create request",
        "type": "object",
        "required": [
          "moduleId",
          "activityId",
          "input"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "description": "Module ID"
          },
          "activityId": {
            "type": "string",
            "description": "Activity ID (e.g. \"Create\")"
          },
          "listingId": {
            "type": "string",
            "description": "Listing context ID"
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "Field values keyed by display name. Mapped to canonical fieldName via McpModuleInputGuard."
          }
        }
      },
      "McpUpdateRequest": {
        "title": "MCP update request",
        "type": "object",
        "required": [
          "moduleId",
          "activityId",
          "input"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "description": "Module ID"
          },
          "activityId": {
            "type": "string",
            "description": "Activity ID (e.g. \"Edit\")"
          },
          "listingId": {
            "type": "string",
            "description": "Listing context ID"
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "Field values keyed by display name. Mapped to canonical fieldName via McpModuleInputGuard."
          }
        }
      },
      "FormRequest": {
        "title": "Activity form request",
        "type": "object",
        "required": [
          "moduleId",
          "activityId"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "description": "Target module ID"
          },
          "activityId": {
            "type": "string",
            "description": "Activity ID (e.g. create, edit, approve)"
          },
          "listingId": {
            "type": "string",
            "description": "Listing context ID"
          },
          "entryId": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Required for edit/view/existing-entry activity"
          },
          "payload": {
            "type": "object",
            "description": "Optional prefill context"
          }
        }
      },
      "FormSubmission": {
        "title": "Activity submission request",
        "type": "object",
        "required": [
          "moduleId",
          "activityId"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "description": "Module ID"
          },
          "entryId": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Entry ID for existing-entry activities"
          },
          "activityId": {
            "type": "string",
            "description": "Activity ID"
          },
          "listingId": {
            "type": "string",
            "description": "Listing context ID"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "Form payload keyed by fieldName. For table fields, pass array of rows. For connected/module fields, pass the ID/object expected by studio schema."
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "MCP-friendly alias of `payload`. Supports top-level keys using `CanvasGuard.Information[].displayName`. If both `payload` and `input` are provided, values must be identical."
          }
        }
      },
      "ActivityFormResponse": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "string"
          },
          "activityId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "design": {
            "type": "object",
            "additionalProperties": true
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "permissions": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WorkspaceListItem": {
        "title": "Workspace item",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Workspace ID"
          },
          "name": {
            "type": "string",
            "description": "Workspace name"
          }
