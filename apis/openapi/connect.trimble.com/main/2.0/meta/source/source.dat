    "/comments": {
      "get": {
        "tags": [
          "Comments"
        ],
        "summary": "List all Comments",
        "description": "List all Comments",
        "operationId": "ListallComments",
        "parameters": [
          {
            "name": "objectId",
            "in": "query",
            "description": "ID of the Object.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "objectType",
            "in": "query",
            "description": "Type of the Object.",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "FILE",
                "FOLDER",
                "VIEW",
                "CLASH",
                "RELEASE",
                "TODO",
                "ISSUE"
              ],
              "example": "FOLDER"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Includes optional data, such as reactionsSummary",
            "required": false,
            "schema": {
              "type": "string",
              "example": "reactionsSummary"
            }
          },
          {
            "name": "contextId",
            "in": "query",
            "description": "The unique identifier of the context in TRN format (trn:2:tc:{us|eu|ap|ap-au}:projects:{projectId}:files:{fileId}). Mandatory for objectType ISSUE.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "trn:2:tc:us:projects:Z5_UyWkNrmA:files:S4UmFiaKDxQ"
            }
          }
        ],
