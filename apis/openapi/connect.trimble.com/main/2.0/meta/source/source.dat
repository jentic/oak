        "properties": {
          "id": {
            "type": "string",
            "description": "Todo Identifier"
          },
          "projectId": {
            "type": "string",
            "description": "Project Identifier"
          },
          "label": {
            "type": "string",
            "description": "label for the Tag (Unique within a project)"
          },
          "description": {
            "type": "string",
            "description": "description for the Tag"
          },
          "color": {
            "type": "string",
            "description": "The color is given in ARGB format. Colors are represented as 6 or 8 hexadecimal digits prefixed with # character. If 8 digits are present, the first two represent the alpha (transparency) channel"
          }
        },
        "example": {
          "id": "Dyfw481f445",
