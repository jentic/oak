            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "batchId",
            "in": "query",
            "description": "Batch id used to group multiple delete's as a single activity.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "sdXH7RAh3Rk"
            }
          }
