    "/folders/{folderId}/delete": {
      "delete": {
        "tags": [
          "Folders"
        ],
        "summary": "Delete Folder",
        "description": "Deletes the folder with the given folder ID.<br><br>- <b>Empty Folder:</b><br>  If the folder is empty, it will be deleted . The API responds with <code>204 No Content</code>.<br>- <b>Non-Empty Folder (force not set or false):</b><br>  If the folder contains items and the optional `force` query parameter is not provided or set to `false`, the deletion is rejected with an error indicating that `force=true` is required to delete non-empty folders.<br>- <b>Non-Empty Folder (force=true):</b><br>  If the folder contains items and `force` is set to `true`, the deletion is processed asynchronously. The API responds with <code>202 Accepted</code> and includes a `Location` header containing the URI to check the deletion job status. Clients can use this URI or the returned job ID to poll for completion status.",
        "operationId": "deleteFolder",
        "parameters": [
          {
            "name": "folderId",
            "in": "path",
            "description": "ID of the folder to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "syncSessionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "batchId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "headers": {
              "Location": {
                "description": "URI to check the status of the folder deletion job.",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
