      "ObjectSyncFetchObjects": {
        "title": "List of objects from the object sync",
        "required": [
          "type",
          "status",
          "objects"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "the object type"
          },
          "status": {
            "type": "number",
            "description": "the new cursor value for subsequent fetches"
          },
          "range": {
            "type": "string",
            "example": "items 0-1/2",
            "description": "if Response is paged information about the current page is returned"
          },
          "objects": {
            "type": "array",
            "description": "the objects changed or created",
            "items": {
              "type": "object",
              "description": "schema corresponds on the object type"
            }
          }
        }
      },
      "GetAvailableRegionsResponse": {
        "title": "GetAvailableRegionsResponse",
        "required": [
          "isMaster",
          "origin",
          "location",
          "serviceRegion",
          "awsRegion",
          "region",
          "map-bbox",
          "tc-api",
          "objects-sync-api",
          "org-api",
          "pset-api",
          "projects-api",
          "wopi-api",
          "batch-api",
          "user-api",
          "model-api",
          "topic-api"
        ],
        "type": "object",
        "properties": {
          "isMaster": {
            "type": "boolean",
            "description": "Indicates if the region is the Master Region"
          },
          "origin": {
            "type": "string",
            "description": "The Origin of the region"
          },
          "location": {
            "type": "string",
            "description": "The Location of the region"
          },
          "serviceRegion": {
            "type": "string",
            "description": "The Service Region Code for the region"
          },
          "awsRegion": {
            "type": "string",
            "description": "The AWS Region code for the region"
          },
          "region": {
            "type": "string",
            "description": "The Region code for the region, maps to the region in TRN (e.g. Issue contextId TRN)",
            "enum": [
              "us",
              "eu",
              "ap",
              "ap-au"
            ]
          },
          "map-bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Lat, long bounding box for the region's map in [west, south, east, north] format."
          },
          "tc-api": {
            "type": "string",
            "description": "The base URL of TC APIs for the region"
          },
          "objects-sync-api": {
            "type": "string",
            "description": "(Connect Internal) The base URL of Objects Sync APIs for the region"
          },
          "org-api": {
            "type": "string",
            "description": "The base URL of Organizer Service APIs for the region"
          },
          "pset-api": {
            "type": "string",
            "description": "The base URL of PSet Service APIs for the region"
          },
          "projects-api": {
            "type": "string",
            "description": "(Connect Internal) The base URL of Projects Service APIs for the region"
          },
          "wopi-api": {
            "type": "string",
            "description": "(Connect Internal) The base URL of WOPI Service APIs for the region"
          },
          "batch-api": {
            "type": "string",
            "description": "(Connect Internal) The base URL of Batch Service APIs for the region"
          },
          "user-api": {
            "type": "string",
            "description": "(Connect Internal) The base URL of User Service APIs for the region"
          },
          "model-api": {
            "type": "string",
            "description": "The base URL of Model Service APIs for the region"
          },
          "topic-api": {
            "type": "string",
            "description": "The base URL of Topics Service APIs for the region"
          }
        },
        "example": [
          {
            "isMaster": true,
            "origin": "//{baseUrl}",
            "location": "northAmerica",
            "serviceRegion": "na",
            "awsRegion": "us-east-1",
            "map-bbox": [
              -114.2871,
              29.5313,
              -80.8298,
              49.9512
            ],
            "tc-api": "https://{tc-baseUrl}",
            "objects-sync-api": "https://{sync-api-baseUrl}",
            "org-api": "https://{org-api-baseUrl}",
            "pset-api": "https://{pset-api-baseUrl}",
            "projects-api": "https://{projects-api-baseUrl}",
            "wopi-api": "https://{wopi-api-baseUrl}",
            "batch-api": "https://{batch-api-baseUrl}",
            "user-api": "https://{user-api-baseUrl}",
            "model-api": "https://{model-api-baseUrl}",
            "topic-api": "https://{topic-api-baseUrl}"
          },
          {
            "isMaster": false,
            "origin": "//{baseUrl}",
            "location": "europe",
            "serviceRegion": "eu",
            "awsRegion": "eu-west-1",
            "map-bbox": [
              -7.0313,
              42.0329,
              27.2461,
              53.4302
            ],
            "tc-api": "https://{tc-baseUrl}",
            "objects-sync-api": "https://{sync-api-baseUrl}",
            "org-api": "https://{org-api-baseUrl}",
            "pset-api": "https://{pset-api-baseUrl}",
            "projects-api": "https://{projects-api-baseUrl}",
            "wopi-api": "https://{wopi-api-baseUrl}",
            "batch-api": "https://{batch-api-baseUrl}",
            "user-api": "https://{user-api-baseUrl}",
            "model-api": "https://{model-api-baseUrl}",
            "topic-api": "https://{topic-api-baseUrl}"
          }
        ]
      },
      "CompanyDetailsResponse": {
        "title": "CompanyDetailsResponse",
        "required": [
          "id",
          "name",
          "website",
          "domains",
          "image",
          "role",
          "createdOn",
          "modifiedOn",
          "createdBy",
          "modifiedBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Company identifier"
          },
          "name": {
            "type": "string",
            "description": "Name of the company"
          },
          "website": {
            "type": "string",
            "description": "Website of the company"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "domains of the company"
          },
          "image": {
            "type": "string",
            "description": "URL to fetch the thumbnail of the Company Logo (if exists)"
          },
          "role": {
            "type": "string",
            "description": "Role of the current user in the company"
          },
          "createdOn": {
            "type": "string",
            "description": "(timestamp)An ISO8601 date when the Company was created"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(timestamp)An ISO8601 date when the Company was last modified"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          }
        },
        "example": {
          "id": "kTjLp5b2VQM",
          "name": "Trimble",
          "website": "www.trimble.com",
          "domains": [
            "trimble.com"
          ],
          "image": "http://{baseUrl}/tc/app/files/thumb?id=Dyfw481f366&fc=COMPANYIMG#?429259527000",
          "role": "ADMIN",
          "createdOn": "2016-02-09T17:49:19-0800",
          "modifiedOn": "2016-02-09T17:49:49-0800",
          "createdBy": {
            "id": "Dyfw481f367",
            "firstName": "John",
            "lastName": "Doe",
            "email": "jdoe@trimble.com",
            "status": "ACTIVE"
          },
          "modifiedBy": {
            "id": "Dyfw481f368",
            "firstName": "John",
            "lastName": "Doe",
            "email": "jdoe@trimble.com",
            "status": "ACTIVE"
          }
        }
      },
      "CreatedBy": {
        "title": "CreatedBy",
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "status"
        ],
        "type": "object",
        "description": "User details of who created this object",
        "properties": {
          "id": {
            "type": "string",
            "description": "User identifier"
          },
          "tiduuid": {
            "type": "string",
            "description": "Trimble ID of the user"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "User status. User's status is PENDING when a new user has been invited to a project and has not access Connect yet. Once the user has accessed Connect, the status becomes ACTIVE. REMOVED is a project specific status that is shown for users that have been removed from a project.",
            "enum": [
              "ACTIVE",
              "PENDING",
              "REMOVED"
            ]
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "companies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Company"
            }
          },
          "companyAdmin": {
            "type": "boolean"
          }
        },
        "example": {
          "id": "LWOf7rirztM",
          "tiduuid": "b75d4e5c-e4c0-4a92-9963-fcc5d36dd6a6",
          "firstName": "John",
          "lastName": "Doe",
          "email": "jdoe@trimble.com",
          "status": "ACTIVE"
        }
      },
      "ModifiedBy": {
        "title": "ModifiedBy",
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "status"
        ],
        "type": "object",
        "description": "User details of who modified this object recently",
        "properties": {
          "id": {
            "type": "string",
            "description": "User identifier"
          },
          "tiduuid": {
            "type": "string",
            "description": "Trimble ID of the user"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "User status. User's status is PENDING when a new user has been invited to a project and has not access Connect yet. Once the user has accessed Connect, the status becomes ACTIVE. REMOVED is a project specific status that is shown for users that have been removed from a project.",
            "enum": [
              "ACTIVE",
              "PENDING",
              "REMOVED"
            ]
          }
        },
        "example": {
          "id": "LWOf7rirztM",
          "tiduuid": "b75d4e5c-e4c0-4a92-9963-fcc5d36dd6a6",
          "firstName": "John",
