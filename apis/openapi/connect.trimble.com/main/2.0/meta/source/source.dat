    "/projects/{projectId}/settings": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "Get Project settings",
        "description": "API to List all the project specific settings.",
        "operationId": "GetProjectsettings1",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "Path parameter. ID of the project",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Query parameter. Valid values are \"sync\", \"notifications\", \"unit\". All project settings will be given if not provided.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "sync"
            }
          },
          {
            "name": "bellbird",
            "in": "query",
            "description": "Query parameter.  Valid values are TRUE, FALSE. TRUE will give all the settings including bellbird settings. FALSE will just give the current settings without the new bellbird settings.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProjectsettingsresponse"
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "patch": {
        "tags": [
          "Projects"
        ],
        "summary": "Update Project Settings of loggedIn User",
        "description": "This API will set all settings related to project. Generally sets sync,notifications,unit settings. \"ALLOW_AUTO_CHECKOUT\" is the default value in case if sync mode is not given in sync settings.\n\n**Unit Settings :**  \nAPI allows to reset all the values to metric/imperial if unitsystem is the only attribute in the api request. Mix and match values will update the unitsystem to custom.\n\neg: \"unitSettings\": {\n        \"unitsystem\": \"metric\u201d  \n      }\n\nAcceptable values for unitsettings (all defaults are in bold):  \n  unitsystem - (**metric**, imperial, custom)   \n  lengthunit - (for metric - **mm**, cm, m, km)(for imperial - **in**, ft, yd, mi, ft-in, usft)    \n  lengthunitformat - (0, 0.1,  **0.01** , 0.001) when lengthunit in (in, ft, yd, mi,  **mm** , cm, m, km)   else (1/2, **1/4** , 1/8, 1/16, 1/32, 1/64) when lengthunit in (**ft-in**)      \n  lengthmeasurementunit - (for metric - **mm** , cm, m, km)(for imperial -  **in** , ft, yd, mi, ft-in)      \n  lengthmeasurementunitformat - (0, 0.1, **0.01** , 0.001) when lengthmeasurementunit in (**in** , ft, yd, mi, mm, cm, m, km) else (1/2, **1/4** , 1/8, 1/16, 1/32, 1/64) when lengthmeasurementunit in (**ft-in**)      \n  areaunit - (metric - mm2, cm2, **m2**, ha)(imperial - in2, **ft2**, yd2, mi2, usft2, ac, usyd)    \n  areaunitformat - (0, 0.1, **0.01**, 0.001)  \n  volumeunit - (metric - mm3, cm3, **m3**)(imperial - in3, ft3, **yd3**, usft3, usyd3, acft, usacft)     \n  volumeunitformat - (0, 0.1, **0.01**, 0.001)  \n  weightunit - (metric - mg, g, kg, **t**)(imperial - oz, **lb**, ton, stone)    \n  weightunitformat - (0, 0.1, **0.01**, 0.001)  \n  angularunit - (metric - **rad**, deg-min-sec)(imperial - **deg**, deg-min-sec)    \n  angularunitformat - (0, 0.1, **0.01**, 0.001)  \n  heightunit - (metric - m)(imperial - ft, **usft**)   \n  heightunitformat: (0, 0.1, **0.01**, 0.001)  \n  planeangleunit: (metric/imperial - deg, **deg-min-sec**)(custom - Mils, Gons)  \n  planeangleunitformat: (0, 0.1, **0.01**, 0.001, 0.0001, 0.00001, 0.000001)  \n  slopeangleunit: (custom/metric/imperial - **ratio rise over run**, ratio run over rise, angle, percent)  \n  slopeangleunitformat: (0, 0.1, **0.01**, 0.001)  \n  latlonunit: (custom - deg, **deg-min-sec**, mil, gon)  \n  latlonunitformat: (0, 0.1, **0.01**, 0.001, 0.0001, 0.00001, 0.000001)  \n  pressureunit: (metric - **mbar**, mmHg) (imperial - inHg)  \n  pressureunitformat: (0, 0.1, **0.01**, 0.001)    \n  speedunit: (metric - m/s, **km/s**)(imperial - **mi/hr**, ft/s, kn)  \n  speedunitformat: (0, 0.1, **0.01**, 0.001)  \n  temparatureunit: (metric - C)(imperial - F)  \n  temparatureunitformat: (0, 0.1, **0.01**, 0.001)  \n  azimuthdisplay: (custom/metric/imperial - deg, **deg-min-sec**)  \n  azimuthdisplayunitformat -: (0, 0.1, **0.01**, 0.001, 0.0001, 0.00001, 0.000001)",
        "operationId": "UpdateProjectSettingsofloggedInUser",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "ID of the project.",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetProjectsettingsresponse"
              },
              "example": {
                "syncSettings": {
                  "syncMode": "ALLOW_AUTO_CHECKOUT",
                  "filters": [
                    {
                      "id": "Dyfw481fE9U",
                      "description": "AutoCAD lock files (DWL)",
                      "checked": true
                    },
                    {
                      "id": "pNCBBwArq-g",
                      "description": "AutoCAD lock files (DWL2)",
                      "checked": true
                    },
                    {
                      "id": "cu2mUJnneTc",
                      "description": "Rhino lock files (RHL)",
                      "checked": true
                    },
                    {
                      "id": "eX9gwJqSe8I",
                      "description": "Rhino, etc. backup files (BAK)",
                      "checked": true
                    },
                    {
                      "id": "R5yGCjROSRE",
                      "description": "Revit backup directory",
                      "checked": true
                    },
                    {
                      "id": "3UUWLWca4SQ",
                      "description": "Revit temp directory",
                      "checked": true
                    },
                    {
                      "id": "q2I7dwDWrnM",
                      "description": "Revit backup file",
                      "checked": true
                    },
                    {
                      "id": "0CGhTWXE3A4",
                      "description": "Windows shortcut",
                      "checked": true
                    },
                    {
                      "id": "nj7Glv-AqV0",
                      "description": "Log Files",
                      "checked": true
                    },
                    {
                      "id": "M-dWujJNQXA",
                      "description": "AutoCAD lisp file",
                      "checked": true
                    },
                    {
                      "id": "AgR8A8wJDr8",
                      "description": "Sketchup backup file",
                      "checked": true
                    },
                    {
                      "id": "CJY2c8y0EUo",
                      "description": "Error file",
                      "checked": true
                    },
                    {
                      "id": "1rNbvWZv3pk",
                      "description": "Rhino backup file",
                      "checked": true
                    },
                    {
                      "id": "bFvr4Jk8dqw",
