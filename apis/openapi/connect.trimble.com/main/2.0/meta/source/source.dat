      "Target": {
        "title": "object associated to source.",
        "required": [
          "type",
          "id"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "the type of associated object. It could be FILE, URL, TOPIC, TODO or ISSUE. Type is mandatory."
          },
          "name": {
            "type": "string",
            "description": "target name."
          },
          "id": {
            "type": "string",
            "description": "id of target, required unless the type of target intended to be created is an embedded file, indicated by embedded=true flag."
          },
          "versionId": {
            "type": "string",
            "description": "associated object version identifier."
          },
          "embedded": {
            "type": "boolean",
            "description": "(required if target id is null) - this field allows to create an objectlink with an embedded FILE as target without target id."
          },
          "contextId": {
            "type": "string",
            "description": "The unique identifier of the context in TRN format. Required for ISSUE targets."
          }
        },
        "example": {
          "type": "URL",
          "id": "https://connect.trimble.com/2"
        }
      },
      "CreateObjectLinkRequest": {
        "title": "CreateObjectLinkRequest",
        "required": [
          "source",
          "target"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceRequest"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          }
        },
        "example": {
          "source": {
            "versionId": "PdtcatZR279",
            "data": [
              {
                "type": "BIMOBJECT",
                "sourceId": "0mIQCEgIDCAf2Ue8DWdALk"
              },
              {
                "type": "BIMOBJECT",
                "sourceId": "1IBjXv001Ehp4pDpWuC38t"
              }
            ]
          },
          "target": {
            "type": "URL",
            "id": "https://www.trimble.com"
          }
        }
      },
      "SourceResponse": {
        "title": "Source model information",
        "description": "the source object. Source is mandatory in a Request but would be omitted in Response if detail parameter (default = false) is set to false.",
        "required": [
          "id",
          "versionId",
          "data"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier the source object is referencing."
          },
          "versionId": {
            "type": "string",
            "description": "The version the source object is referencing."
          },
          "type": {
            "type": "string",
            "description": "The source object type. Currently only FILE type is supported."
          },
          "data": {
            "type": "array",
            "description": "An array of supplemental data, usually objects in a 3D model.",
            "items": {
              "$ref": "#/components/schemas/SourceDataResponse"
            }
          }
        },
        "example": {
          "id": "PdtcatZR280",
          "versionId": "PdtcatZR281",
          "data": [
            {
              "type": "BIMOBJECT",
              "objectId": "woC32em2Fb0",
              "sourceId": "0mIQCEgIDCAf2Ue8DWdALk"
            },
            {
              "type": "BIMOBJECT",
              "objectId": "woC32em2Fb0",
              "sourceId": "1IBjXv001Ehp4pDpWuC38t"
            }
          ]
        }
      },
      "SourceDataResponse": {
        "title": "Source object information",
        "required": [
          "type",
          "objectId",
          "sourceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "the type of supplemental data. Currently only 'BIMOBJECT' is supported."
          },
          "sourceId": {
            "type": "string",
            "description": "object source identifier. It is mandatory to have sourceId in data object."
          },
          "objectId": {
            "type": "string",
            "description": "Object identitfier.",
            "deprecated": true
          },
          "xrefId": {
            "type": "string",
            "description": "external link identifier."
          }
        },
        "example": {
          "type": "BIMOBJECT",
          "objectId": "woC32em2Fb0",
          "sourceId": "0mIQCEgIDCAf2Ue8DWdALk"
        }
      },
      "SourceRequest": {
        "title": "Source model information",
        "description": "the source object. Source is mandatory in a Request but would be omitted in Response if detail parameter (default = false) is set to false.",
        "required": [
          "versionId",
          "data"
        ],
        "type": "object",
        "properties": {
          "versionId": {
            "type": "string",
            "description": "The version the source object is referencing."
          },
          "data": {
            "type": "array",
            "description": "An array of supplemental data, usually objects in a 3D model.",
            "items": {
              "$ref": "#/components/schemas/SourceDataRequest"
            }
          }
        },
        "example": {
          "versionId": "PdtcatZR282",
          "data": [
            {
              "type": "BIMOBJECT",
              "sourceId": "0mIQCEgIDCAf2Ue8DWdALk"
            },
            {
              "type": "BIMOBJECT",
              "sourceId": "1IBjXv001Ehp4pDpWuC38t"
            }
          ]
        }
      },
      "SourceDataRequest": {
        "title": "Source object information",
        "required": [
          "type",
          "sourceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "the type of supplemental data. Currently only 'BIMOBJECT' is supported."
          },
          "sourceId": {
            "type": "string",
            "description": "object source identifier. It is mandatory to have sourceId in data object."
          }
        },
        "example": {
          "type": "BIMOBJECT",
          "sourceId": "0mIQCEgIDCAf2Ue8DWdALk"
        }
      },
      "ObjectLinkResponse": {
        "title": "ObjectLinkResponse",
        "required": [
          "id",
          "createdOn",
          "createdBy",
          "modifiedOn",
          "modifiedBy",
          "source",
          "target"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The Object link identifier."
          },
          "createdOn": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 date when the link was created"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 date when the link was modified"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          },
          "name": {
            "type": "string",
            "description": "name of link."
          },
