      "SetProcessingStatusrequest": {
        "title": "SetProcessingStatusrequest",
        "required": [
          "id",
          "status",
          "format"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "versionId of the file"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Integer to indicate progress of the file. Value of zero represents PENDING state, value between 1 and 100 is PROCESSING state, value of 100 is READY state and a negative value indicates ERROR"
          },
          "format": {
            "type": "string",
            "description": "The format of processing that the status applies to. Supported values are [\u2018BSQ\u2019,\u2018F3D\u2019,\u2018PDF\u2019, \u2018CLASH\u2019, \u2018THUMBNAIL\u2019,\u2018POINT_CLOUD\u2019]"
          },
          "details": {
            "$ref": "#/components/schemas/FileStatusDetails"
          }
        },
        "example": {
          "id": "abXb05sqF4Y",
          "status": 100,
          "format": "CLASH",
          "details": {
            "errorCode": "PARTIALLY_PROCESSED",
            "message": "Too many clashes"
          }
        }
      },
      "FileStatusDetails": {
        "title": "FileStatusDetails",
        "required": [
          "errorCode",
          "message"
        ],
        "type": "object",
        "description": "additional details such as error or progress information for clash processing.",
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "example": {
          "errorCode": "PARTIALLY_PROCESSED",
          "message": "Too many clashes"
        }
      },
