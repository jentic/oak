                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/files/fs/initiate": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Initiate File upload",
        "description": "**This API functionality is now supported by Package File Upload API**<br></br>These API support file uploads via presigned URL. 3 Steps include initiate upload, stream content and commit the upload process.Upload the content with the presigned url obtained from the Response of this API. Use PUT on the url from the Response to upload file content(no other parameters/headers required)<br/><br/> Multipart uploads require numberofparts and size as mandatory and it will result in list of upload URLs along with the part number. Each part in a multipart upload must be between 5 MiB (5,242,880 bytes) and 5 GiB (5,368,709,120 bytes). The last part can be smaller than 5 MiB (5,242,880 bytes). In general, part sizes should be as large as possible. Each part should be upload to corresponding part upload urls. <br/><br/> Multifile feature used to manage a collection of file objects as a single file resource is supported<br/> <br/>   The API also supports **If-Match** optional header to provide the versionId, so you can verify you are working on the latest version.<br/>  <br/>  If versionId provided in the **If-Match** header is not latest, error Response with Response code **412** will be send back to the caller with **Errorcode** INVALID_HEADER &        **Error Message**: If-Match header value is not latest versionId.<br/> <br/>    If the **If-Match** header value is *  or header not provided, actions will be performed on the latest version.",
        "operationId": "initiateFileUpload",
        "parameters": [
          {
            "name": "fileId",
            "in": "query",
            "description": "If format mentioned, corresponding representation file's fileId required",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "fileId"
          },
          {
            "name": "versionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Parameter to classify this api as representation file upload or original file upload. if it has value, it will be treated as representation file upload or else it will be treated as original file upload.",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            },
            "example": "TRB"
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "If this header is passed with value `*` in the request the upload will fail if there is already file with same name exists in the same folder",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateFileUploadRequest"
              },
              "example": {
                "parentId": "DzX0iFRoo8M",
                "parentType": "FOLDER",
                "name": "Globe.ifc"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "uploadId": "1c6fe4c0-961e-4d64-b92c-3c956524f367",
                  "uploadURL": "https://do-wo.stage.dataocean.trimblecloud.com/s/a9abb0aa-4a72-4ee4-b446-7b8490ff12d1.1?Policy=eyJTdGF0ZW1lbnQiOlt7IlJlc291cmNlIjoiaHR0cHM6Ly9kby13by1ldTEuc3RhZ2UuZGF0YW9jZWFuLnRyaW1ibGVjbG91ZC5jb20vcy9hOWFiYjBhYS00YTcyLTRlZTQtYjQ0Ni03Yjg0OTBmZjEyZDEuMSIsIkNvbmRpdGlvbiI6eyJEYXRlTGVzc1RoYW4iOnsiQVdTOkVwb2NoVGltZSI6MTYzNDg2MDkwMH19fV19&Signature=bU~tmvrj8nYMIINy7i-cRMpE5Sz-HVfHyE21hAnyQX2s9XVVfd79YGFqUNCoN7xwH4MQRpkdxpeQc04Pn3wwC-guuzwn1-I8ODJuvnEXpmAAgJ6H1252Bb8-pFZvXVJFIHUcRVUA~olraBgFmszeigW~OVElvZcTWCmRcuf9BmokN3bRioMqq-vn9HRjc5x6zE57s7q-K6L9eX8J9~CI6HPHb-vDJh4P21PvtJUZFmm2A6sG96eTN5d3kOisy09mhVhNwWzZ-QVJkpQc5D2Z6aWFD-3-dE4wPh-n9UF~4jgOG9x3X2kOcRuw4tjJzh5S2rzG3WRIUHvQ1kj~of~GhQ__&Key-Pair-Id=APKAJJH2YHAR4EAJ5QPQ"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/files/fs/snapshot": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Get the latest files and folders structure",
        "description": "This API retrieves the latest state of files and folders in a project.",
        "operationId": "getActiveFileFolderSnapshot",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "Project ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeDeleted",
            "in": "query",
            "description": "If specified and true, also files and folders marked as deleted returned in the response",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "includeAttachment",
            "in": "query",
            "description": "If specified and true, also file attachments returned in the response",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "skipToken",
            "in": "query",
            "description": "Optimized cursor to fetch items. **`skipToken`** represents a position in the queried collection. <br/>If not provided, a first page of results is returned. ",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxItems",
            "in": "query",
            "description": "Maximum amount of items to return in the response. <br/>It is not guaranteed that exact number of items will be returned, but up to the provided value as max. <br/>The maximum value for this parameter is **`100000`** and the default value will be same as the maximum value. <br/> If requested maxItems exceeds the limit (**100000**), then request will be failed with an error message. <br/>Note that max items limit might be increased in the future, clients should not make any assumptions on the number of items returned by default.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 100000
            }
          },
          {
            "name": "objectTypes",
            "in": "query",
            "description": "Comma-separated types to filter by. <br/>Current supported values are FILE/FOLDER. <br/>Default value is FILE,FOLDER",
            "required": false,
            "schema": {
              "type": "string",
              "default": "FILE,FOLDER"
            },
            "example": "FILE,FOLDER"
          },
          {
            "name": "objectNames",
            "in": "query",
            "description": "Comma-separated names to filter by. <br/>This is a regex-based filter, so names containing the given name as part of their name will also be listed  <br/>Special characters should be URL-encoded (e.g., use %20 for spaces, %7B for '{', %7D for '}'). <br/>Example: sample1, sample2, sample3 objects will be listed if you request name by filter as sample. <br/>The maximum number of names is limited to **`15`**. <br/>If the requested maxItems exceeds this limit (**15**), the request will fail with an error message.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "file1,file2,folder1,folder2,.jpg,.ifc,.skp"
          },
          {
            "name": "id",
            "in": "query",
            "description": "This param might contain either user id or group id. Used for filtering response based on give id.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeRoot",
            "in": "query",
            "description": "When admin user passes this param, root folder of the project will be returned.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "includeActions",
            "in": "query",
            "description": "Specifies whether actions should be included in the response. If specified and true the corresponding actions will be returned; otherwise, they will be excluded.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileFolderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/files/fs/upload": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Get File Upload Details",
        "description": "File upload details contains file name, parent information and uploadUrl. This api also provides the file upload status.",
        "operationId": "getFileUploadDetails",
        "parameters": [
          {
            "name": "uploadId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "wait",
            "in": "query",
            "description": "If true, then server performs long polling for upload to complete. Supported only for uploads via PackageUploadAPI. If upload is not completed even after a specific threshold (f.e.x 1 min), API will return data with current status. Clients should not depend on the threshold in server side as this can be changed anytime",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Package File upload",
        "description": "This API is used to initiate the file upload. The file stream should be uploaded to the upload URL received in the response with the PUT operation and no additional headers including Authorization to be sent. You can use Get File Upload Details API to check the upload status after initiating the upload.</br> </br>This API can be used to upload files and their representation formats (like  thumbnail, TRB, PDF) as a single package. The API supports multipart and multifile uploads. Multipart upload requires the multipart flag to be passed as true in FileUploadContentDto and size of the file is mandatory to be passed for multipart upload. You should replace the * in the pre-signed url received in response with the part number while uploading the parts. If the file content size is greater than 5GB,it should be uploaded as multipart. Multipart file upload is supported only for source file. You should call the upload complete API after uploading all the parts.<br></br>Multi File/ fileset (upload a set of files in an archived format) is supported by passing the fileset and path template in FileUploadContentDto. Multipart upload is supported for filesets (multifiles).<br></br>Some combinations of file types in package upload may not be supported based on the model file format. Currently Source + TRB and Source + TRB + THUMB are not supported for drawing file formats (such as DWG / DXF).<br></br> Please make sure to upload the object only once to each uploadUrl (retries can be done in case of network related failures). If several successful uploads are executed to the the same uploadUrl, the random content from one of the uploads will be picked up for the permanent storage.</br></br> **Please note that the upload will be marked as EXPIRED if file content is not uploaded within 90 minutes for the single part upload and within 30 minutes for the mutlipart upload(after the complete API is called)**",
        "operationId": "initiateFilePackageUpload",
        "parameters": [
          {
            "name": "parentId",
            "in": "query",
            "description": "Parent identifier to which the file has to be uploaded",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "lDiDhrJ7djk"
          },
          {
            "name": "parentType",
            "in": "query",
            "description": "Parent type identifier Supported values are FOLDER|TODO|COMMENT|OBJECTLINK",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "FOLDER"
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tc-enable-process",
            "in": "header",
            "description": "if this value is false, it will ignore processing for this particular file and default value is : true",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "syncSessionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "batchId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "If this header is passed with value `*` in the request the upload will fail if there is already file with same name exists in the same folder",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadDto"
              },
              "examples": {
                "SourceFileUpload": {
                  "description": "SourceFileUpload",
                  "value": {
                    "name": "sourceFile.skp"
                  }
                },
                "PackageFileUpload": {
                  "description": "Package file upload is done by specifying the contents in the request that has information about the additional formats",
                  "value": {
                    "name": "sourceFile.ifc",
                    "contents": [
                      {
                        "format": "THUMBNAIL"
                      },
                      {
                        "format": "TRB"
                      }
                    ]
                  }
                },
                "MultiPart": {
                  "description": "MultiPart",
                  "value": {
                    "name": "MultiPartUpload.skp",
                    "contents": [
                      {
                        "multipart": true,
                        "size": 900000
                      }
                    ]
                  }
                },
                "MultiFile": {
                  "description": "MultiFile",
                  "value": {
                    "name": "MultiFile.zip",
                    "contents": [
                      {
                        "fileset": true
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "ACCEPTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
