            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "versionId": {
            "type": "string",
            "description": "Specific versionID of the input file"
          },
          "projectId": {
            "type": "string"
          },
          "fileId": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string"
          },
          "rotation": {
            "type": "string",
            "description": "This property refers the rotation angle of the 2dview, while creating / updating the view. The possible rotation values are 0, 90, 180, 270 degress. The default rotation value is 0"
          },
          "zoomLevel": {
            "type": "string",
            "description": "This property refers the zoom level of the 2dview, while creating / updating the view. The zoomLevel value is a float value. The default zoomLevel value is 100"
          },
          "pageNumber": {
            "type": "string",
            "description": "Refers current page number while creatig the 2dview. The pageNumber is an integer value. The default value for pageNumber is 1"
          },
          "assignees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssigneeResponse"
            },
            "description": ""
          },
          "markup": {
