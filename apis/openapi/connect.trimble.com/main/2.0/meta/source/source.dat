      "FolderDetailsResponse": {
        "title": "FolderDetailsResponse",
        "required": [
          "id",
          "name",
          "type",
          "versionId",
          "parentId",
          "parentType",
          "permission",
          "createdBy",
          "createdOn",
          "modifiedOn",
          "modifiedBy",
          "size",
          "projectId",
          "hasChildren",
          "path",
          "tags"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Folder Identifier (same across revisions)"
          },
          "name": {
            "type": "string",
            "description": "Name of the Folder"
          },
          "type": {
            "type": "string",
            "description": "FOLDER"
          },
          "versionId": {
            "type": "string",
            "description": "Version Id of the Folder"
          },
          "parentId": {
            "type": "string",
            "description": "Identifier of the parent Folder. If not present, represents the root folder for the project"
          },
          "parentType": {
            "type": "string",
            "description": "FOLDER"
          },
          "permission": {
            "type": "string",
            "enum": [
              "READ",
              "FULL_ACCESS"
            ],
            "description": "Permission"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "createdOn": {
            "type": "string",
            "description": "(timestamp) An ISO8601 date when the Folder was created"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(timestamp) An ISO8601 date when the Folder was modified"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "size of Folder (in bytes)"
          },
          "projectId": {
            "type": "string",
            "description": "Project Identifier"
          },
          "hasChildren": {
            "type": "boolean",
            "description": "Flag to determine if the folder has sub-folders"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Path"
            },
            "description": ""
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tags"
            },
            "description": "Tags specific to this folder"
          }
        },
        "example": {
          "id": "woC32em2Fb0",
          "name": "Drawings",
          "type": "FOLDER",
          "versionId": "woC32em2Fb0",
          "parentId": "iSbX9QodMq4",
          "parentType": "FOLDER",
          "permission": "FULL_ACCESS",
          "createdBy": {
            "id": "Dyfw481f390",
            "firstName": "John",
            "lastName": "Doe",
            "email": "johndoe@trimble.com",
            "status": "ACTIVE"
          },
          "createdOn": "2015-01-21T16:06:09-0800",
          "modifiedOn": "2015-01-21T16:06:09-0800",
          "modifiedBy": {
            "id": "Dyfw481f391",
            "firstName": "John",
            "lastName": "Doe",
            "email": "johndoe@trimble.com",
