                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Folders"
        ],
        "summary": "Update Folder Permissions",
        "description": "This API is used to add new permissions or update/remove existing permissions for a particular folder given as input.<br>If any permissions exist for any users/group, they are removed (reset) and permissions provided in the request body are applied.<br>Input can be either defaultAccess (deprecated) or an ACL comprising lists of users and groups, with permissions set to either READ or FULL_ACCESS or NO_ACCESS.<br>If the project level setting 'fullAccessIncludesPermissions' is enabled, project users with non admin rights will be able to share folders.<br>Additionally, if the project level setting 'allowNonMemberPermissions' is enabled, folders can be shared outside project context.<br>To represent the virtual 'All Members' group, use 'tc-groups:*' in the ACL.",
        "operationId": "patchFolderPermissions",
        "parameters": [
          {
            "name": "folderId",
            "in": "path",
            "description": "ID of the folder for which permission is updated",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "xksFFEd23"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderPermissionsDto"
              },
              "example": {
                "defaultAccess": "FULL_ACCESS",
                "acl": {
                  "READ": [
                    "users:f29a28a8-c4b5-483e-b7b9-071db660abb6"
                  ],
                  "FULL_ACCESS": [
                    "tc-groups:woC32em2Fb0",
                    "tc-groups:*"
                  ],
                  "NO_ACCESS": [
                    "tc-groups:xbnf23yut"
                  ]
                },
                "inheritance": true
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderPermissionsDto"
                },
                "example": {
                  "defaultAccess": "FULL_ACCESS",
                  "acl": {
                    "READ": [
                      "users:f29a28a8-c4b5-483e-b7b9-071db660abb6"
                    ],
                    "FULL_ACCESS": [
                      "tc-groups:woC32em2Fb0",
                      "tc-groups:*"
                    ],
                    "NO_ACCESS": [
                      "tc-groups:xbnf23yut"
                    ]
                  },
                  "inheritance": true
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
