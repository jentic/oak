    "/objectlink/target": {
      "get": {
        "tags": [
          "Object Link to Entity"
        ],
        "summary": "List links for the given target entity",
        "description": "This API returns the set of object links for a given target. For versioned target, either id or versionId must be provided. For ISSUE target, contextId is required.",
        "operationId": "Listlinksforthegiventargetentity",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "project id.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "4MUJs5SXO64"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "target type.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "FILE"
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "target id identifier.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "FlPghBwyP-c"
            }
          },
          {
            "name": "contextId",
            "in": "query",
            "description": "context Id (required for ISSUE target).",
            "schema": {
              "type": "string",
              "example": "trn:2:tc:us:projects:isOldRrinmE"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "target versionId, applicable to versioned target.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "QaUAyoHLcA0"
            }
          },
          {
            "name": "modifiedAfter",
            "in": "query",
            "description": "filter: only links modified after the given time are returned.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2017-01-20T13:51:37-0700"
            }
          },
          {
            "name": "includeDeleted",
            "in": "query",
            "description": "include deleted links.",
            "required": true,
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ObjectLinkResponse"
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
