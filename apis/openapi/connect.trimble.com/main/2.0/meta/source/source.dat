    "/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "List All Search Results",
        "description": "List All Search Results",
        "operationId": "ListAllSearchResults",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "query string to search",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "description": "comma seperated IDs of the Project",
            "schema": {
              "type": "string",
              "example": "lj3cOiJFBGg, lj4cOiJFBGt"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "object type/s to filter seperated by comma",
            "schema": {
              "type": "string",
              "example": "PROJECT, FOLDER, FILE, TODO, RELEASE, VIEW, CLASH"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "starting date to filter",
            "schema": {
              "type": "string",
              "example": "2015-05-21T23:20:39-0000"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "ending date to filter",
            "schema": {
              "type": "string",
              "example": "2015-05-21T23:20:39-0000"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "sort order. Options are [\"name\", \"modified\", \"created\", \"type\"]. Prefix with \"+\" for ascending and \"-\" for descending sort order",
            "schema": {
              "type": "string",
              "example": "-name"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "",
            "schema": {
              "type": "string",
              "example": "items=0-20 (If not specified, returns first 25 results by default)"
