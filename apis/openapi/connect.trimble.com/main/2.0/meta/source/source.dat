            "type": "number",
            "description": "z coordinate of section box  position (mm)"
          },
          "sizeX": {
            "type": "number",
            "description": "section box size in x direction (mm)"
          },
          "sizeY": {
            "type": "number",
            "description": "section box size in y direction (mm)"
          },
          "sizeZ": {
            "type": "number",
            "description": "section box size in z direction (mm)"
