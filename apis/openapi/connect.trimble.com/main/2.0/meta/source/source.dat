    "/views2d": {
      "get": {
        "tags": [
          "2D Views"
        ],
        "summary": "List all 2D Views",
        "description": "API to list 2D Views in a project based on either project Id or file Id using which views are created.",
        "operationId": "Listall2DViews",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "ID of the project. This is mandatory if fileId is not provided.",
            "schema": {
              "type": "string",
              "example": "oLZYUISHJ9c"
            }
          },
          {
            "name": "fileId",
            "in": "query",
            "description": "ID of the file linked to the view. This is optional if projectId is provided, else required if versionId is specified. If fileId alone is passed, latest version of file is considered for listing views.",
            "schema": {
              "type": "string",
              "example": "syiOnI8pFig"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "ID of specific version of the file. Optional only if fileId is passed.",
            "schema": {
              "type": "string",
              "example": "EFyJmVsGeP8"
            }
          },
          {
            "name": "detail",
            "in": "query",
            "description": "If detail parameter value passed as true, the Response payload will contains detailed information including rotation, zoomLevel, pageNumber, markup properties like xfdfData, markupId. The default value of detail parameter is false. By default, the markup properties like xfdfData, markupId excluded from the Response payload.",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/2DViewDetailsResponse"
                  },
                  "description": ""
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "2D Views"
        ],
        "summary": "Create a New 2D View",
        "description": "API to create a new 2D View. Thumbnail data can be attached as base64 encoded format in the Request.",
