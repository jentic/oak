      "ProjectCloneRequest": {
        "title": "Project Clone Request",
        "type": "object",
        "required": [
          "sourceProjectId",
          "include"
        ],
        "properties": {
          "sourceProjectId": {
            "type": "string",
            "description": "ID of the source project",
            "example": "q-XKNAhg3Rk"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minItems": 1,
              "enum": [
                "folders",
                "folderPermissions",
                "users",
                "groups",
                "settings",
                "*"
              ]
            },
            "description": "When '*' is selected, the clone operation will encompass all project data, including folders, users, groups, settings, and folder permissions.\n\n`folderPermissions` needs to be selected along with `folders` and this ensures that the clone operation includes both folders and their associated permissions. This selection captures the folder structure along with the default permissions set for each folder. If `users` and `groups` are included in the clone, their permissions on folder level will also be replicated accordingly.\n\nFor a comprehensive understanding of how different values in 'include' control the clone behavior, please refer to the Project Clone API description..",
            "example": [
              "folders",
              "users",
              "groups",
              "settings",
              "folderPermissions",
              "*"
            ]
          },
          "targetProjectDetails": {
            "$ref": "#/components/schemas/TargetProjectDetails"
          }
        },
        "example": {
          "sourceProjectId": "q-XKNAhg3Rk",
          "include": [
            "folders",
            "users",
            "groups",
            "settings",
            "folderPermissions",
            "*"
          ],
          "targetProjectDetails": {
            "name": "Cloned Project",
            "description": "Renovation - East side",
            "startDate": "2015-02-16T00:00:00+0000",
            "endDate": "2017-12-07T00:00:00+0000",
            "licenseId": "0206cbd0-7ce3-4a8c-812d-e23d25ff8f9a",
            "address": {
              "text": "Denver, CO",
              "geometry": "[[-38.50245621, 176.0944492], [-45.50245621, 120.0944492], [-20.50245621, 100.0944492]]"
            },
            "crs": {
              "name": "EPSG:5945",
              "csib64": "VE5MIENTSUI...T0xMDk2O30A"
            }
          }
        }
      },
