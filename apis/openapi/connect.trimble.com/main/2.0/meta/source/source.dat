      "Markup": {
        "title": "Markup",
        "required": [
          "type",
          "positionX",
          "positionY",
          "positionZ"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "cloud",
              "text",
              "line",
              "arrow",
              "redlines",
              "measure",
              "measure_with_pick",
              "angle",
              "measure_slope"
            ],
            "description": "the type of markup"
          },
          "markupId": {
            "type": "string",
            "description": "markup identifier"
          },
          "positionX": {
            "type": "number",
            "description": "first x coordinate (mm), omitted for type = redlines or measure_with_pick or angle two pick case"
          },
          "positionY": {
            "type": "number",
            "description": "first y coordinate (mm), omitted for type = redlines or measure_with_pick or angle two pick case"
          },
          "positionZ": {
            "type": "number",
            "description": "first z coordinate (mm), omitted for type = redlines or measure_with_pick or angle two pick case"
          },
          "projectId": {
            "type": "string",
            "description": "project identifier"
          },
          "mashupId": {
            "type": "string",
            "description": "mashup identifier"
          },
          "referenceObject": {
            "type": "string",
            "description": "picking reference"
          },
          "color": {
            "$ref": "#/components/schemas/Color"
          },
          "type(if type=cloud)": {
            "$ref": "#/components/schemas/MarkUpCloudType"
          },
          "type(if type=text)": {
            "$ref": "#/components/schemas/MarkUpTextType"
          },
          "type(if type=line)": {
            "$ref": "#/components/schemas/MarkUpLineType"
          },
          "type(if type=arrow)": {
            "$ref": "#/components/schemas/MarkUpArrowType"
          },
          "type(if type=redlines)": {
            "$ref": "#/components/schemas/MarkUpRedLineType"
          },
          "type(if type=measure)": {
            "$ref": "#/components/schemas/MarkUpMeasureType"
          },
          "type(if type=measure_with_pick)": {
            "$ref": "#/components/schemas/MarkUpMeasureWithPickType"
          },
          "type(if type=angle)": {
            "$ref": "#/components/schemas/MarkUpAngleType"
          },
          "type(if type=measure_slope)": {
            "$ref": "#/components/schemas/MarkUpMeasureSlopeType"
