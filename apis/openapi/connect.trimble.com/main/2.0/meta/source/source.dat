      "MarkUpAngleType": {
        "title": "MarkUpAngleType",
        "description": "Angle markup type would cover the following two cases _two pick_ and _three pick_. On _two pick_ case start and end fields can be considered as first pick and second pick respectively with its schema type followed, and fields like positionX, positionY, positionZ of the markup can be omitted. On _three pick_ case in addition to start and end field, fields like positionX, positionY, positionZ of the markup can be considered as an additional pick of type point.",
        "required": [
          "type",
          "start",
          "end"
        ],
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/components/schemas/AnglePickStart"
