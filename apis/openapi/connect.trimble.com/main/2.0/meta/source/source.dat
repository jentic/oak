      "ObjectsinaTagResponse": {
        "title": "ObjectsinaTagResponse",
        "required": [
          "id",
          "objectType",
          "type",
          "projectId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Tag identifier"
          },
          "objectType": {
            "type": "string",
            "enum": [
              "FILE",
              "FOLDER",
              "TODO",
              "TOPIC",
              "ISSUE"
            ],
            "description": "object type"
          },
          "contextId": {
            "type": "string",
            "description": "Unique identifier of the context in TRN format (trn:2:tc:{us|eu|ap|ap-au}:projects:{projectId}). Mandatory for objectType ISSUE and must refer to a project context."
          },
          "type": {
            "type": "string",
            "description": "Types are FILE, FOLDER, TODO [Fault, Clash, Request, Inquiry, Remark, Comment, Issue, Request, Solution], TOPIC"
          },
          "title": {
            "type": "string",
            "description": "Title of the object"
          },
          "label": {
            "type": "string",
            "description": "label for the Tag (Unique within a project)"
          },
          "description": {
            "type": "string",
            "description": "description of tag (valid for todo)"
          },
          "dueDate": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 due date (valid for todo)"
          },
          "status": {
            "type": "string",
            "description": "Processing status of File",
            "enum": [
              "PENDING",
              "ON HOLD",
              "DONE",
              "CANCELLED",
              "ERROR",
              "PROCESSING"
            ]
          },
          "priority": {
            "type": "string",
            "description": "priority of the TODO"
          },
          "projectId": {
            "type": "string",
            "description": "project identifier"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "versionId": {
            "type": "string",
            "description": "Version Id of the Folder/File"
          },
          "parentId": {
            "type": "string",
            "description": "Identifier of the parent Folder. If not present, represents the root folder/file for the project"
          },
          "permission": {
            "type": "string",
            "description": "Permission",
            "enum": [
              "READ",
              "FULL_ACCESS"
            ]
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "size of Folder/File (in bytes)"
          },
          "hasChildren": {
            "type": "boolean",
            "description": "Flag to determine if the folder has sub-folders (Only for folder type)"
          },
          "hidden": {
            "type": "boolean",
            "description": "hidden status"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "description": "Revision Number for file (valid for files)"
          },
          "thumbnailUrl": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "array of thumbnail urls (valid for files)"
          },
          "hash": {
            "type": "string",
            "description": "MD5 hash for the file contents (valid for files)"
          }
        },
        "example": {
          "id": "PuXqMs7ckQ0",
          "objectType": "TODO",
          "type": "Inquiry",
          "title": "Test02",
          "label": "TAGS-4",
          "description": "Test02",
          "dueDate": "2016-11-25T00:00:00+0000",
          "status": "NEW",
          "priority": "LOW",
          "projectId": "Dyfw481f450"
        }
      },
