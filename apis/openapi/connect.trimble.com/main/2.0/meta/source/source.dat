    "/jobs": {
      "get": {
        "tags": [
          "Support"
        ],
        "summary": "List Jobs",
        "description": "Will fetch the latest jobs ordered by latest created (by default).\nDefault range is 100 if none provided.\n\nIf no parameters are provided, status=\"PENDING\" will be the default query used.\n\nValid queue names to use in optional parameter are:\n\nIMAGE_RESIZER,DOCUMENT_CONVERSION,ASSIMILATION,CLASH,BATCHJOB,DEREFJOB,POPULATE_MODEL,\nBCF_PROCESSOR,BCF_EXPORT,CLASH_PREPROCESSOR,POPULATE_CLASH_RESULT,\nEXCEL_EXPORT,EXCEL_IMPORT,\nGEOSPATIAL,GEOSPATIAL_POSTPROCESSOR",
        "operationId": "ListJobs",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Status of the jobs to be fetched",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "PENDING"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "description": "ID of the project",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "S0MhTo4v9Z4"
            }
          },
          {
            "name": "queue",
            "in": "query",
            "description": "name of the queue",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "ASSIMILATION"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "starting date to filter, applied to createdOn (has to be within last 3 months as old records are archived)",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "ending date to filter, applied to createdOn",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "sort order, allowed fields are status, projectId, queue, createdOn or modifiedOn",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "+status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobsDetailresponse"
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "post": {
        "tags": [
          "Support"
        ],
        "summary": "Create Jobs",
        "description": "To create a request for processing data.\n\nValid queue names to use in optional parameter are:\n\nSITE_DATA_PRE_PROCESSOR\n\nYou can create a new Job using this action.\n\n+ queueName (string) - The name of the processor\n\n+ projectId (string) - Project Identifier\n\n+ details (object) - key value configuration for additional details based on queueName",
        "operationId": "Create a new job",
        "parameters": [],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobsrequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsDetailresponse"
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "patch": {
        "tags": [
          "Support"
        ],
        "summary": "Bulk Update Jobs",
        "description": "You can bulk update the `status` of the jobs using this API",
