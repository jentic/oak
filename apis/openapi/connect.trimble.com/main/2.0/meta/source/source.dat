          },
          "name": {
            "type": "string",
            "description": "Name of the Folder"
          },
          "type": {
            "type": "string",
            "enum": [
              "FOLDER",
              "FILE"
            ],
            "description": "Item type"
          },
          "versionId": {
            "type": "string",
            "description": "Version Id of the Folder"
          },
          "parentId": {
            "type": "string",
            "description": "Identifier of the parent Folder. If not present, represents the root folder for the project"
          },
          "parentType": {
            "type": "string",
            "enum": [
              "FOLDER",
              "TODO"
            ],
            "description": "Type of the parent"
          },
          "permission": {
            "type": "string",
            "enum": [
              "READ",
              "FULL_ACCESS"
            ],
            "description": "Permission"
          },
          "_actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed actions for the specific user on the specific storage object",
            "enum": [
              "folder:Create",
              "folder:Delete",
              "folder:EditPermission",
              "folder:Get",
              "folder:GetPermission",
              "folder:List",
              "folder:Restore",
              "folder:Update",
              "file:Create",
              "file:Delete",
              "file:EditPermission",
              "file:Get",
              "file:GetPermission",
              "file:List",
              "file:Restore",
              "file:Update"
            ]
