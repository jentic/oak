      "PaginationLinks": {
        "type": "object",
        "description": "Schema for pagination links.",
        "properties": {
          "first": {
            "type": "object",
            "description": "A URL that will retrieve the first page of results.",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri",
                "example": "https://app.connect.trimble.com/tc/api/2.0/comments/{commentId}/reactions?pageSize=100"
              }
            }
          },
          "self": {
            "type": "object",
            "description": "A URL that will retrieve the response that was just received.",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "next": {
            "type": "object",
            "description": "A URL that will retrieve the next page of results.",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri",
                "example": "https://app.connect.trimble.com/tc/api/2.0/comments/{commentId}/reactions?pageSize=100&skipToken=sgsfhdgg"
              }
            }
          }
        }
      },
