          },
          "rotationZ": {
            "type": "number",
            "description": "rotation quaternion z component"
          },
          "rotationW": {
            "type": "number",
            "description": "rotation quaternion w component"
          },
          "excludedVersionIds": {
            "type": "array",
            "items": {
              "type": "string"
