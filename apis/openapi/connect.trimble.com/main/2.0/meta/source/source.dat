    "/shares": {
      "get": {
        "tags": [
          "Shares"
        ],
        "summary": "List all Shares",
        "description": "This API will fetch all the shares by the user.\n\nIf the calling user is the project admin, then the Response will have all shares for the  given projectId, else it will return the shares created by that user in project.\n\nIf the projectId is not given, then the API Response will have shares across all the projects for the calling user.\n\nThe default limit will be 25 elemenets, maximum of 1000 elements can be fetched on ranged Request",
        "operationId": "ListallShares",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "ID of the Project",
            "schema": {
              "type": "string",
              "example": "Dyfw481f304"
            }
          },
          {
            "name": "includeFields",
            "in": "query",
            "description": "Optional field to include additional data in response. Supported values - path, parentid. \nWhen path is specified, the response will include the path field for each shared object.\nWhen parentId is specified, the response will include the parent folder id for each shared object.",
            "schema": {
              "type": "string",
              "enum": [
                "path",
                "parentId"
              ],
              "example": "path, parentId"
            }
          }
        ],
        "responses": {
          "206": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShareDetailsResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shares"
        ],
        "summary": "Create a New Share",
        "description": "You may create a new Share using this action.\n\nDepending on mode, for \"PROJECT_USERS\", valid values for \"notify\" object's \"type\" field are ['USER', 'GROUP'], and for other two modes, valid type is \"EMAIL\" (with \"id\" being the actual email address)\n\nFor Objects array, in case of FILE object type, user can specify optional \"useLatestVersion\" boolean field. Defaults to \"true\".\n\nFor \"PROJECT_USERS\" mode, \"expiryDate\", \"permission\", and \"useLatestVersion\" are defaulted and cannot be specified in the API.\n\n- expiryDate : never\n\n- permission : DOWNLOAD\n\n- useLatestVersion : TRUE",
        "operationId": "CreateaNewShare",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateaNewShareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateShareResponse"
                }
              }
            }
          }
        }
      }
    },
    "/shares/token/{stoken}": {
      "get": {
        "tags": [
          "Shares"
        ],
        "summary": "Get Share Details along with public accesstoken.",
        "description": "Get details of the particular share using share token along with accessToken to access the files shared in public mode",
        "operationId": "GetShareDetailsWithAccessTokenUsingStoken",
        "security": [],
        "parameters": [
