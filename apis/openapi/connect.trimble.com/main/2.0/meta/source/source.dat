    "/files/{fileId}/status": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Get processing status of a File",
        "description": "Returns the format processing status for 2D and 3D files. The valid return values are integer from 0 to 100, negative values indicate processing error.\n\nSupported formats are ifc, ifczip, 3dm, obj, skp, fbx, rvt, dwg, dxf, dgn, 3ds, stp, step, iges, igs, stl, doc, docx, xls, xlsx, rtf, txt, ppt, pptx, pdf, jpg, jpeg, gif, png, bmp, jpg, jpeg, gif, png, tif and tiff.",
        "operationId": "GetprocessingstatusofaFile",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "ID of the file",
            "required": true,
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "specific version you need status on.",
            "schema": {
              "type": "string",
              "example": "sdXH7RAh3Rk"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "processing status of a specific format",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "TRB",
                "PDF",
                "THUMBNAIL",
                "GEOJSON"
              ],
              "example": "TRB"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetprocessingstatusofaFileResponse"
                }
              }
            }
          }
        }
      }
