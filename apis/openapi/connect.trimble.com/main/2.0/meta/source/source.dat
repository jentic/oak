      "put": {
        "tags": [
          "Files"
        ],
        "summary": "Create Alignment",
        "description": "Create or update an alignment for a given file. It is assumed that the vectors axis and refDirection are orthonormal. \n\nUpdates or creates alignment for the latest version of the file if versionId is not mentioned.",
        "operationId": "CreateAlignment",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "ID of the file",
