    "/projects/{projectId}/objects": {
      "get": {
        "tags": [
          "Object Sync"
        ],
        "summary": "Get project content changes since last time",
        "description": "Fetch the changes in the project content happend after the sync cursor value proved in the `status` parameter.\nThe API allows to fetch changes in project files and folders. Each change represents a new version of the file or folder. Changes are ordered by the time. The API can be thought of as a stream of change events, client fetches events from the stream using a cursor (skipToken) that represents a position in the stream. If skipToken is not provided then events are fetched from the beginning of the project history, otherwise only events that happen after the given cursor are returned. The API allows to implement efficient incremental synchronisation (or cache invalidation) for the project file system on the client side.",
        "operationId": "GetProjectSyncObjects",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "Id of the project to process",
            "required": true,
            "schema": {
              "type": "string",
              "example": "vGxx_WPD1G0"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "The base64 url-safe encoded for of sync cursor from the `GetProjectSyncStatus` API.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eyJhbGciOiJIUzI1NiJ9.eyJleHAiOjE0NTY4ODY4MjUsInN1YiI6IlFRckxtak9qUm9ZIiwidXNlcklkIjoiTS1kV3VqSk5RWEEiLCJpc3MiOiInYXBpLmd0ZWFtLmNvbSciLCJqdGkiOiIxbl8wclV4aWUydyIsInNJZCI6Im1Nd1VadTNwZmNNIiwiaWF0IjoxNDU2ODU4MDI1fQ.7nTSr6Apzu0JeN7-_bl58fDyZ32Q_lL-uTK1wIOFQWg"
            }
          },
          {
            "name": "types",
            "in": "query",
            "description": "Comma seperated resource types to fetch. Supported types are: [`ALIGNMENT`,`CLASH`,`COMMENT`,`GROUP`,`FSOBJECT`(_Supported for `FILE` and `FOLDER` types_),`OBJECTLINK`,`RELEASE`,`TAG`,`TODO`,`VIEW`,`VIEW2D`,`VIEW_GROUP`]. If not provided, all supported object types are included.",
            "schema": {
              "type": "string",
              "example": "TODO,COMMENT,TAG"
            }
          },
          {
            "name": "includeTopicEmbedded",
            "in": "query",
            "description": "If specified and true then topic embedded views will be included in the response",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Format to be used in the response. Possible values are (**`v1, v2`**). <br/>Default value is v1. This format will be deprecated soon. <br/>Format **`v1`** follows legacy response structure (refer ObjectSyncFetchObjects). <br/>Format **`v2`** follows new response structure (refer FileFolderObjSyncResponse).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "v1"
            }
          },
          {
            "name": "skipToken",
            "in": "query",
            "description": "Optimized cursor to fetch events. **`skipToken`** represents a position in the stream. <br/>If not provided, events are fetched from the beginning of the project history. ",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "Pagination details for legacy implementation. <br/>It is recommended to use **`format=v2`**, **`skipToken`** and **`maxItems`** for **`types=FSOBJECT`** workflow.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxItems",
            "in": "query",
            "description": "Maximum amount of items to return in the response. <br/>It is not guaranteed that exact number of items will be returned, but up to the provided value as max. <br/>The maximum value for this parameter is **`10000`** and the default value will be same as the maximum value. <br/> If requested maxItems exceeds the limit (**10000**), then request will be failed with an error message. <br/>Note that max items limit might be increased in the future, clients should not make any assumptions on the number of items returned by default.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ObjectSyncFetchObjectList"
                    },
                    {
                      "$ref": "#/components/schemas/FileFolderObjSyncResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
