      "ClashDetailsResponse": {
        "title": "ClashDetailsResponse",
        "required": [
          "name",
          "id",
          "projectId",
          "tolerance",
          "type",
          "status",
          "count",
          "ignoreSameDiscipline",
          "models",
          "files",
          "createdBy",
          "createdOn",
          "modifiedBy",
          "modifiedOn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Clash identifier"
          },
          "name": {
            "type": "string",
            "description": "name for the Clash"
          },
          "projectId": {
            "type": "string",
            "description": "project identifier"
          },
          "tolerance": {
            "type": "number",
            "description": "(float)- Tolerance of the clash"
          },
          "type": {
            "type": "string",
            "enum": [
              "CLASH",
              "CLEARANCE"
            ],
            "description": "Type of Clash report created"
          },
          "status": {
            "type": "number",
            "description": "(Int)- Clash processing indicator"
          },
          "count": {
            "type": "number",
            "description": "count of clash"
          },
          "ignoreSameDiscipline": {
            "type": "boolean",
            "description": "(Int)-  Flag check to ignore same discipline in Clash"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "An ordered array of model version ids"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "An ordered array of model file ids corresponding to the models array"
          },
          "assignees": {
            "$ref": "#/components/schemas/AssigneeResponse"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 date when the Clash was last modified"
          },
          "createdOn": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 date when the Clash was last modified"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          }
        },
        "example": {
          "name": "mashup2",
          "projectId": "Dyfw481f438",
          "status": 100,
          "tolerance": 0.01,
          "type": "CLASH",
          "count": 8,
          "id": "bCiE0H8vE38",
          "ignoreSameDiscipline": false,
          "models": [
            "baYVC8V3ag8"
          ],
          "files": [
            "baYVC8V3ag8"
          ],
          "createdBy": {
            "id": "Dyfw481f439",
            "firstName": "Johny",
            "lastName": "Doe",
            "email": "johndoe@trimble.com",
            "status": "ACTIVE"
          },
          "createdOn": "2015-01-21T16:06:09-0800",
          "modifiedBy": {
            "id": "Dyfw481f440",
            "firstName": "Johny",
            "lastName": "Doe",
            "email": "johndoe@trimble.com",
            "status": "ACTIVE"
          },
          "modifiedOn": "2015-01-21T16:06:09-0800"
        }
      },
