      "FileCreationRequest": {
        "title": "FileCreationRequest",
        "required": [
          "parentId",
          "fromFileVersionId",
          "mergeExisting"
        ],
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "description": "Id of the parent folder to upload file(s) to or TodoId/CommentId to attach the new file to"
          },
          "parentType": {
            "type": "string",
            "description": "Type of the parent. Default value:FOLDER. Supported values : FOLDER, TODO, COMMENT"
          },
          "fromFileVersionId": {
            "type": "string",
            "description": "Version Id of the File to be copied."
          },
          "mergeExisting": {
            "type": "boolean",
            "description": "If true, and a file exists with the same name in target folder, will override the existing file as a new revision. Both copyMetaData and mergeExisting cannot be true."
          },
          "copyMetaData": {
            "type": "boolean",
            "description": "If true, copies the metadata info [revision no, createdBy, modifiedBy, createdOn, modifiedOn]"
          }
        },
        "example": {
          "parentId": "DzX0iFRoo8M",
          "fromFileVersionId": "q-XKNAhg3Rk",
          "parentType": "FOLDER",
          "copyMetaData": true,
          "mergeExisting": false
        }
      },
      "Tags": {
        "title": "Tags",
        "required": [
          "id",
          "projectId",
          "label",
          "description"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": " Folder Identifier (same across revisions)"
          },
          "projectId": {
            "type": "string",
            "description": "Project Identifier"
          },
          "label": {
            "type": "string",
            "description": "comma seperated tag label, Example - Architecture,Design"
          },
          "description": {
            "type": "string",
            "description": "Description about the tag"
          }
        },
        "example": {
          "id": "DzX0iFRoo8M",
          "projectId": "LWOf7rirztM",
          "label": "Architecture",
          "description": "Architecture"
        }
      },
