    "/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "List all Projects",
        "description": "API to list all the projects for the user. Folders count metric includes the root folder as well.",
        "operationId": "ListallProjects",
        "parameters": [
          {
            "name": "fullyLoaded",
            "in": "query",
            "description": "Include file/folder details in the listing (No of files, No of Folders, No of File Versions, Size), commerce access info. Default is TRUE",
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "minimal",
            "in": "query",
            "description": "Retrieve only id, name of the project in the listing. Will override fullyLoaded parameter. Default is FALSE",
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order. Options are [\"name\", \"size\", \"lastVisited\", \"modified\", \"updatedOn\"]. Prefix with \"+\"\" for ascending and \"-\" for descending sort order. Default is \"-lastVisited\"",
            "schema": {
              "type": "string",
              "example": "-name"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "A comma-separated list of fields to include in the response. Supported values: \"license.appAccess\" and \"license.policyType\". You can specify either or both of these values. If this parameter is present, a \"Range\" header must also be provided to limit the response to a maximum of 25 items.",
            "schema": {
              "type": "string",
              "example": "license.appAccess,license.policyType"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectDetailsResponse"
