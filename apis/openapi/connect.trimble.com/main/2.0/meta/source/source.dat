                        "activityId": "uIWwVwIss4k",
                        "activityNotificationSettingId": "PIJ2R12xD-w"
                      }
                    ]
                  }
                },
                "isTodosRestricted": true,
                "isProjectInviteRestricted": true
              }
            }
          },
          "required": true
        },
        "responses": {
