    "/folders/fs/{folderId}/permissions": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "Get Folder Permissions",
        "description": "This API gives the access control lists (ACLs) that specify the permissions for users and groups associated with a specific folder.<br>Use the query parameter <code>fields</code> with value <code>inherited</code> to include inherited permissions in addition to direct permissions.",
        "operationId": "getFolderPermissions",
        "parameters": [
          {
            "name": "folderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "inherited"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderPermissionsDto"
                },
                "example": {
                  "defaultAccess": "FULL_ACCESS",
                  "acl": {
                    "READ": [
                      "users:f29a28a8-c4b5-483e-b7b9-071db660abb6"
                    ],
                    "FULL_ACCESS": [
                      "tc-groups:woC32em2Fb0",
                      "tc-groups:*"
                    ],
                    "NO_ACCESS": [
                      "tc-groups:xbnf23yut"
                    ]
                  },
                  "inheritance": true
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
