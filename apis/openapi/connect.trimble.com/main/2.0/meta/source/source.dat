    "/objectlink": {
      "get": {
        "tags": [
          "Object Link to Entity"
        ],
        "summary": "List linked entities for objects",
        "description": "This API returns the list of links based on the version Id of the 3d model and the object Id (or object source Id). Either id or versionId parameter must be provided.",
        "operationId": "Listlinkedentitiesforobjects",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "source identifier. Currently could only be file id.  If id alone is passed then every linkage for that file (all versions) is returned.",
            "schema": {
              "type": "string",
              "example": "Dyfw481f323"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "file version identifier.  If versionId alone is passed then every linkage for the model identified by the versionId is returned.",
            "schema": {
              "type": "string",
              "example": "cFhCbaRN4t1"
            }
          },
          {
            "name": "sourceId",
            "in": "query",
            "description": "Source identifier of the object of interest.",
            "schema": {
              "type": "string",
              "example": "PdtcatZR271"
            }
          },
          {
            "name": "modifiedAfter",
            "in": "query",
            "description": "filter: only links modified after the given time are returned.",
            "schema": {
              "type": "string",
              "format": "date-time",
