        "properties": {
          "users": {
            "$ref": "#/components/schemas/usersMetrics"
          },
          "fileStorage": {
            "$ref": "#/components/schemas/fileStorageMetrics"
          }
        },
        "example": {
          "users": {
            "count": 3,
            "deleted": 2
          },
          "fileStorage": {
            "activeSize": 1318084,
            "billedSize": 1243132,
            "filesCount": 5,
            "foldersCount": 2,
            "versionsCount": 10
          }
        }
      },
      "usersMetrics": {
        "title": "usersMetrics",
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Count of active and pending users in the project"
          },
          "deleted": {
            "type": "integer",
            "format": "int32",
            "description": "Count of deleted users in the project"
          }
        },
        "example": {
          "users": {
            "count": 3,
            "deleted": 2
          }
        }
      },
      "fileStorageMetrics": {
        "title": "fileStorageMetrics",
        "type": "object",
        "properties": {
          "activeSize": {
            "type": "integer",
            "format": "int32",
            "description": "Size of latest versions of non deleted files in the project in bytes"
          },
          "billedSize": {
            "type": "integer",
            "format": "int32",
            "description": "Used storage of files and their delta versions under the project's billing account"
          },
          "filesCount": {
            "type": "integer",
            "format": "int32",
            "description": "Count of latest versions of non deleted files in the project"
          },
          "foldersCount": {
            "type": "integer",
            "format": "int32",
            "description": "Count of latest versions of non deleted folders in the project"
          },
          "versionsCount": {
            "type": "integer",
            "format": "int32",
            "description": "Sum of versions of all non deleted files"
          }
        },
        "example": {
          "fileStorage": {
            "activeSize": 1318084,
            "billedSize": 1243132,
            "filesCount": 5,
            "foldersCount": 2,
            "versionsCount": 10
          }
        }
      },
      "ProjectMinimalDetailsResponse": {
        "title": "ProjectMinimalDetailsResponse",
        "required": [
          "id",
          "name",
          "location",
          "license"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Project Identifier"
          },
          "name": {
            "type": "string",
            "description": "Name of the project"
          },
          "location": {
            "type": "string",
            "description": "Name of the region the project is hosted on"
          },
          "license": {
            "$ref": "#/components/schemas/ProjectListLicenseResponse"
          }
        },
        "example": {
          "id": "woC32em2Fb0",
          "name": "MSG Project",
          "location": "northAmerica",
          "license": {
            "appAccess": true,
            "policyType": "ENTERPRISE_PROJECT"
          }
        }
      },
      "ProjectListLicenseResponse": {
        "title": "ViewProjectLicenseDetailsResponse",
        "required": [
          "appAccess",
          "policyType"
        ],
        "type": "object",
        "properties": {
