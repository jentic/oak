  "paths": {
    "/2.1/folders/by_path": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "List Items in a Folder by Path",
        "description": "List Items in a Folder by Path\nAPI to list all items in a folder specified by a path within a project, with cursor-based pagination and optional field selection.\n\nThe `links.next.href` property in the response contains the URL to the next page of results. If there are no more results, the `links.next.href` property is not present in the response.\nThe requester is expected to call `links.next.href` to fetch the rest of the resources, if `links.next.href` is present in the response.\n\n**Pagination** : Uses cursor-based pagination with `skipToken` and `pageSize` parameters.\n**Field Selection**: Use the `fields` parameter to include optional fields information.\n**Sorting** : Supports composed order sorting with `sort` parameter.\n**Path-based Access**: Specify folder location using relative path within a project.\n",
        "operationId": "ListItemsinaFolderByPath",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "description": "Path to the folder within the project.\n",
            "required": true,
            "schema": {
              "type": "string",
              "example": "folder1/subfolder"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "description": "ID of the project containing the folder.\nMust be a valid project identifier that the user has access to.\n",
            "required": true,
            "schema": {
              "type": "string",
              "example": "XCVSDFRED23"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "A comma-separated list of optional fields to include in the response.\n**Supported values:**\n- `size` - Include size information\n- `hidden` - Include hidden value  \n- `tags` - Include tags information\n- `path` - Include path information\n- `_actions` - Include access related information\n\n**Note:** These fields are omitted from the response if not requested or if their values are null.\n",
            "required": false,
            "schema": {
              "type": "string",
              "example": "_actions,size,hidden,tags,path"
            },
            "explode": false
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of items to return per page. \nThe `pageSize` parameter informs the server on how many items client wants to receive in a single page at most.\nIf `pageSize` parameter is not specified then server return default number of items in response. \nIf the `pageSize` parameter is greater than specified limit endpoint can support server will return error to help client avoid bug in pagination implementation.\n\n**Default:** 100\n**Maximum:** 500 \n**Minimum:** 1\n",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "skipToken",
            "in": "query",
            "description": "Cursor token for pagination. If the `skipToken` query parameter is not specified, first page of the result set is returned.\n\n**First page:** Omit this parameter  \n**Subsequent pages:** Use the given skipToken to fetch next set of items\n",
            "schema": {
              "type": "string",
              "example": "ABC123"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Composed order sorting specification. Use `+` prefix for ascending and `-` prefix for descending order.\n\n**Supported fields:**\n- `name` - Sort by file/folder name\n- `size` - Sort by file/folder size in bytes\n- `modified` - Sort by modified date\n\n**Default:** `+name` (name in ascending order)\n\n**Examples:**\n- `sort=+name` - Sort by name A-Z\n- `sort=-size` - Sort by size (largest first)\n- `sort=-modified` - Sort by modified (latest first)\n",
            "schema": {
              "type": "string",
              "enum": [
                "+name",
                "-name",
                "+size",
                "-size",
                "+modified",
                "-modified"
              ],
              "default": "+name",
              "example": "+name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved items in the folder specified by path.",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ListItemsinaFolderResponseV21"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    }
                  }
                },
                "example": {
                  "items": [
                    {
                      "id": "ABC123",
                      "name": "folder1",
                      "type": "FOLDER",
                      "versionId": "aidTteQCZoA",
                      "parentId": "xFWAqIQ978M",
                      "parentType": "FOLDER",
                      "createdBy": {
                        "status": "ACTIVE",
                        "id": "ABCDEFHGHIJK",
                        "tiduuid": "46e53ce5-b9a0-4138-9fb1-67857978",
                        "email": "abc@trimble.com",
                        "firstName": "John",
                        "lastName": "P"
                      },
                      "createdOn": "2025-07-22T07:01:02+0000",
                      "modifiedOn": "2025-08-12T12:46:43+0000",
                      "modifiedBy": {
                        "status": "ACTIVE",
                        "id": "ABCDEFHGHIJK",
                        "tiduuid": "46e53ce5-b9a0-4138-9fb1-67857978",
                        "email": "abc@trimble.com",
                        "firstName": "John",
                        "lastName": "P"
                      },
                      "projectId": "XCVSDFRED23",
                      "hasChildren": true
                    }
                  ],
                  "links": {
                    "self": {
                      "href": "https://app.connect.trimble.com/tc/api/2.1/folders/by_path?path=folder1/subfolder&projectId=XCVSDFRED23&pageSize=1"
                    },
                    "first": {
                      "href": "https://app.connect.trimble.com/tc/api/2.1/folders/by_path?path=folder1/subfolder&projectId=XCVSDFRED23&pageSize=1"
                    },
                    "next": {
                      "href": "https://app.connect.trimble.com/tc/api/2.1/folders/by_path?path=folder1/subfolder&projectId=XCVSDFRED23&pageSize=1&skipToken=sgsfhdgg"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid request parameters.\n\n**Common scenarios:**\n- Missing required `path` parameter\n- Empty or invalid `path` parameter\n- Missing required `projectId` parameter\n- Invalid `projectId` format\n- Invalid `pageSize` (must be between 1 and 500)\n- Invalid `sort` parameter value\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid parent folder path"
                    },
                    "code": {
                      "type": "string",
                      "example": "INVALID_ARGUMENTS"
                    }
                  }
                },
                "examples": {
                  "invalid_path": {
                    "summary": "Invalid folder path",
                    "value": {
                      "error": "Invalid parent folder path",
                      "code": "INVALID_ARGUMENTS"
                    }
                  },
                  "invalid_page_size": {
                    "summary": "Invalid page size",
                    "value": {
                      "error": "maxItems must be between 1 and 500",
                      "code": "INVALID_PARAM"
                    }
                  },
                  "invalid_project_id": {
                    "summary": "Invalid project ID",
                    "value": {
                      "error": "Invalid projectId format",
                      "code": "INVALID_PARAM"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication required.\nThe request requires valid authentication credentials.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Authentication required"
                    },
                    "code": {
                      "type": "string",
                      "example": "UNAUTHORIZED"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Access denied.\nThe user does not have permission to access the specified project or folder path.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Access denied to project"
                    },
                    "code": {
                      "type": "string",
                      "example": "ACCESS_DENIED"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Resource not found.\nThe specified project or folder path does not exist.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Project not found"
                    },
                    "code": {
                      "type": "string",
                      "example": "RESOURCE_NOT_FOUND"
                    }
                  }
                },
                "examples": {
                  "project_not_found": {
                    "summary": "Project not found",
                    "value": {
                      "error": "Project not found",
                      "code": "RESOURCE_NOT_FOUND"
                    }
                  },
                  "path_not_found": {
                    "summary": "Folder path not found",
                    "value": {
                      "error": "Folder path not found",
                      "code": "RESOURCE_NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - An unexpected error occurred on the server.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    },
                    "code": {
                      "type": "string",
                      "example": "INTERNAL_ERROR"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/2.1/folders/{folderId}/items": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "List Items in a Folder",
        "description": "List Items in a Folder\nAPI to list all items in a folder with cursor-based pagination and optional field selection.\n\nThe `links.next.href` property in the response contains the URL to the next page of results. If there are no more results, the `links.next.href` property is not present in the response.\nThe requester is expected to call `links.next.href` to fetch the rest of the resources,if `links.next.href` is present in the response.\n\n**Pagination** : Uses cursor-based pagination with `skipToken` and `pageSize` parameters.\n**Field Selection**: Use the `fields` parameter to include optional fields information.\n**Sorting** : Supports composed order sorting with `sort` parameter.\n",
        "operationId": "ListItemsinaFolder",
        "parameters": [
          {
            "name": "folderId",
            "in": "path",
            "description": "ID of the Folder.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "DzX0iFRoo8M"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "A comma-separated list of optional fields to include in the response.\n**Supported values:**\n- `size` - Include size information\n- `hidden` - Include hidden value  \n- `tags` - Include tags information\n- `path` - Include path information\n- `_actions` - Include access related information\n\n**Note:** These fields are omitted from the response if not requested or if their values are null.\n",
            "required": false,
            "schema": {
              "type": "string",
              "example": "_actions,size,hidden,tags,path"
            },
            "explode": false
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of items to return per page. \nThe `pageSize` parameter informs the server on how many items client wants to receive in a single page at most.\nIf `pageSize` parameter is not specified then server return default number of items in response. \nIf the `pageSize` parameter is greater than specified limit endpoint can support server will return error to help client avoid bug in pagination implementation.\n\n**Default:** 100\n**Maximum:** 500 \n**Minimum:** 1\n",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "skipToken",
            "in": "query",
            "description": "Cursor token for pagination. If the `skipToken` query parameter is not specified, first page of the result set is returned.\n\n**First page:** Omit this parameter  \n**Subsequent pages:** Use the given skipToken to fetch next set of items\n",
            "schema": {
              "type": "string",
              "example": "ABC123"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Composed order sorting specification. Use `+` prefix for ascending and `-` prefix for descending order.\n\n**Supported fields:**\n- `name` - Sort by folders and files name\n- `size` - Sort by size in bytes\n- `modified` - Sort by modified date\n\n**Default:** `+name` (name in ascending order)\n\n**Examples:**\n- `sort=+name` - Sort by name A-Z\n- `sort=-size` - Sort by size (largest first)\n- `sort=-modified` - Sort by modified (newest first)\n",
            "schema": {
              "type": "string",
              "enum": [
                "+name",
                "-name",
                "+size",
                "-size",
                "+modified",
                "-modified"
              ],
              "default": "+name",
              "example": "+name"
            }
          },
          {
            "name": "objectTypes",
            "in": "query",
            "description": "Filter items by object type. Comma-separated list of object types to include in the response.\n\n**Supported values:**\n- `FOLDER` - Include only folders\n- `FILE` - Include only files\n\n**Default:** If not specified, both folders and files are returned\n\n**Examples:**\n- `objectTypes=FOLDER` - Return only folders\n- `objectTypes=FILE` - Return only files\n- `objectTypes=FOLDER,FILE` - Return both folders and files\n",
            "required": false,
            "schema": {
              "type": "string",
              "example": "FOLDER,FILE"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved items in the folder.",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ListItemsinaFolderResponseV21"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    }
                  }
                },
                "example": {
                  "items": [
                    {
                      "id": "ABC123",
                      "name": "folder1",
                      "type": "FOLDER",
                      "versionId": "aidTteQCZoA",
                      "parentId": "xFWAqIQ978M",
                      "parentType": "FOLDER",
                      "createdBy": {
                        "status": "ACTIVE",
                        "id": "ABCDEFHGHIJK",
                        "tiduuid": "46e53ce5-b9a0-4138-9fb1-67857978",
                        "email": "abc@trimble.com",
                        "firstName": "John",
                        "lastName": "P"
                      },
                      "createdOn": "2025-07-22T07:01:02+0000",
                      "modifiedOn": "2025-08-12T12:46:43+0000",
                      "modifiedBy": {
                        "status": "ACTIVE",
                        "id": "ABCDEFHGHIJK",
                        "tiduuid": "46e53ce5-b9a0-4138-9fb1-67857978",
                        "email": "abc@trimble.com",
                        "firstName": "John",
                        "lastName": "P"
                      },
                      "projectId": "XCVSDFRED23",
                      "hasChildren": true
                    }
                  ],
                  "links": {
                    "self": {
                      "href": "https://app.connect.trimble.com/tc/api/2.1/folders/cyfw481f43f/items?pageSize=1"
                    },
                    "first": {
                      "href": "https://app.connect.trimble.com/tc/api/2.1/folders/cyfw481f43f/items?pageSize=1"
