    "/files/fs/{fileId}/downloadurl": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Download URL",
        "description": "You can retrieve download URL for a single file using this action. (Part downloads supported with range headers). Use GET on the url from the Response to download file content (no other parameters/headers required)\n\nThe API also supports **If-Match** optional header to provide the versionId, so you can verify you are downloading on the latest version.\n\nIf versionId provided in the **If-Match** header is not latest, error Response wiith Response code **412** will be send back to the caller with **Errorcode** INVALID_HEADER &\n**Error Message**: If-Match header value is not latest versionId.",
        "operationId": "DownloadURL",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "ID of the file",
            "required": true,
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "specific version you need to download",
            "schema": {
              "type": "string",
              "example": "sdXH7RAh3Rk"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "format generated by TC to download",
            "schema": {
              "type": "string",
              "enum": [
                "TRB",
                "PDF",
                "THUMBNAIL",
                "GEOJSON"
              ],
              "example": "TRB"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadURLResponse"
                }
              }
            }
          }
        }
      }
    },
    "/files/{fileId}": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Get File Details",
        "description": "This API will fetch the latest version details for the given file Id.\n\nTo fetch a specific version information, optional query parameter __versionId__ can be specified.",
        "operationId": "GetFileDetails",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "ID of the file",
            "required": true,
            "schema": {
              "type": "string",
              "example": "q-XKNAhg3Rk"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "specific version Id you need information for",
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "List of fields to include in the response.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "_actions"
              ]
            },
            "explode": false
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "thumbnailUrl",
              "path",
              "_actions"
            ]
          },
          {
            "name": "minimal",
            "in": "query",
            "description": "Parameter to specify the response structure. If this is set as true, minimum required response will be sent, otherwise whole full response payload will be delivered. By default full response payload will be delivered.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Files"
        ],
        "summary": "Update File Details",
        "description": "You can rename the file using this API. To move the file, change the parentId to the id of the destination folder.\n\nIn case both parentId and name is provided, move will take precedence before rename.\n\nThe API also supports **If-Match** optional header to provide the versionId, so you can verify you are working on the latest version.\n\nIf versionId provided in the **If-Match** header is not latest, error Response wiith Response code **412** will be send back to the caller with **Errorcode** INVALID_HEADER &\n**Error Message**: If-Match header value is not latest versionId.\n\nIf the **If-Match** header value is *  or header not provided, actions will be performed on the latest version.",
        "operationId": "UpdateFileDetails",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "ID of the File",
            "required": true,
            "schema": {
              "type": "string",
              "example": "q-XKNAhg3Rk"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFileDetailsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDetailsResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Files"
        ],
        "summary": "Delete File",
        "description": "The API also supports **If-Match** optional header to provide the versionId, so you can verify you are working on the latest version. (applicable for single file upload, ignored for multiple file upload)\n\nIf versionId provided in the **If-Match** header is not latest, error Response wiith Response code **412** will be send back to the caller with **Errorcode** INVALID_HEADER &\n**Error Message**: If-Match header value is not latest versionId.\n\nIf the **If-Match** header value is *  or header not provided, actions will be performed on the latest version.",
        "operationId": "DeleteFile",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "ID of the file",
            "required": true,
            "schema": {
              "type": "string",
              "example": "q-XKNAhg3Rk"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "batchId",
            "in": "query",
            "description": "Batch id used to group multiple delete's as a single activity.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "sdXH7RAh3Rk"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "",
            "headers": {}
          }
        }
      }
    },
    "/files/{fileId}/alignment": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Get alignment",
        "description": "Get the alignment for a given file. If the **versionId** is specified the alignment details for that particular version is retrieved else it will give the alignment details of the latest version.",
        "operationId": "Getalignment",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
