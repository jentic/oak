      "ProjectsPagedResponseV21": {
        "type": "object",
        "title": "ProjectsPagedResponseV21",
        "description": "Paginated response containing a list of projects with navigation links",
        "required": [
          "items",
          "links"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "Array of project items for the current page",
            "items": {
              "$ref": "#/components/schemas/ProjectItemDtoV21"
            }
          },
          "links": {
            "$ref": "#/components/schemas/PaginationLinks"
          }
        },
        "example": {
          "items": [
            {
              "id": "ABC123",
              "name": "Sample Project",
              "rootId": "XYZ789",
              "thumbnail": "https://resources.connect.trimble.com/thumb/project.png",
              "lastVisitedOn": "2024-01-15T10:30:00Z",
              "createdAt": "2024-01-01T09:00:00Z",
