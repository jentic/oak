    "/activities/list": {
      "post": {
        "tags": [
          "Activities"
        ],
        "summary": "List activities with filters",
        "description": "This API is used to list activities with filters.The `filters` in the request body can be used to filter the list of activities by a start and end date, by list of users or usergroups who performed actions that created the activities, and by list of activity types.  <br> This API can also be used to list activities by specific objectId and objectType by using the query parameters. <br> This API uses cursor based pagination (see `lastId` and `pageSize` query params) and does not support range headers.",
        "parameters": [
          {
            "name": "objectId",
            "in": "query",
            "description": "ID of the Object, if present lists all activities associated with the object. Optional if projectId is present, else required.",
            "schema": {
              "type": "string",
              "example": "q-XKNAhg3Rk"
            }
          },
          {
            "name": "objectType",
            "in": "query",
            "description": "objectType  of `objectId`. **If objectId is specified, objectType  is required**. (Supported values : `PROJECT`, `VIEW`, `CLASH`, `RELEASE`, `COMMENT`, `FOLDER`, `FILE`, `TODO`, `VIEW2D`)",
            "schema": {
              "type": "string",
              "example": "RELEASE"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The desired page size for the response list. The allowed minimum value = 1 and maximum value = 15.  <br> For example, if the pageSize = 10,  it is guaranteed that the resource count in the response does not exceed 10, however, it does not guarantee that exactly 10 items will be returned.",
            "schema": {
              "type": "number",
              "default": 15
            }
          },
          {
            "name": "lastId",
            "in": "query",
            "description": "The lastId of the response list in the previous page. This value can be fetched from the response header Last-Id or the last resource Id from the previously fetched page list. If this value is not provided, the default paging will be from the beginning.",
            "schema": {
              "type": "string",
              "example": "P_INzmU25NU"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityListRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The `details` contains the corresponding object associated with the activity. A minimal representation is provided in the `ActivityObject`. If the client needs additional information about the object, use the corresponding resource endpoint. <br> In case of multiple activities clubbed together, the count is provided in the `statistics`. To fetch additional information in case of multiple activities, use the [/activities/logs](#/activities/logs) endpoint. To fetch additional information about the object, use the corresponding resource endpoints based on the type of object.",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityListResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
