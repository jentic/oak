                }
              }
            }
          },
          "409": {
            "description": "User tried to add a duplicate reaction."
          }
        }
      },
      "get": {
        "tags": [
          "Comments"
        ],
        "summary": "List reactions to a comment",
        "description": "List reactions to a comment. Cursor based pagination is used with optional `pageSize` query params. The default value of `pageSize` is 100.\n\n**Note:** The result items might not have the same count as in `pageSize`. The client must keep paginating until the `links.next` is empty in the response.",
        "operationId": "ListReactionsToComment",
        "parameters": [
          {
            "name": "commentId",
            "in": "path",
            "description": "ID of the Comment",
            "required": true,
            "schema": {
              "type": "string",
              "example": "cyfw481f43f"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The desired page size for the response list. The allowed minimum value = 1 and maximum value = 100.",
            "required": false,
            "schema": {
              "type": "number",
              "default": 100,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "skipToken",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The token to skip to a specific point in the full list of query results. Client must not explicitly provide this. This is automatically provided in the `links.next` of paginated response."
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AddReactionToCommentResponse"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    }
                  }
                },
                "example": {
                  "items": [
                    {
                      "id": "A1B23456-ABCD-0102-0304-555566667777",
                      "commentId": "cyfw481f43f",
                      "emoji": "\\uD83D\\uDE00",
                      "createdBy": "users:4455ecd5-38fd-4ede-810d-8494b7d7e5ad",
                      "createdAt": "2019-10-07T15:14:00-0700"
                    },
                    {
                      "id": "DEADBEEF-9876-0000-1111-121212121212",
                      "commentId": "cyfw481f43f",
                      "emoji": "\\uD83D\\uDE00",
                      "createdBy": "users:11111111-2222-3333-4444-555555555555",
                      "createdAt": "2025-06-06T17:18:00-0600"
                    }
                  ],
                  "links": {
                    "self": {
                      "href": "https://app.connect.trimble.com/tc/api/2.0/comments/cyfw481f43f/reactions?pageSize=2"
                    },
                    "first": {
                      "href": "https://app.connect.trimble.com/tc/api/2.0/comments/cyfw481f43f/reactions?pageSize=2"
                    },
                    "next": {
                      "href": "https://app.connect.trimble.com/tc/api/2.0/comments/cyfw481f43f/reactions?pageSize=2&skipToken=sgsfhdgg"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
