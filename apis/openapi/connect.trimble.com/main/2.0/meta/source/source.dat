                    "next": {
                      "href": "https://app.connect.trimble.com/tc/api/2.1/folders/cyfw481f43f/items?pageSize=1&skipToken=sgsfhdgg"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListItemsErrorResponseV21"
                },
                "examples": {
                  "invalid_page_size": {
                    "summary": "Invalid page size",
                    "value": {
                      "error": "INVALID_ARGUMENTS",
                      "message": "PageSize must be a positive integer between 1 and 500"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListItemsErrorResponseV21"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListItemsErrorResponseV21"
                }
              }
            }
          }
        }
      }
    },
    "/2.1/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "List all Projects (v2.1)",
        "description": "API to list all projects for the user with cursor-based pagination and optional field selection.\n\nThe `links.next.href` property in the response contains the URL to the next page of results. If there are no more results, the `links.next.href` property is not present in the response.\nServer may return response with `links.next.href` property even if the response contains no / lesser than requested(pageSize) items.\nServer may return less items than `pageSize` requested (or even zero). It could happen e.g. if resources requested are too large to fit into a single response\nor if some (or all `pageSize` requested) resources are not accessible to the requester. In this case requester is expected to call `links.next.href` to fetch the rest of the resources,if `links.next.href` is present in the response.\nIn extreme cases response could be empty with the `links.next.href` present, it means that all resources on the current page is not accessible to the requester.\n\n**Pagination**: Uses cursor-based pagination with `skipToken` and `pageSize` parameters.\n**Field Selection**: Use the `fields` parameter to include optional license and description information.\n**Sorting**: Supports single-field sorting with `sortBy` parameter.\n",
        "operationId": "ListAllProjectsV21",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "description": "A comma-separated list of optional fields to include in the response.\n\n**Supported values:**\n- `license.appAccess` - Include application access information\n- `license.policyType` - Include policy type information  \n- `description` - Include project description\n\n**Examples:**\n- `fields=description` - Include only description\n- `fields=license.appAccess,license.policyType` - Include license information\n- `fields=license.appAccess,license.policyType,description` - Include all optional fields\n\n**Note:** These fields are omitted from the response if not requested or if their values are null.\n",
            "schema": {
              "type": "string",
              "example": "license.appAccess,license.policyType,description"
            },
            "explode": false
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of projects to return per page. \nThe `pageSize` parameter informs the server on how many items client wants to receive in a single page at most. Server may return less number of items than requested if requested response payload is too large or if some of the items are not accessible to the requester. If `pageSize` parameter is not specified then server return maximum possible number of items by default. If the `pageSize` parameter is greater than specified limit endpoint can support server will return error to help client avoid bug in pagination implementation.\n\n**Default:** 25  \n**Maximum:** 50  \n**Minimum:** 1\n",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25,
              "example": 25
            }
          },
          {
            "name": "skipToken",
            "in": "query",
            "description": "Cursor token for pagination. If the `skipToken` query parameter is not specified, first page of the result set is returned.\n\n**First page:** Omit this parameter  \n**Subsequent pages:** Use the given skipToken to fetch next set of projects\n",
            "schema": {
              "type": "string",
              "example": "ABC123"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Single field sorting specification. Use `+` prefix for ascending and `-` prefix for descending order.\n\n**Supported fields:**\n- `name` - Sort by project name\n- `size` - Sort by project size in bytes\n- `lastVisited` - Sort by last visited date\n- `updatedAt` - Sort by last updated date\n\n**Default:** `-lastVisited` (most recently visited first)\n\n**Examples:**\n- `sortBy=+name` - Sort by name A-Z\n- `sortBy=-size` - Sort by size (largest first)\n- `sortBy=+lastVisited` - Sort by last visited (oldest first)\n",
            "schema": {
              "type": "string",
              "enum": [
                "+name",
                "-name",
                "+size",
                "-size",
                "+lastVisited",
                "-lastVisited",
                "+updatedAt",
                "-updatedAt"
              ],
              "default": "-lastVisited",
              "example": "-lastVisited"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved projects list",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectsPagedResponseV21"
                },
                "examples": {
                  "basic_response": {
