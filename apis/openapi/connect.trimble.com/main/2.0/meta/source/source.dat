{
  "openapi": "3.0.0",
  "info": {
    "title": "TC Internal API",
    "description": "_Last modified on 2021-03-09_\n\nThis document describes **internal** Trimble Connect APIs. Don't use these APIs for any new development. These APIs are planned to be deprecated.\n\n**PRIOR TO USING THIS API, YOU MUST AGREE TO OUR [TERMS OF USE](https://developer.trimble.com/docs/connect/terms)**",
    "contact": {
      "name": "Trimble Connect Support",
      "url": "https://connect.trimble.com",
      "email": "connect-support@trimble.com"
    },
    "license": {
      "name": "Trimble Connect SDK Internal Use License",
      "url": "https://developer.trimble.com/docs/connect/terms/SDK-IU-license-agreement"
    },
    "termsOfService": "https://developer.trimble.com/docs/connect/terms",
    "version": "2.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Trimble-Connect/tcps.internal-int/2.0"
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "servers": [
    {
      "url": "https://app.connect.trimble.com/tc/api/2.0",
      "description": "PROD US master region"
    },
    {
      "url": "https://app21.connect.trimble.com/tc/api/2.0",
      "description": "PROD EU region"
    },
    {
      "url": "https://app31.connect.trimble.com/tc/api/2.0",
      "description": "PROD AP region"
    },
    {
      "url": "https://app.stage.connect.trimble.com/tc/api/2.0",
      "description": "STAGE US master region"
