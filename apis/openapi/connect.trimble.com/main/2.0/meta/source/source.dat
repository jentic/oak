  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "x-amazon-apigateway-authtype": "custom"
      }
    },
    "schemas": {
      "ActivityEntryDto": {
        "type": "object",
        "required": [
          "activityId",
          "projectId",
          "activityType",
          "userId",
          "timestamp",
          "details"
        ],
        "properties": {
          "activityId": {
            "readOnly": true,
            "type": "string",
            "format": "uuid",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "projectId": {
            "type": "string",
            "example": "abcdefgh"
          },
          "activityType": {
            "type": "string",
            "example": "TOPIC_CREATED"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "a290f1ee-6c54-4b01-90e6-d701748f0854"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "the timestamp of activity occurence",
            "example": "2016-08-29T09:12:33.001Z"
          },
          "details": {
            "type": "object",
            "required": [
              "type",
              "primaryResource"
            ],
            "description": "objects representing the details needed for the activity.",
            "properties": {
              "type": {
                "type": "string",
                "description": "The type of object being added/changed/removed in the activity. eg. If a viewpoint is added/removed in topic, VIEWPOINT is the type. If a TOPIC is created/deleted, TOPIC is the type.",
                "example": "TOPIC"
              },
              "schema": {
                "type": "string",
                "format": "url",
                "example": "https://example.com/topic.schema.json",
                "description": "The schema represents the json schema for the object present in oldValue and newValue. (This is targeted for long term, but optional for phase1. For now parse the object based on the type and specific schemas such as TopicDto etc., given in this documentation)"
              },
              "primaryResource": {
                "type": "object",
                "$ref": "#/components/schemas/ActivityPrimaryResourceDto"
              },
              "oldValue": {
                "type": "object",
                "description": "state of entity before to the activity action. Can be null in case of new entity creation.",
                "$ref": "#/components/schemas/ActivityDetailDto"
              },
              "newValue": {
                "type": "object",
                "description": "state of entity after the activity action. Should be of same object type as oldValue. Can be null in case of entity deletion. However, both oldValue and newValue cannot be null.",
                "$ref": "#/components/schemas/ActivityDetailDto"
              }
            }
          }
        }
      },
      "ActivityPrimaryResourceDto": {
        "type": "object",
        "description": "the primary resource associated with the activity. (eg. topic)",
        "properties": {
          "id": {
            "type": "string",
            "description": "the primary resource id associated with the activity. eg. ID of the topic on which the viewpoint is added for a TOPIC_VIEWPOINT_ADDED activity",
            "example": "h290f1ee-6c54-4b01-70f5-d701748f0823"
          },
          "type": {
            "type": "string",
            "example": "TOPIC",
            "description": "the primary resource type."
          },
          "name": {
            "type": "string",
            "example": "Topic Title",
            "description": "the name of the primary resource."
          },
          "thumbUrl": {
            "type": "string",
            "description": "The thumbnail url of topic"
          }
        }
      },
      "ActivityDetailDto": {
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TopicDto"
          },
          {
            "$ref": "#/components/schemas/CommentDto"
          },
          {
            "$ref": "#/components/schemas/ViewpointDto"
          },
          {
            "$ref": "#/components/schemas/DocRefDto"
          }
        ]
      },
      "ActivityPubApiDto": {
        "type": "object",
        "required": [
          "type",
          "createdBy",
          "createdOn",
          "details"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of Activity action. Allowed types are ISSUE_ADD, ISSUE_UPDATE, ISSUE_DELETE, ISSUE_LINK_ADD, ISSUE_LINK_DELETE,BULK_USER_UPDATE",
            "example": "ISSUE_ADD"
          },
          "createdBy": {
            "type": "string",
            "description": "TID UUID of the user who performed the activity",
            "example": "c83d8a68-ec58-4b41-8127-4c8d6d5f5d24"
          },
          "createdOn": {
            "type": "string",
            "format": "date in ISO 8601 format.",
            "description": "Timestamp of activity created",
            "example": "2023-10-04T17:00:00Z"
          },
          "contextId": {
            "type": "string",
            "description": "The unique identifier of the context in TRN format (trn:2:tc:{us|eu|ap|ap-au}:projects:{projectId}:files:{fileId}). This is optional, and if specified, The activity will be specific to the mentioned context and will not be listed in regular project context.",
            "example": "trn:2:tc:us-east:projects:Z5_UyWkNrmA:files:S4UmFiaKDxQ"
          },
          "details": {
            "type": "object",
            "description": "The activity object based on the activity type",
            "oneOf": [
              {
                "$ref": "#/components/schemas/IssueActivityDetailsDto"
              },
              {
                "$ref": "#/components/schemas/BulkUserUpdateActivityDetailsDto"
              }
            ]
          }
        }
      },
      "IssueActivityDetailsDto": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "serverAssignedId",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the issue",
            "example": "12f8a851-7f8e-42f1-a5e6-6f7c74415070"
          },
          "type": {
            "type": "string",
            "description": "type of the activity",
            "enum": [
              "ISSUE_ADD",
              "ISSUE_UPDATE",
              "ISSUE_DELETE",
              "ISSUE_LINK_ADD",
              "ISSUE_LINK_REMOVE"
            ]
          },
          "title": {
            "type": "string",
            "description": "Title of the issue"
          },
          "serverAssignedId": {
            "type": "string",
            "description": "Server assigned id of the issue",
            "example": "ABC-1"
          },
          "data": {
            "type": "object",
            "description": "Refer to issue management service API documentation for the exact dto objects to be passed in each type of activity data DTO below.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/IssueAddActivityDto"
              },
              {
                "$ref": "#/components/schemas/IssueUpdateActivityDto"
              },
              {
                "$ref": "#/components/schemas/IssueDeleteActivityDto"
              },
              {
                "$ref": "#/components/schemas/IssueLinkAddActivityDto"
              },
              {
                "$ref": "#/components/schemas/IssueLinkRemoveActivityDto"
              }
            ]
          }
        }
      },
      "IssueAddActivityDto": {
        "type": "object",
        "required": [
          "newValue"
        ],
        "properties": {
          "newValue": {
            "type": "object",
            "description": "Issue object that was added"
          }
        }
      },
      "IssueUpdateActivityDto": {
        "type": "object",
        "required": [
          "oldValue",
          "newValue"
        ],
        "properties": {
          "oldValue": {
            "type": "object",
            "description": "Issue object with old fields that were changed"
          },
          "newValue": {
            "type": "object",
            "description": "Issue object with new fields that were changed"
          }
        }
      },
      "IssueDeleteActivityDto": {
        "type": "object",
        "required": [
          "oldValue"
        ],
        "properties": {
          "oldValue": {
            "type": "object",
            "description": "Issue object that was deleted."
          }
        }
      },
      "IssueLinkAddActivityDto": {
        "type": "object",
        "required": [
          "oldValue"
        ],
        "properties": {
          "oldValue": {
            "type": "object",
            "description": "Issue Link object added"
          }
        }
      },
      "IssueLinkRemoveActivityDto": {
        "type": "object",
        "required": [
          "oldValue"
        ],
        "properties": {
          "oldValue": {
            "type": "object",
            "description": "Issue Link object removed."
          }
        }
      },
      "BulkUserUpdateActivityDetailsDto": {
        "type": "object",
        "required": [
          "usersAddedCount",
          "usersUpdatedCount",
          "usersRemovedCount"
        ],
        "properties": {
          "usersAddedCount": {
            "type": "number",
            "description": "count of users added in project"
          },
          "usersUpdatedCount": {
            "type": "number",
            "description": "count of users updated in project"
          },
          "usersRemovedCount": {
            "type": "number",
            "description": "count of users removed in project"
          }
        }
      },
      "TopicDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "guid": {
            "type": "string",
            "nullable": true
          },
          "topic_type": {
            "type": "string",
            "nullable": true
          },
          "topic_status": {
            "type": "string",
            "nullable": true
          },
          "reference_links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "nullable": true
          },
          "index": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "creation_date": {
            "type": "string",
            "format": "date-time"
          },
          "creation_author": {
            "type": "string",
            "nullable": true
          },
          "creation_author_uuid": {
            "type": "string",
            "nullable": true
          },
          "created_by_uuid": {
            "type": "string",
            "nullable": true
          },
          "modified_date": {
            "type": "string",
            "format": "date-time"
          },
          "modified_author": {
            "type": "string",
            "nullable": true
          },
          "modified_author_uuid": {
            "type": "string",
            "nullable": true
          },
          "assigned_to": {
            "type": "string",
            "nullable": true
          },
          "assigned_to_uuid": {
            "type": "string",
            "nullable": true
          },
          "assignees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssigneeDto"
            },
            "nullable": true
          },
          "stage": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "due_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "marker": {
            "$ref": "#/components/schemas/MarkerDto"
          },
          "viewpoint": {
            "$ref": "#/components/schemas/ViewpointInfoDto"
          },
          "bim_snippet": {
            "$ref": "#/components/schemas/BimSnippetDto"
          },
          "related_topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RelatedTopicDto"
            },
            "nullable": true
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CommentDto": {
        "type": "object",
        "required": [
          "comment"
        ],
        "properties": {
          "comment": {
            "type": "string",
            "example": "https://www.trimble.com"
          }
        }
      },
      "ViewpointDto": {
        "type": "object",
        "required": [
          "view_id"
        ],
        "properties": {
          "view_id": {
            "type": "string"
          },
          "guId": {
            "type": "string",
            "format": "string"
          },
          "snapshot_url": {
            "type": "string",
            "format": "string"
          },
          "snapshot_thumb": {
            "type": "string"
          }
        }
      },
      "DocRefDto": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string",
            "format": "uuid",
            "example": "a290f1ee-6c54-4b01-90e6-d701748f0854"
          },
          "url": {
