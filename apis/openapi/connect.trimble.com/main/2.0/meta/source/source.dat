                  "$ref": "#/components/schemas/2DViewDetailsResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "2D Views"
        ],
        "summary": "Delete 2D View",
        "description": "API to delete 2D View by it's id.",
        "operationId": "Delete2DView",
        "parameters": [
          {
            "name": "viewId",
            "in": "path",
            "description": "ID of the View",
            "required": true,
            "schema": {
              "type": "string",
              "example": "GAw2S6K65dM"
            }
          },
          {
            "name": "force",
            "in": "query",
            "description": "Flag to delete explicit view even if it is attached to ToDos. Default is `false`",
            "schema": {
              "type": "boolean",
              "example": false
            }
          }
        ],
        "responses": {
          "204": {
            "description": "",
            "headers": {}
          }
        }
