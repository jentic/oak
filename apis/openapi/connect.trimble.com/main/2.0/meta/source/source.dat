      "ActivityListRequest": {
        "title": "ActivityListRequest",
        "required": [
          "projectId"
        ],
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "filters": {
            "type": "object",
            "description": "optional filters for activities.",
