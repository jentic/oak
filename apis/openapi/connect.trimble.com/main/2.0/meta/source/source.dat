    "/files/{fileId}/process": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Process file",
        "description": "Makes an attempt to process / reprocess given file if the calling user has READ or higher access to the file. The specified version or its latest content will be tried for processing (i.e, if specified version was generated due to non-content changes such as rename/move/restore, its previous latest version where file content was updated will be retried)\n\n+ Path parameters\n    + id (required, string, `lPNWZRNb7M0`): id of the input file. Only 3D (BIM) input files are supported for reprocessing.\n\n+ Body parameters\n    + format (required, string, `TRB`) : accepted values : `TRB` or `BSQ` or `PDF`\n    + versionId (optional, string, `lPNWZRNb7M0`) : will process this particular version's content if provided, otherwise the latest version's content for the given file id will be processed.",
        "operationId": "Processfile",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "`application/json`": {
              "schema": {
                "$ref": "#/components/schemas/Processfilerequest"
              },
              "example": {
                "format": "TRB",
                "versionId": "oNsCaFIusqY"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processfileresponse"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
