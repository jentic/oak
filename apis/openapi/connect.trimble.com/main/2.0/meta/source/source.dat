      "FolderDetailsresponse": {
        "title": "FolderDetailsresponse",
        "required": [
          "id",
          "name",
          "type",
          "versionId",
          "parentId",
          "parentType",
          "permission",
          "createdBy",
          "createdOn",
          "modifiedOn",
          "modifiedBy",
          "size",
          "projectId",
          "hasChildren",
          "path",
          "tags"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": " Folder Identifier (same across revisions)"
          },
          "name": {
            "type": "string",
            "description": "Name of the Folder"
          },
          "type": {
            "type": "string",
            "description": "Valid values are [\u2018FOLDER\u2019, \u2018FILE\u2019]"
          },
          "versionId": {
            "type": "string",
            "description": "revision Id of the Folder"
          },
          "parentId": {
            "type": "string",
            "description": "Identifier of the parent Folder. If not present, represents the root folder for the project"
          },
          "parentType": {
            "type": "string",
            "description": "Type of the parent.Valid Values are [\u2018FOLDER\u2019, \u2018TODO\u2019]"
          },
          "permission": {
            "type": "string",
            "description": "Valid values are [\u2018READ\u2019,\u2018FULL_ACCESS\u2019]"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "createdOn": {
            "type": "string",
            "description": "(Timestamp) An ISO8601 date when the Folder was created"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(Timestamp) An ISO8601 date when the Folder was modified"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "size of Folder (in bytes)"
          },
          "projectId": {
            "type": "string",
            "description": "Project Identifier"
          },
          "hasChildren": {
            "type": "boolean",
            "description": "Flag to determine if the folder has sub-folders"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Path"
            },
            "description": ""
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tags"
            },
            "description": "Tags specific to this folder"
          }
        },
        "example": {
          "id": "woC32em2Fb0",
          "name": "Drawings",
          "type": "FOLDER",
          "versionId": "woC32em2Fb0",
          "parentId": "iSbX9QodMq4",
          "parentType": "FOLDER",
          "permission": "FULL_ACCESS",
          "createdBy": {
            "id": "Dyfw481fE9U",
            "firstName": "John",
            "lastName": "Doe",
            "email": "johndoe@trimble.com",
            "status": "ACTIVE"
          },
          "createdOn": "2015-01-21T16:06:09-0800",
          "modifiedOn": "2015-01-21T16:06:09-0800",
          "modifiedBy": {
            "id": "Dyfw481fE9U",
            "firstName": "John",
            "lastName": "Doe",
            "email": "johndoe@trimble.com",
            "status": "ACTIVE"
          },
          "size": 1290,
          "projectId": "DzX0iFRoo8M",
          "hasChildren": false,
          "path": [
            {
              "id": "Dyfw481fE9U",
              "name": "RootFolder",
              "versionId": "Dyfw481fE9U"
            },
            {
              "id": "Wr7epg5aE1o",
              "name": "Drawings",
              "versionId": "yAqbfBXwcow"
            },
            {
              "id": "iSbX9QodMq4",
              "name": "MRN",
              "versionId": "iSbX9QodMq4"
            }
          ],
          "tags": []
        }
      },
      "Tags": {
        "title": "Tags",
        "required": [
          "id",
          "projectId",
          "label",
          "description"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": " Folder Identifier (same across revisions)"
          },
          "projectId": {
            "type": "string",
            "description": "Project Identifier"
          },
          "label": {
