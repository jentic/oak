      "Camera": {
        "title": "Camera",
        "required": [
          "cameraId",
          "targetX",
          "targetY",
          "targetZ",
          "distance",
          "pitch",
          "yaw",
          "projectionType"
        ],
        "type": "object",
        "properties": {
          "cameraId": {
            "type": "string",
            "description": "camera\u2019s identifier"
          },
          "targetX": {
            "type": "number",
            "description": "camera target\u2019s x coordinate (mm)"
          },
          "targetY": {
            "type": "number",
            "description": "camera target\u2019s y coordinate (mm)"
          },
          "targetZ": {
            "type": "number",
            "description": "camera target\u2019s z coordinate (mm)"
          },
          "upX": {
            "type": "integer",
            "format": "int32",
            "description": "x coordinate of camera\u2019s up vector"
          },
          "upY": {
            "type": "integer",
            "format": "int32",
            "description": "y coordinate of camera\u2019s up vector"
          },
          "upZ": {
            "type": "integer",
            "format": "int32",
            "description": "z coordinate of camera\u2019s up vector"
          },
          "distance": {
            "type": "number",
            "description": "distance from camera location to camera target (m)"
          },
          "pitch": {
            "type": "number",
            "description": "camera pitch value (radians)"
          },
          "yaw": {
            "type": "number",
            "description": "camera yaw value (radians)"
          },
          "projectionType": {
            "type": "string",
            "description": "camera\u2019s projection type",
            "enum": [
              "ortho",
              "perspective"
            ]
          },
          "viewId": {
            "type": "string",
            "description": "view identifier"
          },
          "viewAngle": {
            "type": "number",
            "description": "camera\u2019s view angle (degrees)"
          },
          "viewScale": {
            "type": "number",
            "description": "camera\u2019s view scale"
          }
        },
        "example": {
          "cameraId": "SU3Z_3dSJwY",
          "targetX": 5906.641099938377,
          "targetY": 28367.20764109994,
          "targetZ": 27909.584641099937,
          "upX": 0,
          "upY": 0,
          "upZ": 1,
          "distance": 450991.34641099937,
          "pitch": 1.0656410999383772,
          "yaw": 5.808185641099938,
          "projectionType": "ortho",
          "viewId": "GAw2S6K65dM"
        }
      },
