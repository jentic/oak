    "/projects/{projectId}/spatialworkspaces/{id}/image": {
      "get": {
        "tags": [
          "Spatial Workspace"
        ],
        "summary": "Get workspace Image",
        "description": "To get workspace image by id using the action. API takes width, height and resizeMethod to re-size a image on the fly. Following are the different re-size methods that the API supports.\n\n**Stretch** - The image is stretched as necessary in the x-direction to exactly match the specified width and separately in the y-direction to exactly match the specified height. So the original aspect ratio is not necessarily maintained.\n\n**DownOnlyToIdeal** - The image is re-sized only if BOTH its original width is greater than the specified width AND its original height is greater than the specified height.  Otherwise the size is unchanged. If re-sized, either the original width is adjusted to the specified width or the original height is adjusted to the specified height such that the original aspect ratio is maintained and neither height nor width becomes smaller than the specified height and width. Typically used when uploading images to server for storage at an optimal server determined size.\n\n**AlwaysToIdeal** - The image is always re-sized to the ideal size even if originally smaller.\n\n**CropToBestFit** - The maximum portion of the image that fits the aspect ratio determined from the specified width and height is cropped out of the center of the image and re-sized to the specified width and height. So aspect ratio is as per the width and height specified. Typically used when downloading images from server and re-sizing to a client specified size.",
        "operationId": "GetworkspaceImage",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "ID of a Project",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "string",
              "example": "H4ljlocVSgY"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "ID of a workspace",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "string",
              "example": "HX_QJGsFa_k"
            }
          },
          {
            "name": "width",
            "in": "query",
            "description": "Width of an image",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 250
            }
          },
          {
            "name": "height",
            "in": "query",
            "description": "Height of an image",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 250
            }
          },
          {
            "name": "resizeMethod",
            "in": "query",
            "description": "Possible values are Stretch, DownOnlyToIdeal, AlwaysToIdeal and CropToBestFit",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "CropToBestFit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {}
          }
        },
        "deprecated": false
      }
    },
