      "post": {
        "tags": [
          "Attributes"
        ],
        "summary": "Create a New Attribute",
        "description": "You may create a new Attribute using this action.\n\n+ name (string) - (Required) The details of the Attribute\n\n+ value (string) - (Required) The Value of the Attribute\n\n+ objectId (string) - (Required) Object Identifier\n\n+ objectType (string) - (Required) Object Type\n\n+ dataType (string) - (Required) DataType\n\nValid values for **objectType** are:\n\n- FILE\n\n- FOLDER\n\n- PROJECT\n\nValid values for **dataType** are:\n\n- STRING\n\n- TEXTAREA\n\n- DATE\n\n- LONG\n\n- BOOLEAN",
        "operationId": "CreateaNewAttribute",
        "parameters": [],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateaNewAttributerequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttributeDetailsresponse"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
