    "/views2d/multiparts": {
      "post": {
        "tags": [
          "2D Views"
        ],
        "summary": "Create a new 2D View with image",
        "description": "Create a 2dview using Multipart/form-data media type. The form should have two fields; one named views2d which is the stringified 2dview Json object, the other named imageData is the file to be used as thumbnail.",
        "operationId": "Createa2DViewMultipart",
        "parameters": [],
        "requestBody": {
          "description": "",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "view": {
                    "$ref": "#/components/schemas/Createa2DViewRequest"
                  },
                  "imageData": {
                    "type": "string",
                    "format": "binary",
                    "description": "View image data (base64-encoded)"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/2DViewDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/views2d/multiparts/{viewId}": {
      "patch": {
        "tags": [
          "2D Views"
        ],
        "summary": "Update a 2D View with image",
        "description": "Update a 2dview using Multipart/form-data media type. The form can have two fields; one named view which is the stringified view Json object, the other named imageData is the file to be used as thumbnail.",
        "operationId": "Update2DViewMultipart",
        "parameters": [
          {
            "name": "viewId",
            "in": "path",
            "description": "ID of the View",
            "required": true,
            "schema": {
              "type": "string",
              "example": "crMPGUr-O_c"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "view": {
                    "$ref": "#/components/schemas/Update2DViewRequest"
                  },
                  "imageData": {
                    "type": "string",
                    "format": "binary",
                    "description": "View image data (base64-encoded)"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/2DViewDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/views2d/{viewId}": {
      "get": {
        "tags": [
          "2D Views"
        ],
        "summary": "Get 2D View details",
        "description": "API to get details of a 2D View by it's Id.",
        "operationId": "Get2DViewdetails",
        "parameters": [
          {
            "name": "viewId",
            "in": "path",
            "description": "ID of the View",
            "required": true,
            "schema": {
              "type": "string",
              "example": "crMPGUr-O_c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/2DViewDetailsResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "2D Views"
        ],
        "summary": "Update 2D View",
        "description": "API to update 2D View.",
        "operationId": "Update2DView",
        "parameters": [
          {
            "name": "viewId",
            "in": "path",
            "description": "ID of the View",
            "required": true,
            "schema": {
              "type": "string",
              "example": "crMPGUr-O_c"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Update2DViewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
