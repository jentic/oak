      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Create a New Project",
        "description": "You may create a new Project using this action.\n\nTC supports max length of 255 characters for project names. Names are validated according to OS supported rules, so ones that contain non-printable ascii or with special meaning will be rejected by the API (Ex: \"..\", \"PRN\", \"/\")",
        "operationId": "CreateaNewProject",
