            "type": "boolean",
            "description": "Application access"
          },
          "policyType": {
            "type": "string",
            "description": "Project policy type"
          }
        },
        "example": {
          "appAccess": true,
          "policyType": "ENTERPRISE_PROJECT"
        }
      },
      "ProjectDetailsResponse": {
        "title": "ViewProjectDetailsResponse",
        "required": [
          "id",
          "name",
          "rootId",
          "thumbnail",
          "location",
          "lastVisitedOn",
          "createdOn",
          "updatedOn",
          "modifiedOn",
          "createdBy",
          "updatedBy",
          "modifiedBy",
          "size",
          "filesCount",
          "foldersCount",
          "versionsCount",
          "usersCount",
          "description",
          "startDate",
          "endDate",
          "access"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Project Identifier"
          },
          "name": {
            "type": "string",
            "description": "Name of the project"
          },
          "crs": {
            "$ref": "#/components/schemas/Crs"
          },
          "rootId": {
            "type": "string",
            "description": "Identifier of root folder for the project"
          },
          "thumbnail": {
            "type": "string",
            "description": "URL to fetch the thumbnail of the project (if exists)"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "location": {
            "type": "string",
            "description": "Name of the region the project is hosted on"
          },
          "lastVisitedOn": {
            "type": "string",
            "description": "(timestamp) An ISO8601 date when the user last visited the project"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(timestamp) An ISO8601 date when the Project was modified"
          },
          "createdOn": {
            "type": "string",
            "description": "(timestamp) An ISO8601 date when the Project was created"
          },
          "updatedOn": {
            "type": "string",
            "description": "(timestamp) An ISO8601 date when the Project was updated"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          },
          "updatedBy": {
            "$ref": "#/components/schemas/UpdatedBy"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Size of project in bytes"
          },
          "filesCount": {
            "type": "integer",
            "format": "int32",
            "description": "Count of Files in the project"
          },
          "foldersCount": {
            "type": "integer",
            "format": "int32",
            "description": "Count of Folders in the project"
          },
          "versionsCount": {
            "type": "integer",
            "format": "int32",
            "description": "Count of Versions - includes the number of files plus the revisions count of all files"
          },
          "usersCount": {
            "type": "integer",
            "format": "int32",
            "description": "Count of Users in the project"
          },
          "description": {
            "type": "string",
            "description": "Description of the project"
          },
          "startDate": {
            "type": "string",
            "description": "Start date of the project (timestamp)"
          },
          "endDate": {
            "type": "string",
            "description": "End date of the project (timestamp)"
          },
          "access": {
            "type": "string",
            "enum": [
              "FULL_ACCESS",
              "NO_ACCESS"
            ],
            "description": "Flag to indicate access state based on commerce status of the project in context of the current user"
          },
          "license": {
            "$ref": "#/components/schemas/License"
          }
        },
        "example": {
