      "ViewpointApiDto": {
        "title": "ViewpointApiDto",
        "type": "object",
        "description": "BCF-compatible viewpoint data structure",
        "properties": {
          "view_id": {
            "type": "string",
            "description": "Trimble Connect view identifier generated from the viewpoint",
            "example": "359cS0SswP4"
          },
          "guid": {
            "type": "string",
            "description": "Unique identifier for the viewpoint (required)",
            "example": "a8e8e7c2-9c4d-4a8b-8e1d-7f2a3b4c5d6e"
          },
          "index": {
            "type": "integer",
            "description": "Index of the viewpoint",
            "example": 1
          },
          "snapshot": {
            "$ref": "#/components/schemas/ViewpointSnapshot",
            "readOnly": true,
            "description": "Snapshot information (readonly - automatically generated from uploaded image)"
          },
          "components": {
            "$ref": "#/components/schemas/ComponentsDto"
          },
          "perspective_camera": {
            "$ref": "#/components/schemas/PerspectiveCamera"
          },
          "orthogonal_camera": {
            "$ref": "#/components/schemas/OrthogonalCamera"
          },
          "clipping_planes": {
            "type": "array",
            "description": "Clipping planes for sectioning",
            "items": {
              "$ref": "#/components/schemas/ClippingPlane"
            }
          },
          "lines": {
            "type": "array",
            "description": "Markup lines for annotations",
            "items": {
              "$ref": "#/components/schemas/MarkupLine"
            }
          },
          "bitmaps": {
            "type": "array",
            "description": "Bitmap images for markup",
            "items": {
              "$ref": "#/components/schemas/BitmapDto"
            }
          },
          "models": {
            "type": "array",
            "description": "List of model identifiers",
            "items": {
              "type": "string"
            },
            "example": [
              "model_1",
              "model_2"
            ]
          },
          "createdBy": {
            "type": "string",
            "description": "User who created the viewpoint (user:<uuid>)",
            "example": "user:12345678-1234-1234-1234-123456789012"
          },
          "modifiedBy": {
            "type": "string",
            "description": "User who last modified the viewpoint (user:<uuid>)",
            "example": "user:87654321-4321-4321-4321-210987654321"
          },
          "createdOn": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the viewpoint was created",
            "example": "2024-01-15T10:30:00Z"
          },
          "modifiedOn": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the viewpoint was last modified",
            "example": "2024-01-15T14:45:30Z"
          }
        },
        "required": [
          "guid"
        ],
        "example": {
          "guid": "a8e8e7c2-9c4d-4a8b-8e1d-7f2a3b4c5d6e",
          "perspective_camera": {
            "camera_view_point": {
              "x": 100.5,
              "y": 200,
              "z": 150.25
            },
            "camera_direction": {
              "x": -0.707,
              "y": 0,
              "z": -0.707
            },
            "camera_up_vector": {
              "x": 0,
              "y": 0,
              "z": 1
            },
            "field_of_view": 45
          }
        }
      },
      "ViewpointSnapshot": {
        "title": "ViewpointSnapshot",
        "type": "object",
        "description": "Snapshot image information for a viewpoint",
        "properties": {
          "snapshot_url": {
            "type": "string",
            "description": "URL to the full-resolution snapshot image. Falls back to thumbnail URL when the full image is not available."
          },
          "thumbnailUrl": {
            "type": "string",
            "description": "URL to the thumbnail image"
          },
          "snapshot_type": {
            "type": "string",
            "description": "Type of snapshot (Allowed types- png/jpeg)",
            "enum": [
              "png",
              "jpg",
              "jpeg"
            ]
          }
        }
      },
      "PerspectiveCamera": {
        "title": "PerspectiveCamera",
        "type": "object",
        "description": "Perspective camera settings",
        "properties": {
          "camera_view_point": {
            "$ref": "#/components/schemas/Point"
          },
          "camera_direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "camera_up_vector": {
            "$ref": "#/components/schemas/Direction"
          },
          "aspect_ratio": {
            "type": "number",
            "description": "Camera aspect ratio"
          },
          "field_of_view": {
            "type": "number",
            "description": "Field of view in degrees",
            "minimum": 1,
            "maximum": 180
          }
        }
      },
      "OrthogonalCamera": {
        "title": "OrthogonalCamera",
        "type": "object",
        "description": "Orthogonal camera settings",
        "properties": {
          "camera_view_point": {
            "$ref": "#/components/schemas/Point"
          },
          "camera_direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "camera_up_vector": {
            "$ref": "#/components/schemas/Direction"
          },
          "aspect_ratio": {
            "type": "number",
            "description": "Camera aspect ratio"
          },
          "view_to_world_scale": {
            "type": "number",
            "description": "View to world scale ratio"
          }
        }
      },
      "BaseCoordinates": {
        "title": "BaseCoordinates",
        "type": "object",
        "description": "Base class for 3D coordinate types",
        "properties": {
          "x": {
            "type": "number",
            "description": "X coordinate"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate"
          },
          "z": {
            "type": "number",
            "description": "Z coordinate"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ]
      },
      "Point": {
        "title": "Point",
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseCoordinates"
          }
        ],
        "description": "3D point representing a position in space"
      },
      "Direction": {
        "title": "Direction",
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseCoordinates"
          }
        ],
        "description": "3D vector representing a direction (typically normalized)"
      },
      "Location": {
        "title": "Location",
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseCoordinates"
          }
        ],
        "description": "3D location coordinates with transformation applied"
      },
      "MarkupLine": {
        "title": "MarkupLine",
        "type": "object",
        "description": "Markup line for annotations",
        "properties": {
          "start_point": {
            "$ref": "#/components/schemas/Point"
          },
          "end_point": {
            "$ref": "#/components/schemas/Point"
          }
        }
      },
      "ClippingPlane": {
        "title": "ClippingPlane",
        "type": "object",
        "description": "Clipping plane for sectioning",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          }
        }
      },
      "ComponentsDto": {
        "title": "ComponentsDto",
        "type": "object",
        "description": "Component visibility and selection information",
        "properties": {
          "selection": {
            "type": "array",
            "description": "Selected components",
            "items": {
              "$ref": "#/components/schemas/SelectionDto"
            }
          },
          "coloring": {
            "type": "array",
            "description": "Component coloring information",
            "items": {
              "$ref": "#/components/schemas/ColoringDto"
            }
          },
          "visibility": {
            "$ref": "#/components/schemas/VisibilityDto"
          }
        }
      },
      "VisibilityDto": {
        "title": "VisibilityDto",
        "type": "object",
        "description": "Component visibility settings",
        "properties": {
          "default_visibility": {
            "type": "boolean",
            "description": "Default visibility state for components"
          },
          "exceptions": {
            "type": "array",
            "description": "Components with different visibility than default",
            "items": {
              "$ref": "#/components/schemas/ExceptionsDto"
            }
          },
          "view_setup_hints": {
            "$ref": "#/components/schemas/ViewSetupHintsDto"
          }
        }
      },
      "SelectionDto": {
        "title": "SelectionDto",
        "type": "object",
        "description": "Selected component information",
        "properties": {
          "ifc_guid": {
            "type": "string",
            "description": "IFC GUID of the selected component"
          },
          "originating_system": {
            "type": "string",
            "description": "System that originated this component"
          },
          "authoring_tool_id": {
            "type": "string",
            "description": "Authoring tool identifier"
          }
        }
      },
      "ColoringDto": {
        "title": "ColoringDto",
        "type": "object",
        "description": "Component coloring information",
        "properties": {
          "color": {
            "type": "string",
            "description": "Hex color value",
            "pattern": "^[0-9A-Fa-f]{8}$",
            "example": "FF0000FF"
          },
          "components": {
            "type": "array",
            "description": "Components to apply this color to",
            "items": {
              "$ref": "#/components/schemas/SelectionDto"
            }
          }
        }
      },
      "ExceptionsDto": {
        "title": "ExceptionsDto",
        "type": "object",
        "description": "Component exception for visibility",
        "properties": {
          "ifc_guid": {
            "type": "string",
            "description": "IFC GUID of the component"
          },
          "originating_system": {
            "type": "string",
            "description": "System that originated this component"
          },
          "authoring_tool_id": {
            "type": "string",
            "description": "Authoring tool identifier"
          }
        }
      },
      "ViewSetupHintsDto": {
        "title": "ViewSetupHintsDto",
        "type": "object",
        "description": "View setup hints for rendering",
        "properties": {
          "spaces_visible": {
            "type": "boolean",
            "description": "Whether spaces should be visible"
          },
          "space_boundaries_visible": {
            "type": "boolean",
            "description": "Whether space boundaries should be visible"
          },
          "openings_visible": {
            "type": "boolean",
            "description": "Whether openings should be visible"
          }
        }
      },
      "BitmapDto": {
        "title": "BitmapDto",
        "type": "object",
        "description": "Bitmap image for markup annotations",
        "properties": {
          "guid": {
            "type": "string",
            "description": "Unique identifier for the bitmap"
          },
          "bitmap_type": {
            "type": "string",
            "description": "Type of bitmap (e.g., png, jpg)"
          },
          "bitmap_data": {
            "type": "string",
            "description": "Base64 encoded bitmap data"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "normal": {
            "$ref": "#/components/schemas/Direction"
          },
          "up": {
            "$ref": "#/components/schemas/Direction"
          },
          "height": {
            "type": "number",
            "description": "Height of the bitmap in world units"
          }
        }
      },
      "PagedViewpointResponse": {
        "title": "PagedViewpointResponse",
        "type": "object",
        "description": "Paginated response for viewpoints list using Trimble Connect PagedResponse",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ViewpointApiDto"
            },
            "description": "List of viewpoints"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Viewpoints",
      "description": "APIs for managing BCF-compatible viewpoints in Trimble Connect.\n\nViewpoints represent specific camera views with optional snapshot images and can be associated with issues for collaboration workflows."
    },
    {
      "name": "BIM API",
      "description": "APIs related to BIM objects are described in this section."
