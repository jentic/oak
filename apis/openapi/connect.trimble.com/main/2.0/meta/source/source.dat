          "details"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "example": "d290f1ex17",
            "description": "The connect project id"
          },
          "recipientUserUuids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "fcbc7382-97f7-497c-a3ef-cfdc3aa502f0",
              "ecbc7382-97f7-497c-a3ef-cfdc3aa50258"
            ],
            "description": "List of TID UUIDs of users to whom the emails are to be sent"
          },
          "recipientGroupIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "d290f1ex17",
              "OnkRKjL4Q_s"
            ],
            "description": "List of Group Ids in the project to whom the emails are to be sent."
          },
          "details": {
            "type": "object",
            "required": [
              "emailType"
            ],
            "description": "The type of email notification.",
            "properties": {
              "emailType": {
                "description": "The type of notification",
                "example": "TOPIC_DUE_DATE_NOTIFICATION"
              }
            },
            "example": {
              "emailType": "TOPIC_DUE_DATE_NOTIFICATION",
              "topicUuid": "h290f1ee-6c54-4b01-70f5-d701748f0823",
              "name": "The title of topic",
              "thumbUrl": "the thumb url here",
              "priority": "HIGH",
              "status": "OPEN",
              "createdByUuid": "a73d8a68-ec58-4b41-8127-4c8d6d5f5d29",
              "duedate": "2023-01-01T06:30:56+0000",
              "dueinDays": 7
            }
          }
        }
      },
