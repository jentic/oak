              },
              "types": {
                "type": "string",
                "enum": [
                  "FILE_ADD",
                  "FILE_DELETE",
                  "FILE_MOVE",
                  "FILE_RENAME",
                  "FILE_DOWNLOAD",
                  "FILE_CHECKOUT",
                  "FILE_CHECKIN",
