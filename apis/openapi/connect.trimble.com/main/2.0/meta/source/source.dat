          },
          "refDirectionX": {
            "type": "number",
            "description": "x coordinate of model ref direction unit vector"
          },
          "refDirectionY": {
            "type": "number",
            "description": "y coordinate of model ref direction unit vector"
          },
          "refDirectionZ": {
            "type": "number",
