    "/tags": {
      "get": {
        "tags": [
          "Tags"
        ],
        "summary": "List Tags in a project",
        "description": "API to list Tags under a project / mapped with an object",
        "operationId": "ListTagsinaproject",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "ID of the Project, if present lists all tags with in the project. Optional if objectId is present, else required.",
            "schema": {
              "type": "string",
              "example": "Dyfw481f337"
            }
          },
          {
            "name": "objectId",
            "in": "query",
            "description": "ID of the Object, if present lists all tags mapped with the object. Optional if projectId is present, else required.",
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "contextId",
            "in": "query",
            "description": "The unique identifier of the context in TRN format (trn:2:tc:{us|eu|ap|ap-au}:projects:{projectId}). Mandatory for objectType ISSUE and must refer to a project context.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "trn:2:tc:us:projects:Z5_UyWkNrmA"
            }
          },
          {
            "name": "objectType",
            "in": "query",
            "description": "Object type of objectId. If objectId is specified, objectType is required. (Supported values : `FOLDER`, `FILE`, `TODO`,`TOPIC`, `ISSUE`)",
            "schema": {
              "type": "string",
              "example": "FOLDER"
            }
          },
          {
            "name": "includeDeletedObjects",
            "in": "query",
            "description": "Include deleted objects mapped to the tag. Default value is false. This query parameter does not have an effect on references to TOPIC objects that are always returned regardless of their deletion status.",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": false
            }
          },
          {
            "name": "miniRep",
            "in": "query",
            "description": "If `true`, excludes the fields `createdOn`, `createdBy`, `modifiedOn`, `modifiedBy`.Default value is `false`.",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/TagDetailsResponse"
                      },
                      {
                        "$ref": "#/components/schemas/TagDetailsMiniRepResponse"
                      }
                    ]
                  },
                  "description": ""
                },
                "examples": {
                  "TagDetailsResponse": {
                    "value": [
                      {
                        "id": "q2I7dwDWrnM",
                        "projectId": "Dyfw481f338",
                        "label": "BUILDING",
                        "description": "BUILDING",
                        "color": "#FF0000",
                        "createdOn": "2016-10-27T11:56:48+0530",
                        "createdBy": {
                          "id": "Dyfw481f447",
                          "firstName": "test",
                          "lastName": "user",
                          "email": "user@trimble.com",
                          "status": "ACTIVE"
                        },
                        "modifiedOn": "2016-10-27T11:56:48+0530",
                        "modifiedBy": {
