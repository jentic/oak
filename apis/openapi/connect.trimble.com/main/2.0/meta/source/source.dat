            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "deprecated": true,
            "description": "The `versionId` of the file.",
            "schema": {
              "type": "string",
              "example": "poA38tc2Kr0"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "versionId of the file",
            "schema": {
              "type": "string",
              "example": "poA38tc2Kr0"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlignmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetalignmentResponse"
                }
              }
            }
          },
          "201": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetalignmentResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Files"
        ],
        "summary": "Delete alignment",
        "description": "Remove alignment associated with a file.  If the **versionId** is presented for a given file version, only alignment associated with that version is removed, otherwise alignments for all version removed.",
        "operationId": "Deletealignment",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "description": "ID of the file",
            "required": true,
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "deprecated": true,
