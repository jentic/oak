      "ToDoDetailsResponse": {
        "title": "ToDoDetailsResponse",
        "required": [
          "id",
          "title",
          "label",
          "description",
          "status",
          "priority",
          "projectId",
          "createdOn",
          "createdBy",
          "modifiedOn",
          "modifiedBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ToDo identifier"
          },
          "type": {
            "type": "string",
            "enum": [
              "Fault",
              "Clash",
              "Request",
              "Inquiry",
              "Remark",
              "Comment",
              "Issue",
              "Request",
              "Solution"
            ],
            "description": "Type of the ToDo"
          },
          "title": {
            "type": "string",
            "description": "Title of the ToDo"
          },
          "label": {
            "type": "string",
            "description": "Unique label for the ToDo within a project"
          },
          "description": {
            "type": "string",
            "description": "Description about the ToDo"
          },
          "dueDate": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 Due date for the ToDo"
          },
          "percentComplete": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 100,
            "description": "Progress percent"
          },
          "status": {
            "type": "string",
            "description": "ToDo Status",
            "enum": [
              "NEW",
              "IN_PROGRESS",
              "RESOLVED",
              "BLOCKED",
              "CLOSED"
            ]
          },
          "priority": {
            "type": "string",
            "description": "ToDo Priority",
            "enum": [
              "LOW",
              "NORMAL",
              "HIGH",
              "CRITICAL"
            ]
          },
          "projectId": {
            "type": "string",
            "description": "Project Identifier"
          },
          "assignees": {
            "$ref": "#/components/schemas/AssigneeResponse"
          },
          "createdOn": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 date when the ToDo was created"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(timestamp) - An ISO8601 date when the ToDo was modified"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          }
        },
        "example": {
          "id": "woC32em2Fb0",
          "type": "Comment",
          "title": "PROJ-21-Title",
          "label": "PROJ-21",
          "description": "Fix the fire rating issue",
          "dueDate": "2015-05-21T00:00:00+0000",
          "percentComplete": 11,
          "status": "NEW",
          "priority": "NORMAL",
          "projectId": "woC32em2Fb0",
