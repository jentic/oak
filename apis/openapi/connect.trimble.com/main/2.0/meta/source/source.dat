          "refDirectionX",
          "refDirectionY",
          "refDirectionZ",
          "scale"
        ],
        "type": "object",
        "properties": {
          "locationX": {
            "type": "number",
            "description": "Location X (mm)"
          },
          "locationY": {
            "type": "number",
            "description": "Location Y (mm)"
          },
          "locationZ": {
            "type": "number",
            "description": "Location Z (mm)"
          },
          "axisX": {
            "type": "integer",
            "format": "int32",
            "description": "x coordinate of axis unit vector"
          },
          "axisY": {
            "type": "integer",
            "format": "int32",
