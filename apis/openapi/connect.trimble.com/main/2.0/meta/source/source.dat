      "ListAllClashItemsResponse": {
        "title": "ListAllClashItemsResponse",
        "required": [
          "id",
          "label",
          "distance",
          "sourceId1",
          "sourceId2",
          "elementName1",
          "elementName2",
          "elementType1",
          "elementType2",
          "center"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "clash item identifier"
          },
          "label": {
            "type": "string",
            "description": "clash item name"
          },
          "distance": {
            "type": "number",
            "description": "(float)-penetration distance or clearance distance"
          },
          "sourceId1": {
            "$ref": "#/components/schemas/ClashItemSourceId"
          },
          "sourceId2": {
            "$ref": "#/components/schemas/ClashItemSourceId"
          },
          "elementName1": {
            "type": "string",
            "description": "name of the first object"
          },
          "elementName2": {
            "type": "string",
            "description": "name of the second object"
          },
          "elementType1": {
            "type": "string",
            "description": "Type of the first object"
          },
          "elementType2": {
            "type": "string",
            "description": "Type of the second object"
          },
          "center": {
            "$ref": "#/components/schemas/ClashItemCenter"
          }
        },
        "example": {
          "id": "9Ssi8I0CcG4",
          "label": "TRBT-1",
          "distance": -160,
          "sourceId1": {
            "sourceId": "0n7sI9iqr1AQjcef7_fZGD",
            "versionId": "QQrLmjOjRoY"
          },
          "sourceId2": {
            "sourceId": "3RkoOjmuLBFO0Wb70dNZur",
            "versionId": "QQrLmjOjRoY"
          },
          "elementName1": "W010",
          "elementName2": "C001",
          "elementType1": "IFCWALLSTANDARDCASE",
          "elementType2": "IFCCOLUMN",
          "center": {
            "x": 7000,
            "y": 18920,
            "z": 4854
          }
        }
      },
