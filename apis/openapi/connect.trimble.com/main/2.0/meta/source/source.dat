            "type": "string",
            "description": "Default is true. If true, folder structure will be imported"
          },
          "users": {
            "type": "string",
            "description": "Default is true. If true, users will be imported"
          },
          "groups": {
            "type": "string",
            "description": "Default is true. If true, groups will be imported."
          },
          "settings": {
            "type": "string",
            "description": "Default is true. If true, settings will be imported"
          },
          "permissions": {
            "type": "string",
            "description": "Default is true. If true, permissions will be imported. For exporting permissions, either folders/users/groups also should be exported."
          },
          "projectDetails": {
            "$ref": "#/components/schemas/ProjectDetailsRequest"
          }
        },
