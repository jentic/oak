      "ProjectItemDtoV21": {
        "type": "object",
        "title": "ProjectItemDtoV21",
        "description": "Project item representation in the v2.1 API response",
        "required": [
          "id",
          "name",
          "rootId",
          "thumbnail",
          "lastVisitedOn",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Project identifier (visible ID)",
            "example": "ABC123"
          },
          "name": {
            "type": "string",
            "description": "Name of the project",
            "example": "Downtown Office Building"
          },
          "rootId": {
            "type": "string",
            "description": "Identifier of the root folder for the project",
            "example": "XYZ789"
          },
          "thumbnail": {
            "type": "string",
            "description": "URL to fetch the thumbnail of the project",
            "example": "https://resources.connect.trimble.com/thumb/project.png"
          },
          "lastVisitedOn": {
            "type": "string",
            "format": "date-time",
            "description": "ISO8601 timestamp when the user last visited the project",
            "example": "2024-01-15T10:30:00Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO8601 timestamp when the project was created",
            "example": "2024-01-01T09:00:00Z"
          },
          "createdBy": {
            "type": "string",
            "description": "TIDUUID in curie format, e.g users:TIDUUID",
            "example": "users:4455ecd5-38fd-4ede-810d-8494b7d7e5ad"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO8601 timestamp when the project was last updated",
            "example": "2024-01-15T10:25:00Z"
          },
          "updatedBy": {
            "type": "string",
            "description": "TIDUUID in curie format, e.g users:TIDUUID",
            "example": "users:a8b9c0d1-e2f3-4566-7890-123456789012"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Size of the project in bytes",
            "example": 1572864
          },
          "description": {
            "type": "string",
            "description": "Project description. \n\n**Note:** This field is only included in the response if:\n1. The `fields` parameter includes `description`\n2. The project has a non-null, non-empty description\n\nIf not requested or if the value is null/empty, this field is omitted from the JSON response.\n",
            "example": "Modern office building project with sustainable design features"
          },
          "license": {
            "$ref": "#/components/schemas/ProjectLicenseV21"
          }
        }
      },
      "ProjectLicenseV21": {
        "type": "object",
        "title": "ProjectLicenseV21",
        "description": "License information for the project.\n\n**Note:** This object is only included in the response if:\n1. The `fields` parameter includes license-related fields (`license.appAccess` or `license.policyType`)\n2. The project has valid license information\n\nIf not requested or if license information is unavailable, this field is omitted from the JSON response.\n",
        "properties": {
          "policyType": {
            "type": "string",
            "description": "Project policy type indicating the license tier or type.\n\n**Note:** Only included if `fields` parameter contains `license.policyType`\n",
            "example": "ENTERPRISE_PROJECT",
            "enum": [
              "ENTERPRISE_PROJECT",
              "UNLICENSED_PROJECT",
              "LICENSED_PROJECT",
              "DERIVED"
            ]
          },
          "appAccess": {
            "type": "boolean",
            "description": "Flag indicating whether applications have access to this project.\n\n**Note:** Only included if `fields` parameter contains `license.appAccess`\n",
            "example": true
          }
        },
        "example": {
          "policyType": "ENTERPRISE_PROJECT",
          "appAccess": true
        }
      },
      "ErrorResponseV21": {
        "type": "object",
        "title": "ErrorResponseV21",
        "description": "Standard error response format",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code indicating the type of error",
            "example": "INVALID_ARGUMENTS",
            "enum": [
              "INVALID_ARGUMENTS",
              "UNAUTHORIZED",
              "INTERNAL_ERROR",
              "NOT_FOUND"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message providing details about the error",
            "example": "Invalid field: license.invalidField. Valid fields are: [license.appAccess, license.policyType, description]"
          }
        },
        "example": {
          "error": "INVALID_ARGUMENTS",
          "message": "PageSize must be a positive integer between 1 and 50"
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "errorcode": {
            "type": "string"
          }
        }
      },
      "FileUploadContentDto": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "description": "Supported values are TRB, PDF and THUMBNAIL. For source file this property can be ignored"
          },
          "fileset": {
            "type": "boolean",
            "description": "Mark this file as a multifile. Supported only for source file.",
            "default": false
          },
          "multipart": {
            "type": "boolean",
            "description": "Mark this upload as a multipart(split the upload into multiple parts). Server will respond with a templated URL that the client can use to do each partial upload and partNumber has to be specified in the templated url while uploading the parts.Each part in a multipart upload must be between 5 MiB (5,242,880 bytes) and 5 GiB (5,368,709,120 bytes). The last part can be smaller than 5 MiB (5,242,880 bytes). In general, part sizes should be as large as possible.Each part upload to this templated url returns **Etag** in the response headers When the client is done, they must call the complete endpoint with the etags of each part upload as the input.Supported only for source file.",
            "default": false
          },
          "size": {
            "type": "integer",
            "description": "Size of the file in bytes. Mandatory for multipart uploads. Will be ignored if specified for non multipart uploads in request.For single part uploads the size is visible only when status is AVAILABLE, for multipart uploads immediately.",
            "format": "int64"
          },
          "path_template": {
            "type": "string",
            "description": "Path structure for downloading a file in case of a multifile"
          }
        },
        "description": "Contents can be skipped for single part source file only uploads."
      },
      "FileUploadDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the file"
          },
          "contents": {
            "type": "array",
            "description": "Contents can be skipped for single part source file only uploads.",
            "items": {
              "$ref": "#/components/schemas/FileUploadContentDto"
            }
          }
        }
      },
      "FileUploadDetailsResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the file"
          },
          "uploadId": {
            "type": "string",
            "description": "Upload identifier"
          },
          "parentId": {
            "type": "string",
            "description": "ParentId of the file"
          },
          "parentType": {
            "type": "string",
            "description": "ParentType of the file"
          },
          "projectId": {
            "type": "string",
            "description": "ProjectId of the file"
          },
          "status": {
            "type": "string",
            "description": "Overall status of the upload",
            "enum": [
              "UPLOADABLE",
              "DONE",
              "ERROR",
              "EXPIRED"
            ]
          },
          "fileId": {
            "type": "string",
            "description": "File identifier. Property is returned when status is UPLOADABLE when updating existing file.In case of new file upload, property is returned only when status is DONE"
          },
          "versionId": {
            "type": "string",
            "description": "File version identifier. Property is returned only when status is DONE"
          },
          "revision": {
            "type": "integer",
            "description": "File revision. Property is returned only when status is DONE",
            "format": "int64"
          },
          "contents": {
            "type": "array",
            "description": "content that has format not specified refers to source file",
            "items": {
              "$ref": "#/components/schemas/UploadDetailsContent"
            }
          },
          "created": {
            "type": "string",
            "description": "Upload created time",
            "format": "date-time"
          },
          "modified": {
            "type": "string",
            "description": "File saved time",
            "format": "date-time"
          },
          "completed": {
            "type": "string",
            "description": "Upload completed time. (When status is updated as DONE)",
            "format": "date-time"
          },
          "createdBy": {
            "$ref": "#/components/schemas/UserDto"
          },
          "errorReason": {
            "type": "string",
            "description": "Error reason in case status is ERROR",
            "example": "THUMB_MAX_SIZE_EXCEEDED"
          }
        }
      },
      "UploadDetailsContent": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "description": "Supported values are TRB, PDF and THUMBNAIL. For source file this property can be ignored"
          },
          "fileset": {
            "type": "boolean",
            "description": "Mark this file as a multifile. Supported only for source file.",
            "default": false
          },
          "multipart": {
            "type": "boolean",
            "description": "Mark this upload as a multipart(split the upload into multiple parts). Server will respond with a templated URL that the client can use to do each partial upload and partNumber has to be specified in the templated url while uploading the parts.Each part in a multipart upload must be between 5 MiB (5,242,880 bytes) and 5 GiB (5,368,709,120 bytes). The last part can be smaller than 5 MiB (5,242,880 bytes). In general, part sizes should be as large as possible.Each part upload to this templated url returns **Etag** in the response headers When the client is done, they must call the complete endpoint with the etags of each part upload as the input.Supported only for source file.",
            "default": false
          },
          "size": {
            "type": "integer",
            "description": "Size of the file in bytes. Mandatory for multipart uploads. Will be ignored if specified for non multipart uploads in request.For single part uploads the size is visible only when status is AVAILABLE, for multipart uploads immediately.",
            "format": "int64"
          },
          "type": {
            "type": "string",
            "description": "Upload type, it maybe SINGLEPART or MULTIPART"
          },
          "url": {
            "type": "string",
            "description": "File should be uploaded to this url with the PUT operation and no additional headers including Authorization to be sent. Returned only when status is UPLOADABLE.This upload url can be refereshed(on expiry) by calling Get File Upload Details API"
          },
          "status": {
            "type": "string",
            "description": "Status of the file upload, the valid values are UPLOADABLE, UPLOADED, FINALIZING, AVAILABLE, DELETING, UPLOAD_FAILED, ARCHIVE_PROCESSING, ARCHIVE_PROCESSING_FAILEDS"
          },
          "path_template": {
            "type": "string",
            "description": "Path structure for downloading a file in case of a multifile"
          }
        },
        "description": "content that has format not specified refers to source file"
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tiduuid": {
            "type": "string"
          }
        }
      },
      "CompleteUploadRequestDto": {
        "required": [
          "parts"
        ],
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "description": "For source file this property can be ignored"
          },
          "parts": {
            "type": "array",
            "description": "Parts of the file to be completed",
            "items": {
              "$ref": "#/components/schemas/PartDto"
            }
          }
        }
      },
      "PartDto": {
        "required": [
          "etag",
          "part_number"
        ],
        "type": "object",
        "properties": {
          "etag": {
            "type": "string",
            "description": "**etag** value is given as the part of the response headers of the PUT request to the upload URL"
          },
          "part_number": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Parts of the file to be completed"
      },
      "InitiateFileUploadRequest": {
        "required": [
          "name",
          "parentId",
          "parentType"
        ],
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "description": "Id of the parent folder to upload file(s) to or TodoId/CommentId to attach the new file to"
          },
          "name": {
            "type": "string",
            "description": "name of the file"
          },
          "parentType": {
            "type": "string",
            "description": "Type of the parent. Default value:FOLDER. Supported values : FOLDER, TODO, COMMENT, OBJECTLINK.<br/>     - parentType as FOLDER to upload file to the given folder.<br/>   - parentType as TODO  to attach the file to the Todo.<br/>     - parentType as COMMENT to attach the file to the Comment.<br/>     - parentType as OBJECTLINK to attach the file to the object link.<br/>"
          },
          "numberOfParts": {
            "type": "string",
            "description": "number of parts, for multipart"
          },
          "size": {
            "type": "string",
            "description": "size of file in bytes, for multipart"
          },
          "pathTemplate": {
            "type": "string",
            "description": "path structure for downloading a file in case of a multifile"
          },
          "fileset": {
            "type": "boolean",
            "description": "mark this file as a multifile"
          }
        }
      },
      "CommitFileUploadRequest": {
        "required": [
          "uploadId"
        ],
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "multipart": {
            "$ref": "#/components/schemas/CommitUploadDto"
          }
        },
        "description": "Commit and finalize the file upload. For multipart uploads the multipart property with list of uploaded parts is required."
      },
      "CommitUploadDto": {
        "required": [
          "upload"
        ],
        "type": "object",
        "properties": {
          "upload": {
            "$ref": "#/components/schemas/UploadParts"
          }
        },
        "description": "This is required only for Multipart upload"
      },
