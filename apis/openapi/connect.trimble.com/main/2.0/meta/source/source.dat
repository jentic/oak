    "/projects/clones": {
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Clone project from existing project",
        "description": "This API facilitates the creation of a new project by cloning an existing one.\nAPI supports cloning settings, users, groups, folders and permissions of an\nexisting project. It generates a request to clone the given project and returns\nthe details of the clone process. Status of the clone process can be tracked\nusing the GET project clone details API. \n\n\nThe 'include' field in the request body indicate the items to be included in\nclone. The selection of these items could be done in any manner. Only those\nitems that are selected will be included in clone. \n\n\nHowever, there is also a special scenario\n\n\n`*` => implicitly includes all options (folders, users, groups, settings and folderPermissions)\n\n\nExamples on how different values in 'include' control the clone behavior\n\n\n- folders + users => folders and users alone will be cloned\n\n- folders + groups => folders and groups alone will be cloned\n\n- folders + users + settings => folders, users and settings alone will be cloned\n\n- folders + folderPermissions => folders and default folder permissions will be cloned\n\n- folders + users + folderPermissions => folders, users, default folder permissions and user permissions in folder level will be cloned\n\n- folders + groups + folderPermissions => folders, groups, default default permissions and group permissions in folder level will be cloned.\n\n- folders + folderPermissions + settings => folders, folder default permissions and settings will be cloned\n\n- `*` => all items (folders, users, groups, respective folder permissions and settings) will be cloned\n\n- settings + users + groups + folderPermissions =>   settings, users and groups will be cloned\n\n`Permission level required:` Only project admins can perform the project clone operation",
        "operationId": "cloneProject",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCloneRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectCloneResponse"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/projects/clones/{cloneId}": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "Get the details of project clone",
        "description": "API to fetch details of the project clone. The response will contain the id of the cloned project (inside the `result` object) in case of successful clone, or will contain information about the reason for failure in case of clone failure.\n\n`Permission level required:` This API can be accessed only by the user who initiated the project clone",
        "operationId": "getProjectCloneDetails",
        "parameters": [
          {
            "name": "cloneId",
            "in": "path",
            "description": "Clone ID for which the details are required.",
            "required": true,
            "style": "simple",
            "explode": true,
            "schema": {
