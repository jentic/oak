  "paths": {
    "/viewpoints": {
      "post": {
        "tags": [
          "Viewpoints"
        ],
        "summary": "Create Viewpoint",
        "description": "Create a viewpoint for an issue. A viewpoint represents a specific camera view with optional snapshot image data.\n\nThis endpoint accepts BCF-compatible viewpoint data and creates a view in the Trimble Connect system.\n\n**Notes**: \n- The GUID field is mandatory and must be unique within the issue.\n- When uploading an image file via `imageData` multipart form field, the `snapshot_type` is automatically inferred from the file extension and validated.\n- The `snapshot` field in the request body is readonly - it will be ignored if provided.\n- The response will include the `snapshot` object with `snapshot_url` and `snapshot_type` if an image was uploaded.",
        "operationId": "CreateViewpoint",
        "parameters": [
          {
            "name": "contextId",
            "in": "query",
            "description": "Context identifier (project context is only currently supported)",
            "required": true,
            "schema": {
              "type": "string",
              "example": "trn:2:tc:{region}:projects:{projectId}"
            }
          },
          {
            "name": "issueId",
            "in": "query",
            "required": true,
            "description": "Optional issue identifier to associate the viewpoint with",
            "schema": {
              "type": "string",
              "example": "12f8a851-7f8e-42f1-a5e6-6f7c74415070"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "viewpoint": {
                    "type": "string",
                    "description": "JSON string containing viewpoint data"
                  },
                  "imageData": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional image file for the viewpoint snapshot"
                  }
                },
                "required": [
                  "viewpoint"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Viewpoint created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewpointApiDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid viewpoint data"
          },
          "403": {
            "description": "Forbidden - Insufficient permissions"
          }
        }
      },
      "get": {
        "tags": [
          "Viewpoints"
        ],
        "summary": "List Viewpoints",
        "description": "List viewpoints in a project with support for cursor-based pagination.\n\nReturns viewpoints associated with an issue, with pagination support using skipToken.",
        "operationId": "ListViewpoints",
        "parameters": [
          {
            "name": "issueId",
            "in": "query",
            "required": true,
            "description": "Issue identifier to filter viewpoints",
            "schema": {
              "type": "string",
              "example": "12f8a851-7f8e-42f1-a5e6-6f7c74415070"
            }
          },
          {
            "name": "contextId",
            "in": "query",
            "description": "Context identifier",
            "required": true,
            "schema": {
              "type": "string",
              "example": "trn:2:tc:us:projects:projectId"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of items per page (max 25, default 25)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 25,
              "example": 25
            }
          },
          {
            "name": "skipToken",
            "in": "query",
            "description": "Cursor token for pagination - opaque string token for fetching next page",
            "schema": {
              "type": "string",
              "example": "RXhhbXBsZVZ"
            }
          }
        ],
        "responses": {
          "206": {
            "description": "Partial content - List of viewpoints retrieved successfully with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedViewpointResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters"
          },
          "403": {
            "description": "Forbidden - Insufficient permissions"
          }
        }
      }
    },
    "/viewpoints/{guid}": {
      "get": {
        "tags": [
          "Viewpoints"
        ],
        "summary": "Get Viewpoint by GUID",
        "description": "Retrieve a specific viewpoint by its GUID.\n\nReturns the viewpoint data in BCF-compatible format.",
        "operationId": "GetViewpointByGuid",
        "parameters": [
          {
            "name": "guid",
            "in": "path",
            "description": "GUID of the viewpoint",
            "required": true,
            "schema": {
              "type": "string",
              "example": "a8e8e7c2-9c4d-4a8b-8e1d-7f2a3b4c5d6e"
            }
          },
          {
            "name": "issueId",
            "in": "query",
            "description": "Issue identifier to which the viewpoint belongs",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12f8a851-7f8e-42f1-a5e6-6f7c74415070"
            }
          },
          {
            "name": "contextId",
            "in": "query",
            "description": "Context identifier",
            "required": true,
            "schema": {
              "type": "string",
              "example": "trn:2:tc:us:projects:projectId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Viewpoint retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewpointApiDto"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient permissions"
          },
          "404": {
            "description": "Viewpoint not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Viewpoints"
        ],
        "summary": "Delete Viewpoint by GUID",
        "description": "Delete a specific viewpoint by its GUID.\n\nRemoves the viewpoint from the system permanently.",
        "operationId": "DeleteViewpointByGuid",
        "parameters": [
          {
            "name": "guid",
            "in": "path",
            "description": "GUID of the viewpoint to delete",
            "required": true,
            "schema": {
              "type": "string",
              "example": "a8e8e7c2-9c4d-4a8b-8e1d-7f2a3b4c5d6e"
            }
          },
          {
            "name": "issueId",
            "in": "query",
            "description": "Issue identifier to which the viewpoint belongs",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12f8a851-7f8e-42f1-a5e6-6f7c74415070"
            }
          },
          {
            "name": "contextId",
            "in": "query",
            "description": "Context identifier",
            "required": true,
            "schema": {
              "type": "string",
              "example": "trn:2:tc:us:projects:projectId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Viewpoint deleted successfully"
          },
          "403": {
            "description": "Forbidden - Insufficient permissions"
          },
          "404": {
            "description": "Viewpoint not found"
          }
        }
      }
    },
