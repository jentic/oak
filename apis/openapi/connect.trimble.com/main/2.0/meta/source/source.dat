      "GetUserDetailsResponse": {
        "title": "GetUserDetailsResponse",
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "status",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "User identifier"
          },
          "tiduuid": {
            "type": "string",
            "description": "Trimble ID of the user"
          },
          "firstName": {
            "type": "string",
            "description": "First name of the user"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the user"
          },
          "email": {
            "type": "string",
            "description": "Email of the user"
          },
          "status": {
            "type": "string",
            "description": "User status. User's status is PENDING when a new user has been invited to a project and has not access Connect yet. Once the user has accessed Connect, the status becomes ACTIVE. REMOVED is a project specific status that is shown for users that have been removed from a project.",
            "enum": [
              "ACTIVE",
              "PENDING",
              "REMOVED"
            ]
          },
          "role": {
            "type": "string",
            "description": "Role of user (applicable only in context of a project)"
          },
          "viewerBackground": {
            "$ref": "#/components/schemas/ViewerBackground"
          },
          "timeZone": {
            "type": "string",
            "description": "Timezone preference of the user"
          },
          "title": {
            "type": "string",
            "description": "Title for the user"
          },
          "phone": {
            "type": "string",
