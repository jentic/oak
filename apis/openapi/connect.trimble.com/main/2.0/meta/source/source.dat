    "/files/{fileId}/permissions": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Get File Permissions",
        "description": "This API gives the access control lists (ACLs) that specify the permissions for users and groups associated with a specific file.",
        "operationId": "getFilePermissions",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilePermissionsDto"
                },
                "example": {
                  "acl": {
                    "READ": [
                      "users:f29a28a8-c4b5-483e-b7b9-071db660abb6"
                    ],
                    "FULL_ACCESS": [
                      "tc-groups:woC32em2Fb0",
                      "tc-groups:*"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Files"
        ],
        "summary": "Update File Permissions",
        "description": "This API is used to add new permissions or update/remove existing permissions for a particular file given as input.<br>If any permissions exist for any users/group, they are removed (reset) and permissions provided in the request body are applied.<br>Input can be an ACL comprising lists of users and groups, with permissions set to either READ or FULL_ACCESS.<br>If the project level setting 'fullAccessIncludesPermissions' is enabled, project users with non admin rights will be able to share files.<br>Additionally, if the project level setting 'allowNonMemberPermissions' is enabled, files can be shared outside project context.<br>To represent the virtual 'All Members' group, use 'tc-groups:*' in the ACL.",
        "operationId": "patchFilePermissions",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
