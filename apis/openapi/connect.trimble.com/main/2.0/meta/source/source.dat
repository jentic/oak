    "/views": {
      "get": {
        "tags": [
          "Views"
        ],
        "summary": "List all Views in a project",
        "description": "This API returns the list of views in a project based on either project Id or file Id using which views are created.",
        "operationId": "ListallViewsinaproject",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "Project Identifier",
            "required": true,
            "schema": {
              "type": "string",
              "example": "cFhCbaRN4t1"
            }
          },
          {
            "name": "fileId",
            "in": "query",
            "description": "ID of the file linked to the view. This is optional if projectId is provided, else required if versionId is specified. If fileId alone is passed, latest version of file is considered for listing views.",
            "schema": {
              "type": "string",
              "example": "4MUJs5SXO64"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "Id of specific version of the file. Optional only if fileId is passed.",
            "schema": {
              "type": "string",
              "example": "PdtcatZR266"
            }
          },
          {
            "name": "topicId",
            "in": "query",
            "description": "Id of the BCF topic in which views are embedded.This is optional, and if specified, only the embedded views in the topic are returned.",
            "schema": {
              "type": "string",
              "example": "6915bad3-f679-4ab8-8d08-51a06c44b040"
            }
          },
          {
            "name": "issueId",
            "in": "query",
            "description": "Id of the Issue in which views are embedded.This is optional, and if specified, only the embedded views in the issue are returned. Must be present if contextId is given.",
            "schema": {
              "type": "string",
              "example": "12f8a851-7f8e-42f1-a5e6-6f7c74415070"
            }
          },
          {
            "name": "contextId",
            "in": "query",
            "description": "The unique identifier of the context in TRN format (trn:2:tc:{us|eu|ap|ap-au}:projects:{projectId}:files:{fileId}). This is optional, and if specified, issueId must also be specified. Only the views in this context and embedded in the issue are returned.",
            "schema": {
              "type": "string",
              "example": "trn:2:tc:us:projects:Z5_UyWkNrmA:files:S4UmFiaKDxQ"
            }
          },
          {
            "name": "detail",
            "in": "query",
            "description": "If specified and true then full details will be returned for each view. Otherwise (by default) only minimum information about each view is returned. This parameter is recomended to be used to optimize the performance when listing all views in the project, so all views are listed with minimum details first and then when details are needed they are fetched individually for specific view.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "includeEmbedded",
            "in": "query",
            "description": "If specified and true then todo embedded views will be included in the response",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "includeTopicEmbedded",
            "in": "query",
            "description": "If specified and true then topic embedded views will be included in the response",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ViewDetailsResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Views"
        ],
        "summary": "Create View",
        "description": "API to create a view. Note that imageData has been truncated in the example below.\nView can be created on a project level or as view embedded to ToDo. For creating embedded view an todoId property must be given in the Request with valid existing ToDo identifier.\n**Note:** View models can span up to a limit of **`170`**.",
        "operationId": "CreateView",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateViewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/views/multiparts": {
      "post": {
        "tags": [
          "Views"
        ],
        "summary": "Create View with image",
        "description": "Create a view using form data. The form should have two fields; one named view which is the stringified view Json object, the other named imageData is the file to be used as thumbnail.\n\n**Note:** View models can span up to a limit of **`170`**.",
