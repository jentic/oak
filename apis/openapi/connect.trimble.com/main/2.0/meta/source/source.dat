      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Set Sync Settings",
        "description": "API to update Sync settings and Filters.\n\nFor filters, pass in the object as shown in the example request below. Required fields are \"id\" and \"checked\" flag to indicate if that filter is to be enabled or disabled.\n\nThe Filters field resets the filters and sets only the ones provided in the request",
        "operationId": "SetSyncSettings",
        "parameters": [],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetSyncSettingsrequest"
              },
              "example": {
                "projectId": "vGxx_WPD1G0",
                "allowAutoCheckout": true,
                "requireCheckoutForUpload": false,
                "requireCheckoutForUploadMakeReadonly": false,
                "filters": [
                  {
                    "id": "Dyfw481fE9U",
                    "checked": true
                  },
                  {
                    "id": "pNCBBwArq-g",
                    "checked": true
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSyncSettingsresponse"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
