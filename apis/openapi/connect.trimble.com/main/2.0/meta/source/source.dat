    "/projects/{projectId}/status": {
      "get": {
        "tags": [
          "Object Sync"
        ],
        "summary": "Get project content sync cursor.",
        "description": "Returns the project content sync cursor. This sync cursor is exected to be used together with the `ObjectSync` API to detect changes in the project content and do the incremental sync.",
        "operationId": "GetProjectSyncStatus",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "Id of the project to process",
            "required": true,
            "schema": {
              "type": "string",
              "example": "vGxx_WPD1G0"
            }
          },
          {
            "name": "encode",
            "in": "query",
            "description": "If false sync cursors for individual resource types are returned, otherwise a full encoded project sync cursor is returned. A full encoded project cursor is base64 encoded json object with all individual sync cursors.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "If-Modified-Since",
            "in": "header",
            "schema": {
              "type": "string",
              "format": "timestamp",
              "example": "Fri, 20 Nov 2015 20:07:45 GMT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The the project content sync cursor. If `encode` query parameter is `true` or missing only the `status` property is returned, otherwise response contains all individual sync cursors for all resource types. Content of individual resource cursors should not be interpreted by client in any way and used as an opaque string for equality operations only.",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Base64 url-safe encoded string representing the current state of the project content. Only this property is returned if encode query parameter is true or missing.",
                      "example": "eyJhbGciOiJIUzI1NiJ9.eyJleHAiOjE0NTY4ODY4MjUsInN1YiI6IlFRckxtak9qUm9ZIiwidXNlcklkIjoiTS1kV3VqSk5RWEEiLCJpc3MiOiInYXBpLmd0ZWFtLmNvbSciLCJqdGkiOiIxbl8wclV4aWUydyIsInNJZCI6Im1Nd1VadTNwZmNNIiwiaWF0IjoxNDU2ODU4MDI1fQ.7nTSr6Apzu0JeN7-_bl58fDyZ32Q_lL-uTK1wIOFQWg"
                    },
                    "projectId": {
                      "type": "string",
                      "description": "The project identifier."
                    },
                    "modifiedOn": {
                      "type": "string",
                      "description": "The time of latest change in the project content."
                    },
                    "projectMetadataTs": {
                      "type": "string",
                      "description": "The project descriptor sync cursor value."
                    },
                    "teamTs": {
                      "type": "string",
                      "description": "The project members sync cursor value."
                    },
                    "groupsTs": {
                      "type": "string",
                      "description": "The user groups sync cursor value."
                    },
                    "filesTs": {
                      "type": "string",
                      "deprecated": true,
                      "description": "The files sync cursor value."
                    },
                    "foldersTs": {
                      "type": "string",
                      "deprecated": true,
                      "description": "The folders sync cursor value."
                    },
                    "fsobjTs": {
                      "type": "string",
                      "description": "The combined files and folders sync cursor value."
                    },
                    "alignmentTs": {
                      "type": "string",
                      "description": "The model alignments sync cursor value."
                    },
                    "thumbnailTs": {
                      "type": "string",
                      "description": "The thumbnails sync cursor value."
                    },
                    "permissionsTs": {
                      "type": "string",
                      "description": "The file permissions sync cursor value."
                    },
                    "commentsTs": {
                      "type": "string",
                      "description": "The comments sync cursor value."
                    },
                    "tagTs": {
                      "type": "string",
                      "description": "The tags sync cursor value."
                    },
                    "todosTs": {
                      "type": "string",
                      "description": "The todos sync cursor value."
                    },
                    "releasesTs": {
                      "type": "string",
                      "description": "The releases sync cursor value."
                    },
                    "clashesTs": {
                      "type": "string",
                      "description": "The clashes sync cursor value."
                    },
                    "viewsTs": {
                      "type": "string",
                      "description": "The 3D views sync cursor value."
                    },
                    "views2dTs": {
                      "type": "string",
                      "description": "The 2D views sync cursor value."
                    },
                    "viewGroupsTs": {
                      "type": "string",
                      "description": "The 2D views sync cursor value."
                    },
                    "objectlinkTs": {
                      "type": "string",
                      "description": "The object links sync cursor value."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
