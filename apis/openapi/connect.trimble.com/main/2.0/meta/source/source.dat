      "ListItemsinaFolderResponseV21": {
        "title": "ListItemsinaFolderResponseV21",
        "required": [
          "id",
          "name",
          "type",
          "versionId",
          "parentId",
          "parentType",
          "createdBy",
          "modifiedBy",
          "projectId",
          "createdOn",
          "modifiedOn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": " Folder / File Identifier"
          },
          "name": {
            "type": "string",
            "description": "Name of the Folder / File"
          },
          "type": {
            "type": "string",
            "description": "Valid values are [\u2018FOLDER\u2019, \u2018FILE\u2019]"
          },
          "versionId": {
            "type": "string",
            "description": "revision Id of the Folder"
          },
          "parentId": {
            "type": "string",
            "description": "Identifier of the parent Folder. If not present, represents the root folder for the project"
          },
          "parentType": {
            "type": "string",
            "description": "Type of the parent.Valid Values are [\u2018FOLDER\u2019, \u2018TODO\u2019]"
          },
          "createdBy": {
            "$ref": "#/components/schemas/CreatedBy"
          },
          "createdOn": {
            "type": "string",
            "description": "(Timestamp) An ISO8601 date when the Folder or File was created"
          },
          "modifiedOn": {
            "type": "string",
            "description": "(Timestamp) An ISO8601 date when the Folder or File was modified"
          },
          "modifiedBy": {
            "$ref": "#/components/schemas/ModifiedBy"
          },
          "projectId": {
            "type": "string",
            "description": "Project Identifier"
          },
          "hasChildren": {
            "type": "boolean",
            "description": "Flag to determine if the folder has sub-folders"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "description": "Revision Number for file"
          },
          "thumbnailUrl": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "array of thumbnail urls"
          },
          "hash": {
            "type": "string",
            "description": "MD5 hash for the file contents"
          },
          "status": {
            "type": "string",
            "description": "Processing status of file.Valid values are [ \u2018PENDING\u2019,\u2018ON HOLD\u2019,\u2018DONE\u2019, \u2018CANCELLED\u2019, \u2018ERROR\u2019, \u2018PROCESSING\u2019]"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "size of Folder or File (in bytes)\n**Note:** This field is only included in the response if:\n1. The `fields` parameter includes `size`\n"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Path"
            },
            "description": "Path of the specific storage object\n**Note:** This field is only included in the response if:\n1. The `fields` parameter includes `path`\n"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags for the specific storage object\n**Note:** This field is only included in the response if:\n1. The `fields` parameter includes `tags`\n"
          },
          "_actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed actions for the specific user on the specific storage object\n**Note:** This field is only included in the response if:\n1. The `fields` parameter includes `_actions`\n",
            "enum": [
              "folder:Create",
              "folder:Delete",
              "folder:EditPermission",
              "folder:Get",
              "folder:GetPermission",
              "folder:List",
              "folder:Restore",
              "folder:Update",
              "file:Create",
              "file:Delete",
              "file:EditPermission",
              "file:Get",
              "file:GetPermission",
              "file:List",
              "file:Restore",
              "file:Update"
            ]
          }
        },
