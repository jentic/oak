                  "SNAPSHOT_DELETE",
                  "SNAPSHOT_UPDATE",
                  "SNAPSHOT_RENAME",
                  "SNAPSHOT_UPDATE_DESCRIPTION",
                  "VIEW2D_ADD",
                  "VIEW2D_ADD_IMPLICIT",
                  "VIEW2D_DELETE",
                  "VIEW2D_UPDATE",
                  "VIEW2D_ADD_ASSIGNEES",
                  "VIEW2D_REMOVE_ASSIGNEES",
                  "VIEW2D_RENAME",
                  "VIEW2D_UPDATE_DESCRIPTION",
                  "CLASH_ADD",
                  "CLASH_DELETE",
                  "RELEASE_CREATE",
                  "RELEASE_ADD_FILES",
                  "RELEASE_REMOVE_FILES",
                  "RELEASE_FILE_DOWNLOAD",
                  "RELEASE_SENT",
                  "RELEASE_DELETE",
                  "RELEASE_RENAME",
                  "RELEASE_EDIT_DUE_DATE",
                  "RELEASE_EDIT_NOTES",
                  "TODO_ADD",
                  "TODO_EDIT_DESCRIPTION",
                  "TODO_EDIT_DUE_DATE",
                  "TODO_EDIT_PERCENT_COMPLETE",
                  "TODO_EDIT_PRIORITY",
                  "TODO_EDIT_STATUS",
                  "TODO_EDIT_TITLE",
                  "TODO_EDIT_TYPE",
                  "TODO_EDIT",
                  "TODO_DELETE",
                  "TODO_ADD_FILES",
                  "TODO_REMOVE_FILES",
                  "TODO_ADD_SNAPSHOTS",
                  "TODO_REMOVE_SNAPSHOT",
                  "TODO_SNAPSHOT_UPDATE",
                  "TODO_ADD_VIEW2D",
                  "TODO_REMOVE_VIEW2D",
                  "TODO_VIEW2D_UPDATE",
                  "TODO_ADD_CLASH_ITEM",
                  "TODO_ADD_ASSIGNEES",
                  "TODO_REMOVE_ASSIGNEES",
                  "EXCEL_IMPORT_TODO",
                  "COMMENT_ADD",
                  "COMMENT_EDIT",
                  "COMMENT_DELETE",
                  "SHARE_ADD",
                  "SHARE_DELETE",
                  "SHARE_UPDATE_MODE",
                  "SHARE_UPDATE_MESSAGE",
                  "SHARE_UPDATE_NOTIFY",
                  "SHARE_UPDATE_EXPIRY_DATE",
                  "SHARE_UPDATE_PERMISSION",
                  "SHARE_UPDATE_LATEST_VERSION",
                  "PROJECT_RENAME",
                  "PROJECT_EDIT_DESCRIPTION",
                  "PROJECT_EDIT_END_DATE",
                  "PROJECT_EDIT_START_DATE",
                  "PROJECT_EDIT_ADDRESS",
                  "PROJECT_EDIT_CRS",
                  "TOPIC_CREATED",
                  "TOPIC_EDITED",
                  "TOPIC_DELETED",
                  "TOPIC_DOCREFS_ADDED",
                  "TOPIC_DOCREFS_REMOVED",
                  "TOPIC_VIEW_ADDED",
                  "TOPIC_VIEW_DELETED",
                  "TOPIC_COMMENT_ADDED",
                  "TOPIC_COMMENT_EDITED",
                  "TOPIC_COMMENT_DELETED"
                ],
                "description": "filter by activity action types. This cannot be used along with objectId/objectType filter."
              },
              "users": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Filter for activity created users by TID UUID"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": "tJ2lDVMEiOY"
                },
                "description": "Filter for groups of activity created users"
