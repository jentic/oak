      "ListItemsErrorResponseV21": {
        "type": "object",
        "title": "ListItemsErrorResponseV21",
        "description": "Standard error response format for List Items API",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code indicating the type of error",
            "example": "INVALID_ARGUMENTS",
            "enum": [
              "INVALID_ARGUMENTS",
              "UNAUTHORIZED",
              "INTERNAL_ERROR",
              "NOT_FOUND"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message providing details about the error",
            "example": "PageSize must be a positive integer between 1 and 500"
          }
        },
        "example": {
          "error": "INVALID_ARGUMENTS",
          "message": "PageSize must be a positive integer between 1 and 500"
        }
      },
      "FolderPermissionsResponse": {
        "title": "FolderPermissionsResponse",
        "required": [
          "defaultPermission",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "defaultPermission": {
            "type": "string",
            "enum": [
              "NO_ACCESS",
              "READ",
              "FULL_ACCESS"
            ],
            "description": "default access to the folder"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionResponse"
            },
            "description": ""
          }
        },
        "example": {
          "defaultPermission": "FULL_ACCESS",
          "permissions": [
            {
              "id": ":cu2mUJnneTc",
              "type": "USER",
              "name": "John Doe",
              "permission": "READ"
            },
            {
              "id": ":ZI5ok9YONOQ",
              "type": "GROUP",
              "name": "Group MEP",
              "permission": "NO_ACCESS"
            }
          ]
        }
      },
