    "/activities": {
      "get": {
        "tags": [
          "Activities"
        ],
        "summary": "List Activities of a Project / Object",
        "description": "API to list the activities in a project / specific object",
        "operationId": "ListActivitiesofaProject/Object",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "ID of the Project, if present lists all activities with in the project. Optional if objectId is present, else required",
            "required": true,
            "schema": {
              "type": "string",
              "example": "woC32em2Fb0"
            }
          },
          {
            "name": "objectId",
            "in": "query",
            "description": "ID of the Object, if present lists all activities associated with the object. Optional if projectId is present, else required.",
            "schema": {
              "type": "string",
              "example": "q-XKNAhg3Rk"
            }
          },
          {
            "name": "objectType",
            "in": "query",
            "description": "objectType  of `objectId`. **If objectId is specified, objectType  is required**. (Supported values : `PROJECT`, `VIEW`, `CLASH`, `RELEASE`, `COMMENT`, `FOLDER`, `FILE`, `TODO`, `VIEW2D`, `USER`)",
            "schema": {
              "type": "string",
              "example": "RELEASE"
            }
          },
          {
            "name": "filters",
            "in": "query",
            "description": "It supports either comma separated objectTypes or a single objectType as input and would return the related activities of the specified objectType. Query param should be either filters or a combination of objectId and objectType. Both filters and a combination of objectId and objectType cannot be provided via a single request. When a single objectType(`FILE`) is provided, activities related to `FILE` objectType would be returned. When multiple comma separated objectType's(`FILE,FOLDER,TODO`) are provided, activities related to `FILE`,`FOLDER` and `TODO` would be returned.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "singleObjectType": {
                "value": "FILE"
              },
              "multipleObjectType": {
                "value": "FILE,FOLDER,TODO"
              }
            }
          },
          {
            "name": "lastId",
            "in": "query",
            "description": "Activity Id, if it is passed the api collects the list of activities next to the given activity id",
            "schema": {
              "type": "string",
              "example": "zIn1S6j0yww"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityDetailsResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
