{
  "openapi": "3.0.3",
  "info": {
    "title": "MISP API",
    "version": "2.4.0",
    "description": "The MISP (Malware Information Sharing Platform) API provides programmatic access to threat intelligence data including events, attributes, objects, galaxies, tags, feeds, organisations, users, and sharing groups. MISP is an open-source threat intelligence platform.",
    "x-jentic-source-url": "https://www.misp-project.org/"
  },
  "servers": [{ "url": "https://misp.local" }],
  "paths": {
    "/events/restSearch": { "post": { "operationId": "searchEvents", "summary": "Search events", "description": "Get filtered/paginated events (recommended method)", "tags": ["Events"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchFilter" } } } }, "responses": { "200": { "description": "Successful response", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } } } } }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/events": { "get": { "operationId": "listEvents", "summary": "List events", "tags": ["Events"], "responses": { "200": { "description": "Successful response", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } } } } }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/events/add": { "post": { "operationId": "createEvent", "summary": "Create event", "tags": ["Events"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventInput" } } } }, "responses": { "200": { "description": "Event created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } } }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/events/view/{eventId}": { "get": { "operationId": "getEvent", "summary": "Get event by ID", "tags": ["Events"], "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } } }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/events/edit/{eventId}": { "put": { "operationId": "updateEvent", "summary": "Edit event", "tags": ["Events"], "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventInput" } } } }, "responses": { "200": { "description": "Event updated" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/events/delete/{eventId}": { "delete": { "operationId": "deleteEvent", "summary": "Delete event", "tags": ["Events"], "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Event deleted" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/events/publish/{eventId}": { "post": { "operationId": "publishEvent", "summary": "Publish event", "tags": ["Events"], "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Event published" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/attributes/restSearch": { "post": { "operationId": "searchAttributes", "summary": "Search attributes", "tags": ["Attributes"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchFilter" } } } }, "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/attributes/add/{eventId}": { "post": { "operationId": "addAttribute", "summary": "Add attribute to event", "tags": ["Attributes"], "parameters": [{ "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttributeInput" } } } }, "responses": { "200": { "description": "Attribute added" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/attributes/edit/{attributeId}": { "put": { "operationId": "editAttribute", "summary": "Edit attribute", "tags": ["Attributes"], "parameters": [{ "name": "attributeId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttributeInput" } } } }, "responses": { "200": { "description": "Attribute updated" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/attributes/delete/{attributeId}": { "delete": { "operationId": "deleteAttribute", "summary": "Delete attribute", "tags": ["Attributes"], "parameters": [{ "name": "attributeId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Attribute deleted" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/tags": { "get": { "operationId": "listTags", "summary": "List tags", "tags": ["Tags"], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/tags/add": { "post": { "operationId": "createTag", "summary": "Create tag", "tags": ["Tags"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "colour": { "type": "string" } } } } } }, "responses": { "200": { "description": "Tag created" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/galaxies": { "get": { "operationId": "listGalaxies", "summary": "List galaxies", "tags": ["Galaxies"], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/galaxies/view/{galaxyId}": { "get": { "operationId": "getGalaxy", "summary": "Get galaxy", "tags": ["Galaxies"], "parameters": [{ "name": "galaxyId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/organisations": { "get": { "operationId": "listOrganisations", "summary": "List organisations", "tags": ["Organisations"], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/organisations/view/{organisationId}": { "get": { "operationId": "getOrganisation", "summary": "Get organisation", "tags": ["Organisations"], "parameters": [{ "name": "organisationId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/admin/users": { "get": { "operationId": "listUsers", "summary": "List users", "tags": ["Users"], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/admin/users/add": { "post": { "operationId": "createUser", "summary": "Add user", "tags": ["Users"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "email": { "type": "string" }, "org_id": { "type": "string" }, "role_id": { "type": "string" } } } } } }, "responses": { "200": { "description": "User created" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/feeds": { "get": { "operationId": "listFeeds", "summary": "List feeds", "tags": ["Feeds"], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/feeds/add": { "post": { "operationId": "createFeed", "summary": "Add feed", "tags": ["Feeds"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "Feed added" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/sharing_groups": { "get": { "operationId": "listSharingGroups", "summary": "List sharing groups", "tags": ["Sharing Groups"], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/servers/getVersion": { "get": { "operationId": "getVersion", "summary": "Get MISP version", "tags": ["Servers"], "responses": { "200": { "description": "Version info" }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/sightings/add/{attributeId}": { "post": { "operationId": "addSighting", "summary": "Add sighting", "tags": ["Sightings"], "parameters": [{ "name": "attributeId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Sighting added" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } },
    "/warninglists": { "get": { "operationId": "listWarninglists", "summary": "List warninglists", "tags": ["Warninglists"], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } } }
  },
  "components": {
    "schemas": {
      "Event": { "type": "object", "properties": { "id": { "type": "string" }, "info": { "type": "string" }, "date": { "type": "string", "format": "date" }, "threat_level_id": { "type": "string" }, "analysis": { "type": "string" }, "distribution": { "type": "string" }, "published": { "type": "boolean" }, "org_id": { "type": "string" }, "timestamp": { "type": "string" } } },
      "EventInput": { "type": "object", "properties": { "info": { "type": "string" }, "date": { "type": "string", "format": "date" }, "threat_level_id": { "type": "string" }, "analysis": { "type": "string" }, "distribution": { "type": "string" }, "published": { "type": "boolean" } } },
      "AttributeInput": { "type": "object", "properties": { "type": { "type": "string" }, "category": { "type": "string" }, "value": { "type": "string" }, "to_ids": { "type": "boolean" }, "distribution": { "type": "string" }, "comment": { "type": "string" } } },
      "SearchFilter": { "type": "object", "properties": { "value": { "type": "string" }, "type": { "type": "string" }, "category": { "type": "string" }, "org": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" }, "last": { "type": "string" }, "published": { "type": "boolean" }, "limit": { "type": "integer" }, "page": { "type": "integer" } } },
      "ErrorResponse": { "type": "object", "properties": { "name": { "type": "string" }, "message": { "type": "string" }, "url": { "type": "string" } } }
    },
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "name": "Authorization", "in": "header", "description": "MISP API key" }
    }
  },
  "security": [{ "apiKey": [] }]
}