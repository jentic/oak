{
  "openapi": "3.0.3",
  "info": {
    "title": "MyMemory Translation API",
    "description": "MyMemory is a free translation memory and machine translation API. It provides translations from a large collaborative translation memory with over 1 billion segments, combined with machine translation fallback. The free tier allows 1000 words/day without signup; providing a contact email or an API key raises limits and unlocks private translation memory features.",
    "version": "1.0.0",
    "contact": {
      "name": "Translated",
      "url": "https://mymemory.translated.net"
    },
    "x-jentic-source-url": "https://mymemory.translated.net/doc/spec.php"
  },
  "servers": [
    {
      "url": "https://api.mymemory.translated.net",
      "description": "MyMemory production server"
    }
  ],
  "paths": {
    "/get": {
      "get": {
        "operationId": "translate",
        "summary": "Translate text",
        "description": "Translate a text segment from source to target language. Returns translation memory matches and machine translation results. Works without authentication (1000 words/day); supplying an API key returns private TM matches.",
        "security": [
          {},
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 500
            },
            "description": "Source text to translate. UTF-8 encoded, max 500 bytes."
          },
          {
            "name": "langpair",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Source and target language separated by pipe. ISO language codes (e.g. en|it, en|fr, de|en)."
          },
          {
            "name": "mt",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 1
            },
            "description": "Enable machine translation in results. 1 = enabled (default), 0 = disabled."
          },
          {
            "name": "onlyprivate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            },
            "description": "When authenticated, return only private TM matches. Default: 0."
          },
          {
            "name": "de",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Valid contact email for troubleshooting and higher rate limits."
          }
        ],
        "responses": {
          "200": {
            "description": "Translation results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/set": {
      "get": {
        "operationId": "contributeTranslation",
        "summary": "Contribute a translation",
        "description": "Add a translation segment to MyMemory. Without a key, the contribution is public; with a key, it goes to your private TM only.",
        "security": [
          {},
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "seg",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Source language sentence. UTF-8 encoded."
          },
          {
            "name": "tra",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Target language translation. UTF-8 encoded."
          },
          {
            "name": "langpair",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Source and target language separated by pipe (e.g. en|it)."
          },
          {
            "name": "de",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Valid contact email for troubleshooting."
          }
        ],
        "responses": {
          "200": {
            "description": "Contribution accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "responseStatus": {
                      "type": "integer"
                    },
                    "responseData": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/subjects": {
      "get": {
        "operationId": "listSubjects",
        "summary": "List available subjects",
        "description": "Returns the list of available subjects for querying and TM importing.",
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "List of subjects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "subjects": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "responseStatus": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "Optional MyMemory API key passed as the 'key' query parameter. When provided, requests access private translation memory matches and higher rate limits. Not required for basic use."
      }
    },
    "schemas": {
      "TranslationResponse": {
        "type": "object",
        "properties": {
          "responseData": {
            "type": "object",
            "properties": {
              "translatedText": {
                "type": "string",
                "description": "Best translation result."
              },
              "match": {
                "type": "number",
                "description": "Match quality score (0.0 to 1.0)."
              }
            }
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "segment": {
                  "type": "string"
                },
                "translation": {
                  "type": "string"
                },
                "quality": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "usage-count": {
                  "type": "integer"
                },
                "subject": {
                  "type": "string"
                },
                "created-by": {
                  "type": "string"
                },
                "last-updated-by": {
                  "type": "string"
                },
                "create-date": {
                  "type": "string"
                },
                "last-update-date": {
                  "type": "string"
                },
                "match": {
                  "type": "number"
                }
              }
            }
          },
          "responseStatus": {
            "type": "integer"
          }
        }
      }
    }
  },
  "security": [
    {},
    {
      "ApiKeyAuth": []
    }
  ]
}