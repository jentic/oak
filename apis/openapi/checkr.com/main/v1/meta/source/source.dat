    "/reports": {
      "post": {
        "description": "Creates a new Report resource.\n\n<b>Notes: </b>\n- This resource does not support the creation of reports which include international Packages. Use the [`/invitations` API](#tag/invitations) to order these reports.\n- Employment Verifications, Education Verifications, and Credit Checks may not be initiated using the `/reports` API. Please use the [`/invitations` API](#tag/invitations) to initiate the [Checkr-Hosted Apply Flow](/#section/Getting-Started/Create-an-Invitation) when ordering background checks that include any of these screening types.\n- Creating a Report which includes an Occupational Health or Drug\nCheck will automatically issue an email invitation to the candidate to schedule their appointment at a clinic of their choice.\n",
        "operationId": "createReport",
        "requestBody": {
          "$ref": "#/components/requestBodies/ReportCreate"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ReportCreated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/PackageNotFoundError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Create a new Report",
        "tags": [
          "Reports"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/reports \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n    -d package=driver_pro \\\n    -d candidate_id=e44aa283528e6fde7d542194\n"
          }
        ]
      }
    },
    "/reports/{id}": {
      "get": {
        "description": "Returns an existing Report with the input ID.\n",
        "operationId": "getReport",
        "parameters": [
