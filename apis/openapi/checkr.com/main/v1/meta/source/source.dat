          {
            "description": "Returns all Geos with the input state.",
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Specifies the page number to retrieve.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "number"
            }
          },
          {
            "description": "Indicates how many records each page should contain. The default value is 25 records.",
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GeosList"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
