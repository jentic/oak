          }
        },
        "type": "object"
      },
      "Charge": {
        "properties": {
          "arrest_date": {
            "example": null,
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "assessment": {
            "example": null,
            "type": "string"
          },
          "category": {
            "description": "The Checkr Assess category assigned to this criminal charge. This field will be included only if Checkr Assess is enabled for your account.\n",
            "enum": [
              "criminal_intent",
              "drugs_and_alcohol",
              "fraud_and_deception",
              "homicide",
              "security",
              "sexual",
              "statutory",
              "theft_and_property",
              "unclassified",
              "vehicles_and_traffic",
              "violence"
            ],
            "example": "fraud_and_deception",
            "type": "string"
          },
          "charge": {
            "example": "Fraud",
            "type": "string"
          },
          "charge_date": {
            "example": null,
            "format": "date",
            "nullable": true,
            "type": "string"
