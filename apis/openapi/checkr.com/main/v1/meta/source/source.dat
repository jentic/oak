    "/candidates/{id}": {
      "get": {
        "description": "Retrieves an existing Candidate.\n",
        "operationId": "getCandidate",
        "parameters": [
          {
            "description": "Comma delimited string specifying the resources to be embedded in the returned Candidate object. See [Embedding Resources](#section/Reference/Embedding-Resources).",
            "example": "reports,geos",
            "in": "query",
            "name": "include",
            "required": false,
            "schema": {
              "enum": [
                "reports",
                "geos"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Candidate"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Retrieve an existing Candidate",
        "tags": [
          "Candidates"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X GET https://api.checkr.com/v1/candidates/e44aa283528e6fde7d542194 \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9:\n"
          },
          {
            "lang": "curl",
            "source": "$ curl -X GET https://api.checkr.com/v1/candidates/e44aa283528e6fde7d542194?include=reports \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9:\n"
          }
        ]
      },
      "parameters": [
        {
          "description": "The Candidate's ID.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Updates an existing Candidate.\n\nAttempts to update a field that cannot be updated will return a 400 error stating \"... cannot be updated\u201d. For example, attempting to update an SSN will return 400 stating \"Candidate SSN can not be updated because it has reports\u201d. \n\nUpdating `geo_ids` will **replace** all existing Geos. To keep existing geos, include their IDs in the update request. `geo_ids` cannot be updated if the candidate's work location is outside the US.\nOnly fields with `null` values can be updated after a Report has been ordered for a Candidate with the exception of the following fields:\n- email\n- phone\n- previous_driver_license_number\n- previous_driver_license_state\n- copy_requested\n- custom_id\n- geo_ids\n\nUpdating metadata with an empty value (null or empty object) will delete existing metadata. Individual keys may also be set and unset.\n- Adding a new key-value pair will maintain all existing key-value pairs.\n- Providing a new value for an existing key will update the old value to the new value.\n- Providing an empty value for an existing key will remove that key from the metadata object.\n- When all keys in the metadata object have empty values, the object will be deleted.\n",
        "operationId": "updateCandidate",
        "requestBody": {
          "$ref": "#/components/requestBodies/CandidatePatch"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/CandidateUpdated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Update an existing Candidate",
        "tags": [
          "Candidates"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/candidates/e44aa283528e6fde7d542194 \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n    -d first_name=John \\\n    -d middle_name=Alfred \\\n    -d last_name=Smith \\\n    -d email=john.smith@gmail.com \\\n    -d phone=5555555555 \\\n    -d zipcode=90401 \\\n    -d dob=1970-01-22 \\\n    -d ssn=543-43-4645 \\\n    -d 'geo_ids[]=87f5bb4983eade22c55f4731&geo_ids[]=22b20140fc1adfae693ca35c'\n"
          }
        ]
      }
    },
