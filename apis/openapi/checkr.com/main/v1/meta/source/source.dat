              "result": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ScreeningResult"
                  },
                  {
                    "example": "consider"
                  }
                ]
              },
              "status": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ScreeningStatus"
                  },
                  {
                    "example": "complete"
                  }
                ]
              },
              "turnaround_time": {
                "example": 90
              },
              "uri": {
                "example": "/v1/global_watchlist_searches/539fd88c101897f7cd000008"
              }
            },
            "type": "object"
          }
        ]
      },
      "HierarchyNode": {
        "properties": {
          "custom_id": {
            "description": "Customer-defined unique ID for the node. Must be unique within your account. <b>Note: </b>Custom IDs may contain only letters, numbers, spaces, hyphens, colons, ampersands, and/or underscores.",
            "example": "zpy8orej4r614ize",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "description": "The name for the node. This name will be displayed in the Checkr Dashboard.",
            "example": "Acme Staffing",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "packages": {
            "description": "List of slugs for packages that are visible to this node (through either direct assignment to the node, or assignment to one of the node's ancestors). Only provided if \"include=packages\" is included in the query.",
            "example": [
              "driver_pro",
              "tasker_pro"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parent_custom_id": {
            "description": "The `custom_id` for the parent of this node. If not provided, this node will be placed at the top level of the hierarchy. <b>Note: </b>If provided, this node must be a valid and previously loaded `custom_id`, and may contain only letters, numbers, spaces, hyphens, colons, ampersands, and/or underscores.",
            "example": "parent custom id",
            "maxLength": 255,
            "type": "string"
          },
          "tier": {
            "description": "Customer-defined label for this level of the hierarchy. (For example \"Department\" or \"Division\".)",
            "example": "department",
            "maxLength": 255,
            "type": "string"
          }
        },
        "required": [
          "name",
          "custom_id"
        ],
        "type": "object"
      },
      "HierarchyNotEnabledError": {
        "properties": {
          "error": {
            "example": "Sorry, your account is not enabled for Hierarchy",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HierarchyNotFoundError": {
        "properties": {
          "error": {
            "example": "No hierarchy exists on account, or hierarchy ingestion is in progress",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HierarchyTree": {
        "properties": {
          "children": {
            "description": "List of child hierarchy trees with name, custom_id, tier and their children",
            "items": {
              "$ref": "#/components/schemas/HierarchyTree"
            },
            "type": "array"
          },
          "custom_id": {
            "description": "Customer-defined unique ID for the node. Must be unique within your account.",
            "example": "zpy8orej4r614ize",
            "type": "string"
          },
          "name": {
            "description": "The name for the node. This name will be displayed in the Checkr Dashboard.",
            "example": "Acme Staffing",
            "type": "string"
          },
          "tier": {
            "description": "Customer-defined label for this level of the hierarchy. (For example \"Department\" or \"Division\")",
            "example": "department",
            "type": "string"
          }
        },
        "required": [
          "name",
          "custom_id"
        ],
        "type": "object"
      },
      "IncludesCanceledBoolean": {
        "description": "If account has opted in to report lifecycle phase two, indicates the presence of canceled histories. Otherwise, `null`.",
        "enum": [
          true,
          false
        ],
        "nullable": true,
        "type": "boolean"
      },
      "IngestionInProgressError": {
        "properties": {
          "error": {
            "example": "Ingestion is already in progress",
            "type": "string"
          }
        },
        "type": "object"
      },
      "InternationalAddress": {
