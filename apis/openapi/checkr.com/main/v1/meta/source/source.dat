{
  "components": {
    "requestBodies": {
      "AccountCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "client_id": {
                  "description": "Client credentials provided as part of your Partner Application.",
                  "example": "56269e3411a549fd07ed8d92",
                  "type": "string"
                },
                "company": {
                  "properties": {
                    "city": {
                      "description": "City where company is headquartered.",
                      "example": "San Francisco",
                      "type": "string"
                    },
                    "dba_name": {
                      "description": "Name of Company displayed in Checkr emails and branded web pages.",
                      "example": "Acme",
                      "nullable": true,
                      "type": "string"
                    },
                    "incorporation_state": {
                      "description": "State where company is incorporated. Format: `ISO 3166-2:US`.\n",
                      "example": "CA",
                      "nullable": true,
                      "type": "string"
                    },
                    "incorporation_type": {
                      "description": "Type of incorporation.",
                      "enum": [
                        "association",
                        "co-ownership",
                        "corporation",
                        "joint-venture",
                        "limited-partnership",
                        "llc",
                        "llp",
                        "non-profit",
                        "partnership",
                        "s-corporation",
                        "sp",
                        "trusteeship"
                      ],
                      "type": "string"
                    },
                    "industry": {
                      "description": "Industry that company operates in. Format: `NAICS 2017 Code`.\n",
                      "example": "72",
                      "nullable": true,
                      "type": "string"
                    },
                    "phone": {
                      "description": "Company phone number.",
                      "example": "206-555-0100",
                      "nullable": true,
                      "type": "string"
                    },
                    "state": {
                      "description": "State where company is headquartered. Format: `ISO 3166-2:US`.\n",
                      "example": "CA",
                      "type": "string"
                    },
                    "street": {
                      "description": "Street address where company is headquartered.",
                      "example": "123 Main Street",
                      "type": "string"
                    },
                    "tax_id": {
                      "description": "Company Tax ID number.",
                      "example": "123456789",
                      "type": "string"
                    },
                    "website": {
                      "description": "Company website.",
                      "example": "https://www.example.com",
                      "nullable": true,
                      "type": "string"
                    },
                    "zipcode": {
                      "description": "Zipcode where company is headquartered.",
                      "example": "94107",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "default_compliance_city": {
                  "description": "Fallback compliance city if candidate location is not provided.\n",
                  "example": "San Francisco",
                  "nullable": true,
                  "type": "string"
                },
                "default_compliance_state": {
                  "description": "Fallback compliance state if candidate location is not provided. Format: `ISO 3166-2:US`.\n",
                  "example": "CA",
                  "nullable": true,
                  "type": "string"
                },
                "name": {
                  "description": "Name of Account displayed in the Dashboard.",
                  "example": "Acme Corporation",
                  "type": "string"
                },
                "oauth_authorize": {
                  "default": false,
                  "description": "Allows skipping of the /oauth/authorize call",
                  "type": "boolean"
                },
                "purpose": {
                  "description": "Permissible purpose to run background checks. Determines which background checks the Account is credentialed for.\n",
                  "enum": [
                    "employment",
                    "business",
                    "insurance",
                    "tenant"
                  ],
                  "example": "employment",
                  "type": "string"
                },
                "user": {
                  "properties": {
                    "email": {
                      "description": "Email of the initial Admin user for the Account.",
                      "example": "user@example.com",
                      "type": "string"
                    },
                    "full_name": {
                      "description": "Full name of the initial Admin user for the Account.",
                      "example": "Jeanette Hughes",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "client_id",
                "name",
                "purpose",
                "user",
                "company"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "AdverseActionCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "adverse_item_ids": {
                  "description": "IDs of Adverse Items selected for the Adverse Action.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "medium": {
                  "description": "The medium through which the Adverse Action notification should be sent.\n",
                  "properties": {
                    "email": {
                      "description": "The email medium is used to send an adverse action via email to the candidate.\n",
                      "properties": {
                        "priority": {
                          "description": "The priority setting dictates whether the adverse action should be sent through this medium. A priority of 1 means the adverse action will be sent, while a priority of 0 means it will not be sent through this medium.",
                          "example": 1,
                          "type": "number"
                        },
                        "required": {
                          "description": "The \"required\" setting specifies whether an adverse action must be sent. If set to true, it means the adverse action must be sent through this medium. If set to false, sending the adverse action through this medium is optional.",
                          "example": true,
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    },
                    "postal": {
                      "description": "The postal medium is used to send an adverse action via physical mail to the candidate.\n",
                      "properties": {
                        "priority": {
                          "description": "The priority setting dictates whether the adverse action should be sent through this medium. A priority of 1 means the adverse action will be sent, while a priority of 0 means it will not be sent through this medium.",
                          "example": 0,
                          "type": "number"
                        },
                        "required": {
                          "description": "The \"required\" setting specifies whether an adverse action must be sent. If set to true, it means the adverse action must be sent through this medium. If set to false, sending the adverse action through this medium is optional.",
                          "example": false,
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "post_notice_scheduled_at": {
                  "description": "Time at which the Post-Adverse Action notification will be sent. Default is 7 days after creation.",
                  "example": "2016-10-07T12:34:00Z",
                  "format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "adverse_item_ids"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "CandidateCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "copy_requested": {
                  "default": false,
                  "description": "If `true`, the candidate has asked to receive a copy of their report.",
                  "type": "boolean"
                },
                "custom_id": {
                  "description": "Client-assigned unique ID for the Candidate. Can be used to map Checkr Candidate IDs to your internal tracking system, and to search for Candidates through both the Dashboard and the API.",
                  "example": "HRIS-27",
                  "type": "string"
                },
                "dob": {
                  "description": "Candidate\u2019s date of birth.",
                  "example": "1970-01-22",
                  "format": "date",
                  "type": "string"
                },
                "driver_license_number": {
                  "description": "Candidate\u2019s driver license number.",
                  "example": "F2111655",
                  "type": "string"
                },
                "driver_license_state": {
                  "description": "Candidate\u2019s driver license state of issue.\nFormat: `ISO 3166-2:US`.\n",
                  "example": "CA",
                  "type": "string"
                },
                "email": {
                  "description": "Candidate\u2019s email address.\n",
                  "example": "john.smith@gmail.com",
                  "format": "email",
                  "type": "string"
                },
                "first_name": {
                  "description": "Candidate\u2019s first name.\n",
                  "example": "John",
                  "pattern": "^(?=.*[a-zA-Z\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff])[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]*$",
                  "type": "string"
                },
                "geo_ids": {
                  "description": "Array of Geo IDs.",
                  "items": {
                    "example": "79f943e212cce7de21c054a8",
                    "type": "string"
                  },
                  "type": "array"
                },
                "last_name": {
                  "description": "Candidate\u2019s last name.",
                  "example": "Smith",
                  "pattern": "[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]{2,}",
                  "type": "string"
                },
                "metadata": {
                  "$ref": "#/components/schemas/Metadata"
                },
                "middle_name": {
                  "description": "Candidate\u2019s middle name. This field is required if `no_middle_name` is `false`.\n",
                  "example": "Alfred",
                  "pattern": "[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]*",
                  "type": "string"
                },
                "mother_maiden_name": {
                  "description": "Candidate\u2019s mother\u2019s maiden name.\n",
                  "example": "Jones",
                  "pattern": "[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]*",
                  "type": "string"
                },
                "no_middle_name": {
                  "default": false,
                  "description": "Required if no `middle_name` is provided. `true` if the candidate has no middle name.\n",
                  "type": "boolean"
                },
                "object": {
                  "enum": [
                    "candidate"
                  ],
                  "readOnly": true,
                  "type": "string"
                },
                "phone": {
                  "description": "Candidate\u2019s phone number.",
                  "example": 5555555555,
                  "nullable": true,
                  "type": "string"
                },
                "postal_address": {
                  "description": "The candidate postal address is the address Checkr will use to send postal mail to the candidate. Each candidate can be associated with only one postal address.",
                  "example": {
                    "city": "San Francisco",
                    "name": "John Alfred Smith",
                    "state": "CA",
                    "street": "123 Main Street",
                    "street2": "APT A",
                    "zipcode": "94108"
                  },
                  "type": "object"
                },
                "previous_driver_license_number": {
                  "description": "Candidate\u2019s previous driver license number.",
                  "example": "F1501739",
                  "type": "string"
                },
                "previous_driver_license_state": {
                  "description": "State that issued the candidate\u2019s previous driver license.\nFormat: `ISO 3166-2:US`.\n",
                  "example": "MD",
                  "type": "string"
                },
                "report_ids": {
                  "description": "Array of Report IDs.",
                  "items": {
                    "example": "532e71cfe88a1d4e8d00000d",
                    "type": "string"
                  },
                  "readOnly": true,
                  "type": "array"
                },
                "ssn": {
                  "description": "Candidate\u2019s Social Security Number. This value will be redacted in all return calls, except for the last four digits.",
                  "example": "XXX-XX-4645",
                  "type": "string"
                },
                "work_locations": {
                  "description": "<font color=\"red\">Required</font> for non-US candidates.\n\nArray of locations described using country, state, and city. When country is not specified defaults to US. State is required for US candidates. Country is required for non-US candidates.\n",
                  "items": {
                    "$ref": "#/components/schemas/WorkLocation"
                  },
                  "type": "array"
                },
                "zipcode": {
                  "description": "Candidate\u2019s 5-digit zip code.",
                  "example": 90401,
                  "type": "string"
                }
              },
              "required": [
                "email"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "CandidatePatch": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Candidate"
            }
          }
        },
        "required": true
      },
      "CandidatePiiRemoval": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "deletion_contact_email_address": {
                  "description": "Email address of person requesting candidate's PII removal.",
                  "example": "john.smith@gmail.com",
                  "type": "string"
                },
                "deletion_contact_first_name": {
                  "description": "First name of person requesting candidate's PII removal.",
                  "example": "John",
                  "type": "string"
                },
                "deletion_contact_last_name": {
                  "description": "Last name of person requesting candidate's PII removal.",
                  "example": "Smith",
                  "type": "string"
                }
              },
              "required": [
                "deletion_contact_email_address"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "CandidatePostalAddressCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "city": {
                  "description": "City of the Candidate.\n",
                  "example": "Santa Monica",
                  "type": "string"
                },
                "name": {
                  "description": "Name of the Candidate.\n",
                  "example": "John Smith",
                  "type": "string"
                },
                "object": {
                  "enum": [
                    "postal_address"
                  ],
                  "readOnly": true,
                  "type": "string"
                },
                "state": {
                  "description": "State of the Candidate.\n",
                  "example": "CA",
                  "type": "string"
                },
                "street": {
                  "description": "Street address of the Candidate.\n",
                  "example": "123 Main St",
                  "type": "string"
                },
                "street2": {
                  "description": "Additional street address of the Candidate.\n",
                  "example": "Apt A",
                  "nullable": true,
                  "type": "string"
                },
                "zipcode": {
                  "description": "5-digit zip code of the Candidate.\n",
                  "example": "90401",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "street",
                "city",
                "state",
                "zipcode"
              ],
              "type": "object"
            }
          }
        }
      },
      "CandidateStoryCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "content": {
                  "description": "Additional information provided by Candidate.",
                  "example": "Since my case, I have received the following certifications (see attachments)",
                  "type": "string"
                },
                "documents": {
                  "description": "An array of documents to attach to the Candidate Story. Can be empty.",
                  "items": {
                    "properties": {
                      "filename": {
                        "description": "File name",
                        "example": "evidence_of_rehab.pdf",
                        "type": "string"
                      },
                      "tempfile": {
                        "description": "Accessible resource from which the document will be copied.",
                        "example": "https://tempfilebucket.aws.example.com/abYwtudnakfnafl",
                        "type": "string"
                      },
                      "type": {
                        "description": "Document MIME type",
                        "enum": [
                          "application/pdf",
                          "image/bmp",
                          "image/gif",
                          "image/heic",
                          "image/jpeg",
                          "image/jpg",
                          "image/png",
                          "image/tiff"
                        ],
                        "example": "application/pdf",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "record_id": {
                  "description": "ID of the Record existing on a Screening to which the Candidate Story is linked.\nWhen no record ID is provided, the Candidate Story is considered General Information.\n",
                  "example": "af3393b7d751206c7c67b6e5",
                  "type": "string"
                }
              },
              "required": [
                "content",
                "documents"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "ContinuousCheckCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "node": {
                  "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts with Nodes.\n\n`custom_id` of the associated node.\n",
                  "type": "string"
                },
                "type": {
                  "description": "Defines the screening type(s) for this Continuous Check.",
                  "enum": [
                    "criminal",
                    "mvr"
                  ],
                  "example": "criminal",
                  "type": "string"
                },
                "work_locations": {
                  "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts.\n\nArray of locations described using country, state, and city. When country is not specified defaults to US. State is required for US candidates. Country is required for non-US candidates.\n",
                  "items": {
                    "$ref": "#/components/schemas/WorkLocation"
                  },
                  "type": "array"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "ContinuousCheckUpdate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "node": {
                  "description": "`custom_id` of the associated node.\n",
                  "type": "string"
                },
                "work_locations": {
                  "description": "Array of locations described using country, state, and city. When country is not specified defaults to US. State is required for US candidates. Country is required for non-US candidates.\n",
                  "items": {
                    "$ref": "#/components/schemas/WorkLocation"
                  },
                  "type": "array"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "DocumentUpload": {
        "content": {
          "multipart/form-data": {
            "encoding": {
              "file": {
                "contentType": "image/gif, image/jpg, image/jpeg, image/png, image/bmp, image/tiff, application/pdf, image/heic"
              }
            },
            "schema": {
              "properties": {
                "file": {
                  "description": "Path to the document on your local file system.\n\nValid MIME types: `image/gif`, `image/jpg`, `image/jpeg`, `image/png`, `image/bmp`, `image/tiff`, `application/pdf`, `image/heic`.\n",
                  "format": "binary",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "alien_id",
                    "citizenship_certificate",
                    "consent",
                    "credit_report_consent_form",
                    "degree",
                    "diploma",
                    "driver_license",
                    "driver_license_back",
                    "driver_license_history",
                    "education_certificate",
                    "education_proof",
                    "electronic_consent_form",
                    "employment_proof",
                    "government_id",
                    "international_consent_form",
                    "military_id",
                    "national_id",
                    "national_id_back",
                    "passport",
                    "passport_signature_page",
                    "paystub",
                    "previous_driver_license",
                    "professional_license_certification_image",
                    "selfie",
                    "ssn_card",
                    "state_id_card",
                    "state_id_card_back",
                    "student_id",
                    "tax_form1099",
                    "tax_form_schedule_c",
                    "tax_form_w2",
                    "taxpayer_id",
                    "transcript"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "file",
                "type"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "DriverLicenseCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "current": {
                  "description": "Defines whether the driver license is the candidate's current license. `true` if the license is the candidate's current license, `false` otherwise.",
                  "type": "boolean"
                },
                "issued_date": {
                  "description": "The issued date of the driver license.",
                  "example": "2010-01-30",
                  "format": "date",
                  "type": "string"
                },
                "number": {
                  "description": "The driver license number.",
                  "example": "F2222222",
                  "type": "string"
                },
                "state": {
                  "description": "The state that issued the driver license.",
                  "example": "CA",
                  "type": "string"
                }
              },
              "required": [
                "number",
                "state",
                "current"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "DriverLicenseUpdate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "current": {
                  "description": "The updated current status of the driver license. `true` if the license is the candidate's current license, `false` otherwise.",
                  "type": "boolean"
                },
                "issued_date": {
                  "description": "The updated issued date of the driver license.",
                  "example": "2010-01-30",
                  "format": "date",
                  "type": "string"
                },
                "number": {
                  "description": "The updated number of the driver license.",
                  "example": "F1111111",
                  "type": "string"
                },
                "state": {
                  "description": "The updated state that issued the driver license.",
                  "example": "CA",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "required": true
      },
      "EmployerCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "address": {
                  "$ref": "#/components/schemas/Address"
                },
                "candidate_id": {
                  "description": "ID of the Candidate being screened.",
                  "example": "xxx",
                  "minLength": 1,
                  "pattern": "[a-zA-Z0-9 -'.,]*",
                  "type": "string"
                },
                "contract_type": {
                  "description": "Candidate\u2019s contract type.",
                  "enum": [
                    "full_time",
                    "part_time",
                    "contract",
                    "internship"
                  ],
                  "example": "full_time",
                  "type": "string"
                },
                "do_not_contact": {
                  "default": false,
                  "description": "If `true`, the employer will not be contacted about the Candidate.",
                  "example": false,
                  "type": "boolean"
                },
                "employer_url": {
                  "description": "Employer\u2019s website.",
                  "example": "www.employer.com",
                  "type": "string"
                },
                "end_date": {
                  "description": "Candidate\u2019s end date with the employer.",
                  "example": "2017-05-01",
                  "format": "date",
                  "type": "string"
                },
                "id": {
                  "$ref": "#/components/schemas/ResourceId"
                },
                "manager": {
                  "properties": {
                    "email": {
                      "description": "Candidate's manager's email address.",
                      "example": "joesmith@checkr.co",
                      "type": "string"
                    },
                    "name": {
                      "description": "Candidate's manager's name.",
                      "example": "Joe Smith",
                      "type": "string"
                    },
                    "phone": {
                      "description": "Candidate's manager's phone number.",
                      "example": "212-555-1234",
                      "type": "string"
                    },
                    "title": {
                      "description": "Candidate's manager's title.",
                      "example": "Engineering Manager",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "name": {
                  "description": "Candidate\u2019s employer\u2019s name.",
                  "example": "Checkr",
                  "minLength": 1,
                  "pattern": "[a-zA-Z0-9 -'.,]*",
                  "type": "string"
                },
                "note": {
                  "description": "A text note used to add context for an employment gap.",
                  "example": "Took time off to travel abroad.",
                  "maxLength": 65535,
                  "type": "string"
                },
                "object": {
                  "enum": [
                    "employer"
                  ],
                  "readOnly": true,
                  "type": "string"
                },
                "position": {
                  "description": "Candidate\u2019s position or title.",
                  "example": "Software Engineer",
                  "type": "string"
                },
                "salary": {
                  "description": "Candidate\u2019s gross salary in dollars annually.",
                  "example": 10000,
                  "type": "integer"
                },
                "start_date": {
                  "description": "Candidate\u2019s start date with the employer.",
                  "example": "2016-06-01",
                  "format": "date",
                  "type": "string"
                },
                "type": {
                  "default": "employer",
                  "description": "Type of employment history to be created.\n\nIf type is set to `gap` only `start_date` is required, and only `start_date`, `end_date`, and `note` will be recorded.\n",
                  "enum": [
                    "employer",
                    "gap"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "position",
                "contract_type",
                "start_date",
                "address"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "FormI9Create": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "authorized_representative_email": {
                  "description": "Email address of authorized representative.",
                  "example": "lee.perry@domain.com",
                  "type": "string"
                },
                "authorized_representative_first_name": {
                  "description": "First name of authorized representative.",
                  "example": "Lee",
                  "type": "string"
                },
                "authorized_representative_last_name": {
                  "description": "Last name of authorized representative.",
                  "example": "Perry",
                  "type": "string"
                },
                "candidate_id": {
                  "description": "Candidate resource Id.\n",
                  "example": "3de7e278beb24d14a3785e2dd02cca49",
                  "type": "string"
                },
                "email": {
                  "description": "Candidate email address.",
                  "example": "john.doe@example.com",
                  "type": "string"
                },
                "start_date": {
                  "description": "Candidate start date.",
                  "example": "2023-04-29",
                  "type": "string"
                },
                "workflow_type": {
                  "description": "Workflow type.\n\nFor additional insights into workflow types, please consider reviewing the [Form I-9 definitions](#section/Reference/Form-I-9-definitions-lessBETAgreater).\n",
                  "enum": [
                    "remote_section_1_only",
                    "employer_appointment",
                    "employee_appointment"
                  ],
                  "example": "remote_section_1_only",
                  "type": "string"
                },
                "worksite_id": {
                  "description": "Worksite resource Id.",
                  "example": "8046067e32ad6b25a9078735",
                  "type": "string"
                }
              },
              "required": [
                "candidate_id",
                "email",
                "worksite_id",
                "workflow_type",
                "start_date"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "GeoCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "city": {
                  "description": "A major city within the input state.",
                  "example": "San Francisco",
                  "type": "string"
                },
                "name": {
                  "description": "Human-readable name of the Geo.",
                  "example": "San Francisco",
                  "type": "string"
                },
                "state": {
                  "description": "US state for the Geo.",
                  "example": "CA",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "state"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "GeoUpdate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "city": {
                  "description": "Updates the Geo with the input city.",
                  "example": "San Francisco",
                  "nullable": true,
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "required": true
      },
      "HierarchyUpdate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "nodes": {
                  "items": {
                    "$ref": "#/components/schemas/HierarchyNode"
                  },
                  "type": "array"
                }
              },
              "required": [
                "nodes"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "InvitationCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "candidate_id": {
                  "description": "ID of the Candidate for whom the Invitation is created.",
                  "example": "551564b7865af96a28b13f36",
                  "type": "string"
                },
                "node": {
                  "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts.\n\n`custom_id` of the associated node.\n",
                  "type": "string"
                },
                "package": {
                  "description": "`slug` of the associated package.\n",
                  "example": "driver_pro",
                  "type": "string"
                },
                "tags": {
                  "description": "Array of tags for the Report.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "work_locations": {
                  "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts.\n\nArray of locations described using country, state, and city. When country is not specified defaults to US. State is required for US candidates. Country is required for non-US candidates.\n",
                  "items": {
                    "$ref": "#/components/schemas/WorkLocation"
                  },
                  "type": "array"
                }
              },
              "required": [
                "package",
                "candidate_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "ProfessionalLicenseCreate": {
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProfessionalLicense"
                },
                {
                  "properties": {
                    "certification_document_id": {
                      "description": "ID of document previously created with the [uploadDocument](/#operation/uploadDocument) endpoint. Document must be of `type` `professional_license_certification_image` and should contain an image proof of professional license to be verified.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expiration_date",
                    "issuer_name",
                    "issuer_region",
                    "license_type",
                    "certification_document_id"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        }
      },
      "ReportCreate": {
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "properties": {
                    "candidate_id": {
                      "description": "ID of the Candidate screened.",
                      "example": "e44aa283528e6fde7d542194",
                      "type": "string"
                    },
                    "node": {
                      "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts.\n\n`custom_id` of the associated node.\n",
                      "type": "string"
                    },
                    "package": {
                      "description": "`slug` of the associated package.\nExample: `driver_pro`\n",
                      "type": "string"
                    },
                    "self_disclosures": {
                      "description": "Array of SelfDisclosures\n\n**Note:** Self Disclosures may not be added, updated, or deleted after a Report has been created. The information provided in a Self Disclosure will not be included in the completed Report, and may be retrieved using [GET](#operation/getReport) `/v1/reports/{id}?include=documents`. See the [Documents](#tag/Documents) resource for more information.\n\nRemoving the requirement for the description, date, and location parameters greatly reduces the value of Self Disclosures. If your system mandates that these parameters be optional, work with your Checkr Customer Success Manager to disable the requirement.\n",
                      "items": {
                        "$ref": "#/components/schemas/SelfDisclosure"
                      },
                      "type": "array"
                    },
                    "tags": {
                      "description": "Array of tags for the Report.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "work_locations": {
                      "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts.\n\nArray of locations described using country, state, and city. When country is not specified defaults to US. State is required for US candidates. Country is required for non-US candidates.\n",
                      "items": {
                        "$ref": "#/components/schemas/WorkLocation"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                {
                  "required": [
                    "package",
                    "candidate_id"
                  ]
                }
              ]
            }
          }
        },
        "required": true
      },
      "SchoolCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "address": {
                  "$ref": "#/components/schemas/Address"
                },
                "candidate_id": {
                  "description": "Candidate linked to this School resource.",
                  "example": "83ebeagdec0948690863766f792ead24d61fe3f9",
                  "minLength": 1,
                  "pattern": "[a-zA-Z0-9 -'.,]*",
                  "type": "string"
                },
                "current": {
                  "default": false,
                  "description": "Defines whether the Candidate is currently enrolled.",
                  "type": "boolean"
                },
                "degree": {
                  "description": "Degree awarded to the Candidate.",
                  "example": "BA",
                  "type": "string"
                },
                "end_date": {
                  "description": "Candidate\u2019s end date with the School.",
                  "example": "2017-05-10",
                  "format": "date",
                  "type": "string"
                },
                "id": {
                  "$ref": "#/components/schemas/ResourceId"
                },
                "major": {
                  "description": "Candidate\u2019s major.",
                  "example": "Russian Literature",
                  "pattern": "[a-zA-Z0-9 -'.,]*",
                  "type": "string"
                },
                "minor": {
                  "description": "Candidate\u2019s minor.",
                  "example": "Background Checks",
                  "type": "string"
                },
                "name": {
                  "description": "Name of the School.",
                  "example": "College University",
                  "minLength": 1,
                  "pattern": "[a-zA-Z0-9 -'.,]*",
                  "type": "string"
                },
                "object": {
                  "enum": [
                    "school"
                  ],
                  "readOnly": true,
                  "type": "string"
                },
                "phone": {
                  "description": "School's phone number.",
                  "example": "415-111-1111",
                  "nullable": true,
                  "type": "string"
                },
                "school_url": {
                  "description": "School\u2019s website.",
                  "example": "www.collegeuniversity.com",
                  "type": "string"
                },
                "start_date": {
                  "description": "Candidate\u2019s start date with the School.",
                  "example": "2012-09-22",
                  "format": "date",
                  "type": "string"
                },
                "year_awarded": {
                  "description": "Year in which the degree was awarded.",
                  "example": 2017,
                  "minLength": 1,
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "degree",
                "major",
                "address"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "SubscriptionCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "candidate_id": {
                  "description": "ID of the candidate being screened.",
                  "type": "string"
                },
                "interval_count": {
                  "description": "The number of intervals between each recurrent background check.",
                  "type": "integer"
                },
                "interval_unit": {
                  "description": "Interval at which the subscription will repeat.",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ],
                  "type": "string"
                },
                "node": {
                  "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts.\n\n`custom_id` of the associated node.\n",
                  "type": "string"
                },
                "package": {
                  "description": "`slug` of the associated package.\n",
                  "type": "string"
                },
                "start_date": {
                  "description": "Start date for the subscription. This is the date on which the subscription will begin, and the first time the report will be run.",
                  "format": "date",
                  "type": "string"
                },
                "work_locations": {
                  "description": "<font color=\"red\">Required</font> for hierarchy-enabled accounts.\nArray of locations described using country, state, and city. When country is not specified defaults to US. State is required for US candidates. Country is required for non-US candidates.\n",
                  "items": {
                    "$ref": "#/components/schemas/WorkLocation"
                  },
                  "type": "array"
                }
              },
              "required": [
                "package",
                "candidate_id",
                "start_date"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "SubscriptionUpdate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "candidate_id": {
                  "description": "ID of the candidate being screened.",
                  "type": "string"
                },
                "interval_count": {
                  "description": "The number of intervals between each recurrent background check.",
                  "type": "integer"
                },
                "interval_unit": {
                  "description": "Interval at which the subscription will repeat.",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "year"
                  ],
                  "type": "string"
                },
                "node": {
                  "description": "`custom_id` of the associated node.\n",
                  "type": "string"
                },
                "package": {
                  "description": "Package to run for the Report.",
                  "type": "string"
                },
                "start_date": {
                  "description": "Start date for the subscription. This is the date on which the subscription will begin, and the first time the report will be run.",
                  "format": "date",
                  "type": "string"
                },
                "work_locations": {
                  "description": "Array of locations described using country, state, and city. When country is not specified defaults to US. State is required for US candidates. Country is required for non-US candidates.\n",
                  "items": {
                    "$ref": "#/components/schemas/WorkLocation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          }
        },
        "required": true
      },
      "WebhookCreate": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "include_object": {
                  "description": "When `true`, the webhook event payload will include the related object.",
                  "type": "boolean"
                },
                "live": {
                  "description": "When 'true', the webhook is for the live environment.",
                  "example": true,
                  "type": "boolean"
                },
                "webhook_url": {
                  "description": "The URL which receives the webhook event payload. This must be an HTTPS or an AWS SNS URL. For more information, see [Supported Webhook URLs](#section/Webhooks/Supported-webhook-URLs) section.",
                  "example": "https://example.com",
                  "type": "string"
                }
              },
              "required": [
                "webhook_url"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "WorksiteCreate": {
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Worksite"
                },
                {
                  "required": [
                    "name",
                    "street_line1",
                    "city",
                    "state",
                    "zip_code"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        },
        "required": true
      },
      "WorksiteUpdate": {
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Worksite"
                },
                {
                  "properties": {
                    "everify_status": {
                      "description": "Worksite E-Verify Status.",
                      "enum": [
                        "active",
                        "inactive"
                      ],
                      "example": "inactive",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "required": true
      }
    },
    "responses": {
      "Account": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Account"
            }
          }
        },
        "description": "Account details"
      },
      "AccountHierarchy": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "nodes": {
                  "items": {
                    "$ref": "#/components/schemas/HierarchyTree"
                  },
                  "type": "array"
                },
                "sync_id": {
                  "description": "The `uri_name` of the Account, plus a randomly generated hexadecimal ID, linked with a hyphen.",
                  "example": "account-da78fa2cd1e6ebee4b5975aa",
                  "type": "string"
                },
                "time": {
                  "description": "The date and time at which the ingestion job began.",
                  "example": "2020-01-01T08:00:00Z",
                  "format": "date-time",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "The hierarchy for the account."
      },
