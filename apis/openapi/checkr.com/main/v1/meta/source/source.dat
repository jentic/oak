      "ProfessionalLicenseVerification": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScreeningsGenericPayload"
          },
          {
            "properties": {
              "certifications": {
                "description": "An array of candidate input objects and license verification results objects.",
                "items": {
                  "allOf": [
                    {
                      "properties": {
                        "candidate_documents": {
                          "description": "An array of documents uploaded by the candidate",
                          "items": {
                            "$ref": "#/components/schemas/Document"
                          },
                          "type": "array"
                        },
                        "input": {
                          "description": "Candidate input for license verification.",
                          "properties": {
                            "additional_text": {
                              "description": "Additional information provided by the candidate for their manually entered license.",
                              "example": "License expires on 01-01-2050",
                              "type": "string"
                            },
                            "certification_issued_to": {
                              "description": "Candidate name used in application for professional license verification.",
                              "example": "Jersey John Smith",
                              "type": "string"
                            },
                            "certification_issuer": {
                              "description": "Certifying organization that issued the license. For example: \"California: General\".",
                              "example": "California: Care Providers",
                              "type": "string"
                            },
                            "certification_issuer_website": {
                              "description": "Certifying organization's website.",
                              "example": "https://www.bpelsg.ca.gov/",
                              "type": "string"
                            },
                            "license_number": {
                              "description": "Professional License Number.",
                              "example": "B1234567",
                              "type": "string"
                            },
                            "license_type": {
                              "description": "Professional License type, as provided by the certification's issuer.",
                              "example": "Nurse",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "result": {
                          "description": "Certification result.",
                          "properties": {
                            "certification_expiration": {
                              "description": "Certification's expiration date in MM/DD/YYYY format. Present only if certification is found.",
                              "example": "01/10/2019",
                              "type": "string"
                            },
                            "certification_issued_to": {
                              "description": "Certification Holder.",
                              "example": "Jersey John Smith",
                              "type": "string"
                            },
                            "certification_issuer": {
                              "description": "Certifying organization that issued the license. For example: \"California: General\".",
                              "example": "California: Care Providers",
                              "type": "string"
                            },
                            "certification_issuer_region": {
                              "description": "Certifying organization's region or state.",
                              "example": "CA",
                              "type": "string"
                            },
                            "sub_checks": {
                              "description": "An array of objects describing the results of specific verification criteria.",
                              "example": [
                                {
                                  "name": "not_expired",
                                  "status": "consider"
                                },
                                {
                                  "name": "data_consistency",
                                  "status": "clear"
                                },
                                {
                                  "name": "in_good_standing",
                                  "status": "clear"
                                },
                                {
                                  "name": "found",
                                  "status": "clear"
                                }
                              ],
                              "items": {
                                "allOf": [
                                  {
                                    "properties": {
                                      "name": {
                                        "description": "`not_expired`: Certification active.<br>\n`data_consistency`: Certification matches candidate PII.<br>\n`in_good_standing`: Certification not revoked.<br>\n`found`: Certification found given license identifier.<br>\n",
                                        "enum": [
                                          "not_expired",
                                          "data_consistency",
                                          "in_good_standing",
                                          "found"
                                        ],
                                        "type": "string"
                                      },
                                      "status": {
                                        "enum": [
                                          "clear",
                                          "consider"
                                        ],
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  }
                                ]
                              },
                              "type": "array"
                            },
                            "sub_results": {
                              "description": "An array of objects describing the results of verification data.",
                              "example": [
                                {
                                  "name": "license_number",
                                  "value": "B1234567"
                                }
                              ],
                              "items": {
                                "allOf": [
                                  {
                                    "properties": {
                                      "name": {
                                        "description": "Certifying organization's name for the data returned.",
                                        "type": "string"
                                      },
                                      "value": {
                                        "description": "Certifying organization specific data value.",
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  }
                                ]
                              },
                              "type": "array"
                            },
                            "verified_by": {
                              "description": "Entity that verified the license.\n\n`partner`: Verified by one of Checkr's Professional License partners (most common).<br>\n`none`: Candidate's license was manually entered, and has not been verified.<br>\n",
                              "enum": [
                                "partner",
                                "none"
                              ],
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "documents": {
                "description": "An array of documents captured for the Professional License Verification.",
                "items": {
                  "$ref": "#/components/schemas/Document"
                },
                "type": "array"
              },
              "object": {
                "enum": [
                  "professional_license_verification"
                ]
              },
              "result": {
                "description": "if `clear`, a valid active license was found matching the candidate's PII.",
                "enum": [
                  "clear",
                  "consider"
                ],
                "example": "consider",
                "nullable": true,
                "type": "string"
              },
              "status": {
                "description": "if `clear` a valid active license was found matching the candidate's PII.",
                "enum": [
                  "pending",
                  "clear",
                  "consider"
                ],
                "example": "consider",
                "type": "string"
              },
              "turnaround_time": {
                "example": 603216
              },
              "uri": {
                "example": "/v1/professional_license_verifications/5ee1b0c080c74df951ce6a59"
              }
            },
            "type": "object"
          }
        ]
      },
