      "Verification": {
        "properties": {
          "completed_at": {
            "description": "Value will be null if the candidate has not uploaded the required documents, otherwise will contain the date and time that the documents were provided.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "example": "2014-01-18T12:34:00Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "object": {
            "enum": [
              "verification"
            ],
            "readOnly": true,
            "type": "string"
          },
          "processed_at": {
            "description": "Value will be null if the candidate has not uploaded the required documents, otherwise will contain the date and time that the documents were processed.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "report_id": {
            "description": "Value include the report_id",
