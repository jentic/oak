      "WorkLocation": {
        "properties": {
          "city": {
            "description": "Name of the city",
            "example": "San Francisco",
            "maxLength": 255,
            "type": "string"
          },
          "country": {
            "description": "The country in ISO-3166 alpha-2 format.",
            "example": "US",
            "maxLength": 2,
            "minLength": 2,
            "type": "string"
          },
          "state": {
            "description": "The two letter state code.",
            "example": "CA",
