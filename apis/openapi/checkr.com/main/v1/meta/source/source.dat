          },
          "issuer_region": {
            "description": "2-letter abbreviation of US state where license was issued. For licenses not issued for a specific state, use \"United States\".",
            "example": "CA",
            "type": "string"
          },
          "license_number": {
            "description": "Unique identifier assigned to license by issuer. Format may vary",
            "example": "A 12345",
            "type": "string"
          },
