    "/invitations": {
      "get": {
        "description": "Returns a list of existing Invitations with the input `status` or `candidate_id`.\n\n* If no parameters are passed, returns all Invitations.\n\n* If `candidate_id` or `status` is passed, returns Invitations that match the input parameter.\n\n* If both `candidate_id` and `status` are passed, return Invitations that match both parameters.\n\nReturns 400 if the (optional) `status` parameter is not `pending`, `expired`, or `completed`.\n<b>Note: </b>This call will not return invitations with non-US `work_locations`. Use [GET /invitations/{id}](#operation/getInvitation) to retrieve candidates outside the US.\n",
        "operationId": "listOfInvitations",
        "parameters": [
          {
            "description": "ID of the candidate to whom the invitation was issued.",
            "in": "query",
            "name": "candidate_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Status of the Invitation.",
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "pending",
                "completed",
                "expired"
              ],
              "type": "string"
            }
          },
          {
            "description": "Specifies the page number to retrieve.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "number"
            }
          },
          {
            "description": "Indicates how many records each page should contain. The default value is 25 records.",
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/InvitationsList"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "List existing Invitations",
        "tags": [
          "Invitations"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X GET https://api.checkr.com/v1/invitations \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n    -d status=pending\n"
          }
        ]
      },
      "post": {
        "description": "Creates a new Invitation resource.\n",
        "operationId": "createInvitation",
        "requestBody": {
          "$ref": "#/components/requestBodies/InvitationCreate"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/InvitationCreated"
