          }
        ]
      }
    },
    "/hierarchy/status": {
      "get": {
        "description": "Returns the status of the latest Hierarchy ingestion request.\n\nThis call requires no input, and is provided as a means to determine the progress of an\nasynchronous `POST /hierarchy` request.\n",
        "operationId": "getAccountHierarchyStatus",
        "responses": {
          "200": {
