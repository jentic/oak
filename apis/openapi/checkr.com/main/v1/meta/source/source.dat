          "Hierarchy (Enabled by request)"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl https://api.checkr.com/v1/hierarchy/status \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9:\n"
          }
        ]
      }
    },
    "/i9/forms_i9": {
      "get": {
        "description": "Retrieves all I-9s for the authenticated Checkr account.\n",
        "operationId": "getFormI9",
        "parameters": [
          {
            "description": "Returns records listed by `order_by` parameter. \n\nIf neither is specified, records will be ordered by start_date.\n",
            "example": "full_name",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "enum": [
                "full_name",
                "start_date",
                "worksite_name",
                "open_task"
              ],
              "type": "string"
            }
          },
          {
