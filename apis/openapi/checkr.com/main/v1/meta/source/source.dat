          },
          "verification_url": {
            "description": "URL to direct the candidate to upload documents.",
            "example": "http://verifications.checkr.com/db313e73383710d4fa2f18fd",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Violation": {
        "properties": {
          "description": {
            "description": "Description of the violation",
            "example": "HIT AND RUN",
            "type": "string"
          },
          "issued_date": {
            "description": "Violation issuance date. <b>Date format:</b> \"YYYY-MM-DD\u201d",
            "example": "2050-01-01 00:00:00+00:00",
            "format": "date",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Webhook": {
        "properties": {
          "account_id": {
            "description": "The account associated with the webhook.",
            "example": "8e122cc56b8fa82d33c6118a",
            "readOnly": true,
            "type": "string"
          },
          "application_id": {
            "description": "The application associated with the webhook.",
            "example": null,
            "readOnly": true,
            "type": "string"
          },
          "created_at": {
            "description": "Time at which the webhook was created.",
            "example": "1939-09-01T12:21:00Z",
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "deleted_at": {
            "description": "Time at which the webhook was deleted.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "readOnly": true,
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "include_object": {
