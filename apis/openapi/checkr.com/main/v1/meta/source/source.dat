      "FormI9": {
        "properties": {
          "authorized_representative_email": {
            "description": "Email address of authorized representative.",
            "example": "lee.perry@domain.com",
            "type": "string"
          },
          "authorized_representative_first_name": {
            "description": "First name of authorized representative.",
            "example": "Lee",
            "type": "string"
          },
          "authorized_representative_last_name": {
            "description": "Last name of authorized representative.",
            "example": "Perry",
            "type": "string"
          },
          "candidate_id": {
            "description": "ID of the candidate",
            "example": "3de7e278beb24d14a3785e2dd02cca49",
            "type": "string"
          },
          "created_at": {
            "description": "Form I-9 date of creation.",
            "example": "2023-04-29T16:21:11Z",
            "type": "string"
          },
          "form_i9_url": {
            "description": "Form I-9 link to Tracker UI.",
            "example": "https://integration.i9complete.com/Content/tracker/YWg1ZDg5SDM5RVMzbWxh",
            "type": "string"
          },
          "id": {
            "description": "ID of the resource",
            "example": "1a16ef5f9c1f1df045e74bb4",
            "type": "string"
          },
          "object": {
            "enum": [
              "form_i9"
            ],
            "type": "string"
          },
          "open_tasks": {
            "description": "Form I-9 open task.\n\nMore details on [Form I-9 definitions](#section/Reference/Form-I-9-definitions-lessBETAgreater).\n",
            "enum": [
              "no_action",
              "complete_section_2",
              "appoint_section_2_representative",
              "accept_reject_i9",
              "check_user_email"
            ],
            "example": "complete_section_2",
            "type": "string"
          },
          "open_tasks_url": {
            "description": "Form I-9 open task link.",
            "example": "",
            "type": "string"
          },
          "order_progress": {
            "description": "Form I-9 order progress.\n\nMore details on [Form I-9 definitions](#section/Reference/Form-I-9-definitions-lessBETAgreater).\n",
            "enum": [
              "section_1_incomplete",
              "section_2_incomplete",
              "awaiting_approval",
              "everify_pending",
              "everify_tnc_issued",
              "i9_complete"
            ],
            "example": "section_1_incomplete",
            "type": "string"
          },
          "start_date": {
            "description": "Candidate start date.",
            "example": "2023-04-29",
            "type": "string"
          },
          "uri": {
            "description": "URI of the resource",
            "example": "v1/forms_i9/1a16ef5f9c1f1df045e74bb4",
            "type": "string"
          },
          "workflow_type": {
            "description": "Type of workflow.\n\nMore details on [Form I-9 definitions](#section/Reference/Form-I-9-definitions-lessBETAgreater).\n",
            "enum": [
              "remote_section_1_only",
              "employer_appointment",
              "employee_appointment"
            ],
            "example": "remote_section_1_only",
            "type": "string"
          },
          "worksite_id": {
            "description": "Worksite resource Id.",
            "example": "8046067e32ad6b25a9078735",
            "type": "string"
          },
          "worksite_uri": {
            "description": "URI of the worksite",
