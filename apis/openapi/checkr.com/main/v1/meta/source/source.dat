          "name": "candidate_id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Creates a new Driver License for a given candidate.\n\nIf a `current` driver license is created for a candidate with an existing driver license marked `current`, the existing license will be updated to reflect that it is no longer `current`.\n\nIf a `candidate_driver_license` exists with the `state` and `number` passed in with the POST request, a new license will not be created. The `current` and `issued_date` values of the existing license will be updated with on the parameters passed.\n\n**Note:** When a new driver license is created, Checkr will attempt to apply the new license information to resolve any existing exceptions for the candidate's most recent MVR screening if the screening has not yet produced reportable results.\n\n\nSee [Driver License validation](#section/Reference/Driver-License-validation) in the Reference section for a list of valid driver license number input by state.\n",
        "operationId": "createDriverLicense",
        "requestBody": {
          "$ref": "#/components/requestBodies/DriverLicenseCreate"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/DriverLicenseCreated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/CandidateNotFoundError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Create a new Driver License",
        "tags": [
          "Driver Licenses"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/candidates/5fb31d36bc2e7f4609aba03d/driver_licenses \\\n     -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n     -d number=F2222222 \\\n     -d state=CA \\\n     -d issued_date=2010-01-30 \\\n     -d current=true"
          }
        ]
      }
    },
