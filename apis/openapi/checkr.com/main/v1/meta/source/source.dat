          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Create a new Employer",
        "tags": [
          "Employers"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/candidates/e44aa283528e6fde7d542194/employers \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n    -d name=Checkr \\\n    -d position=Engineer \\\n    -d salary=10000 \\\n    -d address\\[street\\]=123+Main+St. \\\n    -d address\\[city\\]=San+Francisco \\\n    -d address\\[state\\]=CA \\\n    -d address\\[zipcode\\]=94108 \\\n    -d address\\[country\\]=US \\\n    -d contract_type=full_time \\\n    -d start_date=2016-01-22 \\\n    -d end_date=2017-01-22 \\\n    -d manager\\[name\\]=Joe \\\n    -d manager\\[title\\]=Manager \\\n    -d employer_url=www.employer.com\n"
