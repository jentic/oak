      "Report": {
        "properties": {
          "adjudication": {
            "description": "The adjudication for the candidate. `Null` if no adjudication has been made.\n",
            "enum": [
              "engaged",
              "pre_adverse_action",
              "post_adverse_action"
            ],
            "example": "engaged",
            "nullable": true,
            "type": "string"
          },
          "archived": {
            "description": "Returns `true` if the invitation is archived.",
            "example": false,
            "type": "boolean"
          },
          "arrest_search_id": {
            "description": "ID of the Arrest Search linked to the report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "assessment": {
            "description": "The assessment for the report. This field will be non-null only for Assess-enabled accounts. For accounts with Assess enabled, it will be null for reports completed before Assess was enabled, and null for a short time after report completion while the account's Assess rules are applied.\n",
            "enum": [
              "eligible",
              "review",
              "escalated"
            ],
            "example": "eligible",
            "nullable": true,
            "type": "string"
          },
          "candidate_id": {
            "description": "ID of the candidate being screened.",
            "example": "e44aa283528e6fde7d542194",
            "type": "string"
          },
          "candidate_story_ids": {
            "description": "Array of Candidate Story IDs linked to the Report.",
            "items": {
              "example": "989b4c2d83dd8a81547f2dae",
              "type": "string"
            },
            "type": "array"
          },
          "completed_at": {
            "description": "Time at which the report was completed.\n",
            "example": "2014-01-18T12:35:30Z",
            "format": "date-time",
            "type": "string"
          },
          "county_criminal_search_ids": {
            "description": "Array of County Criminal Search IDs linked to the Report.",
            "items": {
              "example": "539fdcf335644a0ef4000003",
              "type": "string"
            },
            "type": "array"
          },
          "created_at": {
            "description": "Time at which the report was created.\n",
            "example": "2014-01-18T12:34:00Z",
            "format": "date-time",
            "type": "string"
          },
          "document_ids": {
            "description": "Array of Document IDs.",
            "items": {
              "example": "539fdcf335496a0ef4000003",
              "type": "string"
            },
            "type": "array"
          },
          "drug_alcohol_clearinghouse_id": {
            "description": "ID of the Drug & Alcohol Clearinghouse Search linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "drug_screening": {
            "description": "Embedded Drug Screening object",
            "properties": {
              "analytes": {
                "description": "Array of result analytes from the Drug Screening Panel",
                "items": {
                  "properties": {
                    "disposition": {
                      "description": "Medical evaluation for specific drug",
                      "enum": [
                        "negative",
                        "positive"
                      ],
                      "example": "negative",
                      "type": "string"
                    },
                    "name": {
                      "description": "Name of drug that was tested",
                      "example": "Marijuana",
                      "type": "string"
                    },
                    "specimen_type": {
                      "description": "Type of specimen that was tested",
                      "enum": [
                        "urine",
                        "breath",
                        "saliva"
                      ],
                      "example": "urine",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "appointment_id": {
                "description": "ID of the Appointment linked to the Drug Screening.",
                "example": "539fd88c101897f7cd000001",
                "type": "string"
              },
              "disposition": {
                "description": "Medical evaluation for entire screening",
                "enum": [
                  "negative",
                  "positive",
                  "canceled"
                ],
                "example": "negative",
                "type": "string"
              },
              "events": {
                "description": "Array of drug screening events",
                "items": {
                  "properties": {
                    "created_at": {
                      "description": "Time the event was created",
                      "example": "2014-01-19T11:28:31Z",
                      "format": "date-time",
                      "type": "string"
                    },
                    "text": {
                      "description": "Additional note for event type",
                      "example": "Specimen Sent to Lab",
                      "type": "string"
                    },
                    "type": {
                      "description": "Type of event",
                      "enum": [
                        "completed",
                        "screening_invitation_sent",
                        "screening_scheduled",
                        "status_update",
                        "screening_pass_extended",
                        "screening_notice"
                      ],
                      "example": "status_update",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "description": "ID of the Drug Screening linked to the Report.",
                "example": "539fd88c101897f7cd000001",
                "type": "string"
              },
              "mro_notes": {
                "description": "Notes from Medical Review Officer",
                "example": "Diluted Sample",
                "type": "string"
              },
              "result": {
                "description": "Outcome of the Drug Screening.\n",
                "enum": [
                  "clear",
                  "consider"
                ],
                "example": "clear",
                "type": "string"
              },
              "screening_pass_expires_at": {
                "description": "Time the Candidate has to complete the drug screening",
                "example": "2014-01-19T11:28:31Z",
                "format": "date-time",
                "type": "string"
              },
              "status": {
                "description": "Status of the Drug Screening.\n",
                "enum": [
                  "pending",
                  "clear",
                  "consider",
                  "suspended",
                  "canceled",
                  "complete"
                ],
                "example": "clear",
                "type": "string"
              }
            },
            "type": "object"
          },
          "drug_screening_id": {
            "description": "ID of the Drug Screening linked to the report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "estimated_completion_time": {
            "description": "Date at which the report is predicted to be finished. Despite the date-time format, we only estimate to the date. The time is not relevant.\n",
            "example": "2019-07-31T00:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "facis_search_id": {
            "description": "ID of the FACIS Search linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "federal_civil_search_id": {
            "description": "ID of the Federal Civil Search linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "federal_criminal_search_id": {
            "description": "ID of the Federal Criminal Search linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "federal_district_civil_search_id": {
            "description": "ID of the Federal District Civil Search linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "federal_district_criminal_search_id": {
            "description": "ID of the Federal District Criminal Search linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "geo_ids": {
            "description": "Array of Geo IDs.",
            "items": {
              "example": "87f5bb4983eade22c55f4731",
              "type": "string"
            },
            "type": "array"
          },
          "global_watchlist_search_id": {
            "description": "ID of the Global Watchlist Search linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "includes_canceled": {
            "description": "Returns `true` if the report includes a canceled screening.",
            "example": false,
            "type": "boolean"
          },
          "international_adverse_media_search_ids": {
            "description": "Array of International Adverse Media Search IDs linked to the Report. If no searches exists, this field is omitted.",
            "items": {
              "example": "41007c751c9a15c892c0981a0400e2",
              "type": "string"
            },
            "type": "array"
          },
          "international_criminal_searches_v2_ids": {
            "description": "Array of International Criminal Search IDs linked to the Report. If no searches exist, this field is omitted.",
            "items": {
              "example": "41007c751c9a15c892c0981a0400d1",
              "type": "string"
            },
            "type": "array"
          },
          "international_education_verification_id": {
            "description": "ID of an International Education Verification linked to the Report. If no verification exists, this field is omitted.",
            "example": "41007c751c9a15c892c0981a040004",
            "type": "string"
          },
          "international_employment_verification_id": {
            "description": "ID of an International Employment Verification linked to the Report. If no verification exists, this field is omitted.",
            "example": "41007c751c9a15c892c0981a040015",
            "type": "string"
          },
          "international_global_watchlist_search_id": {
            "description": "ID of an International Global Watchlist Search linked to the Report. If no search exists, this field is omitted.",
            "example": "41007c751c9a15c892c0981a0400f3",
            "type": "string"
          },
          "international_identity_document_validation_id": {
            "description": "ID of an International Identity Document Validation linked to the Report. If no validation exists, this field is omitted.",
            "example": "41007c751c9a15c892c0981a040026",
            "type": "string"
          },
          "motor_vehicle_report_id": {
            "description": "ID of the Motor Vehicle Record Search linked to the Report.",
            "example": "539fd88c101897f7cd000007",
            "type": "string"
          },
          "national_criminal_search_id": {
            "description": "ID of the National Criminal Search linked to the Report.",
            "example": "539fd88c101897f7cd000006",
            "type": "string"
          },
          "object": {
            "description": "Defines the object type: `report`.\n",
            "enum": [
              "report"
            ],
            "readOnly": true,
            "type": "string"
          },
          "occupational_health_screening_id": {
            "description": "ID of the Health Screening linked to the report.",
            "example": "539fdcf335644a0ef4000003",
            "type": "string"
          },
          "package": {
            "description": "Human-readable name of the Package.\n",
            "example": "driver_pro",
            "type": "string"
          },
          "personal_reference_verification_ids": {
            "description": "Array of Personal Reference Verification IDs linked to the Report.",
            "items": {
              "example": "539fdcf335644a0ef4000003",
              "type": "string"
            },
            "type": "array"
          },
          "professional_license_verification_ids": {
            "description": "Array of Professional License Verification IDs linked to the Report.",
            "items": {
              "example": "5ee1b0c080c74df951ce6a59",
              "type": "string"
            },
            "type": "array"
          },
          "professional_reference_verification_ids": {
            "description": "Array of Professional Reference Verification IDs linked to the Report.",
            "items": {
              "example": "539fdcf335644a0ef4000003",
              "type": "string"
            },
            "type": "array"
          },
          "program_id": {
            "description": "ID of the Program linked to the Report.\n",
            "example": "00166f9ff39ec7b453adfaec",
            "type": "string"
          },
          "result": {
            "description": "Outcome of the report.\n",
            "enum": [
              "clear",
              "consider"
            ],
            "example": "clear",
            "nullable": true,
            "type": "string"
          },
          "revised_at": {
            "description": "Time at which the report was revised.\n",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "segment_stamps": {
            "description": "Tier and name of the node the report was ordered with and tier|name information for all its parent nodes.\n",
            "items": {
              "example": [
                "unit|Anvil Charlotte",
                "company|Acme Corporation",
                "division|Anvil Sales",
                "region|Anvil South East"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "sex_offender_search_id": {
            "description": "ID of the Sex Offender Registry Search linked to the Report.",
            "example": "539fd88c101897f7cd000008",
            "type": "string"
          },
          "source": {
            "description": "The method used to create the report. <br>`api` created from the Checkr API. <br>`continuous_check` created automatically from a Continuous Check return. <br>`form` created from the Checkr Hosted Invite/Apply flow. <br>`manual_order` created from a manual order (customer enters candidate's PII) originating in the Checkr Dashboard. <br>`recurrence` created from a Subscription. <br>`web` created from <b>Candidates > Order new Report </b> in the Checkr Dashboard.",
            "enum": [
              "api",
              "continuous_check",
              "form",
              "manual_order",
              "recurrence",
              "web"
            ],
            "example": "api",
            "type": "string"
          },
          "ssn_trace_id": {
            "description": "ID of the SSN Trace linked to the Report.",
            "example": "539fd88c101897f7cd000001",
            "type": "string"
          },
          "state_criminal_searches": {
            "description": "Array of State Criminal Search IDs linked to the Report.",
            "items": {
              "example": "539fdcf335644a0ef4000003",
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "description": "Status of the report.\n\n`canceled` if and only if all screenings, including SSN Trace, within the report were canceled.\n`complete` if at least one screening was completed.\n",
            "enum": [
              "pending",
              "complete",
              "suspended",
              "dispute",
              "canceled"
            ],
            "example": "complete",
            "type": "string"
          },
          "turnaround_time": {
            "description": "Number of seconds the report took to complete, calculated from `created_at` to `completed_at`.",
            "example": 90,
            "type": "integer"
          },
          "upgraded_at": {
            "description": "Time at which the report was upgraded.\n",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "example": "/v1/reports/4722c07dd9a10c3985ae432a"
          },
          "work_locations": {
            "description": "Array of work locations set while ordering this report.\n",
            "items": {
              "$ref": "#/components/schemas/WorkLocation"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ReportAddresses": {
