    "/candidates": {
      "get": {
        "description": "Lists existing Candidates with the input parameters.\n\n<b>Note: </b>This call will not return candidates with non-US `work_locations`. Use [GET /candidates/{id}](#operation/getCandidate) to retrieve candidates outside the US.\n",
        "operationId": "listOfCandidates",
        "parameters": [
          {
            "description": "Returns candidates with the input email address.",
            "in": "query",
            "name": "email",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with the input `full_name`.",
            "in": "query",
            "name": "full_name",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with the input adjudication. `Null` if no adjudication has been made.",
            "in": "query",
            "name": "adjudication",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with the input `custom_id`.",
            "in": "query",
            "name": "custom_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates created after the input date.",
            "in": "query",
            "name": "created_after",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Returns candidates created before the input date.",
            "in": "query",
            "name": "created_before",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Returns candidates adjudicated after the input date.",
            "in": "query",
            "name": "report_adjudicated_after",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Returns candidates adjudicated before the input date.",
            "in": "query",
            "name": "report_adjudicated_before",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with a report adjudicated by someone with input `adjudicator_email`.",
            "in": "query",
            "name": "report_adjudicator_email",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with a report revised after the input date.",
            "in": "query",
            "name": "report_revised_after",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with a report revised before the input date.",
            "in": "query",
            "name": "report_revised_before",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with the input `driver_license_number`.",
            "in": "query",
            "name": "driver_license_number",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with the input `geo_id`.",
            "in": "query",
            "name": "geo_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates with the input `program_id`.",
            "in": "query",
            "name": "program_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns candidates matching the input key-values. Input keys will be matched exactly. Input values will be pre- and post-pended with wildcards. (For example: A query for 1234 will return results for \\*1234\\*.)",
            "in": "query",
            "name": "metadata",
            "schema": {
              "type": "object"
            }
          },
          {
            "description": "Specifies the page number to retrieve.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "number"
            }
          },
          {
            "description": "Indicates how many records each page should contain. The default value is 25 records.",
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "nullable": true,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ListOfCandidates"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "List existing Candidates",
        "tags": [
          "Candidates"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X GET https://api.checkr.com/v1/candidates \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9:\n"
          }
        ]
      },
      "post": {
        "description": "Creates a new Candidate resource.\n\n### Required attributes\n\nThe Candidate resource\u2019s required attributes vary depending on its intended use. If this resource is to be used in conjunction with the Invitations API (in which the invitation apply form collects the Candidate's personal information), the only strictly required Candidate attribute is `email`.\n\nIf this resource is to be used to generate any other report type, other personal information is also required.\n\nAttributes required to generate a Report include:\n- `first_name`\n- `middle_name` or `no_middle_name`\n- `last_name`\n- `dob`\n\nAttributes required to generate a Report with a criminal check screening:\n- `ssn`\n- `zipcode`\n\nAttributes required to generate a report with a Motor Vehicle Record (MVR) screening:\n- `driver_license_number`\n- `driver_license_state`\n\nSee [Driver License validation](#section/Reference/Driver-License-validation) in the Reference section for a list of valid input by state.\n\nAttributes recommended to generate a report with an Identity Document Verification screening:\n- `phone` (mobile phone number)\n\nValidation for these attributes is performed when requesting a Report, as the requirements depend on the Package.\n\nCheckr's product incorporates SSN field controls designed to not accept SSNs with the following characteristics:\n\n  - SSNs without exactly 9 numeric characters\n  - SSNs that start with 666 (666-34-3768)\n  - SSNs that start with 9 (967-65-4325)\n  - SSNs that are a single digit (111-11-1111)\n  - SSNs that are sequential digits (123-45-6789)\n",
        "operationId": "createCandidate",
        "requestBody": {
          "$ref": "#/components/requestBodies/CandidateCreate"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CandidateCreated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Create a new Candidate",
        "tags": [
          "Candidates"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/candidates \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n    -H 'Content-Type: application/json' \\\n    -d '{\"first_name\":\"John\",\n        \"middle_name\":\"Alfred\",\n        \"last_name\":\"Smith\",\n        \"email\":\"john.smith@gmail.com\",\n        \"phone\":\"5555555555\",\n        \"zipcode\":\"90401\",\n        \"dob\":\"1970-01-22\",\n        \"ssn\":\"847-43-4645\",\n        \"driver_license_number\":\"F2111655\",\n        \"driver_license_state\":\"CA\",\n        \"work_locations\":[{\"country\":\"US\"}],\n        \"postal_address\": {\n                            \"name\": \"John Alfred Smith\",\n                            \"street\": \"123 Main Street\",\n                            \"street2\": \"APT A\",\n                            \"city\": \"San Francisco\",\n                            \"state\": \"CA\",\n                            \"zipcode\": \"90401\"\n                            }\n        }'\n"
          }
        ]
      }
    },
    "/candidates/{candidate_id}/continuous_checks": {
      "get": {
        "description": "Returns a list of existing Continuous Checks.\n",
        "operationId": "listOfContinuousChecks",
        "responses": {
          "200": {
