      "SelfDisclosure": {
        "properties": {
          "date": {
            "description": "Date of the conviction.",
            "example": "2019-11-01",
            "format": "date",
            "type": "string"
          },
          "description": {
            "description": "Candidate-provided description of their criminal history.",
            "example": "I made a mistake and grew from this experience.",
            "type": "string"
          },
          "location": {
            "description": "The location of the incident.",
            "properties": {
              "country": {
                "description": "2 letter country code. Format: `ISO 3166-1 alpha-2` (`US` by default.)\n",
                "example": "US",
                "type": "string"
              },
              "county": {
                "description": "Name of the county in which the conviction occurred. (Use the [/counties](#tag/Counties) resource to obtain a list of counties in each state.)\n",
                "example": "BOULDER",
                "type": "string"
              },
              "state": {
                "description": "State where the county is located. Format: `ISO 3166-2:US`.\n",
                "example": "CO",
                "type": "string"
              }
            },
            "required": [
              "state",
              "county"
            ],
            "type": "object"
          },
          "offense_category": {
            "description": "The criminal charge",
            "example": "Insurance Fraud",
            "type": "string"
          },
          "offense_level": {
            "description": "The level of the offense.",
            "example": "Misdemeanor",
            "type": "string"
          },
          "sentence": {
            "description": "The sentence imposed.",
            "example": "24 months probation",
            "type": "string"
          },
          "time_served": {
            "description": "The time served.",
            "example": "20 months probation",
            "type": "string"
          }
        },
        "required": [
          "description",
          "date",
          "location"
        ],
        "type": "object"
      },
      "SexOffenderSearch": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScreeningsGenericPayload"
          },
          {
            "properties": {
              "object": {
                "example": "sex_offender_search"
              },
              "records": {
                "description": "Array of SexRecord objects.",
                "items": {
                  "properties": {
                    "age": {
                      "description": "Age listed on the record.",
                      "example": 44,
                      "type": "integer"
                    },
                    "dob": {
                      "description": "Date of birth listed on the record.",
                      "example": "1975-02-01",
                      "format": "date",
                      "type": "string"
                    },
                    "full_name": {
                      "description": "Name listed on the record.",
                      "example": "John Alfred Smith",
                      "type": "string"
                    },
                    "registration_end": {
                      "description": "End date for the registration.",
                      "example": "2012-02-12",
                      "format": "date",
                      "type": "string"
                    },
                    "registration_start": {
                      "description": "Start date for the registration.",
                      "example": "2011-02-12",
                      "format": "date",
                      "type": "string"
                    },
                    "registry": {
                      "description": "State in which the record was registered.",
                      "example": "California",
                      "type": "string"
                    },
                    "state": {
                      "description": "State listed for the record.",
                      "example": "CA",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "result": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ScreeningResult"
                  },
                  {
                    "example": "consider"
                  }
                ]
              },
              "status": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ScreeningStatus"
                  },
                  {
                    "example": "complete"
                  }
                ]
              },
              "turnaround_time": {
                "example": 90
              },
              "uri": {
                "example": "/v1/sex_offender_searches/539fd88c101897f7cd000008"
              }
            },
            "type": "object"
          }
        ]
      },
      "Ssn": {
        "properties": {
          "encrypted_ssn": {
            "description": "The candidate's SSN: encrypted, then encoded using Base64. `Null` if no SSN exists for the candidate.",
            "example": "hyYMhDje9dVUEPKU9myy7OFJ7R27pj0pmlegFlka99I=",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SsnTrace": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScreeningsWithNullResult"
          },
          {
            "properties": {
              "addresses": {
                "description": "This field has been deprecated and will return an empty array.",
                "type": "array"
              },
              "aliases": {
                "description": "This field has been deprecated and will return an empty array.",
                "type": "array"
              },
              "data_mismatch": {
                "default": false,
                "description": "If true, information returned from the SSN Trace does not match any of the candidate\u2019s provided information.",
                "type": "boolean"
              },
              "death_index": {
                "default": false,
                "description": "If true, the input SSN is listed on the Social Security Administration's \u201cDeath Master File\u201d.",
                "type": "boolean"
              },
              "dob_mismatch": {
                "default": false,
                "description": "If true, the name on the SSN Trace matches the candidate's provided information, but the DOB does not.",
                "type": "boolean"
              },
              "invalid_issuance_year": {
                "default": false,
                "description": "If true, the input SSN has a year of issuance that precedes the candidate's reported year of birth.",
                "type": "boolean"
              },
              "issued_state": {
                "description": "The US state where the ID was issued.",
                "example": "CA",
                "type": "string"
              },
              "issued_year": {
                "description": "The year the ID was issued.",
                "example": 1993,
                "type": "integer"
              },
              "name_mismatch": {
                "default": false,
                "description": "If true, the DOB associated with the addresses returned from the SSN Trace matches the candidate's input DOB, but the name does not.",
                "type": "boolean"
              },
              "no_data": {
                "default": false,
                "description": "No data was returned for the input Candidate PII.",
                "type": "boolean"
              },
              "object": {
                "enum": [
                  "ssn_trace"
                ]
              },
              "result": {
                "description": "Outcome of the screening.  Screenings completed before April 2021 may return `\"clear\"` or `\"consider\"`.",
                "example": null,
                "nullable": true,
                "type": "string"
              },
              "ssn": {
                "description": "Candidate\u2019s social security number. This value will be redacted in all return calls, except for the last four digits.",
                "example": "XXX-XX-4645",
                "type": "string"
              },
              "ssn_already_taken": {
                "default": false,
                "description": "If true, another Candidate with same SSN already exists in our system.",
                "type": "boolean"
              },
              "status": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ScreeningStatusNonReportable"
                  },
                  {
                    "example": "complete"
                  }
                ]
              },
              "thin_file": {
                "default": false,
                "description": "No information found.",
                "type": "boolean"
              },
              "turnaround_time": {
                "example": 90
              },
              "uri": {
                "example": "/v1/ssn_traces/539fd88c101897f7cd000001"
              }
            },
            "type": "object"
          }
        ]
      },
      "StateCriminalSearch": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ScreeningsGenericPayload"
          },
          {
            "properties": {
              "completed_at": {
                "example": "2014-01-18T12:35:30Z",
                "format": "date-time",
                "type": "string"
              },
              "created_at": {
                "example": "2014-01-18T12:34:00Z",
                "format": "date-time",
                "type": "string"
              },
              "estimated_completion_time": {
                "description": "Estimated time of completion for the Screening. This estimate will be based on the maximum turnaround time across all states searched.",
                "example": "2014-01-18T12:34:00Z",
                "format": "date-time",
                "type": "string"
              },
              "filtered_by_positive_adjudication_records": {
                "description": "Array of CriminalRecord objects filtered out by your account\u2019s Positive Adjudication Matrix or by your account\u2019s Assess configuration.",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Record"
                    }
                  ]
                },
                "type": "array"
              },
              "object": {
                "enum": [
                  "state_criminal_search"
                ]
              },
              "records": {
                "description": "Array of CriminalRecord objects.",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Record"
                    },
                    {
                      "properties": {
                        "arresting_agency": {
                          "example": "San Francisco Police Department"
                        },
                        "charges": {
                          "items": {
                            "allOf": [
                              {
                                "$ref": "#/components/schemas/Charge"
                              },
                              {
                                "properties": {
                                  "arrest_date": {
                                    "example": "2011-04-22"
                                  },
                                  "charge": {
                                    "example": "Sell Cocaine"
                                  },
                                  "defendant": {
                                    "example": "John Alfred Smith"
                                  },
                                  "sentence_date": {
                                    "example": "2011-06-02"
                                  }
                                },
                                "type": "object"
                              }
                            ]
                          },
                          "type": "array"
                        },
                        "court_jurisdiction": {
                          "example": "San Francisco"
                        },
                        "file_date": {
                          "example": "2010-02-18"
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "result": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ScreeningResult"
                  },
                  {
                    "example": "consider"
                  }
                ]
              },
              "screening_pointers": {
                "description": "Array of `screening_pointers` associated with the screening.",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ScreeningPointer"
                    },
                    {
                      "example": [
                        "Denver, CO County Search",
                        "Kentucky State Search",
                        "Widgets-R-Us Employment Address",
                        "Harvard University Education Address"
                      ],
                      "type": "string"
                    }
                  ]
                },
                "type": "array"
              },
              "state": {
                "description": "State searched for these records.",
                "example": "CA",
                "type": "string"
              },
              "status": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ScreeningStatus"
                  },
                  {
                    "example": "complete"
                  }
                ]
              },
              "turnaround_time": {
                "example": 100800
              },
              "uri": {
                "example": "/v1/state_criminal_searches/539fdcf335644a0ef4000001"
              }
            },
            "type": "object"
          }
        ]
      },
      "Subscription": {
        "properties": {
          "canceled_at": {
            "description": "Time at which the Subscription was canceled.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "candidate_id": {
            "description": "ID of the candidate screened.",
            "example": "4722c07dd9a10c3985ae432a",
            "type": "string"
          },
          "created_at": {
            "description": "Time at which the Subscription was created.",
            "example": "2014-01-18T12:34:00Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "interval_count": {
            "description": "The number of intervals between each recurrent background check.",
            "example": 1,
            "type": "integer"
          },
          "interval_unit": {
            "description": "Interval at which the Subscription will repeat.",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ],
            "example": "month",
            "type": "string"
          },
          "next_occurrence_date": {
            "description": "The next date on which the Subscription will be run. This date is determined based on the `start_date`, `interval_unit`, `interval_count`, and the last date the subscription was run.",
            "example": "2014-07-10",
            "format": "date",
            "type": "string"
          },
          "node": {
            "description": "Node to be used when generating a report for this Subscription.",
            "example": "zpy8orej4r614ize",
            "type": "string"
          },
          "object": {
            "enum": [
              "subscription"
            ],
            "readOnly": true,
            "type": "string"
          },
          "package": {
            "description": "Package to run for the Subscription.",
            "example": "driver_pro",
            "type": "string"
          },
          "start_date": {
            "description": "Start date for the Subscription. This is the date on which the Subscription will begin, and the first time the report will be run.",
            "example": "2014-06-10",
            "format": "date",
            "type": "string"
          },
          "status": {
            "description": "Status of the Subscription.",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active",
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "description": "URI of the Subscription.",
            "example": "/v1/subscriptions/e44aa283528e6fde7d542194"
          },
          "work_locations": {
            "description": "Array of work locations to be used when generating a report for this Subscription.",
            "items": {
              "$ref": "#/components/schemas/WorkLocation"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
