      "Invitation": {
        "properties": {
          "archived": {
            "description": "Returns `true` if the invitation is archived.",
            "example": false,
            "type": "boolean"
          },
          "archived_info": {
            "description": "Information relating to an archived report or invitation",
            "properties": {
              "time": {
                "description": "Time the report or invitation was archived",
                "example": "2023-08-29T23:15:34Z",
                "format": "date-time",
                "type": "string"
              },
              "user": {
                "description": "User information about the archiver",
                "properties": {
                  "email": {
                    "description": "User's email address\n",
                    "example": "john.smith@gmail.com",
                    "format": "email",
                    "nullable": true,
                    "type": "string"
                  },
                  "id": {
                    "description": "User's ID\n",
                    "example": "1234abcd5678",
                    "nullable": true,
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "candidate_id": {
            "description": "ID of the Candidate to whom the Invitation was sent.",
            "example": "551564b7865af96a28b13f36",
            "type": "string"
          },
          "completed_at": {
            "description": "Time at which the Invitation was completed by the candidate.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "description": "Time at which the Invitation was created.",
            "example": "2015-05-14T17:45:34Z",
            "format": "date-time",
            "type": "string"
          },
          "deleted_at": {
            "description": "Time at which the Invitation was deleted.",
            "example": null,
            "nullable": true,
            "type": "string"
          },
          "expires_at": {
            "description": "Time at which the Invitation will expire.",
            "example": "2015-05-21T17:45:34Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "invitation_url": {
            "description": "URL for the Invitation.",
            "example": "https://apply.checkr.com/invite/try-checkr/290f9d6d6e46/test",
            "type": "string"
          },
          "object": {
            "enum": [
              "invitation"
            ],
            "readOnly": true,
            "type": "string"
          },
          "package": {
            "description": "Package associated with the Invitation.",
            "example": "driver_pro",
            "type": "string"
          },
          "report_id": {
            "description": "ID of the Report created by the completion of this Invitation. Will be null if the Invitation has not yet been completed.",
            "example": null,
            "nullable": true,
            "type": "string"
          },
          "status": {
            "description": "Status of the Invitation.",
            "enum": [
              "pending",
              "completed",
              "expired"
            ],
            "example": "pending",
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "example": "/v1/invitations/e44aa283528e6fde7d542194"
          }
        },
        "type": "object"
      },
      "LicenseInfo": {
        "properties": {
          "country": {
            "description": "Candidate\u2019s driver license country of issue. **Format:** ISO 3166-2 2 letter alpha2 country code. **Example:** `CA`",
            "example": "CA",
            "type": "string"
          },
          "expiration_date": {
            "description": "Candidate\u2019s driver license expiration date. **Date format:** \"YYYY-MM-DD\u201d",
            "example": "2030-01-01 00:00:00+00:00",
            "format": "date",
            "type": "string"
          },
          "is_current": {
            "description": "Boolean that represents if it is the candidate\u2019s current driver license",
            "example": true,
            "type": "boolean"
          },
          "license_class": {
            "description": "Candidate\u2019s driver license class",
            "example": "G1",
            "type": "string"
          },
          "license_number": {
            "description": "Candidate\u2019s driver license number; Format varies by subdivision (i.e. province)",
            "example": "ABC12345",
            "type": "string"
          },
          "subdivision": {
            "description": "Candidate's driver license subdivision of issue country. **Format:** ISO 3166-2 subdivision code. **Example:** `CA-AB`",
            "example": "CA-AB",
            "type": "string"
          }
        },
        "type": "object"
      },
      "LicenseReport": {
        "properties": {
          "actual_license_class": {
            "description": "The actual, verified license class this driver is eligible for. **Example:** G, G1, G2",
            "example": 1,
            "type": "string"
          },
          "is_valid_license_class": {
            "description": "Boolean check to confirm if the License Classes match",
            "example": true,
            "type": "boolean"
          },
          "license_infos": {
            "description": "Array of LicenseInfo objects",
            "items": {
              "$ref": "#/components/schemas/LicenseInfo"
            },
            "type": "array"
          },
          "license_status": {
            "description": "Final result of the search",
            "example": "VALID",
            "type": "string"
          },
          "violations": {
            "description": "Array of Violation objects.\n\n**Note:** The violations, if any, will show up only if `include_driver_history` is set to `true`. Otherwise, it will return an empty violation array.\n",
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Metadata": {
        "description": "Up to 50 customer-defined key-value pairs. Use this parameter to store additional information on your candidate. For example: Use the key to map candidates to `job_req_id`, `application_id`, or `branch_id`. Keys must be 40 characters or less. Values must be 500 characters or less.\nFor example: { \"job_req_id\": \"12345\" }",
