            "type": "string"
          },
          "tier": {
            "description": "Customer-defined label for this level of the hierarchy. (For example \"Department\" or \"Division\".)",
            "example": "department",
            "maxLength": 255,
            "type": "string"
          }
        },
        "required": [
          "name",
          "custom_id"
        ],
        "type": "object"
      },
