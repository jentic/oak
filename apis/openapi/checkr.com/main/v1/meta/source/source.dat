      "post": {
        "description": "Creates a new Employer resource.\n\nIf the country is not US, the following parameters will be required in addition to those marked as required in the table below:\n\n- salary\n- address:\n  - street\n  - country\n  - zipcode\n- manager:\n  - name\n  - title\n\nValidation for `start_date` and `end_date` is performed to ensure logical dates are provided. `end_date` must be after `start_date`, and both dates must be after 1900-01-01.\n",
        "operationId": "createEmployer",
        "parameters": [
          {
            "description": "Create an employer for the input `candidate_id`.",
            "in": "path",
            "name": "candidate_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
