    "schemas": {
      "Account": {
        "properties": {
          "account_deauthorization": {
            "description": "Account deauthorization details if account has been deauthorized.\n",
            "properties": {
              "reason": {
                "description": "Reason for account deauthorization.",
                "example": "nonpayment",
                "type": "string"
              }
            },
            "type": "object"
          },
          "adverse_action_email": {
            "description": "Email used to send pre- and post- Adverse Action notices on behalf of the Account to candidates.\nThis address will also receive undeliverable notices if an Adverse Action notice isn't deliverable to a candidate.\n",
            "example": "john.doe@example.com",
            "format": "email",
            "type": "string"
          },
          "api_authorized": {
            "default": false,
            "description": "Determines whether Account is authorized to use the API to order background checks.\n",
            "example": true,
            "type": "boolean"
          },
          "authorized": {
            "default": false,
            "description": "Determines whether Account is credentialed to order background checks.\n",
            "example": true,
            "type": "boolean"
          },
          "available_screenings": {
            "description": "List of screening types available for the Account.\n",
            "example": [
              "county_civil_search",
              "county_criminal_search",
              "municipal_criminal_search",
              "education_verification",
              "employment_verification",
              "federal_civil_search",
              "federal_criminal_search",
              "motor_vehicle_report",
              "national_criminal_search",
              "sex_offender_search",
              "ssn_trace",
              "state_criminal_search",
              "international_adverse_media_search",
              "international_education_verification"
            ],
            "items": {
              "pattern": "[a-z_]+",
              "type": "string"
            },
            "type": "array"
          },
          "billing_email": {
            "description": "Email that is used for Checkr to contact you about invoices and other billing communication.\n",
            "example": "john.doe@example.com",
            "format": "email",
            "type": "string"
          },
          "company": {
            "description": "Company details",
            "properties": {
              "city": {
                "description": "City where company is headquartered.",
                "example": "Wilmington",
                "type": "string"
              },
              "dba_name": {
                "description": "Doing-Business-As name of Company displayed in Checkr emails and branded web pages.\n",
                "example": "ACME",
                "type": "string"
              },
              "incorporation_state": {
                "description": "Incorporation state. Format: `ISO 3166-2:US`.\n",
                "example": "DE",
                "type": "string"
              },
              "incorporation_type": {
                "description": "Type of incorporation.",
                "enum": [
                  "association",
                  "co-ownership",
                  "corporation",
                  "joint-venture",
                  "limited-partnership",
                  "llc",
                  "llp",
                  "non-profit",
                  "partnership",
                  "s-corporation",
                  "sp",
                  "trusteeship"
                ],
                "example": "llc",
                "type": "string"
              },
              "industry": {
                "description": "Industry that company operates in, as NAICS code (see https://www.naics.com)",
                "example": "52-59",
                "pattern": "[0-9-]+",
                "type": "string"
              },
              "name": {
                "description": "Registered company name.",
                "example": "Acme Corporation",
                "type": "string"
              },
              "phone": {
                "description": "Company phone number.",
                "example": "206-555-0100",
                "type": "string"
              },
              "state": {
                "description": "State where company is headquartered. Format: `ISO 3166-2:US`.\n",
                "example": "DE",
                "type": "string"
              },
              "street": {
                "description": "Street address where company is headquartered.",
                "example": "123 Main St",
                "type": "string"
              },
              "tax_id": {
                "description": "Company Tax ID number.",
                "example": "123456789",
                "type": "string",
                "writeOnly": true
              },
              "website": {
                "description": "Company's official corporate website.",
                "example": "https://example.com",
                "type": "string"
              },
              "zipcode": {
                "description": "Zipcode where company is headquartered.",
                "example": "19801",
                "type": "string"
              }
            },
            "type": "object"
          },
          "compliance_contact_email": {
            "description": "Email for the main point of contact on your side to communicate with Checkr about\ncompliance issues or updates. This is also where we'll send you the results of candidate\ndisputes (for example, if we changed the information on a report).\n",
            "example": "compliance.team@example.com",
            "format": "email",
            "type": "string"
          },
          "created_at": {
            "description": "Time at which the Account was created.",
            "example": "2020-01-07T00:26:49Z",
            "format": "date-time",
            "type": "string"
          },
          "default_compliance_city": {
            "description": "Fallback compliance city if candidate location is not provided.\n",
            "example": "San Francisco",
            "nullable": true,
            "type": "string"
          },
          "default_compliance_state": {
            "description": "Fallback compliance state if candidate location is not provided. Format: `ISO 3166-2:US`.\n",
            "example": "CA",
            "nullable": true,
            "type": "string"
          },
          "geos_required": {
            "default": false,
            "description": "Determines whether a Geo must be provided to order a Report.",
            "type": "boolean"
          },
          "id": {
            "description": "The ID of the Account.\n\n<b>Note: </b>The returned Account ID is dependent on the API token used to make the call.\n  * If an account-level API token is used, the ID of the account associated with the Live API Token will be returned.\n  * If a partner OAuth token is used, the ID of the account (or customer's account) connected to the OAuth application will be returned.\n",
            "type": "string"
          },
          "name": {
            "description": "Name of Account displayed in the Dashboard.",
            "example": "Acme Corp",
            "type": "string"
          },
          "object": {
            "enum": [
              "account"
            ],
            "type": "string"
          },
          "purpose": {
            "default": "employment",
            "description": "Permissible purpose to run background checks.\nDetermines which background checks the Account is credentialed for.\n",
            "enum": [
              "employment",
              "business",
              "insurance",
              "tenant"
            ],
            "type": "string"
          },
          "segmentation_enabled": {
            "default": true,
            "description": "Determines whether Hierarchy/Nodes is enabled on the Account.",
            "type": "boolean"
          },
          "support_email": {
            "description": "Email address used for candidates to contact you if they need to supply evidence\nof rehabilitation or other context during the Adverse Action process.\n",
            "example": "support@example.com",
            "format": "email",
            "nullable": true,
            "type": "string"
          },
          "support_phone": {
            "description": "Phone number used for candidates to contact you if they need to supply evidence of\nrehabilitation or other context during the Adverse Action process.\n",
            "example": "206-555-0188",
            "nullable": true,
            "type": "string"
          },
          "technical_contact_email": {
            "description": "The main point of contact on your side to communicate with Checkr about technical issues or\nupdates.\n",
            "example": "jane.smith@example.com",
            "format": "email",
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "example": "/v1/accounts/e44aa283528e6fde7d542194"
          },
          "uri_name": {
            "description": "Unique slug referencing the Account. This appears in some Account-specific URL paths.\n",
            "example": "acme-corp",
            "pattern": "[a-z0-9-_]+",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Address": {
        "properties": {
          "city": {
            "description": "City.",
            "example": "San Francisco",
            "pattern": "[a-zA-Z0-9 -'.,]*",
            "type": "string"
          },
          "country": {
            "description": "Country.\n\nFormat: `ISO 3166-1 alpha-2`\n",
            "example": "US",
            "type": "string"
          },
          "state": {
            "description": "State.",
            "example": "CA",
            "type": "string"
          },
          "street": {
            "description": "Street address.",
            "example": "123 Main St.",
            "pattern": "[a-zA-Z0-9 -'.,]*",
            "type": "string"
          },
          "unit": {
            "description": "House, building or apartment number.",
            "example": 2000,
            "pattern": "[a-zA-Z0-9 -'.,]*",
            "type": "string"
          },
          "zipcode": {
            "description": "5-digit zip code.",
            "example": "90401",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AdverseAction": {
        "properties": {
          "adverse_items": {
            "description": "Array of Adverse Items on which the Action is based.",
            "items": {
              "$ref": "#/components/schemas/AdverseItem"
            },
            "type": "array"
          },
          "canceled_at": {
            "description": "Time at which the Adverse Action was canceled.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "description": "Time at which the Adverse Action was created.",
            "example": "2016-09-29T17:39:49Z",
            "format": "date-time",
            "type": "string"
          },
          "delivery": {
            "description": "Details about the delivery state of the Adverse Action.",
            "properties": {
              "reason": {
                "description": "Reason for the current state. Typically, this an error message, e.g. the raw response from an email provider.",
                "example": "The email account that you tried to reach does not exist. Please double-check the recipient's email address for typos or unnecessary spaces.",
                "type": "string"
              },
              "state": {
                "description": "Status of delivery for the Adverse Action.",
                "enum": [
                  "none",
                  "queued",
                  "sent",
                  "delivered",
                  "error",
                  "unknown",
                  "unopened"
                ],
                "example": "delivered",
                "type": "string"
              },
              "updated_at": {
                "description": "Time at which the delivery state was updated.",
                "example": "2016-09-29T17:39:49Z",
                "format": "date-time",
                "type": "string"
              }
            },
            "type": "object"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "individualized_assessment_engaged": {
            "default": false,
            "type": "boolean"
          },
          "object": {
            "enum": [
              "adverse_action"
            ],
            "readOnly": true,
            "type": "string"
          },
          "post_notice_ready_at": {
            "description": "Timestamp after which the post notice can be sent. (Often 7 days after `created_at`.)\n",
            "example": "2016-10-06T17:39:48Z",
            "format": "date-time",
            "type": "string"
          },
          "post_notice_scheduled_at": {
            "description": "Timestamp at which the post Adverse Action notification will be sent. This time is\ndependent on the time at which the Pre-Adverse Action was created, and related settings\nwithin your Checkr system.\n",
            "example": "2016-10-07T12:34:00Z",
            "format": "date-time",
            "type": "string"
          },
          "report_id": {
            "description": "ID of the Report causing this adverse action.",
            "example": "b861a56db1b1b89692dd6118",
            "type": "string"
          },
          "status": {
            "description": "Status of the Adverse Action.",
            "enum": [
              "pending",
              "complete",
              "dispute",
              "canceled"
            ],
            "example": "pending",
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "example": "/v1/adverse_actions/57ed51e57619e8002a6683f2"
          }
        },
        "type": "object"
      },
      "AdverseItem": {
        "properties": {
          "assessment": {
            "$ref": "#/components/schemas/AdverseItemAssessment"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "object": {
            "description": "Defines the object type.",
            "enum": [
              "adverse_item"
            ],
            "readOnly": true,
            "type": "string"
          },
          "text": {
            "description": "Human-readable description of the Adverse Item.",
            "example": "License status: Suspended",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AdverseItemAssessment": {
        "description": "Information about the Assessment of the Adverse Item.\n\nIncluded only if Assess is enabled for the account.\n",
        "properties": {
          "rule": {
            "$ref": "#/components/schemas/Rule"
          },
          "value": {
            "$ref": "#/components/schemas/AssessmentValue"
          }
        },
        "type": "object"
      },
      "AssessedObject": {
        "description": "TODO\n",
        "properties": {
          "object_id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "object_type": {
            "enum": [
              "child_abuse_search",
              "criminal_charge",
              "drug_screening",
              "drug_screening_v2",
              "employment_verification",
              "education_verification",
              "global_watchlist_charge",
              "motor_vehicle_report",
              "occupational_health_screening",
              "sex_offender_search"
            ],
            "example": "criminal_charge",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Assessment": {
        "description": "Information about an Assessment of the Report.\n",
        "properties": {
          "created_at": {
            "description": "Time at which the Assessment was created.\n\n<b>Note: </b>This timestame is accurate to the millisecond.\n",
            "example": "2014-01-18T12:34:015Z",
            "format": "date-time",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/AssessmentResult"
            },
            "type": "array"
          },
          "ruleset": {
            "$ref": "#/components/schemas/Ruleset"
          },
          "value": {
            "$ref": "#/components/schemas/AssessmentValue"
          }
        },
        "type": "object"
      },
      "AssessmentAttribute": {
        "description": "The assessment for this screening. This field will be non-null only for Assess-enabled accounts. For accounts with Assess enabled, it will be null for reports completed before Assess was enabled, and null for a short time after report completion while the account's Assess rules are applied.\n",
        "enum": [
          "eligible",
          "review",
          "escalated"
        ],
        "example": "eligible",
        "nullable": true,
        "type": "string"
      },
      "AssessmentResult": {
        "description": "The result of assessing one or more items on the report.\n",
        "properties": {
          "assessed_objects": {
            "items": {
              "$ref": "#/components/schemas/AssessedObject"
            },
            "type": "array"
          },
          "rule": {
            "$ref": "#/components/schemas/Rule"
          },
          "value": {
            "$ref": "#/components/schemas/AssessmentValue"
          }
        },
        "type": "object"
      },
      "AssessmentValue": {
        "enum": [
          "eligible",
          "review",
          "escalated"
        ],
        "example": "eligible",
        "type": "string"
      },
      "BadContinuousCheckRequestError": {
        "properties": {
          "error": {
            "example": "type does not have a valid value",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BadContinuousCheckUpdateRequestError": {
        "properties": {
          "error": {
            "example": "Node cannot be found on your account",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BadHierarchyRequestError": {
        "properties": {
          "error": {
            "example": "nodes cannot be empty",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BadPiiRequestError": {
        "properties": {
          "error": {
            "example": "Candidate has already had PII removed",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BadProfessionalLicenseCreateRequestError": {
        "properties": {
          "error": {
            "example": "license_type is missing",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BadRequestError": {
        "properties": {
          "error": {
            "example": "Dl number 'F211165' does not match the license number format in CA",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Candidate": {
        "properties": {
          "adjudication": {
            "description": "The adjudication for the Candidate\u2019s most recently created Report.",
            "enum": [
              "engaged",
              "pre_adverse_action",
              "post_adverse_action"
            ],
            "type": "string"
          },
          "copy_requested": {
            "default": false,
            "description": "If `true`, the candidate has asked to receive a copy of their report.",
            "type": "boolean"
          },
          "custom_id": {
            "description": "Client-assigned unique ID for the Candidate. Can be used to map Checkr Candidate IDs to your internal tracking system, and to search for Candidates through both the Dashboard and the API.",
            "type": "string"
          },
          "dob": {
            "description": "Candidate\u2019s date of birth.",
            "example": "1970-01-22",
            "format": "date",
            "type": "string"
          },
          "driver_license_number": {
            "description": "Candidate\u2019s driver license number.",
            "example": "F2111655",
            "type": "string"
          },
          "driver_license_state": {
            "description": "Candidate\u2019s driver license state of issue.\nFormat: `ISO 3166-2:US`.\n",
            "example": "CA",
            "type": "string"
          },
          "email": {
            "description": "Candidate\u2019s email address.\n",
            "example": "john.smith@gmail.com",
            "format": "email",
            "type": "string"
          },
          "first_name": {
            "description": "Candidate\u2019s first name.\n",
            "example": "John",
            "minLength": 1,
            "pattern": "^(?=.*[a-zA-Z\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff])[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]*$",
            "type": "string"
          },
          "geo_ids": {
            "description": "Array of Geo IDs.",
            "items": {
              "example": "79f943e212cce7de21c054a8",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "last_name": {
            "description": "Candidate\u2019s last name.",
            "example": "Smith",
            "minLength": 1,
            "pattern": "[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]{2,}",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "middle_name": {
            "description": "Candidate\u2019s middle name. This field is required if `no_middle_name` is `false`.\n",
            "example": "Alfred",
            "pattern": "[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]*",
            "type": "string"
          },
          "mother_maiden_name": {
            "description": "Candidate\u2019s mother\u2019s maiden name.\n",
            "example": "Jones",
            "pattern": "[a-zA-Z0-9\u00aa\u00b5\u00ba\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff\\-'., ]*",
            "type": "string"
          },
          "no_middle_name": {
            "default": false,
            "description": "Required if no `middle_name` is provided. `true` if the candidate has no middle name.\n",
            "type": "boolean"
          },
          "object": {
            "enum": [
              "candidate"
            ],
            "readOnly": true,
            "type": "string"
          },
          "phone": {
            "description": "Candidate\u2019s phone number.",
            "example": 5555555555,
            "nullable": true,
            "type": "string"
          },
          "postal_address": {
            "description": "Candidate's postal address.",
            "example": {
              "city": "San Francisco",
              "name": "John Alfred Smith",
              "state": "CA",
              "street": "123 Main Street",
              "street2": "APT A",
              "zipcode": "94108"
            },
            "type": "object"
          },
          "previous_driver_license_number": {
            "description": "Candidate\u2019s previous driver license number.",
            "example": "F1501739",
            "type": "string"
          },
          "previous_driver_license_state": {
            "description": "State that issued the candidate\u2019s previous driver license.\nFormat: `ISO 3166-2:US`.\n",
            "example": "MD",
            "type": "string"
          },
          "report_ids": {
            "description": "Array of Report IDs.",
            "items": {
              "example": "532e71cfe88a1d4e8d00000d",
              "type": "string"
            },
            "readOnly": true,
            "type": "array"
          },
          "ssn": {
            "description": "Candidate\u2019s Social Security Number. This value will be redacted in all return calls, except for the last four digits.",
            "example": "XXX-XX-4645",
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "example": "/v1/candidates/e44aa283528e6fde7d542194"
          },
          "zipcode": {
            "description": "Candidate\u2019s 5-digit zip code.",
            "example": 90401,
            "type": "string"
          }
        },
        "type": "object"
      },
      "CandidateNotFoundError": {
        "properties": {
          "error": {
            "example": "Candidate not found",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CandidatePostalAddress": {
        "properties": {
          "candidate_id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "city": {
            "description": "City of the Candidate.\n",
            "example": "Santa Monica",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "name": {
            "description": "Name of the Candidate.\n",
            "example": "John Alfred Smith",
            "type": "string"
          },
          "object": {
            "enum": [
              "candidate_postal_address"
            ],
            "readOnly": true,
            "type": "string"
          },
          "state": {
            "description": "State of the Candidate.\n",
            "example": "CA",
            "type": "string"
          },
          "street": {
            "description": "Street address of the Candidate.\n",
            "example": "123 Main St",
            "type": "string"
          },
          "street2": {
            "description": "Additional street address of the Candidate.\n",
            "example": "Apt A",
            "nullable": true,
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "example": "/v1/candidate/e44aa283528e6fde7d542194/postal_address"
          },
          "zipcode": {
            "description": "5-digit zip code of the Candidate.\n",
            "example": "90401",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CandidateRegisteredError": {
        "properties": {
          "error": {
            "example": "candidate_id: <id> already has a form I-9",
