        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X GET https://api.checkr.com/v1/reports/4722c07dd9a10c3985ae432a?include=drug_screening \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9:\n"
          }
        ]
      },
      "parameters": [
        {
          "description": "The Report's ID.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Updates the `package` or `adjudication` for an existing Report resource.\n\nUse this endpoint to update reports which include the candidate's Social Security Number. To update a Report which does not include an SSN, first use the [update Candidate](#operation/updateCandidate) request to add the candidate\u2019s SSN before updating the report.\n\nEither `package` or `adjudication` is required.\n\n<b>Note: </b>This endpoint may also be used to update international reports for candidates which do not include an SSN.\n<div class=\"alert alert-info\">\n\n  **Note**: The Package of a Report cannot be updated if it has an Adverse Action with the status: `complete` or `dispute`. To proceed, cancel the Adverse Action or create a new Report.\n\n</div>\n",
        "operationId": "updateReport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "adjudication": {
                    "enum": [
                      "engaged"
                    ],
                    "example": "engaged",
                    "type": "string"
                  },
                  "package": {
                    "description": "Slug of the Package.\n",
                    "example": "driver_pro",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ReportUpdated"
          },
          "400": {
            "$ref": "#/components/responses/PreExistingAdverseActionError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Update an existing Report",
        "tags": [
          "Reports"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/reports/4722c07dd9a10c3985ae432a \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n    -d package=driver_pro\n"
          }
        ]
      }
    },
    "/reports/{id}/complete": {
      "parameters": [
        {
          "description": "The Report's ID.",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Cancels all pending or suspended screenings and completes the report.\n\nUse this endpoint to complete reports which include pending or suspended screenings. If a report is completed with pending or suspended screenings, the following events will be triggered:\n\n  - The `status` for all in-progress screenings within the report will be updated to `canceled`.\n  - A cancellation reason and the reason\u2019s description will be added to each canceled screening.\n  - Checkr will issue webhooks upon report completion.\n    - If all screenings are canceled, a `report.canceled` webhook will be issued.\n    - If at least one screening has a result before the report is completed, Checkr will issue two webhooks: first, `report.updated`, followed by `report.complete`.\n",
        "operationId": "completeReport",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ReportUpdated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "summary": "Complete an existing Report",
        "tags": [
          "Reports"
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/reports/4722c07dd9a10c3985ae32a/complete \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9\n"
          }
        ]
      }
    },
