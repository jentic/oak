          }
        },
        "type": "object"
      },
      "CandidateStoriesLimitError": {
        "properties": {
          "error": {
            "example": "Candidate stories limit exceeded",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CandidateStory": {
        "properties": {
          "content": {
            "description": "Additional information provided by Candidate.",
            "example": "Since my case, I have received the following certifications (see attachments)",
            "type": "string"
          },
          "created_at": {
            "description": "Time at which the Candidate Story was created.",
            "example": "2020-04-17T07:48:34Z",
            "format": "date-time",
            "type": "string"
          },
          "documents": {
            "description": "Attached documents provided by Candidate.",
            "items": {
              "$ref": "#/components/schemas/CandidateStoryDocument"
            },
            "type": "array"
          },
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "object": {
            "enum": [
              "candidate_story"
            ],
            "readOnly": true,
            "type": "string"
          },
          "record": {
            "description": "Simplified representation of linked record.\nIf `null`, Candidate Story is considered general information about the Candidate.\n",
            "nullable": true,
            "properties": {
              "case_number": {
                "description": "Case number, if existing",
                "example": "NMND78D",
                "nullable": true,
                "type": "string"
              },
              "charge": {
                "description": "Charge description, if existing",
                "example": "LIGHT OFFENSE",
                "nullable": true,
                "type": "string"
              },
              "id": {
                "description": "Record ID",
                "example": "4e2a551f79e0095b35d4d3ca",
                "type": "string"
              },
              "location": {
                "description": "Location of the Record, can be a State, or a City and a State, if existing",
                "example": "San Mateo, CA",
                "nullable": true,
                "type": "string"
              },
              "offense_date": {
                "description": "Offense date, if existing",
                "example": "2020-01-20",
                "format": "date",
                "nullable": true,
                "type": "string"
              }
            },
            "type": "object"
          },
          "report_id": {
            "description": "ID of the Report to which the Candidate Story is linked.",
            "example": "af3393b7d751206c7c67b6e5",
            "type": "string"
          },
          "uri": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceURI"
              }
            ],
            "example": "/v1/candidate_stories/e44aa283528e6fde7d542194"
          }
        },
        "type": "object"
      },
      "CandidateStoryDocument": {
        "properties": {
