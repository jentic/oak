                                  "charge": {
                                    "example": "Sell Cocaine"
                                  },
                                  "defendant": {
                                    "description": "Defendant's name on the record.",
                                    "example": "John Alfred Smith"
                                  },
                                  "sentence_date": {
                                    "description": "Recorded sentence date.",
                                    "example": "2011-06-02"
                                  }
                                },
                                "type": "object"
                              }
                            ]
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  ]
