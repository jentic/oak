            "lang": "curl",
            "source": "$ curl -X GET https://api.checkr.com/v1/candidates/5fb31d36bc2e7f4609aba03d/driver_licenses \\\n     -u 83ebeabdec09f6670863766f792ead24d61fe3f9:"
          }
