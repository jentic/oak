            "lang": "curl",
            "source": "$ curl -X POST https://api.checkr.com/v1/accounts \\\n    -u 83ebeabdec09f6670863766f792ead24d61fe3f9: \\\n    -d client_id=56269e3411a549fd07ed8d92 \\\n    -d name=Acme+Corporation \\\n    -d default_compliance_state=CA \\\n    -d purpose=employment \\\n    -d user[full_name]=Jeanette+Hughes \\\n    -d user[email]=user@example.com \\\n    -d company[dba_name]=Acme \\\n    -d company[industry]=72 \\\n    -d company[street]=123+Main+Street \\\n    -d company[city]=San Francisco \\\n    -d company[state]=CA \\\n    -d company[zipcode]=94107 \\\n    -d company[tax_id]=123456789 \\\n    -d company[incorporation_state]=CA \\\n    -d company[incorporation_type]=association \\\n    -d company[phone]=206-555-0100 \\\n    -d company[website]=https%3A%2F%2Fwww.example.com\n"
          }
        ]
      }
    },
