{
  "openapi": "3.0.3",
  "info": {
    "title": "Buffer API",
    "description": "Buffer's GraphQL API for managing social media publishing. Provides queries for account, organizations, channels, posts, post metrics, daily posting limits, and ideas, plus mutations to create, edit, and delete posts and create ideas. All operations are sent as GraphQL queries or mutations to a single endpoint.",
    "version": "2026-07-01",
    "x-jentic-source-url": "https://developers.buffer.com/",
    "contact": {
      "name": "Buffer API Support",
      "url": "https://developers.buffer.com/"
    }
  },
  "tags": [
    {
      "name": "GraphQL",
      "description": "Buffer GraphQL operations executed against the single API endpoint."
    }
  ],
  "servers": [
    {
      "url": "https://api.buffer.com",
      "description": "Buffer GraphQL endpoint"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "operationId": "graphqlQuery",
        "tags": [
          "GraphQL"
        ],
        "summary": "Execute GraphQL query or mutation",
        "description": "Execute any Buffer GraphQL query or mutation. Queries: account, channel, channels, post, posts, aggregatedPostMetrics, dailyPostingLimits, ideas, ideaGroups. Mutations: createPost, editPost, deletePost, createIdea. Provide the operation in the 'query' field and any arguments in 'variables'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphQLRequest"
              },
              "examples": {
                "account": {
                  "summary": "Get authenticated account and organizations",
                  "value": {
                    "query": "query GetAccount { account { id email backupEmail avatar name timezone createdAt organizations { id name } } }"
                  }
                },
                "channels": {
                  "summary": "List channels for an organization",
                  "value": {
                    "query": "query GetChannels($input: ChannelsInput!) { channels(input: $input) { id name service type } }",
                    "variables": {
                      "input": {
                        "organizationId": "YOUR_ORGANIZATION_ID"
                      }
                    }
                  }
                },
                "channel": {
                  "summary": "Get a single channel by ID",
                  "value": {
                    "query": "query GetChannel($input: ChannelInput!) { channel(input: $input) { id name service type } }",
                    "variables": {
                      "input": {
                        "id": "CHANNEL_ID"
                      }
                    }
                  }
                },
                "post": {
                  "summary": "Get a single post by ID",
                  "value": {
                    "query": "query GetPost($input: PostInput!) { post(input: $input) { id text status dueAt } }",
                    "variables": {
                      "input": {
                        "id": "POST_ID"
                      }
                    }
                  }
                },
                "posts": {
                  "summary": "List posts with pagination",
                  "value": {
                    "query": "query GetPosts($input: PostsInput!, $first: Int, $after: String) { posts(input: $input, first: $first, after: $after) { edges { node { id text status dueAt } cursor } pageInfo { hasNextPage endCursor } } }",
                    "variables": {
                      "input": {
                        "organizationId": "YOUR_ORGANIZATION_ID"
                      },
                      "first": 20
                    }
                  }
                },
                "aggregatedPostMetrics": {
                  "summary": "Aggregate normalized post metrics (Preview)",
                  "value": {
                    "query": "query GetAggregatedPostMetrics($input: AggregatedPostMetricsInput!) { aggregatedPostMetrics(input: $input) { metrics { type name description value unit } } }",
                    "variables": {
                      "input": {
                        "organizationId": "YOUR_ORGANIZATION_ID",
                        "startDateTime": "2026-01-01T00:00:00Z",
                        "endDateTime": "2026-01-31T23:59:59Z"
                      }
                    }
                  }
                },
                "dailyPostingLimits": {
                  "summary": "Get daily posting limit status for channels",
                  "value": {
                    "query": "query GetDailyPostingLimits($input: DailyPostingLimitsInput!) { dailyPostingLimits(input: $input) { channelId sent scheduled limit isAtLimit } }",
                    "variables": {
                      "input": {
                        "channelIds": [
                          "CHANNEL_ID"
                        ]
                      }
                    }
                  }
                },
                "ideas": {
                  "summary": "List ideas with pagination",
                  "value": {
                    "query": "query GetIdeas($input: IdeasInput!, $first: Int, $after: String) { ideas(input: $input, first: $first, after: $after) { edges { node { id content } } pageInfo { hasNextPage endCursor } } }",
                    "variables": {
                      "input": {
                        "organizationId": "YOUR_ORGANIZATION_ID"
                      },
                      "first": 20
                    }
                  }
                },
                "ideaGroups": {
                  "summary": "List idea groups for an organization",
                  "value": {
                    "query": "query GetIdeaGroups($input: IdeaGroupsInput!) { ideaGroups(input: $input) { id name } }",
                    "variables": {
                      "input": {
                        "organizationId": "YOUR_ORGANIZATION_ID"
                      }
                    }
                  }
                },
                "createPost": {
                  "summary": "Create a scheduled post",
                  "value": {
                    "query": "mutation CreatePost($input: CreatePostInput!) { createPost(input: $input) { post { id status text dueAt } } }",
                    "variables": {
                      "input": {
                        "channelId": "CHANNEL_ID",
                        "schedulingType": "SCHEDULED",
                        "dueAt": "2026-02-01T12:00:00Z",
                        "text": "Hello from the Buffer API"
                      }
                    }
                  }
                },
                "editPost": {
                  "summary": "Edit an existing post",
                  "value": {
                    "query": "mutation EditPost($input: EditPostInput!) { editPost(input: $input) { post { id status text dueAt } } }",
                    "variables": {
                      "input": {
                        "id": "POST_ID",
                        "text": "Updated post text"
                      }
                    }
                  }
                },
                "deletePost": {
                  "summary": "Delete a post by ID",
                  "value": {
                    "query": "mutation DeletePost($input: DeletePostInput!) { deletePost(input: $input) { id } }",
                    "variables": {
                      "input": {
                        "id": "POST_ID"
                      }
                    }
                  }
                },
                "createIdea": {
                  "summary": "Create a new idea",
                  "value": {
                    "query": "mutation CreateIdea($input: CreateIdeaInput!) { createIdea(input: $input) { idea { id content } } }",
                    "variables": {
                      "input": {
                        "organizationId": "YOUR_ORGANIZATION_ID",
                        "content": "A great content idea"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL response. Note that GraphQL returns HTTP 200 even for operation-level errors, which are reported in the 'errors' array.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphQLResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (malformed JSON or query)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid Bearer token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Buffer API access token. Obtain a token at https://publish.buffer.com/settings/api and send it as 'Authorization: Bearer YOUR_TOKEN'."
      }
    },
    "schemas": {
      "GraphQLRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "GraphQL query or mutation string"
          },
          "variables": {
            "type": "object",
            "description": "Variables for the GraphQL operation",
            "additionalProperties": true
          },
          "operationName": {
            "type": "string",
            "description": "Name of the operation to execute when the query contains multiple operations"
          }
        }
      },
      "GraphQLResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "The response data for the executed operation. The top-level key matches the operation field name, e.g. { account }, { channels }, { posts }, { dailyPostingLimits }, { aggregatedPostMetrics }, { ideas }, { ideaGroups } for queries, and { createPost }, { editPost }, { deletePost }, { createIdea } for mutations.",
            "additionalProperties": true
          },
          "errors": {
            "type": "array",
            "description": "Operation-level errors, if any",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "extensions": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
