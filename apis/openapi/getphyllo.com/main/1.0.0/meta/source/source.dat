{
  "openapi": "3.0.3",
  "info": {
    "title": "Phyllo Creator Economy API",
    "description": "Phyllo provides a unified API for accessing creator economy data across social media and commerce platforms. It enables retrieval of creator identity, engagement metrics, income transactions, and audience demographics from platforms like YouTube, Instagram, TikTok, Twitch, and more.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.getphyllo.com/"
  },
  "servers": [
    {
      "url": "https://api.getphyllo.com",
      "description": "Production API server"
    },
    {
      "url": "https://api.sandbox.getphyllo.com",
      "description": "Sandbox API server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/v1/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "Retrieve all users",
        "description": "Returns a paginated list of all users created in your Phyllo account.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 },
            "description": "Maximum number of items to return"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 },
            "description": "Number of items to skip"
          }
        ],
        "responses": {
          "200": {
            "description": "List of users retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/User" }
                    },
                    "metadata": { "$ref": "#/components/schemas/PaginationMetadata" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Create a user",
        "description": "Creates a new user in Phyllo. Users represent the creators whose data you want to access.",
        "tags": ["Connect"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Display name of the user"
                  },
                  "external_id": {
                    "type": "string",
                    "description": "Your unique identifier for the user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/users/{user_id}": {
      "get": {
        "operationId": "getUser",
        "summary": "Retrieve a user",
        "description": "Returns the details of a specific user by their ID.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the user"
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/users/external_id/{external_id}": {
      "get": {
        "operationId": "getUserByExternalId",
        "summary": "Retrieve user by external ID",
        "description": "Returns user details using your external identifier.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "external_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Your external identifier for the user"
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/sdk-tokens": {
      "post": {
        "operationId": "createSdkToken",
        "summary": "Create an SDK token",
        "description": "Generates an SDK token used to initialize the Phyllo Connect SDK for a specific user.",
        "tags": ["Connect"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id", "products"],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The ID of the user"
                  },
                  "products": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["IDENTITY", "ENGAGEMENT", "INCOME"] },
                    "description": "Products to enable for this SDK session"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SDK token created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sdk_token": { "type": "string" },
                    "expires_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/work-platforms": {
      "get": {
        "operationId": "listWorkPlatforms",
        "summary": "Retrieve all work platforms",
        "description": "Returns a list of supported work platforms (e.g., YouTube, Instagram, TikTok).",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          },
          {
            "name": "name",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by platform name"
          }
        ],
        "responses": {
          "200": {
            "description": "List of work platforms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/WorkPlatform" }
                    },
                    "metadata": { "$ref": "#/components/schemas/PaginationMetadata" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/work-platforms/{work_platform_id}": {
      "get": {
        "operationId": "getWorkPlatform",
        "summary": "Retrieve a work platform",
        "description": "Returns details of a specific work platform by ID.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "work_platform_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the work platform"
          }
        ],
        "responses": {
          "200": {
            "description": "Work platform retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkPlatform" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "Retrieve all accounts",
        "description": "Returns a paginated list of connected accounts.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          },
          {
            "name": "user_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" },
            "description": "Filter by user ID"
          },
          {
            "name": "work_platform_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" },
            "description": "Filter by work platform ID"
          }
        ],
        "responses": {
          "200": {
            "description": "List of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Account" }
                    },
                    "metadata": { "$ref": "#/components/schemas/PaginationMetadata" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/accounts/{account_id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Retrieve an account",
        "description": "Returns details of a specific connected account.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the account"
          }
        ],
        "responses": {
          "200": {
            "description": "Account retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "operationId": "updateAccount",
        "summary": "Update account monitoring settings",
        "description": "Updates the monitoring configuration for a connected account.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "identity": { "type": "object" },
                      "engagement": { "type": "object" },
                      "income": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/accounts/{account_id}/disconnect": {
      "post": {
        "operationId": "disconnectAccount",
        "summary": "Disconnect an account",
        "description": "Disconnects a connected creator account from monitoring.",
        "tags": ["Connect"],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Account disconnected successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/profiles": {
      "get": {
        "operationId": "listProfiles",
        "summary": "Retrieve all profiles",
        "description": "Returns a paginated list of creator profiles with identity information.",
        "tags": ["Identity"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          },
          {
            "name": "account_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "user_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "work_platform_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Profile" }
                    },
                    "metadata": { "$ref": "#/components/schemas/PaginationMetadata" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/profiles/{profile_id}": {
      "get": {
        "operationId": "getProfile",
        "summary": "Retrieve a profile",
        "description": "Returns identity details of a specific creator profile.",
        "tags": ["Identity"],
        "parameters": [
          {
            "name": "profile_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Profile" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/profiles/refresh": {
      "post": {
        "operationId": "refreshProfile",
        "summary": "Refresh profile data",
        "description": "Triggers a refresh of profile data for the specified account.",
        "tags": ["Identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["account_id"],
                "properties": {
                  "account_id": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile refresh initiated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/audience": {
      "get": {
        "operationId": "getAudienceDemographics",
        "summary": "Retrieve audience demographics",
        "description": "Returns audience demographic data for a creator account.",
        "tags": ["Identity"],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Audience data retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AudienceData" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/social/contents": {
      "get": {
        "operationId": "listSocialContents",
        "summary": "Retrieve all content items",
        "description": "Returns a paginated list of social media content items (posts, videos, stories).",
        "tags": ["Engagement"],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "from_date",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to_date",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of content items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ContentItem" }
                    },
                    "metadata": { "$ref": "#/components/schemas/PaginationMetadata" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/social/contents/{content_id}": {
      "get": {
        "operationId": "getSocialContent",
        "summary": "Retrieve a content item",
        "description": "Returns details of a specific social media content item.",
        "tags": ["Engagement"],
        "parameters": [
          {
            "name": "content_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Content item retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContentItem" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/social/contents/refresh": {
      "post": {
        "operationId": "refreshSocialContents",
        "summary": "Refresh content items",
        "description": "Triggers a refresh of social content data for the specified account.",
        "tags": ["Engagement"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["account_id"],
                "properties": {
                  "account_id": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Content refresh initiated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/social/contents/search": {
      "post": {
        "operationId": "searchSocialContents",
        "summary": "Retrieve content items in bulk",
        "description": "Returns multiple content items by their IDs.",
        "tags": ["Engagement"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ids"],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Content items retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ContentItem" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/social/content-groups": {
      "get": {
        "operationId": "listContentGroups",
        "summary": "Retrieve all content groups",
        "description": "Returns a paginated list of content groups (e.g., playlists, albums).",
        "tags": ["Engagement"],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "from_date",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to_date",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of content groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ContentGroup" }
                    },
                    "metadata": { "$ref": "#/components/schemas/PaginationMetadata" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/social/content-groups/{content_group_id}": {
      "get": {
        "operationId": "getContentGroup",
        "summary": "Retrieve a content group",
        "description": "Returns details of a specific content group.",
        "tags": ["Engagement"],
        "parameters": [
          {
            "name": "content_group_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Content group retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContentGroup" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/social/comments": {
      "get": {
        "operationId": "listSocialComments",
        "summary": "Retrieve all comments",
        "description": "Returns a paginated list of comments on social content.",
        "tags": ["Engagement"],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "from_date",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to_date",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "offset",
