    "/ticket/ticketExternalId/reply": {
      "post": {
        "description": "Add a new reply to an existing ticket based on the externalId. This endpoint accepts one single object like the one in the replies array in the ticket structure.\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
