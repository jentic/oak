          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/financial/deal/:entity?itemsPerPage=20&page=1' \\\n -X GET \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json'"
          }
        ]
      },
      "post": {
        "description": "You can create a new financial deal or update an existing one by sending a POST request to [https://api.custify.com/financial/deal/{entity}](https://api.custify.com/financial/deal/{entity}), where {entity} is the Custify internal `id` of the Financial Deal.\nAlternatively, you can create/update financial deals by sending a POST request to [https://api.custify.com/financial/deal](https://api.custify.com/financial/deal) that has in the body the field `externalId`, where `externalId` is your internal ID of the deal.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/entityFinancial"
          }
        ],
        "requestBody": {
