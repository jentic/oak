        "x-code-samples": [
          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/ticket/ticketExternalId/reply' \\\n -X POST \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json' -d ' \n{\n  \"jobs\": [\n    {\n      \"type\": \"people\",\n      \"payload\": {\n        \"name\": \"John Doe\",\n        \"user_id\": \"batch_1\",\n        \"email\": \"john.doe@outlook.com\"\n      }\n    }\n  ],\n  \"synchronous\": false,\n  \"returnJobId\": \"35757461-c988-5508-9f80-68bd45a99bf9\"\n}'"
          }
        ]
      }
    },
    "/ticket/{entity}": {
      "get": {
        "description": "You can fetch a list of tickets associated with a specific company or person by sending a GET request to [https://api.custify.com/ticket/{entity}](https://api.custify.com/ticket/{entity}), where {entity} is the Custify internal ID of either a company or a person.\n\nThe endpoint automatically detects whether the provided ID belongs to a company or a person and returns all tickets associated with that entity. The list, by default, is sorted by the `openedAt` field and in `descending` order, with the most recent tickets first.\n\n### Filtering tickets\nIf you want to apply filters to the `/ticket/{entity}` endpoint, you would need to send the `filters` query parameter as an URL-encoded array of objects. The filtering logic is similar to other entities:\n```json\n[\n    {\n        \"field\": \"ticketStatus\",\n        \"values\": [\"open\", \"pending\"]\n    },\n    {\n        \"field\": \"priority\",\n        \"values\": [\"high\"]\n    }\n]\n```\n\n### Search\nYou can search tickets using the `searchTerm` query parameter. The search will look through ticket title, description, and other text fields.\n",
        "parameters": [
          {
            "description": "Custify internal ID of the company or person",
            "in": "path",
            "name": "entity",
            "required": true,
            "schema": {
              "example": "5ea93252e0263c08145d6944",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/itemsPerPageMax200"
          },
          {
            "$ref": "#/components/parameters/pageParam"
          },
          {
            "description": "Field to sort by",
            "in": "query",
            "name": "sort",
            "schema": {
              "default": "openedAt",
              "example": "openedAt",
              "type": "string"
            }
          },
          {
            "description": "Sort order (asc or desc)",
            "in": "query",
            "name": "order",
            "schema": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "desc",
              "type": "string"
            }
          },
          {
            "description": "The resource items filters",
            "in": "query",
            "name": "filters",
            "schema": {
              "items": {
                "$ref": "#/components/schemas/ListingTicketFilter"
              },
              "type": "array"
            }
          },
          {
            "description": "Search term to filter tickets",
            "in": "query",
            "name": "searchTerm",
            "schema": {
              "example": "login issue",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "tickets": {
                      "description": "Array of ticket objects",
                      "items": {
                        "$ref": "#/components/schemas/TicketListing"
                      },
                      "type": "array"
                    },
                    "total": {
                      "description": "Total number of tickets matching the query",
                      "example": 25,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "404": {
            "description": "Entity not found"
          },
          "500": {
            "description": "Some other error occurred"
          }
        },
        "summary": "List tickets for a specific company or person",
        "tags": [
          "Tickets"
        ],
        "x-code-samples": [
          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/ticket/5ea93252e0263c08145d6944?itemsPerPage=20&page=1&sort=openedAt&order=desc' \\\n -X GET \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json'"
          }
        ]
      }
    },
    "/time-track": {
      "delete": {
        "description": "Delete an existing time track based on the Custify internal ID (in the query params).\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Bad request (invalid request syntax)"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "Some other error occurred"
          }
        },
        "summary": "Delete an existing time track",
        "tags": [
          "Time Tracking"
        ],
        "x-code-samples": [
          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/time_track/{:id}\\\n -X DELETE \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json'"
          }
        ]
      },
      "get": {
        "description": "List the time tracks. You can send additional query params to filter or paginate results, like:\n- `company` (Custify company internal ID) or `company_id` (your internal company ID) - filters time tracks by which company/companies they are assigned to.\n- `people` (Custify people internal ID) or `user_id` (your internal user ID) or `email` - filters time tracks by which people they are assigned to.\n- `tags` - filters time tracks by tags, the values being Custify IDs of Tags.\n- `start_date` - filters time tracks by the start date of the time track.\n- `end_date` - filters time tracks by the end date of the time track.\n- `user` - filters time tracks by the user who created the time track. It can be the Custify internal ID of the user or the email of the user.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/itemsPerPageMax50"
          },
          {
            "$ref": "#/components/parameters/pageParam"
          },
          {
            "$ref": "#/components/parameters/sortingParam"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "time_track": {
                      "description": "An array of objects with the details of the time tracks",
                      "items": {
                        "$ref": "#/components/schemas/TimeTrackListing"
                      },
                      "type": "array"
                    },
                    "total": {
                      "description": "Total number of time tracks",
                      "example": 1,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "500": {
            "description": "Some other error occurred"
          }
        },
        "summary": "List the time tracks",
        "tags": [
          "Time Tracking"
        ],
        "x-code-samples": [
          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/time_track?itemsPerPage=20&page=1' \\\n -X GET \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json'"
          }
        ]
      },
      "post": {
        "description": "Create a new time track on Companies or People. When adding a time track for a Company, you need to provide the `company` field in the body of the request or the `company_id` in the query params. When adding a time track for a People, you need to provide the `people` field in the body of the request or the `user_id` pr `email` in the query params.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/userParamRequired"
          },
          {
            "$ref": "#/components/parameters/companyIdParam"
          },
          {
            "$ref": "#/components/parameters/userIdParam"
          },
          {
            "$ref": "#/components/parameters/emailParam"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeTrack"
              }
            }
          },
          "description": "Time track request object",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeTrackListing"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "500": {
            "description": "Some other error occurred"
          }
        },
        "summary": "Create a new time track",
        "tags": [
          "Time Tracking"
        ]
      },
      "put": {
        "description": "Update an existing time track on Companies or People. When adding a time track for a Company, you need to provide the `company` field in the body of the request or the `company_id` in the query params. When adding a time track for a People, you need to provide the `people` field in the body of the request or the `user_id` pr `email` in the query params.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/userParamRequired"
          },
          {
            "$ref": "#/components/parameters/companyIdParam"
          },
          {
            "$ref": "#/components/parameters/userIdParam"
          },
          {
            "$ref": "#/components/parameters/emailParam"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeTrack"
              }
            }
          },
          "description": "Time track request object",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeTrackListing"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "500": {
            "description": "Some other error occurred"
          }
        },
        "summary": "Update an exiting time track",
        "tags": [
          "Time Tracking"
        ]
      }
    }
  },
