            "source": "curl 'https://api.custify.com/financial/deal?externalId=abc\\\n -X DELETE \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json'"
          }
        ]
      },
      "get": {
        "description": "List the financial deals. When the result of the request is only one financial deal the response will be directly the financial deal object.\n",
