        "properties": {
          "comment": {
            "description": "The optional comment left by the respondent",
            "example": "Great product, very easy to use!",
            "type": "string"
          },
          "company": {
            "description": "The ID of the company associated with the survey response",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "email": {
            "description": "The email address of the respondent",
            "example": "john.doe@mail.com",
            "type": "string"
          },
          "extraQuestions": {
            "description": "Answers to any additional questions configured in the survey",
            "items": {
              "properties": {
                "answer": {
                  "description": "The answer provided (can be a string, number, boolean or array of strings)",
                  "example": "Dashboard analytics"
                },
                "question": {
                  "description": "The extra question text",
                  "example": "What feature do you value the most?",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "description": "The Custify internal ID of the survey response",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "name": {
            "description": "The name of the respondent",
            "example": "John Doe",
            "type": "string"
          },
          "people": {
            "description": "The ID of the person associated with the survey response",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "responseDate": {
            "description": "The date and time when the response was submitted",
            "example": "2024-03-15T14:30:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "score": {
            "description": "The score given by the respondent. For NPS surveys the score ranges from 0 to 10. For CSAT surveys the score ranges from 1 to 5.",
            "example": 9,
            "type": "integer"
          }
        },
        "required": [
