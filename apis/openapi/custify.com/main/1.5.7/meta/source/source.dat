{
  "components": {
    "parameters": {
      "batchJobId": {
        "description": "ID of the batch job id.",
        "example": "35757461-c988-5508-9f80-68bd45a99bf9",
        "in": "path",
        "name": "id",
        "schema": {
          "type": "string"
        }
      },
      "categoryParam": {
        "description": "The resource items category.",
        "example": "company",
        "in": "query",
        "name": "category",
        "schema": {
          "default": "all",
          "type": "string"
        }
      },
      "companyIdParam": {
        "description": "Your internal ID of the company.",
        "example": "2345",
        "in": "query",
        "name": "company_id",
        "schema": {
          "type": "string"
        }
      },
      "companyIdQuery": {
        "description": "Custify internal ID of the company.",
        "example": "5b9f95d838ab5e09b8ed66cb",
        "in": "query",
        "name": "companyId",
        "schema": {
          "type": "string"
        }
      },
      "companyParam": {
        "description": "The Custify internal ID of the company.",
        "example": "5b9f95d838ab5e09b8ed66cb",
        "in": "query",
        "name": "company",
        "schema": {
          "type": "string"
        }
      },
      "emailParam": {
        "description": "Person `email` address.",
        "example": "john.doe_at_example.com",
        "in": "query",
        "name": "email",
        "schema": {
          "type": "string"
        }
      },
      "entity": {
        "description": "The Custify internal entity ID.",
        "example": "5b9f95d838ab5e09b8ed66cb",
        "in": "path",
        "name": "entity",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "entityFinancial": {
        "description": "The Custify internal entity ID of the financial entity (deal, invoice or subscription).",
        "example": "5b9f95d838ab5e09b8ed66cb",
        "in": "path",
        "name": "entity",
        "schema": {
          "type": "string"
        }
      },
      "entityModel": {
        "description": "companies or people, depending on the entity type",
        "example": "companies",
        "in": "path",
        "name": "entityModel",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "entityModelComment": {
        "description": "Note or Task, depending on the entity type",
        "example": "Note",
        "in": "path",
        "name": "entityModel",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "entityNotRequired": {
        "description": "The Custify internal entity ID.",
        "example": "5b9f95d838ab5e09b8ed66cb",
        "in": "path",
        "name": "entity",
        "schema": {
          "type": "string"
        }
      },
      "filteringParam": {
        "description": "The resource items filters.",
        "in": "query",
        "name": "filters",
        "schema": {
          "items": {
            "$ref": "#/components/schemas/ListingFilter"
          },
          "type": "array"
        }
      },
      "filteringProperties": {
        "description": "The resource items properties that will be returned (if they exist). If not set, all properties will be returned.",
        "in": "query",
        "name": "properties",
        "schema": {
          "example": [
            "name",
            "email"
          ],
          "type": "array"
        }
      },
      "filteringTaskParam": {
        "description": "The resource items filters.",
        "in": "query",
        "name": "filters",
        "schema": {
          "items": {
            "$ref": "#/components/schemas/ListingTaskFilter"
          },
          "type": "array"
        }
      },
      "financialExternalId": {
        "description": "External ID of the financial entity (deal, invoice or subscription).",
        "example": "abc",
        "in": "path",
        "name": "externalId",
        "schema": {
          "type": "string"
        }
      },
      "includeSegmentsParam": {
        "description": "If this field is set to `true` the response will include the segments of the resource. Default value is `false`. In the response, the segments will be in the `segments` field and will be an array of objects each one containing the fields `id` (the ID of the segment) and `name` (the name of the segment).",
        "in": "query",
        "name": "includeSegments",
        "schema": {
          "default": "false",
          "type": "string"
        }
      },
      "itemsPerPageMax200": {
        "description": "The resource number of items per page.",
        "example": 20,
        "in": "query",
        "name": "itemsPerPage",
        "schema": {
          "default": 20,
          "maximum": 200,
          "type": "integer"
        }
      },
      "itemsPerPageMax50": {
        "description": "The resource number of items per page.",
        "example": 20,
        "in": "query",
        "name": "itemsPerPage",
        "schema": {
          "default": 20,
          "maximum": 50,
          "type": "integer"
        }
      },
      "limitParam": {
        "description": "The resource number of items per page. Default value is `20`.",
        "example": 25,
        "in": "query",
        "name": "itemsPerPage",
        "schema": {
          "type": "integer"
        }
      },
      "orderParam": {
        "description": "The resource items order direction.",
        "example": "asc",
        "in": "query",
        "name": "order",
        "schema": {
          "type": "string"
        }
      },
      "pageParam": {
        "description": "The resource current page.",
        "example": 7,
        "in": "query",
        "name": "page",
        "schema": {
          "default": 1,
          "type": "integer"
        }
      },
      "peopleIdQuery": {
        "description": "Custify internal ID of the people.",
        "example": "5b9f95d838ab5e09b8ed66cc",
        "in": "query",
        "name": "peopleId",
        "schema": {
          "type": "string"
        }
      },
      "resourceId": {
        "description": "The Custify internal resource identifier string.",
        "example": "5b9f95d838ab5e09b8ed66cb",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "resourceIdOptional": {
        "description": "The Custify internal resource identifier string.",
        "example": "5b9f95d838ab5e09b8ed66cb",
        "in": "path",
        "name": "id",
        "schema": {
          "type": "string"
        }
      },
      "searchKeyQuery": {
        "description": "Search string to be used in filtering file names.",
        "example": "document",
        "in": "query",
        "name": "searchKey",
        "schema": {
          "type": "string"
        }
      },
      "sortParam": {
        "description": "The resource items sort field.",
        "example": "updated_at",
        "in": "query",
        "name": "sort",
        "schema": {
          "type": "string"
        }
      },
      "sortingParam": {
        "description": "The resource items sorting object. This param should be an object, like: {\"field\": \"updated_at\", \"direction\": \"desc\"} and must be encoded.",
        "in": "query",
        "name": "sorting",
        "schema": {
          "type": "object"
        }
      },
      "ticketExternalId": {
        "description": "External ID of the ticket.",
        "example": "ab",
        "in": "path",
        "name": "ticketExternalId",
        "schema": {
          "type": "string"
        }
      },
      "typeParam": {
        "description": "The type of the resource.",
        "example": "company",
        "in": "query",
        "name": "type",
        "schema": {
          "type": "string"
        }
      },
      "userIdParam": {
        "description": "Your internal `user_id`.",
        "example": "36",
        "in": "query",
        "name": "user_id",
        "schema": {
          "type": "string"
        }
      },
      "userParamRequired": {
        "description": "The email address of the user or the Custify internal ID of the user.",
        "example": "john.doe@example.com",
        "in": "query",
        "name": "user",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "AccessForbidden": {
        "description": "Access forbidden, invalid API-KEY was used"
      },
      "Conflict": {
        "description": "There's a conflict with the expected format or details that need to be sent in the request"
      },
      "NotFound": {
        "description": "Resource was not found"
      }
    },
    "schemas": {
      "Batch": {
        "properties": {
          "jobs": {
            "description": "The jobs array of objects",
            "example": [
              {
                "payload": {
                  "email": "john.doe@outlook.com",
                  "name": "John Doe",
                  "user_id": "batch_1"
                },
                "type": "people"
              },
              {
                "payload": {
                  "company_id": "batch_company_1",
                  "name": "John's Company",
                  "website": "www.johnscompany.com"
                },
                "type": "company"
              },
              {
                "payload": {
                  "created_at": "2022-01-17T13:00:00.000Z",
                  "name": "event_from_batch",
                  "user_id": "batch_1"
                },
                "type": "event"
              },
              {
                "payload": {
                  "data": {
                    "amount": 175,
                    "invoiced_at": "2023-02-02T00:00:00Z",
                    "is_paid": false,
                    "product_name": "bronze_plan"
                  },
                  "data_id": "INV_003",
                  "data_type": "invoice",
                  "entity": "65240f85e2a675bd3090a3d3",
                  "entityModel": "Company"
                },
                "type": "custom-data"
              }
            ],
            "type": "array"
          },
          "returnJobId": {
            "description": "The job id of the processing used in case synchronous is false",
            "example": false,
            "type": "boolean"
          },
          "synchronous": {
            "description": "The type of the processing",
            "example": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "CSATScore": {
        "properties": {
          "comment": {
            "description": "The comment for the CSAT score",
            "example": "Very satisfied",
            "type": "string"
          },
          "score": {
            "description": "The score for the CSAT score (typically 1-5)",
            "example": 5,
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          },
          "submittedAt": {
            "description": "Date for the CSAT score",
            "example": "2021-04-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "surveyId": {
            "description": "The survey id for the CSAT score",
            "example": "5d402cf8c3a4c5578c9be5f4",
            "type": "string"
          }
        },
        "required": [
          "score"
        ],
        "type": "object"
      },
      "CalculatedMetricsListing": {
        "properties": {
          "created_at": {
            "description": "The date the calculated metric was created in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          },
          "description": {
            "description": "The description of the calculated metric",
            "example": "This is the first calculated metric",
            "type": "string"
          },
          "frequency": {
            "description": "The frequency of the calculated metric (number of hours)",
            "example": 12,
            "type": "number"
          },
          "id": {
            "description": "The Custify internal ID of the calculated metric",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "name": {
            "description": "The name of the calculated metric",
            "example": "First calculated metric",
            "type": "string"
          },
          "tags": {
            "description": "An array of the tags to apply to the calculated metric. Valid tag IDs are Custify internal IDs tags having category `calculated_metric`",
            "items": {
              "$ref": "#/components/schemas/TagsList"
            },
            "type": "array"
          },
          "type": {
            "description": "The type of the calculated metric (company or people)",
            "example": "company",
            "type": "string"
          },
          "updated_at": {
            "description": "The date the calculated metric was updated in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "Comment": {
        "properties": {
          "createdBy": {
            "description": "Custify's internal ID of the user which left the comment. It can be also the email of the user",
            "example": "john.doe@test.com",
            "type": "string"
          },
          "id": {
            "description": "ID of the comment (used to update an existing comment).",
            "example": "5ed60ea90494f32ff3959079",
            "type": "string"
          },
          "text": {
            "description": "Comment's text.",
            "example": "First comment",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "CommentListing": {
        "properties": {
          "createdBy": {
            "description": "Custify's internal ID of the user which left the comment.",
            "example": "5ed60ea90494f32ff3959079",
            "type": "string"
          },
          "entity": {
            "description": "The Custify internal id of the entity (Note or Task).",
            "example": "5ed60ea90494f32ff3959079",
            "type": "string"
          },
          "entityModel": {
            "description": "Note or Task.",
            "example": "Note",
            "type": "string"
          },
          "text": {
            "description": "Comment's text.",
            "example": "First comment",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Company": {
        "properties": {
          "churned": {
            "default": false,
            "description": "Defines if a company has churned. Default value is false; if set to true, company will be considered as churned.",
            "type": "boolean"
          },
          "company_id": {
            "description": "The company id you've defined for the company.",
            "example": "6",
            "type": "string"
          },
          "custom_attributes": {
            "description": "A JSON object of key/value pairs containing any other data about the company.",
            "example": {
              "custom": "template",
              "restaurants": 5
            },
            "type": "object"
          },
          "industry": {
            "description": "The industry that this company operates in.",
            "example": "Restaurant",
            "type": "string"
          },
          "monthly_revenue": {
            "description": "How much revenue the company generates for your business.",
            "example": 1234567,
            "type": "integer"
          },
          "name": {
            "description": "The name of the company.",
            "example": "Pizzeria Presto",
            "type": "string"
          },
          "owners_account": {
            "description": "The email adderess of the Account manager assigned to this company. A user with this email must exist in Custify to be assigned.",
            "example": "john.doe@mail.com",
            "type": "string"
          },
          "owners_csm": {
            "description": "The email adderess of the CSM assigned to this company. A user with this email must exist in Custify to be assigned.",
            "example": "john.doe@mail.com",
            "type": "string"
          },
          "parent_companies": {
            "description": "An array of IDs of the parent_companies associated with the current company.",
            "example": [
              {
                "id": "5ec50c9829d3c17c7cf455f2"
              },
              {
                "id": "5ec50c9829d3c17c7cf457f2"
              }
            ],
            "type": "array"
          },
          "plan": {
            "description": "The plan this company is subscribed to.",
            "example": "Platinum",
            "type": "string"
          },
          "signed_up_at": {
            "description": "The company signup date or date the contract started.",
            "example": "2019-05-30T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "size": {
            "description": "The number of employees in this company.",
            "example": 15,
            "type": "integer"
          },
          "website": {
            "description": "The URL for this company's website.",
            "example": "www.pizzeriapresto.com",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CustomData": {
        "properties": {
          "data": {
            "description": "Key-value list of the custom data object properties",
            "example": {
              "amount": 123,
              "invoiced_at": "2019-06-30T12:00:00.000Z",
              "is_paid": true,
              "plan": "advanced"
            },
            "type": "object"
          },
          "data_id": {
            "description": "Your ID for the custom data object",
            "example": "INV_001",
            "type": "string"
          },
          "data_type": {
            "description": "The type of custom data object",
            "example": "invoice",
            "type": "string"
          }
        },
        "required": [
          "data_type",
          "data_id",
          "data"
        ],
        "type": "object"
      },
      "CustomDataListing": {
        "properties": {
          "data": {
            "description": "The data object of the custom data",
            "example": {
              "campaign": 1,
              "opened": false,
              "priority": "high",
              "scheduled": "2020-12-02T00:00:00.000Z"
            },
            "type": "object"
          },
          "data_id": {
            "description": "The data id of the custom data",
            "example": "MSG_001",
            "type": "string"
          },
          "data_type": {
            "description": "The data type of the custom data",
            "example": "messages",
            "type": "string"
          }
        },
        "required": [
          "data_type",
          "data_id",
          "data"
        ],
        "type": "object"
      },
      "Event": {
        "properties": {
          "company_id": {
            "description": "A unique String identifier for the company, created via the \"companies\" API. Optional.",
            "example": "20",
            "type": "string"
          },
          "created_at": {
            "description": "The time the event occurred in your application.",
            "example": "2019-07-01T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "deduplication_id": {
            "description": "An identifier of the event. If present, subsequent events with the same identifier will be ignored",
            "example": "5d95ecc9749204521d2e3945",
            "type": "string"
          },
          "email": {
            "description": "The person's email address, previously created via the \"people\" API. Required if no user_id is present.",
            "example": "test@example.org",
            "type": "string"
          },
          "metadata": {
            "description": "Optional metadata about the event.",
            "example": {
              "code": "ABCDEF",
              "email": "john@example.org"
            },
            "type": "object"
          },
          "name": {
            "description": "Name of the event.",
            "example": "login",
            "type": "string"
          },
          "user_id": {
            "description": "A unique String identifier for the person, created via the \"people\" API. Required if no email is present.",
            "example": "1",
            "type": "string"
          }
        },
        "required": [
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "File": {
        "properties": {
          "companyId": {
            "description": "The Custify internal ID of the company",
            "example": "5ea93252e0263c08145d6944",
            "type": "string"
          },
          "file": {
            "description": "The file to be uploaded",
            "format": "binary",
            "type": "string"
          },
          "peopleId": {
            "description": "The Custify internal ID of the people",
            "example": "5ea93252e0263c08145d6944",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "FileList": {
        "example": "5d11d5687113bc33f07573f0",
        "type": "string"
      },
      "FileShowInPortal": {
        "properties": {
          "showInPortal": {
            "description": "Enable/Disable the file to be shown in the portal",
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "showInPortal"
        ],
        "type": "object"
      },
      "FileUnlink": {
        "properties": {
          "companyId": {
            "description": "The Custify internal ID of the company",
            "example": "5ea93252e0263c08145d6949",
            "type": "string"
          },
          "fileId": {
            "description": "The Custify internal ID of the file",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "peopleId": {
            "description": "The Custify internal ID of the people",
            "example": "5ea93252e0263c08145d694a",
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ],
        "type": "object"
      },
      "FileUploadListing": {
        "properties": {
          "account": {
            "description": "Custify's internal ID of the account",
            "example": "5ea93252e0263c08145d6946",
            "type": "string"
          },
          "companies": {
            "description": "An array of the companies the file belongs to",
            "example": [
              "5ea93252e0263c08145d6947"
            ],
            "type": "array"
          },
          "created_at": {
            "description": "The date the file was uploaded in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          },
          "extension": {
            "description": "The extension of the file",
            "example": "pdf",
            "type": "string"
          },
          "id": {
            "description": "Custify's internal ID of the file",
            "example": "5ea93252e0263c08145d6945",
            "type": "string"
          },
          "mimeType": {
            "description": "The mime type of the file",
            "example": "application/pdf",
            "type": "string"
          },
          "name": {
            "description": "The name of the file",
            "example": "Document.pdf",
            "type": "string"
          },
          "peoples": {
            "description": "An array of the people the file belongs to",
            "example": [
              "5ea93252e0263c08145d6948"
            ],
            "type": "array"
          },
          "showInPortal": {
            "description": "Enable/Disable the file to be shown in the portal",
            "example": true,
            "type": "boolean"
          },
          "size": {
            "description": "The size of the file",
            "example": 1447260,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "account",
          "extension",
          "mimeType",
          "name",
          "size",
          "created_at",
          "showInPortal"
        ],
        "type": "object"
      },
      "FilesListing": {
        "properties": {
          "files": {
            "description": "An array of file objects that are linked to the specified entity",
            "items": {
              "$ref": "#/components/schemas/FileUploadListing"
            },
            "type": "array"
          },
          "total": {
            "description": "Total number of files",
            "example": 15,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "files"
        ],
        "type": "object"
      },
      "FinancialDeal": {
        "properties": {
          "addedAt": {
            "description": "The date the financial deal was added.",
            "example": "2022-04-01T12:00:00.000Z",
            "format": "date-time"
          },
          "company": {
            "description": "Custify's internal ID of the company for which the financial deal is created/updated",
            "example": "5ea93252e0263c08145d6944",
            "type": "string"
          },
          "company_id": {
            "description": "Your internal identifier of the company",
            "example": "20",
            "type": "string"
          },
          "externalId": {
            "description": "Your internal ID of the financial deal.",
            "example": "deal01",
            "type": "string"
