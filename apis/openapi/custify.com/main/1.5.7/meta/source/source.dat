      "Ticket": {
        "properties": {
          "assignedToName": {
            "description": "The name of the person that the ticket is assigned to",
            "example": "John",
            "type": "string"
          },
          "company": {
            "description": "The company id you've defined for the company.",
            "example": "6",
            "type": "string"
          },
          "description": {
            "description": "The description of the ticket",
            "example": "Description of the ticket",
            "type": "string"
          },
          "externalId": {
            "description": "The external ID of the ticket (used in your system).",
            "example": "ab",
            "type": "string"
          },
          "lastModifiedAt": {
            "description": "The date the ticket was last modified",
            "example": "2021-05-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "openedAt": {
            "description": "The date the ticket was opened",
            "example": "2021-04-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "people": {
            "description": "The user_id or the email you've defined for the people.",
            "example": "15",
            "type": "string"
          },
          "priority": {
            "description": "The priority of the ticket",
            "example": "high",
            "type": "string"
          },
          "replies": {
            "description": "The replies to the ticket",
            "example": [
              {
                "body": "Take a look",
                "from": "John",
                "submittedAt": "2021-05-10T12:00:00.000Z",
                "type": "note|incoming|outgoing"
              }
            ],
            "type": "array"
          },
          "ticketStatus": {
            "description": "The status of the ticket",
            "example": "open",
            "type": "string"
          },
          "title": {
            "description": "The title of the ticket",
            "example": "First ticket",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TicketListing": {
        "properties": {
          "assignedTo": {
            "description": "The identifier of the person the ticket is assigned to",
            "example": "john.doe@example.com",
            "type": "string"
          },
          "assignedToName": {
            "description": "The name of the person the ticket is assigned to",
            "example": "John Doe",
            "type": "string"
          },
          "company": {
            "description": "Array of Custify internal IDs of the companies associated with the ticket",
            "example": [
              "5ea93252e0263c08145d6944"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "companyNames": {
            "description": "Array of company name objects associated with the ticket (enriched data)",
            "example": [
              {
                "forte": "Acme Corp"
              }
            ],
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "created_at": {
            "description": "The date the ticket was created in Custify",
            "example": "2021-04-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "The description of the ticket",
            "example": "User is unable to login using their credentials on the mobile app",
            "type": "string"
          },
          "externalId": {
            "description": "The external ID of the ticket (used in your system)",
            "example": "TICKET-123",
            "type": "string"
          },
          "id": {
            "description": "Custify's internal ID of the ticket",
            "example": "5ea93252e0263c08145d6945",
            "type": "string"
          },
          "lastModifiedAt": {
            "description": "The date the ticket was last modified",
            "example": "2021-05-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "openedAt": {
            "description": "The date the ticket was opened",
            "example": "2021-04-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "people": {
            "description": "Array of people objects associated with the ticket",
            "example": [
              {
                "id": "60b4d002e1a59a7c74531fcad"
              }
            ],
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "peopleNames": {
            "description": "Array of people names associated with the ticket (enriched data)",
            "example": [
              "John Doe"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "priority": {
            "description": "The priority of the ticket",
            "example": "high",
            "type": "string"
          },
          "provider": {
            "description": "The provider/source system of the ticket",
            "example": "zendesk",
            "type": "string"
          },
          "rating": {
            "description": "The rating given to the ticket",
            "example": "5",
            "type": "string"
          },
          "ratingAt": {
            "description": "The date the ticket was rated",
            "example": "2021-04-15T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "description": "The internal status of the ticket (active or inactive)",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active",
            "type": "string"
          },
          "tags": {
            "description": "Array of tag IDs associated with the ticket",
            "example": [
              "5d11d5687113bc33f07573f0"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ticketStatus": {
            "description": "The status of the ticket",
            "example": "open",
            "type": "string"
          },
          "title": {
            "description": "The title of the ticket",
            "example": "Login issue with mobile app",
            "type": "string"
          },
          "updated_at": {
            "description": "The date the ticket was last updated in Custify",
            "example": "2021-05-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TicketReply": {
        "properties": {
          "body": {
            "description": "The body of the reply.",
            "example": "Take a look",
            "type": "string"
          },
          "from": {
            "description": "The name of the person from where the reply is coming.",
            "example": "John",
            "type": "string"
          },
          "submittedAt": {
            "description": "The date the reply was submitted",
            "example": "2021-05-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "description": "The type of the reply. Available values are note, incoming and outgoing.",
            "example": "note",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TimeTrack": {
        "properties": {
          "company": {
            "description": "Custify's internal ID of the company for which the time tracking is created/updated",
            "example": "5ea93252e0263c08145d6944",
            "type": "string"
          },
          "duration": {
            "description": "The duration in seconds of the time tracking",
            "example": 3600,
            "type": "integer"
          },
          "name": {
            "description": "The name of the time tracking",
            "example": "First time tracking",
            "type": "string"
          },
          "people": {
            "description": "Custify's internal ID of the people for which the time tracking is created/updated",
            "example": "5ea93252e0263c08145d6944",
            "type": "string"
          },
          "startedDate": {
            "description": "The date the time tracking was started",
            "example": "2022-04-01T12:00:00.000Z",
            "format": "date-time"
          },
          "tags": {
            "description": "An array of the tags to apply to the time tracking. Valid tag IDs are Custify internal IDs tags having category `time_tracker`",
            "items": {
              "$ref": "#/components/schemas/TagsList"
            },
            "type": "array"
          }
        },
        "required": [
          "duration",
          "name",
          "startedDate"
        ],
        "type": "object"
      },
      "TimeTrackListing": {
        "properties": {
          "company": {
            "description": "An array of the companies the time tracking belongs to",
            "example": [
              "5ea93252e0263c08145d6947"
            ],
            "type": "array"
          },
          "created_at": {
            "description": "The date the time tracking was created in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          },
          "duration": {
            "description": "The duration in seconds of the time tracking",
            "example": 3600,
            "type": "integer"
          },
          "id": {
            "description": "The Custify internal ID of the time tracking",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "name": {
            "description": "The name of the time tracking",
            "example": "First time tracking",
            "type": "string"
          },
          "people": {
            "description": "An array of the people the time tracking belongs to",
            "example": [
              "5ea93252e0263c08145d6948"
            ],
            "type": "array"
          },
          "startDate": {
            "description": "The date the time tracking was started",
            "example": "2022-04-01T12:00:00.000Z",
            "format": "date-time"
          },
          "tags": {
            "description": "An array of the tags to apply to the time tracking. Valid tag IDs are Custify internal IDs tags having category `time_tracker`",
            "items": {
              "$ref": "#/components/schemas/TagsList"
            },
            "type": "array"
          },
          "updated_at": {
            "description": "The date the time tracking was updated in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          },
          "user": {
            "description": "The Custify internal ID of the user who created (or for whom) the time tracking is created",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "duration",
          "startDate"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAUTH": {
        "bearerFormat": "Bearer <API_KEY>",
        "scheme": "bearer",
        "type": "http"
      }
    }
