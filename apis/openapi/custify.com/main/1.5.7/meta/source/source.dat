    "/survey/{id}/responses": {
      "get": {
        "description": "You can get the responses for a specific survey by sending a GET request to [https://api.custify.com/survey/{id}/responses](https://api.custify.com/survey/{id}/responses), where `{id}` is the Custify internal ID of the survey.\n\nThe response includes the list of individual survey responses with the respondent's email, name, score, comment, response date and any extra question answers. Results are sorted by response date in descending order (most recent first).\n\nThis endpoint is useful for exporting survey data per survey, allowing you to identify which survey a response belongs to (e.g., when you have multiple NPS surveys for different products).\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceId"
          },
          {
            "$ref": "#/components/parameters/itemsPerPageMax50"
          },
          {
            "$ref": "#/components/parameters/pageParam"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyResponsesResult"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "404": {
            "description": "Survey not found"
          }
        },
        "summary": "Get survey responses",
        "tags": [
          "Surveys"
        ],
        "x-code-samples": [
          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/survey/5ea93252e0263c08145d6948/responses?itemsPerPage=20&page=1' \\\n -X GET \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json'"
          }
        ]
      }
    },
    "/tag/entity": {
      "patch": {
        "description": "Tags can be added/removed to/from multiple entities of the same category by sending a PATCH request to the URL `https://api.custify.com/tag/entity`.\n",
