      "Task": {
        "properties": {
          "assignedTo": {
            "description": "Custify's internal ID of the user to which the task is assigned. It can be also the email of the user",
            "example": "john.doe@test.com",
            "type": "string"
          },
          "assignedToCustomer": {
            "description": "Field value is set to true if the task is assigned to a customer",
            "example": false,
            "type": "boolean"
          },
          "checklist": {
            "description": "An array of checklist objects that are attached to the task",
            "items": {
              "$ref": "#/components/schemas/TaskChecklist"
            },
            "type": "array"
          },
          "collaborators": {
            "description": "An array of Custify internal IDs of the people that are collaborators on the task. It also accepts the email of the user.",
            "items": {
              "example": "5ea93252e0263c08145d6945",
              "type": "string"
            },
            "type": "array"
          },
          "company": {
            "description": "Custify's internal ID of the company for which the task is created/updated",
            "example": "5ea93252e0263c08145d6944",
            "type": "string"
          },
          "company_id": {
            "description": "Your internal identifier of the company",
            "example": "20",
            "type": "string"
          },
          "description": {
            "description": "The description of the task",
            "example": "Description of the task",
            "type": "string"
          },
          "dueDate": {
            "description": "The due date of the task",
            "example": "2022-04-01T12:00:00.000Z",
            "format": "date-time"
          },
          "externalId": {
            "description": "Your internal task ID",
            "example": "abc",
            "type": "string"
          },
          "files": {
            "description": "An array of file ids that are attached to the task",
            "items": {
              "$ref": "#/components/schemas/FileList"
            },
            "type": "array"
          },
          "name": {
            "description": "The name of the task",
            "example": "First task",
            "type": "string"
          },
          "people": {
            "description": "Custify's internal ID of the people from the company for which the task is created/updated",
            "example": "5ea93252e0263c08145d6945",
            "type": "string"
          },
          "priority": {
            "description": "The priority of the task",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "example": "medium",
            "type": "string"
          },
          "showInPortal": {
            "description": "Mark if the task should be shown in the portal. Default is `false`.",
            "example": false,
            "type": "boolean"
          },
          "status": {
            "default": "open",
            "description": "The status of the task",
            "enum": [
              "open",
              "done",
              "not relevant"
            ],
            "example": "open",
            "type": "string"
          },
          "tags": {
            "description": "An array of the tags to apply to the task. Valid tag IDs are Custify internal IDs tags having category `task`",
            "items": {
              "$ref": "#/components/schemas/TagsList"
            },
            "type": "array"
          },
          "user_id": {
            "description": "Your internal identifier of the people",
            "example": "20",
            "type": "string"
          }
        },
        "required": [
          "name",
          "priority",
          "status"
        ],
        "type": "object"
      },
