        "required": [
          "score"
        ],
        "type": "object"
      },
      "Note": {
        "properties": {
          "entity": {
            "description": "The Custify internal id of the entity (Customer or Company).",
            "example": "5ed60ea90494f32ff3959079",
            "type": "string"
          },
          "entityModel": {
            "description": "Customer (for People) or Company.",
            "example": "Company",
            "type": "string"
          },
          "files": {
            "description": "An array of file ids that are attached to the note",
            "items": {
              "$ref": "#/components/schemas/FileList"
            },
            "type": "array"
          },
          "metadata": {
            "description": "An object with some extra metadata for notes",
            "properties": {
              "mentionedUsers": {
                "description": "An array of mentioned users in the note. The array may contain Custify user IDs or email of the user",
                "items": {
                  "$ref": "#/components/schemas/NoteMentionedUsers"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "showInPortal": {
            "description": "Mark if the note should be shown in the portal. Default is `false`.",
            "example": false,
            "type": "boolean"
          },
          "sticky": {
            "description": "Mark if the note it's sticky or not. Default is `false`.",
            "example": false,
            "type": "boolean"
          },
          "tags": {
            "description": "An array of the tags to apply to the note. Valid tag IDs are Custify internal IDs tags having category `note`",
            "items": {
              "$ref": "#/components/schemas/TagsList"
            },
            "type": "array"
          },
          "text": {
            "description": "Text of the note.",
            "example": "First note",
            "type": "string"
          }
        },
        "required": [
          "text",
          "entity",
          "entityModel"
        ],
        "type": "object"
      },
      "NoteMentionedUsers": {
        "example": "5d11d5687113bc33f07573f0",
        "type": "string"
      },
      "ObjectiveListing": {
        "properties": {
          "assignedTo": {
            "description": "The ID of the entity assigned to this objective. The value depends on the assignment type:\n- If assigned to a User (internal team member): Contains the User ID from Custify\n- If assigned to a Customer (person/contact): Contains the Customer ID from Custify\n- If assigned to Customer but no specific person is selected: Contains the string \"Customer\"\n",
            "example": "5ea93252e0263c08145d6950",
            "type": "string"
          },
          "assignedToName": {
            "description": "The name of the entity assigned to this objective. The value depends on the assignment type:\n- If assigned to a User: Contains the User's name from Custify\n- If assigned to a Customer: Contains the Customer's name from Custify\n- If assigned to Customer but no specific person is selected: null\n",
            "example": "John Smith",
            "nullable": true,
            "type": "string"
          },
          "collaborators": {
            "description": "An array of collaborators on this objective. Each collaborator has a name and entity ID.\nCollaborators can be Users (internal team members), Customers (people/contacts), or External collaborators.\n",
            "example": [
              {
                "entity": "66152404f5a78cb0a2512127",
                "name": "Collaborator 1"
              },
              {
                "entity": "655cb9430a400bc0eac7633b",
                "name": "Collaborator 2"
              }
            ],
            "items": {
              "properties": {
                "entity": {
                  "description": "The Custify internal ID of the collaborator entity",
                  "example": "5ea93252e0263c08145d6951",
                  "type": "string"
                },
                "name": {
                  "description": "The name of the collaborator",
                  "example": "Jane Doe",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "company": {
            "description": "The Custify internal ID of the company this objective belongs to",
            "example": "5fa0366f7ebb2b60c9f4dc03",
            "type": "string"
          },
          "completedAt": {
            "description": "The date the objective was completed",
            "example": "2024-05-20T10:30:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "completionAttribute": {
            "description": "The company attribute used for automatic completion calculation (only when completionType is attribute_based)",
            "example": "custom_attributes.onboarding_score",
            "type": "string"
          },
          "completionPercentage": {
            "description": "The completion percentage of the objective (0 to 100)",
            "example": 65,
            "type": "number"
          },
          "completionType": {
            "description": "How the completion percentage is calculated",
            "enum": [
              "manual",
              "attribute_based"
            ],
            "example": "manual",
            "type": "string"
          },
          "created_at": {
            "description": "The date the objective was created in Custify",
            "example": "2024-01-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "The description of the objective",
            "example": "Ensure the customer adopts all core features within 90 days",
            "type": "string"
          },
          "dueAt": {
            "description": "The due date of the objective",
            "example": "2024-06-30T00:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "health": {
            "description": "The health rating of the objective (0 to 5)",
            "example": 4,
            "type": "number"
          },
          "id": {
            "description": "The Custify internal ID of the objective",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "importance": {
            "description": "The importance level of the objective",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "example": "high",
            "type": "string"
          },
          "name": {
            "description": "The name of the objective",
            "example": "Increase product adoption",
            "type": "string"
          },
          "objectiveStatus": {
            "description": "The current status of the objective",
            "enum": [
              "not_started",
              "in_progress",
              "paused",
              "archived",
              "abandoned",
              "completed"
            ],
            "example": "in_progress",
            "type": "string"
          },
          "risk": {
            "description": "The risk level of the objective",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "example": "medium",
            "type": "string"
          },
          "startAt": {
            "description": "The start date of the objective",
            "example": "2024-01-15T00:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "tags": {
            "description": "An array of tag IDs associated with the objective",
            "example": [
              "5ea93252e0263c08145d6948"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at": {
            "description": "The date the objective was last updated in Custify",
            "example": "2024-03-15T14:30:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "valueBaseline": {
            "description": "The baseline value for attribute-based completion tracking",
            "example": "0",
            "type": "string"
          },
          "valueCurrent": {
            "description": "The current value for attribute-based completion tracking",
            "example": "65",
            "type": "string"
          },
          "valueTarget": {
            "description": "The target value for attribute-based completion tracking",
            "example": "100",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "People": {
        "properties": {
          "companies": {
            "description": "A list of companies you wish to assign; usually, this is one company.",
            "example": [
              {
                "company_id": "366"
              }
            ],
            "type": "array"
          },
          "custom_attributes": {
            "description": "A hash of key/value pairs containing any other data you want to store in Custify.",
            "example": {
              "bool_paid_subscriber": true,
              "date_example_date_at": "2019-06-30T12:00:00.000Z",
              "int_team_mates": 5,
              "string_plan": "advanced"
            },
            "type": "object"
          },
          "email": {
            "description": "The person's email address. Required on creation if a user_id is not supplied.",
            "example": "john.doe@mail.com",
            "type": "string"
          },
          "name": {
            "description": "The person's full name.",
            "example": "John Doe",
            "type": "string"
          },
          "phone": {
            "description": "The person's phone number.",
            "example": "+44 7911 123456",
            "type": "string"
          },
          "session_count": {
            "description": "The person's session count.",
            "example": 2,
            "type": "integer"
          },
          "signed_up_at": {
            "description": "The person's signup date or date the contract started.",
            "example": "2019-05-30T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "unsubscribed_from_calls": {
            "default": false,
            "description": "A Boolean value representing the person's unsubscribed status from calls that you have collected from other systems. Default value is false.",
            "type": "boolean"
          },
          "unsubscribed_from_emails": {
            "default": false,
            "description": "A Boolean value representing the person's unsubscribed status from emails that you've collected from other systems. Default value is false.",
            "type": "boolean"
          },
          "user_id": {
            "description": "A unique string identifier for people. Required on creation if an email isn't supplied.",
            "example": "25",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PeopleTag": {
