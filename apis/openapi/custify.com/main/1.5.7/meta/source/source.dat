      "LifecycleListing": {
        "properties": {
          "created_at": {
            "description": "The date the lifecycle was created in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          },
          "created_by": {
            "description": "The Custify internal ID of the user who created the lifecycle",
            "example": "619614c208f44122f75dfea2",
            "type": "string"
          },
          "created_by_name": {
            "description": "The name of the user who created the lifecycle",
            "example": "John Doe",
            "type": "string"
          },
          "daysToComplete": {
            "description": "Number of days to complete the lifecycle",
            "example": "30",
            "type": "string"
          },
          "daysToStuck": {
            "description": "Number of days until lifecycle is considered stuck",
            "example": "7",
            "type": "string"
          },
          "description": {
            "description": "The description of the lifecycle",
            "example": "Customer onboarding process",
            "type": "string"
          },
          "endCondition": {
            "description": "The end condition of the lifecycle",
            "enum": [
              "all goals are reached",
              "manually completed",
              "enters segment",
              "leaves segment",
              "all tasks are done",
              "all goals and all tasks are completed",
              "custom condition"
            ],
            "example": "all goals are reached",
            "type": "string"
          },
          "endConditionEntityName": {
            "description": "The name of the entity associated with the end condition",
            "example": "Onboarded customers",
            "type": "string"
          },
          "goals": {
            "description": "An array of lifecycle goals",
            "items": {
              "properties": {
                "criteria": {
                  "example": "profile_completed",
                  "type": "string"
                },
                "id": {
                  "example": "5ea93252e0263c08145d6949",
                  "type": "string"
                },
                "name": {
                  "example": "Complete profile",
                  "type": "string"
                },
                "segment": {
                  "example": "5ea93252e0263c08145d694a",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "description": "The Custify internal ID of the lifecycle",
            "example": "5ea93252e0263c08145d6948",
            "type": "string"
          },
          "name": {
            "description": "The name of the lifecycle",
            "example": "Onboarding lifecycle",
            "type": "string"
          },
          "position": {
            "description": "The position of the lifecycle in the list",
            "example": 1,
            "type": "number"
          },
          "settings": {
            "description": "Additional settings for the lifecycle",
            "type": "object"
          },
          "showInC360": {
            "description": "Whether the lifecycle is shown in Company 360",
            "example": true,
            "type": "boolean"
          },
          "startCondition": {
            "description": "The start condition of the lifecycle",
            "enum": [
              "manually started",
              "enters segment",
              "leaves segment",
              "is in segment",
              "another lifecycle finishes",
              "custom condition"
            ],
            "example": "enters segment",
            "type": "string"
          },
          "startConditionEntityName": {
            "description": "The name of the entity associated with the start condition",
            "example": "New customers",
            "type": "string"
          },
          "status": {
            "description": "The status of the lifecycle (active or inactive)",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active",
            "type": "string"
          },
          "tags": {
            "description": "An array of tag IDs associated with the lifecycle",
            "example": [
              "5d11d5687113bc33f07573f0"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tasks": {
            "description": "An array of task templates associated with the lifecycle",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "updated_at": {
            "description": "The date the lifecycle was updated in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          },
          "updated_by": {
            "description": "The Custify internal ID of the user who last updated the lifecycle",
            "example": "619614c208f44122f75dfea2",
            "type": "string"
          },
          "updated_by_name": {
            "description": "The name of the user who last updated the lifecycle",
            "example": "John Doe",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
