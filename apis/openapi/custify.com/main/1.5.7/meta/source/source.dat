          },
          "tags": {
            "description": "An array of the tags to apply to the meeting. Valid tag IDs are Custify internal IDs tags having category `meeting`",
            "items": {
              "$ref": "#/components/schemas/TagsList"
            },
            "type": "array"
          },
          "title": {
            "description": "The title of the meeting",
            "example": "First meeting",
            "type": "string"
          },
          "updated_at": {
            "description": "The date the meeting was updated in Custify",
            "example": "2022-10-01T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "Message": {
        "properties": {
