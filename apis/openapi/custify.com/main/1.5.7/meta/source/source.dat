        ],
        "x-code-samples": [
          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/financial/deal' \\\n -X POST \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json' -d ' \n{\n  \"externalId\": \"deal01\"\n  \"company_id\": \"123\"\n  \"status\": \"pending\"\n}'"
