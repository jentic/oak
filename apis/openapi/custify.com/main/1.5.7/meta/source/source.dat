          }
        ]
      }
    },
    "/task": {
      "get": {
        "description": "List the tasks.\n### Filtering tasks\nIf you want to apply filters to the LIST endpoint, you would need to send the filters query parameter as an URL-encoded array of objects as follows:\n```json\n[\n    {\n        field: \"createdBy\", //the field to filter by\n        values: ['629dfbc3e827ed3cd0de1a53',\u2026] //the values\n    },\n    ...\n]\n```\nThe logic applied to filtering is `OR` between different values for the same field and `AND` between different fields, for example:\n```\n(createdBy='value1' OR createdBy='value2') AND (status='value3' OR status='value4')\n```\n\nThe following fields can be filtered (including what can be sent in the values array):\n- `createdBy` - filters tasks by who/what they were created by. The allowed values are Custify IDs of Users, Playbooks and Lifecycles that have created the task\n- `company` - filters tasks by which company/companies they are assigned to. The values are Custify IDs for Companies\n- `assignedTo` - filters tasks by which User they are assigned to. The values are Custify IDs of Users or emails\n- `tags` - filters tasks by tags, the values being Custify IDs of Tags\n- `status` - filters tasks by status, the possible values being: `open`, `done`, `not relevant`, `snoozed` and `overdue`\n\nExtra filtering can be archived by using the `searchTerm` query parameter and should be a string. This will filter tasks by the name of the task or the description of the task.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/itemsPerPageMax50"
          },
          {
            "$ref": "#/components/parameters/pageParam"
          },
          {
            "$ref": "#/components/parameters/sortingParam"
          },
          {
            "$ref": "#/components/parameters/filteringTaskParam"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "tasks": {
                      "description": "An array of objects with the details of the tasks",
                      "items": {
                        "$ref": "#/components/schemas/TaskListing"
                      },
                      "type": "array"
                    },
                    "total": {
                      "description": "Total number of tasks",
                      "example": 1,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "500": {
            "description": "Some other error occurred"
          }
        },
        "summary": "List the tasks",
        "tags": [
          "Tasks"
        ],
        "x-code-samples": [
          {
            "lang": "Curl",
            "source": "curl 'https://api.custify.com/task?itemsPerPage=20&page=1' \\\n -X GET \\\n -H 'Authorization: Bearer <Your access token>' \\\n -H 'Accept: application/json' \\\n -H 'Content-Type: application/json'"
          }
        ]
      },
      "post": {
        "description": "Create a new task on Companies.\n### Dynamic data in tasks\nThe task `description` accepts dynamic data fields that are being automatically populated with data from either the Company or the Person that it is being assigned to.\n\nIn order use dynamic data, it should be sent as follows: `{company:name}` or `{people:name}`.\n\nIn order to use custom attributes, metrics or health scores in the dynamic data, they should be sent in a dot-notation format, as follows:\n- `{company:custom_attributes.account_owner}`\n- `{company:metrics.people_count}`\n- `{company:metrics.calculated_metrics.calculatedMetricID}`\n- `{company:metrics.health_scores.healthScoreID}`\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Task"
              }
            }
          },
          "description": "Task request object",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListing"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "$ref": "#/components/responses/AccessForbidden"
          },
          "500": {
            "description": "Some other error occurred"
          }
        },
        "summary": "Create a new task",
        "tags": [
          "Tasks"
        ]
      }
    },
