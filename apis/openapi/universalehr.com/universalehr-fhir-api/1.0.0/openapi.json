{
  "openapi": "3.0.3",
  "info": {
    "title": "UniversalEHR FHIR API",
    "version": "1.0.0",
    "description": "UniversalEHR (EMR Direct) provides a FHIR STU 3 API for accessing patient health records. The API supports OAuth 2.0 authorization and provides access to patient demographics, conditions, medications, allergies, observations, procedures, immunizations, and clinical documents (CCDA).",
    "x-jentic-source-url": "https://www.universalehr.com/EMR/"
  },
  "servers": [
    {
      "url": "https://{baseUrl}",
      "description": "FHIR server base URL (varies by healthcare provider organization)",
      "variables": {
        "baseUrl": {
          "default": "fhir.universalehr.com",
          "description": "Base URL obtained from the healthcare provider organization"
        }
      }
    }
  ],
  "paths": {
    "/Patient": {
      "get": {
        "operationId": "searchPatients",
        "summary": "Search patients",
        "description": "Search for patients by family name, birthdate, or other criteria.",
        "tags": ["Patient"],
        "parameters": [
          { "name": "family", "in": "query", "description": "Patient family name", "required": false, "schema": { "type": "string" } },
          { "name": "birthdate", "in": "query", "description": "Patient birth date", "required": false, "schema": { "type": "string", "format": "date" } },
          { "name": "given", "in": "query", "description": "Patient given name", "required": false, "schema": { "type": "string" } },
          { "name": "gender", "in": "query", "description": "Patient gender", "required": false, "schema": { "type": "string", "enum": ["male", "female", "other", "unknown"] } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of matching patients", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/Patient/{id}": {
      "get": {
        "operationId": "getPatient",
        "summary": "Get patient by ID",
        "description": "Retrieve a specific patient record.",
        "tags": ["Patient"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Patient ID", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Patient resource", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Patient" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/Condition": {
      "get": {
        "operationId": "getConditions",
        "summary": "Search conditions",
        "description": "Search patient conditions/diagnoses.",
        "tags": ["Clinical"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } },
          { "name": "onset", "in": "query", "description": "Date filter", "required": false, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of conditions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/MedicationStatement": {
      "get": {
        "operationId": "getMedicationStatements",
        "summary": "Search medication statements",
        "description": "Search patient medication statements.",
        "tags": ["Clinical"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } },
          { "name": "effective", "in": "query", "description": "Date filter", "required": false, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of medication statements", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/AllergyIntolerance": {
      "get": {
        "operationId": "getAllergyIntolerances",
        "summary": "Search allergy intolerances",
        "description": "Search patient allergy and intolerance records.",
        "tags": ["Clinical"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of allergies", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/Observation": {
      "get": {
        "operationId": "getObservations",
        "summary": "Search observations",
        "description": "Search patient observations (lab results, vitals, etc.).",
        "tags": ["Clinical"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } },
          { "name": "date", "in": "query", "description": "Date filter", "required": false, "schema": { "type": "string", "format": "date" } },
          { "name": "category", "in": "query", "description": "Observation category", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of observations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/Procedure": {
      "get": {
        "operationId": "getProcedures",
        "summary": "Search procedures",
        "description": "Search patient procedures.",
        "tags": ["Clinical"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } },
          { "name": "date", "in": "query", "description": "Date filter", "required": false, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of procedures", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/Immunization": {
      "get": {
        "operationId": "getImmunizations",
        "summary": "Search immunizations",
        "description": "Search patient immunization records.",
        "tags": ["Clinical"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of immunizations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/CareTeam": {
      "get": {
        "operationId": "getCareTeams",
        "summary": "Search care teams",
        "description": "Search patient care team information.",
        "tags": ["Clinical"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of care teams", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    },
    "/DocumentReference": {
      "get": {
        "operationId": "getDocumentReferences",
        "summary": "Search document references",
        "description": "Search patient clinical documents including CCDA documents.",
        "tags": ["Documents"],
        "parameters": [
          { "name": "patient", "in": "query", "description": "Patient ID", "required": true, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "description": "Document type code", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "FHIR Bundle of document references", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bundle" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationOutcome" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Bundle": {
        "type": "object",
        "properties": {
          "resourceType": { "type": "string", "enum": ["Bundle"] },
          "type": { "type": "string" },
          "total": { "type": "integer" },
          "entry": { "type": "array", "items": { "type": "object", "properties": { "resource": { "type": "object" } } } }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "resourceType": { "type": "string", "enum": ["Patient"] },
          "id": { "type": "string" },
          "name": { "type": "array", "items": { "type": "object", "properties": { "family": { "type": "string" }, "given": { "type": "array", "items": { "type": "string" } } } } },
          "gender": { "type": "string" },
          "birthDate": { "type": "string", "format": "date" }
        }
      },
      "OperationOutcome": {
        "type": "object",
        "properties": {
          "resourceType": { "type": "string", "enum": ["OperationOutcome"] },
          "issue": { "type": "array", "items": { "type": "object", "properties": { "severity": { "type": "string" }, "code": { "type": "string" }, "diagnostics": { "type": "string" } } } }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://{baseOAuthURL}/authz",
            "tokenUrl": "https://{baseOAuthURL}/token",
            "scopes": {
              "patient/*.read": "Read access to patient data",
              "openid": "OpenID Connect"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": []
    }
  ]
}