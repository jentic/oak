{
  "openapi": "3.0.3",
  "info": {
    "title": "Mapbox API",
    "description": "Mapbox mapping platform APIs including Geocoding v6, Directions v5, and Static Images. Provides forward/reverse geocoding, turn-by-turn routing, and static map image generation.",
    "version": "6.0.0",
    "contact": {
      "name": "Mapbox",
      "url": "https://docs.mapbox.com/api/"
    },
    "x-jentic-source-url": "https://docs.mapbox.com/api/"
  },
  "x-jentic-provenance": "jentic-generated",
  "servers": [
    {
      "url": "https://api.mapbox.com",
      "description": "Mapbox API"
    }
  ],
  "security": [
    {
      "accessToken": []
    }
  ],
  "paths": {
    "/search/geocode/v6/forward": {
      "get": {
        "operationId": "geocodeForward",
        "summary": "Forward geocode a text query to coordinates",
        "description": "Converts a text search query (address, place name, etc.) into geographic coordinates. Supports both free-form text and structured input.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free-form text search query (use this OR structured parameters, not both)",
            "schema": {
              "type": "string"
            },
            "example": "1600 Pennsylvania Ave NW, Washington DC"
          },
          {
            "name": "address_number",
            "in": "query",
            "required": false,
            "description": "Street address number (structured input)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "street",
            "in": "query",
            "required": false,
            "description": "Street name (structured input)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "place",
            "in": "query",
            "required": false,
            "description": "City or place name (structured input)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "State or region (structured input)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "postcode",
            "in": "query",
            "required": false,
            "description": "Postal code (structured input)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "description": "Mapbox access token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "autocomplete",
            "in": "query",
            "required": false,
            "description": "Enable autocomplete results",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "description": "Bounding box to bias results (minLon,minLat,maxLon,maxLat)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Comma-separated ISO 3166-1 alpha-2 country codes to limit results",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "IETF language tag for results",
            "schema": {
              "type": "string"
            },
            "example": "en"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results (1-10)",
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 10
            }
          },
          {
            "name": "proximity",
            "in": "query",
            "required": false,
            "description": "Bias results toward a location (longitude,latitude or 'ip')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "description": "Comma-separated feature types to filter (country, region, postcode, district, place, locality, neighborhood, street, block, address, secondary_address, poi)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "worldview",
            "in": "query",
            "required": false,
            "description": "Worldview for disputed boundaries (us, cn, in, jp)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "permanent",
            "in": "query",
            "required": false,
            "description": "Whether results will be stored permanently",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection of geocoding results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid access token"
          },
          "403": {
            "description": "Forbidden - insufficient token scopes"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/search/geocode/v6/reverse": {
      "get": {
        "operationId": "geocodeReverse",
        "summary": "Reverse geocode coordinates to addresses",
        "description": "Converts geographic coordinates into place names and addresses.",
        "parameters": [
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "description": "Longitude coordinate",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "description": "Latitude coordinate",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "description": "Mapbox access token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Comma-separated ISO 3166-1 alpha-2 country codes",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "IETF language tag",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results (1-5)",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 5
            }
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "description": "Comma-separated feature types to filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "worldview",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "permanent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection of reverse geocoding results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/search/geocode/v6/batch": {
      "post": {
        "operationId": "geocodeBatch",
        "summary": "Batch geocode multiple queries",
        "description": "Submit multiple forward or reverse geocoding queries in a single request.",
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "description": "Mapbox access token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "permanent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "types": {
                      "type": "string"
                    },
                    "q": {
                      "type": "string"
                    },
                    "longitude": {
                      "type": "number"
                    },
                    "latitude": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array of geocoding results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "batch": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GeocodingResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/directions/v5/mapbox/{profile}/{coordinates}": {
      "get": {
        "operationId": "getDirections",
        "summary": "Get turn-by-turn directions between coordinates",
        "description": "Returns a route between two or more coordinates with turn-by-turn instructions, distance, duration, and route geometry.",
        "parameters": [
          {
            "name": "profile",
            "in": "path",
            "required": true,
            "description": "Routing profile",
            "schema": {
              "type": "string",
              "enum": [
                "driving-traffic",
                "driving",
                "walking",
                "cycling"
              ]
            }
          },
          {
            "name": "coordinates",
            "in": "path",
            "required": true,
            "description": "Semicolon-separated coordinates in longitude,latitude format (2-25 pairs)",
            "schema": {
              "type": "string"
            },
            "example": "-73.989,40.733;-74.005,40.722"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "description": "Mapbox access token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alternatives",
            "in": "query",
            "required": false,
            "description": "Whether to return alternative routes",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "geometries",
            "in": "query",
            "required": false,
            "description": "Format of the returned geometry",
            "schema": {
              "type": "string",
              "enum": [
                "geojson",
                "polyline",
                "polyline6"
              ],
              "default": "polyline"
            }
          },
          {
            "name": "overview",
            "in": "query",
            "required": false,
            "description": "Type of returned overview geometry",
            "schema": {
              "type": "string",
              "enum": [
                "full",
                "simplified",
                "false"
              ],
              "default": "simplified"
            }
          },
          {
            "name": "steps",
            "in": "query",
            "required": false,
            "description": "Whether to return steps and turn-by-turn instructions",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "annotations",
            "in": "query",
            "required": false,
            "description": "Comma-separated annotations (distance,duration,speed,congestion,maxspeed,closure,state_of_charge)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "banner_instructions",
            "in": "query",
            "required": false,
            "description": "Include visual navigation banner instructions",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "voice_instructions",
            "in": "query",
            "required": false,
            "description": "Include voice navigation instructions",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "voice_units",
            "in": "query",
            "required": false,
            "description": "Units for voice instructions",
            "schema": {
              "type": "string",
              "enum": [
                "imperial",
                "metric"
              ]
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Language for turn instructions (IETF tag)",
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "description": "Comma-separated road types to exclude (motorway,toll,ferry,unpaved,cash_only_tolls)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depart_at",
            "in": "query",
            "required": false,
            "description": "Departure time in ISO 8601 format (driving profiles only)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "arrive_by",
            "in": "query",
            "required": false,
            "description": "Arrival time in ISO 8601 format (driving-traffic only)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_height",
            "in": "query",
            "required": false,
            "description": "Vehicle max height in meters (driving profiles)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_width",
            "in": "query",
            "required": false,
            "description": "Vehicle max width in meters (driving profiles)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_weight",
            "in": "query",
            "required": false,
            "description": "Vehicle max weight in metric tons (driving profiles)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Route response with directions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectionsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Unprocessable - invalid coordinates or parameters"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/styles/v1/{username}/{styleId}/static/{overlay}/{lon},{lat},{zoom},{bearing},{pitch}/{width}x{height}": {
      "get": {
        "operationId": "getStaticImage",
        "summary": "Generate a static map image",
        "description": "Generates a static PNG or JPEG image of a map at specified location, zoom, and dimensions. Supports overlays including markers, GeoJSON, and paths.",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Mapbox account username",
            "schema": {
              "type": "string"
            },
            "example": "mapbox"
          },
          {
            "name": "styleId",
            "in": "path",
            "required": true,
            "description": "Map style ID",
            "schema": {
              "type": "string"
            },
            "example": "streets-v12"
          },
          {
            "name": "overlay",
            "in": "path",
            "required": true,
            "description": "Comma-separated overlays (marker, geojson, path). Use 'auto' for no overlay.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lon",
            "in": "path",
            "required": true,
            "description": "Center longitude (-180 to 180)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lat",
            "in": "path",
            "required": true,
            "description": "Center latitude (-85.0511 to 85.0511)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "zoom",
            "in": "path",
            "required": true,
            "description": "Zoom level (0-22)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "bearing",
            "in": "path",
            "required": true,
            "description": "Map bearing in degrees (0-360, default 0)",
            "schema": {
              "type": "number",
              "default": 0
            }
          },
          {
            "name": "pitch",
            "in": "path",
            "required": true,
            "description": "Map pitch in degrees (0-60, default 0)",
            "schema": {
              "type": "number",
              "default": 0
            }
          },
          {
            "name": "width",
            "in": "path",
            "required": true,
            "description": "Image width in pixels (1-1280)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1280
            }
          },
          {
            "name": "height",
            "in": "path",
            "required": true,
            "description": "Image height in pixels (1-1280)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1280
            }
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "description": "Mapbox access token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attribution",
            "in": "query",
            "required": false,
            "description": "Show attribution on image",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "logo",
            "in": "query",
            "required": false,
            "description": "Show Mapbox logo on image",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "before_layer",
            "in": "query",
            "required": false,
            "description": "Layer ID to insert overlays before",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "padding",
            "in": "query",
            "required": false,
            "description": "Padding around viewport (CSS-style: top,right,bottom,left)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Static map image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded (1250 req/min default)"
          }
        }
      }
    },
    "/styles/v1/{username}/{styleId}/static/{bbox}/{width}x{height}": {
      "get": {
        "operationId": "getStaticImageByBbox",
        "summary": "Generate a static map image from bounding box",
        "description": "Generates a static map image for a bounding box area instead of center point.",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "styleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bbox",
            "in": "path",
            "required": true,
            "description": "Bounding box [minLon,minLat,maxLon,maxLat]",
            "schema": {
              "type": "string"
            },
            "example": "[-77.043686,38.894868,-77.028923,38.903012]"
          },
          {
            "name": "width",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1280
            }
          },
          {
            "name": "height",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1280
            }
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attribution",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "logo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Static map image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/isochrone/v1/mapbox/{profile}/{coordinates}": {
      "get": {
        "operationId": "getIsochrone",
        "summary": "Get isochrone contours for reachability analysis",
        "description": "Returns polygons representing areas reachable within specified time or distance limits from a coordinate.",
        "parameters": [
          {
            "name": "profile",
            "in": "path",
            "required": true,
            "description": "Routing profile",
            "schema": {
              "type": "string",
              "enum": [
                "driving",
                "walking",
                "cycling"
              ]
            }
          },
          {
            "name": "coordinates",
            "in": "path",
            "required": true,
            "description": "Center coordinate (longitude,latitude)",
            "schema": {
              "type": "string"
            },
            "example": "-73.989,40.733"
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contours_minutes",
            "in": "query",
            "required": false,
            "description": "Comma-separated travel time contours in minutes (max 4, each up to 60)",
            "schema": {
              "type": "string"
            },
            "example": "5,10,15"
          },
          {
            "name": "contours_meters",
            "in": "query",
            "required": false,
            "description": "Comma-separated distance contours in meters",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contours_colors",
            "in": "query",
            "required": false,
            "description": "Comma-separated hex colors for contours",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "polygons",
            "in": "query",
            "required": false,
            "description": "Return polygons (true) or linestrings (false)",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "denoise",
            "in": "query",
            "required": false,
            "description": "Remove noise from isochrone results (0.0-1.0)",
            "schema": {
              "type": "number",
              "default": 1.0
            }
          },
          {
            "name": "generalize",
            "in": "query",
            "required": false,
            "description": "Tolerance for Douglas-Peucker generalization in meters",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection of isochrone contours",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "FeatureCollection"
                      ]
                    },
                    "features": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "properties": {
                            "type": "object",
                            "properties": {
                              "contour": {
                                "type": "integer"
                              },
                              "color": {
                                "type": "string"
                              },
                              "opacity": {
                                "type": "number"
                              },
                              "metric": {
                                "type": "string"
                              }
                            }
                          },
                          "geometry": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/optimized-trips/v1/mapbox/{profile}/{coordinates}": {
      "get": {
        "operationId": "getOptimizedTrip",
        "summary": "Get optimized route visiting multiple stops",
        "description": "Returns an optimized route that visits all input coordinates in the most efficient order (traveling salesman problem).",
        "parameters": [
          {
            "name": "profile",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "driving",
                "driving-traffic",
                "walking",
                "cycling"
              ]
            }
          },
          {
            "name": "coordinates",
            "in": "path",
            "required": true,
            "description": "Semicolon-separated coordinates (2-12 pairs)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "geometries",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "geojson",
                "polyline",
                "polyline6"
              ],
              "default": "polyline"
            }
          },
          {
            "name": "overview",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "full",
                "simplified",
                "false"
              ]
            }
          },
          {
            "name": "steps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "roundtrip",
            "in": "query",
            "required": false,
            "description": "Whether the route should return to the first coordinate",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Which coordinate to use as the trip origin",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "first"
              ],
              "default": "any"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": false,
            "description": "Which coordinate to use as the trip destination",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "last"
              ],
              "default": "any"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Optimized trip response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "trips": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Route"
                      }
                    },
                    "waypoints": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Waypoint"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/geocoding/v5/mapbox.places/{searchText}.json": {
      "get": {
        "operationId": "geocodeForwardV5",
        "summary": "Forward geocode (v5, legacy)",
        "description": "Legacy v5 forward geocoding endpoint. Converts a text search into geographic coordinates.",
        "parameters": [
          {
            "name": "searchText",
            "in": "path",
            "required": true,
            "description": "Search text (address, place name, ZIP code, etc.)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "access_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "autocomplete",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "maximum": 10
            }
          },
          {
            "name": "proximity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON FeatureCollection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodingResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "apiKey",
        "in": "query",
        "name": "access_token",
        "description": "Mapbox access token. Get one at https://account.mapbox.com/access-tokens/"
      }
    },
    "schemas": {
      "GeocodingResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FeatureCollection"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "Feature"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "geometry": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "coordinates": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "properties": {
                  "type": "object",
                  "properties": {
                    "mapbox_id": {
                      "type": "string"
                    },
                    "feature_type": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "name_preferred": {
                      "type": "string"
                    },
                    "full_address": {
                      "type": "string"
                    },
                    "place_formatted": {
                      "type": "string"
                    },
                    "coordinates": {
                      "type": "object",
                      "properties": {
                        "longitude": {
                          "type": "number"
                        },
                        "latitude": {
                          "type": "number"
                        }
                      }
                    },
                    "context": {
                      "type": "object",
                      "properties": {
                        "country": {
                          "type": "object"
                        },
                        "region": {
                          "type": "object"
                        },
                        "postcode": {
                          "type": "object"
                        },
                        "place": {
                          "type": "object"
                        },
                        "neighborhood": {
                          "type": "object"
                        },
                        "street": {
                          "type": "object"
                        }
                      }
                    },
                    "match_code": {
                      "type": "object",
                      "properties": {
                        "address_number": {
                          "type": "string"
                        },
                        "street": {
                          "type": "string"
                        },
                        "postcode": {
                          "type": "string"
                        },
                        "place": {
                          "type": "string"
                        },
                        "region": {
                          "type": "string"
                        },
                        "country": {
                          "type": "string"
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "exact",
                            "high",
                            "medium",
                            "low"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "attribution": {
            "type": "string"
          }
        }
      },
      "DirectionsResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Status code (Ok for success)",
            "enum": [
              "Ok",
              "NoRoute",
              "NoSegment",
              "ProfileNotFound",
              "InvalidInput"
            ]
          },
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Route"
            }
          },
          "waypoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Waypoint"
            }
          },
          "uuid": {
            "type": "string",
            "description": "Unique request identifier"
          }
        }
      },
      "Route": {
        "type": "object",
        "properties": {
          "distance": {
            "type": "number",
            "description": "Total distance in meters"
          },
          "duration": {
            "type": "number",
            "description": "Total duration in seconds"
          },
          "geometry": {
            "type": "object",
            "description": "Route geometry (format depends on geometries parameter)"
          },
          "weight": {
            "type": "number"
          },
          "weight_name": {
            "type": "string"
          },
          "legs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "distance": {
                  "type": "number"
                },
                "duration": {
                  "type": "number"
                },
                "summary": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "distance": {
                        "type": "number"
                      },
                      "duration": {
                        "type": "number"
                      },
                      "geometry": {
                        "type": "object"
                      },
                      "name": {
                        "type": "string"
                      },
                      "mode": {
                        "type": "string"
                      },
                      "maneuver": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "instruction": {
                            "type": "string"
                          },
                          "bearing_before": {
                            "type": "integer"
                          },
                          "bearing_after": {
                            "type": "integer"
                          },
                          "location": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "annotation": {
                  "type": "object",
                  "properties": {
                    "distance": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "duration": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "speed": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "congestion": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Waypoint": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Street name of the waypoint"
          },
          "location": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "[longitude, latitude] snapped to road"
          },
          "distance": {
            "type": "number",
            "description": "Distance from input to snapped coordinate in meters"
          },
          "waypoint_index": {
            "type": "integer"
          },
          "trips_index": {
            "type": "integer"
          }
        }
      }
    }
  }
}
