{
  "openapi": "3.0.3",
  "info": {
    "title": "Jaggaer Advanced Sourcing Optimizer (ASO) API",
    "description": "The Jaggaer ASO API provides programmatic access to the Advanced Sourcing Optimizer platform for procurement and strategic sourcing. It encompasses three services: Customer Host Entity Service (CHES) for managing customers, users, events, and templates; Event Entity Service (EES) for interacting with event attributes, bids, awards, and suppliers; and Quay Service for submitting and managing optimization jobs.",
    "version": "26.0.0.4",
    "x-jentic-source-url": "https://asodocs.jaggaer.com/"
  },
  "servers": [
    {
      "url": "https://ches.aso-api.jaggaer.com",
      "description": "Customer Host Entity Service (CHES)"
    },
    {
      "url": "https://ees.aso-api.jaggaer.com",
      "description": "Event Entity Service (EES)"
    },
    {
      "url": "https://quay.aso-api.jaggaer.com",
      "description": "Quay Optimization Job Service"
    },
    {
      "url": "https://auth.aso-api.jaggaer.com",
      "description": "OAuth 2.0 Authentication Service"
    }
  ],
  "security": [
    {
      "oauth2": [],
      "apiKey": []
    }
  ],
  "paths": {
    "/oauth2/token": {
      "post": {
        "operationId": "generateAccessToken",
        "summary": "Generate OAuth 2.0 access token",
        "description": "Retrieves a system-to-system bearer access token using the OAuth 2.0 Client Credentials Grant.",
        "tags": ["Authentication"],
        "security": [],
        "parameters": [
          {
            "name": "grant_type",
            "in": "query",
            "required": true,
            "description": "OAuth 2.0 grant type",
            "schema": {
              "type": "string",
              "enum": ["client_credentials"]
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Admin clients require valid customer host ID or SHA512-hashed session value; non-admin clients omit this.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["grant_type"],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": ["client_credentials"]
                  },
                  "scope": {
                    "type": "string",
                    "description": "Required for admin clients"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthToken"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, unknown client, invalid scope, or unsupported grant type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client credentials"
          }
        }
      }
    },
    "/asyncStatus/{encodedAsyncPid}": {
      "get": {
        "operationId": "getAsyncStatus",
        "summary": "Get asynchronous process status",
        "description": "Retrieves the status of an asynchronous file processing operation using an encoded process ID.",
        "tags": ["Async Operations"],
        "parameters": [
          {
            "name": "encodedAsyncPid",
            "in": "path",
            "required": true,
            "description": "Encoded async process ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Async process status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid encoded async process ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Request expired or unauthorized async process ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/chost/{customerHostId}/fqdn": {
      "get": {
        "operationId": "getCustomerHostFqdn",
        "summary": "Get customer host FQDN",
        "description": "Retrieves the fully qualified domain name for an ASO customer host.",
        "tags": ["Customer Host"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "description": "ASO customer host identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer host FQDN",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fqdn": {
                      "type": "string",
                      "description": "Fully qualified domain name",
                      "example": "qa.qa-asap-web-04.combinenet.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          },
          "404": {
            "description": "Customer host FQDN not found"
          }
        }
      }
    },
    "/chost/{customerHostId}/user/{userId}/template/{templateId}/apiEvent": {
      "post": {
        "operationId": "createEventFromTemplate",
        "summary": "Create event from template",
        "description": "Creates an ASO event synchronously from a template for a specified user.",
        "tags": ["Events"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "description": "Customer host identifier",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "User identifier",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "description": "Template identifier",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.sciquest.com.ches+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created successfully",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (NULL_PAYLOAD, USER_NOT_FOUND, TEMPLATE_EVENT_NOT_FOUND, INSUFFICIENT_PERMISSIONS, MISSING_REQUIRED_FIELD, ALREADY_EXISTS, EXCEEDED_CHARACTER_LIMIT, INVALID_TEMPLATE_TYPE, INVALID_SUBCATEGORY_1_VALUE, INVALID_SUBCATEGORY_2_VALUE, INVALID_USER_GROUP_NAME, REQUIRES_COPY_SUPPLIERS_AND_COPY_ITEMS, REQUIRES_COPY_SUPPLIERS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/chost/{customerHostId}/user/{userId}/template/{templateId}/apiEvent/async": {
      "post": {
        "operationId": "createEventFromTemplateAsync",
        "summary": "Create event from template asynchronously",
        "description": "Initiates asynchronous event creation from a template, returning a status URL for polling.",
        "tags": ["Events"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.sciquest.com.ches+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Async event creation initiated",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/chost/{customerHostId}/user/{userId}/apiEvents": {
      "get": {
        "operationId": "listEventsByUser",
        "summary": "List events by user",
        "description": "Retrieves ASO event data visible to a specified user with optional filtering.",
        "tags": ["Events"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "eventId",
            "in": "query",
            "description": "Filter to single event",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "name_in",
            "in": "query",
            "description": "Filter events by name substring",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description_in",
            "in": "query",
            "description": "Filter events by description substring",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "createdOn_to",
            "in": "query",
            "description": "Filter events created on or before date (13-digit epoch ms)",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "createdOn_from",
            "in": "query",
            "description": "Filter events created on or after date (13-digit epoch ms)",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "createdBy",
            "in": "query",
            "description": "Filter events by creator user ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/chost/{customerHostId}/apiLocationNames": {
      "get": {
        "operationId": "listRateLocationNames",
        "summary": "List rate location names",
        "description": "Retrieves ASO rate structure location names with filtering, sorting, and pagination.",
        "tags": ["Customer Host"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "locationName",
            "in": "query",
            "description": "Filter by name (supports * wildcard for startsWith, endsWith, contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_field",
            "in": "query",
            "description": "Field to sort by",
            "schema": {
              "type": "string",
              "enum": ["locationName"]
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          },
          {
            "name": "page_number",
            "in": "query",
            "description": "Pagination offset",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Results per page",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of location names",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/chost/{customerHostId}/templateType/{templateTypeId}/apiSubcategories": {
      "get": {
        "operationId": "listSubcategoriesByTemplateType",
        "summary": "List subcategories by template type",
        "description": "Retrieves subcategory names for a specified template type.",
        "tags": ["Templates"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "templateTypeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subcategories for the template type",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "$ref": "#/components/schemas/Subcategories"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/chost/{customerHostId}/user/{userId}/apiTemplates": {
      "get": {
        "operationId": "listTemplatesByUser",
        "summary": "List templates by user",
        "description": "Retrieves ASO event templates visible to a specified user with optional filtering.",
        "tags": ["Templates"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "eventId",
            "in": "query",
            "description": "Filter to single template",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "name_in",
            "in": "query",
            "description": "Filter templates by name substring",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description_in",
            "in": "query",
            "description": "Filter templates by description substring",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "createdOn_to",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "createdOn_from",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "createdBy",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of templates",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Template"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/chost/{customerHostId}/apiTemplateTypes": {
      "get": {
        "operationId": "listTemplateTypes",
        "summary": "List template types",
        "description": "Retrieves all available ASO template types for a customer host.",
        "tags": ["Templates"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of template types",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TemplateType"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/chost/{customerHostId}/apiUser/{userId}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get a single user",
        "description": "Retrieves a single ASO user by user ID.",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/chost/{customerHostId}/apiUsers": {
      "get": {
        "operationId": "listUsers",
        "summary": "List all users",
        "description": "Retrieves all ASO users for a specified customer host.",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "customerHostId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/vnd.sciquest.com.ches+json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized customer host ID"
          }
        }
      }
    },
    "/event/{eventId}/apiAttribute/{attributeId}": {
      "get": {
        "operationId": "getAttribute",
        "summary": "Get a single attribute",
        "description": "Retrieves a single attribute by ID within an event.",
        "tags": ["Attributes"],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "attributeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attribute details",
            "content": {
              "application/vnd.sciquest.com.ees+json": {
                "schema": {
                  "$ref": "#/components/schemas/Attribute"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Attribute not found"
          }
        }
      },
      "patch": {
        "operationId": "updateAttribute",
        "summary": "Update an attribute",
        "description": "Updates an existing attribute's writable fields.",
        "tags": ["Attributes"],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "attributeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.sciquest.com.ees+json": {
              "schema": {
                "$ref": "#/components/schemas/Attribute"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attribute updated successfully",
            "content": {
              "application/vnd.sciquest.com.ees+json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Attribute not found"
          },
          "409": {
            "description": "Conflict - attribute cannot be updated"
          }
        }
      },
      "delete": {
        "operationId": "deleteAttribute",
        "summary": "Delete an attribute",
        "description": "Deletes an attribute by ID (bid/item/supplier types only).",
        "tags": ["Attributes"],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "attributeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Attribute deleted successfully"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Attribute not found"
          },
          "409": {
            "description": "Conflict - attribute cannot be deleted"
          }
        }
      }
    },
    "/event/{eventId}/apiAttributes": {
      "get": {
        "operationId": "listAttributes",
        "summary": "List all attributes",
        "description": "Retrieves all attributes within an event.",
        "tags": ["Attributes"],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
