  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.aso-api.jaggaer.com/oauth2/token",
            "scopes": {}
          }
        }
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for client identification"
      }
    },
    "schemas": {
      "OAuthToken": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "format": "uuid",
            "description": "Bearer access token"
          },
          "token_type": {
            "type": "string",
            "description": "Token type (bearer)"
          },
          "expires_in": {
            "type": "integer",
            "description": "Token expiration time in seconds"
          },
          "scope": {
            "type": "string",
            "description": "Token scope"
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code"
          },
          "error_description": {
            "type": "string",
            "description": "Detailed error explanation"
          }
        }
      },
      "AsyncStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["initialized", "processing", "cancelled", "failed", "completed"],
            "description": "Current process status"
          },
          "resultUrl": {
            "type": "string",
            "format": "uri",
            "description": "Pre-signed download URL (visible only when completed)"
          },
          "resultUrlExpiresInSeconds": {
            "type": "integer",
            "description": "Seconds until result URL expiration"
          }
        }
      },
      "AsyncResponse": {
        "type": "object",
        "properties": {
          "statusUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for polling async status"
          },
          "statusUrlExpiresInSeconds": {
            "type": "integer",
            "description": "Seconds until status URL expiration"
          }
        }
      },
      "CreateEventRequest": {
        "type": "object",
        "required": ["name", "description", "isTestEvent", "templateTypeName", "subcategory1", "copySuppliers", "copyItems", "copyHistorics", "copyRfiAnswers"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "description": "Event name"
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "description": "Event description"
          },
          "isTestEvent": {
            "type": "boolean",
            "description": "Whether this is a test event"
          },
          "templateTypeName": {
            "type": "string",
            "enum": ["Transportation", "Packaging", "Indirect Materials", "RFxpress", "Direct Materials", "Services", "SD Auction", "Multi-Stage", "Facilities Management & Services", "Routing Network"],
            "description": "Template type name"
          },
          "subcategory1": {
            "type": "string",
            "description": "Required subcategory value"
          },
          "subcategory2": {
            "type": "string",
            "nullable": true,
            "description": "Optional subcategory value"
          },
          "copySuppliers": {
            "type": "boolean",
            "description": "Include template suppliers"
          },
          "copyItems": {
            "type": "boolean",
            "description": "Include template items"
          },
          "copyHistorics": {
            "type": "boolean",
            "description": "Include item historic pricing (requires copySuppliers and copyItems)"
          },
          "copyRfiAnswers": {
            "type": "boolean",
            "description": "Include RFI answers (requires copySuppliers)"
          },
          "userGroupName": {
            "type": "string",
            "nullable": true,
            "description": "Optional user group name"
          }
        }
      },
      "CreateEventResponse": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "object",
            "properties": {
              "SUCCESS": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "integer"
                    },
                    "eventName": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "description": "Event identifier"
          },
          "customerHostId": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 50
          },
          "uriName": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "isTestEvent": {
            "type": "boolean"
          },
          "isTemplate": {
            "type": "boolean"
          },
          "archivalState": {
            "type": "string",
            "enum": ["archiving", "archived", "restoring", "not_archived"]
          },
          "eventOwner": {
            "type": "string",
            "maxLength": 100
          },
          "eventOwnerEmail": {
            "type": "string",
            "maxLength": 100
          },
          "publicOrPrivate": {
            "type": "string",
            "enum": ["public", "private"]
          },
          "templateTypeName": {
            "type": "string"
          },
          "eventTypeName": {
            "type": "string"
          },
          "eventTypeCategory": {
            "type": "string",
            "enum": ["RFX", "eAuction"]
          },
          "subcategory1": {
            "type": "string",
            "maxLength": 64
          },
          "subcategory2": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "active": {
            "type": "boolean"
          },
          "createdOn": {
            "type": "integer",
            "format": "int64",
            "description": "13-digit epoch timestamp"
          },
          "projectStartDate": {
            "type": "integer",
            "format": "int64"
          },
          "biddingOpen": {
            "type": "integer",
            "format": "int64"
          },
          "biddingClose": {
            "type": "integer",
            "format": "int64"
          },
          "lastModified": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Template": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer"
          },
          "customerHostId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "uriName": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          },
          "isTestEvent": {
            "type": "boolean"
          },
          "isTemplate": {
            "type": "boolean"
          },
          "archivalState": {
            "type": "string",
            "enum": ["archiving", "archived", "restoring", "not_archived"]
          },
          "eventOwner": {
            "type": "string"
          },
          "eventOwnerEmail": {
            "type": "string"
          },
          "publicOrPrivate": {
            "type": "string",
            "enum": ["public", "private"]
          },
          "templateTypeName": {
            "type": "string"
          },
          "eventTypeName": {
            "type": "string",
            "enum": ["Sealed Bid", "Reverse Auction", "Dutch Reverse Auction", "Japanese Reverse Auction", "SD Auction", "Supply Chain", "Routing Network"]
          },
          "eventTypeCategory": {
            "type": "string",
            "enum": ["RFX", "eAuction", "Advanced Sourcing"]
          },
          "active": {
            "type": "boolean"
          },
          "createdOn": {
            "type": "integer",
            "format": "int64"
          },
          "lastModified": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "TemplateType": {
        "type": "object",
        "properties": {
          "templateTypeId": {
            "type": "integer",
            "description": "Template type identifier"
          },
          "name": {
            "type": "string",
            "enum": ["Transportation", "Packaging", "Indirect Materials", "RFxpress", "Direct Materials", "Services", "SD Auction", "Multi-Stage", "Facilities Management & Services", "Routing Network"]
          }
        }
      },
      "Subcategories": {
        "type": "object",
        "properties": {
          "subcategory1": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Available subcategory 1 names"
          },
          "subcategory2": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Available subcategory 2 names"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "nullable": true,
            "description": "User identifier"
          },
          "username": {
            "type": "string",
            "nullable": true,
            "description": "User email/username"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "User full name"
          },
          "status": {
            "type": "string",
            "enum": ["locked", "single_use", "unlocked", "bad_password", "expired"],
            "description": "User account status"
          },
          "active": {
            "type": "boolean",
            "description": "User active status"
          }
        }
      },
      "Attribute": {
        "type": "object",
        "properties": {
          "attributeId": {
            "type": "integer"
          },
          "attributeCode": {
            "type": "string",
            "description": "Attribute code (required for creation)"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "attributeType": {
            "type": "string",
            "enum": ["bid", "item", "supplier", "supplier_contact"]
          },
          "type": {
            "type": "string",
            "enum": ["string", "memo", "currency", "integer", "number", "money", "percent", "date", "time", "date-time", "yes-no", "select-one"]
          },
          "apiField": {
            "type": "string"
          },
          "isNormalized": {
            "type": "boolean"
          },
          "selectOneValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "normalizedValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fractionalPrecision": {
            "type": "integer"
          },
          "isRequired": {
            "type": "boolean"
          },
          "lowValue": {
            "type": "number"
          },
          "highValue": {
            "type": "number"
          },
          "visibleToBidder": {
            "type": "boolean"
          },
          "visibleInManagement": {
            "type": "boolean"
          },
          "isHistoric": {
            "type": "boolean"
          },
          "isLocked": {
            "type": "boolean"
          }
        }
      },
      "SubmitJobRequest": {
        "type": "object",
        "required": ["consumer", "customerId", "customerName", "eventId", "inputFilename"],
        "properties": {
          "consumer": {
            "type": "string",
            "enum": ["ASO", "JCS", "USDA"],
            "description": "Consumer system"
          },
          "customerId": {
            "type": "integer",
            "description": "Customer identifier"
          },
          "customerName": {
            "type": "string",
            "maxLength": 100,
            "description": "Customer name"
          },
          "eventId": {
            "type": "integer",
            "description": "Event identifier"
          },
          "inputFilename": {
            "type": "string",
            "maxLength": 100,
            "description": "Input filename for optimization"
          },
          "notificationHostname": {
            "type": "string",
            "maxLength": 250,
            "description": "Notification callback hostname"
          },
          "notificationPort": {
            "type": "integer",
            "description": "Notification callback port"
          }
        }
      },
      "SubmitJobResponse": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "object",
            "properties": {
              "SUCCESS": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "integer",
                      "description": "Assigned job identifier"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["Received", "Queued", "Requeued", "Optimizing", "Completed", "Failed", "Cancelled", "Cancelling", "Expired", "Limited"],
            "description": "Current job status"
          }
        }
      },
      "JobDetails": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "integer"
          },
          "consumer": {
            "type": "string",
            "enum": ["ASO", "JCS", "USDA"]
          },
          "customerId": {
            "type": "integer"
          },
          "customerName": {
            "type": "string"
          },
          "eventId": {
            "type": "integer"
          },
          "inputFilename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["Received", "Queued", "Requeued", "Optimizing", "Completed", "Failed", "Cancelled", "Cancelling", "Expired", "Limited"]
          },
          "jobType": {
            "type": "string"
          },
          "optSetType": {
            "type": "string"
          },
          "submitTime": {
            "type": "string",
            "format": "date-time"
          },
          "inprocAtSubmit": {
            "type": "integer"
          },
          "runClient": {
            "type": "string"
          },
          "workingDirectory": {
            "type": "string"
          },
          "processStartTime": {
            "type": "string",
            "format": "date-time"
          },
          "processStopTime": {
            "type": "string",
            "format": "date-time"
          },
          "cpuTime": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "object",
            "properties": {
              "SUCCESS": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attributeId": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "MultiStatusResponse": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "object",
            "properties": {
              "SUCCESS": {
                "type": "array",
                "items": {
