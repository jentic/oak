    "/submitJob": {
      "post": {
        "operationId": "submitOptimizationJob",
        "summary": "Submit optimization job",
        "description": "Submits a job for queuing and optimization processing.",
        "tags": ["Optimization Jobs"],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.sciquest.com.quay+json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job submitted successfully",
            "content": {
              "application/vnd.sciquest.com.quay+json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitJobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized - missing or invalid API key"
          },
          "422": {
            "description": "Validation error (INVALID_ENUM_VALUE, MISSING_REQUIRED_FIELD, EXCEEDED_CHARACTER_LIMIT, FILE_NOT_FOUND)"
          },
          "429": {
            "description": "Job submission exceeded customer's configured limit"
          }
        }
      }
    },
    "/cancelJob/{jobId}": {
      "post": {
        "operationId": "cancelOptimizationJob",
        "summary": "Cancel optimization job",
        "description": "Cancels an in-process optimization job.",
        "tags": ["Optimization Jobs"],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "description": "Quay job identifier",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Job cancelled successfully"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid authentication"
          },
          "403": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Job not found"
          },
          "422": {
            "description": "Job could not be cancelled"
          }
        }
      }
    },
    "/jobStatus/{jobId}": {
      "get": {
        "operationId": "getJobStatus",
        "summary": "Get job status",
        "description": "Retrieves current job status by job identifier.",
        "tags": ["Optimization Jobs"],
