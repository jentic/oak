{
  "openapi": "3.0.3",
  "info": {
    "title": "RANDOM.ORG API",
    "version": "4.0",
    "description": "RANDOM.ORG offers true random number generation based on atmospheric noise via a JSON-RPC 4 API. Supports generating random integers, decimal fractions, Gaussian distributions, strings, UUIDs, and binary blobs.",
    "contact": {
      "url": "https://www.random.org"
    },
    "x-jentic-source-url": "https://api.random.org/json-rpc/4/basic"
  },
  "servers": [
    {
      "url": "https://api.random.org/json-rpc/4",
      "description": "RANDOM.ORG JSON-RPC 4 API"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyInBody": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key (passed as apiKey in JSON-RPC params body). Get one at https://api.random.org/api-keys"
      }
    },
    "schemas": {
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method",
          "params",
          "id"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "generateIntegers",
              "generateIntegerSequences",
              "generateDecimalFractions",
              "generateGaussians",
              "generateStrings",
              "generateUUIDs",
              "generateBlobs",
              "getUsage"
            ]
          },
          "params": {
            "type": "object",
            "description": "Method-specific parameters including apiKey"
          },
          "id": {
            "type": "integer",
            "description": "Request identifier"
          }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "properties": {
              "random": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {}
                  },
                  "completionTime": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "bitsUsed": {
                "type": "integer"
              },
              "bitsLeft": {
                "type": "integer"
              },
              "requestsLeft": {
                "type": "integer"
              },
              "advisoryDelay": {
                "type": "integer"
              }
            }
          },
          "id": {
            "type": "integer"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyInBody": []
    }
  ],
  "paths": {
    "/invoke": {
      "post": {
        "summary": "Invoke JSON-RPC Method",
        "operationId": "invokeMethod",
        "description": "Invoke any RANDOM.ORG JSON-RPC method. Supported methods: generateIntegers, generateIntegerSequences, generateDecimalFractions, generateGaussians, generateStrings, generateUUIDs, generateBlobs, getUsage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "examples": {
                "generateIntegers": {
                  "summary": "Generate random integers",
                  "value": {
                    "jsonrpc": "2.0",
                    "method": "generateIntegers",
                    "params": {
                      "apiKey": "YOUR_API_KEY",
                      "n": 10,
                      "min": 1,
                      "max": 100,
                      "replacement": true,
                      "base": 10
                    },
                    "id": 1
                  }
                },
                "generateStrings": {
                  "summary": "Generate random strings",
                  "value": {
                    "jsonrpc": "2.0",
                    "method": "generateStrings",
                    "params": {
                      "apiKey": "YOUR_API_KEY",
                      "n": 5,
                      "length": 10,
                      "characters": "abcdefghijklmnopqrstuvwxyz",
                      "replacement": true
                    },
                    "id": 2
                  }
                },
                "generateUUIDs": {
                  "summary": "Generate random UUIDs",
                  "value": {
                    "jsonrpc": "2.0",
                    "method": "generateUUIDs",
                    "params": {
                      "apiKey": "YOUR_API_KEY",
                      "n": 3
                    },
                    "id": 3
                  }
                },
                "getUsage": {
                  "summary": "Get API usage statistics",
                  "value": {
                    "jsonrpc": "2.0",
                    "method": "getUsage",
                    "params": {
                      "apiKey": "YOUR_API_KEY"
                    },
                    "id": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response with random data or usage info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          }
        }
      }
    },
    "/verify": {
      "post": {
        "summary": "Verify Signed Response",
        "operationId": "verifySignature",
        "description": "Verify the authenticity of a signed random response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method",
                  "params",
                  "id"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": [
                      "2.0"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "verifySignature"
                    ]
                  },
                  "params": {
                    "type": "object",
                    "properties": {
                      "random": {
                        "type": "object"
                      },
                      "signature": {
                        "type": "string"
                      }
                    }
                  },
                  "id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "type": "string"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "authenticity": {
                          "type": "boolean"
                        }
                      }
                    },
                    "id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage": {
      "post": {
        "summary": "Get API Key Usage",
        "operationId": "getUsage",
        "description": "Get usage statistics for an API key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method",
                  "params",
                  "id"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": [
                      "2.0"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "getUsage"
                    ]
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "apiKey"
                    ],
                    "properties": {
                      "apiKey": {
                        "type": "string"
                      }
                    }
                  },
                  "id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usage stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "type": "string"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "stopped",
                            "running"
                          ]
                        },
                        "creationTime": {
                          "type": "string"
                        },
                        "bitsLeft": {
                          "type": "integer"
                        },
                        "requestsLeft": {
                          "type": "integer"
                        },
                        "totalBits": {
                          "type": "integer"
                        },
                        "totalRequests": {
                          "type": "integer"
                        }
                      }
                    },
                    "id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}