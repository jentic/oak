{
  "openapi": "3.0.3",
  "info": {
    "title": "Strapi REST API",
    "version": "5.0.0",
    "description": "OpenAPI description of the Strapi 5 headless CMS REST API, generated from the official documentation (https://docs.strapi.io/cms/api/rest).\n\nStrapi auto-generates REST endpoints for every content type in an instance. Two shapes exist:\n- **Collection types** (many entries) are served at `/{pluralApiId}` and `/{pluralApiId}/{documentId}` and support list/create/read-one/update/delete.\n- **Single types** (one global entry) are served at `/{singularApiId}` and support read/update/delete.\n\nBecause the resource segment is per-instance, the generic paths use a templated `{pluralApiId}` / `{singularApiId}` / `{documentId}`. As a concrete example, the Jentic instance's `page-metadata` collection is included explicitly at `/page-metadatas` and `/page-metadatas/{documentId}`.\n\nStrapi 5 identifies records by a string `documentId` (stable across locales and draft/published versions), not the numeric `id`. Responses use a flattened `data` / `meta` envelope (attributes are no longer nested under `data.attributes` as in v4).\n\n**Draft & Publish caveat:** the `status` query parameter selects draft vs published on reads, but Strapi 5 has no built-in REST route to publish/unpublish, and create/update over REST auto-publishes regardless of a `status=draft` hint (see strapi/strapi#21544, #24547). Verify `publishedAt` on the response rather than trusting the parameter.",
    "x-jentic-source-url": "https://docs.strapi.io/cms/api/rest",
    "contact": {
      "name": "Strapi Documentation",
      "url": "https://docs.strapi.io/cms/api/rest"
    }
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "description": "Strapi instance base URL. Strapi is self-hosted or run on Strapi Cloud, so the host is per-deployment.",
      "variables": {
        "host": {
          "default": "my-project.strapiapp.com",
          "description": "Strapi deployment host (a Strapi Cloud *.strapiapp.com host, or your self-hosted domain)."
        }
      }
    }
  ],
  "paths": {
    "/page-metadatas": {
      "get": {
        "operationId": "listPageMetadata",
        "summary": "List page-metadata entries",
        "description": "List entries of the Jentic instance's `page-metadata` collection. This is the collection-type list endpoint (`GET /{pluralApiId}`) with `pluralApiId = page-metadatas`.",
        "tags": [
          "page-metadata"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/sort"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/populate"
          },
          {
            "$ref": "#/components/parameters/status"
          },
          {
            "$ref": "#/components/parameters/locale"
          },
          {
            "$ref": "#/components/parameters/publicationFilter"
          },
          {
            "$ref": "#/components/parameters/paginationPage"
          },
          {
            "$ref": "#/components/parameters/paginationPageSize"
          },
          {
            "$ref": "#/components/parameters/paginationStart"
          },
          {
            "$ref": "#/components/parameters/paginationLimit"
          },
          {
            "$ref": "#/components/parameters/paginationWithCount"
          },
          {
            "name": "filters[pagePath][$eq]",
            "in": "query",
            "description": "Filter by exact page path.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filters[robotsIndex][$eq]",
            "in": "query",
            "description": "Filter by robotsIndex flag.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "filters[robotsFollow][$eq]",
            "in": "query",
            "description": "Filter by robotsFollow flag.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of page-metadata entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createPageMetadata",
        "summary": "Create a page-metadata entry",
        "description": "Create a `page-metadata` entry (`POST /{pluralApiId}`). Note: over REST the created entry is published even when `status=draft` is supplied; verify `publishedAt` on the response.",
        "tags": [
          "page-metadata"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageMetadataWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataSingleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/page-metadatas/{documentId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/documentId"
        }
      ],
      "get": {
        "operationId": "getPageMetadata",
        "summary": "Get a page-metadata entry",
        "description": "Retrieve a single `page-metadata` entry by documentId (`GET /{pluralApiId}/{documentId}`).",
        "tags": [
          "page-metadata"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/populate"
          },
          {
            "$ref": "#/components/parameters/status"
          },
          {
            "$ref": "#/components/parameters/locale"
          }
        ],
        "responses": {
          "200": {
            "description": "The page-metadata entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataSingleResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "operationId": "updatePageMetadata",
        "summary": "Update a page-metadata entry",
        "description": "Partially update a `page-metadata` entry by documentId (`PUT /{pluralApiId}/{documentId}`). Used to flip `robotsIndex` / `robotsFollow`. Note: updating over REST publishes the entry; there is no REST route to unpublish. Verify `publishedAt` on the response.",
        "tags": [
          "page-metadata"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageMetadataWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataSingleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deletePageMetadata",
        "summary": "Delete a page-metadata entry",
        "description": "Delete a `page-metadata` entry by documentId (`DELETE /{pluralApiId}/{documentId}`).",
        "tags": [
          "page-metadata"
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/{apiId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/apiId"
        }
      ],
      "get": {
        "operationId": "listEntries",
        "summary": "List collection entries, or get a single type",
        "description": "For a collection type (`apiId` = plural API ID, e.g. `articles`, `page-metadatas`) this lists entries with filtering, sorting, field selection, population, pagination, and status. For a single type (`apiId` = singular API ID, e.g. `homepage`) this returns the one global entry; the list query parameters do not apply. Collection and single types share this path position, so they are described by one templated path.",
        "tags": [
          "collection-type",
          "single-type"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/sort"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/populate"
          },
          {
            "$ref": "#/components/parameters/status"
          },
          {
            "$ref": "#/components/parameters/locale"
          },
          {
            "$ref": "#/components/parameters/publicationFilter"
          },
          {
            "$ref": "#/components/parameters/paginationPage"
          },
          {
            "$ref": "#/components/parameters/paginationPageSize"
          },
          {
            "$ref": "#/components/parameters/paginationStart"
          },
          {
            "$ref": "#/components/parameters/paginationLimit"
          },
          {
            "$ref": "#/components/parameters/paginationWithCount"
          },
          {
            "name": "filters",
            "in": "query",
            "description": "Filter the response. Use bracket syntax `filters[field][$operator]=value`. Operators: $eq, $eqi, $ne, $nei, $lt, $lte, $gt, $gte, $in, $notIn, $contains, $notContains, $containsi, $notContainsi, $startsWith, $startsWithi, $endsWith, $endsWithi, $null, $notNull, $between, $or, $and, $not.",
            "required": false,
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createEntry",
        "summary": "Create a collection-type entry",
        "description": "Create an entry of a collection type. The request body wraps attributes under a `data` key. Not applicable to single types (use PUT). Note: over REST the entry is auto-published even with `status=draft`; verify `publishedAt` on the response.",
        "tags": [
          "collection-type"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntrySingleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "operationId": "updateSingleType",
        "summary": "Update (or create) a single type",
        "description": "For a single type (`apiId` = singular API ID), update the one global entry, creating it if absent. Collection-type entries are updated at `/{apiId}/{documentId}` instead. Note: updating over REST publishes the entry; there is no REST route to unpublish.",
        "tags": [
          "single-type"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated single-type entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntrySingleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "operationId": "deleteSingleType",
        "summary": "Delete a single type",
        "description": "For a single type (`apiId` = singular API ID), delete the one global entry. Collection-type entries are deleted at `/{apiId}/{documentId}` instead.",
        "tags": [
          "single-type"
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/{apiId}/{documentId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/apiId"
        },
        {
          "$ref": "#/components/parameters/documentId"
        }
      ],
      "get": {
        "operationId": "getEntry",
        "summary": "Get a collection-type entry by documentId",
        "description": "Retrieve a single collection-type entry by its `documentId`.",
        "tags": [
          "collection-type"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/populate"
          },
          {
            "$ref": "#/components/parameters/status"
          },
          {
            "$ref": "#/components/parameters/locale"
          }
        ],
        "responses": {
          "200": {
            "description": "The entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntrySingleResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "operationId": "updateEntry",
        "summary": "Update a collection-type entry",
        "description": "Partially update a collection-type entry by `documentId`. Note: updating over REST publishes the entry; there is no REST route to unpublish.",
        "tags": [
          "collection-type"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntrySingleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deleteEntry",
        "summary": "Delete a collection-type entry",
        "description": "Delete a collection-type entry by `documentId`.",
        "tags": [
          "collection-type"
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Strapi API token or authenticated-user JWT, sent as `Authorization: Bearer <token>`."
      }
    },
    "parameters": {
      "apiId": {
        "name": "apiId",
        "in": "path",
        "required": true,
        "description": "The content type's API ID: the plural API ID for a collection type (e.g. `articles`, `page-metadatas`) or the singular API ID for a single type (e.g. `homepage`, `global`).",
        "schema": {
          "type": "string"
        }
      },
      "documentId": {
        "name": "documentId",
        "in": "path",
        "required": true,
        "description": "Strapi 5 document identifier (string), stable across locales and draft/published versions.",
        "schema": {
          "type": "string"
        }
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "description": "Sort the response. Single field `sort=field:asc`, or multiple via `sort[0]=field:asc&sort[1]=other:desc`. Direction is `:asc` (default) or `:desc`.",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Select only specific fields to return, e.g. `fields[0]=title&fields[1]=description`. Does not apply to relational/media/component/dynamic-zone fields.",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "populate": {
        "name": "populate",
        "in": "query",
        "required": false,
        "description": "Populate relations, media, components, and dynamic zones (excluded by default). `populate=*` for all one level deep, or bracket syntax for specific/nested relations.",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      },
      "status": {
        "name": "status",
        "in": "query",
        "required": false,
        "description": "Select the Draft & Publish status on reads.",
        "schema": {
          "type": "string",
          "enum": [
            "published",
            "draft"
          ],
          "default": "published"
        }
      },
      "locale": {
        "name": "locale",
        "in": "query",
        "required": false,
        "description": "Select a locale (i18n plugin).",
        "schema": {
          "type": "string"
        }
      },
      "publicationFilter": {
        "name": "publicationFilter",
        "in": "query",
        "required": false,
        "description": "Select documents by how their draft and published versions relate.",
        "schema": {
          "type": "string"
        }
      },
      "paginationPage": {
        "name": "pagination[page]",
        "in": "query",
        "required": false,
        "description": "Page-based pagination: page number. Cannot be combined with start/limit.",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "paginationPageSize": {
        "name": "pagination[pageSize]",
        "in": "query",
        "required": false,
        "description": "Page-based pagination: entries per page.",
        "schema": {
          "type": "integer",
          "default": 25
        }
      },
      "paginationStart": {
        "name": "pagination[start]",
        "in": "query",
        "required": false,
        "description": "Offset-based pagination: index of the first entry. Cannot be combined with page/pageSize.",
        "schema": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        }
      },
      "paginationLimit": {
        "name": "pagination[limit]",
        "in": "query",
        "required": false,
        "description": "Offset-based pagination: number of entries to return. Maximum is configurable per instance.",
        "schema": {
          "type": "integer",
          "default": 25
        }
      },
      "paginationWithCount": {
        "name": "pagination[withCount]",
        "in": "query",
        "required": false,
        "description": "Include the total count / page count in the pagination metadata.",
        "schema": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request (invalid parameters or body).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid token, or the route is not enabled for the caller's role.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Document not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "PageMetadataAttributes": {
        "type": "object",
        "description": "SEO fields held by one page-metadata entry (one per site route).",
        "properties": {
          "pagePath": {
            "type": "string",
            "description": "Site route this metadata applies to (e.g. /apis/{slug})."
          },
          "title": {
            "type": "string",
            "maxLength": 70
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "robotsIndex": {
            "type": "boolean",
            "default": true,
            "description": "Whether the route may be indexed (drives sitemap inclusion)."
          },
          "robotsFollow": {
            "type": "boolean",
            "default": true,
            "description": "Whether links on the route may be followed."
          },
          "ogTitle": {
            "type": "string",
            "maxLength": 90
          },
          "ogDescription": {
            "type": "string",
            "maxLength": 200
          },
          "ogImage": {
            "type": "string"
          },
          "twitterTitle": {
            "type": "string",
            "maxLength": 90
          },
          "twitterDescription": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "PageMetadataEntry": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PageMetadataAttributes"
          },
          {
            "$ref": "#/components/schemas/DocumentMeta"
          }
        ]
      },
      "PageMetadataWriteRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PageMetadataAttributes"
          }
        }
      },
      "PageMetadataSingleResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PageMetadataEntry"
          },
          "meta": {
            "type": "object"
          }
        }
      },
      "PageMetadataListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageMetadataEntry"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        }
      },
      "DocumentMeta": {
        "type": "object",
        "description": "Strapi 5 system fields present on every document (flattened, not nested under data.attributes).",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Numeric id, retained for backwards compatibility; not used to address documents."
          },
          "documentId": {
            "type": "string",
            "description": "Stable document identifier used in URLs."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Publication timestamp; null when the version is a draft."
          },
          "locale": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Entry": {
        "type": "object",
        "description": "A generic Strapi document: content-type attributes plus system fields, flattened at the top level.",
