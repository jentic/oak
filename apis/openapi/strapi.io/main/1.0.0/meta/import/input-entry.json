{
  "openapi": "3.0.3",
  "info": {
    "title": "Jentic Strapi CMS - Page Metadata API",
    "description": "Minimal spec for the Jentic strapi-cms `page-metadata` collection (Strapi 5.46 auto-generated REST CRUD). One entry per site route, keyed by `pagePath`, holding SEO fields. `robotsIndex`/`robotsFollow` control sitemap inclusion. Note the doubled plural in the path: Strapi serves the `page-metadata` content type at `/api/page-metadatas`. Strapi 5 identifies records by the string `documentId`; the `{id}` path parameter accepts that documentId.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.strapi.io/cms/api/rest"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "description": "Strapi CMS REST API.",
      "variables": {
        "host": {
          "default": "strapi-cms.example.strapiapp.com",
          "description": "Strapi deployment host"
        }
      }
    }
  ],
  "paths": {
    "/page-metadatas": {
      "get": {
        "tags": [
          "page-metadata"
        ],
        "operationId": "getPageMetadatas",
        "summary": "List page-metadata entries",
        "parameters": [
          {
            "name": "filters[pagePath][$eq]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filters[robotsIndex][$eq]",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "filters[robotsFollow][$eq]",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pagination[page]",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pagination[pageSize]",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 100
            }
          },
          {
            "name": "pagination[withCount]",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "published",
                "draft"
              ],
              "default": "published"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "page-metadata"
        ],
        "operationId": "createPageMetadata",
        "summary": "Create a page-metadata entry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageMetadataWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataSingleResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/page-metadatas/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Strapi 5 documentId"
        }
      ],
      "get": {
        "tags": [
          "page-metadata"
        ],
        "operationId": "getPageMetadataById",
        "summary": "Get a single page-metadata entry",
        "responses": {
          "200": {
            "description": "Entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataSingleResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "page-metadata"
        ],
        "operationId": "updatePageMetadata",
        "summary": "Update a page-metadata entry — use to flip robotsIndex/robotsFollow",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageMetadataWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageMetadataSingleResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "page-metadata"
        ],
        "operationId": "deletePageMetadata",
        "summary": "Delete a page-metadata entry",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Strapi API token"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "PageMetadataAttributes": {
        "type": "object",
        "properties": {
          "pagePath": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 70
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "robotsIndex": {
            "type": "boolean",
            "default": true
          },
          "robotsFollow": {
            "type": "boolean",
            "default": true
          },
          "ogTitle": {
            "type": "string",
            "maxLength": 90
          },
          "ogDescription": {
            "type": "string",
            "maxLength": 200
          },
          "ogImage": {
            "type": "string"
          },
          "twitterTitle": {
            "type": "string",
            "maxLength": 90
          },
          "twitterDescription": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "PageMetadataEntry": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PageMetadataAttributes"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "documentId": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "publishedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          }
        ]
      },
      "PageMetadataWriteRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PageMetadataAttributes"
          }
        }
      },
      "PageMetadataSingleResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PageMetadataEntry"
          },
          "meta": {
            "type": "object"
          }
        }
      },
      "PageMetadataListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageMetadataEntry"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "pagination": {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer"
                  },
                  "pageSize": {
                    "type": "integer"
                  },
                  "pageCount": {
                    "type": "integer"
                  },
                  "total": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "nullable": true
          },
          "error": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "page-metadata",
      "description": "SEO metadata records, one per site route"
    }
  ]
}