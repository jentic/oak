            "description": "Latitude"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "Longitude"
          },
          {
            "name": "dim",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 0.025
            },
            "description": "Width and height of image in degrees"
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Date of image"
          }
        ],
        "responses": {
          "200": {
            "description": "Earth imagery",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
