                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mars-photos/api/v1/rovers/{rover}/photos": {
      "get": {
        "operationId": "getMarsRoverPhotos",
        "summary": "Mars Rover Photos",
        "description": "Retrieves photos taken by Mars rovers (Curiosity, Opportunity, Spirit, Perseverance).",
        "tags": [
          "Mars Rovers"
        ],
        "parameters": [
          {
            "name": "rover",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "curiosity",
                "opportunity",
                "spirit",
                "perseverance"
              ]
            },
            "description": "Rover name"
          },
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sol",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Martian sol (day)"
          },
          {
            "name": "earth_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Earth date (YYYY-MM-DD)"
          },
          {
            "name": "camera",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "FHAZ",
                "RHAZ",
                "MAST",
                "CHEMCAM",
                "MAHLI",
                "MARDI",
                "NAVCAM",
                "PANCAM",
                "MINITES"
              ]
            },
            "description": "Camera abbreviation"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number (25 items per page)"
          }
        ],
        "responses": {
          "200": {
            "description": "Mars rover photos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarsPhotosResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
