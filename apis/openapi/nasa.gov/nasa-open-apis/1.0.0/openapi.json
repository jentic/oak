{
  "openapi": "3.0.3",
  "info": {
    "title": "NASA Open APIs",
    "version": "1.0.0",
    "description": "NASA Open APIs provide access to NASA data including Astronomy Picture of the Day (APOD), Mars Rover Photos, Near-Earth Object data (NeoWs), Earth imagery (EPIC), and more. Free API key available at api.nasa.gov.",
    "x-jentic-source-url": "https://api.nasa.gov/"
  },
  "servers": [
    {
      "url": "https://api.nasa.gov"
    }
  ],
  "paths": {
    "/planetary/apod": {
      "get": {
        "operationId": "getApod",
        "summary": "Astronomy Picture of the Day",
        "description": "Returns the Astronomy Picture of the Day along with metadata. One of the most popular NASA APIs.",
        "tags": [
          "APOD"
        ],
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key (use DEMO_KEY for testing)"
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Date of the APOD (YYYY-MM-DD). Default is today."
          },
          {
            "name": "start_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start of date range"
          },
          {
            "name": "end_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End of date range"
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Return count random APODs"
          },
          {
            "name": "thumbs",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Return video thumbnail URL"
          }
        ],
        "responses": {
          "200": {
            "description": "APOD data",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApodResponse"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ApodResponse"
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/neo/rest/v1/feed": {
      "get": {
        "operationId": "getNeoFeed",
        "summary": "Near-Earth Object feed",
        "description": "Retrieves a list of near-Earth asteroids based on their closest approach date to Earth.",
        "tags": [
          "NeoWs"
        ],
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date (default: today)"
          },
          {
            "name": "end_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date (max 7 days after start)"
          }
        ],
        "responses": {
          "200": {
            "description": "NEO feed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeoFeedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/neo/rest/v1/neo/{asteroid_id}": {
      "get": {
        "operationId": "getNeoById",
        "summary": "Get asteroid by ID",
        "description": "Retrieves detailed information about a specific near-Earth object.",
