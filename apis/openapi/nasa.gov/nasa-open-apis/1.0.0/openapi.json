    "/planetary/earth/imagery": {
      "get": {
        "operationId": "getEarthImagery",
        "summary": "Earth Landsat imagery",
        "description": "Retrieves the Landsat 8 image for the supplied location and date.",
        "tags": [
          "Earth"
        ],
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
