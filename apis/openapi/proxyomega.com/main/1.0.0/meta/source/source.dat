              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidGB": {
                    "summary": "Invalid GB tier for platinum/mobile",
                    "value": {
                      "success": false,
                      "error": "Invalid gb amount. Allowed values: 1, 5, 15, 25, 50, 100, 150, 200, 500, 1000"
                    }
                  },
                  "InvalidDuration": {
                    "summary": "Invalid duration",
                    "value": {
                      "success": false,
                      "error": "Valid product_type required: unlimited, ipv6, platinum, mobile"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Insufficient balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Insufficient balance. Required: $119.99, Available: $50.00"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
