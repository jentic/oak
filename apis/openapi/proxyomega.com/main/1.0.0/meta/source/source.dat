    },
    "/sub-accounts/{sub_account_id}/subscriptions/{subscription_id}": {
      "parameters": [
        {
          "name": "sub_account_id",
          "in": "path",
          "required": true,
          "description": "Sub-account ID",
          "schema": {
            "type": "integer"
          },
          "example": 567
        },
        {
          "name": "subscription_id",
          "in": "path",
          "required": true,
          "description": "Subscription ID to cancel",
          "schema": {
            "type": "integer"
          },
          "example": 890
        }
      ],
      "delete": {
        "tags": [
          "Subscriptions (Provisioning)"
        ],
        "summary": "Cancel Subscription (Deprovision)",
        "description": "Cancel an active subscription and deprovision the service.\n\n**Important:**\n- Cancellation is immediate\n- No refunds are issued\n- For bandwidth-based products (Platinum, Mobile), unused bandwidth is forfeited\n- Sub-account will lose access immediately\n\n**Use Cases:**\n- Customer requests cancellation\n- Non-payment\n- Service downgrade",
        "operationId": "cancelSubscription",
        "responses": {
          "200": {
            "description": "Subscription cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Subscription cancelled successfully"
                }
              }
            }
          },
          "404": {
            "description": "Subscription not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Subscription not found"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/sub-accounts/{id}/proxy-list": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Sub-account ID",
          "schema": {
            "type": "integer"
          },
          "example": 567
        }
      ],
      "get": {
        "tags": [
          "Subscriptions (Provisioning)"
        ],
        "summary": "Generate Proxy List",
        "description": "Generate a formatted proxy list for a sub-account's subscription with geographic targeting applied.\n\n## Product Types & Targeting\n\n### Platinum Residential & Mobile (Traffic-Based)\nTargeting applied via username format parameters:\n- `country` - ISO 2-letter code (lowercase): `us`, `gb`, `de`\n- `region` - State/region name (lowercase, spaces\u2192underscores): `california`, `new_york`\n- `city` - City name (lowercase): `los_angeles`, `chicago`\n- `asn` - ASN number: `12345`\n- `session` - Sticky session ID for persistent IPs: `abc123`\n- `ttl` - Session duration in minutes: `30` (default: 5)\n\n### IPv6 Datacenter\nTargeting via username format:\n- `country` - ISO 2-letter code\n- `session` - Sticky session ID\n- `ttl` - Session duration in minutes\n\n### Unlimited Residential\nReturns port-based proxy list. Country targeting is configured per-port via the `/port-configs` endpoint, not via this endpoint.\n\n## Output Formats\n- `host:port:username:password` (default)\n- `host:port`\n- `username:password@host:port`\n- `http://username:password@host:port`\n- `socks5://username:password@host:port`\n- `json` - Structured JSON array\n- `csv` - CSV format with headers",
        "operationId": "generateProxyList",
        "parameters": [
          {
            "name": "product_type",
            "in": "query",
            "required": true,
            "description": "Type of proxy product",
            "schema": {
              "type": "string",
              "enum": [
                "unlimited",
                "ipv6",
                "platinum",
                "mobile"
              ]
            },
            "example": "platinum"
          },
          {
            "name": "subscription_id",
            "in": "query",
            "description": "Specific subscription ID (required for unlimited/ipv6)",
            "schema": {
              "type": "integer"
            },
            "example": 890
          },
          {
            "name": "country",
            "in": "query",
            "description": "ISO 2-letter country code (lowercase) for targeting",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          },
          {
            "name": "region",
            "in": "query",
            "description": "State/region name (platinum/mobile only)",
            "schema": {
              "type": "string"
            },
            "example": "california"
          },
          {
            "name": "city",
            "in": "query",
            "description": "City name (platinum/mobile only)",
            "schema": {
              "type": "string"
            },
            "example": "los_angeles"
          },
          {
            "name": "asn",
            "in": "query",
            "description": "ASN number for targeting (platinum/mobile only)",
            "schema": {
              "type": "integer"
            },
            "example": 12345
          },
          {
            "name": "session",
            "in": "query",
            "description": "Sticky session ID for persistent IP",
            "schema": {
              "type": "string"
            },
            "example": "abc123"
          },
          {
            "name": "ttl",
            "in": "query",
            "description": "Session duration in minutes (1-60)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 5
            },
            "example": 30
          },
          {
            "name": "quantity",
            "in": "query",
            "description": "Number of proxies to generate (1-1000)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 10
            },
            "example": 100
          },
          {
            "name": "format",
            "in": "query",
            "description": "Output format for proxy list",
            "schema": {
              "type": "string",
              "enum": [
                "host:port:username:password",
                "host:port",
                "username:password@host:port",
                "http://username:password@host:port",
                "socks5://username:password@host:port",
                "json",
                "csv"
              ],
              "default": "host:port:username:password"
            },
            "example": "http://username:password@host:port"
          }
        ],
        "responses": {
          "200": {
            "description": "Proxy list generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "product_type": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer"
                        },
                        "format": {
                          "type": "string"
                        },
                        "targeting": {
                          "type": "object",
                          "properties": {
                            "country": {
                              "type": "string"
                            },
                            "region": {
                              "type": "string"
                            },
                            "city": {
                              "type": "string"
                            },
                            "session": {
                              "type": "string"
                            },
                            "ttl": {
                              "type": "integer"
                            }
                          }
                        },
                        "proxy_list": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "PlatinumWithTargeting": {
                    "summary": "Platinum proxies with US targeting",
                    "value": {
                      "success": true,
                      "data": {
                        "product_type": "platinum",
                        "quantity": 5,
                        "format": "host:port:username:password",
                        "targeting": {
                          "country": "us",
                          "region": "california",
                          "city": "los_angeles",
                          "session": "abc123",
                          "ttl": 30
                        },
                        "proxy_list": [
                          "207.174.105.17:20228:customer_johndoe-country-us-region-california-city-los_angeles-session-abc123-ttl-30:A8k#mP2$vL9@xQ",
                          "207.174.105.17:20228:customer_johndoe-country-us-region-california-city-los_angeles-session-abc124-ttl-30:A8k#mP2$vL9@xQ"
                        ]
                      }
                    }
                  },
                  "UnlimitedProxies": {
                    "summary": "Unlimited residential proxies (port-based)",
                    "value": {
                      "success": true,
                      "data": {
                        "product_type": "unlimited",
                        "subscription_id": 890,
                        "quantity": 5,
                        "format": "host:port:username:password",
                        "proxy_list": [
                          "207.174.105.17:10000:customer_johndoe:A8k#mP2$vL9@xQ",
                          "207.174.105.17:10001:customer_johndoe:A8k#mP2$vL9@xQ",
                          "207.174.105.17:10002:customer_johndoe:A8k#mP2$vL9@xQ",
                          "207.174.105.17:10003:customer_johndoe:A8k#mP2$vL9@xQ",
                          "207.174.105.17:10004:customer_johndoe:A8k#mP2$vL9@xQ"
                        ]
                      }
                    }
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "207.174.105.17:20228:customer_johndoe-country-us:A8k#mP2$vL9@xQ\n207.174.105.17:20228:customer_johndoe-country-us:A8k#mP2$vL9@xQ\n"
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Invalid product_type. Allowed values: unlimited, ipv6, platinum, mobile"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/sub-accounts/{sub_account_id}/subscriptions/{subscription_id}/port-configs": {
      "parameters": [
        {
          "name": "sub_account_id",
          "in": "path",
          "required": true,
          "description": "Sub-account ID",
          "schema": {
            "type": "integer"
          },
          "example": 567
        },
        {
          "name": "subscription_id",
          "in": "path",
          "required": true,
          "description": "Unlimited Residential subscription ID",
          "schema": {
            "type": "integer"
          },
          "example": 890
        }
      ],
      "get": {
        "tags": [
          "Subscriptions (Provisioning)"
        ],
        "summary": "Get Port Configurations",
        "description": "Retrieve port configurations for an Unlimited Residential subscription.\n\n**Only applicable for `unlimited` product type subscriptions.**\n\nEach port can have its own configuration:\n- **Country targeting** - Which country's IPs to use\n- **Rotation interval** - How often to rotate IP (1-60 minutes)\n- **Notes** - Optional description for the port\n\nPorts without custom configuration use the subscription defaults.",
        "operationId": "getPortConfigs",
        "responses": {
          "200": {
            "description": "Port configurations retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "subscription_id": {
                          "type": "integer"
                        },
                        "total_ports": {
                          "type": "integer"
                        },
                        "port_range": {
                          "type": "object",
                          "properties": {
                            "start": {
                              "type": "integer"
                            },
                            "end": {
                              "type": "integer"
                            }
                          }
                        },
                        "default_config": {
                          "type": "object",
                          "properties": {
                            "rotation_minutes": {
                              "type": "integer"
                            },
                            "country_targeting": {
                              "type": "string"
                            }
                          }
                        },
                        "configurations": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PortConfig"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "subscription_id": 890,
                    "total_ports": 5,
                    "port_range": {
                      "start": 10000,
                      "end": 10004
                    },
                    "default_config": {
                      "rotation_minutes": 5,
                      "country_targeting": "all"
                    },
                    "configurations": [
                      {
                        "id": 123,
                        "port_number": 10000,
                        "rotation_minutes": 3,
                        "country_targeting": "us",
                        "enabled": true,
                        "notes": "US scraping bot",
                        "created_at": "2025-12-01 10:00:00",
                        "updated_at": "2025-12-01 10:00:00"
                      },
                      {
                        "id": 124,
                        "port_number": 10002,
                        "rotation_minutes": 10,
                        "country_targeting": "de",
                        "enabled": true,
                        "notes": "German market research",
                        "created_at": "2025-12-01 10:05:00",
                        "updated_at": "2025-12-01 10:05:00"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid subscription type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Port configurations are only available for Unlimited Residential subscriptions"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "post": {
        "tags": [
          "Subscriptions (Provisioning)"
        ],
        "summary": "Create/Update Port Configuration",
        "description": "Create or update a port configuration for an Unlimited Residential subscription.\n\n**Only applicable for `unlimited` product type subscriptions.**\n\n## Configuration Options\n\n| Parameter | Description | Values |\n|-----------|-------------|--------|\n| `port_number` | Port to configure | Based on subscription (10000-100XX) |\n| `rotation_minutes` | IP rotation interval | 1, 3, 5, 10, 15, 20, 30, 45, 60 |\n| `country_targeting` | Country for proxy IPs | `all` or ISO 2-letter code |\n| `enabled` | Whether port config is active | true/false |\n| `notes` | Optional description | Any text (max 255 chars) |\n\n## Available Countries (150+)\nal, dz, ao, ar, am, au, at, az, bh, bd, bb, by, be, bz, bj, bm, bt, bo, ba, bw, br, bn, bg, bf, kh, cm, ca, cv, ky, cl, co, cr, hr, cu, cw, cy, cz, dk, do, cd, ec, eg, sv, ee, et, fj, fi, fr, gf, ga, gm, ge, de, gh, gr, gt, gn, gy, hn, hk, hu, in, id, ir, iq, ie, il, it, jm, jp, jo, kz, ke, kg, la, lv, lb, lt, lu, mk, my, mv, mt, mu, mx, md, mn, me, ma, mz, mm, na, np, nl, nz, ni, ng, no, om, pk, pa, py, pe, ph, pl, pt, pr, qa, ro, ru, rw, sa, sn, rs, sg, sk, si, za, kr, es, lk, se, ch, tw, tj, tz, th, tg, tt, tn, tr, ua, ae, gb, us, uy, uz, ve, vn, ye, zm, zw\n\n## Behavior\n- If a configuration already exists for the port, it will be updated\n- If no configuration exists, a new one will be created\n- Ports without configurations use subscription defaults",
        "operationId": "createOrUpdatePortConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortConfigCreate"
              },
              "examples": {
                "USTargeting": {
                  "summary": "Configure port for US traffic",
                  "value": {
                    "port_number": 10000,
                    "rotation_minutes": 5,
                    "country_targeting": "us",
                    "notes": "US market scraping"
                  }
                },
                "FastRotation": {
                  "summary": "Fast rotation with Germany targeting",
                  "value": {
                    "port_number": 10001,
                    "rotation_minutes": 1,
                    "country_targeting": "de",
                    "notes": "Fast rotation German bot"
                  }
                },
                "DisablePort": {
                  "summary": "Disable a port configuration",
                  "value": {
                    "port_number": 10002,
                    "enabled": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Port configuration created/updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/PortConfig"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Port configuration updated successfully",
                  "data": {
                    "id": 123,
                    "port_number": 10000,
                    "rotation_minutes": 5,
                    "country_targeting": "us",
                    "enabled": true,
                    "notes": "US market scraping",
                    "created_at": "2025-12-01 10:00:00",
                    "updated_at": "2025-12-03 14:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidPort": {
                    "summary": "Port not in subscription range",
                    "value": {
                      "success": false,
                      "error": "Invalid port_number. Must be between 10000 and 10004 for this subscription."
                    }
                  },
                  "InvalidRotation": {
                    "summary": "Invalid rotation interval",
                    "value": {
                      "success": false,
                      "error": "Invalid rotation_minutes. Allowed values: 1, 3, 5, 10, 15, 20, 30, 45, 60"
                    }
                  },
                  "InvalidCountry": {
                    "summary": "Invalid country code",
                    "value": {
                      "success": false,
                      "error": "Invalid country_targeting. Use 'all' or a valid ISO 2-letter country code."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/sub-accounts/{sub_account_id}/subscriptions/{subscription_id}/port-configs/{config_id}": {
      "parameters": [
        {
          "name": "sub_account_id",
          "in": "path",
          "required": true,
          "description": "Sub-account ID",
          "schema": {
            "type": "integer"
          },
          "example": 567
        },
        {
          "name": "subscription_id",
          "in": "path",
          "required": true,
          "description": "Unlimited Residential subscription ID",
          "schema": {
            "type": "integer"
          },
          "example": 890
        },
        {
          "name": "config_id",
          "in": "path",
          "required": true,
          "description": "Port configuration ID",
          "schema": {
            "type": "integer"
          },
          "example": 123
        }
      ],
      "delete": {
        "tags": [
          "Subscriptions (Provisioning)"
        ],
        "summary": "Delete Port Configuration",
        "description": "Delete a specific port configuration. The port will revert to using subscription defaults.\n\n**Note:** This does not disable the port - it simply removes the custom configuration.",
        "operationId": "deletePortConfig",
        "responses": {
          "200": {
            "description": "Port configuration deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Port configuration deleted. Port 10000 now uses subscription defaults."
                }
              }
            }
          },
          "404": {
            "description": "Configuration not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Port configuration not found"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header",
        "description": "API key for production environment. Found in Reseller Center > Overview tab.\n\n**Requirements for Production API:**\n1. Valid API key (X-API-Key header)\n2. KYC verification completed and verified\n\n**Note:** The development/sandbox API at `/dev` requires neither authentication nor KYC verification"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Error message here"
          },
          "details": {
            "type": "object",
            "description": "Additional error details (optional)"
          },
          "_dev_mode": {
            "type": "boolean",
            "description": "Present and set to true when using development/sandbox API"
          }
        }
      },
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "balance": {
                "type": "number",
                "description": "Current reseller balance in USD"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "bronze",
                  "silver",
                  "gold",
                  "platinum"
                ]
              },
              "current_discount": {
                "type": "string"
              },
              "monthly_spending": {
                "type": "number"
              },
              "spending_reset_date": {
                "type": "string",
                "format": "date"
              },
              "next_tier": {
                "type": "string",
                "nullable": true
              },
              "amount_to_next_tier": {
                "type": "number",
                "nullable": true
              },
              "minimum_balance_required": {
                "type": "number"
              },
              "company_name": {
                "type": "string",
                "nullable": true
              },
              "tier_thresholds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tier": {
                      "type": "string"
                    },
                    "min_monthly_volume": {
                      "type": "number"
                    },
                    "discount_percentage": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ProductsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string"
              },
              "discount_percentage": {
                "type": "number"
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "deposit",
              "provision",
              "refund",
              "adjustment"
            ]
          },
          "amount": {
            "type": "number"
          },
          "balance_before": {
            "type": "number"
          },
          "balance_after": {
            "type": "number"
          },
          "sub_account_id": {
            "type": "integer",
            "nullable": true
          },
          "subscription_id": {
            "type": "integer",
            "nullable": true
          },
          "payment_method": {
            "type": "string",
            "nullable": true
          },
          "external_reference": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SubAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "external_id": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "active_subscriptions": {
            "type": "integer"
          },
          "total_spent": {
            "type": "number"
          }
        }
      },
      "SubAccountDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SubAccount"
          },
          {
            "type": "object",
            "properties": {
              "subscriptions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Subscription"
                }
              },
              "total_spent": {
                "type": "number"
              },
              "whitelist_ips": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "product_type": {
            "type": "string",
            "enum": [
              "unlimited",
              "platinum",
              "mobile",
              "ipv6"
            ]
          },
          "ports": {
            "type": "integer",
            "nullable": true
          },
          "threads": {
            "type": "integer",
            "nullable": true
          },
          "bandwidth_gb": {
            "type": "number",
            "nullable": true
          },
          "bandwidth_used_gb": {
            "type": "number",
            "nullable": true
          },
          "wholesale_price": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "cancelled",
              "pending_cancellation"
            ]
          },
          "date_purchased": {
            "type": "string",
            "format": "date-time"
          },
          "date_expiry": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "country_targeting": {
            "type": "string",
            "nullable": true
          },
          "protocol": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        }
      },
      "ProvisionUnlimited": {
        "type": "object",
        "required": [
          "product_type",
          "duration",
          "ports"
        ],
        "properties": {
          "product_type": {
            "type": "string",
            "enum": [
              "unlimited"
            ]
          },
          "duration": {
            "type": "string",
            "enum": [
              "1_day",
              "7_days",
              "30_days"
            ]
          },
          "ports": {
            "type": "integer",
            "enum": [
              5,
              15,
              25,
              50,
              100
            ]
          },
          "country_targeting": {
            "type": "string",
            "default": "all"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "both",
              "http",
              "socks5"
            ],
            "default": "both"
          }
        }
      },
      "ProvisionPlatinum": {
        "type": "object",
        "required": [
          "product_type",
          "gb"
        ],
        "properties": {
          "product_type": {
            "type": "string",
            "enum": [
              "platinum"
            ]
          },
          "gb": {
            "type": "integer",
            "enum": [
              1,
              5,
              15,
              25,
              50,
              100,
              150,
              200,
              500,
              1000
            ]
          }
        }
      },
      "ProvisionMobile": {
        "type": "object",
        "required": [
          "product_type",
          "gb"
        ],
        "properties": {
          "product_type": {
            "type": "string",
            "enum": [
              "mobile"
            ]
          },
          "gb": {
            "type": "integer",
            "enum": [
              1,
              5,
              15,
              25,
              50,
              100,
              150,
              200,
              500,
              1000
            ]
          }
        }
      },
      "ProvisionIPv6": {
        "type": "object",
        "required": [
          "product_type",
          "duration",
          "threads"
        ],
        "properties": {
          "product_type": {
            "type": "string",
            "enum": [
              "ipv6"
            ]
          },
          "duration": {
            "type": "string",
            "enum": [
              "1_day",
              "7_days",
              "30_days"
            ]
          },
          "threads": {
            "type": "integer",
            "enum": [
              100,
              250,
              500,
              1000
            ]
          },
          "country_targeting": {
            "type": "string",
            "default": "all"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "both",
              "http",
              "socks5"
            ],
            "default": "both"
          }
        }
      },
      "PortConfig": {
        "type": "object",
        "description": "Port configuration for Unlimited Residential subscription",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Configuration ID"
          },
          "port_number": {
            "type": "integer",
            "description": "Port number (10000-100XX based on subscription)"
          },
          "rotation_minutes": {
            "type": "integer",
            "description": "IP rotation interval in minutes",
            "enum": [
              1,
              3,
              5,
              10,
              15,
              20,
              30,
              45,
              60
            ]
          },
          "country_targeting": {
            "type": "string",
            "description": "Country code (lowercase) or 'all' for worldwide"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this configuration is active"
          },
          "notes": {
            "type": "string",
            "description": "Optional description/notes for this port",
            "maxLength": 255
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PortConfigCreate": {
        "type": "object",
        "description": "Request body for creating/updating port configuration",
        "required": [
          "port_number"
        ],
        "properties": {
          "port_number": {
            "type": "integer",
            "description": "Port number to configure (must be within subscription range)",
            "example": 10000
          },
          "rotation_minutes": {
            "type": "integer",
            "description": "IP rotation interval in minutes",
            "enum": [
              1,
              3,
              5,
              10,
              15,
              20,
              30,
              45,
              60
            ],
            "default": 5,
            "example": 5
          },
          "country_targeting": {
            "type": "string",
            "description": "Country code (lowercase ISO 2-letter) or 'all' for worldwide",
            "default": "all",
            "example": "us"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this configuration is active",
            "default": true,
            "example": true
          },
          "notes": {
            "type": "string",
            "description": "Optional description/notes for this port",
            "maxLength": 255,
            "example": "US market scraping bot"
          }
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Authentication failed - Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": "Invalid API key"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": "Resource not found"
            }
          }
        }
      }
    }
  }
}