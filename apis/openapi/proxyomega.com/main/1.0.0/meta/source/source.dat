  "paths": {
    "/": {
      "get": {
        "tags": [
          "API Info"
        ],
        "summary": "Get API Information",
        "description": "Returns API version, your reseller information, and a list of available endpoints.\n\nUse this endpoint to verify your API connection and authentication.",
        "operationId": "getApiInfo",
        "responses": {
          "200": {
            "description": "API information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string",
                          "example": "1.0"
                        },
                        "reseller": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 123
                            },
                            "email": {
                              "type": "string",
                              "example": "reseller@company.com"
                            },
                            "tier": {
                              "type": "string",
                              "example": "silver"
                            },
                            "balance": {
                              "type": "number",
                              "example": 1250.5
                            }
                          }
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "GET /balance",
                            "POST /balance/transfer",
                            "GET /products",
                            "GET /sub-accounts"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/balance": {
      "get": {
        "tags": [
          "Balance & Transactions"
        ],
        "summary": "Get Balance",
        "description": "Retrieve your current reseller balance, tier information, monthly spending, and tier progression details.\n\n**Response includes:**\n- Current balance available for provisioning\n- Your reseller tier and discount percentage\n- Monthly spending (resets on the 1st of each month)\n- Amount needed to reach the next tier\n- All tier thresholds",
        "operationId": "getBalance",
        "responses": {
          "200": {
            "description": "Balance information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "balance": 1250.5,
                    "tier": "silver",
                    "current_discount": "20%",
                    "monthly_spending": 6500.0,
                    "spending_reset_date": "2025-01-01",
                    "next_tier": "gold",
                    "amount_to_next_tier": 3500.0,
                    "minimum_balance_required": 500.0,
                    "company_name": "Tech Solutions Inc",
                    "tier_thresholds": [
                      {
                        "tier": "bronze",
                        "min_monthly_volume": 0,
                        "discount_percentage": 15
                      },
                      {
                        "tier": "silver",
                        "min_monthly_volume": 5000,
                        "discount_percentage": 20
                      },
                      {
                        "tier": "gold",
                        "min_monthly_volume": 10000,
                        "discount_percentage": 25
                      },
                      {
                        "tier": "platinum",
                        "min_monthly_volume": 25000,
                        "discount_percentage": 30
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/balance/transfer": {
      "post": {
        "tags": [
          "Balance & Transactions"
        ],
        "summary": "Transfer Funds from Main Account",
        "description": "Transfer funds from your main ProxyOmega account balance to your reseller account balance.\n\n**Transfer Rules:**\n- **First transfer**: $500 minimum (KYC verification required)\n- **Subsequent transfers**: $100 minimum\n- **Maximum per transfer**: $10,000\n- Transfers are instant and atomic\n\n**Use Cases:**\n- Initial reseller account funding\n- Adding funds for customer provisioning\n- Maintaining operational balance\n\n**Note:** KYC verification is automatically checked via the Reseller Center dashboard.",
        "operationId": "transferFunds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount"
                ],
                "properties": {
                  "amount": {
                    "type": "number",
                    "format": "float",
                    "minimum": 100,
                    "maximum": 10000,
                    "description": "Amount to transfer in USD",
                    "example": 1000.0
                  }
                }
              },
              "examples": {
                "FirstTransfer": {
                  "summary": "First transfer (KYC required)",
                  "value": {
                    "amount": 500.0
                  }
                },
                "SubsequentTransfer": {
                  "summary": "Subsequent transfer",
                  "value": {
                    "amount": 1000.0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Funds transferred successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Funds transferred successfully."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "amount": {
                          "type": "number",
                          "example": 1000.0
                        },
                        "new_reseller_balance": {
                          "type": "number",
                          "example": 2250.5
                        },
                        "new_main_balance": {
                          "type": "number",
                          "example": 450.25
                        },
                        "is_first_transfer": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid amount or insufficient funds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InsufficientFunds": {
                    "summary": "Insufficient funds in main account",
                    "value": {
                      "success": false,
                      "error": "Insufficient funds in main account. Please add funds via the Billing page first.",
                      "details": {
                        "available": 450.0,
                        "requested": 1000.0,
                        "shortfall": 550.0
                      }
                    }
                  },
                  "MinimumAmount": {
                    "summary": "Below minimum amount",
                    "value": {
                      "success": false,
                      "error": "Minimum transfer amount is $100.",
                      "details": {
                        "minimum_amount": 100,
                        "is_first_transfer": false
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "KYC verification required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "KYC verification required before your first transfer. Please complete identity verification first.",
                  "details": {
                    "kyc_required": true,
                    "is_first_transfer": true
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": [
          "Balance & Transactions"
        ],
        "summary": "Get Transaction History",
        "description": "Retrieve your transaction history with pagination and optional filtering.\n\n**Transaction Types:**\n- `deposit` - Funds transferred from main account\n- `provision` - Service provisioned for sub-account\n- `refund` - Refund issued to reseller balance\n- `adjustment` - Manual adjustment by admin\n\n**Use Cases:**\n- Reconciliation and accounting\n- Customer billing reports\n- Audit trails",
        "operationId": "getTransactions",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (starts at 1)",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Results per page",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 10,
              "maximum": 100
            },
            "example": 50
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by transaction type",
            "schema": {
              "type": "string",
              "enum": [
                "deposit",
                "provision",
                "refund",
                "adjustment"
              ]
            },
            "example": "provision"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction history retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "transactions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Transaction"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "transactions": [
                      {
                        "id": 1234,
                        "type": "provision",
                        "amount": 119.99,
                        "balance_before": 1250.5,
                        "balance_after": 1130.51,
                        "sub_account_id": 567,
                        "subscription_id": 890,
                        "payment_method": null,
                        "external_reference": null,
                        "description": "Provisioned 5 ports unlimited residential - 30 days",
                        "created_at": "2025-12-03 10:30:00"
                      },
                      {
                        "id": 1233,
                        "type": "deposit",
                        "amount": 1000.0,
                        "balance_before": 250.5,
                        "balance_after": 1250.5,
                        "sub_account_id": null,
                        "subscription_id": null,
                        "payment_method": "account_transfer",
                        "external_reference": null,
                        "description": "Transfer from main account",
                        "created_at": "2025-12-03 09:15:00"
                      }
                    ],
                    "pagination": {
                      "page": 1,
                      "limit": 20,
                      "total": 45,
                      "total_pages": 3
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Get Products & Wholesale Pricing",
        "description": "Retrieve all available proxy products with your tier-based wholesale pricing.\n\n**Product Types:**\n\n1. **Unlimited Residential Proxies**\n   - Time-based subscriptions (1 day, 7 days, 30 days)\n   - Port-based pricing (5, 15, 25, 50, 100 ports)\n   - Unlimited bandwidth per port\n   - **Per-port country & rotation configuration** (150+ countries)\n   - Configure via `/port-configs` endpoint\n\n2. **Platinum Residential Proxies**\n   - Pay-per-GB bandwidth model\n   - Fixed GB tiers: 1, 5, 15, 25, 50, 100, 150, 200, 500, 1000\n   - Bandwidth never expires\n   - **150+ countries via username targeting** (country, region, city, ASN)\n   - Session persistence with TTL support\n\n3. **Mobile 4G/5G Proxies**\n   - Pay-per-GB bandwidth model\n   - Same GB tiers as Platinum\n   - Real mobile carrier IPs\n   - **Same country coverage as Platinum** (150+ countries)\n   - Session persistence with TTL support\n\n4. **IPv6 Datacenter Proxies**\n   - Time-based subscriptions\n   - Thread-based pricing (100, 250, 500, 1000 threads)\n   - High-speed datacenter connectivity\n   - **108 countries via username targeting**\n\n**Pricing Notes:**\n- All prices include your tier discount\n- Retail prices shown for reference\n- Volume discounts available for large orders",
        "operationId": "getProducts",
        "responses": {
          "200": {
            "description": "Product catalog retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductsResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "tier": "silver",
                    "discount_percentage": 20,
                    "products": [
                      {
                        "id": "unlimited",
                        "name": "Unlimited Residential Proxies",
                        "description": "Unlimited bandwidth rotating residential proxies",
                        "type": "unlimited",
                        "features": [
                          "Unlimited bandwidth",
                          "Rotating IPs",
                          "HTTP/HTTPS & SOCKS5",
                          "Global coverage",
                          "No traffic limits"
                        ],
                        "pricing": [
                          {
                            "duration": "30_days",
                            "duration_label": "1 Month",
                            "ports": 5,
                            "retail_price": 119.99,
                            "wholesale_price": 95.99
                          },
                          {
                            "duration": "30_days",
                            "duration_label": "1 Month",
                            "ports": 15,
                            "retail_price": 299.99,
                            "wholesale_price": 239.99
                          }
                        ]
                      },
                      {
                        "id": "platinum",
                        "name": "Platinum Residential Proxies",
                        "description": "Premium rotating residential proxies - pay per GB",
                        "type": "platinum",
                        "billing_model": "per_gb",
                        "features": [
                          "Premium residential IPs",
                          "Pay only for data used",
                          "HTTP/HTTPS & SOCKS5",
                          "Global coverage",
                          "No time expiration"
                        ],
                        "pricing_note": "Pay-per-GB model. Data does not expire. Fixed tiers only.",
                        "pricing": [
                          {
                            "gb": 1,
                            "price_per_gb": 3.0,
                            "retail_price": 3.0,
                            "wholesale_price": 2.4
                          },
                          {
                            "gb": 50,
                            "price_per_gb": 2.5,
                            "retail_price": 125.0,
                            "wholesale_price": 100.0
                          }
                        ]
                      }
                    ],
                    "notes": [
                      "All prices in USD",
                      "Wholesale prices already reflect your tier discount",
                      "Contact support for custom pricing on large volumes"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/geographic/countries": {
      "get": {
        "tags": [
          "Geographic Data"
        ],
        "summary": "Get Available Countries",
        "description": "Retrieve the list of available countries for a specific proxy product type.\n\n**Product Types & Country Availability:**\n- `platinum` & `mobile`: ~129 countries from our residential network\n- `ipv6`: 139 countries with datacenter coverage\n- `unlimited`: 162 countries for rotating residential\n- `premium_unlimited`: Dynamic list from premium network\n\n**Response includes:**\n- `supports_regions`: Whether region/state targeting is available\n- `supports_cities`: Whether city-level targeting is available",
        "operationId": "getCountries",
        "parameters": [
          {
            "name": "product_type",
            "in": "query",
            "required": true,
            "description": "The proxy product type",
            "schema": {
              "type": "string",
              "enum": [
                "platinum",
                "mobile",
                "ipv6",
                "unlimited",
                "premium_unlimited"
              ]
            },
            "example": "platinum"
          }
        ],
        "responses": {
          "200": {
            "description": "Countries retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "product_type": {
                          "type": "string"
                        },
                        "countries": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "total": {
                          "type": "integer"
                        },
                        "supports_regions": {
                          "type": "boolean"
                        },
                        "supports_cities": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "product_type": "platinum",
                    "countries": [
                      {
                        "code": "",
                        "name": "Random (Default)"
                      },
                      {
                        "code": "us",
                        "name": "United States"
                      },
                      {
                        "code": "gb",
                        "name": "United Kingdom"
                      },
                      {
                        "code": "de",
                        "name": "Germany"
                      }
                    ],
                    "total": 129,
                    "supports_regions": true,
                    "supports_cities": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid product_type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Invalid product_type. Allowed: platinum, mobile, ipv6, unlimited, premium_unlimited"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/geographic/regions": {
      "get": {
        "tags": [
          "Geographic Data"
        ],
        "summary": "Get Available Regions/States",
        "description": "Retrieve available regions or states for a specific country.\n\n**Only available for:**\n- `platinum` & `mobile`: Regions extracted from residential network coverage\n\n**Not available for:**\n- `ipv6`: Country-level targeting only\n- `unlimited`: Country-level targeting only\n- `premium_unlimited`: Use cities endpoint directly",
        "operationId": "getRegions",
        "parameters": [
          {
            "name": "product_type",
            "in": "query",
            "required": true,
            "description": "The proxy product type",
            "schema": {
              "type": "string",
              "enum": [
                "platinum",
                "mobile"
              ]
            },
            "example": "platinum"
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 2-letter country code (lowercase)",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          }
        ],
        "responses": {
          "200": {
            "description": "Regions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "product_type": {
                          "type": "string"
                        },
                        "country": {
                          "type": "string"
                        },
                        "regions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "product_type": "platinum",
                    "country": "us",
                    "regions": [
                      {
                        "code": "",
                        "name": "All Regions (Default)"
                      },
                      {
                        "code": "california",
                        "name": "California"
                      },
                      {
                        "code": "new_york",
                        "name": "New York"
                      },
                      {
                        "code": "texas",
                        "name": "Texas"
                      }
                    ],
                    "total": 51
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/geographic/cities": {
      "get": {
        "tags": [
          "Geographic Data"
        ],
        "summary": "Get Available Cities",
        "description": "Retrieve available cities for a specific country, optionally filtered by region.\n\n**Available for:**\n- `platinum` & `mobile`: ~13,000+ cities from residential network\n- `premium_unlimited`: Dynamic city list from premium network\n\n**Not available for:**\n- `ipv6`: Country-level targeting only\n- `unlimited`: Country-level targeting only",
        "operationId": "getCities",
        "parameters": [
          {
            "name": "product_type",
            "in": "query",
            "required": true,
            "description": "The proxy product type",
            "schema": {
              "type": "string",
              "enum": [
                "platinum",
                "mobile",
                "premium_unlimited"
              ]
            },
            "example": "platinum"
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 2-letter country code (lowercase)",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            },
            "example": "us"
          },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by region/state code (platinum/mobile only)",
            "schema": {
              "type": "string"
            },
            "example": "california"
          }
        ],
        "responses": {
          "200": {
            "description": "Cities retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "product_type": {
                          "type": "string"
                        },
                        "country": {
                          "type": "string"
                        },
                        "region": {
                          "type": "string"
                        },
                        "cities": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string",
                                "description": "Value to use in proxy targeting"
                              },
                              "name": {
                                "type": "string",
                                "description": "Human-readable city name"
                              }
                            }
                          }
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "product_type": "platinum",
                    "country": "us",
                    "region": "california",
                    "cities": [
                      {
                        "code": "",
                        "name": "All Cities (Default)"
                      },
                      {
                        "code": "region-california-city-los_angeles",
                        "name": "Los Angeles"
                      },
                      {
                        "code": "region-california-city-san_francisco",
                        "name": "San Francisco"
                      },
                      {
                        "code": "region-california-city-san_diego",
                        "name": "San Diego"
                      }
                    ],
                    "total": 234
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/sub-accounts": {
      "get": {
        "tags": [
          "Sub-Accounts"
        ],
        "summary": "List Sub-Accounts",
        "description": "Retrieve a paginated list of all your sub-accounts with optional search and status filtering.\n\n**Use Cases:**\n- Customer management dashboard\n- Account status monitoring\n- Bulk operations\n\n**Search:**\n- Search by username, email, external_id, or label\n- Case-insensitive partial matching",
        "operationId": "listSubAccounts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 50
            },
            "example": 20
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search by username, email, external_id, or label",
            "schema": {
              "type": "string"
            },
            "example": "customer_123"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "suspended",
                "all"
              ],
              "default": "all"
            },
            "example": "active"
          }
        ],
        "responses": {
          "200": {
            "description": "Sub-accounts list retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "sub_accounts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/SubAccount"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "sub_accounts": [
                      {
                        "id": 567,
                        "external_id": "cust_abc123",
                        "username": "customer_johndoe",
                        "email": "john@example.com",
                        "label": "John Doe - Enterprise",
                        "status": "active",
                        "created_at": "2025-11-15 14:30:00",
                        "active_subscriptions": 2,
                        "total_spent": 450.0
                      },
                      {
                        "id": 568,
                        "external_id": "cust_xyz789",
                        "username": "customer_janedoe",
                        "email": "jane@example.com",
                        "label": "Jane Doe - Startup",
                        "status": "active",
                        "created_at": "2025-11-20 09:15:00",
                        "active_subscriptions": 1,
                        "total_spent": 119.99
                      }
                    ],
                    "pagination": {
                      "page": 1,
                      "limit": 20,
                      "total": 45,
                      "total_pages": 3
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "post": {
        "tags": [
          "Sub-Accounts"
        ],
        "summary": "Create Sub-Account",
        "description": "Create a new sub-account for your customer.\n\n**Important:**\n- Username must be unique across all ProxyOmega accounts\n- Password is auto-generated and returned once (store it securely)\n- External ID allows you to link to your internal customer ID\n\n**Response includes:**\n- Generated password (save this - cannot be retrieved later)\n- API key for programmatic access\n- Sub-account credentials for proxy authentication",
        "operationId": "createSubAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "email"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{3,32}$",
                    "description": "Unique username (3-32 chars, alphanumeric, dash, underscore)",
                    "example": "customer_johndoe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Customer email address",
                    "example": "john@example.com"
                  },
                  "external_id": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Your internal customer ID for linking",
                    "example": "cust_abc123"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Display name or notes",
                    "example": "John Doe - Enterprise Plan"
                  }
                }
              },
              "examples": {
                "BasicAccount": {
                  "summary": "Basic account creation",
                  "value": {
                    "username": "customer_johndoe",
                    "email": "john@example.com"
                  }
                },
                "WithExternalID": {
                  "summary": "With external ID and label",
                  "value": {
                    "username": "customer_johndoe",
                    "email": "john@example.com",
                    "external_id": "cust_abc123",
                    "label": "John Doe - Enterprise Plan"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sub-account created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "external_id": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string",
                          "description": "Auto-generated password (save this!)"
                        },
                        "api_key": {
                          "type": "string",
                          "description": "API key for programmatic access"
                        },
                        "email": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Sub-account created successfully",
                  "data": {
                    "id": 567,
                    "external_id": "cust_abc123",
                    "username": "customer_johndoe",
                    "password": "A8k#mP2$vL9@xQ",
                    "api_key": "d4e5f6a7-8b9c-0d1e-2f3g-4h5i6j7k8l9m",
                    "email": "john@example.com",
                    "label": "John Doe - Enterprise Plan",
                    "status": "active",
                    "created_at": "2025-12-03 14:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "UsernameExists": {
                    "summary": "Username already exists",
                    "value": {
                      "success": false,
                      "error": "Username 'customer_johndoe' is already taken"
                    }
                  },
                  "InvalidEmail": {
                    "summary": "Invalid email format",
                    "value": {
                      "success": false,
                      "error": "Invalid email address format"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/sub-accounts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Sub-account ID",
          "schema": {
            "type": "integer"
          },
          "example": 567
        }
      ],
      "get": {
        "tags": [
          "Sub-Accounts"
        ],
        "summary": "Get Sub-Account Details",
        "description": "Retrieve detailed information about a specific sub-account including:\n- Account information and status\n- All active subscriptions with expiration dates\n- Total spending and usage statistics\n- Current whitelist IPs",
        "operationId": "getSubAccountDetails",
        "responses": {
          "200": {
            "description": "Sub-account details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SubAccountDetail"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": 567,
                    "external_id": "cust_abc123",
                    "username": "customer_johndoe",
                    "email": "john@example.com",
                    "label": "John Doe - Enterprise Plan",
                    "status": "active",
                    "created_at": "2025-11-15 14:30:00",
                    "subscriptions": [
                      {
                        "id": 890,
                        "product_type": "unlimited",
                        "ports": 5,
                        "status": "active",
                        "date_purchased": "2025-12-01 10:00:00",
                        "date_expiry": "2025-12-31 10:00:00",
                        "wholesale_price": 95.99
                      },
                      {
                        "id": 891,
                        "product_type": "platinum",
                        "bandwidth_gb": 50,
                        "bandwidth_used_gb": 23.5,
                        "status": "active",
                        "date_purchased": "2025-12-01 10:05:00",
                        "wholesale_price": 100.0
                      }
                    ],
                    "total_spent": 195.99,
                    "whitelist_ips": 5
                  }
                }
              }
            }
          },
          "404": {
            "description": "Sub-account not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Sub-account not found"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "put": {
        "tags": [
          "Sub-Accounts"
        ],
        "summary": "Update Sub-Account",
        "description": "Update sub-account details such as email and label.\n\n**Note:** Username cannot be changed after creation.",
        "operationId": "updateSubAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "newemail@example.com"
                  },
                  "label": {
                    "type": "string",
                    "example": "Updated Customer Name - VIP"
                  }
                }
              },
              "examples": {
                "UpdateEmail": {
                  "summary": "Update email address",
                  "value": {
                    "email": "newemail@example.com"
                  }
                },
                "UpdateLabel": {
                  "summary": "Update label",
                  "value": {
                    "label": "John Doe - VIP Customer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-account updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SubAccount"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Sub-account updated successfully",
                  "data": {
                    "id": 567,
                    "external_id": "cust_abc123",
                    "username": "customer_johndoe",
                    "email": "newemail@example.com",
                    "label": "John Doe - VIP Customer",
                    "status": "active",
                    "created_at": "2025-11-15 14:30:00"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "delete": {
        "tags": [
          "Sub-Accounts"
        ],
        "summary": "Delete Sub-Account",
        "description": "Permanently delete a sub-account.\n\n**Warning:**\n- This action is irreversible\n- All active subscriptions will be cancelled\n- No refunds are issued\n- All usage data will be retained for audit purposes\n\nUse suspension instead if you want to temporarily disable access.",
        "operationId": "deleteSubAccount",
        "responses": {
          "200": {
            "description": "Sub-account deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Sub-account deleted successfully. 2 active subscriptions cancelled."
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/sub-accounts/{id}/subscriptions": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Sub-account ID",
          "schema": {
            "type": "integer"
          },
          "example": 567
        }
      ],
      "get": {
        "tags": [
          "Subscriptions (Provisioning)"
        ],
        "summary": "List Sub-Account Subscriptions",
        "description": "Get all subscriptions (active, expired, cancelled) for a sub-account.\n\n**Subscription Statuses:**\n- `active` - Currently active and usable\n- `expired` - Time limit reached\n- `cancelled` - Manually cancelled\n- `pending_cancellation` - Will expire at end of billing period",
        "operationId": "listSubAccountSubscriptions",
        "responses": {
          "200": {
            "description": "Subscriptions list retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "subscriptions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Subscription"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "subscriptions": [
                      {
                        "id": 890,
                        "product_type": "unlimited",
                        "ports": 5,
                        "threads": null,
                        "bandwidth_gb": null,
                        "bandwidth_used_gb": null,
                        "wholesale_price": 95.99,
                        "status": "active",
                        "date_purchased": "2025-12-01 10:00:00",
                        "date_expiry": "2025-12-31 10:00:00",
                        "country_targeting": "all",
                        "protocol": "both"
                      },
                      {
                        "id": 891,
                        "product_type": "platinum",
                        "ports": null,
                        "threads": null,
                        "bandwidth_gb": 50,
                        "bandwidth_used_gb": 23.5,
                        "wholesale_price": 100.0,
                        "status": "active",
                        "date_purchased": "2025-12-01 10:05:00",
                        "date_expiry": null,
                        "country_targeting": null,
                        "protocol": "both"
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "post": {
        "tags": [
          "Subscriptions (Provisioning)"
        ],
        "summary": "Provision Service",
        "description": "Provision a proxy service for a sub-account. The API automatically handles the correct product type based on the parameters provided.\n\n## Product Types & Parameters\n\n### Unlimited Residential\n```json\n{\n  \"product_type\": \"unlimited\",\n  \"duration\": \"30_days\",\n  \"ports\": 5,\n  \"country_targeting\": \"us\",\n  \"protocol\": \"both\"\n}\n```\n- **duration**: `1_day`, `7_days`, `30_days`\n- **ports**: `5`, `15`, `25`, `50`, `100`\n- **country_targeting**: `all` (default), or country code (`us`, `uk`, `de`, etc.)\n- **protocol**: `both` (default), `http`, `socks5`\n\n### Platinum Residential (Pay-per-GB)\n```json\n{\n  \"product_type\": \"platinum\",\n  \"gb\": 50\n}\n```\n- **gb**: Fixed tiers - `1`, `5`, `15`, `25`, `50`, `100`, `150`, `200`, `500`, `1000`\n- Bandwidth never expires\n- Price per GB decreases with volume\n\n### Mobile 4G/5G (Pay-per-GB)\n```json\n{\n  \"product_type\": \"mobile\",\n  \"gb\": 25\n}\n```\n- **gb**: Same tiers as Platinum\n- Real mobile carrier IPs\n- Bandwidth never expires\n\n### IPv6 Datacenter\n```json\n{\n  \"product_type\": \"ipv6\",\n  \"duration\": \"30_days\",\n  \"threads\": 500,\n  \"country_targeting\": \"all\",\n  \"protocol\": \"both\"\n}\n```\n- **duration**: `1_day`, `7_days`, `30_days`\n- **threads**: `100`, `250`, `500`, `1000`\n- **country_targeting**: `all` (default), or country code\n- **protocol**: `both` (default), `http`, `socks5`\n\n## Balance Validation\nYour reseller balance is checked before provisioning. If insufficient, you'll receive a 403 error with the exact amount needed.\n\n## Response\nReturns the provisioned subscription details and updated balance.",
        "operationId": "provisionService",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ProvisionUnlimited"
                  },
                  {
                    "$ref": "#/components/schemas/ProvisionPlatinum"
                  },
                  {
                    "$ref": "#/components/schemas/ProvisionMobile"
                  },
                  {
                    "$ref": "#/components/schemas/ProvisionIPv6"
                  }
                ]
              },
              "examples": {
                "UnlimitedResidential": {
                  "summary": "Unlimited Residential - 5 ports, 30 days",
                  "value": {
                    "product_type": "unlimited",
                    "duration": "30_days",
                    "ports": 5,
                    "country_targeting": "us",
                    "protocol": "both"
                  }
                },
                "PlatinumPayPerGB": {
                  "summary": "Platinum - 50GB",
                  "value": {
                    "product_type": "platinum",
                    "gb": 50
                  }
                },
                "MobilePayPerGB": {
                  "summary": "Mobile - 25GB",
                  "value": {
                    "product_type": "mobile",
                    "gb": 25
                  }
                },
                "IPv6Datacenter": {
                  "summary": "IPv6 - 500 threads, 30 days",
                  "value": {
                    "product_type": "ipv6",
                    "duration": "30_days",
                    "threads": 500,
                    "country_targeting": "all",
                    "protocol": "both"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Service provisioned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "subscription_id": {
                          "type": "integer"
                        },
                        "product_type": {
                          "type": "string"
                        },
                        "wholesale_price": {
                          "type": "number"
                        },
                        "balance_remaining": {
                          "type": "number"
                        },
                        "credentials": {
                          "type": "object",
                          "properties": {
                            "username": {
                              "type": "string"
                            },
                            "password": {
                              "type": "string"
                            },
                            "proxy_list": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "expires_at": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "UnlimitedProvisioned": {
                    "summary": "Unlimited residential provisioned",
                    "value": {
                      "success": true,
                      "message": "Service provisioned successfully",
                      "data": {
                        "subscription_id": 890,
                        "product_type": "unlimited",
                        "wholesale_price": 95.99,
                        "balance_remaining": 1154.51,
                        "credentials": {
                          "username": "customer_johndoe",
                          "password": "A8k#mP2$vL9@xQ",
                          "proxy_list": [
                            "207.174.105.17:10000",
                            "207.174.105.17:10001",
                            "207.174.105.17:10002",
                            "207.174.105.17:10003",
                            "207.174.105.17:10004"
                          ]
                        },
                        "expires_at": "2026-01-02 14:30:00"
                      }
                    }
                  },
                  "PlatinumProvisioned": {
                    "summary": "Platinum 50GB provisioned",
                    "value": {
                      "success": true,
                      "message": "50GB platinum bandwidth provisioned successfully",
                      "data": {
                        "purchase_id": 1245,
                        "product_type": "platinum",
                        "gb_added": 50,
                        "wholesale_price": 100.0,
                        "balance_remaining": 1150.5,
                        "credentials": {
                          "username": "customer_johndoe",
                          "password": "A8k#mP2$vL9@xQ",
                          "proxy_list": [
                            "207.174.105.17:20228"
                          ]
                        },
                        "note": "Bandwidth does not expire. Use until depleted."
                      }
                    }
                  }
                }
              }
            }
