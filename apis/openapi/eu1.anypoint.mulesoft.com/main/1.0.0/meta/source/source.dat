      "ServiceConfirmationRequest": {
        "type": "object",
        "required": [
          "lsp",
          "vin",
          "brand",
          "settlementId",
          "activity",
          "amount",
          "currency"
        ],
        "properties": {
          "lsp": {
            "type": "string",
            "description": "LSP name",
            "example": "InterEuropa Ltd"
          },
          "vin": {
            "type": "string",
            "description": "VIN number of the vehicle",
            "example": "WOL000051T2123456"
          },
          "brand": {
            "type": "string",
            "description": "Related vehicle brand",
            "example": "OPEL"
          },
          "settlementId": {
            "type": "string",
            "description": "TMS settlement identifier for the specific service",
            "example": "SETTL-2026-001"
          },
          "numberOfDaysStored": {
            "type": "number",
            "format": "decimal",
            "description": "Number of days the vehicle has been stored",
            "minimum": 0,
            "example": 5
          },
          "activity": {
            "type": "string",
            "description": "Invoicable activity",
            "enum": [
              "STORAGE",
              "WASHING",
              "PDI",
              "TRANSPORT",
              "LOADING",
              "UNLOADING",
              "INSPECTION",
              "REFUELING"
            ],
            "example": "STORAGE"
          },
          "amount": {
            "type": "number",
            "format": "decimal",
            "description": "Invoicable amount",
            "example": 150.0
          },
          "currency": {
            "type": "string",
            "description": "ISO currency code for the invoiceable amount",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          }
        }
      },
      "ServiceConfirmationResponse": {
        "type": "object",
