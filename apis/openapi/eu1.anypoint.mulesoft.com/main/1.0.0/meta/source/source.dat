  "components": {
    "securitySchemes": {
      "clientCredentials": {
        "type": "http",
        "scheme": "basic",
        "description": "Client Id and Client Secret authentication."
      }
    },
    "parameters": {
      "MDWToLSPSystemId": {
        "name": "systemId",
        "in": "header",
        "required": false,
        "description": "**Totally optional to expose from LSP side\n\nEach system (LSPs/TMS/ERP/F&A) should be assigned a uniqueId from Middleware. \n\n If LSPs require, middleware can pass **TMS system id** towards LSP so they know where was the request originated from. ",
        "schema": {
          "type": "string"
        },
        "example": "TMS001"
      },
      "LSPToMDWSourceSystem": {
        "name": "sourceId",
        "in": "header",
        "required": true,
        "description": "Each system (LSPs/TMS/ERP/F&A) should be assigned a uniqueId from Middleware. \n\n In this case, LSP should pass their **own assigned system id** to middleware so middleware know where was the request originated from.",
        "schema": {
          "type": "string"
        },
        "example": "LSP001"
      },
      "MDWToTMSSystemId": {
        "name": "systemId",
        "in": "header",
        "required": false,
        "description": "**Totally optional to expose from TMS side\n\nEach system (LSPs/TMS/ERP/F&A) should be assigned a uniqueId from Middleware. \n\n If TMS require, middleware can pass **LSP system id** towards TMS so tms know where was the request originated from. ",
        "schema": {
          "type": "string"
        },
        "example": "TMS001"
      },
      "MDWToERPSystemId": {
        "name": "systemId",
        "in": "header",
        "required": false,
        "description": "**Totally optional to expose from ERP side\n\nEach system (LSPs/TMS/ERP/F&A) should be assigned a uniqueId from Middleware. \n\n If ERP require, middleware can pass **LSP or TMS system id** towards ERP so ERP know where was the request originated from. ",
        "schema": {
          "type": "string"
        },
        "example": "LSP001 or TMS001"
      },
      "brand": {
        "name": "brand",
        "in": "header",
        "required": true,
        "description": "Related vehicle brand",
        "schema": {
          "type": "string"
        },
        "example": "OPEL"
      },
      "country": {
        "name": "country",
        "in": "header",
        "required": true,
        "description": "Related country of the transport. ISO\u202f3166-1 alpha-2 country code (e.g. \u201cHU\u201d). Default can be \u201cHU\u201d",
        "schema": {
          "type": "string"
        },
        "example": "HU"
      },
      "TMSToMDWTargetSystem": {
        "name": "targetId",
        "in": "header",
        "required": true,
        "description": "Each system (LSPs/TMS/ERP/F&A) should be assigned a uniqueId from Middleware. \n\n In this case, TMS should pass **LSP system id** to middleware so middleware know which LSP this request should be routed for.",
        "schema": {
          "type": "string"
        },
        "example": "LSP001"
      },
      "ERPToMDWSourceSystem": {
        "name": "sourceId",
        "in": "header",
        "required": true,
        "description": "Each system (LSPs/TMS/ERP/F&A) should be assigned a uniqueId from Middleware. \n\n In this case, ERP should pass their **own assigned system id** to middleware so middleware know where was the request originated from.",
        "schema": {
          "type": "string"
        },
        "example": "ERP001"
      },
      "MDWToDWHSourceSystem": {
        "name": "sourceId",
        "in": "header",
        "required": true,
        "description": "Each system (LSPs/TMS/ERP/F&A) should be assigned a uniqueId from Middleware. \n\n In this case, middleware can pass **LSP or TMS system id** towards DWH so DWH know where was the request originated from.",
        "schema": {
          "type": "string"
        },
        "example": "ERP001"
      },
      "OrderNumber": {
        "name": "orderNumber",
        "in": "path",
        "required": true,
        "description": "Transport order number",
        "schema": {
          "type": "string"
        },
        "example": "AWD-TO-2026-001"
      },
      "ClaimId": {
        "name": "claimId",
        "in": "path",
        "required": true,
        "description": "Damage claim Id",
        "schema": {
          "type": "string"
        },
        "example": "CLAIM-2026-001"
      },
      "ServiceId": {
        "name": "serviceId",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the service report",
        "schema": {
          "type": "string"
        },
        "example": "SVC-2026-001"
      }
    },
    "schemas": {
      "TransportOrderRequest": {
        "type": "object",
        "required": [
          "lsp",
          "orderNumber",
          "vin",
          "timestamp",
          "vehicleStatus",
          "model",
          "typeCode",
          "modelCode",
          "weight",
          "length",
          "width",
          "height",
          "dealer",
          "dealerCode",
          "pickupAddress",
          "deliveryAddress",
          "netValue",
          "operation"
        ],
        "properties": {
          "lsp": {
            "type": "string",
            "description": "LSP name",
            "example": "InterEuropa Ltd"
          },
          "orderNumber": {
            "type": "string",
            "description": "AWD purchase order number",
            "example": "AWD-TO-2026-001"
          },
          "vin": {
            "type": "string",
            "description": "Vehicle identification number (17 characters)",
            "example": "WOL000051T2123456"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Record date (ISO 8601 format)",
            "example": "2026-01-24T11:00:00Z"
          },
          "vehicleStatus": {
            "type": "string",
            "description": "Current status of the vehicle to be delivered",
            "enum": [
              "ORDERED",
              "UNDER_MANUFACTURING",
              "RELEASED",
              "IN_TRANSIT",
              "OUT",
              "IN",
              "TAKE_OVER",
              "CALLOFF",
              "TRUCK_PLANNED",
              "ARRIVED",
              "IN_DAMAGED",
              "COMPOUND_DAMAGED",
              "ARRIVED_DAMAGED",
              "UNDER_REPAIR",
              "REPAIRED"
            ],
            "example": "RELEASED"
          },
          "brand": {
            "type": "string",
            "description": "Related vehicle brand",
            "example": "OPEL"
          },
          "model": {
            "type": "string",
            "description": "Car model",
            "example": "ASTRA L"
          },
          "typeCode": {
            "type": "string",
            "description": "Factory type code of the vehicle",
            "example": "AST-L-2024"
          },
          "modelCode": {
            "type": "string",
            "description": "Factory model code of the vehicle",
            "example": "AST-L-2024-MT6"
          },
          "weight": {
            "type": "number",
            "format": "decimal",
            "description": "Weight of the vehicle in kg",
            "example": 1450.5
          },
          "length": {
            "type": "number",
            "format": "decimal",
            "description": "Length of the vehicle in cm",
            "example": 437.0
          },
          "width": {
            "type": "number",
            "format": "decimal",
            "description": "Width of the vehicle in cm",
            "example": 185.2
          },
          "height": {
            "type": "number",
            "format": "decimal",
            "description": "Height of the vehicle in cm",
            "example": 146.5
          },
          "dealer": {
            "type": "string",
            "description": "Dealer name",
            "example": "Budapest Motors"
          },
          "dealerCode": {
            "type": "string",
            "description": "Dealer code",
            "example": "BP-001"
          },
          "pickupAddress": {
            "type": "string",
            "description": "Pickup location of the car to be delivered",
            "example": "Factory Munich, Germany"
          },
          "deliveryAddress": {
            "type": "string",
            "description": "Delivery address",
            "example": "Budapest Motors, V\u00e1ci \u00fat 100, Budapest, Hungary"
          },
          "netValue": {
            "type": "number",
            "format": "decimal",
            "description": "Net value of the car",
            "example": 28500.0
          },
          "remark": {
            "type": "string",
            "description": "Internal comment or remark",
