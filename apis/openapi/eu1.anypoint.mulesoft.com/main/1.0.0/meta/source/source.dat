            "description": "Order number in the source system.",
            "example": "ORD-2026-10024"
          },
          "orderedBy": {
            "type": "string",
            "description": "Dealer code (importer or dealer).",
            "example": "DLR-BUD-01"
          },
          "orderCategory": {
            "type": "string",
            "enum": [
              "IMPORTER",
              "DEALER"
            ],
            "example": "DEALER"
          },
          "vin": {
            "type": "string",
            "description": "Vehicle Identification Number.",
            "example": "WOL000051T2123456"
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-24T11:00:00Z"
          },
          "carOrderStatus": {
            "type": "string",
            "description": "OEM delivery/order status.",
            "example": "RELEASED_FOR_TRANSPORT"
          },
          "brand": {
            "type": "string",
            "description": "Manufacturer brand.",
            "example": "OPEL"
          },
          "model": {
            "type": "string",
            "description": "Car model.",
            "example": "ASTRA L"
          },
          "typeCode": {
            "type": "string",
            "description": "Factory type code.",
            "example": "AST-L-2024"
          },
          "weight": {
            "type": "number",
            "format": "decimal",
            "description": "Weight in kg.",
            "example": 1450.5
          },
          "length": {
            "type": "number",
            "format": "decimal",
            "description": "Length in cm.",
            "example": 437.0
          },
          "width": {
            "type": "number",
            "format": "decimal",
            "description": "Width in cm.",
            "example": 185.2
          },
          "height": {
            "type": "number",
            "format": "decimal",
            "description": "Height in cm.",
            "example": 146.5
          },
          "dealer": {
            "type": "string",
            "description": "Recipient dealer name.",
            "example": "Budapest Motors"
          },
          "dealerCode": {
            "type": "string",
            "description": "Recipient dealer code.",
            "example": "BP-001"
          },
          "pickupAddress": {
            "type": "string",
            "example": "Factory Port, Koper, Slovenia"
          },
          "deliveryAddress": {
            "type": "string",
            "example": "Budapest Motors, V\u00e1ci \u00fat 100, Budapest, Hungary"
          },
          "netValue": {
            "type": "number",
            "format": "decimal",
            "example": 28500.0
          },
          "remark": {
            "type": "string",
            "example": "Fragile: handle with care during loading"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "toBeDelivered": {
            "type": "boolean",
