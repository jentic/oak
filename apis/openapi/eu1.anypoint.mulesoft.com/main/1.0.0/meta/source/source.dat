              "lsp": {
                "type": "string",
                "example": "InterEuropa Ltd"
              },
              "countryCode": {
                "type": "string",
                "example": "HU"
              },
              "claimId": {
                "type": "string",
                "example": "CLAIM-2026-001"
              },
              "vin": {
                "type": "string",
                "example": "WOL000051T2123456"
              },
              "vehicleStatus": {
                "type": "string",
                "example": "UNDER_REPAIR"
              },
              "damageDate": {
                "type": "string",
                "format": "date",
                "example": "2026-01-20"
              },
              "inspectionDate": {
                "type": "string",
                "format": "date",
                "example": "2026-01-21"
              },
              "brand": {
                "type": "string",
                "example": "OPEL"
              },
              "model": {
                "type": "string",
                "example": "ASTRA L"
              },
              "typeCode": {
                "type": "string",
                "example": "AST-L-2024"
              },
              "configuration": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ConfigurationOption"
                }
              },
              "repairItems": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RepairItem"
                }
              },
              "lspRepairReference": {
                "type": "string",
                "example": "REPAIR-LSP-2026-100"
              },
              "repairStatus": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "IN_PROGRESS",
                  "PARTS_ORDERED",
                  "PARTS_RECEIVED",
                  "COMPLETED"
                ],
                "example": "IN_PROGRESS"
              },
              "actualCompletionDate": {
                "type": "string",
                "format": "date",
                "nullable": true,
                "example": null
              },
              "actualCost": {
                "type": "number",
                "format": "decimal",
                "nullable": true,
                "example": null
              }
            }
          }
        }
      },
      "LspConfirmationRequest": {
        "type": "object",
        "required": [
          "lsp",
          "vin",
          "brand",
          "type",
          "orderId",
          "timestamp",
          "confirmation",
          "reasonCode"
        ],
        "properties": {
          "lsp": {
            "type": "string",
            "description": "LSP name",
            "example": "InterEuropa Ltd"
          },
          "vin": {
            "type": "string",
            "description": "Vehicle identification number (17 characters)",
            "example": "WOL000051T2123456"
          },
          "type": {
            "type": "string",
            "description": "Type of order being confirmed",
            "enum": [
              "TRANSPORT_ORDER",
              "SERVICE_ORDER"
            ],
            "example": "TRANSPORT_ORDER"
          },
          "brand": {
            "type": "string",
            "description": "Related vehicle brand",
            "example": "OPEL"
          },
          "orderId": {
            "type": "string",
            "description": "Identifier of the specific transport or service order",
            "example": "AWD-TO-2026-001"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the confirmation (ISO 8601 format)",
            "example": "2026-01-24T11:05:00Z"
          },
          "confirmation": {
            "type": "string",
            "description": "Confirmation status",
            "enum": [
              "ACCEPT",
              "REJECT"
            ],
            "example": "ACCEPT"
          },
          "reasonCode": {
            "type": "string",
            "description": "Reason code for the confirmation",
            "enum": [
              "OK",
              "NO_CAPACITY",
              "VEHICLE_NOT_TRANSPORTABLE",
              "DATA_ERROR",
              "OTHER"
            ],
            "example": "OK"
          },
          "description": {
            "type": "string",
            "description": "Optional free text description of the confirmation reason",
            "maxLength": 500,
            "example": "Order accepted, pickup scheduled for 2026-01-25"
          }
        }
      },
      "LspConfirmationResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "Unique identifier for the response message",
            "example": "MDW-2026012411050001"
          },
          "source": {
            "type": "string",
            "description": "Origin of the response",
            "example": "LSP"
          },
          "sourceId": {
            "type": "string",
            "description": "Identifier of the LSP system",
            "example": "InterEuropa-API-Client"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Response timestamp (ISO 8601 format)",
            "example": "2026-01-24T11:05:02Z"
          },
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "description": {
            "type": "string",
            "example": "LSP confirmation received and forwarded to TMS"
          },
          "data": {
            "type": "object",
            "properties": {
              "orderId": {
                "type": "string",
                "example": "AWD-TO-2026-001"
              },
              "vin": {
                "type": "string",
                "example": "WOL000051T2123456"
              },
              "confirmation": {
                "type": "string",
                "enum": [
                  "ACCEPT",
                  "REJECT"
                ],
                "example": "ACCEPT"
              },
              "forwardedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "TMS"
                ]
              }
            }
          }
        }
      },
      "TransportStatusRequest": {
        "type": "object",
        "required": [
          "dataSource",
          "sourceType",
          "vin",
          "brand",
          "timestamp",
          "location",
          "status"
        ],
        "properties": {
          "dataSource": {
            "type": "string",
            "description": "Name of the LSP providing the status information",
            "example": "InterEuropa Ltd"
          },
          "sourceType": {
            "type": "string",
            "description": "Always LSP for LSP submissions",
            "enum": [
              "LSP"
            ],
            "example": "LSP"
          },
          "vin": {
            "type": "string",
            "description": "Full vehicle chassis number (VIN - 17 characters)",
            "example": "WOL000051T2123456"
          },
          "brand": {
            "type": "string",
            "description": "Related vehicle brand",
            "example": "OPEL"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the recorded process (ISO 8601 format)",
            "example": "2026-01-25T08:30:00Z"
          },
          "location": {
            "type": "string",
            "description": "Location of the specific vehicle at the given date and time",
            "example": "Transit Hub Vienna"
          },
          "status": {
            "type": "string",
            "description": "Status of the vehicle at the specific datetime and location",
            "enum": [
              "ORDERED",
              "UNDER_MANUFACTURING",
              "RELEASED",
              "IN_TRANSIT",
              "OUT",
              "IN",
              "TAKE_OVER",
              "CALLOFF",
              "TRUCK_PLANNED",
              "ARRIVED",
              "IN_DAMAGED",
              "COMPOUND_DAMAGED",
              "ARRIVED_DAMAGED",
              "UNDER_REPAIR",
              "REPAIRED"
            ],
            "example": "IN_TRANSIT"
          },
          "eta": {
            "type": "string",
            "format": "date-time",
            "description": "Expected arrival date ",
            "example": "2026-01-25T08:30:00Z"
          }
        }
      },
      "TransportStatusResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "example": "MDW-2026012508300001"
          },
          "source": {
            "type": "string",
            "example": "LSP"
          },
          "sourceId": {
            "type": "string",
            "example": "InterEuropa-API-Client"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-25T08:30:02Z"
          },
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "description": {
            "type": "string",
            "example": "Transport status received and distributed"
          },
          "data": {
            "type": "object",
            "properties": {
              "vin": {
                "type": "string",
                "example": "WOL000051T2123456"
              },
              "statusUpdate": {
                "type": "string",
                "example": "IN_TRANSIT"
              },
              "distributedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "TMS",
                  "ERP"
                ]
              }
            }
          }
        }
      },
      "ServiceReportRequest": {
        "type": "object",
        "required": [
          "lsp",
          "vin",
          "brand",
          "serviceId",
          "service",
          "operation"
        ],
        "properties": {
          "lsp": {
            "type": "string",
            "description": "LSP name",
            "example": "InterEuropa Ltd"
          },
          "vin": {
            "type": "string",
            "description": "VIN number of the vehicle",
            "example": "WOL000051T2123456"
          },
          "brand": {
            "type": "string",
            "description": "Related vehicle brand",
            "example": "OPEL"
          },
          "serviceId": {
            "type": "string",
            "description": "Identifier of the TMS settlement item for the specific service",
            "example": "SVC-2026-001"
          },
          "numberOfDaysStored": {
            "type": "number",
            "format": "decimal",
            "description": "Number of days the vehicle has been stored (0 if not applicable)",
            "minimum": 0,
            "example": 5
          },
          "service": {
            "type": "string",
            "description": "Invoicable service type",
            "enum": [
              "STORAGE",
              "WASHING",
              "PDI",
              "TRANSPORT",
              "LOADING",
              "UNLOADING",
              "INSPECTION",
              "REFUELING"
            ],
            "example": "STORAGE"
          },
          "operation": {
            "type": "string",
            "description": "Operation to handle the specific service report record",
            "enum": [
              "C",
              "U",
              "D"
            ],
            "example": "C"
          },
          "documents": {
            "type": "array",
            "description": "Array of documents",
            "items": {
              "$ref": "#/components/schemas/DocumentAttachment"
            }
          }
        }
      },
      "ServiceReportResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "example": "MDW-2026012412000001"
          },
          "source": {
            "type": "string",
            "example": "LSP"
          },
          "sourceId": {
            "type": "string",
            "example": "InterEuropa-API-Client"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-24T12:00:02Z"
          },
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "description": {
            "type": "string",
            "example": "Service report received and forwarded"
          },
          "data": {
            "type": "object",
            "properties": {
              "serviceId": {
                "type": "string",
                "example": "SVC-2026-001"
              },
              "settlementId": {
                "type": "string",
                "example": "SETTL-2026-001"
              },
              "vin": {
                "type": "string",
                "example": "WOL000051T2123456"
              },
              "distributedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "TMS",
                  "ERP"
                ]
              }
            }
          }
        }
      },
      "TransportInvoiceHeader": {
        "type": "object",
        "required": [
          "invoiceType",
          "invoiceNumber",
          "buyerId",
          "invoiceDate",
          "buyerTaxNumber",
          "vatDate",
          "dueDate",
          "paymentTerms",
          "paymentMethod",
          "buyerName",
          "buyerAddress",
          "sellerName",
          "sellerAddress",
          "sellerPhoneNumber",
          "sellerTaxNumber",
          "sellerEUTaxNumber",
          "sellerBankName",
          "currency",
          "totalNetAmount",
          "totalVATAmount",
          "totalAmount"
        ],
        "properties": {
          "invoiceType": {
            "type": "string",
            "enum": [
              "INVOICE",
              "CREDIT_NOTE",
              "STORNO"
            ],
            "example": "INVOICE"
          },
          "invoiceNumber": {
            "type": "string",
            "description": "Unique identifier for the invoice",
            "example": "LSP-INV-2026-001"
          },
          "buyerId": {
            "type": "string",
            "description": "Unique identifier for the buyer",
            "example": "14925"
          },
          "invoiceDate": {
            "type": "string",
            "format": "date",
            "description": "Date the invoice was issued",
            "example": "2026-01-24"
          },
          "buyerTaxNumber": {
            "type": "string",
            "description": "Buyer's tax number",
            "example": "28832568-2-44"
          },
          "vatDate": {
            "type": "string",
            "format": "date",
            "description": "Payment VAT date",
            "example": "2026-01-24"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "Payment due date",
            "example": "2026-02-23"
          },
          "paymentTerms": {
            "type": "string",
            "description": "Terms of payment",
            "example": "30DAYS"
          },
          "paymentMethod": {
            "type": "string",
            "description": "Method of payment",
            "example": "BANK_TRANSFER"
          },
          "buyerName": {
            "type": "string",
            "description": "Name of the customer",
            "example": "AW OPL Distribution Kft."
          },
          "buyerAddress": {
            "type": "string",
            "description": "Address of the customer",
            "example": "Budapest, V\u00e1ci \u00fat 100, 1133 Hungary"
          },
          "sellerName": {
            "type": "string",
            "description": "Name of the seller (LSP)",
            "example": "InterEuropa Ltd"
          },
          "sellerAddress": {
            "type": "string",
            "description": "Address of the seller",
            "example": "Vienna, Hauptstra\u00dfe 50, 1010 Austria"
          },
          "sellerPhoneNumber": {
            "type": "string",
            "description": "Seller's phone number",
            "example": "+43 1 123 4567"
          },
          "sellerTaxNumber": {
            "type": "string",
            "description": "Seller's tax number",
            "example": "ATU12345678"
          },
          "sellerEUTaxNumber": {
            "type": "string",
            "description": "Seller's EU tax number",
            "example": "ATU12345678"
          },
          "sellerCompanyRegNumber": {
            "type": "string",
            "description": "Seller's Company Registration Number",
            "example": "FN 123456a"
          },
          "sellerURL": {
            "type": "string",
            "description": "Seller's website URL",
            "example": "www.InterEuropa.at"
          },
          "sellerEmail": {
            "type": "string",
            "format": "email",
            "description": "Seller's email address",
            "example": "invoices@InterEuropa.at"
          },
          "sellerBankName": {
            "type": "string",
            "description": "Seller's bank name",
            "example": "Erste Bank"
          },
          "sellerIBANHUF": {
            "type": "string",
            "nullable": true,
            "description": "Seller's IBAN account number HUF",
            "example": "HU14120967050011279300100006"
          },
          "sellerIBANEUR": {
            "type": "string",
            "description": "Seller's IBAN account number EUR",
            "example": "AT611904300234573201"
          },
          "sellerSwiftCode": {
            "type": "string",
            "description": "Seller's SWIFT code",
            "example": "GIBAATWWXXX"
          },
          "currency": {
            "type": "string",
            "description": "ISO currency code for the invoiced amounts",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          },
          "totalNetAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Sum of NetAmount of all invoice items",
            "example": 1500.0
          },
          "totalVATAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Sum of VATAmount of all invoice items",
            "example": 405.0
          },
          "totalAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Sum of GrossAmount of all invoice items",
            "example": 1905.0
          },
          "documents": {
            "type": "array",
            "description": "Array of documents",
            "items": {
              "$ref": "#/components/schemas/DocumentAttachment"
            }
          }
        }
      },
