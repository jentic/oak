              "ORDERED",
              "UNDER_MANUFACTURING",
              "RELEASED",
              "IN_TRANSIT",
              "OUT",
              "IN",
              "TAKE_OVER",
              "CALLOFF",
              "TRUCK_PLANNED",
              "ARRIVED",
              "IN_DAMAGED",
              "COMPOUND_DAMAGED",
              "ARRIVED_DAMAGED",
              "UNDER_REPAIR",
              "REPAIRED"
            ]
          },
          "brand": {
            "type": "string",
            "description": "Related vehicle brand",
            "example": "OPEL"
          },
          "model": {
            "type": "string"
          },
          "modelCode": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "format": "decimal",
            "description": "Weight in kg"
          },
          "length": {
            "type": "number",
            "format": "decimal",
            "description": "Length in cm"
          },
          "height": {
            "type": "number",
            "format": "decimal",
            "description": "Height in cm"
          },
          "width": {
            "type": "number",
            "format": "decimal",
            "description": "Width in cm"
          },
          "price": {
            "type": "number",
            "format": "decimal",
            "description": "Wholesale price"
          },
          "configuration": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "option": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
