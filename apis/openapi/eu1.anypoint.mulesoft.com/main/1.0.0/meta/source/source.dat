{
  "openapi": "3.0.3",
  "info": {
    "title": "AWG TMS Unified Interfaces",
    "description": "**New Version Available: https://app.swaggerhub.com/apis/e6integrations-6a1/awg-tms-unified-objects/1.10.0**\n\nAutoWallis TMS Unified API specification for Middleware platform to communicate with Logistics Service Provider (LSP), Transport Management System (TMS), Progression System (ERP), Data Warehouse (DWH) and Finance and Accounting (F&A) Systems.\n\n**Authentication:** All middleware endpoints will be secured using Client ID\u2013based authentication. Downstream and upstream systems may implement their own authentication mechanisms. The middleware layer should adapt to support these system-specific authentication methods.\n\n**Important Note:** The API endpoint names referenced in this document are indicative and represent the intended functionality only. Participating systems are free to define and use their own endpoint naming conventions. The middleware must adapt accordingly. The primary focus should be on validating, mapping, adapting the API request/response fields and success/error behaviour.",
    "version": "1.0.0",
    "contact": {
      "name": "New API Version - 1.10.0",
      "url": "https://app.swaggerhub.com/apis/e6integrations-6a1/awg-tms-unified-objects/1.10.0"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/e6integrations-6a1/awg-tms-unified-objects/1.0.0"
  },
  "servers": [
    {
      "url": "https://eu1.anypoint.mulesoft.com/awg-tms-unified-objects/v1",
      "description": ""
    }
  ],
  "security": [
    {
      "clientCredentials": []
    }
  ],
  "tags": [
    {
      "name": "Middleware to LSP",
      "description": "LSP should expose these endpoints for Middleware."
    },
    {
      "name": "LSP to Middleware",
      "description": "Middleware should expose these endpoints for LSPs, where they should send information."
    },
    {
      "name": "TMS to Middleware",
      "description": "Middleware should expose these endpoints for TMS to send information towards (or get information from) different LSP."
    },
    {
      "name": "Middleware to TMS",
      "description": "TMS should expose these endpoints for Middleware to deliver information from other systems."
    },
    {
      "name": "Middleware to ERP",
      "description": "ERP should expose these endpoints for Middleware to deliver information from TMS or LSP."
    },
    {
      "name": "IMS (Progression) to Middleware",
      "description": "Middleware exposes these endpoints for the IMS (Progression System) to send vehicle and order data."
    },
    {
      "name": "Middleware to DWH",
      "description": "Middleware to push each required events to DWH for reporting."
    }
  ],
  "paths": {
    "/lsp/transport-orders": {
      "post": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Create Transport Order (IF-2)",
        "description": "Middleware sends new transport order to LSP.\n\n**Flow**: TMS \u2192 Middleware \u2192 LSP\n\n**LSP Actions**:\n- Receive and validate order\n- Respond with acknowledgment\n- Send confirmation via IF-12 (separate API call to middleware)",
        "operationId": "createTransportOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransportOrderRequest"
              },
              "example": {
                "lsp": "InterEuropa Ltd",
                "orderNumber": "AWD-TO-2026-001",
                "vin": "WOL000051T2123456",
                "timestamp": "2026-01-24T11:00:00Z",
                "vehicleStatus": "RELEASED",
                "brand": "OPEL",
                "model": "ASTRA L",
                "typeCode": "AST-L-2024",
                "modelCode": "AST-L-2024-MT6",
                "weight": 1450.5,
                "length": 437.0,
                "width": 185.2,
                "height": 146.5,
                "dealer": "Budapest Motors",
                "dealerCode": "BP-001",
                "pickupAddress": "Factory Munich, Germany",
                "deliveryAddress": "Budapest Motors, V\u00e1ci \u00fat 100, Budapest, Hungary",
                "netValue": 28500.0,
                "remark": "Urgent delivery",
                "operation": "C"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transport order received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportOrderResponse"
                },
                "example": {
                  "messageId": "LSP-2026012411000001",
                  "source": "Middleware",
                  "sourceId": "MDW-APP-246",
                  "timestamp": "2026-01-24T11:00:05Z",
                  "status": "success",
                  "description": "Transport order received successfully",
                  "data": {
                    "orderNumber": "AWD-TO-2026-001",
                    "lspReferenceNumber": "LSP-REF-2026-5001",
                    "vin": "WOL000051T2123456",
                    "estimatedPickupDate": "2026-01-25",
                    "note": "Order received. Formal confirmation will be sent via LSP confirmation endpoint"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/transport-orders/{orderNumber}": {
      "get": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Get Transport Order Details",
        "description": "Retrieve details of a specific transport order from a specific LSP",
        "operationId": "getTransportOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderNumber"
          },
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "responses": {
          "200": {
            "description": "Transport order details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportOrderDetailsResponse"
                },
                "example": {
                  "messageId": "LSP-2026012411050001",
                  "source": "LSP",
                  "sourceId": "InterEuropa-System",
                  "timestamp": "2026-01-24T11:05:10Z",
                  "status": "success",
                  "description": "Transport order details retrieved successfully",
                  "data": {
                    "lsp": "InterEuropa Ltd",
                    "orderNumber": "AWD-TO-2026-001",
                    "vin": "WOL000051T2123456",
                    "timestamp": "2026-01-24T11:00:00Z",
                    "vehicleStatus": "RELEASED",
                    "brand": "OPEL",
                    "model": "ASTRA L",
                    "typeCode": "AST-L-2024",
                    "modelCode": "AST-L-2024-MT6",
                    "weight": 1450.5,
                    "length": 437.0,
                    "width": 185.2,
                    "height": 146.5,
                    "dealer": "Budapest Motors",
                    "dealerCode": "BP-001",
                    "pickupAddress": "Factory Munich, Germany",
                    "deliveryAddress": "Budapest Motors, V\u00e1ci \u00fat 100, Budapest, Hungary",
                    "netValue": 28500.0,
                    "remark": "Urgent delivery",
                    "operation": "C",
                    "lspReferenceNumber": "LSP-REF-2026-5001",
                    "orderStatus": "CONFIRMED",
                    "currentLocation": "Transit Hub Vienna",
                    "estimatedDeliveryDate": "2026-01-26"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Update Transport Order",
        "description": "Update details of existing transport order in a specific LSP through Middleware.\n\n**Operation**: U (Update)",
        "operationId": "updateTransportOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderNumber"
          },
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransportOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transport order updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportOrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Delete/Cancel Transport Order",
        "description": "Cancel an existing transport order in a specific LSP through Middleware.\n\n**Operation**: D (Delete)",
        "operationId": "deleteTransportOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderNumber"
          },
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "responses": {
          "204": {
            "description": "Transport order cancelled successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/ordered-vehicles": {
      "post": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Send Ordered Vehicles (IF-10)",
        "description": "Middleware sends ordered vehicle information to LSP.\n\n**Flow**: ERP \u2192 TMS \u2192 Middleware \u2192 LSP",
        "operationId": "sendOrderedVehicles",
        "parameters": [
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderedVehicleRequest"
              },
              "example": {
                "job": "2123456",
                "vin": "WOL000051T2123456",
                "ims": "ERP-GERMANY",
                "orderId": "ORD-2026-9988",
                "timestamp": "202601251430",
                "location": "Factory Munich",
                "status": "ORDERED",
                "brand": "OPEL",
                "model": "ASTRA L",
                "modelCode": "AST-L-2024-MT6",
                "weight": 1450.5,
                "length": 437.0,
                "height": 146.5,
                "width": 185.2,
                "price": 28500.0,
                "configuration": [
                  {
                    "option": "6 speed manual gearbox"
                  },
                  {
                    "option": "LED headlights"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Ordered vehicle information received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderedVehicleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/service-orders": {
      "post": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Create Service Order (IF-5)",
        "description": "Middleware sends service order to LSP.\n\n**Flow**: TMS \u2192 Middleware \u2192 LSP",
        "operationId": "createServiceOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceOrderRequest"
              },
              "example": {
                "serviceOrderId": "SO-2026-001",
                "lsp": "InterEuropa Ltd",
                "vin": "WOL000051T2123456",
                "brand": "OPEL",
                "serviceId": "SVC-2026-001",
                "service": "WASHING",
                "dueDate": "2026-01-26"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Service order received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceOrderResponse"
                },
                "example": {
                  "messageId": "LSP-2026012413000001",
                  "source": "Middleware",
                  "sourceId": "MDW-APP-246",
                  "timestamp": "2026-01-24T13:00:05Z",
                  "status": "success",
                  "description": "Service order received successfully",
                  "data": {
                    "serviceOrderId": "SO-2026-001",
                    "lspServiceReference": "LSP-SVC-2026-100",
                    "vin": "WOL000051T2123456",
                    "estimatedCompletionDate": "2026-01-26"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/service-confirmations": {
      "post": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Send Service Confirmation (IF-6)",
        "description": "TMS sends service confirmation to LSP via Middleware.\n\n**Flow**: TMS \u2192 Middleware \u2192 LSP",
        "operationId": "sendServiceConfirmation",
        "parameters": [
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceConfirmationRequest"
              },
              "example": {
                "lsp": "InterEuropa Ltd",
                "vin": "WOL000051T2123456",
                "brand": "OPEL",
                "settlementId": "SETTL-2026-001",
                "numberOfDaysStored": 5,
                "activity": "STORAGE",
                "amount": 150.0,
                "currency": "EUR"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Service confirmation received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceConfirmationResponse"
                },
                "example": {
                  "messageId": "LSP-2026012414000001",
                  "source": "Middleware",
                  "sourceId": "MDW-APP-246",
                  "timestamp": "2026-01-24T14:00:02Z",
                  "status": "success",
                  "description": "Service confirmation received and acknowledged",
                  "data": {
                    "settlementId": "SETTL-2026-001",
                    "vin": "WOL000051T2123456",
                    "confirmedAmount": 150.0
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/repair-orders": {
      "post": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Create Repair Order (IF-9)",
        "description": "TMS sends repair order for damaged vehicles via Middleware.\n\n**Flow**: TMS \u2192 Middleware \u2192 LSP\n\n**Condition**: Only sent when AWD is responsible for the damage",
        "operationId": "createRepairOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepairOrderRequest"
              },
              "example": {
                "lsp": "InterEuropa Ltd",
                "countryCode": "HU",
                "claimId": "CLAIM-2026-001",
                "vin": "WOL000051T2123456",
                "vehicleStatus": "DAMAGED",
                "damageDate": "2026-01-20",
                "inspectionDate": "2026-01-21",
                "brand": "OPEL",
                "model": "ASTRA L",
                "typeCode": "AST-L-2024",
                "configuration": [
                  {
                    "option": "6 speed manual gearbox"
                  },
                  {
                    "option": "LED headlights"
                  }
                ],
                "repairItems": [
                  {
                    "id": 1,
                    "task": "Replace front bumper"
                  },
                  {
                    "id": 2,
                    "task": "Repaint left front fender"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Repair order received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepairOrderResponse"
                },
                "example": {
                  "messageId": "LSP-2026012415000001",
                  "source": "Middleware",
                  "sourceId": "MDW-APP-246",
                  "timestamp": "2026-01-24T15:00:05Z",
                  "status": "success",
                  "description": "Repair order received successfully",
                  "data": {
                    "claimId": "CLAIM-2026-001",
                    "lspRepairReference": "REPAIR-LSP-2026-100",
                    "vin": "WOL000051T2123456",
                    "estimatedCompletionDate": "2026-01-28",
                    "estimatedCost": 850.0
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/repair-orders/{claimId}": {
      "get": {
