            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/transport-status": {
      "get": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Retrieve Transport Status on Demand (Query based on orderNumber/vin)",
        "description": "Middleware retrieves vehicle transport status updates from LSP based on multiple query parameters such as orderNumber, and vinNumber.\n\n**Flow**: Any System \u2192 Middleware \u2192 LSP\n\n**Status Values**: ORDERED, UNDER_MANUFACTURING, RELEASED, IN_TRANSIT, OUT, IN, TAKE_OVER, CALLOFF, TRUCK_PLANNED, ARRIVED, IN_DAMAGED, COMPOUND_DAMAGED, ARRIVED_DAMAGED, UNDER_REPAIR, REPAIRED",
        "operationId": "getTransportStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          },
          {
            "name": "orderNumber",
            "in": "query",
            "required": false,
            "description": "Transport order number",
            "schema": {
              "type": "string",
              "example": "AWD-TO-2026-001"
            }
          },
          {
            "name": "vin",
            "in": "query",
            "description": "Vehicle Identification Number",
            "required": false,
            "schema": {
              "type": "string",
              "example": "WOL000051T2123456"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transport status updates retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportStatusResponse"
                },
                "example": {
                  "messageId": "LSP-2026012610300001",
                  "source": "LSP",
                  "sourceId": "InterEuropa-API-Server",
                  "timestamp": "2026-01-26T10:30:00Z",
                  "status": "success",
                  "description": "Transport status retrieved successfully",
                  "data": [
                    {
                      "dataSource": "InterEuropa Ltd",
                      "sourceType": "LSP",
                      "vin": "WOL000051T2123456",
                      "brand": "OPEL",
                      "timestamp": "2026-01-25T08:30:00Z",
                      "location": "Transit Hub Vienna",
                      "status": "IN_TRANSIT"
                    },
                    {
                      "dataSource": "InterEuropa Ltd",
                      "sourceType": "LSP",
                      "vin": "WOL000051T2123456",
                      "brand": "OPEL",
                      "timestamp": "2026-01-26T14:30:00Z",
                      "location": "Budapest Motors, V\u00e1ci \u00fat 100, Budapest",
                      "status": "ARRIVED"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/lsp/damage-claim-status": {
      "get": {
        "tags": [
          "Middleware to LSP"
        ],
        "summary": "Retrieve Damage Claim Status on Demand (Query based damageClaimId/vin)",
        "description": "Middleware retrieves damage claim handling status updates from LSP based on multiple query parameters such as damageClaimId and vinNumber.\n\n**Flow**: Any System \u2192 Middleware \u2192 LSP\n\n**Status Values**: DAMAGED, INSPECTED, REPAIR_STARTED, PARTS_ORDERED, PARTS_RECEIVED, REPAIRED",
        "operationId": "getDamageClaimStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/MDWToLSPSystemId"
          },
          {
            "name": "damageClaimId",
            "in": "query",
            "description": "Damage Claim ID",
            "required": false,
            "schema": {
              "type": "string",
              "example": "CLAIM-2026-001"
            }
          },
          {
            "name": "vin",
            "in": "query",
            "description": "Vehicle Identification Number",
            "required": false,
            "schema": {
              "type": "string",
              "example": "WOL000051T2123456"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Damage claim status updates retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DamageClaimStatusResponse"
                },
                "example": {
                  "messageId": "LSP-2026012615000001",
                  "source": "LSP",
                  "sourceId": "InterEuropa-API-Server",
                  "timestamp": "2026-01-26T15:00:00Z",
                  "status": "success",
                  "description": "Damage claim status retrieved successfully",
                  "data": [
                    {
                      "lsp": "InterEuropa Ltd",
                      "damageClaimId": "CLAIM-2026-001",
                      "vin": "WOL000051T2123456",
                      "brand": "OPEL",
                      "timestamp": "2026-01-26T14:00:00Z",
                      "damageClaimStatus": "REPAIR_STARTED",
                      "storageDate": "2026-01-21",
                      "plateNumber": "BP-AB-1234",
                      "transportMode": "ROAD",
                      "damagedElement": "Front bumper",
                      "damagePosition": "Front left",
                      "damage": "Deep scratch and dent",
                      "repairMode": "REPLACE",
                      "causedBy": "TRANSPORT",
                      "documents": [
                        {
                          "attachmentType": "FILE_CONTENT",
                          "documentType": "INVOICE",
                          "fileName": "invoice_AWD_2026_001.pdf",
                          "fileContentBase64": "JVBERi0xLjQKJ...(truncated_base64_string)...Ym9keQ==",
                          "fileExtension": "pdf"
                        },
                        {
                          "attachmentType": "FILE_LINK",
                          "documentType": "REPORT",
                          "fileName": "service_report_v1.pdf",
                          "documentURL": "https://storage.autowallis.com/reports/service-report-7721.pdf",
                          "fileExtension": "pdf"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/middleware/lsp-confirmations": {
      "post": {
        "tags": [
          "LSP to Middleware"
        ],
        "summary": "Submit LSP Confirmation (IF-12)",
        "description": "LSP submits confirmation (ACCEPT/REJECT) for transport orders or service orders.\n\n**Flow**: LSP \u2192 Middleware \u2192 TMS",
        "operationId": "submitLspConfirmation",
        "parameters": [
          {
            "$ref": "#/components/parameters/LSPToMDWSourceSystem"
          },
          {
            "$ref": "#/components/parameters/brand"
          },
          {
            "$ref": "#/components/parameters/country"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LspConfirmationRequest"
              },
              "examples": {
                "acceptTransportOrder": {
                  "summary": "Accept Transport Order",
                  "value": {
                    "lsp": "InterEuropa Ltd",
                    "vin": "WOL000051T2123456",
                    "brand": "OPEL",
                    "type": "TRANSPORT_ORDER",
                    "orderId": "AWD-TO-2026-001",
                    "timestamp": "2026-01-24T11:05:00Z",
                    "confirmation": "ACCEPT",
                    "reasonCode": "OK",
                    "description": "Order accepted, pickup scheduled for 2026-01-25"
                  }
                },
                "rejectNoCapacity": {
                  "summary": "Reject - No Capacity",
                  "value": {
                    "lsp": "InterEuropa Ltd",
                    "vin": "WOL000051T2123456",
                    "brand": "OPEL",
                    "type": "TRANSPORT_ORDER",
                    "orderId": "AWD-TO-2026-001",
                    "timestamp": "2026-01-24T11:05:00Z",
                    "confirmation": "REJECT",
                    "reasonCode": "NO_CAPACITY",
                    "description": "No available capacity for pickup on requested date. Next available: 2026-01-27"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Confirmation received and forwarded to TMS successfully",
