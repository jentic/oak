          "inspectionDate": {
            "type": "string",
            "format": "date",
            "description": "Date of damage inspection",
            "example": "2026-01-21"
          },
          "brand": {
            "type": "string",
            "description": "Manufacturer of the car",
            "example": "OPEL"
          },
          "model": {
            "type": "string",
            "description": "Car model",
            "example": "ASTRA L"
          },
          "typeCode": {
            "type": "string",
            "description": "Factory type code of the vehicle",
            "example": "AST-L-2024"
          }
        }
      },
