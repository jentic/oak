                    "typeCode": "AST-L-2024",
                    "configuration": [
                      {
                        "option": "6 speed manual gearbox"
                      },
                      {
                        "option": "LED headlights"
                      }
                    ],
                    "repairItems": [
                      {
                        "id": 1,
