                  "timestamp": "2026-01-24T11:05:02Z",
                  "status": "success",
                  "description": "LSP confirmation received and forwarded to TMS",
                  "data": {
                    "orderId": "AWD-TO-2026-001",
                    "vin": "WOL000051T2123456",
                    "confirmation": "ACCEPT",
                    "forwardedTo": [
                      "TMS"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
