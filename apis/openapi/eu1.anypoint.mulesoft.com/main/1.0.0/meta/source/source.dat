      "TransportInvoiceItem": {
        "type": "object",
        "required": [
          "itemNumber",
          "settlementId",
          "description",
          "quantity",
          "unit",
          "unitPrice",
          "netAmount",
          "vatPercent",
          "vatAmount",
          "grossAmount"
        ],
        "properties": {
          "itemNumber": {
            "type": "string",
            "description": "Line item code",
            "example": "1"
          },
          "settlementId": {
            "type": "string",
            "description": "Identifier of the TMS settlement item for the specific service",
            "example": "SETTL-2026-001"
          },
          "description": {
            "type": "string",
            "description": "Description of goods or services",
            "example": "Vehicle transport Munich to Budapest"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity of items",
            "minimum": 1,
            "example": 1
          },
          "unit": {
            "type": "string",
            "description": "Unit of measure",
            "example": "piece"
          },
          "unitPrice": {
            "type": "number",
            "format": "decimal",
            "description": "Price per unit in invoice currency",
            "example": 1200.0
          },
          "netAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Calculated field (UnitPrice * Quantity)",
            "example": 1200.0
          },
          "vatPercent": {
            "type": "number",
            "format": "decimal",
            "description": "VAT rate percentage",
            "example": 27
          },
          "vatAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Calculated field (NetAmount * VATPercent/100)",
            "example": 324.0
          },
          "grossAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Calculated field (NetAmount + VATAmount)",
            "example": 1524.0
          }
        }
      },
      "RepairInvoiceItem": {
        "type": "object",
        "required": [
          "itemNumber",
          "description",
          "quantity",
          "unit",
          "unitPrice",
          "netAmount",
          "vatPercent",
          "vatAmount",
          "grossAmount"
        ],
        "properties": {
          "itemNumber": {
            "type": "string",
            "description": "Line item code",
            "example": "1"
          },
          "description": {
            "type": "string",
            "description": "Description of goods or services",
            "example": "Vehicle transport Munich to Budapest"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity of items",
            "minimum": 1,
            "example": 1
          },
          "unit": {
            "type": "string",
            "description": "Unit of measure",
            "example": "piece"
          },
          "unitPrice": {
            "type": "number",
            "format": "decimal",
            "description": "Price per unit in invoice currency",
            "example": 1200.0
          },
          "netAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Calculated field (UnitPrice * Quantity)",
            "example": 1200.0
          },
          "vatPercent": {
            "type": "number",
            "format": "decimal",
            "description": "VAT rate percentage",
            "example": 27
          },
          "vatAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Calculated field (NetAmount * VATPercent/100)",
            "example": 324.0
          },
          "grossAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Calculated field (NetAmount + VATAmount)",
            "example": 1524.0
          }
        }
      },
      "TransportInvoiceRequest": {
        "type": "object",
        "required": [
          "header",
          "items"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/TransportInvoiceHeader"
          },
          "items": {
            "type": "array",
            "description": "Invoice line items",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/TransportInvoiceItem"
            }
          }
        }
      },
      "TransportInvoiceResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "example": "MDW-2026012416000001"
          },
          "source": {
            "type": "string",
            "example": "LSP"
          },
          "sourceId": {
            "type": "string",
            "example": "InterEuropa-API-Client"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-24T16:00:02Z"
          },
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "description": {
            "type": "string",
            "example": "Transport invoice received and distributed"
          },
          "data": {
            "type": "object",
            "properties": {
              "invoiceNumber": {
                "type": "string",
                "example": "LSP-INV-2026-001"
              },
              "invoiceId": {
                "type": "string",
                "example": "INV-MW-2026-5001"
              },
              "distributedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "TMS",
                  "F&A"
                ]
              }
            }
          }
        }
      },
      "RepairInvoiceRequest": {
        "type": "object",
        "required": [
          "header",
          "items"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/RepairInvoiceHeader"
          },
          "items": {
            "type": "array",
            "description": "Invoice line items",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/RepairInvoiceItem"
            }
          }
        }
      },
      "RepairInvoiceResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "example": "MDW-2026012810000001"
          },
          "source": {
            "type": "string",
            "example": "LSP"
          },
          "sourceId": {
            "type": "string",
            "example": "InterEuropa-API-Client"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-28T10:00:02Z"
          },
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "description": {
            "type": "string",
            "example": "Repair invoice received and distributed"
          },
          "data": {
            "type": "object",
            "properties": {
              "invoiceNumber": {
                "type": "string",
                "example": "LSP-REP-INV-2026-001"
              },
              "invoiceId": {
                "type": "string",
                "example": "REP-INV-MW-2026-1001"
              },
              "relatedClaimId": {
                "type": "string",
                "example": "CLAIM-2026-001"
              },
              "distributedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "TMS",
                  "ERP"
                ]
              }
            }
          }
        }
      },
      "DocumentAttachment": {
        "required": [
          "attachmentType",
          "documentType",
          "fileName",
          "fileExtension"
        ],
        "type": "object",
        "properties": {
          "attachmentType": {
            "type": "string",
            "description": "Type of attachment - File Content (base64) or File Link (URL)",
            "example": "FILE_CONTENT",
            "enum": [
              "FILE_CONTENT",
              "FILE_LINK"
            ]
          },
          "documentType": {
            "type": "string",
            "description": "Document group code where document belongs to",
            "example": "ORDER/INVOICE/REPORT"
          },
          "fileName": {
            "type": "string",
            "description": "Name of the file",
            "example": "invoice.pdf"
          },
          "fileContentBase64": {
            "type": "string",
            "description": "File content converted to base64 format. Required if attachmentType is 'File Content'",
            "example": "dGVzdDE="
          },
          "documentURL": {
            "type": "string",
            "description": "Required if attachmentType is 'File Link'. Public URL where the document can be downloaded from",
            "example": "https://lsp-storage.example.com/damages/claim-2026-001-img1.jpg"
          },
          "fileExtension": {
            "type": "string",
            "description": "File extension",
            "example": "pdf"
          }
        }
      },
      "DamageClaimStatusRequest": {
        "type": "object",
        "required": [
          "lsp",
          "damageClaimId",
          "vin",
          "timestamp",
          "damageClaimStatus",
          "storageDate",
          "transportMode",
          "damagedElement",
          "damagePosition",
          "damage",
          "causedBy"
        ],
        "properties": {
          "lsp": {
            "type": "string",
            "description": "LSP handling the damage claim case",
            "example": "InterEuropa Ltd"
          },
          "damageClaimId": {
            "type": "string",
            "description": "Unique identifier of the damage claim case",
            "example": "CLAIM-2026-001"
          },
          "vin": {
            "type": "string",
            "description": "Vehicle Identification Number of the damaged car",
            "example": "WOL000051T2123456"
          },
          "brand": {
            "type": "string",
            "description": "Related vehicle brand",
            "example": "OPEL"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Time of sending the message",
            "example": "2026-01-26T14:00:00Z"
          },
          "damageClaimStatus": {
            "type": "string",
            "description": "Damage claim handling status of the vehicle",
            "enum": [
              "DAMAGED",
              "INSPECTED",
              "REPAIR_STARTED",
              "PARTS_ORDERED",
              "PARTS_RECEIVED",
              "REPAIRED"
            ],
            "example": "REPAIR_STARTED"
          },
          "storageDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the vehicle was stored in the compound",
            "example": "2026-01-21"
          },
          "plateNumber": {
            "type": "string",
            "description": "Plate number of the truck transporting the vehicle",
            "example": "BP-AB-1234"
          },
          "transportMode": {
            "type": "string",
            "description": "Mode of transport",
            "enum": [
              "RAIL",
              "ROAD",
              "SHIP"
            ],
            "example": "ROAD"
          },
          "damagedElement": {
            "type": "string",
            "description": "Specification of the damaged element",
            "example": "Front bumper"
          },
          "damagePosition": {
            "type": "string",
            "description": "Location of the damage on the car",
            "example": "Front left"
          },
          "damage": {
            "type": "string",
            "description": "Short description of the damage",
            "example": "Deep scratch and dent"
          },
          "repairMode": {
            "type": "string",
            "description": "Required method to repair",
            "example": "REPLACE"
          },
          "causedBy": {
            "type": "string",
            "description": "Who caused the damage",
            "enum": [
              "OEM",
              "TRANSPORT",
              "IMPORTER",
              "DEALER",
              "N/A"
            ],
            "example": "TRANSPORT"
          },
          "documents": {
            "type": "array",
            "description": "Array of damage documentation",
            "items": {
              "$ref": "#/components/schemas/DocumentAttachment"
            }
          }
        }
      },
      "DamageClaimStatusResponse": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "example": "MDW-2026012614000001"
          },
          "source": {
            "type": "string",
            "example": "LSP"
          },
          "sourceId": {
            "type": "string",
            "example": "InterEuropa-API-Client"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-26T14:00:02Z"
          },
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "description": {
            "type": "string",
            "example": "Damage claim status received and forwarded to TMS"
          },
          "data": {
            "type": "object",
            "properties": {
              "damageClaimId": {
                "type": "string",
                "example": "CLAIM-2026-001"
              },
              "vin": {
                "type": "string",
                "example": "WOL000051T2123456"
              },
              "damageClaimStatus": {
                "type": "string",
                "example": "REPAIR_STARTED"
              },
              "distributedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "TMS"
                ]
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "messageId",
          "source",
          "sourceId",
          "timestamp",
          "status",
          "description",
          "errors"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "description": "Unique identifier for the error message instance",
            "example": "LSP-2026012410543001"
          },
          "source": {
            "type": "string",
            "description": "Origin of the request",
            "example": "Middleware"
          },
          "sourceId": {
            "type": "string",
            "description": "Unique identifier associated with the request origin",
            "example": "MDW-APP-246"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "The time the error occurred, in ISO 8601 format",
            "example": "2026-01-24T10:54:14.084Z"
          },
          "status": {
            "type": "string",
            "description": "Status indicator for the response",
            "enum": [
              "error"
            ],
            "example": "error"
          },
          "description": {
            "type": "string",
            "description": "General description of the error",
            "example": "Transport order validation failed"
          },
          "errors": {
            "type": "array",
            "description": "List of detailed error items",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "code",
                "type",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "integer",
                  "description": "HTTP status code associated with the error",
                  "example": 400
                },
                "type": {
                  "type": "string",
                  "description": "Categorical identifier for the error",
                  "example": "VALIdATION:INVALId_VIN"
                },
                "reason": {
                  "type": "string",
                  "description": "Technical reason for the failure",
                  "example": "VIN must be exactly 17 alphanumeric characters"
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable explanation of the error",
                  "example": "The provided VIN 'WOL00005' is invalid. Expected 17 characters, received 8"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request - Invalid request format or validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "messageId": "LSP-2026012410543001",
              "source": "Middleware",
              "sourceId": "MDW-APP-246",
              "timestamp": "2026-01-24T10:54:14.084Z",
              "status": "error",
              "description": "Transport order validation failed",
              "errors": [
                {
                  "code": 400,
                  "type": "VALIdATION:INVALId_VIN",
                  "reason": "VIN must be exactly 17 alphanumeric characters",
                  "message": "The provided VIN 'WOL00005' is invalid. Expected 17 characters, received 8"
                }
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - Authentication failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "messageId": "LSP-2026012411023002",
              "source": "Middleware",
              "sourceId": "MDW-APP-246",
              "timestamp": "2026-01-24T11:02:30.125Z",
              "status": "error",
              "description": "Authentication failed",
              "errors": [
                {
                  "code": 401,
                  "type": "AUTH:INVALId_CREDENTIALS",
                  "reason": "Client Id or Client Secret is invalid",
                  "message": "The provided authentication credentials are invalid. Please check your Client Id and Client Secret"
                }
              ]
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found - Requested resource doesn't exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "messageId": "LSP-2026012411154003",
              "source": "Middleware",
              "sourceId": "MDW-APP-246",
              "timestamp": "2026-01-24T11:15:40.456Z",
              "status": "error",
              "description": "Requested resource not found",
              "errors": [
                {
                  "code": 404,
                  "type": "RESOURCE:NOT_FOUND",
                  "reason": "Transport order does not exist in the system",
                  "message": "Transport order 'AWD-TO-2026-999' was not found"
                }
              ]
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Unprocessable Entity - Business logic error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "messageId": "LSP-2026012412005005",
              "source": "LSP",
              "sourceId": "InterEuropa-System",
              "timestamp": "2026-01-24T12:00:50.234Z",
              "status": "error",
              "description": "Business rule violation",
              "errors": [
                {
                  "code": 422,
                  "type": "BUSINESS:LOCATION_RESTRICTED",
                  "reason": "Service is not available for the requested pickup location",
                  "message": "Cannot accept transport order 'AWD-TO-2026-001'. The pickup location is outside the supported service area."
                }
              ]
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict - Resource already exists or state conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "messageId": "MDW-2026012414005009",
              "source": "LSP",
              "sourceId": "InterEuropa-API-Client",
              "timestamp": "2026-01-24T14:00:12.567Z",
              "status": "error",
              "description": "Duplicate resource conflict",
              "errors": [
                {
                  "code": 409,
                  "type": "RESOURCE:DUPLICATE",
                  "reason": "Invoice with the same invoice number already exists",
                  "message": "Cannot create invoice. Invoice number 'LSP-INV-2026-001' already exists in the system"
                }
              ]
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error - System error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "messageId": "LSP-2026012413005007",
              "source": "LSP",
              "sourceId": "InterEuropa-System",
              "timestamp": "2026-01-24T13:00:30.912Z",
              "status": "error",
              "description": "Internal system error occurred",
              "errors": [
                {
                  "code": 500,
                  "type": "SYSTEM:INTERNAL_ERROR",
                  "reason": "Database connection timeout",
                  "message": "An unexpected error occurred while processing your request. Please try again later. If the problem persists, contact support with message Id: LSP-2026012413005007"
                }
              ]
            }
          }
        }
      }
    }
  }
}