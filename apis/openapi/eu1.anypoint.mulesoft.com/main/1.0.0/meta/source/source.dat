          },
          "orderId": {
            "type": "string",
            "description": "Order identifier in the Source ERP system."
          },
          "timestamp": {
            "type": "string",
            "description": "Date and time in YYYYMMDDHH24MI format.",
            "example": "202601251430"
          },
          "location": {
            "type": "string",
            "description": "Location of the specific vehicle in the given date and time."
          },
