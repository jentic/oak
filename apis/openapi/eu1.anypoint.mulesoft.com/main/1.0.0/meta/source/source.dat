            "example": true
          },
          "configuration": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "option": {
                  "type": "string",
                  "example": "6 speed manual gearbox"
                }
              }
            },
            "description": "Arbitrary number of configuration items."
          }
        }
      },
      "ServiceOrderRequest": {
        "type": "object",
        "required": [
          "serviceOrderId",
