                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "status": "success",
                      "error": null,
                      "offset": null,
                      "total_records": null,
                      "data": {
                        "number": "******",
                        "sys_id": "******",
                        "link": "******",
                        "watchlist": "******"
                      }
