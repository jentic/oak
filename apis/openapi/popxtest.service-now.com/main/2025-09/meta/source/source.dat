{
  "openapi": "3.0.3",
  "info": {
    "title": "POPX Customer Ticketing API",
    "version": "2025-09",
    "description": "Customer Ticketing API for creating and managing Cases in POPX (ServiceNow-backed).\nAll responses are JSON and follow a common envelope format.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MIKEHALL_1/popx-customer-ticketing-api/2025-09"
  },
  "servers": [
    {
      "url": "https://popxtest.service-now.com",
      "description": "Test"
    },
    {
      "url": "https://popx.service-now.com",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Cases"
    },
    {
      "name": "Comments"
    },
    {
      "name": "Attachments"
    },
    {
      "name": "Actions"
    },
    {
      "name": "Webhooks"
    }
  ],
  "security": [
    {
      "basicAuth": []
    },
    {
      "oauth2": []
    }
  ],
  "paths": {
    "/api/x_popx_api/customer/case/list": {
      "get": {
        "tags": [
          "Cases"
        ],
        "summary": "List Cases",
        "description": "Lists Cases in ServiceNow (POPX).",
        "operationId": "listCases",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limits the number of records returned in the payload.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "How much this is offset from 0.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCasesResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "status": "success",
                      "error": null,
                      "offset": {
                        "limit": "******",
                        "previous_offset": "******",
                        "new_offset": "******"
                      },
                      "total_records": "******",
                      "data": [
                        {
                          "number": "******",
                          "sys_id": "******",
                          "state": "******",
                          "active": "******",
                          "short_description": "******",
                          "description": "******",
                          "category": "******",
                          "subcategory": "******",
                          "u_cause_code": "******",
                          "u_hide_external": "******",
                          "link": "******"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
