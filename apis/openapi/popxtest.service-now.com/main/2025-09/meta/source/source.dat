                "schema": {
                  "$ref": "#/components/schemas/CaseWriteResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "status": "success",
                      "error": null,
                      "offset": null,
                      "total_records": null,
                      "data": {
                        "sys_id": "******",
                        "display_value": "******",
                        "correlation_id": "******",
                        "correlation_display": "******",
                        "link": "******"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
