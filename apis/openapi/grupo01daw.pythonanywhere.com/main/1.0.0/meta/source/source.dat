{
  "openapi": "3.0.4",
  "info": {
    "title": "SmartQuiz - API Custionario",
    "description": "Documentaci\u00f3n de las APIs CRUD para gestionar Cuestionarios en SmartQuiz.\nLas recompensas son medallas/incentivos que se otorgan a los mejores jugadores.\n[https://grupo01daw.pythonanywhere.com/](https://grupo01daw.pythonanywhere.com/)",
    "termsOfService": "https://grupo01daw.pythonanywhere.com/",
    "contact": {
      "email": "grupo01@usat.edu.pe"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/usat-426/API_CUESTIONARIOS/1.0.0"
  },
  "externalDocs": {
    "description": "Descubre m\u00e1s de SmartQuiz en USAT",
    "url": "https://www.usat.edu.pe/"
  },
  "servers": [
    {
      "url": "https://grupo01daw.pythonanywhere.com/"
    }
  ],
  "tags": [
    {
      "name": "cuestionario",
      "description": "Todo sobre cuestionarios",
      "externalDocs": {
        "description": "Documentaci\u00f3n de cuestionario",
        "url": "https://smartquiz.com/docs/cuestionario"
      }
    }
  ],
  "paths": {
    "/api/cuestionario": {
      "post": {
        "tags": [
          "cuestionario"
        ],
        "summary": "Agregar un nuevo cuestionario",
        "description": "Agregar un nuevo cuestionario completo, incluyendo preguntas y recompensas.",
        "operationId": "addCuestionario",
        "parameters": [
          {
            "name": "cookie",
            "in": "header",
            "description": "Token de sesi\u00f3n para autenticaci\u00f3n.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "El objeto de cuestionario completo para crear.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CuestionarioCompleto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuestionario creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/crearCuestionario201"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta. El servidor no pudo interpretar la solicitud. \u00bfQuiz\u00e1s sea un error de sintaxis?.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/crearCuestionario400"
                }
              }
            }
          },
          "500": {
            "description": "Error interno en el servidor. El servidor ha detectado una situaci\u00f3n que no sabe c\u00f3mo gestionar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error500"
                }
              }
            }
          }
        },
        "security": [
          {
            "flask_login": []
          }
        ]
      }
    },
    "/api/cuestionario/{id_cuestionario}": {
      "get": {
        "tags": [
          "cuestionario"
        ],
        "summary": "Encuentre cuestionario por ID.",
        "description": "Retorna un solo cuestionario",
        "operationId": "getCuestionarioById",
        "parameters": [
          {
            "name": "cookie",
            "in": "header",
            "description": "Token de sesi\u00f3n para autenticaci\u00f3n.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id_cuestionario",
            "in": "path",
            "description": "ID de cuestionario a devolver",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operaci\u00f3n exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/obtCuestionario200"
                },
                "example": {
                  "descripcion": "Descripci\u00f3n detallada del cuestionario.",
                  "estado": "Activo",
                  "fecha_creacion": "Sat, 22 Nov 2025 17:05:31 GMT",
                  "id_cuestionario": 136,
                  "id_profesor_creador": 48,
                  "imagen_portada": null,
                  "pin_permanente": null,
                  "preguntas": [
                    {
                      "id_pregunta": 634,
                      "opcion_rpta": "Selecci\u00f3n simple",
                      "puntos": "Puntos dobles",
                      "respuestas": [
                        {
                          "es_correcta": false,
                          "id_respuesta": 1574,
                          "texto_respuesta": "Santiago"
                        },
                        {
                          "es_correcta": true,
                          "id_respuesta": 1575,
                          "texto_respuesta": "Lima"
                        },
                        {
                          "es_correcta": false,
                          "id_respuesta": 1576,
                          "texto_respuesta": "Buenos Aires"
                        },
                        {
                          "es_correcta": false,
                          "id_respuesta": 1577,
                          "texto_respuesta": "Bogot\u00e1"
                        }
                      ],
                      "texto_pregunta": "\u00bfCu\u00e1l es la capital de Per\u00fa?",
                      "tiempo_limite_segundos": 30,
                      "tipo_pregunta": "opcion_multiple",
                      "url_media": null
                    },
                    {
                      "id_pregunta": 635,
                      "opcion_rpta": "Selecci\u00f3n simple",
                      "puntos": "Est\u00e1ndar",
                      "respuestas": [
                        {
                          "es_correcta": true,
                          "id_respuesta": 1578,
                          "texto_respuesta": "Verdadero"
                        },
                        {
                          "es_correcta": false,
                          "id_respuesta": 1579,
                          "texto_respuesta": "Falso"
                        }
                      ],
                      "texto_pregunta": "El sol es una estrella.",
                      "tiempo_limite_segundos": 20,
                      "tipo_pregunta": "verdadero_falso",
                      "url_media": null
                    }
                  ],
                  "puntos": "Est\u00e1ndar",
                  "recompensas": [
                    {
                      "descripcion": "+ 3 puntos en el examen"
                    },
                    {
                      "descripcion": "+ 2 puntos en el examen"
                    },
                    {
                      "descripcion": "+1 punto en el examen"
                    }
                  ],
                  "titulo": "T\u00edtulo del Cuestionario",
                  "visibilidad": "publico"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied"
          },
          "403": {
            "description": "El acceso al recurso est\u00e1 prohibido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/obtCuestionario403"
                }
              }
            }
          },
          "404": {
            "description": "El servidor devolvi\u00f3 una p\u00e1gina de error HTML debido a un fallo interno (Error de BD/Aplicaci\u00f3n).",
            "content": {
              "text/html": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInternoHTML404"
                }
              }
            }
          }
        },
        "security": [
          {
            "flask_login": []
          }
        ]
      },
      "put": {
        "tags": [
          "cuestionario"
        ],
        "summary": "Update cuestionario resource.",
        "description": "Actualiza cuestionario",
        "operationId": "updateCuestionario",
        "parameters": [
          {
            "name": "cookie",
            "in": "header",
            "description": "Token de sesi\u00f3n para autenticaci\u00f3n.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id_cuestionario",
            "in": "path",
            "description": "ID del cuestionario a actualizar",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Actualizar cuestionario existente",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CuestionarioCompleto"
              },
              "example": {
                "titulo": "T\u00edtulo del Cuestionario ACTUALIZADO",
                "descripcion": "Descripci\u00f3n detallada del cuestionario ACTUALIZADO.",
                "visibilidad": "publico",
                "estado": "Activo",
                "imagen_portada": null,
                "recompensas": [
                  {
                    "puesto": 1,
                    "descripcion": "+ 3 puntos en el examen"
                  },
                  {
                    "puesto": 2,
                    "descripcion": "+ 2 puntos en el examen"
                  },
                  {
                    "puesto": 3,
                    "descripcion": "+1 punto en el examen"
                  }
                ],
                "preguntas": [
                  {
                    "texto_pregunta": "\u00bfCu\u00e1l es la capital de Per\u00fa? ACTUALIZADO",
                    "url_media": null,
                    "tipo_pregunta": "opcion_multiple",
                    "tiempo_limite": 30,
                    "puntos": "Puntos dobles",
                    "opcion_rpta": "Selecci\u00f3n simple",
                    "respuestas": [
                      {
                        "texto_respuesta": "Santiago",
                        "es_correcta": 0
                      },
                      {
                        "texto_respuesta": "Lima",
                        "es_correcta": 1
                      },
                      {
                        "texto_respuesta": "Buenos Aires",
                        "es_correcta": 0
                      },
                      {
                        "texto_respuesta": "Bogot\u00e1",
                        "es_correcta": 0
                      }
                    ]
                  },
                  {
                    "texto_pregunta": "El sol es una estrella. ACTUALIZADO",
                    "url_media": null,
                    "tipo_pregunta": "verdadero_falso",
                    "tiempo_limite": 20,
                    "puntos": "Est\u00e1ndar",
                    "opcion_rpta": "Selecci\u00f3n simple",
                    "respuestas": [
                      {
                        "texto_respuesta": "Verdadero",
                        "es_correcta": 1
                      },
                      {
                        "texto_respuesta": "Falso",
                        "es_correcta": 0
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operaci\u00f3n exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/actCuestionario200"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "text/html": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInternoHTML400"
                }
              }
            }
          },
          "403": {
            "description": "El acceso al recurso est\u00e1 prohibido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/obtCuestionario403"
                }
              }
            }
          },
          "404": {
            "description": "El servidor devolvi\u00f3 una p\u00e1gina de error HTML debido a un fallo interno (Error de BD/Aplicaci\u00f3n).",
            "content": {
              "text/html": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInternoHTML404"
                }
              }
            }
          }
        },
        "security": [
          {
            "flask_login": []
          }
        ]
      },
      "delete": {
        "tags": [
          "cuestionario"
        ],
        "summary": "Eliminar un cuestionario.",
        "description": "Elimina un cuestionario por su ID.",
        "operationId": "deleteCuestionario",
        "parameters": [
          {
            "name": "cookie",
            "in": "header",
            "description": "Token de sesi\u00f3n para autenticaci\u00f3n.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id_cuestionario",
            "in": "path",
            "description": "ID del cuestionario a eliminar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cuestionario eliminado exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/deleteCuestionario200"
                }
              }
            }
          },
          "400": {
            "description": "ID de cuestionario no v\u00e1lido (ej. formato incorrecto).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInternoHTML400"
                }
              }
            }
          },
          "403": {
            "description": "Prohibido. El usuario autenticado no tiene permisos para eliminar este cuestionario.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/obtCuestionario403"
                }
              }
            }
          },
          "404": {
            "description": "Cuestionario no encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInternoHTML404"
                }
              }
            }
          }
        },
        "security": [
          {
            "flask_login": []
          }
        ]
      }
    },
    "/api/mis-quizzes": {
      "get": {
        "tags": [
          "cuestionario"
        ],
        "summary": "Obtener la lista de cuestionarios propios.",
        "description": "Retorna una lista resumida de los cuestionarios creados por el usuario autenticado.",
        "operationId": "getMisQuizzes",
        "parameters": [
          {
            "name": "cookie",
            "in": "header",
            "description": "Token de sesi\u00f3n para autenticaci\u00f3n.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de cuestionarios  recuperada exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CuestionarioResumido"
                  }
                },
                "example": [
                  {
                    "descripcion": "Descripci\u00f3n detallada del cuestionario.",
                    "id_cuestionario": 139,
                    "imagen_portada": null,
                    "numero_preguntas": 2,
                    "pin_permanente": null,
                    "titulo": "T\u00edtulo del Cuestionario (M\u00e1ximo 255 caracteres)"
                  }
                ]
              }
            }
          },
          "404": {
            "description": "El servidor devolvi\u00f3 una p\u00e1gina de error HTML debido a un fallo interno (Error de BD/Aplicaci\u00f3n).",
            "content": {
              "text/html": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInternoHTML404"
                }
              }
            }
          }
        },
        "security": [
          {
            "flask_login": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CuestionarioCompleto": {
        "type": "object",
        "description": "Estructura completa para crear o editar un cuestionario con preguntas y recompensas.",
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 255,
            "description": "T\u00edtulo del cuestionario.",
            "example": "T\u00edtulo del Cuestionario"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripci\u00f3n detallada del cuestionario.",
            "example": "Descripci\u00f3n detallada del cuestionario."
          },
          "visibilidad": {
            "type": "string",
            "enum": [
              "publico",
              "privado"
            ],
            "example": "publico"
          },
          "estado": {
            "type": "string",
            "maxLength": 10,
            "default": "Activo",
            "example": "Activo"
          },
          "imagen_portada": {
            "type": "string",
            "format": "url",
            "nullable": true,
            "example": null
          },
          "recompensas": {
            "type": "array",
            "description": "Lista de premios o reconocimientos asociados.",
            "items": {
              "$ref": "#/components/schemas/Recompensa"
            },
            "example": [
              {
                "puesto": 1,
                "descripcion": "+ 3 puntos en el examen"
              },
              {
                "puesto": 2,
                "descripcion": "+ 2 puntos en el examen"
              },
              {
                "puesto": 3,
                "descripcion": "+1 punto en el examen"
              }
            ]
          },
          "preguntas": {
            "type": "array",
            "description": "Lista de preguntas del cuestionario.",
            "items": {
              "$ref": "#/components/schemas/Pregunta"
            },
            "example": [
              {
                "texto_pregunta": "\u00bfCu\u00e1l es la capital de Per\u00fa?",
                "url_media": null,
                "tipo_pregunta": "opcion_multiple",
                "tiempo_limite": 30,
                "puntos": "Puntos dobles",
                "opcion_rpta": "Selecci\u00f3n simple",
                "respuestas": [
                  {
                    "texto_respuesta": "Santiago",
                    "es_correcta": 0
                  },
                  {
                    "texto_respuesta": "Lima",
                    "es_correcta": 1
                  },
                  {
                    "texto_respuesta": "Buenos Aires",
                    "es_correcta": 0
                  },
                  {
                    "texto_respuesta": "Bogot\u00e1",
                    "es_correcta": 0
                  }
                ]
              },
              {
                "texto_pregunta": "El sol es una estrella.",
                "url_media": null,
                "tipo_pregunta": "verdadero_falso",
                "tiempo_limite": 20,
                "puntos": "Est\u00e1ndar",
                "opcion_rpta": "Selecci\u00f3n simple",
                "respuestas": [
                  {
                    "texto_respuesta": "Verdadero",
                    "es_correcta": 1
                  },
                  {
                    "texto_respuesta": "Falso",
                    "es_correcta": 0
                  }
                ]
              }
            ]
          }
        },
        "required": [
          "titulo",
          "visibilidad",
          "estado",
          "preguntas"
        ]
      },
      "Recompensa": {
        "type": "object",
        "description": "Define un premio espec\u00edfico asociado a un puesto.",
        "properties": {
          "puesto": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "descripcion": {
            "type": "string",
            "example": "Premio para el primer lugar."
          }
        },
        "required": [
          "puesto",
          "descripcion"
        ]
      },
      "Pregunta": {
        "type": "object",
        "properties": {
          "texto_pregunta": {
            "type": "string",
            "example": "\u00bfCu\u00e1l es la capital de Per\u00fa?"
          },
          "url_media": {
            "type": "string",
            "format": "url",
            "nullable": true,
            "example": null
          },
          "tipo_pregunta": {
            "type": "string",
            "enum": [
              "opcion_multiple",
              "verdadero_falso"
            ],
            "example": "opcion_multiple"
          },
          "tiempo_limite": {
            "type": "integer",
            "format": "int32",
            "example": 30
          },
          "puntos": {
            "type": "string",
            "enum": [
              "Est\u00e1ndar",
              "Puntos dobles"
            ],
            "example": "Puntos dobles"
          },
          "opcion_rpta": {
            "type": "string",
            "enum": [
              "Selecci\u00f3n simple",
              "Selecci\u00f3n m\u00faltiple"
            ],
            "example": "Selecci\u00f3n simple"
          },
          "respuestas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Respuesta"
            }
          }
        },
        "required": [
          "texto_pregunta",
          "tipo_pregunta",
          "tiempo_limite",
          "puntos",
          "opcion_rpta",
          "respuestas"
        ]
      },
      "Respuesta": {
        "type": "object",
        "properties": {
          "texto_respuesta": {
            "type": "string",
            "example": "Lima"
          },
          "es_correcta": {
            "type": "integer",
            "format": "int32",
            "enum": [
              0,
              1
            ],
            "example": 1
          }
        },
        "required": [
          "texto_respuesta",
          "es_correcta"
        ]
      },
      "crearCuestionario201": {
        "type": "object",
        "properties": {
          "id_cuestionario": {
            "type": "integer",
            "format": "int32"
          },
          "mensaje": {
            "type": "string",
            "example": "Cuestionario creado exitosamente"
          },
          "pin_permanente": {
            "type": "string",
            "example": null
          }
        },
        "xml": {
          "name": "##default"
        }
      },
      "crearCuestionario400": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Datos incompletos: T\u00edtulo, id de profesor y preguntas son requeridos."
          }
        },
        "required": [
          "message"
        ]
      },
      "Error500": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Error interno del servidor al crear"
          }
        },
        "required": [
          "message"
        ]
      },
      "obtCuestionario200": {
        "type": "object",
        "description": "Estructura completa de un cuestionario recuperado, incluyendo IDs, fecha y estado.",
        "properties": {
          "descripcion": {
            "type": "string",
            "description": "Descripci\u00f3n detallada del cuestionario.",
            "example": "Descripci\u00f3n detallada del cuestionario."
          },
          "estado": {
            "type": "string",
            "example": "Activo"
          },
          "fecha_creacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora de creaci\u00f3n del cuestionario.",
            "example": "Sat, 22 Nov 2025 17:05:31 GMT"
          },
          "id_cuestionario": {
            "type": "integer",
            "format": "int32",
            "description": "ID \u00fanico del cuestionario.",
            "example": 136
          },
          "id_profesor_creador": {
            "type": "integer",
            "format": "int32",
            "description": "ID del profesor que cre\u00f3 el cuestionario.",
            "example": 48
          },
          "imagen_portada": {
            "type": "string",
            "format": "url",
            "nullable": true,
            "example": null
          },
          "pin_permanente": {
            "type": "string",
            "nullable": true,
            "description": "C\u00f3digo PIN para acceso permanente (puede ser nulo).",
            "example": "ZYIFUX"
          },
          "preguntas": {
            "type": "array",
            "description": "Lista de preguntas completas.",
            "items": {
              "$ref": "#/components/schemas/PreguntaObtenida"
            }
          },
          "puntos": {
            "type": "string",
            "description": "Tipo de puntuaci\u00f3n general.",
            "example": "Est\u00e1ndar"
          },
          "recompensas": {
            "type": "array",
            "description": "Lista de recompensas definidas.",
            "items": {
              "$ref": "#/components/schemas/RecompensaObtenida"
            }
          },
          "titulo": {
            "type": "string",
            "example": "T\u00edtulo del Cuestionario"
          },
          "visibilidad": {
            "type": "string",
            "example": "publico"
          }
        },
        "required": [
          "id_cuestionario",
          "titulo",
          "preguntas"
        ]
      },
      "PreguntaObtenida": {
        "type": "object",
        "description": "Estructura de una pregunta recuperada con su ID.",
        "properties": {
          "id_pregunta": {
            "type": "integer",
            "format": "int32"
          },
          "opcion_rpta": {
            "type": "string"
          },
          "puntos": {
            "type": "string"
          },
          "respuestas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RespuestaObtenida"
            }
          },
          "texto_pregunta": {
            "type": "string"
          },
          "tiempo_limite_segundos": {
            "type": "integer",
            "format": "int32"
          },
          "tipo_pregunta": {
            "type": "string"
          },
          "url_media": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id_pregunta",
          "texto_pregunta",
          "respuestas"
        ]
      },
      "RespuestaObtenida": {
        "type": "object",
        "description": "Estructura de una respuesta recuperada con su ID.",
        "properties": {
          "es_correcta": {
            "type": "boolean"
          },
          "id_respuesta": {
            "type": "integer",
            "format": "int32"
          },
          "texto_respuesta": {
            "type": "string"
          }
        },
        "required": [
          "id_respuesta",
          "texto_respuesta",
          "es_correcta"
        ]
      },
      "RecompensaObtenida": {
        "type": "object",
        "description": "Estructura de una recompensa.",
        "properties": {
          "descripcion": {
            "type": "string"
          }
        }
      },
      "obtCuestionario403": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Una descripci\u00f3n general del error (opcional).",
            "example": "No tienes permiso sobre este cuestionario"
          }
        },
        "required": [
          "message"
        ]
      },
      "ErrorInternoHTML404": {
        "type": "object",
        "description": "Respuesta HTML gen\u00e9rica para un error 500 del servidor.",
        "properties": {
          "html_content": {
            "type": "string",
            "description": "Contenido HTML completo del error de sistema.",
            "example": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Error del Sistema</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-red-50\">\n    <div class=\"min-h-screen flex flex-col items-center justify-center text-center p-4\">\n        <h1 class=\"text-6xl font-extrabold text-red-600 mb-4\">404 NOT FOUND</h1>\n        <h2 class=\"text-4xl font-bold text-red-800 mb-2\">Error Interno del Sistema</h2>\n        <p class=\"text-red-700 mb-6 max-w-lg\">\n            Hemos encontrado un problema t\u00e9cnico con nuestra base de datos. Nuestro equipo ya ha sido notificado.\n            Por\n            favor, intenta de nuevo m\u00e1s tarde.\n        </p>\n        <a href=\"/\" class=\"bg-red-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-700 transition\">\n            Volver a la P\u00e1gina de Inicio\n        </a>\n    </div>\n</body>\n</html>\n"
          }
        }
      },
      "ErrorInternoHTML400": {
        "type": "object",
        "description": "Respuesta HTML gen\u00e9rica para un error 500 del servidor.",
        "properties": {
          "html_content": {
            "type": "string",
            "description": "Contenido HTML completo del error de sistema.",
            "example": "<!doctype html>\n<html lang=\"en\">\n<title>400 Bad Request</title>\n<h1>Bad Request</h1>\n<p>The browser (or proxy) sent a request that this server could not understand.</p>      \n"
          }
        }
      },
      "actCuestionario200": {
        "type": "object",
        "properties": {
          "mensaje": {
            "type": "string",
            "description": "Una descripci\u00f3n general del error (opcional).",
            "example": "Cuestionario actualizado"
          },
          "pin_permante": {
            "type": "string",
            "example": null
          }
        },
        "required": [
          "message",
          "pin_permanente"
        ]
      },
      "deleteCuestionario200": {
        "type": "object",
        "properties": {
          "mensaje": {
            "type": "string",
            "description": "Mensaje de estado de la operaci\u00f3n.",
            "example": "Cuestionario eliminado exitosamente"
          }
        },
        "required": [
          "mensaje"
        ]
      },
      "CuestionarioResumido": {
        "type": "object",
        "description": "Versi\u00f3n resumida de un cuestionario para la vista de lista del usuario.",
        "properties": {
          "descripcion": {
            "type": "string",
            "example": "Descripci\u00f3n detallada del cuestionario."
          },
          "id_cuestionario": {
            "type": "integer",
            "format": "int32",
            "description": "ID \u00fanico del cuestionario.",
            "example": 139
          },
          "imagen_portada": {
            "type": "string",
            "format": "url",
            "nullable": true,
            "example": null
          },
          "numero_preguntas": {
            "type": "integer",
            "format": "int32",
            "description": "Cantidad total de preguntas en el cuestionario.",
            "example": 2
          },
          "pin_permanente": {
            "type": "string",
            "nullable": true,
            "description": "C\u00f3digo PIN para acceso permanente (puede ser nulo si no est\u00e1 activo).",
            "example": null
          },
          "titulo": {
            "type": "string",
            "example": "T\u00edtulo del Cuestionario (M\u00e1ximo 255 caracteres)"
          }
        },
        "required": [
          "id_cuestionario",
          "titulo",
          "numero_preguntas"
        ]
      }
    },
    "securitySchemes": {
      "flask_login": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Autenticaci\u00f3n con Flask-Login (Cookie de sesi\u00f3n)"
      }
    }
  }
}