{
  "openapi": "3.0.3",
  "info": {
    "title": "Black Forest Labs FLUX API",
    "description": "Image generation and editing API from Black Forest Labs. Supports FLUX.2, FLUX.1, and Kontext model families for text-to-image generation, image editing, inpainting, and outpainting. All generation endpoints are asynchronous - submit a task and poll for results.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.bfl.ml/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.bfl.ai",
      "description": "BFL API (Global)"
    }
  ],
  "paths": {
    "/v1/credits": {
      "get": {
        "operationId": "getCredits",
        "summary": "Get the user's credits",
        "description": "Returns the user's current credit balance.",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/get_result": {
      "get": {
        "operationId": "getResult",
        "summary": "Get generation task result",
        "description": "Retrieves the result of a previously submitted generation task. Poll this endpoint until status is 'Ready'.",
        "tags": [
          "Utility"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Task ID returned from a generation endpoint",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/flux-2-pro": {
      "post": {
        "operationId": "generateFlux2Pro",
        "summary": "Generate or edit an image with FLUX.2 [PRO]",
        "description": "Submits an image generation or editing task with FLUX.2 [PRO]. Recommended default model for image editing and generation. Supports text-to-image and image-to-image editing workflows.",
        "tags": [
          "Models"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Flux2Inputs"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
