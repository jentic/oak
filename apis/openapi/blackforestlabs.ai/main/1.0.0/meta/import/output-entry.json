  "components": {
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-key",
        "description": "API key from your BFL dashboard"
      }
    },
    "schemas": {
      "AsyncResponse": {
        "type": "object",
        "required": [
          "id",
          "polling_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Task identifier for polling"
          },
          "polling_url": {
            "type": "string",
            "description": "URL to poll for results"
          },
          "cost": {
            "type": "number",
            "description": "Cost in credits for this request"
          },
          "input_mp": {
            "type": "number",
            "description": "Input megapixels (2 decimal places)"
          },
          "output_mp": {
            "type": "number",
            "description": "Output megapixels (2 decimal places)"
          }
        }
      },
      "ResultResponse": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Task identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "Task not found",
              "Pending",
              "Request Moderated",
              "Content Moderated",
              "Ready",
              "Error"
            ],
            "description": "Current task status"
          },
          "result": {
            "type": "object",
            "description": "Result data when status is Ready (contains 'sample' URL)",
            "properties": {
              "sample": {
                "type": "string",
                "description": "Signed URL for the generated image (expires after 10 minutes)"
              }
            }
          },
          "progress": {
            "type": "number",
            "description": "Generation progress (0-1)"
          }
        }
      },
      "CreditsResponse": {
        "type": "object",
        "required": [
          "credits"
        ],
        "properties": {
          "credits": {
            "type": "number",
            "description": "Current credit balance"
          }
        }
      },
      "Flux2Inputs": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text prompt for image generation"
          },
          "disable_pup": {
            "type": "boolean",
            "description": "Disable prompt upsampling",
            "default": false
          },
          "input_image": {
            "type": "string",
            "description": "Base64-encoded input image for editing"
          },
          "input_image_2": {
            "type": "string",
            "description": "Second input image (base64)"
          },
          "input_image_3": {
            "type": "string",
            "description": "Third input image (base64)"
          },
          "input_image_4": {
            "type": "string",
            "description": "Fourth input image (base64)"
          },
          "seed": {
            "type": "integer",
            "description": "Seed for reproducibility"
          },
          "width": {
            "type": "integer",
            "minimum": 64,
            "description": "Output width in pixels",
            "default": 0
          },
          "height": {
            "type": "integer",
            "minimum": 64,
            "description": "Output height in pixels",
            "default": 0
          },
          "safety_tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Moderation strictness (0=most strict, 5=least strict)",
            "default": 2
          },
          "output_format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "jpeg"
          },
          "transparent_bg": {
            "type": "boolean",
            "description": "Remove background, return transparent RGBA PNG",
            "default": false
          },
          "webhook_url": {
            "type": "string",
            "format": "uri",
            "description": "URL for webhook notification on completion"
          },
          "webhook_secret": {
            "type": "string",
            "description": "Secret for webhook signature verification"
          }
        }
      },
      "Flux2FlexInputs": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text prompt for image generation"
          },
          "prompt_upsampling": {
            "type": "boolean",
            "description": "Whether to use prompt upsampling",
            "default": true
          },
          "input_image": {
            "type": "string",
            "description": "Base64-encoded input image"
          },
          "seed": {
            "type": "integer",
            "description": "Seed for reproducibility"
          },
          "width": {
            "type": "integer",
            "minimum": 64,
            "description": "Output width in pixels",
            "default": 0
          },
          "height": {
            "type": "integer",
            "minimum": 64,
            "description": "Output height in pixels",
            "default": 0
          },
          "guidance": {
            "type": "number",
            "minimum": 1.5,
            "maximum": 10.0,
            "description": "Guidance scale. Higher = more prompt adherence, less realism.",
            "default": 5.0
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Number of generation steps. Higher = more detailed.",
            "default": 50
          },
          "safety_tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 2
          },
          "output_format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "jpeg"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_secret": {
            "type": "string"
          }
        }
      },
      "Flux2KleinInputs": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text prompt for image generation"
          },
          "input_image": {
            "type": "string",
            "description": "Base64-encoded input image"
          },
          "seed": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 64,
            "default": 0
          },
          "height": {
            "type": "integer",
            "minimum": 64,
            "default": 0
          },
          "safety_tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
