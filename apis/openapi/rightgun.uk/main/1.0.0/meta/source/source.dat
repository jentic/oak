          },
          "barrelPoint": {
            "type": "number"
          },
          "stockUnit": {
            "type": "string",
            "enum": [
              "Inch",
              "Centimeters"
            ]
          },
          "stock": {
            "type": "number"
          },
          "stockPoint": {
            "type": "number"
          },
