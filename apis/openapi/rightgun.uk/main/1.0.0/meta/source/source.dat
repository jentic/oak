              "08 Gauge",
              "10 Gauge",
              "12 Gauge",
              "14 Gauge",
              "16 Gauge",
              "20 Gauge",
              "28 Gauge"
            ]
          },
          "loadWeight": {
            "type": "string"
          },
          "shotSize": {
            "type": "string"
          },
          "shotMaterial": {
            "type": "string",
            "enum": [
              "Lead",
              "Steel",
              "Bismuth",
              "Tungsten",
              "Copper plated lead",
              "Hevi"
            ]
          },
          "wadType": {
            "type": "string",
            "enum": [
              "Plastic",
              "Fiber felt",
              "Fiber cork",
              "Biodegradable",
              "Cup wad",
              "Slit wad"
            ]
          },
          "velocity": {
            "type": "integer",
            "enum": [
              1100,
              1200,
              1250,
              1300,
              1350,
              1400,
              1450
            ]
          },
          "caseMaterial": {
            "type": "string",
            "enum": [
              "Plastic",
              "Paper",
              "Brass"
            ]
          },
          "primerType": {
            "type": "string"
          },
          "powderType": {
            "type": "string"
          }
        }
      },
      "shotgun": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "enum": [
              1,
              2
            ]
          },
          "ejector": {
            "type": "string",
            "enum": [
              true,
              false
            ]
          },
          "chamber": {
            "type": "string"
          },
          "chamberPoint": {
            "type": "string"
          },
          "choke": {
            "type": "string",
            "enum": [
              "fixed",
              "multi"
            ]
          },
          "choke1": {
