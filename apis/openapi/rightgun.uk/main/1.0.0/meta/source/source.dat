          {
            "name": "reference",
            "in": "path",
            "description": "Advertise the item based on the reference. The reference is your internal id, used initially to create the item.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Create a new advertisement with a price",
