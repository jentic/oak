          "Firearm",
          "Prohibited weapons and ammunition",
          "Registered Firearms Dealer (RFD)",
          "Shotgun",
          "Temporary permit",
          "No Licence"
        ]
      },
      "dimensions": {
        "type": "object",
        "properties": {
          "length": {
            "type": "integer",
            "format": "int64",
            "description": "This is the length of the item",
            "default": null
          },
          "width": {
            "type": "integer",
            "format": "int64",
            "description": "This is the width of the item",
            "default": null
          },
          "height": {
            "type": "integer",
            "format": "int64",
            "description": "This is the height of the item",
            "default": null
          },
          "text": {
            "type": "integer",
            "format": "int64",
            "description": "This is the text value",
            "default": null
          }
        }
      },
      "statusResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "This is the status of the action. For example 'success'."
          },
          "message": {
            "type": "string",
            "description": "We have received your request, it will be processed shortly."
          },
