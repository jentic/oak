    "/metadata/calibre": {
      "post": {
        "tags": [
          "metadata"
        ],
        "summary": "Add a new calibre",
        "description": "Creates a new calibre in the correct item",
        "operationId": "createCalibre",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/calibre"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/calibre"
                }
              }
            }
          },
          "default": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "metadata"
        ],
        "summary": "Retrieve a calibre",
        "description": "Retrieve calibre information",
        "operationId": "getCalibre",
        "parameters": [
          {
            "name": "calibre",
            "in": "query",
            "description": "The calibre",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "The type of firearm for calibre e.g. shotgun for 12 Gauge",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Rifle",
                "Shotgun",
                "Airgun"
              ]
            }
          },
          {
            "name": "match",
            "in": "query",
            "description": "This is how the data is matched to your input. Numbers only will remove all other characters. For example 12 Gauge would return 12. If you select fuzzy, and put in 410, then 0.410 Gauge will be found.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Fuzzy",
                "Numbers only"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/calibre"
                }
              }
            }
          },
          "400": {
            "description": "Invalid calibre supplied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/metadata/category": {
      "get": {
        "tags": [
          "metadata"
        ],
        "summary": "Retrieves a list of all categories.",
        "description": "Retrieve category information.",
        "operationId": "getCategory",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/category"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/metadata/subCategory/{category}": {
      "get": {
        "tags": [
          "metadata"
        ],
        "summary": "Get subCategory",
        "description": "Returns all the subcategories based on the category.",
        "operationId": "getSubCategory",
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "description": "Category for the subcategory",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/subCategory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid category supplied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Category not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "metadata"
        ],
        "summary": "Add sub category",
        "description": "Add a new sub category.",
        "operationId": "addSubCategory",
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "description": "The category for the subcategory",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subcategory",
            "in": "query",
            "description": "The new subcategory to be added",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/subCategory"
                }
              }
            }
          },
          "default": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/metadata/furtherCategory/{subCategory}": {
      "get": {
        "tags": [
          "metadata"
        ],
        "summary": "Returns all further categories",
        "description": "Returns all the further categories based on the sub category",
        "operationId": "getFurtherCategory",
        "parameters": [
          {
            "name": "subCategory",
            "in": "path",
            "description": "Pass in the sub category to retrieve all further categories.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/furtherCategory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sub category supplied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Sub category not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "metadata"
        ],
        "summary": "Add a new further category, under an existing sub category.",
        "description": "Add a new further category.",
        "operationId": "addFurtherCategory",
        "parameters": [
          {
            "name": "subCategory",
            "in": "path",
            "description": "The sub category to add the further category against.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "furtherCategory",
            "in": "query",
            "description": "The new further category to be added.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/furtherCategory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sub category supplied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Sub category not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oAuthRightgun": {
        "type": "oauth2",
        "description": "This API uses OAuth 2 with the client credentials flow",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://app.rightgun.uk/portal/api/oauth/token",
            "scopes": {
              "read_items": "read item",
              "write_items": "modify item"
            }
          }
        }
      }
    },
    "schemas": {
      "xReference": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The systems name e.g. dealerExchange"
          },
          "code": {
            "type": "string",
            "description": "The systems code e.g. DE"
          },
          "reference": {
            "type": "string",
            "description": "The systems reference  e.g. 180"
          },
          "id": {
            "type": "string",
            "description": "The systems ID  e.g. 180"
          }
        }
      },
      "party": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The party's title e.g. Mr"
          },
          "firstName": {
            "type": "string",
            "description": "The party's first name e.g. John"
          },
          "lastName": {
            "type": "string",
            "description": "The party's last name e.g. Smith"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The party's email e.g. john@example.com"
          },
          "mobile": {
            "type": "string",
            "pattern": "^[0-9 +]+$",
            "description": "The mobile number e.g. 07507 844444"
          },
          "address": {
            "$ref": "#/components/schemas/address"
          }
        }
      },
      "price": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "auction",
              "fixed"
            ],
            "default": "fixed"
          },
          "perUnit": {
            "type": "integer"
          },
          "perUnitSale": {
            "type": "integer",
            "description": "this is the new on sale price"
          },
          "per10Unit": {
            "type": "integer"
          },
          "perUnitTrade": {
            "type": "integer"
          },
          "per10UnitTrade": {
            "type": "integer"
          },
          "taxInclusive": {
            "type": "boolean"
          },
          "purchasePrice": {
            "type": "integer"
          },
          "priceOnApplication": {
            "type": "boolean",
            "default": false
          },
          "auction": {
            "$ref": "#/components/schemas/auction"
          }
        }
      },
      "sell": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "priceSell": {
            "type": "integer",
            "minimum": 1
          },
          "pricePurchase": {
            "type": "integer",
            "minimum": 1
          },
          "party": {
            "$ref": "#/components/schemas/party"
          },
          "notes": {
            "type": "string"
          },
          "sendConfirmation": {
            "type": "string",
            "enum": [
              true,
              false
            ]
          },
          "sendNoticeOfTransfer": {
            "type": "string",
            "enum": [
              true,
              false
            ]
          }
        }
      },
      "auction": {
        "type": "object",
        "properties": {
          "reserve": {
            "type": "integer",
            "minimum": 1,
            "default": null
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "default": null
          },
          "increment": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": null
          },
          "starting": {
            "type": "integer",
            "minimum": 1,
            "default": null
          },
          "buy": {
            "type": "integer",
            "minimum": 1,
            "default": null
          }
        }
      },
      "address": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        }
      },
      "status": {
        "type": "string",
        "enum": [
          "Active",
          "Advertised",
          "Commission",
          "Sold",
          "Repair",
          "Sale or return",
          "Buy or receive",
          "Dispose",
          "Store",
          "Loss",
          "Lend",
          "Deposit",
          "Dealer transfer"
        ],
        "default": "Active"
      },
      "description": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      },
      "inventory": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "In stock",
              "Out of stock"
            ]
          },
          "restock": {
            "type": "string",
            "description": "When the quantity is 0 you can use this field to say when the item is expected to be back in stock.",
            "format": "date"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          },
          "weightUnit": {
            "type": "string",
            "enum": [
              "Pounds",
              "Kg"
            ]
          },
          "weight": {
            "type": "number"
          },
          "dimensions": {
            "$ref": "#/components/schemas/dimensions"
          }
        }
      },
      "category": {
        "type": "string",
        "description": "A category in the catalogue."
      },
      "subCategory": {
        "type": "string",
        "description": "A sub category in the catalogue."
      },
      "furtherCategory": {
        "type": "string",
        "description": "A further category in the sub category with in the catalogue."
      },
      "catalogue": {
        "type": "object",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/category"
          },
          "subCategory": {
            "$ref": "#/components/schemas/subCategory"
          },
          "furtherCategory": {
            "$ref": "#/components/schemas/furtherCategory"
          }
        }
      },
      "makeModelVarient": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          }
        }
      },
      "scope": {
        "type": "object",
        "properties": {
          "scopeMakeModelVarient": {
            "$ref": "#/components/schemas/makeModelVarient"
          },
          "magnification": {
            "type": "string"
          },
          "opticType": {
            "type": "string"
          },
          "objectiveLens": {
            "type": "string"
          },
          "tubeDiameter": {
            "type": "string"
          },
          "reticle": {
            "type": "string"
          },
          "reticleIlluminated": {
            "type": "string"
          },
          "adjustmentUnit": {
            "type": "string"
          },
          "finish": {
            "type": "string"
          }
        }
      },
      "modifier": {
        "type": "object",
        "properties": {
          "modifierMakeModelVarient": {
            "$ref": "#/components/schemas/makeModelVarient"
          },
          "calibre": {
            "$ref": "#/components/schemas/calibre"
          }
        }
      },
      "equipment": {
        "type": "object",
        "properties": {
          "temporary": {
            "type": "string",
            "description": "temporary placeholder only"
          }
        }
      },
      "ammunition": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "explosives",
              "cartridges",
              "bullets"
            ]
          },
          "cartridge": {
            "$ref": "#/components/schemas/cartridge"
          },
          "bullet": {
            "$ref": "#/components/schemas/bullet"
          },
          "explosive": {
            "$ref": "#/components/schemas/explosive"
          },
          "quantityPerUnit": {
            "type": "string"
          }
        }
      },
      "explosive": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Black Powder",
              "Smokeless (Single Base)",
              "Smokeless (Double Base)",
              "Smokeless (Triple Base)",
              "Pyrodex",
              "Substitute"
            ]
          },
          "hazardDivision": {
            "type": "string",
            "enum": [
              "1.1",
              "1.2",
              "1.3",
              "1.4",
              "1.5",
              "1.6"
            ]
          },
          "compatibilityGroup": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H",
              "J",
              "K",
              "L",
              "N",
              "S"
            ]
          },
          "unNumber": {
            "type": "integer"
          },
          "netExplosiveQuantity": {
            "type": "integer"
          },
          "composition": {
            "type": "string"
          },
          "storageRequirements": {
            "type": "string",
            "enum": [
              "Type 1",
              "Type 2",
              "Type 3",
              "Type 4",
              "Type 5"
            ]
          },
          "netWeight": {
            "type": "integer"
          },
          "burnRate": {
            "type": "string",
            "enum": [
              "Very Fast",
              "Fast",
              "Medium",
              "Slow",
              "Very Slow"
            ]
          }
        }
      },
      "bullet": {
        "type": "object",
        "properties": {
          "caliber": {
            "type": "string"
          },
          "bulletWeight": {
            "type": "integer"
          },
          "bulletType": {
            "type": "string",
            "enum": [
              "FMJ",
              "JHP",
              "SP",
              "HP",
              "BT",
              "OTM",
              "TMJ",
              "RN",
              "WC",
              "LRN",
              "AP",
              "Frangible",
              "Saboted"
            ]
          },
          "bulletMaterial": {
            "type": "string",
            "enum": [
              "Lead",
              "Copper",
              "Brass jacketed",
              "Steel core",
              "Tungsten",
              "Polymer tipped",
              "Lead free",
              "Bismuth"
            ]
          },
          "velocity": {
            "type": "integer"
          },
          "energy": {
            "type": "integer"
          },
          "caseMaterial": {
            "type": "string",
            "enum": [
              "Brass",
              "Steel",
              "Aluminum",
              "Nickel plated brass",
              "Polymer"
            ]
          },
          "primerType": {
            "type": "string",
            "enum": [
              "Boxer",
              "Berdan",
              "Small pistol",
              "Large pistol",
              "Small rifle",
