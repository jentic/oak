          },
          "choke2": {
            "type": "string",
            "description": "Only use this field if the shotgun is fixed choke."
          }
        }
      },
      "calibre": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
