            "type": "string",
            "description": "this is the physical serial number of the item. For example a shotgun serial is AB-12345"
          },
          "advertisementId": {
            "type": "string",
            "description": "INTERNAL ONLY - The rightgun internal advertisement  number. This is added once an item has been advertised. It will be retured in subsequent calls. Example 'BMT1CS'"
          },
          "itemId": {
            "type": "string",
            "description": "INTERNAL ONLY - The rightgun internal item number. This is added once an item has been added. It will be retured in subsequent calls. Example '123456'"
          },
          "clientId": {
            "type": "string",
