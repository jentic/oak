{
  "openapi": "3.1.0",
  "info": {
    "title": "Rightgun.uk - OpenAPI 3.1.0",
    "description": "Rightgun.uk offers a suite of APIs through its web services designed to streamline access to critical information and enhance user experiences for developers and businesses in the firearms sector.\nThese APIs provide real-time data on firearm regulations, dealer locations, and shooting range availability, allowing for seamless integration into various applications and platforms. For instance, developers can use our APIs to incorporate up-to-date legislative changes into their apps or to display a dynamic list of nearby shooting ranges and dealers.\nAdditionally, our APIs support advanced search functionalities, enabling users to find specific firearms or related products with ease. By leveraging these web services, businesses and enthusiasts alike can access comprehensive, accurate, and timely information, fostering a more informed and connected firearms community.\nSome useful links:\n  - [Rightgun.uk](https://www.Rightgun.uk)\n  - [Help and support](https://www.rightgun.uk/contact-us)",
    "termsOfService": "https://www.rightgun.uk/privacy-policy",
    "contact": {
      "email": "Help@rightgun.uk"
    },
    "license": {
      "name": "Pricing",
      "url": "https://www.rightgun.uk/pricing"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Rightgun.uk/webservces/1.0.0"
  },
  "externalDocs": {
    "description": "Find out more about Rightgun.uk",
    "url": "https://www.rightgun.uk/about-us"
  },
  "servers": [
    {
      "url": "https://app.rightgun.uk/portal/api/v1/integration/"
    }
  ],
  "tags": [
    {
      "name": "item",
      "description": "Managing your Armoury items e.g. Add, Remove, Update",
      "externalDocs": {
        "description": "Find out more",
        "url": "http://www.rightgun.uk"
      }
    },
    {
      "name": "user",
      "description": "Operations about user"
    },
    {
      "name": "metadata",
      "description": "Everything about the structure of your data. To model the data we create structures. These structures harmonize the data across multiple data sets."
    }
  ],
  "security": [
    {
      "oAuthRightgun": [
        "write_items",
        "read_items"
      ]
    }
  ],
  "paths": {
    "/item": {
      "post": {
        "tags": [
          "item"
        ],
        "summary": "Add a new item to the Armoury",
        "description": "Add a new Armoury item. By default the stock level will be set to 1, and the stock status will be set to In stock. Further changes to stock levels can be set via item/stock/",
        "operationId": "addItem",
        "requestBody": {
          "description": "Create a new item",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/item"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/statusResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/item/reference/{reference}": {
      "get": {
        "tags": [
          "item"
        ],
        "summary": "Get an item by its reference number",
        "operationId": "getItemByReference",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "description": "Get the item based on the reference. The reference is your internal id, used initially to create the item.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/item"
                }
              }
            }
          },
          "400": {
            "description": "Invalid reference value",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "item"
        ],
        "summary": "Update an existing item in the Armoury",
        "description": "Update an existing Armoury item.",
        "operationId": "updateItemByReference",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "description": "The reference of an existing item. The reference is your internal id, it was created when the item was initially created.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Update an existing item",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/updateItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/statusResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/item/id/{id}": {
      "get": {
        "tags": [
          "item"
        ],
        "summary": "Find item by ID",
        "description": "Returns a single item by the ID",
        "operationId": "getItemById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of item to return",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
