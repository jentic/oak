{
  "openapi": "3.0.3",
  "info": {
    "title": "Have I Been Pwned API",
    "description": "The Have I Been Pwned API allows you to check if an email address or password has been compromised in a data breach. Provides breach data, paste data, stealer log data, and domain search capabilities.",
    "version": "3",
    "contact": {
      "name": "Troy Hunt",
      "url": "https://haveibeenpwned.com"
    },
    "x-jentic-source-url": "https://haveibeenpwned.com/API/v3"
  },
  "servers": [
    {
      "url": "https://haveibeenpwned.com/api/v3",
      "description": "Production"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "hibp-api-key",
        "description": "API key obtained from https://haveibeenpwned.com/API/Key"
      }
    },
    "schemas": {
      "Breach": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Domain": {
            "type": "string"
          },
          "BreachDate": {
            "type": "string",
            "format": "date"
          },
          "AddedDate": {
            "type": "string",
            "format": "date-time"
          },
          "ModifiedDate": {
            "type": "string",
            "format": "date-time"
          },
          "PwnCount": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "LogoPath": {
            "type": "string"
          },
          "DataClasses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "IsVerified": {
            "type": "boolean"
          },
          "IsFabricated": {
            "type": "boolean"
          },
          "IsSensitive": {
            "type": "boolean"
          },
          "IsRetired": {
            "type": "boolean"
          },
          "IsSpamList": {
            "type": "boolean"
          },
          "IsMalware": {
            "type": "boolean"
          },
          "IsSubscriptionFree": {
            "type": "boolean"
          }
        }
      },
      "Paste": {
        "type": "object",
        "properties": {
          "Source": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Date": {
            "type": "string",
            "format": "date-time"
          },
          "EmailCount": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/breachedaccount/{account}": {
      "get": {
        "operationId": "getBreachesForAccount",
        "summary": "Get all breaches for an account",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Email address to search"
          },
          {
            "name": "truncateResponse",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Return only breach names"
          },
          {
            "name": "domain",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by domain"
          },
          {
            "name": "includeUnverified",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Include unverified breaches"
          }
        ],
        "responses": {
          "200": {
            "description": "List of breaches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Breach"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found - the account could not be found"
          }
        }
      }
    },
    "/breaches": {
      "get": {
        "operationId": "getAllBreaches",
        "summary": "Get all breaches in the system",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by domain"
          }
        ],
        "responses": {
          "200": {
            "description": "List of all breaches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Breach"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/breach/{name}": {
      "get": {
        "operationId": "getBreachByName",
        "summary": "Get a single breached site",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Breach details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Breach"
                }
              }
            }
          }
        }
      }
    },
    "/latestBreach": {
      "get": {
        "operationId": "getLatestBreach",
        "summary": "Get the most recently added breach",
        "responses": {
          "200": {
            "description": "Latest breach",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Breach"
                }
              }
            }
          }
        }
      }
    },
    "/dataclasses": {
      "get": {
        "operationId": "getDataClasses",
        "summary": "Get all data classes in the system",
        "responses": {
          "200": {
            "description": "List of data classes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pasteaccount/{account}": {
      "get": {
        "operationId": "getPastesForAccount",
        "summary": "Get all pastes for an account",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of pastes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Paste"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stealerlogsByEmail/{email}": {
      "get": {
        "operationId": "getStealerLogsByEmail",
        "summary": "Get stealer logs by email address",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stealer log entries"
          }
        }
      }
    },
    "/stealerlogsByWebsiteDomain/{domain}": {
      "get": {
        "operationId": "getStealerLogsByWebsiteDomain",
        "summary": "Get stealer logs by website domain",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stealer log entries"
          }
        }
      }
    },
    "/stealerlogsByEmailDomain/{domain}": {
      "get": {
        "operationId": "getStealerLogsByEmailDomain",
        "summary": "Get stealer logs by email domain",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stealer log entries"
          }
        }
      }
    },
    "/subscription/status": {
      "get": {
        "operationId": "getSubscriptionStatus",
        "summary": "Get subscription status",
        "responses": {
          "200": {
            "description": "Subscription details"
          }
        }
      }
    },
    "/subscribeddomains": {
      "get": {
        "operationId": "getSubscribedDomains",
        "summary": "Get subscribed domains",
        "responses": {
          "200": {
            "description": "List of subscribed domains"
          }
        }
      }
    },
    "/breacheddomain/{domain}": {
      "get": {
        "operationId": "getBreachedDomain",
        "summary": "Get breaches for a domain",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domain breach data"
          }
        }
      }
    }
  }
}