{
  "openapi": "3.0.3",
  "info": {
    "title": "Montonio Stargate Payments API",
    "description": "Montonio Stargate is an Estonian payment gateway API that enables merchants to create payment orders, manage payment intents, process refunds, and retrieve available payment methods. It supports bank payments, card payments, BNPL (Buy Now Pay Later) financing, and various local payment methods across the Baltics and Europe.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.montonio.com/"
  },
  "servers": [
    {
      "url": "https://stargate.montonio.com/api",
      "description": "Production API server"
    },
    {
      "url": "https://sandbox-stargate.montonio.com/api",
      "description": "Sandbox API server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create a payment order",
        "description": "Creates a new payment order and returns a payment URL where the customer can complete the payment. The order contains all necessary information about the transaction including amount, currency, line items, and customer details.",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/{order_uuid}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Retrieve an order",
        "description": "Returns the details and current status of a specific payment order.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the order"
          }
        ],
        "responses": {
          "200": {
            "description": "Order retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/orders/{order_uuid}/refunds": {
      "post": {
        "operationId": "createRefund",
        "summary": "Create a refund for an order",
        "description": "Initiates a full or partial refund for a completed payment order.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the order to refund"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {
                    "type": "number",
                    "format": "double",
                    "description": "Amount to refund"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency code (e.g., EUR)"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason for the refund"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefundResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/payment-intents/draft": {
      "post": {
        "operationId": "createDraftPaymentIntent",
        "summary": "Draft a payment intent",
        "description": "Creates a draft payment intent for embedded payment flows. This is used with the Montonio Embedded Payments integration where the payment form is rendered directly on the merchant's website.",
        "tags": ["Payment Intents"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DraftPaymentIntentRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft payment intent created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentIntentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payment-intents/{intent_uuid}": {
      "get": {
        "operationId": "getPaymentIntent",
        "summary": "Retrieve a payment intent",
        "description": "Returns the details and current status of a specific payment intent.",
        "tags": ["Payment Intents"],
        "parameters": [
          {
            "name": "intent_uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the payment intent"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment intent retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentIntentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/payment-intents/{intent_uuid}/finalize": {
      "post": {
        "operationId": "finalizePaymentIntent",
        "summary": "Finalize a payment intent",
        "description": "Finalizes a draft payment intent to initiate the actual payment processing.",
        "tags": ["Payment Intents"],
        "parameters": [
          {
            "name": "intent_uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the payment intent to finalize"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payment_method_id": {
                    "type": "string",
                    "description": "The selected payment method identifier"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment intent finalized successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentIntentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/stores/setup": {
      "get": {
        "operationId": "getStoreSetup",
        "summary": "Retrieve available payment methods",
        "description": "Returns the store configuration including available payment methods organized by country and payment type. This endpoint is used to determine which payment methods to display to the customer.",
        "tags": ["Store"],
        "parameters": [
          {
            "name": "access-key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "The merchant access key"
          }
        ],
        "responses": {
          "200": {
            "description": "Store setup retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreSetupResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/{order_uuid}/payouts": {
      "get": {
        "operationId": "getOrderPayouts",
        "summary": "Retrieve payouts for an order",
        "description": "Returns the payout information associated with a specific completed order.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the order"
          }
        ],
        "responses": {
          "200": {
            "description": "Payout information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Payout" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/hire-purchase/applications": {
      "post": {
        "operationId": "createHirePurchaseApplication",
        "summary": "Create a hire purchase application",
        "description": "Creates a new hire purchase (BNPL - Buy Now Pay Later) financing application for a customer order.",
        "tags": ["Hire Purchase"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency", "merchant_reference"],
                "properties": {
                  "amount": {
                    "type": "number",
                    "format": "double",
                    "description": "Total amount for hire purchase"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency code"
                  },
                  "merchant_reference": {
                    "type": "string",
                    "description": "Merchant's order reference"
                  },
                  "return_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL to redirect customer after application"
                  },
                  "notification_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL for webhook notifications"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hire purchase application created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uuid": { "type": "string", "format": "uuid" },
                    "application_url": { "type": "string", "format": "uri" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/hire-purchase/applications/{application_uuid}": {
      "get": {
        "operationId": "getHirePurchaseApplication",
        "summary": "Retrieve a hire purchase application",
        "description": "Returns the details and status of a hire purchase financing application.",
        "tags": ["Hire Purchase"],
        "parameters": [
          {
            "name": "application_uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "The unique identifier of the hire purchase application"
          }
        ],
        "responses": {
          "200": {
            "description": "Application retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uuid": { "type": "string", "format": "uuid" },
                    "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "FINALIZED", "CANCELLED"] },
                    "amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "merchant_reference": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token signed with HS256 using your secret key. The token payload must include the access key and an expiration time (600 seconds)."
      }
    },
    "schemas": {
      "CreateOrderRequest": {
        "type": "object",
        "required": ["accessKey", "merchantReference", "returnUrl", "currency", "grandTotal", "locale", "payment"],
        "properties": {
          "accessKey": {
            "type": "string",
            "description": "Merchant access key"
          },
          "merchantReference": {
            "type": "string",
            "description": "Unique merchant reference for the order"
          },
          "returnUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to redirect the customer after payment"
          },
          "notificationUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for webhook notifications"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code (e.g., EUR)"
          },
          "grandTotal": {
            "type": "number",
            "format": "double",
            "description": "Total order amount"
          },
          "locale": {
            "type": "string",
            "description": "Locale code (e.g., et, lt, lv, fi, pl)"
          },
          "billingAddress": { "$ref": "#/components/schemas/Address" },
          "shippingAddress": { "$ref": "#/components/schemas/Address" },
          "lineItems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LineItem" }
          },
          "payment": { "$ref": "#/components/schemas/PaymentDetails" }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "addressLine1": { "type": "string" },
          "locality": { "type": "string" },
          "region": { "type": "string" },
          "country": { "type": "string" },
          "postalCode": { "type": "string" }
        }
      },
      "LineItem": {
        "type": "object",
        "required": ["name", "quantity", "finalPrice"],
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "integer" },
          "finalPrice": { "type": "number", "format": "double" }
        }
      },
      "PaymentDetails": {
        "type": "object",
        "required": ["method", "currency", "amount"],
        "properties": {
          "method": {
            "type": "string",
            "description": "Payment method (e.g., paymentInitiation, cardPayments, hirePurchase)"
          },
          "currency": { "type": "string" },
          "amount": { "type": "number", "format": "double" },
          "methodOptions": {
            "type": "object",
            "description": "Additional options specific to the payment method"
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid" },
          "paymentUrl": { "type": "string", "format": "uri" },
          "merchantReference": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "PAID", "PARTIALLY_REFUNDED", "REFUNDED", "CANCELLED", "ABANDONED", "VOIDED"]
          },
          "currency": { "type": "string" },
          "grandTotal": { "type": "number", "format": "double" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RefundResponse": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid" },
          "orderUuid": { "type": "string", "format": "uuid" },
          "amount": { "type": "number", "format": "double" },
          "currency": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "FAILED"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "DraftPaymentIntentRequest": {
        "type": "object",
        "required": ["accessKey", "currency", "grandTotal"],
        "properties": {
          "accessKey": { "type": "string" },
          "currency": { "type": "string" },
          "grandTotal": { "type": "number", "format": "double" },
          "merchantReference": { "type": "string" },
          "returnUrl": { "type": "string", "format": "uri" },
          "notificationUrl": { "type": "string", "format": "uri" }
        }
      },
      "PaymentIntentResponse": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["DRAFT", "PENDING", "COMPLETED", "FAILED", "CANCELLED"] },
          "currency": { "type": "string" },
          "grandTotal": { "type": "number", "format": "double" },
          "paymentMethods": {
            "type": "array",
            "items": { "type": "object" }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "StoreSetupResponse": {
        "type": "object",
        "properties": {
          "paymentMethods": {
            "type": "object",
            "properties": {
              "paymentInitiation": {
                "type": "object",
                "properties": {
                  "setup": {
                    "type": "object",
                    "description": "Payment methods organized by country code",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "paymentMethods": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/PaymentMethod" }
                        }
                      }
                    }
                  }
                }
              },
              "cardPayments": { "type": "object" },
              "hirePurchase": { "type": "object" }
            }
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "logoUrl": { "type": "string", "format": "uri" },
          "country": { "type": "string" }
        }
      },
      "Payout": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid" },
          "amount": { "type": "number", "format": "double" },
          "currency": { "type": "string" },
          "status": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" },
          "statusCode": { "type": "integer" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - invalid parameters or request body",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - invalid or expired JWT token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}