        }
      },
      "post": {
        "operationId": "createTour",
        "summary": "Create a tour",
        "description": "Create a new disposition tour",
        "tags": ["Disposition"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TourCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Tour created" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/tours/optimize": {
      "post": {
        "operationId": "optimizeTour",
        "summary": "Optimize a tour",
        "description": "Optimize tour route calculations",
        "tags": ["Disposition"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Optimized tour" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/approvals": {
      "get": {
        "operationId": "listApprovals",
        "summary": "List approvals",
        "description": "Returns approval workflows and status",
        "tags": ["Approvals"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Successful response" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/forms": {
      "get": {
        "operationId": "listForms",
        "summary": "List forms",
        "description": "Returns a list of forms",
        "tags": ["Forms"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Successful response" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/forms/{formId}/pdf": {
      "get": {
        "operationId": "getFormPdf",
        "summary": "Get form PDF",
        "description": "Generate a PDF for a form",
        "tags": ["Forms"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "formId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "PDF generated", "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/geocode": {
      "get": {
        "operationId": "geocode",
        "summary": "Geocode an address",
        "description": "Convert address to coordinates or coordinates to address",
        "tags": ["Geocoding"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "address", "in": "query", "description": "Address to geocode", "required": false, "schema": { "type": "string" } },
          { "name": "lat", "in": "query", "description": "Latitude for reverse geocoding", "required": false, "schema": { "type": "number" } },
          { "name": "lng", "in": "query", "description": "Longitude for reverse geocoding", "required": false, "schema": { "type": "number" } }
        ],
        "responses": {
          "200": { "description": "Geocoding result" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/routes": {
      "get": {
        "operationId": "calculateRoute",
        "summary": "Calculate route",
        "description": "Calculate a route between coordinates",
        "tags": ["Geocoding"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Route calculated" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
