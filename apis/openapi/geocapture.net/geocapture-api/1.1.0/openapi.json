        }
      }
    },
    "/tools": {
      "get": {
        "operationId": "listTools",
        "summary": "List tools",
        "description": "Returns a list of tools in inventory",
        "tags": ["Asset Management"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Successful response" },
