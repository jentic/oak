{
  "openapi": "3.0.3",
  "info": {
    "title": "geoCapture API",
    "version": "1.1.0",
    "description": "The geoCapture API provides integration endpoints for time-tracking, GPS tracking, disposition management, and asset tracking functionalities.",
    "x-jentic-source-url": "https://app.geocapture.net/api/help/view"
  },
  "servers": [
    {
      "url": "https://app.geocapture.net/api"
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "operationId": "listEmployees",
        "summary": "List employees",
        "description": "Returns a list of employees",
        "tags": ["Employees"],
        "parameters": [
          {
            "name": "apitoken",
            "in": "query",
            "description": "API token for authentication",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmployeeListResponse" }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/employees/stamps": {
      "get": {
        "operationId": "listEmployeeStamps",
        "summary": "List employee stamps",
        "description": "Returns employee time tracking stamps",
        "tags": ["Time Tracking"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "offset", "in": "query", "description": "Pagination offset", "required": false, "schema": { "type": "integer", "default": 0 } },
          { "name": "limit", "in": "query", "description": "Number of results per page", "required": false, "schema": { "type": "integer", "default": 100 } }
        ],
        "responses": {
          "200": { "description": "Successful response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StampListResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createEmployeeStamp",
        "summary": "Create employee stamp",
        "description": "Create a new employee time tracking stamp",
        "tags": ["Time Tracking"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StampCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Stamp created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Stamp" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/employees/absences": {
      "get": {
        "operationId": "listEmployeeAbsences",
        "summary": "List employee absences",
        "description": "Returns a list of employee absences",
        "tags": ["Time Tracking"],
        "parameters": [
          { "name": "apitoken", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Successful response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AbsenceListResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
