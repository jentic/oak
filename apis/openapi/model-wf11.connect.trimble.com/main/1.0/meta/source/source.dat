  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Trimble Identity-provided access token.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://id.trimble.com/oauth/authorize",
            "tokenUrl": "https://id.trimble.com/oauth/token",
            "scopes": {
              "tc-model-workflows": "The base scope needed to interact with this API."
            }
          }
        }
      }
    },
    "parameters": {
      "ProjectIdPath": {
        "name": "projectId",
        "in": "path",
        "description": "Project identifier",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        }
      },
      "RuleBasedGroupFieldsQuery": {
        "name": "fields",
        "in": "query",
        "description": "A comma separated list of extra properties to include in the response. If not specified, only the basic properties of the resource will be returned.",
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RuleBasedGroupFields"
          },
          "example": [
            "coloredHierarchyLevel",
            "modelVersions"
          ]
        }
      },
      "DeletedQuery": {
        "name": "deleted",
        "in": "query",
        "description": "If specified the set of deleted resources will be returned.",
        "allowEmptyValue": true,
        "schema": {
          "type": "boolean"
        }
      },
      "PageSizeQuery": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Maximum amount of items to return in the response. It is not guaranteed that exact number of items will be returned, but up to the provided value as max. Note that max items limit might be increased in the future, clients should not make any assumptions on the number of items returned by default.\n",
        "schema": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 500
        }
      },
      "PageTokenQuery": {
        "name": "pageToken",
        "in": "query",
        "required": false,
        "description": "The token used for the pagination. Typically returned with the response in the previous page  and should be used as-is without interpretation.",
        "schema": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024
        }
      },
      "GroupIdPath": {
        "name": "groupId",
        "in": "path",
        "description": "Group identifier.",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      },
      "SubgroupFieldsQuery": {
        "name": "fields",
        "in": "query",
        "description": "A comma separated list of extra properties to include in the response. If not specified, only the basic properties of the resource will be returned. Supported fields: color, visible, links",
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SubgroupFields"
          },
          "example": [
            "links",
            "color"
          ]
        }
      },
      "SubgroupIdPath": {
        "name": "subgroupId",
        "in": "path",
        "description": "Subgroup identifier.",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "RuleBasedGroupFields": {
        "description": "Supported fields option to get the extra properties of the resource:\n  * coloredHierarchyLevel - Will return the colored hierarchy level in the group.\n  * modelVersions - Will return a map of models and model version identifiers, used by the last formula evaluation.\n  * conditionUnitMap - Will return a map of used varDescriptors and unit type.\n  * anySubgroupHidden - Will return whether any subgroup was made hidden in the group.\n",
        "type": "string",
        "enum": [
          "coloredHierarchyLevel",
          "modelVersions",
          "conditionUnitMap",
          "anySubgroupHidden"
        ]
      },
      "Entity": {
        "title": "Entity",
        "description": "A common base schema for entities.",
        "type": "object",
        "required": [
          "id",
          "createdAtDateTime",
          "createdBy",
          "updatedAtDateTime",
          "updatedBy",
          "version"
        ],
        "properties": {
          "id": {
            "description": "The identifier of the resource.",
            "type": "string",
            "maxLength": 128
          },
          "createdAtDateTime": {
            "type": "string",
            "description": "The creation timestamp.",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "description": "The identifier of the principal that created the resource."
          },
          "updatedAtDateTime": {
            "type": "string",
            "description": "The last update timestamp.",
            "format": "date-time"
          },
          "updatedBy": {
            "type": "string",
            "description": "The identifier of the principal that updated the resource."
          },
          "deletedAtDateTime": {
            "type": "string",
            "description": "The deleted timestamp. If the resource is not deleted, this field is null.",
            "format": "date-time"
          },
          "deletedBy": {
            "type": "string",
            "description": "The identifier of the principal that deleted the resource."
          },
          "version": {
            "type": "integer",
            "description": "The version number."
          }
        }
      },
      "NamedEntity": {
        "description": "A common base for schema entities with name.",
        "allOf": [
          {
            "$ref": "#/components/schemas/Entity"
          },
          {
            "type": "object",
            "description": "The entity name.",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "description": "The name of the resource.",
                "type": "string",
                "minLength": 3,
                "maxLength": 128
              }
            }
          }
        ]
      },
      "GroupActions": {
        "description": "These actions are used in the policy statements to specify the access to resources. Effective Permissions:\n  * mws:GetGroup - Allows to get the group.\n  * mws:GetGroupPolicy - Allows to get the group policy object with the statements.\n  * mws:UpdateGroup - Allows to update the group (name, rule, etc).\n  * mws:UpdateGroupPolicy - Allows to update the group's policy object.\n  * mws:RefreshGroup - Allows triggering recalculation of the subgroups.\n  * mws:ListSubgroups - Allows to list the subgroups of the group.\n",
        "type": "string",
        "enum": [
          "mws:GetGroup",
          "mws:GetGroupPolicy",
          "mws:UpdateGroup",
          "mws:UpdateGroupPolicy",
          "mws:RefreshGroup",
          "mws:ListSubgroups"
        ]
      },
      "Group": {
        "description": "Defines the properties of a group.",
        "allOf": [
          {
            "$ref": "#/components/schemas/NamedEntity"
          },
          {
            "type": "object",
            "description": "The group schema.",
            "properties": {
              "actions": {
                "type": "array",
                "description": "The list of effective actions the caller is allowed to\nperform on the resource.\n",
                "items": {
                  "$ref": "#/components/schemas/GroupActions"
                }
              }
            }
          }
        ]
      },
      "RuleBasedGroup": {
        "description": "Defines the properties of a rule-based group.",
        "allOf": [
          {
            "$ref": "#/components/schemas/Group"
          },
          {
            "type": "object",
            "description": "The rule-based group metadata schema.",
            "properties": {
              "coloredHierarchyLevel": {
                "description": "The hierarchy level colorization is set to on the group.",
                "type": "integer"
              },
              "anySubgroupHidden": {
                "description": "Defines whether any subgroup was made hidden in the group.",
                "type": "boolean"
              },
              "modelVersions": {
                "description": "Contains a list of model file identifiers - as keys - and its version identifiers - as values - used by the last formula evaluation.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "conditionUnitMap": {
                "description": "Contains a mapped list of the formula editor filter condition value units, where the keys are varDescriptors identifiers and the values are units of measure.",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "PaginationLinks": {
        "type": "object",
        "description": "Defines URLs that can be used to retrieve next and previous pages.",
        "properties": {
          "self": {
            "type": "object",
            "description": "A URL that will retrieve the response that was just received.",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "href"
            ]
          },
          "first": {
            "type": "object",
            "description": "A URL that will retrieve the first page of results.",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "href"
            ]
          },
          "next": {
            "type": "object",
            "description": "A URL that will retrieve the next page of results.",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "href"
            ]
          }
        },
        "required": [
          "self",
          "first"
        ]
      },
      "Error": {
        "title": "The error response.",
        "description": "The error response is conformant with [RFC 9457](https://www.rfc-editor.org/rfc/rfc9457.html) specification.",
        "type": "object",
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference (use a `tag:` scheme, cannot be dereferenced) that identifies the problem type. Consumers MUST use the `type` string as the primary identifier for the problem type.",
            "format": "uri",
            "pattern": "^tag:([a-zA-Z0-9-_]+)$"
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type."
          },
          "requestId": {
            "type": "string",
            "description": "Provide a correlation ID so this specific error instance can be found in logs, traces, etc."
          }
        }
      },
      "SubgroupFields": {
        "description": "Supported fields option to get the extra properties of the resource:\n  * color - Will return the color of the associated with the subgroup.\n  * visible - Will return the visibility of the associated with the subgroup.\n  * links - Will return the inlined set of links representing the associated entities.\n",
        "type": "string",
        "enum": [
          "color",
          "visible",
          "links"
        ]
      },
      "SubgroupActions": {
        "description": "These actions are used in the policy statements to specify the access to resources. Effective Permissions:\n  * mws:GetSubgroup - Allows to get the subgroup.\n  * mws:UpdateSubgroup - Allows to update the subgroup.\n  * mws:UpdateSubgroupLinks - Allows to update only the subgroup's links.\n",
        "type": "string",
        "enum": [
          "mws:GetSubgroup",
          "mws:UpdateSubgroup",
          "mws:UpdateSubgroupLinks"
        ]
      },
      "Subgroup": {
        "description": "Defines the properties of a subgroup.",
        "allOf": [
          {
            "$ref": "#/components/schemas/NamedEntity"
          },
          {
            "type": "object",
            "description": "The subgroup schema.",
            "required": [
              "groupId",
              "count"
            ],
            "properties": {
              "groupId": {
                "type": "string",
                "description": "The group identifier.",
                "maxLength": 128
              },
              "parentNames": {
                "type": "array",
                "description": "The list of parent names.",
                "items": {
                  "type": "string",
                  "description": "The parent name.",
                  "minLength": 3,
                  "maxLength": 128
                }
              },
              "count": {
                "type": "integer",
                "description": "The number of links associated with this subgroup."
              },
              "links": {
                "type": "array",
                "description": "The inlined set of links representing the associated entities. Each link in the linkset represents the associated entity.",
                "items": {
                  "type": "string",
                  "description": "The link. It is recommended to use FRN notation."
                }
              },
              "linksUrl": {
                "type": "string",
                "description": "The url to download a linkset for the subgroup. Each link in the linkset represents the associated entity."
              },
              "color": {
                "type": "string",
                "description": "The color associated with the subgroup.",
                "maxLength": 64
              },
              "visible": {
                "type": "boolean",
                "description": "The visibility associated with the subgroup.",
                "default": true
              },
              "actions": {
                "type": "array",
                "description": "The list of effective actions the caller is allowed to\nperform on the resource.\n",
                "items": {
                  "$ref": "#/components/schemas/SubgroupActions"
                }
              }
            }
          }
        ]
      },
