        "summary": "Get manual group subgroup",
        "description": "Get a manual group subgroup for the given manual group and subgroup id.\n",
        "operationId": "getManualSubgroup",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdPath"
          },
          {
            "$ref": "#/components/parameters/GroupIdPath"
