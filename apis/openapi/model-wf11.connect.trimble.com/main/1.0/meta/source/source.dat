        "summary": "Get manual group subgroups",
        "operationId": "getManualSubgroups",
        "description": "List subgroups for the given manual group. A single operation will read up to the maximum number of items set in the `pageSize` parameter. If the `next` link is present in the response, you will need to paginate the result set.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdPath"
          },
          {
            "$ref": "#/components/parameters/GroupIdPath"
          },
          {
            "$ref": "#/components/parameters/SubgroupFieldsQuery"
