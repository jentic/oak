    "/health": {
      "get": {
        "tags": [
          "Miscellaneous"
        ],
        "summary": "Health check",
        "operationId": "health",
        "description": "Verifies if the service is up and running.",
        "security": [
          {
            "oauth2": [
              "tc-model-workflows"
            ]
          }
        ],
        "responses": {
