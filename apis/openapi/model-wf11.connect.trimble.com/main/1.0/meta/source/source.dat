{
  "openapi": "3.0.1",
  "info": {
    "title": "Trimble Connect Model Feature Service",
    "description": "# Overview\nModel Feature Service provides easy access to Organizer groups in the context of a Trimble Connect project. The initial release allows read access to both Manual and Rule-based Organizer groups in the context of a project to enable automated consumption of this data.\n\nDocumentation for this service is available on the [Trimble Developer](https://developer.trimble.com/docs/connect/model-feature) site.\n\n# Getting started\n**You must agree to the [Terms of Service](https://developer.trimble.com/docs/connect/terms) to use Connect services.**\n\nYou need to complete the steps in the [Getting started](https://developer.trimble.com/docs/connect/getting_started) guide to be able to call the API.\n\n# Concepts\nPlease see [Common Concepts](https://developer.trimble.com/docs/connect#common-concepts) in the Connect Platform documentation.\n\n## Eventual Read Consistency\nWhen you read data from the service, the response might not reflect the results of the most recently completed write\noperations in other services. The response might include some stale data. If you repeat your read request after a short\ntime, the response should return the latest data.",
    "version": "1.0",
    "contact": {
      "name": "Trimble Connect Support",
      "url": "https://connect.trimble.com",
      "email": "connect-support@trimble.com"
    },
    "license": {
      "name": "Trimble Connect SDK Internal Use License",
      "url": "https://developer.trimble.com/docs/connect/terms/SDK-IU-license-agreement"
    },
    "termsOfService": "https://developer.trimble.com/docs/connect/terms",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Trimble-Connect/model-feature-api/1.0"
  },
  "servers": [
    {
      "url": "https://model-wf11.connect.trimble.com",
      "description": "US East (N. Virginia)"
    },
    {
      "url": "https://model-wf21.connect.trimble.com",
      "description": "Europe (Ireland)"
    },
    {
      "url": "https://model-wf31.connect.trimble.com",
      "description": "Asia Pacific (Singapore)"
    },
    {
      "url": "https://model-wf32.connect.trimble.com",
      "description": "Australia"
    }
  ],
  "tags": [
    {
      "name": "Manual Groups",
      "description": "Operations with manual groups."
    },
    {
      "name": "Miscellaneous",
      "description": "Miscellaneous operations."
    },
    {
      "name": "Rule-Based Groups",
      "description": "Operations with rule-based groups."
    }
  ],
  "paths": {
    "/projects/{projectId}/ruleBasedGroups": {
      "get": {
        "tags": [
          "Rule-Based Groups"
        ],
        "summary": "Get rule-based groups",
        "description": "Get list of rule-based groups associated with the Trimble Connect project. A single operation will read up to the maximum number of items set in the `pageSize` parameter. If the `next` link is present in the response, you will need to paginate the result set.\n",
        "operationId": "getRuleBasedGroups",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdPath"
          },
          {
            "$ref": "#/components/parameters/RuleBasedGroupFieldsQuery"
          },
          {
            "$ref": "#/components/parameters/DeletedQuery"
          },
          {
            "$ref": "#/components/parameters/PageSizeQuery"
          },
          {
            "$ref": "#/components/parameters/PageTokenQuery"
          }
        ],
        "security": [
          {
            "oauth2": [
              "tc-model-workflows"
            ]
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetRuleBasedGroupsResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          }
        }
      }
    },
    "/projects/{projectId}/ruleBasedGroups/{groupId}": {
      "get": {
        "tags": [
          "Rule-Based Groups"
        ],
        "summary": "Get rule-based group",
        "description": "Get a rule-based group for the given id.",
        "operationId": "getRuleBasedGroup",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdPath"
          },
          {
            "$ref": "#/components/parameters/GroupIdPath"
          },
          {
            "$ref": "#/components/parameters/RuleBasedGroupFieldsQuery"
          },
          {
            "$ref": "#/components/parameters/DeletedQuery"
          }
        ],
        "security": [
          {
            "oauth2": [
              "tc-model-workflows"
            ]
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetRuleBasedGroupResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          }
        }
      }
    },
    "/projects/{projectId}/ruleBasedGroups/{groupId}/subgroups": {
      "get": {
        "tags": [
          "Rule-Based Groups"
        ],
        "summary": "Get rule-based group subgroups",
        "operationId": "getRuleBasedSubgroups",
        "description": "List subgroups for the given rule-based group. A single operation will read up to the maximum number of items set in the `pageSize` parameter. If the `next` link is present in the response, you will need to paginate the result set.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdPath"
          },
          {
            "$ref": "#/components/parameters/GroupIdPath"
          },
          {
            "$ref": "#/components/parameters/SubgroupFieldsQuery"
          },
          {
            "$ref": "#/components/parameters/PageSizeQuery"
          },
          {
            "$ref": "#/components/parameters/PageTokenQuery"
          },
          {
            "$ref": "#/components/parameters/DeletedQuery"
          }
        ],
        "security": [
          {
            "oauth2": [
              "tc-model-workflows"
            ]
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetRuleBasedSubgroupsResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          }
        }
      }
    },
    "/projects/{projectId}/ruleBasedGroups/{groupId}/subgroups/{subgroupId}": {
      "get": {
        "tags": [
          "Rule-Based Groups"
        ],
        "summary": "Get rule-based group subgroup",
        "description": "Get a rule-based group subgroup for the given rule-based group and subgroup id.\n",
        "operationId": "getRuleBasedSubgroup",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectIdPath"
          },
          {
            "$ref": "#/components/parameters/GroupIdPath"
          },
          {
            "$ref": "#/components/parameters/SubgroupIdPath"
          },
          {
            "$ref": "#/components/parameters/SubgroupFieldsQuery"
          },
          {
            "$ref": "#/components/parameters/DeletedQuery"
          }
        ],
        "security": [
          {
            "oauth2": [
              "tc-model-workflows"
            ]
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetRuleBasedSubgroupResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          }
        }
      }
    },
