{
  "openapi": "3.0.0",
  "info": {
    "title": "Fundz API",
    "version": "v1",
    "description": "Access comprehensive financial data feeds including funding rounds, crowdfunding campaigns, company acquisitions, executive appointments, business agreements, and product launches. Perfect for investors, analysts, and market researchers.",
    "contact": {
      "name": "Fundz API Support",
      "url": "https://fundz.net/support"
    }
  },
  "servers": [
    {
      "url": "https://api.fundz.net",
      "description": "Production API server"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Your unique API key for authentication. Include this in the Authorization header of each request. Contact support if you need an API key."
      }
    }
  },
  "paths": {
    "/fundings": {
      "get": {
        "summary": "Retrieve funding rounds",
        "tags": [
          "Fundings"
        ],
        "description": "Retrieve a feed of funding rounds, including seed rounds, Series A-F, venture capital, and private equity investments. Use this endpoint to track investment activity, discover newly funded companies, and analyze funding trends across different industries and locations.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "created_from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by created date from (YYYY-MM-DD)",
            "required": false
          },
          {
            "name": "created_to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by created date to (YYYY-MM-DD)",
            "required": false
          },
          {
            "name": "money_raised_min",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Minimum money raised",
            "required": false
          },
          {
            "name": "money_raised_max",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Maximum money raised",
            "required": false
          },
          {
            "name": "number_of_employees_min",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Minimum number of employees",
            "required": false
          },
          {
            "name": "number_of_employees_max",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Maximum number of employees",
            "required": false
          },
          {
            "name": "keywords",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Keywords to search",
            "required": false
          },
          {
            "name": "series",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Funding series",
            "required": false
          },
          {
            "name": "offered_types",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Offered types",
            "required": false
          },
          {
            "name": "locations",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Locations titles and short_description filter",
            "required": false
          },
          {
            "name": "industries",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Industry titles filter",
            "required": false
          },
          {
            "name": "investors",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Investor titles filter",
            "required": false
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "fundings found",
