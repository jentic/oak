{
  "openapi": "3.0.3",
  "info": {
    "title": "Diffbot API",
    "version": "3.0.0",
    "description": "Diffbot provides AI-powered web data extraction APIs. Extract structured data from any web page using Analyze, Article, Product, Image, Video, Discussion, and other extraction APIs. Also includes Crawlbot for site-wide crawling and Search API for querying the Diffbot Knowledge Graph.",
    "x-jentic-source-url": "https://docs.diffbot.com/docs/getting-started-with-diffbot"
  },
  "servers": [
    {
      "url": "https://api.diffbot.com"
    }
  ],
  "tags": [
    {
      "name": "Extract",
      "description": "Automatic and specialized extraction APIs"
    },
    {
      "name": "Crawl",
      "description": "Crawlbot for site-wide crawling"
    },
    {
      "name": "Search",
      "description": "Knowledge Graph search"
    },
    {
      "name": "Enhance",
      "description": "Entity enrichment"
    },
    {
      "name": "Account",
      "description": "Account management"
    }
  ],
  "paths": {
    "/v3/analyze": {
      "get": {
        "operationId": "analyzeUrl",
        "summary": "Analyze a URL",
        "description": "Automatically classify a page and extract data according to its type (article, product, discussion, image, video, etc.).",
        "tags": [
          "Extract"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Developer token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Web page URL to process",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "description": "Timeout in ms",
            "schema": {
              "type": "integer",
              "default": 30000
            }
          },
          {
            "name": "callback",
            "in": "query",
            "required": false,
            "description": "JSONP callback",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxy",
            "in": "query",
            "required": false,
            "description": "Proxy URL",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxyAuth",
            "in": "query",
            "required": false,
            "description": "Proxy auth (user:pass)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "description": "Force extraction type",
            "schema": {
              "type": "string",
              "enum": [
                "article",
                "product",
                "image",
                "discussion",
                "video"
              ]
            }
          },
          {
            "name": "fallback",
            "in": "query",
            "required": false,
            "description": "Fallback extraction type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of fields to return",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
