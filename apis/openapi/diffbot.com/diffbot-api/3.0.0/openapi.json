          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "description": "Timeout in ms",
            "schema": {
              "type": "integer",
              "default": 30000
            }
          },
          {
            "name": "callback",
            "in": "query",
            "required": false,
            "description": "JSONP callback",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxy",
            "in": "query",
            "required": false,
            "description": "Proxy URL",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxyAuth",
            "in": "query",
            "required": false,
            "description": "Proxy auth (user:pass)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "paging",
            "in": "query",
            "required": false,
            "description": "Follow multi-page articles",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "maxTags",
            "in": "query",
            "required": false,
            "description": "Max number of tags to return",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "tagConfidence",
            "in": "query",
