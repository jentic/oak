{
  "openapi": "3.0.3",
  "info": {
    "title": "Ordnance Survey Data Hub APIs",
    "description": "UK mapping, geocoding, and address lookup APIs from Ordnance Survey. Includes OS Names API for geographic place name search, OS Places API for address verification, and OS Maps API for raster map tiles. Authentication via API key (header or query parameter) or OAuth2.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://osdatahub.os.uk/docs/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.os.uk"
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    }
  ],
  "paths": {
    "/search/names/v1/find": {
      "get": {
        "operationId": "namesFindByText",
        "summary": "Search for geographic place names by free text",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Free text search parameter",
            "schema": { "type": "string" }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format",
            "schema": { "type": "string", "enum": ["JSON", "XML"], "default": "JSON" }
          },
          {
            "name": "maxresults",
            "in": "query",
            "description": "Maximum number of results (1-100, default 100)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset the returned results list",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "bounds",
            "in": "query",
            "description": "Bias results to area (British National Grid: XMIN,YMIN,XMAX,YMAX)",
            "schema": { "type": "string" }
          },
          {
            "name": "fq",
            "in": "query",
            "description": "Filter by local_type (e.g. Airport, Hospital, Village, City, Postcode)",
            "schema": { "type": "string" }
          },
          {
            "name": "key",
            "in": "query",
            "description": "API key (alternative to header auth)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": {
                      "type": "object",
                      "properties": {
                        "uri": { "type": "string" },
                        "query": { "type": "string" },
                        "format": { "type": "string" },
                        "maxresults": { "type": "integer" },
                        "offset": { "type": "integer" },
                        "totalresults": { "type": "integer" }
                      }
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "GAZETTEER_ENTRY": {
                            "type": "object",
                            "properties": {
                              "ID": { "type": "string" },
                              "NAMES_URI": { "type": "string" },
                              "NAME1": { "type": "string" },
                              "TYPE": { "type": "string" },
                              "LOCAL_TYPE": { "type": "string" },
                              "GEOMETRY_X": { "type": "number" },
                              "GEOMETRY_Y": { "type": "number" },
                              "POSTCODE_DISTRICT": { "type": "string" },
                              "POPULATED_PLACE": { "type": "string" },
                              "COUNTY_UNITARY": { "type": "string" },
                              "REGION": { "type": "string" },
                              "COUNTRY": { "type": "string" },
                              "MBR_XMIN": { "type": "number" },
                              "MBR_YMIN": { "type": "number" },
                              "MBR_XMAX": { "type": "number" },
                              "MBR_YMAX": { "type": "number" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - invalid or missing API key" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/search/names/v1/nearest": {
      "get": {
        "operationId": "namesFindNearest",
        "summary": "Find nearest geographic place names to coordinates",
        "parameters": [
          {
            "name": "point",
            "in": "query",
            "required": true,
            "description": "British National Grid coordinates (X,Y)",
            "schema": { "type": "string", "example": "530000,180000" }
          },
          {
            "name": "radius",
            "in": "query",
            "description": "Search radius in metres (0.01-1000, default 100)",
            "schema": { "type": "number", "minimum": 0.01, "maximum": 1000, "default": 100 }
          },
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["JSON", "XML"], "default": "JSON" }
          },
          {
            "name": "fq",
            "in": "query",
            "description": "Filter by local_type",
            "schema": { "type": "string" }
          },
          {
            "name": "key",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Nearest place names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": { "type": "object" },
                    "results": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/search/places/v1/find": {
      "get": {
        "operationId": "placesFindByText",
        "summary": "Search for addresses by free text",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Free text search parameter",
            "schema": { "type": "string" }
          },
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["JSON", "XML"], "default": "JSON" }
          },
          {
            "name": "maxresults",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          },
          {
            "name": "dataset",
            "in": "query",
            "description": "Data source (DPA=Delivery Point Address, LPI=Local Property Identifier)",
            "schema": { "type": "string", "enum": ["DPA", "LPI"], "default": "DPA" }
          },
          {
            "name": "lr",
            "in": "query",
            "description": "Language preference",
            "schema": { "type": "string", "enum": ["EN", "CY"], "default": "EN" }
          },
          {
            "name": "minmatch",
            "in": "query",
            "description": "Minimum match score threshold (0.1-1.0)",
            "schema": { "type": "number", "minimum": 0.1, "maximum": 1.0 }
          },
          {
            "name": "matchprecision",
            "in": "query",
            "description": "Decimal precision for match scores (1-10)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 10 }
          },
          {
            "name": "output_srs",
            "in": "query",
            "description": "Output spatial reference system",
            "schema": { "type": "string", "enum": ["EPSG:27700", "WGS84", "EPSG:4326", "EPSG:3857", "EPSG:4258", "BNG"], "default": "EPSG:27700" }
          },
          {
            "name": "fq",
            "in": "query",
            "description": "Classification, status, and country code filters",
            "schema": { "type": "string" }
          },
          {
            "name": "key",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Address search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": {
                      "type": "object",
                      "properties": {
                        "uri": { "type": "string" },
                        "query": { "type": "string" },
                        "totalresults": { "type": "integer" },
                        "format": { "type": "string" },
                        "dataset": { "type": "string" },
                        "maxresults": { "type": "integer" },
                        "offset": { "type": "integer" }
                      }
                    },
                    "results": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/search/places/v1/postcode": {
      "get": {
        "operationId": "placesFindByPostcode",
        "summary": "Search for addresses by postcode",
        "parameters": [
          {
            "name": "postcode",
            "in": "query",
            "required": true,
            "description": "The postcode to search",
            "schema": { "type": "string", "example": "SW1A 1AA" }
          },
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["JSON", "XML"], "default": "JSON" }
          },
          {
            "name": "maxresults",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          },
          {
            "name": "dataset",
            "in": "query",
            "schema": { "type": "string", "enum": ["DPA", "LPI"], "default": "DPA" }
          },
          {
            "name": "lr",
            "in": "query",
            "schema": { "type": "string", "enum": ["EN", "CY"] }
          },
          {
            "name": "output_srs",
            "in": "query",
            "schema": { "type": "string", "enum": ["EPSG:27700", "WGS84", "EPSG:4326", "EPSG:3857", "EPSG:4258", "BNG"], "default": "EPSG:27700" }
          },
          {
            "name": "fq",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "key",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Addresses matching postcode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": { "type": "object" },
                    "results": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/search/places/v1/uprn": {
      "get": {
        "operationId": "placesFindByUprn",
        "summary": "Look up an address by its Unique Property Reference Number (UPRN)",
        "parameters": [
          {
            "name": "uprn",
            "in": "query",
            "required": true,
            "description": "Valid UPRN integer",
            "schema": { "type": "integer" }
          },
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["JSON", "XML"], "default": "JSON" }
          },
          {
            "name": "dataset",
            "in": "query",
            "schema": { "type": "string", "enum": ["DPA", "LPI"], "default": "DPA" }
          },
          {
            "name": "lr",
            "in": "query",
            "schema": { "type": "string", "enum": ["EN", "CY"] }
          },
          {
            "name": "output_srs",
            "in": "query",
            "schema": { "type": "string", "enum": ["EPSG:27700", "WGS84", "EPSG:4326", "EPSG:3857", "EPSG:4258", "BNG"], "default": "EPSG:27700" }
          },
          {
            "name": "fq",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "key",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Address for UPRN",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": { "type": "object" },
                    "results": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/maps/raster/v1/zxy/{layer}/{z}/{x}/{y}.png": {
      "get": {
        "operationId": "getMapTile",
        "summary": "Get a raster map tile by layer, zoom, and coordinates",
        "parameters": [
          {
            "name": "layer",
            "in": "path",
            "required": true,
            "description": "Map layer name",
            "schema": {
              "type": "string",
              "enum": ["Road_3857", "Outdoor_3857", "Light_3857", "Leisure_27700", "Road_27700", "Outdoor_27700", "Light_27700"]
            }
          },
          {
            "name": "z",
            "in": "path",
            "required": true,
            "description": "Zoom level",
            "schema": { "type": "integer" }
          },
          {
            "name": "x",
            "in": "path",
            "required": true,
            "description": "Tile column",
            "schema": { "type": "integer" }
          },
          {
            "name": "y",
            "in": "path",
            "required": true,
            "description": "Tile row",
            "schema": { "type": "integer" }
          },
          {
            "name": "key",
            "in": "query",
            "required": true,
            "description": "API key",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG map tile",
            "content": {
              "image/png": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "key",
        "in": "header",
        "description": "Ordnance Survey API key passed via HTTP header"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "key",
        "in": "query",
        "description": "Ordnance Survey API key passed via query parameter"
      }
    }
  }
}
