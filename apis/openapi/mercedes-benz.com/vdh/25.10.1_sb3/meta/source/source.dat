          }
        },
        "description": "Links of a Dealer."
      },
      "Media": {
        "type": "object",
        "properties": {
          "mediaItem": {
            "type": "array",
            "description": "List of media items.",
            "items": {
              "$ref": "#/components/schemas/MediaItem"
