              "$ref": "#/components/schemas/CodeText"
            }
          },
          "dealerHierarchy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DealerHierarchy"
            }
          }
        },
        "description": "Central vehicle structure. It is possible to cover the handling for all types of vehicles (new, used, passenger cars, vans, trucks...) with this object."
      },
