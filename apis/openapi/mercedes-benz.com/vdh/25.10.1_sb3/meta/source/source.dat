        "summary": "Read a vehicle from VDH with all available attributes and texts.",
        "operationId": "ReadVehicle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadVehicleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
