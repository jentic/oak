      "VehicleIdentification": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "integer",
            "description": "Numeric Mercedes-Benz branch code (0 = passenger cars, 1 = truck, 5 = transporters < 2.8t, 6 = SUVs, 7 = transporter 2.8t - 4.6t, 8 = transporter > 4.6t)",
            "format": "int32",
            "example": 0,
            "enum": [
              0,
              1,
              5,
              6,
              7,
              8
            ]
          },
          "changeYearCode": {
            "type": "string",
            "description": "Change Year code of a vehicle, it is composed of 3 alphanumeric characters.",
            "example": "051"
          },
          "fin": {
            "type": "string",
            "description": "The European Vehicle Identification Number (FIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one FIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDD2221621A511933"
          },
          "finAttributes": {
            "$ref": "#/components/schemas/FinAttributes"
          },
          "manufacturerGroupCode": {
            "type": "string",
            "description": "Manufacturer group code (0M = Mercedes Benz, 0S = Smart, 6M, 5M, 7M, 8M).",
            "example": "0M",
            "enum": [
              "0M",
              "0S",
              "6M",
              "5M",
              "7M",
              "8M"
            ]
          },
          "modelYearCode": {
            "type": "string",
            "description": "Model Year code of a vehicle, it is composed of 3 alphanumeric characters.",
            "example": "XZ1"
          },
          "nst": {
            "type": "string",
            "description": "National sales type of a vehicle, it is composed of 3 alphanumeric characters.",
            "example": "001"
          },
          "vehicleCategory": {
            "type": "string",
            "description": "Vehicle category of a vehicle.",
            "example": "PASSENGER",
            "enum": [
              "PASSENGER",
              "VAN_PRIVATE",
              "VAN_COMMERCIAL",
              "TRUCK",
              "BUS",
              "TRAILER"
            ]
          },
          "vin": {
            "type": "string",
            "description": "The Vehicle Identification Number (VIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one VIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDDUG6CB5LA511933"
          },
          "vehicleId": {
            "type": "integer",
            "description": "Unique numeric id generated by VDH for each used vehicle. Not available for new vehicles.",
            "format": "int64",
            "example": 324787
          },
          "vehicleTransactionId": {
            "type": "string",
            "description": "Unique transaction id generated when adding a vehicle to VDH. The transaction id is consistent throughout the whole sales process of a vehicle.",
            "example": "x3332343738373231323030323241363430303234"
          },
          "takeInAt": {
            "type": "string",
            "description": "Timestamp when the vehicle was taken into VDH.",
            "format": "date-time",
            "example": "2012-09-14T00:00:00+02:00"
          }
        },
        "description": "Vehicle identification attributes of a vehicle."
      },
      "VehicleLengthGroupCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "text"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "code"
          }
        },
        "description": "For vans only: Code of the length group."
      },
      "VehicleMarketCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Germany"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "000"
          }
        },
        "description": "The market to which the vehicle is allocated at the moment.",
        "example": {
          "code": "000",
          "text": "Germany"
        }
      },
      "VehicleMetaData": {
        "type": "object",
        "properties": {
          "technicalId": {
            "type": "string",
            "description": "Unique technical id of a vehicle generated by VDH.",
            "example": "7df72cef1a41680c737e4c482a590a68a5dc7a35"
          },
          "referenceId": {
            "type": "string",
            "description": "Unique reference id. All language variations for the same vehicle instance have the same reference Id.",
            "example": "02ea5c4dd179efd91fcfd36d5b34637b"
          },
          "sourceSystem": {
            "type": "string",
            "description": "Source application from where a vehicle is originated.",
            "example": "UVS"
          },
          "changedAt": {
            "type": "string",
            "description": "Timestamp containing last update time information.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          }
        },
        "description": "General vehicle specific meta information."
      },
      "VehicleStatus": {
        "type": "object",
        "properties": {
          "approvingOutletVBET": {
            "type": "string",
            "description": "VBET of the outlet who is approving the vehicle sales transaction.",
            "example": "51301046"
          },
          "availability": {
            "type": "string",
            "description": "Availability of a vehicle.",
            "example": "FREE_ALL",
            "enum": [
              "NONE",
              "FREE_ALL",
              "FREE_OWN",
              "FREE_AFTER_CONSULTATION"
            ]
          },
          "visibility": {
            "type": "string",
            "description": "Visibility of a vehicle. It can be set to INTERNET. Do not automatically affect the search results.",
            "example": "Example"
          },
          "identifier": {
            "type": "string",
            "description": "Unique identifier for a reservation / order, usually the lead number of the DMS."
          },
          "marketingArea": {
            "type": "string",
            "description": "Marketing area, such as Branc, Group, Super-GRoup, intramarket, crossmarket, etc.",
            "example": "Super-Group"
          },
          "outletId": {
            "type": "string",
            "description": "The Mercedes-Benz GSSN+ outletId (GS number) of the dealer that reserved / ordered / sold a vehicle. The Mercedes-Benz GSSN+ outletid is composed of two letters (GS) and a seven digits number.",
            "example": "GS0010844"
          },
          "orderingStatus": {
            "type": "string",
            "description": "Status of a vehicle order."
          },
          "reservingOutletVBET": {
            "type": "string",
            "description": "VBET of the outlet who is approving the vehicle reservation transaction. The VBET (Vertriebseinheit) describes a market-specific unit for the distribution of the vehicles. Each market can decide how these units are created/organized."
          },
          "salesMarketingResponsible": {
            "type": "string",
            "description": "Dealer responsible for the sales marketing of a vehicle.",
            "example": "GS0000170"
          },
          "soldToCostumerType": {
            "type": "string",
            "example": "3"
          },
          "status": {
            "$ref": "#/components/schemas/VehicleStatusStatusCodeText"
          },
          "vehicleVersion": {
            "type": "integer",
            "format": "int32"
          },
          "invoiceToDealerDate": {
            "type": "string",
            "format": "date-time"
          },
          "orderDate": {
            "type": "string",
            "description": "Date on which a vehicle was ordered.",
            "format": "date-time",
            "example": "2020-08-07T01:00:00+02:01"
          },
          "reservingPerson": {
            "$ref": "#/components/schemas/DealerContact"
          },
          "reservationEndTime": {
            "type": "string",
            "description": "Timestamp when a vehicle's reservation ends.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "reservationStartTime": {
            "type": "string",
            "description": "Timestamp when a vehicle's was reserved.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "salesDate": {
            "type": "string",
            "description": "Sales date of a sold vehicle.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "specificationDate": {
            "type": "string",
            "description": "Relevant day for production, with which the exact model year and year of change can be determined.",
            "format": "date-time",
            "example": "2020-09-27T01:00:00+02:00"
          }
        },
        "description": "Vehicle status related information."
      },
      "VehicleStatusStatusCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Bestand"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "N"
          }
        },
        "description": "Actual status of a vehicle. See the VDH state machine to understand the possible status and status transitions.",
        "example": {
          "code": "N",
          "text": "Bestand"
        },
        "enum": [
          "D",
          "I",
          "N",
          "O",
          "C",
          "W",
          "R",
          "Y",
          "V",
          "Z",
          "X",
          "S"
        ]
      },
      "VehicleSuspensionCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Pneumatic suspension"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "L"
          }
        },
        "description": "Code and text of the suspension type.",
        "example": {
          "code": "L",
          "text": "Pneumatic suspension"
        }
      },
      "VehicleValidationResult": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "vehicleValidationResults": {
            "$ref": "#/components/schemas/VehicleValidationResults"
          }
        },
        "description": "Structure for vehicle validation results. Contains the status information and optional the vehicle itself."
      },
      "VehicleValidationResults": {
        "type": "object",
        "properties": {
          "vehicleResult": {
            "type": "array",
            "description": "List of vehicle's related validation results.",
            "items": {
              "$ref": "#/components/schemas/ValidationRuleResult"
            }
          }
        },
        "description": "Vehicle validation results."
      },
      "Warranty": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Code of the warranty of a vehicle.",
            "example": "M"
          },
          "duration": {
            "type": "integer",
            "description": "Duration of the warranty in months.",
            "format": "int32",
            "example": 17
          },
          "text": {
            "type": "string",
            "description": "Textual description of the warranty of the vehicle.",
            "example": "Mercedes-Benz european warranty"
          }
        },
        "description": "Information about the warranty of a vehicle."
      },
      "WeightData": {
        "type": "object",
        "properties": {
          "gross": {
            "type": "integer",
            "description": "Gross weight. Equals the kerb weight plus the payload.",
            "format": "int32",
            "example": 3100
          },
          "kerb": {
            "type": "integer",
            "description": "Kerb weight.",
            "format": "int32",
            "example": 2077
          },
          "payload": {
            "type": "integer",
            "description": "Permitted payload.",
            "format": "int32",
            "example": 1023
          },
          "vehicleMassKg": {
            "type": "integer",
            "description": "Vehicle mass.",
            "format": "int32",
            "example": 2152
          }
        },
        "description": "Technical data for the vehicle's weight."
      },
      "roofHeight": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "1"
          }
        },
        "description": "roofHeight",
        "example": {
          "code": "1",
          "text": ""
        }
      },
      "BasicTechnicalData": {
        "type": "object",
        "properties": {
          "acceleration": {
            "type": "number",
            "description": "Acceleration from 0 to 100 kilometers per hour (in seconds).",
            "example": 6.5
          },
          "allwheelFlag": {
            "type": "string",
            "description": "Flag indicating if a vehicle has an all-wheel drive.",
            "example": "NO",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "dragCoefficient": {
            "type": "number",
            "description": "The drag coefficient describes the aerodynamics of a vehicle.",
            "example": 0.2
          },
          "emissionDirective": {
            "type": "string",
            "description": "Directive of the emission test.",
            "example": "715/2007*2018/1832DG"
          },
          "emissionStandard": {
            "$ref": "#/components/schemas/TechnicalDataEmissionStandardCodeText"
          },
          "emiCo": {
            "$ref": "#/components/schemas/EmiCo"
          },
          "energyEfficiencyClass": {
            "type": "string",
            "description": "Energy efficiency classification.",
            "example": "A",
            "enum": [
              "Aplus",
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G"
            ]
          },
          "enginePrimary": {
            "$ref": "#/components/schemas/EngineData"
          },
          "engineSecondary": {
            "$ref": "#/components/schemas/EngineData"
          },
          "fineParticle": {
            "type": "string",
            "description": "Fine particle plate of the vehicle (e.g. green, red, yellow)",
            "example": "green"
          },
          "numberOfDoors": {
            "type": "integer",
            "description": "Number of doors.",
            "format": "int32",
            "example": 5
          },
          "numberOfGears": {
            "type": "integer",
            "description": "Number of gears.",
            "format": "int32",
            "example": 6
          },
          "numberOfSeats": {
            "type": "integer",
            "description": "Number of seats.",
            "format": "int32",
            "example": 7
          },
          "steering": {
            "$ref": "#/components/schemas/TechnicalDataSteeringCodeText"
          },
          "topSpeed": {
            "type": "integer",
            "description": "Top speed in kilometers per hour.",
            "format": "int32",
            "example": 250
          },
          "weightData": {
            "$ref": "#/components/schemas/WeightData"
          },
          "wheelbase": {
            "type": "integer",
            "description": "Wheelbase in millimeters.",
            "format": "int32",
            "example": 3200
          },
          "axisLoad": {
            "type": "array",
            "description": "Axis load attributes of a vehicle.",
            "items": {
              "$ref": "#/components/schemas/AxisLoad"
            }
          }
        },
        "description": "Basic technical data of a vehicle."
      },
      "MetaData": {
        "type": "object",
        "properties": {
          "sourceSystem": {
            "type": "string",
            "description": "The source system that is triggering the save request.",
            "example": "AUTOLINE"
          }
        },
        "description": "Optional meta data for the save vehicle request."
      },
      "SaveSlimVehicleRequest": {
        "required": [
          "config"
        ],
        "type": "object",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/RequestConfig"
          },
          "metaData": {
            "$ref": "#/components/schemas/MetaData"
          },
          "takeInVehicles": {
            "type": "array",
            "description": "List of one or more vehicles to be saved.",
            "items": {
              "$ref": "#/components/schemas/TakeInVehicle"
            }
          }
        },
        "description": "Request to call the slim save vehicle business logic. This logic saves a vehicle in VDH but needs only a small number of input parameter for saving a vehicle in VDH.",
        "xml": {
          "name": "SaveSlimVehicleRequest",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.save.v2"
        }
      },
      "TakeInVehicle": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "description": "Locale, used to identify a language and market (country). Composed by a combination of the ISO639-1 format for the language and the ISO 3166-1 Alpha-2 format for the country code separated by an underscore. &lt;Language Code in lowercase&gt;_&lt;Country Code in uppercase&gt;."
          },
          "vehicleMetaData": {
            "$ref": "#/components/schemas/VehicleMetaData"
          },
          "bodyManufacturer": {
            "$ref": "#/components/schemas/VehicleBodyManufacturerCodeText"
          },
          "bodyMass": {
            "$ref": "#/components/schemas/BodyMass"
          },
          "cabin": {
            "$ref": "#/components/schemas/VehicleCabinCodeText"
          },
          "consignment": {
            "$ref": "#/components/schemas/Consignment"
          },
          "distributionType": {
            "type": "string",
            "description": "Indicates if a vehicle should be offered to private customers (B2C) or other dealers (B2B).",
            "example": "PRIVATE",
            "enum": [
              "PRIVATE",
              "BUSINESS"
            ]
          },
          "extendedFactoryWarranty": {
            "type": "string",
            "description": "Specifies if a vehicle has an extended factory warranty by the manufacturer."
          },
          "extendedFactoryWarrantyEndDate": {
            "type": "string",
            "description": "End date of the extended factory warranty.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "taxAttributes": {
            "$ref": "#/components/schemas/TaxAttributes"
          },
          "foreignBrandId": {
            "type": "string",
            "description": "DEPRECATED - Foreign brand code provided by DAT. Only for non-Mercedes-Benz vehicles.",
            "example": "BMW"
          },
          "lengthGroup": {
            "$ref": "#/components/schemas/VehicleLengthGroupCodeText"
          },
          "market": {
            "$ref": "#/components/schemas/VehicleMarketCodeText"
          },
          "modelYear": {
            "type": "integer",
            "description": "Vehicle's model year (YYYY).",
            "format": "int32",
            "example": 2022
          },
          "priceInformation": {
            "$ref": "#/components/schemas/PriceInformation"
          },
          "salesClassBodyGroup": {
            "type": "string",
            "example": "2"
          },
          "salesLevel": {
            "type": "string",
            "description": "Sales level according to the owner of the vehicle, e.g. is this vehicle distributed/owned by Mercedes-Benz AG (wholesale level) or by a dealer (retail level).",
            "example": "RETAIL",
            "enum": [
              "WHOLESALE",
              "RETAIL"
            ]
          },
          "selectiveGoodsFlag": {
            "type": "string",
            "description": "Flag indicating if a vehicle belongs to the group of vehicles which are marked as selective goods.",
            "example": "NO",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "stockNumber": {
            "type": "string",
            "description": "The DMS (Dealer Management System) stock number.",
            "example": "06216G0841"
          },
          "suspension": {
            "$ref": "#/components/schemas/VehicleSuspensionCodeText"
          },
          "tradeInPlannedFlag": {
            "type": "string",
            "description": "Flag indicating if a vehicle is currently not in the physical stock of a dealer.",
            "example": "NO",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "typeKey": {
            "$ref": "#/components/schemas/TypeKey"
          },
          "ucNumber": {
            "type": "string",
            "description": "Vehicle's used car number.",
            "example": "10266G0275"
          },
          "ucNumberTrailer": {
            "type": "string",
            "description": "Vehicle trailer's used car number.",
            "example": "10266D5235"
          },
          "usedVehicleData": {
            "$ref": "#/components/schemas/UsedVehicleData"
          },
          "vehicleData": {
            "$ref": "#/components/schemas/VehicleData"
          },
          "vehicleIdentification": {
            "$ref": "#/components/schemas/VehicleIdentification"
          },
          "vehicleLocation": {
            "$ref": "#/components/schemas/Dealer"
          },
          "vehicleOwner": {
            "$ref": "#/components/schemas/Dealer"
          },
          "vehicleStatus": {
            "$ref": "#/components/schemas/VehicleStatus"
          },
          "vehicleType": {
            "type": "string",
            "description": "Indicates if a vehicle is new or used.",
            "example": "USED",
            "enum": [
              "NEW",
              "USED"
            ]
          },
          "warranty": {
            "$ref": "#/components/schemas/Warranty"
          },
          "wheelform": {
            "type": "string",
            "description": "Form/type of wheels.",
            "example": "4x2"
          },
          "onlineSalesFlag": {
            "type": "string",
            "description": "Flag indicating if a vehicle is online-sales capable.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "technicalData": {
            "$ref": "#/components/schemas/BasicTechnicalData"
          },
          "brand": {
            "$ref": "#/components/schemas/TakeInVehicleBrandCodeText"
          },
          "salesProgram": {
            "type": "array",
            "description": "List of sales programs.",
            "items": {
              "$ref": "#/components/schemas/SalesProgram"
            }
          },
          "prominentFeature": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TextWithLocale"
            }
          },
          "marketplaceId": {
            "type": "array",
            "description": "Marketplace Id. Marketplaces are a sub-domain of the vehicle supply. They represent external platforms that show vehicle data for sales such as Autoscout, mobile.de or internal Marketplaces like MBC POS or EMB. Marketplaces are used to mark vehicles as relevant to be published on this platforms.",
            "example": [
              {
                "code": "MP1",
                "text": ""
              }
            ],
            "items": {
              "$ref": "#/components/schemas/CodeText"
            }
          },
          "teaser": {
            "type": "array",
            "description": "Teasers are used for marketing campaign to provide more URLs to further marketing teasers.",
            "items": {
              "$ref": "#/components/schemas/TextWithLocale"
            }
          },
          "marketingAttribute": {
            "type": "array",
            "description": "Marketing attribute of a vehicle.",
            "example": [
              {
                "code": "M01",
                "text": ""
              }
            ],
            "items": {
              "$ref": "#/components/schemas/CodeText"
            }
          },
          "individualEquipment": {
            "type": "array",
            "description": "List of specific individual non-factory equipments like dealer options.",
            "items": {
              "$ref": "#/components/schemas/IndividualEquipment"
            }
          }
        },
        "description": " This is the dedicated structure for saving a vehicle in VDH (take-in of a vehicle). This includes all types of vehicles (new, used) and different types of vehicle (passenger cars, vans)  with this object."
      },
      "TakeInVehicleBrandCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Mercedes-Benz"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "095"
          }
        },
        "description": "The 3-digits brand code and the official name of the manufacturer of a vehicle.",
        "example": {
          "code": "095",
          "text": "Mercedes-Benz"
        }
      },
      "SaveVehicleResponse": {
        "required": [
          "responseStatus"
        ],
        "type": "object",
        "properties": {
          "responseStatus": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "validationResults": {
            "type": "array",
            "description": "List of validation results for the provided non-vehicle request data.",
            "items": {
              "$ref": "#/components/schemas/ValidationRuleResult"
            }
          },
          "saveVehicleResults": {
            "type": "array",
            "description": "List of validation results for the provided vehicle data.",
            "items": {
              "$ref": "#/components/schemas/VehicleValidationResult"
            }
          }
        },
        "description": "Response to the call of the save vehicle business logic.",
        "xml": {
          "name": "SaveVehicleResponse",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.save.v1"
        }
      },
      "SaveVehicleRequest": {
        "required": [
          "config"
        ],
        "type": "object",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/RequestConfig"
          },
          "metaData": {
            "$ref": "#/components/schemas/MetaData"
          },
          "vehicles": {
            "type": "array",
            "description": "List of one or more vehicles to be saved.",
            "items": {
              "$ref": "#/components/schemas/Vehicle"
            }
          },
          "returnVehiclesFlag": {
            "type": "string",
            "description": "(not used) Flag indicating if the saved vehicles should be returned in the response.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          }
        },
        "description": "Request to call the save vehicle business logic.",
        "xml": {
          "name": "SaveVehicleRequest",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.save.v1"
        }
      },
      "ReadVehicleResponse": {
        "type": "object",
        "properties": {
          "responseStatus": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "searchSummary": {
            "$ref": "#/components/schemas/SearchSummary"
          },
          "vehicles": {
            "type": "array",
            "description": "List of returned vehicles.",
            "items": {
              "$ref": "#/components/schemas/Vehicle"
            }
          }
        },
        "description": "Response of the read vehicle service/business logic.",
        "xml": {
          "name": "ReadVehicleResponse",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.read.v1"
        }
      },
      "SearchSummary": {
        "type": "object",
        "properties": {
          "pageIndex": {
            "type": "integer",
            "description": "Index of the page, if working with paging. Index starts with 0",
            "format": "int32",
            "example": 0
          },
          "quantity": {
            "type": "integer",
            "description": "The desired quantity of results per page. An example value of 20 will deliver 20 vehicles per page.",
            "format": "int64",
            "example": 20
          },
          "totalQuantity": {
            "type": "integer",
            "description": "The desired total quantity of results. Default is 25.",
            "format": "int64",
            "example": 25
          },
          "scrollId": {
            "type": "string",
            "description": "Scroll id generated by VDH if scrolling is used. The scroll id will be generated by VDH and can be used in the next request to scroll forward through the results. This is only required by batch interfaces."
          },
          "uid": {
            "type": "string",
            "description": "Unique id of a search. Each new search generates a new uid. An already generated uid can also be requested."
          }
        },
        "description": "Summary information of the search result."
      },
      "Paging": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "description": "For search type SEARCH_DELTA only: Desired offset, if working with paging. 0 if no offset is required.",
            "example": 0
          },
          "pageIndex": {
            "type": "integer",
            "description": "For search type SEARCH_DELTA only: Index of the page, if working with paging. Index starts with 0",
            "example": 0
          },
          "quantity": {
            "type": "integer",
            "description": "The desired quantity of results per page. An example value of 20, delivers 20 vehicles per page. Please note there's a configured limit that cannot be exceeded.",
            "example": 20
          },
          "scrollId": {
            "type": "string",
            "description": "For search types SEARCH_ARCHIVE/SEARCH_FULL/SEARCH_DELTA only: A scroll id generated by VDH, if scrolling is used. The scroll id will be generated by VDH and can be used in the next request to scroll forward through the results."
          },
          "totalQuantity": {
            "type": "integer",
            "description": "The desired total quantity of results. Default is 25. Please note there's a configured limit that cannot be exceeded.",
            "example": 100
          }
        },
        "description": "Pagination attributes (paging for detail search, scrolling for archive/full/delta search).\n\nFor paging either pageIndex OR offset is expected. If pageIndex is provided (not null/not empty), the offset will be calculated (offset = pageIndex * quantity) - otherwise the given offset will be considered for shifting the search result list.\n\nScrolling applies for archive/full/delta search hence the scrollId is relevant for these search types only. The initial call should not provide a scrollId in the request. Every subsequent call, to retrieve the residual vehicles, should contain the scrollId from the last VDH response."
      },
      "ReadVehicleRequest": {
        "required": [
          "vehicles"
        ],
        "type": "object",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/RequestConfig"
          },
          "outletId": {
            "type": "string",
            "description": "GSSN outlet id of the dealer owning the vehicles that should be read. The Mercedes-Benz's GSSN+ outletId (GS number) of a dealer is composed of two letters (GS) and a seven digits number."
          },
          "paging": {
            "$ref": "#/components/schemas/Paging"
          },
          "vehicles": {
            "type": "array",
            "description": "List of the vehicle identifiers that the caller request to read. Only one identifier is required.",
            "items": {
              "$ref": "#/components/schemas/VehicleIds"
            }
          }
        },
        "description": "Request to call the read vehicle business logic. Retrieve vehicle's information from the FIN or outletId of the caller. If FINs are provided, the service will try to fetch the respective vehicles, if no FINs are provided the service will fetch the vehicles owned by the requesting dealer. Only vehicles that are owned by the requesting dealer can be read.",
        "xml": {
          "name": "ReadVehicleRequest",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.read.v1"
        }
      },
      "VehicleIds": {
        "type": "object",
        "properties": {
          "dmsStockNumber": {
            "type": "string",
            "description": "The Dealer Management System (DMS) stocknumber of the vehicle.",
            "example": "17844"
          },
          "fin": {
            "type": "string",
            "description": "The European Vehicle Identification Number (FIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one FIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDD2221621A511933"
          },
          "licensePlateNumber": {
            "type": "string",
            "description": "The vehicle license plate number.",
            "example": "MKK-YS820"
          },
          "ucNumber": {
            "type": "string",
            "description": "The Used-Car-Number of the vehicle. Only available for used vehicles and it is the same like dmsStockNumber.",
            "example": "17844"
          },
          "vin": {
            "type": "string",
            "description": "The Vehicle Identification Number (VIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one VIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDDUG6CB5LA511933"
          }
        },
        "description": "Vehicle identification data."
      },
      "ReadVehicleStatusResponse": {
        "type": "object",
        "properties": {
          "responseStatus": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "status": {
            "type": "string",
            "description": "The status of the vehicle: C=Order Confirmed, I=Inactive, N=Active, O=Order started, R=Reserved, V=Sold",
            "example": "N",
            "enum": [
              "C",
              "I",
              "N",
              "O",
              "R",
              "V"
            ]
          },
          "statusText": {
            "type": "string",
            "description": "A textual description of the status of the vehicle",
            "example": "stock"
          }
        },
        "description": "Response of the read vehicle status service/business logic.",
        "xml": {
          "name": "ReadVehicleStatusResponse",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.status.read.v1"
        }
      },
      "ReadVehicleStatusRequest": {
        "required": [
          "fin"
        ],
        "type": "object",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/RequestConfig"
          },
          "fin": {
            "type": "string",
            "description": "The European Vehicle Identification Number (FIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one FIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDD2221621A511933",
            "enum": [
              "range[-infinity, 17]"
            ]
          }
        },
        "description": "Request to call the read vehicle status business logic. Read the vehicle status from the stock database by providing a FIN.",
        "xml": {
          "name": "ReadVehicleStatusRequest",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.status.read.v1"
        }
      },
      "BulkAssignMarketplaceResponse": {
        "type": "object",
        "properties": {
          "responseStatus": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "vehicleIdentifications": {
            "type": "array",
            "description": "List of affected vehicle identifications.",
            "items": {
              "$ref": "#/components/schemas/VehicleIds"
            }
          },
          "outletId": {
            "type": "string",
            "description": "OutletId of the caller. The Mercedes-Benz's GSSN+ outletId (GS number) of a dealer is composed of two letters (GS) and a seven digits number.",
            "example": "GS0025995"
          },
          "sourceMarketplaceCode": {
            "type": "string",
            "description": "Code of the source marketplace from where the vehicles were removed.",
            "example": "onlineSales"
          },
          "targetMarketplaceCode": {
            "type": "string",
            "description": "Code of the target marketplace to where all vehicles have been assigned.",
            "example": "m_01"
          }
        },
        "description": "Response for assigning all the vehicles of a given outlet id to another marketplace.",
        "xml": {
          "name": "BulkAssignMarketplaceResponse",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.bulkMarketplace.v1"
        }
      },
      "BulkAssignMarketplaceRequest": {
        "type": "object",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/RequestConfig"
          },
          "outletId": {
            "type": "string",
            "description": "OutletId of the caller. The Mercedes-Benz's GSSN+ outletId (GS number) of a dealer is composed of two letters (GS) and a seven digits number.",
            "example": "GS0025995"
          },
          "simulationModeFlag": {
            "type": "string",
            "description": "Flag indicating if the simulation mode is enabled, this will only trigger a dry-run for e.g. checking affected vehicles without really changing anything. It can be used to determine what vehicles are on a marketplace or would be affected by a reassignment.",
            "example": "NO",
            "default": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "sourceMarketplaceCode": {
            "type": "string",
            "description": "Code of the source marketplace from where the vehicles should be removed. If left empty, all vehicles of the retailer (specified in outletId) will be assigned to the marketplace specified by targetMarketplaceCode.",
            "example": "onlineSales"
          },
          "targetMarketplaceCode": {
            "type": "string",
            "description": "Code of the target marketplace to which all the vehicles have to be assigned. If left empty, the currently assigned marketplace code will be removed.",
            "example": "m_01"
          }
        },
        "description": "Request to call the bulk assign marketplace business logic. It will re-assign all the vehicles of a given outlet id to another marketplace.",
        "xml": {
          "name": "BulkAssignMarketplaceRequest",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.bulkMarketplace.v1"
        }
      },
      "ServiceHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Status of the service. <br /> UP: indicating that the component or subsystem is functioning as expected. <br /> DOWN: indicating that the component or subsystem has suffered an unexpected failure. <br /> UNKNOWN: indicating that the component or subsystem is in an unknown state. <br /> OUT_OF_SERVICE: indicating that the component or subsystem has been taken out of service and should not be used.",
            "example": "UP",
            "enum": [
              "UP",
              "DOWN",
              "UNKNOWN",
              "OUT_OF_SERVICE"
            ]
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "description": "details of health, dynamic in content, in proper json structure",
              "example": {
                "vdh-vehicle-information": "Hello Consumer, I am a static message.",
                "...": "more details."
              }
            },
            "description": "details of health, dynamic in content, in proper json structure",
            "example": {
              "vdh-vehicle-information": "Hello Consumer, I am a static message.",
              "...": "more details."
            }
          }
        },
        "description": "health of service"
      }
    },
    "securitySchemes": {
      "VSE_OAUTH": {
        "type": "oauth2",
        "description": "application flow on oneAPI",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://sso-int.mercedes-benz.com/as/token.oauth2",
            "scopes": {}
          }
        }
      }
    }
  }
}