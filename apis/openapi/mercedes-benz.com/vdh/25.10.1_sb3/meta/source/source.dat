            }
          },
          "saveVehicleResults": {
            "type": "array",
            "description": "List of validation results for the provided vehicle data.",
            "items": {
              "$ref": "#/components/schemas/VehicleValidationResult"
            }
          }
        },
        "description": "Response to the call of the slim save vehicle business logic.",
        "xml": {
          "name": "SaveSlimVehicleResponse",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.save.v2"
        }
      },
      "SftpAttributes": {
        "type": "object",
        "properties": {
          "sftpModelRange": {
            "$ref": "#/components/schemas/SftpAttributesSftpModelRangeCodeText"
          },
          "sftpProductGroup": {
            "$ref": "#/components/schemas/SftpAttributesSftpProductGroupCodeText"
          },
          "sftpSubCategory": {
            "$ref": "#/components/schemas/SftpAttributesSftpSubCategoryCodeText"
          },
          "sftpTypeOfApplication": {
            "$ref": "#/components/schemas/SftpAttributesSftpTypeOfApplicationCodeText"
          },
          "sftpVehicleType": {
            "$ref": "#/components/schemas/SftpAttributesSftpVehicleTypeCodeText"
          }
        },
        "description": "SFTP (Strategic Future Truck Platform) attributes of a truck. Truck data will no longer be supported by the Vehicle Data Hub (VDH) in the near future."
      },
      "SftpAttributesSftpModelRangeCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Actros"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "V1A"
          }
        },
        "description": "Model range of a truck (SFTP). Truck data will no longer be supported by the Vehicle Data Hub (VDH) in the near future.",
        "example": {
          "code": "V1A",
          "text": "Actros"
        }
      },
      "SftpAttributesSftpProductGroupCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Standard"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "V1W"
          }
        },
        "description": "Product group of a truck (SFTP). Truck data will no longer be supported by the Vehicle Data Hub (VDH) in the near future.",
        "example": {
          "code": "V1W",
          "text": "Standard"
        }
      },
      "SftpAttributesSftpSubCategoryCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "24A Actros 4 SZM oMT"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "24A"
          }
        },
        "description": "Sub-category of a truck (SFTP). Truck data will no longer be supported by the Vehicle Data Hub (VDH) in the near future.",
        "example": {
          "code": "24A",
          "text": "24A Actros 4 SZM oMT"
        }
      },
      "SftpAttributesSftpTypeOfApplicationCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Heavy-duty vehicles from 18 t, on-road"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "I6N"
          }
        },
        "description": "Application type / purpose of a truck (SFTP). Truck data will no longer be supported by the Vehicle Data Hub (VDH) in the near future.",
        "example": {
          "code": "I6N",
          "text": "Heavy-duty vehicles from 18 t, on-road"
        }
      },
      "SftpAttributesSftpVehicleTypeCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "text"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "code"
          }
        },
        "description": "Vehicle type of a truck (SFTP). Truck data will no longer be supported by the Vehicle Data Hub (VDH) in the near future."
      },
      "TaxAttributes": {
        "type": "object",
        "properties": {
          "fiscalPower": {
            "type": "integer",
            "description": "The fiscal power as calculated by the application TSCS. TSCS uses technical values (emission, powerKW) to calculate tax attributes in VDH.",
            "format": "int32",
            "example": 6
          }
        },
        "description": "Specific tax data, only for the market France."
      },
      "TaxInformation": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Raw tax amount, expressed in the same currency as the vehicle's price.",
            "example": 2720.34
          },
          "baseAmount": {
            "type": "number",
            "description": "The amount that acts as base for the tax calculation, expressed in the same currency as the vehicle's price.",
            "example": 14760
          },
          "rate": {
            "type": "number",
            "description": "Tax rate in percentage.",
            "example": 20
          },
          "type": {
            "type": "string",
            "description": "Type of the tax. For example VAT, DVAT, BPMN",
            "example": "VAT"
          }
        },
        "description": "Element describing extra taxes available for stock cars in specific countries."
      },
      "TaxInformations": {
        "type": "object",
        "properties": {
          "taxInformation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxInformation"
            }
          }
        },
        "description": "List of additional taxes applied to a vehicle, e.g. VAT, BPM for Netherlands, NOVA for Austria, ..."
      },
      "TechnicalData": {
        "type": "object",
        "properties": {
          "acceleration": {
            "type": "number",
            "description": "Acceleration from 0 to 100 kilometers per hour (in seconds).",
            "example": 6.5
          },
          "allwheelFlag": {
            "type": "string",
            "description": "Flag indicating if a vehicle has an all-wheel drive.",
            "example": "NO",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "dragCoefficient": {
            "type": "number",
            "description": "The drag coefficient describes the aerodynamics of a vehicle.",
            "example": 0.2
          },
          "emissionDirective": {
            "type": "string",
            "description": "Directive of the emission test.",
            "example": "715/2007*2018/1832DG"
          },
          "emissionStandard": {
            "$ref": "#/components/schemas/TechnicalDataEmissionStandardCodeText"
          },
          "emiCo": {
            "$ref": "#/components/schemas/EmiCo"
          },
          "energyEfficiencyClass": {
            "type": "string",
            "description": "Energy efficiency classification.",
            "example": "A",
            "enum": [
              "Aplus",
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G"
            ]
          },
          "enginePrimary": {
            "$ref": "#/components/schemas/EngineData"
          },
          "engineSecondary": {
            "$ref": "#/components/schemas/EngineData"
          },
          "fineParticle": {
            "type": "string",
            "description": "Fine particle plate of the vehicle (e.g. green, red, yellow)",
            "example": "green"
          },
          "numberOfDoors": {
            "type": "integer",
            "description": "Number of doors.",
            "format": "int32",
            "example": 5
          },
          "numberOfGears": {
            "type": "integer",
            "description": "Number of gears.",
            "format": "int32",
            "example": 6
          },
          "numberOfSeats": {
            "type": "integer",
            "description": "Number of seats.",
            "format": "int32",
            "example": 7
          },
          "steering": {
            "$ref": "#/components/schemas/TechnicalDataSteeringCodeText"
          },
          "topSpeed": {
            "type": "integer",
            "description": "Top speed in kilometers per hour.",
            "format": "int32",
            "example": 250
          },
          "weightData": {
            "$ref": "#/components/schemas/WeightData"
          },
          "wheelbase": {
            "type": "integer",
            "description": "Wheelbase in millimeters.",
            "format": "int32",
            "example": 3200
          },
          "axisLoad": {
            "type": "array",
            "description": "Axis load attributes of a vehicle.",
            "items": {
              "$ref": "#/components/schemas/AxisLoad"
            }
          },
          "technicalDataItem": {
            "type": "array",
            "description": "List of technical data items.",
            "items": {
              "$ref": "#/components/schemas/TechnicalDataItem"
            }
          }
        },
        "description": "The technical data of the vehicle."
      },
      "TechnicalDataEmissionStandardCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "EU6"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "6"
          }
        },
        "description": "Exhaust emissions standard.",
        "example": {
          "code": "6",
          "text": "EU6"
        }
      },
      "TechnicalDataItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique ID of a technical data specification.",
            "example": "06T"
          },
          "text": {
            "type": "string",
            "description": "Textual description of a technical data specification.",
            "example": "Fuel Tank Capacity"
          },
          "unit": {
            "type": "string",
            "description": "Unit of a technical data item.",
            "example": "L"
          },
          "value": {
            "type": "string",
            "description": "Actual value of a technical data item",
            "example": "50"
          },
          "valueType": {
            "type": "string",
            "description": "Object type of a technical data item e.g B=boolean, D=date, T=text and Z=number",
            "example": "T"
          },
          "valid": {
            "type": "string",
            "description": "Symbolize an identification if valid, invalid or unknown."
          },
          "origin": {
            "type": "string",
            "description": "Symbolize the origin of this technical data Item, like VEDOC, AMDS, GO, etc.",
            "example": "AMDS"
          },
          "techType": {
            "type": "string",
            "description": "Symbolize the technical attribute type, like T for normal T-value, W for WLTP items or C for custom items.",
            "example": "T"
          }
        },
        "description": "Generic list of technical attributes. Every technical attribute has an ID."
      },
      "TechnicalDataSteeringCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Left-hand drive"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "1"
          }
        },
        "description": "Steering type information for left hand or right hand drive.",
        "example": {
          "code": "1",
          "text": "Left-hand drive"
        }
      },
      "TextWithLocale": {
        "required": [
          "description"
        ],
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Description of the TextWithLocale.",
            "example": "Very special vehicle"
          },
          "locale": {
            "type": "string",
            "description": "Locale used in the request. Used to identify a language and market (country). Composed by a combination of the ISO639-1 format for the language and the ISO 3166-1 Alpha-2 format for the country code separated by an underscore. &lt;Language Code in lowercase&gt;_&lt;Country Code in uppercase&gt;.",
            "example": "de_DE"
          }
        },
        "description": "Text with locale."
      },
      "TireCondition": {
        "type": "object",
        "properties": {
          "tireSets": {
            "$ref": "#/components/schemas/TireSets"
          },
          "spareCondition": {
            "type": "integer",
            "description": "Condition of the spare tire in millimeters.",
            "format": "int32",
            "example": 6
          },
          "totalCondition": {
            "type": "integer",
            "description": "Overall condition of the tires in millimeters.",
            "format": "int32",
            "example": 8
          }
        },
        "description": "Information about the tire conditions."
      },
      "TireSet": {
        "type": "object",
        "properties": {
          "axisPosition": {
            "type": "integer",
            "description": "Indicates the axis position of the tire, starting with 1 for the front axis.",
            "format": "int32",
            "example": 1
          },
          "leftIn": {
            "type": "integer",
            "description": "Condition of the left inner tire in millimeters.",
            "format": "int32",
            "example": 8
          },
          "leftOut": {
            "type": "integer",
            "description": "Condition of the left outer tire in millimeters.",
            "format": "int32",
            "example": 8
          },
          "rightIn": {
            "type": "integer",
            "description": "Condition of the right inner tire in millimeters.",
            "format": "int32",
            "example": 8
          },
          "rightOut": {
            "type": "integer",
            "description": "Condition of the right outer tire in millimeters.",
            "format": "int32",
            "example": 8
          }
        },
        "description": "Information of one tire set, usually one per axis."
      },
      "TireSets": {
        "type": "object",
        "properties": {
          "tireSet": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TireSet"
            }
          }
        },
        "description": "List of tire conditions."
      },
      "TypeKey": {
        "type": "object",
        "properties": {
          "hsn": {
            "type": "string",
            "description": "Manufacturer key (German: Herstellerschl&#252;ssel).",
            "example": "2222"
          },
          "tsn": {
            "type": "string",
            "description": "Type key (German: Typschl&#252;ssel).",
            "example": "ANC"
          },
          "vsn": {
            "type": "string",
            "description": "Variant versions key (German: Varianten-Versionen-Schl&#252;ssel).",
            "example": "00020"
          }
        },
        "description": "Type key data, relevant for the insurance of a vehicle."
      },
      "Upholstery": {
        "type": "object",
        "properties": {
          "baseColor": {
            "$ref": "#/components/schemas/UpholsteryBaseColorCodeText"
          },
          "type": {
            "type": "string",
            "description": "General type of an upholstery.",
            "example": "FABRIC",
            "enum": [
              "LEATHER",
              "FABRIC"
            ]
          },
          "variant": {
            "type": "string",
            "description": "Specific variant - if applicable - of an upholstery.",
            "example": "DESIGNO",
            "enum": [
              "DESIGNO"
            ]
          },
          "code": {
            "type": "string",
            "description": "Code of an upholstery.",
            "example": "VX7"
          },
          "text": {
            "type": "string",
            "description": "Textual description of an upholstery.",
            "example": "Leather Lugano, black"
          },
          "price": {
            "$ref": "#/components/schemas/UpholsteryPricePrice"
          }
        },
        "description": "Data related to a vehicle's upholstery."
      },
      "UpholsteryBaseColorCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "L"
          }
        },
        "description": "General base color of an upholstery.",
        "example": {
          "code": "L",
          "text": ""
        }
      },
      "UpholsteryPricePrice": {
        "type": "object",
        "properties": {
          "taxInformations": {
            "$ref": "#/components/schemas/TaxInformations"
          },
          "basePrice": {
            "type": "number",
            "description": "Base (net) price excluding all taxes.",
            "example": 12300
          },
          "currency": {
            "type": "string",
            "description": "Curreny code of a price, expressed accordingly to ISO 4217.",
            "example": "EUR"
          },
          "currencyType": {
            "type": "string",
            "description": "Type of the currency, only relevant for Search Use Cases. EUR means Euro, COUNTRY means market default currency of the given market and SEARCH means the currency is the one that was send with the vehicle search request.",
            "example": "SEARCH",
            "enum": [
              "SEARCH",
              "COUNTRY",
              "EURO"
            ]
          },
          "totalPrice": {
            "type": "number",
            "description": "Total (gross) price including all taxes.",
            "example": 14760
          },
          "updatedAt": {
            "type": "string",
            "description": "The update timestamp of the price.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "customerType": {
            "type": "string",
            "description": "Type of customer. Values could be for example PRIVATE or BUSINESS.",
            "example": "PRIVATE"
          },
          "businessScenario": {
            "type": "string",
            "description": "Business scenario. Values could be for example Leasing or Financing.",
            "example": "Leasing"
          }
        },
        "description": "Price information of an upholstery."
      },
      "UsedVehicleData": {
        "type": "object",
        "properties": {
          "damagesRepairedFlag": {
            "type": "string",
            "description": "Flag indicating if the damages have been repaired.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "damageAmount": {
            "type": "number",
            "description": "Amount of damages.",
            "example": 1200
          },
          "lastVehicleUsage": {
            "$ref": "#/components/schemas/UsedVehicleDataLastVehicleUsageCodeText"
          },
          "licensePlateNumber": {
            "type": "string",
            "description": "License plate.",
            "example": "S-PVS-02"
          },
          "licenseStatus": {
            "type": "string",
            "description": "Status of the license (registered / not registered).",
            "example": "registered"
          },
          "licenseType": {
            "type": "string",
            "description": "Type of the license (passenger / commercial).",
            "example": "passenger"
          },
          "mileage": {
            "type": "integer",
            "description": "Mileage of a vehicle.",
            "format": "int32",
            "example": 58100
          },
          "mileageExchangeEngine": {
            "type": "integer",
            "description": "Mileage at which the engine was changed.",
            "format": "int32",
            "example": 1800
          },
          "natureOfTransaction": {
            "$ref": "#/components/schemas/UsedVehicleDataNatureOfTransactionCodeText"
          },
          "nextEmissionInspectionDate": {
            "type": "string",
            "description": "Next emission inspection date of a vehicle (e.g. T\u00dcV).",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "nextTechnicalInspectionDate": {
            "type": "string",
            "description": "Next technical inspection date of a vehicle (e.g. T\u00dcV).",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "numberPreviousOwners": {
            "type": "integer",
            "description": "Number of previous owners of a vehicle.",
            "format": "int32",
            "example": 1
          },
          "previousDamagesFlag": {
            "type": "string",
            "description": "Flag indicating if a vehicle had a previous damage.",
            "example": "NO",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "tireCondition": {
            "$ref": "#/components/schemas/TireCondition"
          },
          "totalCondition": {
            "$ref": "#/components/schemas/UsedVehicleDataTotalConditionCodeText"
          },
          "registrationTypeCommercial": {
            "$ref": "#/components/schemas/UsedVehicleDataRegistrationTypeCommercialCodeText"
          },
          "certificateOfConformityNumber": {
            "type": "string",
            "description": "Certificate of conformity for used vehicle."
          },
          "reparationCosts": {
            "type": "number",
            "description": "For aftersales: if some damages were fixed, it is possible to handle the reparation costs.",
            "example": 3500
          },
          "batteryCondition": {
            "$ref": "#/components/schemas/BatteryCondition"
          },
          "firstRegistrationDate": {
            "type": "string",
            "description": "Date of the first official registration of a vehicle.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "deregistrationDate": {
            "type": "string",
            "description": "Date of the deregistration of a vehicle.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "mileageDate": {
            "type": "string",
            "description": "Date on which the mileage of a vehicle was updated in VDH.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          }
        },
        "description": "Data which is specific for used vehicles."
      },
      "UsedVehicleDataLastVehicleUsageCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Jahreswagen"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "2"
          }
        },
        "description": "Former usage of a used vehicle.",
        "example": {
          "code": "2",
          "text": "Jahreswagen"
        }
      },
      "UsedVehicleDataNatureOfTransactionCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Miscellaneous"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "5"
          }
        },
        "description": "Transaction type of a vehicle.",
        "example": {
          "code": "5",
          "text": "Miscellaneous"
        }
      },
      "UsedVehicleDataRegistrationTypeCommercialCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Registered as a truck"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "ZAL"
          }
        },
        "description": "Type of commercial registration, like ZAL = registered as a truck.",
        "example": {
          "code": "ZAL",
          "text": "Registered as a truck"
        }
      },
      "UsedVehicleDataTotalConditionCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Satisfactory"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "3"
          }
        },
        "description": "Overall condition of a vehicle. E.g. VeryGood, Good, Satisfactory, Poor, VeryPoor",
        "example": {
          "code": "3",
          "text": "Satisfactory"
        }
      },
      "ValidationRuleResult": {
        "type": "object",
        "properties": {
          "attribute": {
            "type": "string",
            "description": "Name of the attribute that was validated.",
            "example": "v.wheelbase"
          },
          "description": {
            "type": "string",
            "description": "Textual description of the validation rule result.",
            "example": "Value range check: wheelbase, 4 digits"
          },
          "errorCode": {
            "type": "string",
            "description": "Error code of the validation rule result.",
            "example": "V454"
          },
          "ruleName": {
            "type": "string",
            "description": "Name/id of the validation rule.",
            "example": "rWheelbase"
          },
          "value": {
            "type": "string",
            "description": "Value (if available) that was found as invalid.",
            "example": "99999"
          }
        },
        "description": "The result of a validation against a validation rule configured in VDH."
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "description": "Locale, used to identify a language and market (country). Composed by a combination of the ISO639-1 format for the language and the ISO 3166-1 Alpha-2 format for the country code separated by an underscore. &lt;Language Code in lowercase&gt;_&lt;Country Code in uppercase&gt;."
          },
          "vehicleMetaData": {
            "$ref": "#/components/schemas/VehicleMetaData"
          },
          "bodyManufacturer": {
            "$ref": "#/components/schemas/VehicleBodyManufacturerCodeText"
          },
          "bodyMass": {
            "$ref": "#/components/schemas/BodyMass"
          },
          "cabin": {
