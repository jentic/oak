    "/v1/vehicle/management/status/read": {
      "post": {
        "tags": [
          "Read Vehicle"
        ],
        "summary": "Retrieve the vehicle status from stock database.",
        "operationId": "ReadVehicleStatus",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadVehicleStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadVehicleStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/v1/vehicle/management/marketplace/change": {
      "post": {
        "tags": [
          "Assign Bulk to Marketplaces"
        ],
        "summary": "Bulk assign vehicles to a marketplace. It can also be used to remove/unassigned vehicles from marketplaces. In order to unassgined a bulk of vehicles from a market place, the target marketplace in the request should remain empty.",
        "operationId": "BulkAssignMarketplaces",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkAssignMarketplaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkAssignMarketplaceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/v1/vehicle/management/health": {
      "get": {
        "tags": [
          "Vehicle Management Health"
        ],
        "summary": "Checks the health of the service.",
        "description": "Checks, whether the service is healthy and delivers more details.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealth"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Service DOWN: Service not available"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeVehicleStatusResponse": {
        "required": [
          "responseStatus",
          "statusUpdateResults"
        ],
        "type": "object",
        "properties": {
          "responseStatus": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "statusUpdateResults": {
            "type": "array",
            "description": "Vehicle status update result for each  vehicle and change status request.",
            "items": {
              "$ref": "#/components/schemas/VehicleStatusUpdateResult"
            }
          }
        },
        "description": "Response to the call of the change vehicle status business logic.",
        "xml": {
          "name": "ChangeVehicleStatusResponse",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.status.v1"
        }
      },
      "ResponseStatus": {
        "type": "object",
        "properties": {
          "overallStatus": {
            "type": "string",
            "description": "Overall status.",
            "example": "OK",
            "enum": [
              "OK",
              "NOK"
            ]
          },
          "status": {
            "type": "array",
            "description": "List of status information.",
            "items": {
              "$ref": "#/components/schemas/Status"
            }
          },
          "ifVersion": {
            "type": "string",
            "description": "Interface version.",
            "example": "2.0"
          },
          "locale": {
            "type": "string",
            "description": "Locale used in the request. Used to identify a language and market (country). Composed by a combination of the ISO639-1 format for the language and the ISO 3166-1 Alpha-2 format for the country code separated by an underscore. &lt;Language Code in lowercase&gt;_&lt;Country Code in uppercase&gt;.",
            "example": "de_DE"
          },
          "serviceDuration": {
            "type": "array",
            "description": "List of general service duration information.",
            "items": {
              "$ref": "#/components/schemas/ServiceDuration"
            }
          }
        },
        "description": "Common status information of a request. Used in multiple use cases."
      },
      "ServiceDuration": {
        "type": "object",
        "properties": {
          "duration": {
            "type": "string",
            "description": "Duration of a service call in ms.",
            "example": "114"
          },
          "serviceName": {
            "type": "string",
            "description": "Name of the service called."
          }
        },
        "description": "Information about the duration of a service call."
      },
      "Status": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Status code.",
            "example": "0"
          },
          "text": {
            "type": "string",
            "description": "Status description.",
            "example": "OK"
          },
          "type": {
            "type": "string",
            "description": "Status type.",
            "example": "OK",
            "enum": [
              "OK",
              "INFO",
              "WARNING",
              "ERROR"
            ]
          },
          "fin": {
            "type": "string",
            "description": "Vehicle Identification Number to which this status is related to. The European Vehicle Identification Number is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one VIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDD2050372R111111"
          }
        },
        "description": "Specific status information, used in many different use cases."
      },
      "VehicleResult": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "fin": {
            "type": "string",
            "description": "The European Vehicle Identification Number (FIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one FIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDD2221621A511933"
          },
          "reservationEndTime": {
            "type": "string",
            "description": "Timestamp when a vehicle's reservation ends.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "vin": {
            "type": "string",
            "description": "The Vehicle Identification Number (VIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one VIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDDUG6CB5LA511933"
          },
          "vehicleId": {
            "type": "integer",
            "description": "Unique numeric id generated by VDH for each used vehicle.",
            "format": "int64",
            "example": 2060666
          }
        },
        "description": "Vehicle result."
      },
      "VehicleResults": {
        "required": [
          "vehicleResult"
        ],
        "type": "object",
        "properties": {
          "vehicleResult": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleResult"
            }
          }
        },
        "description": "List of one or many vehicle results."
      },
      "VehicleStatusUpdateResult": {
        "type": "object",
        "properties": {
          "vehicleResults": {
            "$ref": "#/components/schemas/VehicleResults"
          },
          "identifier": {
            "type": "string",
            "description": "Context identifier, necessary for e.g. reservation, starting, confirming order process. This identifier will be used for the validation.",
            "example": "70006547"
          },
          "outletId": {
            "type": "string",
            "description": "The Mercedes-Benz's GSSN+ outletId (GS number) of a dealer is composed of two letters (GS) and a seven digits number.",
            "example": "GS0002385"
          },
          "type": {
            "type": "string",
            "description": "The resulting vehicle status.",
            "example": "R"
          }
        },
        "description": "Vehicle status update result for each requested vehicle and change status request."
      },
      "ChangeVehicleStatusRequest": {
        "required": [
          "requestConfig",
          "statusUpdates"
        ],
        "type": "object",
        "properties": {
          "requestConfig": {
            "$ref": "#/components/schemas/RequestConfig"
          },
          "statusUpdates": {
            "type": "array",
            "description": "List containing information of the status update request.",
            "items": {
              "$ref": "#/components/schemas/VehicleStatusUpdate"
            }
          }
        },
        "description": "Request to call the change vehicle status business logic. It validates and saves one or multiple vehicle status updates of one or multiple vehicles identified by the vehicle identification number (FIN). All status transitions are validated against the status model and if the validation was successful, the vehicles are updated in the VDH database.",
        "xml": {
          "name": "ChangeVehicleStatusRequest",
          "namespace": "urn:daimler:uvss.vse.vehiclemanagement.status.v1"
        }
      },
      "RequestConfig": {
        "type": "object",
        "properties": {
          "countryNumber": {
            "type": "string",
            "description": "Mercedes-Benz country code. 3-digit GSSN+ country number. See VDH Country Definitions.",
            "example": "000"
          },
          "locale": {
            "type": "string",
            "description": "Locale used in the request. Used to identify a language and market (country). Composed by a combination of the ISO639-1 format for the language and the ISO 3166-1 Alpha-2 format for the country code separated by an underscore. &lt;Language Code in lowercase&gt;_&lt;Country Code in uppercase&gt;.",
            "example": "de_DE"
          },
          "currency": {
            "type": "string",
            "description": "Currency used in the request. Is a 3-characters alphabetic code that follows the ISO 4217 standard.",
            "example": "EUR"
          }
        },
        "description": "Parameter information needed for a request."
      },
      "VehicleIdentifier": {
        "type": "object",
        "properties": {
          "fin": {
            "type": "string",
            "description": "The European Vehicle Identification Number (FIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one FIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDD2221621A511933"
          },
          "vin": {
            "type": "string",
            "description": "The Vehicle Identification Number (VIN) is a 17-characters unique ID used to identify vehicles. Each vehicle can only have one VIN which consists of 3-digits for the world manufacturer code and 14-digits for the chassis number.",
            "example": "WDDUG6CB5LA511933"
          }
        },
        "description": "Vehicle identifying information. FIN or VIN is necessary."
      },
      "VehicleStatusUpdate": {
        "type": "object",
        "properties": {
          "vehicles": {
            "type": "array",
            "description": "List of one or more vehicle ids for which the status must be changed.",
            "items": {
              "$ref": "#/components/schemas/VehicleIdentifier"
            }
          },
          "identifier": {
            "type": "string",
            "description": "Context identifier, necessary for e.g. reservation, starting, confirming order process. This identifier will be used for the validation.",
            "example": "70006547"
          },
          "outletId": {
            "type": "string",
            "description": "The Mercedes-Benz's GSSN+ outletId (GS number) of a dealer is composed of two letters (GS) and a seven digits number.",
            "example": "GS0002385"
          },
          "type": {
            "type": "string",
            "description": "Status identifier for status transition. Supported values: R = Reservation, Y = Cancel Reservation, O = Start Order, C = Confirm order, W = Cancel Order",
            "example": "R",
            "enum": [
              "R",
              "Y",
              "W",
              "C",
              "O",
              "I",
              "R",
              "Y",
              "W",
              "C",
              "O"
            ]
          }
        },
        "description": "Vehicle status update request data."
      },
      "AxisLoad": {
        "type": "object",
        "properties": {
          "load": {
            "type": "integer",
            "format": "int32",
            "example": 1550
          },
          "number": {
            "type": "integer",
            "description": "Position number of the axis, starting with 1 for the front axis",
            "format": "int32",
            "example": 1
          }
        },
        "description": "Axis Load attributes of a vehicle."
      },
      "BatteryCondition": {
        "type": "object",
        "properties": {
          "stateOfHealthPerc": {
            "type": "number",
            "description": "Battery State of Health (SoH)"
          },
          "stateOfHealthDate": {
            "type": "string",
            "description": "Date when SoH has been retrieved",
            "format": "date-time"
          },
          "stateOfChargeEstimatePerc": {
            "type": "number",
            "description": "State of Charge Estimate (SoCE)"
          },
          "stateOfChargeEstimateDate": {
            "type": "string",
            "description": "Date when SoCE has been retrieved",
            "format": "date-time"
          },
          "certificateAvailable": {
            "type": "string",
            "description": "Battery Certificate available",
            "enum": [
              "YES",
              "NO"
            ]
          }
        },
        "description": "Battery Condition of a used vehicle"
      },
      "BatteryData": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "chargingTime": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "string"
          }
        },
        "description": "Battery data of an engine."
      },
      "BodyMass": {
        "type": "object",
        "properties": {
          "height": {
            "type": "integer",
            "description": "The height of the cargo space.",
            "format": "int32"
          },
          "length": {
            "type": "integer",
            "description": "The length of the cargo space.",
            "format": "int32"
          },
          "volumeCubicMeter": {
            "type": "integer",
            "description": "The volume of the cargo space in cubic meter.",
            "format": "int32"
          },
          "volumeLiter": {
            "type": "integer",
            "description": "The volume of the cargo space in liter.",
            "format": "int32"
          },
          "width": {
            "type": "integer",
            "description": "The width of the cargo space.",
            "format": "int32"
          }
        },
        "description": "Dimensions of the cargo space"
      },
      "CabinInfo": {
        "type": "object",
        "properties": {
          "cabinBase": {
            "$ref": "#/components/schemas/CabinInfoCabinBaseCodeText"
          },
          "cabinType": {
            "$ref": "#/components/schemas/CabinInfoCabinTypeCodeText"
          },
          "cabinWidth": {
            "$ref": "#/components/schemas/CabinInfoCabinWidthCodeText"
          },
          "cabinBottom": {
            "$ref": "#/components/schemas/CabinInfoCabinBottomCodeText"
          },
          "cabinCombined": {
            "$ref": "#/components/schemas/CabinInfoCabinCombinedCodeText"
          }
        },
        "description": "Additional cabin information for commercial vehicles."
      },
      "CabinInfoCabinBaseCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Cabin base Text",
            "example": "L-cab"
          },
          "code": {
            "type": "string",
            "description": "Cabin base code",
            "example": "CBL"
          }
        },
        "description": "Base of the cabin, such as S-cab, M-cab and L-cab.",
        "example": {
          "code": "CBL",
          "text": "L-cab"
        }
      },
      "CabinInfoCabinBottomCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "level floor"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "F2A"
          }
        },
        "description": "Bottom of the cabin.",
        "example": {
          "code": "F2A",
          "text": "level floor"
        }
      },
      "CabinInfoCabinCombinedCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "L-cab BigSpace, 2.50 m, level floor"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "F1H"
          }
        },
        "description": "Combined information of the cabin.",
        "example": {
          "code": "F1H",
          "text": "L-cab BigSpace, 2.50 m, level floor"
        }
      },
      "CabinInfoCabinTypeCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "BigSpace"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "2V"
          }
        },
        "description": "Type of the cabin.",
        "example": {
          "code": "2V",
          "text": "BigSpace"
        }
      },
      "CabinInfoCabinWidthCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "2,50 m"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "F2H"
          }
        },
        "description": "Width of the cabin.",
        "example": {
          "code": "F2H",
          "text": "2,50 m"
        }
      },
      "CodeText": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "An alphanumeric code representation.",
            "example": "421"
          },
          "text": {
            "type": "string",
            "description": "Textual description of the code.",
            "example": "9G-TRONIC"
          }
        },
        "description": "A generic structure consisting of a code and a text. Usually used to handle different languages (same code but different translated text).",
        "example": [
          {
            "code": "M01",
            "text": ""
          }
        ]
      },
      "Consignment": {
        "type": "object",
        "properties": {
          "entryDate": {
            "type": "string",
            "description": "Date of vehicle entry.",
            "format": "date-time"
          },
          "location": {
            "type": "string",
            "description": "Location of vehicle entry."
          }
        },
        "description": "Consignment information."
      },
      "Consumption": {
        "type": "object",
        "properties": {
          "combined": {
            "type": "number",
            "description": "Fuel consumption combined.",
            "example": 5.9
          },
          "extraUrban": {
            "type": "number",
            "description": "Fuel consumption out of town.",
            "example": 5.5
          },
          "unit": {
            "type": "string",
            "description": "Unit of the fuel consumption.",
            "example": "l/100km"
          },
          "urban": {
            "type": "number",
            "description": "Fuel consumption in town.",
            "example": 6.4
          }
        },
        "description": "Fuel Consumption data of the engine."
      },
      "CylinderData": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "integer",
            "description": "Cylinder capacity in ccm.",
            "format": "int32",
            "example": 1950
          },
          "number": {
            "type": "integer",
            "description": "Number of Cylinders.",
            "format": "int32",
            "example": 4
          }
        },
        "description": "Cylinder data of an engine."
      },
      "Dealer": {
        "type": "object",
        "properties": {
          "addressAddition": {
            "type": "string",
            "description": "Additional information for a dealer address.",
            "example": "2nd Floor"
          },
          "city": {
            "type": "string",
            "description": "The city where a dealer is located.",
            "example": "Stuttgart"
          },
          "companyId": {
            "type": "string",
            "description": "The Global Company (GC) id of the dealer. It is composed of two letters (GC) and a seven digits number.",
            "example": "GC0000492"
          },
          "country": {
            "$ref": "#/components/schemas/DealerCountryCodeText"
          },
          "cpoFlag": {
            "type": "string",
            "description": "Flag indicating if a dealer is a CPO (Certified Pre Owned). CPO is a service that implements processing rules for vehicle CPO certification.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "cpoVanFlag": {
            "type": "string",
            "description": "Flag indicating if a dealer is a CPO (Certified Pre Owned) for vans. CPO is a service that implements processing rules for vehicle CPO certification.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "geoLocation": {
            "$ref": "#/components/schemas/GeoCoordinates"
          },
          "gssnId": {
            "type": "integer",
            "format": "int32"
          },
          "name1": {
            "type": "string",
            "description": "The first part of a dealer's company name.",
            "example": "Senger GmbH &amp; Co. KG"
          },
          "name2": {
            "type": "string",
            "description": "The second part of a dealer's company name.",
            "example": "Autorisierter Mercedes-Benz Verkauf und Service"
          },
          "name3": {
            "type": "string",
            "description": "The third part of a dealer's company name.",
            "example": "Division North."
          },
          "outletCode": {
            "type": "string",
            "description": "Mercedes-Benz's outlet code, only unique within one country.",
            "example": "21783"
          },
          "outletId": {
            "type": "string",
            "description": "The Mercedes-Benz's GSSN+ outletId (GS number) of a dealer. It is composed of two letters (GS) and a seven digits number.",
            "example": "GS0001232"
          },
          "outletVBET": {
            "type": "string",
            "description": "VBET outlet of a dealer. The VBET (Vertriebseinheit) describes a market-specific unit for the distribution of the vehicles. Each market can decide how these units are created/organized.",
            "example": "51301046"
          },
          "outletCofico": {
            "type": "string",
            "description": "CofiCO outlet of a dealer. CofiCO stands for Common Finance & Controlling and is used in CESAR for handling invoices from HQ to dealers.",
            "example": "432130681"
          },
          "postalCode": {
            "type": "string",
            "description": "The postal (zip) code of a dealer's location.",
            "example": "61169"
          },
          "postbox": {
            "type": "string",
            "description": "Post box information.",
            "example": "P.O. Box 5142"
          },
          "region": {
            "type": "string",
            "description": "Additional regional information.",
            "example": "Baden-Wuerttemberg"
          },
          "retailerGroupId": {
            "type": "string",
            "description": "Optional code for assigning several dealers to a group (a group is not legal therefore different from the company ID)."
          },
          "street": {
            "type": "string",
            "description": "The street address of the dealer's location.",
            "example": "Im Holter Feld 10"
          },
          "dealerType": {
            "type": "string"
          },
          "subregion": {
            "type": "string",
            "description": "Additional regional information.",
            "example": "Kreis Stuttgart"
          },
          "destinationKey": {
            "type": "string"
          },
          "dealerContacts": {
            "$ref": "#/components/schemas/DealerContacts"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          }
        },
        "description": "Description of a dealer according GSSN+."
      },
      "DealerContact": {
        "type": "object",
        "properties": {
          "comment": {
            "type": "string",
            "description": "Comment assigned to a dealer's contact person.",
            "example": "On maternity leave until 23-01-2023."
          },
          "email": {
            "type": "string",
            "description": "The email address of the dealer's contact person.",
            "example": "max.mustermann@mercedes-benz.com"
          },
          "fax": {
            "type": "string",
            "description": "The fax number of the dealer's contact person.",
            "example": "+40 711 999 99"
          },
          "firstname": {
            "type": "string",
            "description": "The firstname of the dealer's contact person.",
            "example": "Max"
          },
          "phone": {
            "type": "string",
            "description": "The phone number of the dealer's contact person.",
            "example": "+40 711 999 66"
          },
          "salutation": {
            "type": "string",
            "description": "The salutation of the dealer's contact person.",
            "example": "Mr."
          },
          "surname": {
            "type": "string",
            "description": "The surname of the dealer's contact person.",
            "example": "Mustermann"
          },
          "completeName": {
            "type": "string",
            "description": "The complete name of the dealer's contact person.",
            "example": "Max Robert Mustermann"
          },
          "type": {
            "type": "string",
            "description": "Responsibility of a dealer's contact person."
          },
          "vehicleType": {
            "type": "string",
            "description": "Indicates if a contact person is responsible for new or used vehicle stock.",
            "example": "NEW",
            "enum": [
              "NEW",
              "USED"
            ]
          }
        },
        "description": "Contact data of the dealer's responsible contact person."
      },
      "DealerContacts": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DealerContact"
            }
          }
        },
        "description": "Contact information, depends on division and type of the vehicle (stock / used)"
      },
      "DealerCountryCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Germany"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "000"
          }
        },
        "description": "3-digits GSSN+ code of the country where a dealer is located. This could be different from the country where the vehicle is offered.",
        "example": {
          "code": "000",
          "text": "Germany"
        }
      },
      "DealerHierarchy": {
        "type": "object",
        "properties": {
          "outletId": {
            "type": "array",
            "description": "OutletId of the dealer that belongs to this type of dealer range.",
            "items": {
              "type": "string",
              "description": "OutletId of the dealer that belongs to this type of dealer range.",
              "xml": {
                "name": "outletId"
              }
            }
          },
          "consumer": {
            "type": "string",
            "description": "Consumer group id for this dealer hierarchy."
          },
          "type": {
            "type": "string",
            "description": "Type of a dealer's range e.g. mpc to indicate that this list contains all outlet ids belonging to the same mpc like this vehicle.",
            "example": "MPC"
          }
        },
        "description": "Information of where a vehicle is located within the organizational tree and what organizations can access it in several search ranges (see concept of 4-Level-Dealer-Hierarchy for details)."
      },
      "DealerLink": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of the link provided.",
            "example": "Homepage"
          },
          "url": {
            "type": "string",
            "description": "A weblink to resources of a dealer",
            "example": "https://www.mercedes-benz.de"
          }
        },
        "description": "A link to resources (e.g. Webpages) of a dealer."
      },
      "EmiCo": {
        "type": "object",
        "properties": {
          "approvedUsage": {
            "type": "string",
            "description": "The approved usage is provided by the application Emico. It can be RETAIL or INTERNET. If the vehicle fulfils all the requirements regarding the emission and consumption (legal), then a vehicle gets the INTERNET flag, otherwise RETAIL.",
            "example": "INTERNET"
          },
          "driveConcept": {
            "type": "string",
            "description": "The drive concept is a concatenation of MONO or BI (for hybrids with two engines) and the FUEL. E.g. MONO_DIESEL for a single engine vehicle with DIESEL engine, or BI_PLUGIN for a PLUGIN Hybrid with a second engine (Diesel or Regular).",
            "example": "MONO_DIESEL"
          },
          "legalContext": {
            "type": "string",
            "description": "Can be USED or NEW. It is important for the decision, which legal base is used. NEW cars have more strict rules than USED cars.",
            "example": "USED"
          },
          "testProcedure": {
            "type": "string",
            "description": "NEFZ1, NEFZ2 or WLTP.",
            "example": "WLTP"
          },
          "ruleSetVersionID": {
            "type": "string",
            "description": "Internal EmiCo ID which was used for enrichments.",
            "example": "267"
          },
          "updatedAt": {
            "type": "string",
            "description": "Timestamp of last update of this data of the application EmiCo.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "rawData": {
            "type": "string",
            "description": "Raw JSON String (as a string) from application EmiCo."
          }
        },
        "description": "Emission and consumption data of a vehicle provided by the application EmiCo."
      },
      "Emission": {
        "type": "object",
        "properties": {
          "combined": {
            "type": "number",
            "description": "CO2-Emission combined.",
            "example": 154
          },
          "extraUrban": {
            "type": "number",
            "description": "CO2-Emission out of town.",
            "example": 146
          },
          "unit": {
            "type": "string",
            "description": "Unit of the CO2 emission.",
            "example": "g/km"
          },
          "urban": {
            "type": "number",
            "description": "CO2-Emission in town.",
            "example": 169
          }
        },
        "description": "CO2-Emission data of an engine."
      },
      "EngineData": {
        "type": "object",
        "properties": {
          "batteryData": {
            "$ref": "#/components/schemas/BatteryData"
          },
          "consumption": {
            "$ref": "#/components/schemas/Consumption"
          },
          "consumptionMaximum": {
            "$ref": "#/components/schemas/Consumption"
          },
          "consumptionMinimum": {
            "$ref": "#/components/schemas/Consumption"
          },
          "cylinderData": {
            "$ref": "#/components/schemas/CylinderData"
          },
          "emission": {
            "$ref": "#/components/schemas/Emission"
          },
          "emissionMaximum": {
            "$ref": "#/components/schemas/Emission"
          },
          "emissionMinimum": {
            "$ref": "#/components/schemas/Emission"
          },
          "engineType": {
            "$ref": "#/components/schemas/EngineDataEngineTypeCodeText"
          },
          "fuelTankCapacity": {
            "type": "integer",
            "description": "Fuel tank capacity.",
            "format": "int32",
            "example": 65
          },
          "fuelType": {
            "$ref": "#/components/schemas/EngineDataFuelTypeCodeText"
          },
          "powerData": {
            "$ref": "#/components/schemas/PowerData"
          }
        },
        "description": "Detailed information of an engine."
      },
      "EngineDataEngineTypeCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "1"
          }
        },
        "description": "Type of engine.",
        "example": {
          "code": "1",
          "text": ""
        }
      },
      "EngineDataFuelTypeCodeText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Code Text",
            "example": "Diesel"
          },
          "code": {
            "type": "string",
            "description": "Code",
            "example": "D"
          }
        },
        "description": "Unique code and textual description of the fuel type for a primary / secondary engine. Only hybrid vehicles contain a second fuel type.",
        "example": {
          "code": "D",
          "text": "Diesel"
        }
      },
      "Equipment": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Code of an equipment/option.",
            "example": "F6C"
          },
          "codeDescription": {
            "type": "string",
            "description": "Additional long description of an equipment."
          },
          "codeText": {
            "type": "string",
            "description": "Textual description of the equipment/option.",
            "example": "Windscreen, tinted"
          },
          "codeType": {
            "type": "string",
            "description": "Code type of an equipment.",
            "example": "SA"
          },
          "removedFlag": {
            "type": "string",
            "description": "Flag indicating if an equipment code has been removed by the dealer.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "source": {
            "type": "string",
            "description": "Source application that provides the information of an equipment. Such as V - VeDoc, G - GO, D - Dealer.",
            "example": "V"
          },
          "codeAdditionalType": {
            "type": "string",
            "description": "Additional information of an equipment code besides the code type.\nLI = line\nFE = rim (Felgen)\nSPACE = no additional information",
            "example": "LI"
          },
          "seriesType": {
            "type": "string",
            "description": "Series type of an equipment code.\nSI = always series\nSV = series alternative\nMS = market series\nSN = no series",
            "example": "SI"
          },
          "codeOwner": {
            "type": "string",
            "description": "Origin of the code. E.g. - DA for central code and MA for market codes.",
            "example": "MA"
          },
          "codePackageInformation": {
            "type": "string",
            "description": "Package information related to an equipment code.\nPB = option code is content of a package within the configuration\nPA = option code is alternative package content of a package within the configuration\nSpace = no package information related to option code",
            "example": "PA"
          },
          "standardFlag": {
            "type": "string",
            "description": "Flag indicating if an equipment is a standard or optional equipment.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "partOfPackageFlag": {
            "type": "string",
            "description": "Flag indicating if an equipment is part of a package.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "packageAlternativeFlag": {
            "type": "string",
            "description": "Flag indicating if an equipment can be an alternative of another equipment within a package.",
            "example": "YES",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "groupCode": {
            "type": "array",
            "description": "Group code of an equipment.",
            "example": {
              "code": "EPH",
              "text": "Parking Assistance"
            },
            "items": {
              "$ref": "#/components/schemas/CodeText"
            }
          },
          "price": {
            "$ref": "#/components/schemas/EquipmentPricePrice"
          }
        },
        "description": "Description of a specific equipment/option."
      },
      "EquipmentData": {
        "type": "object",
        "properties": {
          "equipment": {
            "type": "array",
            "description": "List of equipment being part of a vehicle's configuration.",
            "items": {
              "$ref": "#/components/schemas/Equipment"
            }
          },
          "package": {
            "type": "array",
            "description": "List of packages being part of a vehicle's configuration.",
            "items": {
              "$ref": "#/components/schemas/Package"
            }
          },
          "individualEquipment": {
            "type": "array",
            "description": "List of specific individual non-factory equipments like dealer options.",
            "items": {
              "$ref": "#/components/schemas/IndividualEquipment"
            }
          }
        },
        "description": "Data for equipment and packages being part of a vehicle's configuration."
      },
      "EquipmentPricePrice": {
        "type": "object",
        "properties": {
          "taxInformations": {
            "$ref": "#/components/schemas/TaxInformations"
          },
          "basePrice": {
            "type": "number",
            "description": "Base (net) price excluding all taxes.",
            "example": 12300
          },
          "currency": {
            "type": "string",
            "description": "Curreny code of a price, expressed accordingly to ISO 4217.",
            "example": "EUR"
          },
          "currencyType": {
            "type": "string",
            "description": "Type of the currency, only relevant for Search Use Cases. EUR means Euro, COUNTRY means market default currency of the given market and SEARCH means the currency is the one that was send with the vehicle search request.",
            "example": "SEARCH",
            "enum": [
              "SEARCH",
              "COUNTRY",
              "EURO"
            ]
          },
          "totalPrice": {
            "type": "number",
            "description": "Total (gross) price including all taxes.",
            "example": 14760
          },
          "updatedAt": {
            "type": "string",
            "description": "The update timestamp of the price.",
            "format": "date-time",
            "example": "2020-09-14T00:00:00+02:00"
          },
          "customerType": {
            "type": "string",
            "description": "Type of customer. Values could be for example PRIVATE or BUSINESS.",
            "example": "PRIVATE"
          },
          "businessScenario": {
            "type": "string",
            "description": "Business scenario. Values could be for example Leasing or Financing.",
            "example": "Leasing"
          }
        },
        "description": "Price of an equipment."
      },
      "FinAttributes": {
        "type": "object",
        "properties": {
          "baumuster": {
            "type": "string",
            "description": "The 7-digits model of a vehicle (German: Baumuster).",
            "example": "2120022"
          },
          "chassisNumber": {
            "type": "string",
            "description": "The 14-digits of the chassis number engraved in a vehicle chassis.",
            "example": "2120022A640024"
          },
          "wmc": {
            "type": "string",
            "description": "The 3-digits of the world manufacturer code.",
            "example": "WDD"
          }
        },
        "description": "A FIN consists of several parts. This structure holds the fin split up in meaningful sub-parts."
      },
      "FinancingData": {
        "type": "object",
        "properties": {
          "customerType": {
            "type": "string",
            "description": "Type of customer.",
            "example": "PRIVATE",
            "enum": [
              "BUSINESS",
              "PRIVATE"
            ]
          },
          "rate": {
            "$ref": "#/components/schemas/Price"
          },
          "productCodes": {
            "$ref": "#/components/schemas/ProductCodes"
          },
          "financingValues": {
            "$ref": "#/components/schemas/FinancingValues"
          }
        },
        "description": "Financial data information of a vehicle."
      },
      "FinancingValue": {
        "type": "object",
        "properties": {
          "disclaimer": {
            "type": "string",
            "description": "Localized disclaimer for a financial value."
          },
          "highlight": {
            "type": "string",
            "description": "Indicates if the disclaimer / value should be highlighted.",
            "example": "NO",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "id": {
            "type": "string",
            "description": "Unique id of a financial attribute."
          },
          "infoTextKey": {
            "type": "string",
            "description": "Optional information text. Can be used by Dealer managament systems."
          },
          "label": {
            "type": "string",
            "description": "Localized text of a financial value."
          },
          "unit": {
            "type": "string",
            "description": "Unit of the financial value. VDH is using a value / unit concept. In this case, a unit of a financial value could be \"Months\" (e.g. Leasing for 36 Months).",
            "example": "Months"
          },
          "value": {
            "type": "string"
          }
        },
        "description": "Represents one finance data value with all the further information like unit, text and ID."
      },
      "FinancingValues": {
        "type": "object",
        "properties": {
          "financialValue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FinancingValue"
            }
          }
        },
        "description": "List of calculation values for a financing offer."
      },
      "GeoCoordinates": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "description": "The latitude of the dealer's location. Will be provided by GSSN+.",
            "example": 50.344269
          },
          "longitude": {
            "type": "number",
            "description": "The longitude of the dealer's location. Will be provided by GSSN+.",
            "example": 8.756678
          }
        },
        "description": "Geo location coordinates of a dealer."
      },
      "IndividualEquipment": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Code of an individual equipment.",
            "example": "FUSSM"
          },
          "codeText": {
            "type": "string",
            "description": "Textual description of an individual equipment.",
            "example": "Doormats"
          },
          "codeOwner": {
            "type": "string",
            "description": "Code owner of an individual equipment.",
            "example": "D"
          }
        },
        "description": "Description of an individual equipment/option."
      },
      "Links": {
        "type": "object",
        "properties": {
          "dealerLink": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DealerLink"
