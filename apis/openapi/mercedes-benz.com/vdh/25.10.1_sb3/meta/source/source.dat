          },
          "numberOfImages": {
            "type": "integer",
            "description": "Total number of images associated to a vehicle.",
            "format": "int32",
            "example": 20
          },
          "numberOfVideos": {
            "type": "integer",
            "description": "Total number of videos associated to a vehicle.",
            "format": "int32",
            "example": 1
          }
        },
        "description": "Media data, like image or video URLs, associated to a vehicle."
      },
      "MediaItem": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "description": "Dimension of a media item."
          },
          "index": {
            "maximum": 99,
            "minimum": 0,
            "type": "integer",
            "description": "Unique index within the list of media items of the same type for a vehicle.",
            "format": "int32",
            "example": 0
          },
          "perspective": {
            "type": "string",
            "description": "The perspective of a vehicle that a media item shows. 'SOME','LEFT','FRONT','RIGHT','REAR','RIM','INTERIOR','COCKPIT','UPHOL','CPO','DAMAGE','THUMBNAIL','BOOT_REAR','BOOT_SIDE','REAR_SEAT','OPTIONAL_EQUIPMENT','CONSOLE','ENGINE','BOOT','ADDITIONAL'",
            "example": "REAR"
          },
          "provider": {
            "type": "string",
            "description": "The (external) provider of a media item's content.",
            "example": "YOUTUBE"
          },
          "source": {
            "type": "string",
            "description": "Source system of a media item.",
            "example": "CPS"
          },
          "type": {
            "type": "string",
            "description": "The type of a media item.",
            "example": "IMAGE",
            "enum": [
              "VIDEO",
              "IMAGE",
              "STAGE_IMAGE",
              "PAINT_IMAGE",
              "UPHOLSTERY_IMAGE",
              "EQUIPMENT_IMAGE",
              "TRIM_IMAGE",
              "RIM_IMAGE",
              "ENGINE_IMAGE"
            ]
          },
          "url": {
            "type": "string",
            "description": "URL of a media item for retrieving the content.",
            "example": "https://cdn.cps.mercedes-benz.com/CPS-Web/image/IMAGE/xx_FicaAMsJ8tuMl-X7DlmoQ/800/600/1621925094875/SOME"
          },
          "visibility": {
            "type": "string",
            "description": "Visibility range of a media item.",
            "example": "INTERNET",
            "enum": [
              "INTERNET",
              "DMS_ONLY",
              "WHOLESALE"
            ]
          },
          "equipmentCode": {
            "type": "string",
            "description": "The code of an equipment to which this media item is associated.",
            "example": "200"
          }
        },
        "description": "Meta data of a media Item. A media Item can be a video or an image."
      },
