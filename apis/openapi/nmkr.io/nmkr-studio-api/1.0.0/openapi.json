            "description": "NFT project identifier"
          },
          {
            "name": "nftname",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "NFT name"
          }
        ],
        "responses": {
          "200": {
            "description": "NFT details returned",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NftDetails" } } }
