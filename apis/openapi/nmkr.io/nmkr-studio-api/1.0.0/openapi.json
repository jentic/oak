{
  "openapi": "3.0.3",
  "info": {
    "title": "NMKR Studio API",
    "version": "1.0.0",
    "description": "NMKR Studio API for NFT project management on the Cardano blockchain. Supports address reservation, payment processing, NFT sales, wallet validation, project creation, and NFT management. Note: The original API at studio-api.nmkr.io is marked as deprecated.",
    "x-jentic-source-url": "https://studio-api.nmkr.io/swagger/index.html"
  },
  "servers": [
    {
      "url": "https://studio-api.nmkr.io"
    }
  ],
  "paths": {
    "/CancelAddressReservation/{apikey}/{projectuid}/{paymentaddress}": {
      "get": {
        "operationId": "cancelAddressReservation",
        "summary": "Cancel address reservation",
        "description": "Cancels an existing address reservation for an NFT project.",
        "tags": ["Address Reservation"],
        "parameters": [
          {
            "name": "apikey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "API key"
          },
          {
            "name": "projectuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Project unique identifier"
          },
          {
            "name": "paymentaddress",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Payment address to cancel"
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation cancelled",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "400": {
            "description": "Bad request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/CheckAddress/{apikey}/{projectuid}/{address}": {
      "get": {
        "operationId": "checkAddress",
        "summary": "Check address status",
        "description": "Checks the status of an address for an NFT project.",
        "tags": ["Address Reservation"],
        "parameters": [
          {
            "name": "apikey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "API key"
          },
          {
            "name": "projectuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Project unique identifier"
          },
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Address to check"
          }
        ],
        "responses": {
          "200": {
            "description": "Address status returned",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "400": {
            "description": "Bad request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/CheckWalletValidation/{apikey}/{validationuid}/{lovelace}": {
      "get": {
        "operationId": "checkWalletValidation",
        "summary": "Check wallet validation",
        "description": "Validates a wallet for a given amount of lovelace.",
        "tags": ["Wallet"],
        "parameters": [
          {
            "name": "apikey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "API key"
          },
          {
            "name": "validationuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Validation unique identifier"
          },
          {
            "name": "lovelace",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Amount in lovelace"
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "400": {
            "description": "Bad request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/CreateProject/{apikey}": {
      "post": {
        "operationId": "createProject",
        "summary": "Create a new NFT project",
        "description": "Creates a new NFT project on the Cardano blockchain.",
        "tags": ["Projects"],
        "parameters": [
          {
            "name": "apikey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "API key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProjectRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } }
          },
          "400": {
            "description": "Bad request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/DeleteNft/{apikey}/{nftuid}": {
      "get": {
        "operationId": "deleteNft",
        "summary": "Delete an NFT",
        "description": "Deletes a specific NFT by its unique identifier.",
        "tags": ["NFTs"],
        "parameters": [
          {
            "name": "apikey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "API key"
          },
          {
            "name": "nftuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "NFT unique identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "NFT deleted",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "400": {
            "description": "Bad request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
