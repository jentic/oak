  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "projectId": { "type": "string" },
          "projectUid": { "type": "string" },
          "name": { "type": "string" },
          "policyId": { "type": "string" }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "properties": {
          "projectName": { "type": "string" },
          "description": { "type": "string" },
          "policyExpires": { "type": "boolean" },
          "policyExpiresDate": { "type": "string", "format": "date-time" }
        }
      },
      "NftDetails": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "uid": { "type": "string" },
          "name": { "type": "string" },
          "displayName": { "type": "string" },
          "state": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "PaymentAddress": {
        "type": "object",
        "properties": {
          "address": { "type": "string", "description": "Cardano payment address" },
          "lovelace": { "type": "integer", "description": "Price in lovelace" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "ProjectCounts": {
        "type": "object",
        "properties": {
          "totalNfts": { "type": "integer" },
          "sold": { "type": "integer" },
          "free": { "type": "integer" },
          "reserved": { "type": "integer" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "apiKeyPath": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API key passed as path parameter in all endpoints"
      }
    }
  },
  "security": [
    {
      "apiKeyPath": []
    }
  ]
}
