    "/GetNfts/{apikey}/{nftprojectid}/{state}": {
      "get": {
        "operationId": "getNftsByState",
        "summary": "Get NFTs by state",
        "description": "Retrieves NFTs filtered by their distribution state.",
        "tags": ["NFTs"],
        "parameters": [
          {
            "name": "apikey",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "nftprojectid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "NFT project identifier"
          },
          {
            "name": "state",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "NFT state filter"
          }
        ],
        "responses": {
          "200": {
            "description": "NFTs returned",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/NftDetails" } } } }
          },
          "400": {
            "description": "Bad request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
