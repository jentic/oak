{
  "openapi": "3.1.0",
  "info": {
    "title": "Claisy API Live",
    "version": "1.0.0",
    "description": "Claisy API allows importing parcels via a CSV file, providing information about senders, recipients, and parcel content. This document describes the details of each endpoint for effective use of the API.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Claisy/ClaisyAPI/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.claisy.com/functions/v1"
    }
  ],
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/parcel": {
      "post": {
        "tags": [
          "Parcels"
        ],
        "summary": "Create a single parcel",
        "description": "Allows creating a parcel by providing the necessary details directly in the request body.\n",
        "operationId": "createColis",
        "security": [
          {
            "api_key": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reference",
                  "tracking_number",
                  "carrier",
                  "parcel_value",
                  "content"
                ],
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "tracking_number": {
                    "type": "string"
                  },
                  "carrier": {
                    "type": "string",
                    "enum": [
                      "Chronopost",
                      "Colissimo",
                      "DHL",
                      "DPD",
                      "Fedex",
                      "GLS",
                      "Mondial Relay",
                      "Relais Colis",
                      "Royal Mail",
                      "UPS",
                      "USPS",
                      "Evri",
                      "DHL Express",
                      "Other"
                    ]
                  },
                  "sending_mode": {
                    "type": "string",
                    "description": "Type of parcel/shipping mode (e.g., \"Chrono 13\", \"Express\")."
                  },
                  "tracking_link": {
                    "type": "string",
                    "description": "URL for tracking the parcel."
                  },
                  "estimate_delivery_date": {
                    "type": "string",
                    "description": "Estimated delivery date of the parcel.",
                    "pattern": "MM/DD/YYYY",
                    "example": "MM/DD/YYYY"
                  },
                  "parcel_value": {
                    "type": "number"
                  },
                  "parcel_weight": {
                    "type": "number",
                    "description": "Weight of the parcel in kg."
                  },
                  "parcel_currency": {
                    "type": "string",
                    "description": "Currency for the parcel value."
                  },
                  "parcel_category": {
                    "type": "string",
                    "enum": [
                      "Jewelry & Watches",
                      "Leather & Luggage",
                      "Fashion & Accessories",
                      "Art & Collectibles",
                      "High Tech",
                      "Furniture & Decor",
                      "Food",
                      "Household appliances",
                      "TV Hifi",
                      "Beauty & Cosmetic",
                      "Sport & Outdoor",
                      "Tools & Construction",
                      "Music & Hobbies",
                      "Liquids",
                      "Other"
                    ]
                  },
                  "sender_company": {
                    "type": "string"
                  },
                  "sender_first_name": {
                    "type": "string"
                  },
                  "sender_last_name": {
                    "type": "string"
                  },
                  "sender_address": {
                    "type": "string"
                  },
                  "sender_zipcode": {
                    "type": "string"
                  },
                  "sender_city": {
                    "type": "string"
                  },
                  "sender_country": {
                    "type": "string"
                  },
                  "recipient_company": {
                    "type": "string"
                  },
                  "recipient_first_name": {
                    "type": "string"
                  },
                  "recipient_last_name": {
                    "type": "string"
                  },
                  "recipient_address": {
                    "type": "string"
                  },
                  "recipient_zipcode": {
                    "type": "string"
                  },
                  "recipient_city": {
                    "type": "string"
                  },
                  "recipient_country": {
                    "type": "string"
                  },
                  "recipient_email": {
                    "type": "string"
                  },
                  "recipient_lang": {
                    "type": "string",
                    "description": "Preferred language of the recipient."
                  },
                  "recipient_notif": {
                    "type": "boolean",
                    "description": "Whether the partner authorizes communication with the recipient (\"Yes\"/\"No\")."
                  },
                  "cart_data": {
                    "type": "string",
                    "description": "Custom field that can be displayed on the parcel data screen if relevant."
                  },
                  "payment_mode": {
                    "type": "string",
                    "description": "Payment method used."
                  },
                  "claimer_email": {
                    "type": "string",
                    "description": "Email of the claim manager if different from the one who subscribes."
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parcel created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Message indicating that the parcel was successfully created.",
                      "example": "Parcel created successfully."
                    },
                    "protection_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parcel/{parcel_id}": {
      "delete": {
        "tags": [
          "Parcels"
        ],
        "summary": "Delete a parcel",
        "description": "Allows deleting a parcel by using the unique parcel ID.\n",
        "operationId": "deleteColis",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "name": "parcel_id",
            "in": "path",
            "description": "Unique ID of the parcel",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parcel deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Message indicating that the parcel was successfully deleted.",
                      "example": "Parcel deleted successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parcels": {
      "get": {
        "tags": [
          "Parcels"
        ],
        "summary": "Get list of parcels",
        "description": "Retrieve a list of parcels filtered by tracking number and/or reference. Only parcels associated with the API key are returned.\n",
        "operationId": "getParcelList",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "query",
            "description": "Unique reference of the parcel",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tracking_number",
            "in": "query",
            "description": "Parcel tracking number",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of parcels retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalItems": {
                      "type": "integer",
                      "description": "Total number of parcels retrieved.",
                      "example": 5
                    },
                    "list": {
                      "type": "array",
                      "description": "List of parcels.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "reference": {
                            "type": "string"
                          },
                          "tracking_number": {
                            "type": "string"
                          },
                          "carrier": {
                            "type": "string",
                            "enum": [
                              "Chronopost",
                              "Colissimo",
                              "DHL",
                              "DPD",
                              "Fedex",
                              "GLS",
                              "Mondial Relay",
                              "Relais Colis",
                              "Royal Mail",
                              "UPS",
                              "USPS",
                              "Evri",
                              "DHL Express",
                              "Other"
                            ]
                          },
                          "sending_mode": {
                            "type": "string"
                          },
                          "tracking_link": {
                            "type": "string"
                          },
                          "estimate_delivery_date": {
                            "type": "string"
                          },
                          "parcel_value": {
                            "type": "number"
                          },
                          "parcel_weight": {
                            "type": "number"
                          },
                          "created_at": {
                            "type": "string"
                          },
                          "parcel_currency": {
                            "type": "string"
                          },
                          "parcel_category": {
                            "type": "string",
                            "enum": [
                              "Jewelry & Watches",
                              "Leather & Luggage",
                              "Fashion & Accessories",
                              "Art & Collectibles",
                              "High Tech",
                              "Furniture & Decor",
                              "Food",
                              "Household appliances",
                              "TV Hifi",
                              "Beauty & Cosmetic",
                              "Sport & Outdoor",
                              "Tools & Construction",
                              "Music & Hobbies",
                              "Liquids",
                              "Other"
                            ]
                          },
                          "sender_company": {
                            "type": "string"
                          },
                          "sender_first_name": {
                            "type": "string"
                          },
                          "sender_last_name": {
                            "type": "string"
                          },
                          "sender_address": {
                            "type": "string"
                          },
                          "sender_zipcode": {
                            "type": "string"
                          },
                          "sender_city": {
                            "type": "string"
                          },
                          "sender_country": {
                            "type": "string"
                          },
                          "recipient_company": {
                            "type": "string"
                          },
                          "recipient_first_name": {
                            "type": "string"
                          },
                          "recipient_last_name": {
                            "type": "string"
                          },
                          "recipient_address": {
                            "type": "string"
                          },
                          "recipient_zipcode": {
                            "type": "string"
                          },
                          "recipient_city": {
                            "type": "string"
                          },
                          "recipient_country": {
                            "type": "string"
                          },
                          "content": {
                            "type": "string"
                          },
                          "protection_id": {
                            "type": "string"
                          },
                          "covered_value": {
                            "type": "number"
                          },
                          "user_email": {
                            "type": "string"
                          },
                          "recipient_email": {
                            "type": "string"
                          },
                          "recipient_lang": {
                            "type": "string"
                          },
                          "recipient_notif": {
                            "type": "boolean"
                          },
                          "claimer_email": {
                            "type": "string"
                          },
                          "cart_data": {
                            "type": "string"
                          },
                          "tracking_status": {
                            "type": "string",
                            "nullable": true,
                            "description": "Current tracking status of the parcel. Updated automatically. The label is returned in the language configured in your account settings. French: \"En attente\", \"Pr\u00e9paration\", \"Exp\u00e9di\u00e9\", \"En livraison\", \"Probl\u00e8me\", \"Livr\u00e9\". English: \"Pending\", \"Processing\", \"Shipped\", \"Out for delivery\", \"Issue\", \"Delivered\".\n",
                            "example": "Exp\u00e9di\u00e9"
                          },
                          "tracking_last_update": {
                            "type": "string",
                            "nullable": true,
                            "description": "Timestamp of the last tracking status update (ISO 8601 format).\n",
                            "example": "2026-03-01T14:30:00.000Z"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Parcels"
        ],
        "summary": "Create multiple parcels",
        "description": "Allows creating multiple parcels by providing the necessary details directly in the request body.\n",
        "operationId": "createMultipleColis",
        "security": [
