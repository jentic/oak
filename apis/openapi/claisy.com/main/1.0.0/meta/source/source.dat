                    "reference": {
                      "type": "string"
                    },
                    "tracking_number": {
                      "type": "string"
                    },
                    "carrier": {
                      "type": "string",
                      "enum": [
                        "Chronopost",
                        "Colissimo",
                        "DHL",
                        "DPD",
                        "Fedex",
                        "GLS",
                        "Mondial Relay",
                        "Relais Colis",
                        "Royal Mail",
                        "UPS",
                        "USPS",
                        "Evri",
                        "DHL Express",
                        "Other"
