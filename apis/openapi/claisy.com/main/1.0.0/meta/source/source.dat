          }
        },
        "responses": {
          "200": {
            "description": "Parcels created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Message indicating how many parcels were successfully created and how many errors occurred.",
                      "example": "1 parcel created successfully, 1 errors occurred."
                    },
                    "successes": {
                      "type": "array",
                      "description": "List of successfully created parcels.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "reference": {
                            "type": "string"
                          },
                          "protection_id": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "example": "success"
                          }
                        }
                      }
                    },
                    "errors": {
                      "type": "array",
                      "description": "List of errors encountered during parcel creation.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "reference": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "example": "failed"
                          },
                          "error": {
                            "type": "string",
                            "description": "Associated error message.",
                            "example": "duplicate key value violates unique constraint \"parcel_reference_key\""
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parcels-csv": {
      "post": {
        "tags": [
          "Parcels"
        ],
        "summary": "Import a CSV file of parcels",
        "description": "Allows importing a CSV file containing parcel information, including sender details, recipient details, and parcel content. The CSV file must include the following columns:\n- **reference** (string): order number / your internal reference of the parcel or order. (Required)\n- **tracking_number** (string): Parcel tracking number. (Required)\n- **carrier** (string): Carrier name. Possible values: \"Chronopost\", \"Colissimo\", \"Colis Priv\u00e9\", \"DHL\", \"DPD\", \"Fedex\", \"GLS\", \"Mondial Relay\", \"Relais Colis\", \"Royal Mail\", \"UPS\", \"USPS\", \"Evri\", \"DHL Express\", \"Other\". (optional)\n- **sending_mode** (string): Type of parcel/shipping mode (e.g., \"Chrono 13\", \"Express\"). (Optional)\n- **tracking_link** (string): URL for tracking the parcel. (Optional)\n- **estimate_delivery_date** (string): Estimated delivery date of the parcel. (Optional) (\"MM/DD/YYYY\")\n- **parcel_value** (number): Value of the parcel. (Required)\n- **parcel_weight** (number): Weight of the parcel in kg. (Optional)\n- **parcel_currency** (string): Currency for the parcel value. (Optional)\n- **parcel_category** (string): Parcel category. Possible values: \"Jewelry & Watches\", \"Leather & Luggage\", \"Fashion & Accessories\", \"Art & Collectibles\", \"High Tech\", \"Furniture & Decor\", \"Food\", \"Household appliances\", \"TV Hifi\", \"Beauty & Cosmetic\", \"Sport & Outdoor\", \"Tools & Construction\", \"Music & Hobbies\", \"Liquids\", \"Other\" (optional)\n- **sender_company** (string): Sender's company. (Optional)\n- **sender_first_name** (string): Sender's first name. (Optional)\n- **sender_last_name** (string): Sender's last name. (Optional)\n- **sender_address** (string): Sender's address. (Optional)\n- **sender_zipcode** (string): Sender's postal code. (Optional)\n- **sender_city** (string): Sender's city. (Optional)\n- **sender_country** (string): Sender's country. (Optional)\n- **recipient_company** (string): Recipient's company. (Optional)\n- **recipient_first_name** (string): Recipient's first name. (Optional)\n- **recipient_last_name** (string): Recipient's last name. (Optional)\n- **recipient_address** (string): Recipient's address. (Optional)\n- **recipient_zipcode** (string): Recipient's postal code. (Optional)\n- **recipient_city** (string): Recipient's city. (Optional)\n- **recipient_country** (string): Recipient's country. (Optional)\n- **recipient_email** (string): Email of the recipient. (Optional)\n- **recipient_lang** (string): Preferred language of the recipient. (Optional)\n- **recipient_notif** (boolean): Whether the partner authorizes communication with the recipient (\"Yes\"/\"No\"). (Optional)\n- **cart_data** (string): Custom field that can be displayed on the parcel data screen if relevant. (Optional)\n- **payment_mode** (string): Payment method used. (Optional)\n- **claimer_email** (string): Email of the claim manager if different from the one who subscribes. (Optional)\n\n**Additional instructions:**\n- The column headers must exactly match those listed above.\n- Columns are mandatory in the CSV file, but values can be left empty.\n- Values for **carrier** and **parcel_category** fields must be among the listed options. If an invalid value is provided, it will be replaced with \"Other\".\n- The column separator must be a semicolon (`;`).\n",
        "operationId": "importCsvColis",
        "security": [
          {
            "api_key": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "colis_csv_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The CSV file of parcels to import."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import successful.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          }
        }
      }
    },
    "/calculate-quotation": {
      "get": {
        "tags": [
          "Parcels"
        ],
        "summary": "Get insurance price for a parcel",
        "description": "Allows getting the insurance price for a parcel based on its value.\n",
        "operationId": "getQuotation",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "name": "parcel_value",
            "in": "query",
            "description": "Value of the parcel",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Insurance price obtained successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "protectionPrice": {
                      "type": "number",
                      "description": "The insurance price for the parcel."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "api-key",
        "in": "header"
      }
    },
    "schemas": {
      "ImportResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "General message about the import.",
            "examples": [
              "Import completed successfully."
            ]
          }
        }
      },
      "Parcel": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "tracking_number": {
            "type": "string"
          },
          "carrier": {
            "type": "string",
            "enum": [
              "Chronopost",
              "Colissimo",
              "DHL",
              "DPD",
              "Fedex",
              "GLS",
              "Mondial Relay",
              "Relais Colis",
              "Royal Mail",
              "UPS",
              "USPS",
              "Evri",
              "DHL Express",
              "Other"
            ]
          },
          "sending_mode": {
            "type": "string",
            "description": "Type of parcel/shipping mode (e.g., \"Chrono 13\", \"Express\")."
          },
          "tracking_link": {
            "type": "string",
            "description": "URL for tracking the parcel."
          },
          "estimate_delivery_date": {
            "type": "string",
            "description": "Estimated delivery date of the parcel.",
            "pattern": "MM/DD/YYYY",
            "example": "MM/DD/YYYY"
          },
          "parcel_value": {
            "type": "number"
          },
          "parcel_weight": {
            "type": "number",
            "description": "Weight of the parcel in kg."
          },
          "parcel_currency": {
            "type": "string",
            "description": "Currency for the parcel value."
          },
          "parcel_category": {
            "type": "string",
            "enum": [
              "Jewelry & Watches",
              "Leather & Luggage",
              "Fashion & Accessories",
              "Art & Collectibles",
              "High Tech",
              "Furniture & Decor",
              "Food",
              "Household appliances",
              "TV Hifi",
              "Beauty & Cosmetic",
              "Sport & Outdoor",
              "Tools & Construction",
              "Music & Hobbies",
              "Liquids",
              "Other"
            ]
          },
          "sender_company": {
            "type": "string"
          },
          "sender_first_name": {
            "type": "string"
          },
          "sender_last_name": {
            "type": "string"
          },
          "sender_address": {
            "type": "string"
          },
          "sender_zipcode": {
            "type": "string"
          },
          "sender_city": {
            "type": "string"
          },
          "sender_country": {
            "type": "string"
          },
          "recipient_company": {
            "type": "string"
          },
          "recipient_first_name": {
            "type": "string"
          },
          "recipient_last_name": {
            "type": "string"
          },
          "recipient_address": {
            "type": "string"
          },
          "recipient_zipcode": {
            "type": "string"
          },
          "recipient_city": {
            "type": "string"
          },
          "recipient_country": {
            "type": "string"
          },
          "recipient_email": {
            "type": "string"
          },
          "recipient_lang": {
            "type": "string",
            "description": "Preferred language of the recipient."
          },
          "recipient_notif": {
            "type": "boolean",
            "description": "Whether the partner authorizes communication with the recipient (\"Yes\"/\"No\")."
          },
          "cart_data": {
            "type": "string",
            "description": "Custom field that can be displayed on the parcel data screen if relevant."
          },
          "payment_mode": {
            "type": "string",
            "description": "Payment method used."
          },
          "claimer_email": {
            "type": "string",
            "description": "Email of the claim manager if different from the one who subscribes."
          },
          "content": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "protection_id": {
            "type": "string"
          },
          "covered_value": {
            "type": "number"
          },
          "user_email": {
            "type": "string"
          },
          "tracking_status": {
            "type": "string",
            "nullable": true,
            "description": "Current tracking status of the parcel. Updated automatically via Ship24.\n",
            "enum": [
              "info_received",
              "in_transit",
              "out_for_delivery",
              "failed_attempt",
              "delivered",
              "available_for_pickup",
              "exception",
              "expired",
              "pending",
              "unknown"
            ]
          },
          "tracking_last_update": {
            "type": "string",
            "nullable": true,
            "description": "Timestamp of the last tracking status update (ISO 8601 format).\n",
            "example": "2026-03-01T14:30:00.000Z"
          }
        }
      }
    }
  }
}