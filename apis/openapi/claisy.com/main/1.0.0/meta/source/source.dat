                    "sender_first_name": {
                      "type": "string"
                    },
                    "sender_last_name": {
                      "type": "string"
                    },
                    "sender_address": {
                      "type": "string"
                    },
                    "sender_zipcode": {
                      "type": "string"
                    },
                    "sender_city": {
                      "type": "string"
                    },
                    "sender_country": {
                      "type": "string"
                    },
                    "recipient_company": {
                      "type": "string"
                    },
                    "recipient_first_name": {
                      "type": "string"
                    },
                    "recipient_last_name": {
                      "type": "string"
                    },
                    "recipient_address": {
                      "type": "string"
                    },
                    "recipient_zipcode": {
                      "type": "string"
                    },
                    "recipient_city": {
                      "type": "string"
                    },
                    "recipient_country": {
                      "type": "string"
                    },
