          "name"
        ],
        "properties": {
          "company_id": {
            "type": "integer",
            "description": "Target company ID."
          },
          "name": {
            "type": "string",
            "description": "Form name."
          },
          "questions": {
            "type": "array",
            "description": "Array of question IDs to attach to this form.",
            "items": {
              "type": "integer"
            }
          }
        },
        "additionalProperties": false
