    "/messages": {
      "get": {
        "tags": [
          "Messages"
        ],
        "summary": "List messages by mail account",
        "operationId": "listAccountMessages",
        "parameters": [
          {
            "name": "from_account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the mail account (from `GET /companies/mail-accounts` or `GET /users/{user_id}/mail-accounts`)."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "scheduled",
                "sent",
                "all"
              ],
              "default": "all"
            },
            "description": "Filter by message status: `scheduled` (pending send), `sent` (delivered), `all` (both). Default: `all`."
          },
          {
            "name": "date_from",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Start of period (unix timestamp, seconds). Filters on scheduled/sent time."
          },
          {
            "name": "date_to",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "End of period (unix timestamp, seconds). Filters on scheduled/sent time."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number (1-based)."
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Number of items per page (1–100)."
          },
          {
            "$ref": "#/components/parameters/ViewQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of messages for the specified mail account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountMessageListResponse"
                },
                "example": {
                  "messages": [
                    {
                      "type": "mailbox",
                      "message": {
                        "id": 12345,
                        "from": "sender@example.com",
                        "to": "prospect@company.com",
                        "cc": "",
                        "subject": "Exciting opportunity",
                        "body": "<p>Hi, I found your profile...</p>",
                        "date": "Apr 09, 2026 10:00 AM",
                        "attachments": [

                        ],
                        "schedule": "",
                        "opensCount": 2,
                        "opens": [

                        ],
                        "autoJobId": "",
                        "isNurtured": false
                      }
                    }
                  ],
                  "pagination": {
                    "page_size": 20,
                    "page_count": 7,
                    "page": 1,
                    "total_count": 134
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "description": "Returns messages sent or scheduled from a specific mail account. Useful for monitoring cold outreach campaigns — check pending queue, delivery history, and plan next sends. Only returns outbound messages (sent and scheduled), not received."
      }
    },
