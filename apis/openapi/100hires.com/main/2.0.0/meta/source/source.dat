                      "name": "Applied",
                      "order": 1
                    },
                    {
                      "id": 11,
                      "name": "Interview",
                      "order": 2
                    },
                    {
                      "id": 12,
                      "name": "Offer",
                      "order": 3
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
