                    "cc": "",
                    "subject": "Interview invitation — Senior Engineer",
                    "body": "<p>Hi Alice, we'd like to invite you for an interview.</p>",
                    "date": "Mar 22, 2024 09:00 AM",
                    "attachments": [

                    ],
                    "schedule": {
                      "senderId": 1,
