                "value": 1778457600,
                "summary": "Unix timestamp (seconds)"
              },
              "iso8601": {
                "value": "2026-05-11T00:00:00Z",
                "summary": "ISO-8601 UTC"
              }
            }
          },
          {
            "name": "created_at_end",
            "in": "query",
            "description": "Return only jobs created at or before this time. Accepts a Unix timestamp in seconds (not milliseconds) or an ISO-8601 string with timezone offset (e.g. `2026-05-11T00:00:00Z`, `2026-05-11T00:00:00.123+03:00`). Fractional seconds are accepted but truncated to whole seconds.",
            "schema": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string"
                }
              ]
            },
            "examples": {
              "unix": {
                "value": 1778457600,
                "summary": "Unix timestamp (seconds)"
              },
              "iso8601": {
                "value": "2026-05-11T00:00:00Z",
                "summary": "ISO-8601 UTC"
              }
            }
          },
          {
            "name": "updated_after",
            "in": "query",
            "description": "Return only jobs updated at or after this time. Accepts a Unix timestamp in seconds (not milliseconds) or an ISO-8601 string with timezone offset (e.g. `2026-05-11T00:00:00Z`, `2026-05-11T00:00:00.123+03:00`). Fractional seconds are accepted but truncated to whole seconds. Use for incremental sync.",
            "schema": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
