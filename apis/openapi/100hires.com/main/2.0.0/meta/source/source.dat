              "string",
              "null"
            ],
            "description": "Email of the company owner"
          },
          "company_owner_phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Phone number of the company owner"
          },
          "company_owner_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Full name of the company owner"
          }
        }
      },
      "CompanyListResponse": {
        "type": "object",
