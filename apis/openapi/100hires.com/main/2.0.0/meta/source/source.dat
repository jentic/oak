              }
            }
          }
        ]
      },
      "NurtureCampaignStepAssignTag": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NurtureCampaignStepBase"
          },
          {
            "type": "object",
            "required": [
              "tag_id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "assign_tag"
                ]
              },
              "tag_id": {
                "type": "integer",
