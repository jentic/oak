      "CareerSiteSettings": {
        "type": "object",
        "required": [
          "company_id",
          "language"
        ],
        "properties": {
          "company_id": {
            "type": "integer",
            "description": "ID of the company these settings belong to."
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "example": "de-DE",
            "description": "Locale the public career site renders in. Null means no language is picked and the site renders in en-US. A job may override it through the `language` field of the Job resource."
          }
        }
      },
      "CareerSiteSettingsUpdateRequest": {
        "type": "object",
        "properties": {
          "language": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 35,
            "example": "de-DE",
            "description": "Locale the public career site renders in (e.g. de-DE; underscore aliases like de_DE are normalized). Omit the field to leave the current setting untouched; send null to clear it and fall back to en-US. Unknown, disabled, empty and longer-than-35-character values are rejected with a 400 validation error on `language`. Available locales come from GET /languages."
          }
        },
        "additionalProperties": false
      },
