            "description": "Board display name."
          },
          "indeed_posting_url": {
            "type": "string",
            "nullable": true,
            "description": "Public Indeed posting URL when the job has been sourced/posted to Indeed; null otherwise. Populated only for the Indeed board."
          },
          "ziprecruiter_posting_url": {
            "type": "string",
            "nullable": true,
            "description": "Public ZipRecruiter posting URL (the API `preview_url`) when the job has been posted to ZipRecruiter; null otherwise. Populated only for the ZipRecruiter board."
          }
        }
      },
      "JobBoardsResponse": {
        "type": "object",
        "required": [
          "boards"
        ],
        "properties": {
          "boards": {
            "type": "array",
            "description": "Array of job boards for this job.",
            "items": {
              "$ref": "#/components/schemas/JobBoardItem"
            }
          }
        }
      },
      "BatchJobBoardsRequest": {
        "type": "object",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "description": "Array of job IDs.",
            "items": {
              "type": "integer"
            }
          },
          "boards": {
            "type": "array",
            "description": "Array of board IDs.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "BatchJobBoardsResponse": {
        "type": "object",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
