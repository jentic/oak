    "/notification-messages/{id}": {
      "get": {
        "tags": [
          "Notification Messages"
        ],
        "summary": "Get notification message",
        "operationId": "getNotificationMessage",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationMessage"
                },
                "example": {
                  "id": 70001,
                  "from": "notifications@example.com",
                  "to": "john.doe@example.com",
                  "subject": "Update on your application",
                  "body": "<p>Thank you for applying. Unfortunately we have decided to move forward with other candidates.</p>",
                  "date": "Mar 22, 2024 09:00 AM",
                  "schedule": {
                    "id": 8801,
                    "isScheduled": true,
                    "isFailed": false,
                    "humanDatetime": "Mar 22, 2024 09:00 AM",
                    "isNotificationMessage": true
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "description": "Returns a notification email message (e.g. rejection email) by its ID, including subject, body, sender, recipient, and schedule metadata."
      },
      "put": {
        "tags": [
          "Notification Messages"
        ],
        "summary": "Update notification message",
