              "schema": {
                "$ref": "#/components/schemas/NotificationMessageUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated notification message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationMessage"
                },
                "example": {
                  "id": 70001,
                  "from": "notifications@example.com",
                  "to": "john.doe@example.com",
                  "subject": "Update on your application (revised)",
                  "body": "<p>Thank you for your interest. We'd like to keep your profile on file for future roles.</p>",
                  "date": "Mar 22, 2024 09:00 AM",
                  "schedule": {
                    "id": 8801,
                    "isScheduled": true,
                    "isFailed": false,
                    "humanDatetime": "Mar 24, 2024 09:00 AM",
