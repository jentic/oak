          }
        }
      },
      "UserActivity": {
        "description": "One user-activity feed item (#3980). `event_id`/`type`/`occurred_at` are always present; the rest of the object is the per-type payload. `candidate`/`job` references are the STANDARD summary payloads (the same objects /candidates and /jobs return). With `view=summary` the heavy bodies (email body, SMS body, note text, call transcription text) are replaced by 200-character `*_preview` twins. When the source record behind `email`/`sms`/`note`/`call` was hard-deleted, that key is `null` and `content: missed` marks the degradation — the item itself is never dropped.\n",
        "oneOf": [
          {
            "$ref": "#/components/schemas/UserActivityCandidateAdded"
          },
          {
            "$ref": "#/components/schemas/UserActivityJobCreated"
          },
          {
            "$ref": "#/components/schemas/UserActivityStageMoved"
          },
          {
            "$ref": "#/components/schemas/UserActivityDisqualified"
          },
          {
            "$ref": "#/components/schemas/UserActivityEmailSent"
          },
          {
            "$ref": "#/components/schemas/UserActivitySmsSent"
          },
          {
            "$ref": "#/components/schemas/UserActivityCallLogged"
          },
          {
            "$ref": "#/components/schemas/UserActivityNoteAdded"
          }
        ]
      },
      "UserActivityBase": {
        "type": "object",
        "required": [
          "event_id",
          "type",
          "occurred_at"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "description": "Deterministic event UUID from the reporting event store."
          },
          "type": {
            "type": "string",
            "description": "Activity type identifier."
          },
          "occurred_at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp (seconds, UTC) of when the action happened."
          }
        }
      },
      "UserActivityCandidateRef": {
        "description": "The STANDARD candidate object in summary view — the same shape /candidates returns (the Candidate schema without `profile`). An {id}-only stub when the candidate is hard-deleted; null when the event carries no candidate.\n",
        "oneOf": [
          {
            "$ref": "#/components/schemas/Candidate"
          },
          {
            "type": "object",
            "description": "Hard-deleted candidate stub.",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "UserActivityJobRef": {
        "description": "The STANDARD job object in summary view — the same shape /jobs returns (the Job schema without `description`). An {id}-only stub when the job is hard-deleted; null when the event carries no job.\n",
        "oneOf": [
          {
            "$ref": "#/components/schemas/Job"
          },
          {
            "type": "object",
            "description": "Hard-deleted job stub.",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "UserActivityStageRef": {
        "type": [
          "object",
          "null"
        ],
        "description": "Pipeline stage reference. Null when absent; hard-deleted stages render as \"Stage",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "UserActivityCandidateAdded": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user created a candidate.",
            "required": [
              "candidate"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "candidate_added"
                ]
              },
              "candidate": {
                "$ref": "#/components/schemas/UserActivityCandidateRef"
              }
            }
          }
        ]
      },
      "UserActivityJobCreated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user created a job.",
            "required": [
              "job"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "job_created"
                ]
              },
              "job": {
                "$ref": "#/components/schemas/UserActivityJobRef"
              }
            }
          }
        ]
      },
      "UserActivityStageMoved": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user moved a candidate between pipeline stages. `type: hired` is the same shape — a move into the hired stage.",
            "required": [
              "candidate",
              "application_id",
              "job",
              "from_stage",
              "to_stage"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stage_moved",
                  "hired"
                ]
              },
              "candidate": {
                "$ref": "#/components/schemas/UserActivityCandidateRef"
              },
              "application_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "job": {
                "$ref": "#/components/schemas/UserActivityJobRef"
              },
              "from_stage": {
                "$ref": "#/components/schemas/UserActivityStageRef"
              },
              "to_stage": {
                "$ref": "#/components/schemas/UserActivityStageRef"
              }
            }
          }
        ]
      },
      "UserActivityDisqualified": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user disqualified a candidate.",
            "required": [
              "candidate",
              "application_id",
              "job",
              "reason"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "disqualified"
                ]
              },
              "candidate": {
                "$ref": "#/components/schemas/UserActivityCandidateRef"
              },
              "application_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "job": {
                "$ref": "#/components/schemas/UserActivityJobRef"
              },
              "reason": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Disqualification reason — the same {id, name} shape /rejection-reasons returns; `name` is null when the reason is hard-gone; the whole object is null when none was recorded.",
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "UserActivityEmailSent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user manually sent an email (automation/nurture sends are excluded from the feed).",
            "required": [
              "candidate",
              "message_id",
              "email"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "email_sent"
                ]
              },
              "candidate": {
                "$ref": "#/components/schemas/UserActivityCandidateRef"
              },
              "application_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "message_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Mail message ID."
              },
              "email": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The full message object (same shape as the messages API: subject, body, from, to, date, …). With `view=summary` the `body` is replaced by a 200-character `body_preview`. Null with `content: missed` when the message was hard-deleted.\n"
              },
              "content": {
                "type": "string",
                "enum": [
                  "missed"
                ],
                "description": "Present only when the source message no longer exists."
              }
            }
          }
        ]
      },
      "UserActivitySmsSent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user manually sent an SMS (automation/nurture sends are excluded from the feed).",
            "required": [
              "candidate",
              "message_id",
              "sms"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "sms_sent"
                ]
              },
              "candidate": {
                "$ref": "#/components/schemas/UserActivityCandidateRef"
              },
              "message_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Texting message ID."
              },
              "sms": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The STANDARD texting message object — the same inner `message` object the candidate messages API returns for `type: texting` (id, body, date, delivery/error state, recipient). With `view=summary` `body` becomes a 200-character `body_preview`. Null with `content: missed` when the message was hard-deleted.\n"
              },
              "content": {
                "type": "string",
                "enum": [
                  "missed"
                ],
                "description": "Present only when the source message no longer exists."
              }
            }
          }
        ]
      },
      "UserActivityCallLogged": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user placed an outbound Twilio call.",
            "required": [
              "candidate",
              "call_id",
              "duration_seconds",
              "call"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "call_logged"
                ]
              },
              "candidate": {
                "$ref": "#/components/schemas/UserActivityCandidateRef"
              },
              "call_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "duration_seconds": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Call duration in seconds."
              },
              "call": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Call details (same shape as the candidate activities call event: from/to labels, human-readable status like \"Completed\", formatted duration, recording attachment and transcription when available). With `view=summary` the transcription text becomes `text_preview`. Null with `content: missed` when the call record was hard-deleted.\n"
              },
              "content": {
                "type": "string",
                "enum": [
                  "missed"
                ],
                "description": "Present only when the source call no longer exists."
              }
            }
          }
        ]
      },
      "UserActivityNoteAdded": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserActivityBase"
          },
          {
            "type": "object",
            "description": "The user added a note (comment) on a candidate.",
            "required": [
              "candidate",
              "note_id",
              "note",
              "application_id",
              "job"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "note_added"
                ]
              },
              "candidate": {
                "$ref": "#/components/schemas/UserActivityCandidateRef"
              },
              "note_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "note": {
                "description": "The STANDARD note object — the same shape /notes returns, `user` included. With `view=summary` `body` becomes `body_preview`. Null with `content: missed` when the note was hard-deleted.\n",
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Note"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "application_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Application the note was left in the context of, when any."
              },
              "job": {
                "$ref": "#/components/schemas/UserActivityJobRef"
              },
              "content": {
                "type": "string",
                "enum": [
                  "missed"
                ],
                "description": "Present only when the source comment no longer exists."
              }
            }
          }
        ]
      },
