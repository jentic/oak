{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Exchange Rates API",
    "description": "Provides real-time and historical exchange rates for 170+ currencies. Uses App ID for authentication via query parameter.",
    "version": "0.7.0",
    "x-jentic-source-url": "https://docs.openexchangerates.org/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://openexchangerates.org/api"
    }
  ],
  "security": [
    {
      "appId": []
    }
  ],
  "paths": {
    "/latest.json": {
      "get": {
        "operationId": "getLatestRates",
        "summary": "Get latest exchange rates for all or specified currencies",
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": true,
            "description": "Your unique App ID",
            "schema": { "type": "string" }
          },
          {
            "name": "base",
            "in": "query",
            "description": "Base currency (3-letter code, default: USD). Paid plans only.",
            "schema": { "type": "string", "default": "USD" }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated list of currency codes to limit results",
            "schema": { "type": "string" }
          },
          {
            "name": "prettyprint",
            "in": "query",
            "description": "Set to false to reduce response size",
            "schema": { "type": "boolean", "default": true }
          },
          {
            "name": "show_alternative",
            "in": "query",
            "description": "Include alternative, black market, and digital currency rates",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing App ID"
          },
          "403": {
            "description": "Access restricted (feature not available on current plan)"
          }
        }
      }
    },
    "/historical/{date}.json": {
      "get": {
        "operationId": "getHistoricalRates",
        "summary": "Get historical exchange rates for a specific date",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "description": "Date in YYYY-MM-DD format",
            "schema": { "type": "string", "format": "date", "example": "2024-01-15" }
          },
          {
            "name": "app_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "base",
            "in": "query",
            "description": "Base currency (3-letter code, default: USD)",
            "schema": { "type": "string", "default": "USD" }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated list of currency codes",
            "schema": { "type": "string" }
          },
          {
            "name": "prettyprint",
            "in": "query",
            "schema": { "type": "boolean" }
          },
          {
            "name": "show_alternative",
            "in": "query",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing App ID"
          }
        }
      }
    },
    "/currencies.json": {
      "get": {
        "operationId": "getCurrencies",
        "summary": "Get list of all available currency codes and names",
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "prettyprint",
            "in": "query",
            "schema": { "type": "boolean" }
          },
          {
            "name": "show_alternative",
            "in": "query",
            "description": "Include alternative currencies",
            "schema": { "type": "boolean" }
          },
          {
            "name": "show_inactive",
            "in": "query",
            "description": "Include historical/inactive currencies",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Currency codes and names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "example": {
                    "USD": "United States Dollar",
                    "EUR": "Euro",
                    "GBP": "British Pound Sterling"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/time-series.json": {
      "get": {
        "operationId": "getTimeSeries",
        "summary": "Get exchange rates for a date range (time series)",
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "description": "Start date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "description": "End date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "base",
            "in": "query",
            "schema": { "type": "string", "default": "USD" }
          },
          {
            "name": "symbols",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "prettyprint",
            "in": "query",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Time series of exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "disclaimer": { "type": "string" },
                    "license": { "type": "string" },
                    "start_date": { "type": "string" },
                    "end_date": { "type": "string" },
                    "base": { "type": "string" },
                    "rates": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/convert/{value}/{from}/{to}": {
      "get": {
        "operationId": "convertCurrency",
        "summary": "Convert a value between two currencies",
        "parameters": [
          {
            "name": "value",
            "in": "path",
            "required": true,
            "description": "Amount to convert",
            "schema": { "type": "number" }
          },
          {
            "name": "from",
            "in": "path",
            "required": true,
            "description": "Source currency code",
            "schema": { "type": "string" }
          },
          {
            "name": "to",
            "in": "path",
            "required": true,
            "description": "Target currency code",
            "schema": { "type": "string" }
          },
          {
            "name": "app_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversion result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "disclaimer": { "type": "string" },
                    "license": { "type": "string" },
                    "request": {
                      "type": "object",
                      "properties": {
                        "query": { "type": "string" },
                        "amount": { "type": "number" },
                        "from": { "type": "string" },
                        "to": { "type": "string" }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "timestamp": { "type": "integer" },
                        "rate": { "type": "number" }
                      }
                    },
                    "response": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage.json": {
      "get": {
        "operationId": "getUsage",
        "summary": "Get API usage statistics for your App ID",
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Usage statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "app_id": { "type": "string" },
                        "status": { "type": "string" },
                        "plan": {
                          "type": "object",
                          "properties": {
                            "name": { "type": "string" },
                            "quota": { "type": "string" },
                            "update_frequency": { "type": "string" },
                            "features": { "type": "object" }
                          }
                        },
                        "usage": {
                          "type": "object",
                          "properties": {
                            "requests": { "type": "integer" },
                            "requests_quota": { "type": "integer" },
                            "requests_remaining": { "type": "integer" },
                            "days_elapsed": { "type": "integer" },
                            "days_remaining": { "type": "integer" },
                            "daily_average": { "type": "number" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RatesResponse": {
        "type": "object",
        "properties": {
          "disclaimer": { "type": "string" },
          "license": { "type": "string" },
          "timestamp": { "type": "integer", "description": "UNIX timestamp in UTC" },
          "base": { "type": "string", "description": "Base currency code" },
          "rates": {
            "type": "object",
            "additionalProperties": { "type": "number" },
            "description": "Currency code to exchange rate mapping"
          }
        }
      }
    },
    "securitySchemes": {
      "appId": {
        "type": "apiKey",
        "name": "app_id",
        "in": "query",
        "description": "Open Exchange Rates App ID"
      }
    }
  }
}
