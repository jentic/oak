      "post": {
        "operationId": "createItem",
        "summary": "Create item",
        "tags": [
          "Items"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item created"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/zapier/ZapierComment/create": {
      "post": {
        "operationId": "createComment",
