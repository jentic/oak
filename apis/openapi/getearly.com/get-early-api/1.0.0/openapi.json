    "/api/zapier/ZapierFolder/trigger": {
      "get": {
        "operationId": "listFolderTriggers",
        "summary": "List folders",
        "tags": [
          "Folders"
        ],
        "responses": {
          "200": {
            "description": "Folders"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
