{
  "openapi": "3.0.3",
  "info": {
    "title": "Get Early API",
    "version": "1.0.0",
    "description": "Get Early is a project management platform. The API provides endpoints for managing projects, blueprints, items, modules, comments, folders, users, and webhook subscriptions.",
    "x-jentic-source-url": "https://api.getearly.com/swagger/v1/swagger.json"
  },
  "servers": [
    {
      "url": "https://api.getearly.com"
    }
  ],
  "paths": {
    "/api/zapier/ZapierAuth": {
      "get": {
        "operationId": "authenticate",
        "summary": "Authenticate",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Authentication successful"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/zapier/ZapierProject/trigger": {
      "get": {
        "operationId": "listProjectTriggers",
        "summary": "List project triggers",
        "tags": [
          "Projects"
        ],
        "responses": {
          "200": {
            "description": "Projects"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/zapier/ZapierProject/create": {
      "post": {
        "operationId": "createProject",
        "summary": "Create project",
        "tags": [
          "Projects"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project created"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/zapier/ZapierBlueprint/trigger": {
      "get": {
        "operationId": "listBlueprintTriggers",
        "summary": "List blueprints",
        "tags": [
          "Blueprints"
        ],
        "responses": {
          "200": {
            "description": "Blueprints"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
