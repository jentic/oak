      "get": {
        "operationId": "listItemTriggers",
        "summary": "List items",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "moduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
