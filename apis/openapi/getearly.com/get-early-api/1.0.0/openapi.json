        ],
        "responses": {
          "200": {
            "description": "Users"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/zapier/ZapierHook/subscribe": {
      "post": {
        "operationId": "subscribeWebhook",
        "summary": "Subscribe to webhook",
        "tags": [
          "Webhooks"
