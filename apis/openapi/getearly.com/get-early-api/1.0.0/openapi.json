  "components": {
    "schemas": {
      "ProjectCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "templateId": {
            "type": "string"
          }
        }
      },
      "ItemCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "moduleId"
        ]
      },
      "CommentCreate": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          }
        }
      },
      "WebhookSubscribe": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ]
