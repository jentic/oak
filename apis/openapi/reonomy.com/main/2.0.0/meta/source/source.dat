{
  "openapi": "3.0.3",
  "info": {
    "title": "Reonomy Property API",
    "description": "Commercial real estate property data API providing property search, property details, ownership information, and geolocation-based queries. Enables filtered property searches, individual and bulk property detail retrieval, parcel shape information, and batch job processing.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://api.reonomy.com/v2/docs/api/reference/"
  },
  "servers": [
    {
      "url": "https://api.reonomy.com/v2",
      "description": "Reonomy API v2 Production"
    }
  ],
  "paths": {
    "/property/search": {
      "post": {
        "operationId": "searchProperties",
        "summary": "Search for properties with filters",
        "description": "Search for commercial real estate properties using various filter criteria including asset type, location, ownership, building characteristics, and date ranges. Supports pagination and sorting.",
        "tags": ["Property Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertySearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful property search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertySearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or API credit limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/property/geo/search": {
      "post": {
        "operationId": "searchPropertiesByGeolocation",
        "summary": "Search properties by geolocation",
        "description": "Search for properties using geographic criteria including radius search around a point, polygon boundary, or bounding box coordinates.",
        "tags": ["Property Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeoSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful geolocation search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertySearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid geolocation parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/property/{propertyId}": {
      "get": {
        "operationId": "getPropertyDetails",
        "summary": "Get property details by ID",
        "description": "Retrieve detailed information about a specific property including building characteristics, tax assessments, sales history, and mortgage information.",
        "tags": ["Property Details"],
        "parameters": [
          {
            "name": "propertyId",
            "in": "path",
            "required": true,
            "description": "Unique Reonomy property identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude_pii",
            "in": "query",
            "required": false,
            "description": "Exclude personally identifiable information from the response",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful property detail retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid property ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Property not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/property/bulk": {
      "post": {
        "operationId": "getPropertyDetailsBulk",
        "summary": "Get details for multiple properties",
        "description": "Retrieve detailed information for multiple properties in a single request by providing an array of property IDs.",
        "tags": ["Property Details"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkPropertyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful bulk property detail retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkPropertyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/property/{propertyId}/ownership": {
      "get": {
        "operationId": "getPropertyOwnership",
        "summary": "Get property ownership information",
        "description": "Retrieve ownership details for a specific property including current owner, owner type, mailing address, and ownership history.",
        "tags": ["Property Details"],
        "parameters": [
          {
            "name": "propertyId",
            "in": "path",
            "required": true,
            "description": "Unique Reonomy property identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful ownership information retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnershipDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid property ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Property not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/property/{propertyId}/parcel": {
      "get": {
        "operationId": "getPropertyParcel",
        "summary": "Get property parcel shape information",
        "description": "Retrieve parcel boundary and shape information for a specific property in GeoJSON format.",
        "tags": ["Property Details"],
        "parameters": [
          {
            "name": "propertyId",
            "in": "path",
            "required": true,
            "description": "Unique Reonomy property identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful parcel shape retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParcelDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid property ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Property or parcel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/property/address/search": {
      "post": {
        "operationId": "resolvePropertyByAddress",
        "summary": "Resolve property by address",
        "description": "Find a specific property by providing a street address, city, state, and zip code for property resolution.",
        "tags": ["Property Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful address resolution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertySearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid address parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/property/parcel/geojson/search": {
      "post": {
        "operationId": "searchParcelsByGeoJson",
        "summary": "Search parcels by GeoJSON boundary",
        "description": "Search for property parcels within a GeoJSON polygon boundary. Returns parcel geometries and associated property identifiers.",
        "tags": ["Property Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeoJsonSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful parcel search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParcelSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid GeoJSON or search parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token obtained from Reonomy. Include as Bearer token in the Authorization header."
      }
    },
    "schemas": {
      "PropertySearchRequest": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "object",
            "description": "Search filter criteria",
            "properties": {
              "asset_type": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["office", "retail", "industrial", "multifamily", "hospitality", "mixed_use", "land", "special_purpose"]
                },
                "description": "Property asset type categories"
              },
              "state": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "US state abbreviations"
              },
              "city": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "City names"
              },
              "zip_code": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "ZIP codes"
              },
              "building_area_sqft": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "description": "Minimum building area in square feet"
                  },
                  "max": {
                    "type": "number",
                    "description": "Maximum building area in square feet"
                  }
                }
              },
              "lot_area_sqft": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              },
              "year_built": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer"
                  },
                  "max": {
                    "type": "integer"
                  }
                }
              },
              "sale_date": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "string",
                    "format": "date"
                  },
                  "max": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "assessed_value": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Page number for pagination"
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Number of results per page"
          },
          "sort_by": {
            "type": "string",
            "description": "Field to sort results by"
          },
          "sort_order": {
            "type": "string",
            "enum": ["asc", "desc"],
            "default": "asc",
            "description": "Sort direction"
          }
        }
      },
      "GeoSearchRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["radius", "polygon", "bounding_box"],
            "description": "Type of geographic search"
          },
          "center": {
            "type": "object",
            "description": "Center point for radius search",
            "properties": {
              "latitude": {
                "type": "number",
                "format": "double"
              },
              "longitude": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "radius_miles": {
            "type": "number",
            "description": "Search radius in miles (for radius search)"
          },
          "polygon": {
            "type": "object",
            "description": "GeoJSON polygon for polygon search",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Polygon"]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "bounding_box": {
            "type": "object",
            "description": "Bounding box coordinates",
            "properties": {
              "north": {
                "type": "number",
                "format": "double"
              },
              "south": {
                "type": "number",
                "format": "double"
              },
              "east": {
                "type": "number",
                "format": "double"
              },
              "west": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "filters": {
            "$ref": "#/components/schemas/PropertySearchRequest/properties/filters"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        },
        "required": ["type"]
      },
      "AddressSearchRequest": {
        "type": "object",
        "properties": {
          "street_address": {
            "type": "string",
            "description": "Street address line"
          },
          "city": {
            "type": "string",
            "description": "City name"
          },
          "state": {
            "type": "string",
            "description": "US state abbreviation"
          },
          "zip_code": {
            "type": "string",
            "description": "ZIP code"
          }
        },
        "required": ["street_address"]
      },
      "GeoJsonSearchRequest": {
        "type": "object",
        "properties": {
          "geometry": {
            "type": "object",
            "description": "GeoJSON geometry defining the search boundary",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Polygon", "MultiPolygon"]
              },
              "coordinates": {
                "type": "array",
                "items": {}
              }
            },
            "required": ["type", "coordinates"]
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        },
        "required": ["geometry"]
      },
      "BulkPropertyRequest": {
        "type": "object",
        "properties": {
          "property_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of Reonomy property identifiers"
          },
          "exclude_pii": {
            "type": "boolean",
            "default": false,
            "description": "Exclude personally identifiable information"
          }
        },
        "required": ["property_ids"]
      },
      "PropertySearchResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total number of matching properties"
          },
          "page": {
            "type": "integer",
            "description": "Current page number"
          },
          "page_size": {
            "type": "integer",
            "description": "Number of results per page"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySummary"
            }
          }
        }
      },
      "PropertySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reonomy property identifier"
          },
          "address": {
            "type": "string",
            "description": "Full property address"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip_code": {
            "type": "string"
          },
          "asset_type": {
            "type": "string",
            "description": "Property asset type classification"
          },
          "building_area_sqft": {
            "type": "number",
            "description": "Building area in square feet"
          },
          "lot_area_sqft": {
            "type": "number",
            "description": "Lot area in square feet"
          },
          "year_built": {
            "type": "integer"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "PropertyDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reonomy property identifier"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip_code": {
            "type": "string"
          },
          "county": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "building_area_sqft": {
            "type": "number"
          },
          "lot_area_sqft": {
            "type": "number"
          },
          "year_built": {
            "type": "integer"
          },
          "number_of_units": {
            "type": "integer"
          },
          "number_of_floors": {
            "type": "integer"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "zoning": {
            "type": "string"
          },
          "tax_assessment": {
            "type": "object",
            "properties": {
              "assessed_value": {
                "type": "number"
              },
              "land_value": {
                "type": "number"
              },
              "improvement_value": {
                "type": "number"
              },
              "tax_year": {
                "type": "integer"
              },
              "annual_tax_amount": {
                "type": "number"
              }
            }
          },
          "sales_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sale_date": {
                  "type": "string",
                  "format": "date"
                },
                "sale_price": {
                  "type": "number"
                },
                "buyer_name": {
                  "type": "string"
                },
                "seller_name": {
                  "type": "string"
                },
                "document_type": {
                  "type": "string"
                }
              }
            }
          },
          "mortgages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "lender_name": {
                  "type": "string"
                },
                "loan_type": {
                  "type": "string"
                },
                "interest_rate": {
                  "type": "number"
                },
                "maturity_date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      },
      "OwnershipDetail": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "current_owner": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "owner_type": {
                "type": "string",
                "enum": ["individual", "company", "trust", "government", "other"]
              },
              "mailing_address": {
                "type": "object",
                "properties": {
                  "street": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "zip_code": {
                    "type": "string"
                  }
                }
              },
              "acquisition_date": {
                "type": "string",
                "format": "date"
              },
              "portfolio_size": {
                "type": "integer",
                "description": "Number of properties in owner portfolio"
              }
            }
          },
          "ownership_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "owner_name": {
                  "type": "string"
                },
                "owner_type": {
                  "type": "string"
                },
                "start_date": {
                  "type": "string",
                  "format": "date"
                },
                "end_date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      },
      "ParcelDetail": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "parcel_id": {
            "type": "string",
            "description": "Assessor parcel number (APN)"
          },
          "geometry": {
            "type": "object",
            "description": "GeoJSON geometry of the parcel boundary",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Polygon", "MultiPolygon"]
              },
              "coordinates": {
                "type": "array",
                "items": {}
              }
            }
          },
          "area_sqft": {
            "type": "number",
            "description": "Parcel area in square feet"
          },
          "area_acres": {
            "type": "number",
            "description": "Parcel area in acres"
          }
        }
      },
      "ParcelSearchResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "parcels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParcelDetail"
            }
          }
        }
      },
      "BulkPropertyResponse": {
        "type": "object",
        "properties": {
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyDetail"
            }
          },
          "not_found": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Property IDs that were not found"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error description"
          }
        }
      }
    }
  }
}