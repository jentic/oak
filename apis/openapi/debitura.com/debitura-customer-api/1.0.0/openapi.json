{
  "openapi": "3.0.3",
  "info": {
    "title": "Debitura Customer API",
    "version": "1.0.0",
    "description": "Debitura is a debt collection platform. The API enables creating and managing collection cases, divisions, payments, contracts, coverage checks, and webhook subscriptions.",
    "x-jentic-source-url": "https://customer-api.debitura.com"
  },
  "servers": [
    {
      "url": "https://customer-api.debitura.com"
    }
  ],
  "paths": {
    "/cases": {
      "post": {
        "operationId": "createCase",
        "summary": "Create collection case",
        "tags": [
          "Cases"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Case created"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listCases",
        "summary": "List collection cases",
        "tags": [
          "Cases"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated cases list"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/cases/preview": {
      "post": {
        "operationId": "previewCase",
        "summary": "Preview case eligibility",
        "tags": [
          "Cases"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Eligibility preview"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/cases/{id}": {
      "get": {
        "operationId": "getCase",
