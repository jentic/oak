  "paths": {
    "/models/{modelId}": {
      "get": {
        "tags": [
          "Model"
        ],
        "summary": "Get Model Info.",
        "operationId": "GetModelInfo",
        "description": "Get model information.",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "description": "The model Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "The file version identifier, if not specified the latest version of the file is assumed.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Properties additionally to be included in the response.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "metadata"
                ]
              }
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-ModelVersionId": {
                "schema": {
                  "type": "string"
                },
                "description": "The actual model version identifier."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfoResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authorization information is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input validation Error: value is missing/null/invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "User has no permissions to execute this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The specified modelId/versionId was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Session is invalid/Gateway timeout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/models/{modelId}/owners": {
      "get": {
        "tags": [
          "Owners"
        ],
        "summary": "List owners",
        "operationId": "ListOwners",
        "description": "List owners in the model.",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "description": "The model Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "The file version identifier, if not specified the latest version of the file is assumed.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "The maximum number of items returned in a single response.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000,
              "default": 30000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The initial value to be fetched from the total result.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-ModelVersionId": {
                "schema": {
                  "type": "string"
                },
                "description": "The actual model version identifier."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnersResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authorization information is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
