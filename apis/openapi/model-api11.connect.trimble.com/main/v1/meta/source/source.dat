    "/models/{modelId}/entities/{entityId}": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "Get entity details by id.",
        "operationId": "GetEntityById",
        "description": "For a given entity Id returns entity details.",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "description": "The model Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "entityId",
            "in": "path",
            "description": "The identifier of the entity. Could be either external Id (prefixed by `id:`), connect Id (prefixed with `idc:`) or internal Id (prefixed by `idx:` ). If a value is passed without any prefix then it is evaluated based on the following precedence : connect Id, internal Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "The file version identifier, if not specified the latest version of the file is assumed.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Properties additionally to be included in the response. To include the property set names, both `pset` and `pset.name` must be passed.\n\nThis query parameter is deprecated, use `fields` instead.",
            "deprecated": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "idx",
                  "idc",
                  "psets",
                  "psets.name",
                  "boundingBox",
                  "product",
                  "hierarchyInfo",
                  "layerIds"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "fields",
            "in": "query",
            "description": "If specified only properties listed in this query parameter are included into response. The `id` property is always returned unless `idx` is explicitly specified. To include the property set names, both `psets` and `psets.name` must be passed otherwise only property values are returned. If not specified, then `idx` and `type` properties are returned by default. The `include` query parameter is ignored if `fields` query parameter is present. Comparing to `include` allows to return only identifiers, without including `type` property.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "idx",
                  "idc",
                  "type",
                  "psets",
                  "psets.name",
                  "boundingBox",
                  "product",
                  "hierarchyInfo",
                  "layerIds"
                ]
              }
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-ModelVersionId": {
                "schema": {
                  "type": "string"
                },
                "description": "The actual model version identifier."
              }
            },
            "content": {
              "application/json": {
