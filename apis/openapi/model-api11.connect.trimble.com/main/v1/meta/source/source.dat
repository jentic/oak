                "schema": {
                  "$ref": "#/components/schemas/BatchGetResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authorization information is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input validation Error: value is missing/null/invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "User has no permissions to execute this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The specified modelId/versionId was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Session is invalid/Gateway timeout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchGetErrorEntity": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The textual error code."
          },
          "message": {
            "type": "string",
            "description": "The error message."
          },
          "identifier": {
            "$ref": "#/components/schemas/EntityIdentifier"
          }
        },
        "description": "The error response corresponding to a specific identifier object to the client."
      },
      "BatchGetErrorIdx": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The textual error code."
          },
          "message": {
            "type": "string",
            "description": "The error message."
          },
          "identifier": {
            "$ref": "#/components/schemas/InternalIdentifier"
          }
        },
        "description": "The error response corresponding to a specific identifier object to the client."
      },
      "BatchGetErrors": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchGetErrorEntity"
            },
            "description": "The collection of errored entities."
          },
          "psetdefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchGetErrorIdx"
            },
            "description": "The collection of errored property set definitions."
          }
        },
        "description": "The collection of error in the BatchGet response."
      },
      "BatchGetRequest": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityIdentifier"
            },
            "description": "The collection of entity identifiers. The maximum number of supported items in a single request is 1000."
          },
          "psetdefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InternalIdentifier"
            },
            "description": "The collection of property set definition identifiers. The maximum number of supported items in a single request is 30000."
          }
        },
        "description": "The request body of the batch request to return resources by a list of identifiers."
      },
      "BatchGetResponse": {
        "type": "object",
        "properties": {
          "responses": {
            "$ref": "#/components/schemas/BatchGetResponses"
          },
          "errors": {
            "$ref": "#/components/schemas/BatchGetErrors"
          }
        },
        "description": "The response wrapper class of the batch request to return resources by a list of identifiers."
      },
      "BatchGetResponses": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelEntity"
            },
            "description": "The collection of entities."
          },
          "psetdefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySetDefinition"
            },
            "description": "The collection of property set definitions."
          }
        },
        "description": "The response body of the batch request to return resources by a list of identifiers."
      },
      "BoundingBox": {
        "required": [
          "center",
          "extents",
          "max",
          "min"
        ],
        "type": "object",
        "properties": {
          "min": {
            "$ref": "#/components/schemas/Vector3"
          },
          "max": {
            "$ref": "#/components/schemas/Vector3"
          },
          "extents": {
            "$ref": "#/components/schemas/Vector3"
          },
          "center": {
            "$ref": "#/components/schemas/Vector3"
          }
        },
        "description": "A bounding box in the 3D space. A bounding box can be specified either with the lower bounds and upper bounds (minimum corner and maximum corner) or with the center point and the extents."
      },
      "DateTimeCompareOptions": {
        "type": "object",
        "properties": {
          "maxDelta": {
            "type": "string",
            "description": "The acceptable duration tolerance when comparing datetime properties. If not specified a default tolerance is used.",
            "format": "iso8601",
            "example": "P1Y1M1DT1H1M1S",
            "pattern": "^P(?=\\d+[YMD])(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d+[HMS])(\\d+H)?(\\d+M)?(\\d+S)?)?$"
          }
        }
      },
      "InternalIdentifier": {
        "type": "object",
        "required": [
          "idx"
        ],
        "properties": {
          "idx": {
            "type": "integer",
            "description": "The index (AKA internal or runtime identifier)."
          }
        },
        "description": "Represents an internal identifier."
      },
      "EntityIdentifier": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The source (AKA external) identifier. Might have `id:` or `idx:` prefix."
          },
          "idx": {
            "type": "integer",
            "description": "The index (AKA internal or runtime identifier)."
          }
        },
        "description": "Represents an identifier (internal and external)."
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "The textual error code."
          },
          "message": {
            "type": "string",
            "description": "The error message."
          }
        },
        "description": "The error response body. Defines a standard for reporting errors to the client."
      },
      "HierarchyInfo": {
        "required": [
          "type",
          "count"
        ],
        "type": "object",
        "properties": {
          "type": {
            "minLength": 1,
            "type": "string",
            "description": "The hierarchy type."
          },
          "count": {
            "type": "integer",
            "description": "The count of entities below this(child entities count) in the hierarchy tree."
          }
        },
        "description": "Hierarchy type information."
      },
      "HierarchyRelation": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "description": "The Parent Id (external identifier) in the hierarchy structure. In case of the root hierarchy relations the value is `root`."
          },
          "childId": {
            "type": "string",
            "description": "The Child Id (external identifier) in the hierarchy structure."
          },
          "parentIdc": {
            "type": "string",
            "description": "The connect Parent Id in the hierarchy structure. In case of the root hierarchy relations the value is `root`."
          },
          "childIdc": {
            "type": "string",
            "description": "The connect Child Id in the hierarchy structure."
          },
          "parentIdx": {
            "type": "integer",
            "description": "The Parent Id (internal identifier) in the hierarchy structure. In case of the root hierarchy relations the value is `-1`."
          },
          "childIdx": {
            "type": "integer",
            "description": "The Child Id (internal identifier) in the hierarchy structure."
          },
          "type": {
            "type": "string",
            "description": "The hierarchy type it belongs to."
          }
        },
        "description": "A hierarchy relation of a given type between two model entities."
      },
      "HierarchyRelationsResponse": {
        "type": "object",
        "required": [
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HierarchyRelation"
            },
            "description": "The Collection of HierarchyRelation items."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response containing a collection of hierarchy relations."
      },
      "History": {
        "required": [
          "changeAction",
          "creationDate",
          "historyState",
          "idx",
          "lastModificationDate"
        ],
        "type": "object",
        "properties": {
          "idx": {
            "type": "integer",
            "description": "The identifier of the history event."
          },
          "creationDate": {
            "type": "string",
            "description": "The creation date of this version of model.",
            "format": "date-time"
          },
          "lastModificationDate": {
            "type": "string",
            "description": "The last modified date of this version of model.",
            "format": "date-time"
          },
          "changeAction": {
            "minLength": 1,
            "type": "string",
            "description": "The change action on this version of model."
          },
          "historyState": {
            "minLength": 1,
            "type": "string",
            "description": "The history state."
          }
        },
        "description": "A model history entry, describing a change/addition/deletion/etc. event in the history of the model."
      },
      "HistoryResponse": {
        "type": "object",
        "required": [
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/History"
            },
            "description": "The Collection of History items."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response which contains a collection of history objects."
      },
      "IdentifiersResponse": {
        "type": "object",
        "required": [
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The Collection of Identifier items."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response which contains a collection of model identifiers."
      },
      "Layer": {
        "required": [
          "idx",
          "name"
        ],
        "type": "object",
        "properties": {
          "idx": {
            "type": "integer",
            "description": "The index of the layer (AKA internal Id or runtime Id)."
          },
          "name": {
            "type": "string",
            "description": "The layer's name."
          }
        },
        "description": "Layer information."
      },
      "LayersResponse": {
        "type": "object",
        "required": [
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Layer"
            },
            "description": "The Collection of Layer objects."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response which contains a collection of model identifiers."
      },
      "Metadata": {
        "required": [
          "key",
          "value"
        ],
        "type": "object",
        "properties": {
          "key": {
            "minLength": 1,
            "type": "string",
            "description": "The metadata's key."
          },
          "value": {
            "type": "string",
            "description": "The metadata's value."
          }
        },
        "description": "Hierarchy type information."
      },
      "ModelEntitiesResponse": {
        "type": "object",
        "required": [
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelEntity"
            },
            "description": "The Collection of ModelEntity items."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response which contains a collection of model entities."
      },
      "ModelEntity": {
        "type": "object",
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string",
            "description": "The entity's source (AKA external) identifier."
          },
          "idc": {
            "minLength": 1,
            "type": "string",
            "description": "The entity's connect identifier. Equal to source identifier if it exists, otherwise generated from the geometry. The generated identifier is not guaranteed to be stable, but in most cases it is."
          },
          "idx": {
            "type": "integer",
            "description": "The entity's index (AKA internal or runtime identifier)."
          },
          "type": {
            "minLength": 1,
            "type": "string",
            "description": "The Entity type."
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "psets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySet"
            },
            "description": "The property sets for the entity."
          },
          "boundingBox": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "hierarchyInfo": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HierarchyInfo"
            },
            "description": "The Array of all the hierarchy types the entity is part of and the count of children under each type."
          },
          "layerIds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "The Ids of layers to which the entity belongs. Note that if the collection of layer Ids can also be used to determine whether the entity has geometry (at least one layer Id exists) or not (the collection of layer Ids is empty)."
          }
        },
        "description": "A model entity, which is the basic group of information in a model. It can represent a 3D construction element (such as a wall, column, pipe, etc.) as well as invisible grouping elements, hierarchies, etc."
      },
      "QueryEntitiesRequest": {
        "type": "object",
        "properties": {
          "psets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySetQuery"
            },
            "description": "The Property Set details to query the model."
          },
          "product": {
            "$ref": "#/components/schemas/ProductQuery"
          },
          "tolerances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tolerances"
            },
            "description": "The list of tolerances to be applied on various property type while comparing their values."
          }
        },
        "description": "The request body used to query the model entities by one or more filter criteria passed through property set name, property name, property value, product name, product description and object type of the product. Each element of the `psets.items` array and `product` is treated as a separate filter criteria and only those entities are returned, which satisfy **all** the preceding filter criteria. If any filter criteria is not provided or is empty, that filter criteria is ignored, and the next filter criteria in the filters precedence order is evaluated. In addition, the request can also define the tolerance limit for comparing property values of every property type. These are passed as `absolute` for floating point types and as `compare` for string type. The service also maintains a default set of absolute tolerances for some of the property types. The tolerance specified as part of the request body will have a higher precedence over the service level default tolerances."
      },
      "ModelInfoResponse": {
        "required": [
          "entityCount",
          "hierarchyCount",
          "hierarchyTypes",
          "historyCount",
          "id",
          "ownerCount",
          "productCount",
          "psetDefCount",
          "layerCount",
          "trbSize",
          "versionId"
        ],
        "type": "object",
        "properties": {
          "trbSize": {
            "type": "integer",
            "description": "The TRB model size in bytes."
          },
          "id": {
            "minLength": 1,
            "type": "string",
            "description": "The model Id."
          },
          "versionId": {
            "minLength": 1,
            "type": "string",
            "description": "The versionId of the model."
          },
          "ownerCount": {
            "type": "integer",
            "description": "The total number of owners in the model."
          },
          "historyCount": {
            "type": "integer",
            "description": "The total number of History in the model."
          },
          "psetDefCount": {
            "type": "integer",
            "description": "The total number of property sets in the model."
          },
          "hierarchyCount": {
            "type": "integer",
            "description": "The total number of hierarchy relations in the model."
          },
          "productCount": {
            "type": "integer",
            "description": "The total number of products in the model."
          },
          "entityCount": {
            "type": "integer",
            "description": "The total number of entities in the model."
          },
          "layerCount": {
            "type": "integer",
            "description": "The total number of layers in the model."
          },
          "hierarchyTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HierarchyInfo"
            },
            "description": "Information about the hierarchy types in the model."
          },
          "metadata": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Metadata"
            },
            "description": "Metadata about the model."
          }
        },
        "description": "Information about a model."
      },
      "Owner": {
        "required": [
          "idx",
          "personId"
        ],
        "type": "object",
        "properties": {
          "idx": {
            "type": "integer",
            "description": "The Owner index (AKA internal Id or runtime Id)."
          },
          "personId": {
            "minLength": 1,
            "type": "string",
            "description": "The Person Id."
          },
          "personFamilyName": {
            "type": "string",
            "description": "The Person's family name."
          },
          "personGivenName": {
            "type": "string",
            "description": "The Person's given name."
          },
          "personMiddleNames": {
            "type": "string",
            "description": "The Person's middle names."
          },
          "personRoles": {
            "type": "string",
            "description": "The Person's roles."
          },
          "organizationId": {
            "type": "string",
            "description": "The Organization Id of the owner."
          },
          "organizationName": {
            "type": "string",
            "description": "The Organization name of the owner."
          },
          "organizationDescription": {
            "type": "string",
            "description": "The Organization description."
          },
          "organizationRoles": {
            "type": "string",
            "description": "The Organization roles."
          },
          "applicationVersion": {
            "type": "string",
            "description": "The Application version."
          },
          "applicationFullName": {
            "type": "string",
            "description": "The Application full name."
          },
          "applicationIdentifier": {
            "type": "string",
            "description": "The Application identifier."
          }
        },
        "description": "Owner information."
      },
      "OwnersResponse": {
        "type": "object",
        "required": [
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Owner"
            },
            "description": "The Collection of Owner items."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response which contains a collection of owners."
      },
      "Product": {
        "required": [
          "historyIdx",
          "name",
          "ownerIdx"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string",
            "description": "The name."
          },
          "description": {
            "type": "string",
            "description": "The description."
          },
          "objectType": {
            "type": "string",
            "description": "The object type."
          },
          "ownerIdx": {
            "type": "integer",
            "description": "The owner index (the internal Id or runtime Id of the owner) of the product."
          },
          "historyIdx": {
            "type": "integer",
            "description": "The index (the internal Id or runtime Id) of the history event the product is related to."
          }
        },
        "description": "Product information."
      },
      "ProductQuery": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name."
          },
          "description": {
            "type": "string",
            "description": "The description."
          },
          "objectType": {
            "type": "string",
            "description": "The object type."
          }
        },
        "description": "A structure used to query the model entities by its product name, description and object type. This filter can be specified individually i.e only (name or description or type) or as combination of two or more (name & description; name & type; name, description & type etc.). If more than one product property is specified then only entities having all the properties of the product are returned."
      },
      "Property": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name."
          },
          "value": {
            "type": "string",
            "description": "The value."
          }
        },
        "description": "A property of a model entity to search for by name and value."
      },
      "PropertyDefinition": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The property name.",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "The property data type.",
            "enum": [
              "lengthMeasure",
              "areaMeasure",
              "volumeMeasure",
              "massMeasure",
              "angleMeasure",
              "string",
              "integer",
              "number",
              "boolean"
            ]
          },
          "format": {
            "type": "string",
            "description": "The optional modifier for a property type.",
            "enum": [
              "date-time"
            ]
          },
          "nullable": {
            "type": "boolean",
            "description": "The optional modifier for a property type.",
            "default": false
          }
        },
        "description": "A single property schema definition including the name of the property and a data type."
      },
      "PropertySet": {
        "required": [
          "idx",
          "name",
          "values"
        ],
        "type": "object",
        "properties": {
          "idx": {
            "type": "integer",
            "description": "The pset index (internal identifier)."
          },
          "name": {
            "type": "string",
            "description": "The pset name."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ordered collection of property values in a property set. The position of the value in the array corresponds the position of property in the property set definition."
          }
        },
        "description": "A property set values."
      },
      "PropertySetDefinition": {
        "required": [
          "idx",
          "name",
          "props"
        ],
        "type": "object",
        "properties": {
          "idx": {
            "type": "integer",
            "description": "The identifier of the pset definition."
          },
          "name": {
            "minLength": 1,
            "type": "string",
            "description": "The property set name."
          },
          "props": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyDefinition"
            },
            "description": "The ordered collection of property items belonging to a property set."
          }
        },
        "description": "A property set definition, which is a data schema of the property set."
      },
      "PropertySetDefinitionsResponse": {
        "type": "object",
        "required": [
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySetDefinition"
            },
            "description": "The collection of property set definitions."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response which contains a collection of property set definitions."
      },
      "PropertySetQuery": {
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string",
            "description": "The name of the Property Set. Only entities having this property set name will be returned."
          },
          "props": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Property"
            },
            "description": "The array containing the individual Property Items belonging to the Property Set."
          }
        },
        "description": "A structure used to query the model entities by property set name, property name and property value. This property filter can be specified as one of the following: Property Set Name; Property Set Name and Property Name; Property Set Name, Property Name and Property value; One or more Property Set Names; One or more Property Names within a Property Set; Zero or one Property Value for any Property Name within a Property Set. If only Property Set Name is specified, entities having properties belonging to that property set are returned If both Property Set Name and Property Name are specified, entities with valid values for those properties are returned. If a Property Value is also specified with a propertyName within a Property Set, the entities having the Property Value and Name exactly matching the one specified in the filter for the given Property Set, are returned."
      },
      "QueryEntitiesResponse": {
        "type": "object",
        "required": [
          "tolerances",
          "items",
          "total",
          "count",
          "offset"
        ],
        "properties": {
          "tolerances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tolerances"
            },
            "description": "The tolerances that were applied for comparing the property values."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelEntity"
            },
            "description": "The Collection of ModelEntity items."
          },
          "offset": {
            "type": "integer",
            "description": "The offset of the first item returned in this page."
          },
          "offsetNext": {
            "type": "integer",
            "description": "The first item of the next page. If null, then this is the last page in the result set. If not null, then this value must be passed in the `offset` query parameter to fetch the next page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of items in the result set."
          },
          "count": {
            "type": "integer",
            "description": "The number of items on the current page."
          }
        },
        "description": "A response which contains a collection of model entities."
      },
      "Tolerances": {
        "type": "object",
        "properties": {
          "lengthMeasure": {
            "$ref": "#/components/schemas/NumberCompareOptions"
          },
          "areaMeasure": {
            "$ref": "#/components/schemas/NumberCompareOptions"
          },
          "volumeMeasure": {
            "$ref": "#/components/schemas/NumberCompareOptions"
          },
          "massMeasure": {
            "$ref": "#/components/schemas/NumberCompareOptions"
          },
          "angleMeasure": {
            "$ref": "#/components/schemas/NumberCompareOptions"
          },
          "number": {
            "$ref": "#/components/schemas/NumberCompareOptions"
          },
          "string": {
            "$ref": "#/components/schemas/StringCompareOptions"
          },
          "dateTime": {
            "$ref": "#/components/schemas/DateTimeCompareOptions"
          }
        },
        "description": "A structure used to specify the comparison options (e.g. tolerances) for property values of various types. Comparison options specified in the request will override the default service level comparison options and tolerance value. If for a property type the tolerance value is not specified in the request, then for that type the service level default tolerance value will be applied."
      },
      "NumberCompareOptions": {
        "type": "object",
        "properties": {
          "maxDelta": {
            "type": "number",
            "description": "The absolute tolerance when comparing numerical properties. If not specified a default tolerance is used specific for the property type.",
            "format": "double"
          }
        }
      },
      "StringCompareOptions": {
        "type": "object",
        "properties": {
          "compare": {
            "type": "string",
            "description": "The case sensitivity rule to be applied for string properties comparison. if not specified a case sensitive comparison is used by default.",
            "enum": [
              "caseSensitive",
              "caseInsensitive"
            ],
            "default": "caseSensitive"
          }
        }
      },
      "Vector3": {
        "type": "object",
        "required": [
          "x",
          "y",
          "z"
        ],
        "properties": {
          "x": {
            "type": "number",
            "description": "The X coordinate.",
            "format": "double"
          },
          "y": {
            "type": "number",
            "description": "The Y coordinate.",
            "format": "double"
          },
          "z": {
            "type": "number",
            "description": "The Z coordinate.",
            "format": "double"
          }
        },
        "description": "A vector in the 3D space."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "The Trimble ID access token.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
