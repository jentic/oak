    "/models/{modelId}/entities": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "List entities in the model.",
        "operationId": "ListEntities",
        "description": "Returns a list of entities in the model. <br/><br/> The result set can be filtered. <br/> If multiple filtering criteria is passed, they are all applied to the result set (combined with AND operator). <br/> If $filter query parameter is passed then all other filters (`text`, `hierarchyType`, `type`) are ignored. <br/><br/> If only entity identifiers are needed then use [ListIdentifiers](#/Entities/ListIdentifiers) endpoint that has similar capabilities, but optimized to return only entity identifiers.",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "description": "The model Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "The file version identifier, if not specified the latest version of the file is assumed.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "The maximum number of items returned on a single response page. If any additional properties are included in the response using the `include` or `fields` query parameters, then the maximum and default value for the `top` is reduced to 1000.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 100000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The initial value to be fetched from the total result.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Properties additionally to be included in the response.<br/> This query parameter is deprecated, use `fields` instead.<b/> To include the property set names, both `psets` and `psets.name` must be passed.",
            "deprecated": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "idx",
                  "idc",
                  "psets",
                  "psets.name",
                  "boundingBox",
                  "product",
                  "hierarchyInfo",
                  "layerIds"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "fields",
            "in": "query",
            "description": "If specified, only properties listed in this query parameter are included into response.<br> The `id` property is always returned unless `idx` is explicitly specified.<br/> To include the property set names, both `psets` and `psets.name` must be passed otherwise only property values are returned.<br/> If not specified, then `idx` and `type` properties are returned by default.<br/> The `include` query parameter is ignored if `fields` query parameter is present.<br/> Compared to `include` allows to return only identifiers, without including the `type` property.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "idx",
                  "idc",
                  "type",
                  "psets",
                  "psets.name",
                  "boundingBox",
                  "product",
                  "hierarchyInfo",
                  "layerIds"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "text",
            "in": "query",
            "description": "Free text search. Looks for the text (substring) in entity class name, product name/description/entity type, property set name, property name/value and return results matching the search criteria. Comparison is case insensitive. To search for boolean property types use `true`, `false` or `null` keywords. Numerical properties are also searched by matching a string representation of the property value to a given text.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "hierarchyType",
            "in": "query",
            "description": "If specified, only entities that belong to the given hierarchy are returned. If not specified, all entities are returned. If hierarchy is prefixed with `!` sign then entities that are NOT involved in the given hierarchy are returned. If only `!` is specified without a type then all that are not part of any hierarchy are returned (AKA orphans).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "If specified, only entities of the given type(s) are returned. Matching is done using exact case sensitive comparison. Multiple entity types may be listed in a comma-delimited list. If not specified, all entities are returned.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "$filter",
            "in": "query",
            "description": "The filter for the entities to return in [OData filter format](https://docs.oasis-open.org/odata/odata/v4.0/csprd01/part2-url-conventions/odata-v4.0-csprd01-part2-url-conventions.html#_Toc355091896). If the OData filter is specified then all other query parameters that apply additional filter criteria (`text`, `hierarchyType`, `type`) are ignored. <br/><br/> Supported [logical operators](https://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_LogicalOperators): `eq`, `ne`, `gt`, `ge`, `lt`, `le`, `or`, `and`, `not`. <br/> Precedence can be controlled with parenthesis as a [grouping operator](https://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_Grouping). <br/> Supported [string functions](https://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_StringandCollectionFunctions): `contains`, `indexof`, `substring` (both with single `start` parameter as well as with two `start` and `length` parameters), `trim`, `startswith`, `endswith`, `tolower`, `toupper`, `matchesPattern`, `length`. <br/> Supported [DateTimeOffset functions](http://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_DateandTimeFunctions): `year`, `month`, `day`, `hour`, `minute`, `second`, `millisecond`, `fractionalseconds`, `date`, `time`, `now`. <br/> Supported [Date functions](http://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_DateandTimeFunctions): `year`, `month`, `day`. <br/> Supported [TimeOfDay functions](http://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_DateandTimeFunctions): `hour`, `minute`, `second`, `millisecond`, `fractionalseconds`. <br/> Supported [Duration functions](http://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_DateandTimeFunctions): `hour`, `minute`, `second`, `millisecond`, `fractionalseconds`. <br/> Supported [Arithmetic functions](https://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_ArithmeticFunctions): `floor`, `ceiling`, `round`. <br/><br/> Properties supported on entity level: `idx`, `idc`, `type`, `layercount`,`hierarchycount`. <br/> A special `product` property set is recognized with `name`, `objectType` and `description` properties. <br/> Custom functions supported on entity level: `haslayerid`, `haslayer`, `ispartofhierarchy`. <br/><br/> Not supported: collection functions, arithmetic operators, geo functions, lambda operators. <br/> Nested functions are not generally supported with a few special cases used for the case insensitive string comparison as described below. <br/><br/> By default all string comparisons with `eq`, `ne`, `contains`, `startswith`, `endswith`, `indexof` are case sensitive. To make them case insensitive use `tolower` or `toupper` functions. For example:\n* `$filter=tolower(type) eq 'column'`\n* `$filter=contains(toupper(product/name),'ABC')`\n* `$filter=startswith(tolower(Tekla_x0020_Common/Class),'a')`\n* `$filter=endswith(tolower(Tekla_x0020_Common/Class),'z')`\n* `$filter=indexof(toupper(IfcMaterial/Material),'CONCRETE') gt 0`\n* `$filter=trim(toupper(IfcMaterial/Material)) eq 'CONCRETE'`\n* `$filter=substring(toupper(Tekla_x0020_Common/Class),5,2) eq 'AB'` <br/><br/>\n\nIn DateTimeOffset literals the time zone offset is mandatory (eg. `2025-05-05T05:05:05.005Z` and `2025-05-05T08:05:05%2B03:00` are valid, but `2025-05-05T05:05:05` is not valid). <br/><br/> Duration literals must be specified in [ISO 8601 format](https://en.wikipedia.org/wiki/ISO_8601#Durations) (eg. `P5DT12H30M30S` and `PT12H` are valid, but `12:30:15` is not valid). <br/><br/> To check the existence of the property set and property, compare them to `null` literal with `eq` and `ne` operators. <br/><br/> Any comparison to a not `null` value of a not existing property always returns `false`, regardless of the comparison operator. This might be confusing when using the `ne` operator and must be taken into account when constructing the queries, existence checks can be added to queries when needed. E.g. `$filter=Tekla_x0020_Common/DoesNotExist ne '123'` will return empty result if `Tekla_x0020_Common/DoesNotExist` property does not exist. <br/><br/> Special characters in property and property set names should be replaced with (encoded as) `_x####_`, where `####` is a 4 digit positive integer representing the hexadecimal character code of the special character. For example spaces (`' '`) should be replaced with (encoded as) `_x0020_` and forward slashes (`'/'`) should be replaced with (encoded as) `_x002F_`. <br/> Additionally the `+` character in DateTimeOffsets should be replaced with (encoded as) `%2B`. <br/><br/> Comparing floating point values with tolerance is possible through the usage of the `diff` function, for example: `diff(Tekla_x0020_Common/Volume, 10.5) le 0.001` <br/><br/> Example filters:\n* `$filter=type eq 'Column'`\n* `$filter=product/name eq 'Name 1'`\n* `$filter=Tekla_x0020_Common ne null` - returns entities that have 'Tekla Common' property set\n* `$filter=IfcMaterial/Material ne null` - returns entities that have 'Material' property in 'IfcMaterial' property set\n* `$filter=Tekla_x0020_Common/Class eq 'Class 1'`\n* `$filter=Tekla_x0020_Common/Volume lt 1.0`\n* `$filter=Tekla_x0020_Common/Class eq Class 1' and Tekla_x0020_Common/Volume ge 1.0`\n* `$filter=contains(IfcMaterial/Material, 'CONCRETE')`\n* `$filter=startswith(Tekla_x0020_Common/Class, 'Class')`\n* `$filter=endswith(Tekla_x0020_Common/Class, '9')`\n* `$filter=substring(Tekla_x0020_Common/Class,0,5) eq 'Class'`\n* `$filter=substring(Tekla_x0020_Common/Class,5) eq '1'`\n* `$filter=matchesPattern(Tekla_x0020_Common/Class, ''%5EC.*5$'')`- note %-encoding (`%5E`) for `^` character. Matches e.g. `Class5`, `Class 5` and `Class 15`.\n* `$filter=MetaData/CreationDate gt now() or MetaData/CreationDate eq 2025-05-05T05:05:05Z`\n* `$filter=year(MetaData/CreationDate) eq 2025 and month(MetaData/CreationDate) le 6`\n* `$filter=MetaData/Duration gt duration'P2D6H30M15S' or MetaData/Duration lt duration'PT2H'`\n* `$filter=haslayerid(1)`\n* `$filter=haslayer('Groundwork') or layercount eq 0`\n* `$filter=ispartofhierarchy('SpatialContainment') or hierarchycount eq 0`\n* `type eq 'Column' and diff(Tekla_x0020_Common/Volume, 10.5) le 0.001 and Tekla_x0020_Common/Area gt 5.0` ",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-ModelVersionId": {
                "schema": {
                  "type": "string"
                },
                "description": "The actual model version identifier."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelEntitiesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authorization information is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input validation Error: value is missing/null/invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "User has no permissions to execute this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The specified modelId/versionId was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Session is invalid/Gateway timeout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/models/{modelId}/entities/aggregate": {
      "get": {
        "tags": [
          "Entities"
        ],
        "summary": "Aggregate entities in the model.",
        "operationId": "AggregateEntities",
        "description": "Returns aggregated values for entities in the model based on the `$apply` transformation. <br/><br/> Supported transformations: <br/> - `aggregate`: Compute aggregated values across all entities or within groups <br/> - `groupby`: Group entities by one or more properties before aggregation <br/> - `filter`: Filter entities before applying aggregation (can be combined with other transformations) <br/><br/> Supported aggregation methods: <br/> - `$count`: Count of entities <br/> - `sum`: Sum of property values <br/> - `average`: Average of property values <br/> - `min`: Minimum property value <br/> - `max`: Maximum property value <br/><br/> Example queries:\n* `$apply=aggregate($count as Count)` - Count all entities\n* `$apply=groupby((type), aggregate($count as Count))` - Count entities by type\n* `$apply=groupby((type), aggregate(Tekla_x0020_Common/Volume with sum as TotalVolume))` - Sum volume by type\n* `$apply=groupby((type), aggregate($count as Count, Tekla_x0020_Common/Volume with average as AvgVolume))` - Multiple aggregations\n* `$apply=filter(type eq 'IFCBEAM')/aggregate(Tekla_x0020_Quantity/Length with max as MaxLength)` - Filter then aggregate\n* `$apply=filter(Tekla_x0020_Common/Volume gt 1.0)/groupby((type), aggregate($count as Count))` - Filter then group and count * `$apply=groupby((type), aggregate($count as Count))&$orderby=Count desc` - Group by type and sort by count (descending) ",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "description": "The model Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "The file version identifier, if not specified the latest version of the file is assumed.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "The maximum number of items returned on a single response page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 100000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The initial value to be fetched from the total result.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "$apply",
            "in": "query",
            "description": "The apply transformation for aggregation queries in [OData apply format](https://docs.oasis-open.org/odata/odata-data-aggregation-ext/v4.0/cs02/odata-data-aggregation-ext-v4.0-cs02.html).",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "$orderby",
            "in": "query",
            "description": "The orderby expression in [OData orderby format](https://docs.oasis-open.org/odata/odata/v4.01/cs01/part2-url-conventions/odata-v4.01-cs01-part2-url-conventions.html#sec_SystemQueryOptionorderby). <br/><br/> Sorts the aggregation results by: <br/> - Grouped properties (e.g., `type`) <br/> - Aggregated values using their aliases (e.g., `Count`, `TotalVolume`) <br/><br/> Use `asc` for ascending order (default) or `desc` for descending order. <br/> Multiple sort keys can be specified separated by commas. <br/><br/> Example queries:\n* `$apply=groupby((type), aggregate($count as Count))&$orderby=Count desc` - Group by type and sort by count (descending)\n* `$apply=groupby((type), aggregate($count as Count))&$orderby=type` - Group by type and sort by type name\n* `$apply=groupby((type), aggregate($count as Count, Tekla_x0020_Common/Volume with sum as TotalVolume))&$orderby=Count desc, type asc` - Multiple sort keys ",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-ModelVersionId": {
                "schema": {
                  "type": "string"
                },
                "description": "The actual model version identifier."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authorization information is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input validation Error: value is missing/null/invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "User has no permissions to execute this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
