    "/models/{modelId}/hierarchies": {
      "get": {
        "tags": [
          "Hierarchies"
        ],
        "summary": "Lists hierarchy relations",
        "operationId": "ListHierarchies",
        "description": "Lists all hierarchy relations in the model.",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "description": "The model Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "The file version identifier, if not specified the latest version of the file is assumed.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "The maximum number of items returned in a single response.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000,
              "default": 30000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The initial value to be fetched from the total result.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "parentId",
            "in": "query",
            "description": "If specified, only immediate children of a given parentId are returned. If not specified, all hierarchy relations are returned. If special value `root` is passed then only root hierarchy relations will be returned.\nParentId could be either external Id (prefixed by `id:`), internal Id (prefixed by `idx:`), 'connect' id (prefixed with 'idc:') or could have value `root`. If a value is passed without a prefix then it is evaluated based on the following precedence : connect Id, internal Id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parentIdx",
            "in": "query",
            "deprecated": true,
            "description": "If specified, only immediate children of a given parentIdx are returned. If not specified, all hierarchy relations are returned. It accepts only internal identifiers which are generally integer values with no prefix.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "childId",
            "in": "query",
            "description": "If specified, only immediate parents of a given childId are returned. If not specified, all hierarchy relations are returned. ChildId could be either external Id (prefixed by `id:`), runtime internal Id (prefixed by `idx:`) or connect identifier (prefixed with 'idc:'). If a value is passed without a prefix then it is evaluated based on the following precedence : connect Id, internal Id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "childIdx",
            "in": "query",
            "deprecated": true,
            "description": "If specified, only immediate parents of a given childIdx are returned. If not specified, all hierarchy relations are returned.r It accepts only internal identifiers which are generally integer values with no prefix.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "If specified, only relations that belong to the given hierarchy are returned. If not specified all relations are returned. If hierarchy is prefixed with `!` sign then relations that are NOT involved in the given hierarchy are returned. The hierarchy type string is matched using exact case sensitive comparison.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "The identifier(external or internal) to be returned in the response.\nBy default response will contain external Id (include=id format). If include=idx then internal Ids are returned and external Ids are omitted. If include=idx,id then both internal and external format identifiers will be returned.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "idx",
                  "idc"
                ]
              }
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-ModelVersionId": {
                "schema": {
                  "type": "string"
                },
                "description": "The actual model version identifier."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyRelationsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authorization information is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input validation Error: value is missing/null/invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "User has no permissions to execute this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The specified modelId/versionId was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Session is invalid/Gateway timeout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/models/{modelId}/hierarchies/{type}": {
      "get": {
        "tags": [
          "Hierarchies"
        ],
        "summary": "Lists hierarchy relations belonging to a given type",
        "operationId": "GetHierarchyByType",
        "description": "Lists all hierarchy relations belonging to a given type in the model.",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "description": "The model Id.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "type",
            "in": "path",
            "description": "The hierarchy type. The possible hierarchy types that exist in the model can be discovered using GetModelInfo endpoint.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "description": "The file version identifier, if not specified the latest version of the file is assumed.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "The maximum number of items returned in a single response.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000,
              "default": 30000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The initial value to be fetched from the total result.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "parentId",
            "in": "query",
            "description": "If specified, only immediate children of a given parentId are returned. If not specified, all hierarchy relations are returned. If `root` is passed then only root hierarchy relations will be returned.\nParentId could be either external Id (prefixed by `id:`), internal Id (prefixed by `idx:`) or could have value `root`. If a value is passed without a prefix then it is evaluated based on the precedence: external Id, internal Id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parentIdx",
            "in": "query",
            "description": "If specified, only immediate children of a given parentIdx are returned. If not specified, all hierarchy relations are returned. It accepts only internal identifiers which are generally integer values with no prefix.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "childId",
            "in": "query",
            "description": "If specified, only immediate parents of a given childId are returned. If not specified, all hierarchy relations are returned. ChildId could be either external Id (prefixed by `id:`), runtime internal Id (prefixed by `idx:`). If a value is passed without a prefix then it is evaluated based on the following precedence : external Id, internal Id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "childIdx",
            "in": "query",
            "description": "If specified, only immediate parents of a given childIdx are returned. If not specified, all hierarchy relations are returned. It accepts only internal identifiers which are generally integer values with no prefix.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "The identifier(external or internal) to be returned in the response. By default response will contain external Id (include=id format). If include=idx then internal Ids are returned and external Ids are omitted. If include=idx,id then both internal and external format identifiers will be returned.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "idx",
                  "idc"
                ]
              }
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-ModelVersionId": {
                "schema": {
                  "type": "string"
                },
                "description": "The actual model version identifier."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyRelationsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authorization information is missing or invalid.",
            "content": {
