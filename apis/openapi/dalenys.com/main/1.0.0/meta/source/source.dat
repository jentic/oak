                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateReportPlanner",
        "summary": "Update Report Planner",
        "description": "Update an existing report planner configuration.",
        "tags": ["Report Planners"],
        "parameters": [
          {
            "name": "plannerId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the planner",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePlannerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Planner updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlannerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
