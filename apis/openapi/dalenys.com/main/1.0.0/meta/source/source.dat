  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer token obtained via POST /iam/token using OAuth2 client credentials flow"
      }
    },
    "schemas": {
      "TokenRequest": {
        "type": "object",
        "required": ["grant_type", "client_id", "client_secret", "scope"],
        "properties": {
          "grant_type": {
            "type": "string",
            "description": "OAuth2 grant type, always 'client_credentials'",
            "enum": ["client_credentials"]
          },
          "client_id": {
            "type": "string",
            "description": "Client ID provided by Payplug"
          },
          "client_secret": {
            "type": "string",
            "description": "Client secret provided by Payplug"
          },
          "scope": {
            "type": "string",
            "description": "Authorization scope provided by Payplug"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT bearer access token"
          },
          "expires_in": {
            "type": "integer",
            "description": "Token lifetime in seconds",
            "example": 900
          },
          "refresh_expires_in": {
            "type": "integer",
            "description": "Refresh token lifetime in seconds",
            "example": 5400
          },
          "refresh_token": {
            "type": "string",
            "description": "Token for refreshing the access token"
          },
          "token_type": {
            "type": "string",
            "description": "Token type, always 'Bearer'",
            "enum": ["Bearer"]
          },
          "not-before-policy": {
            "type": "integer",
            "description": "Epoch time before which tokens are invalid"
          },
          "session_state": {
            "type": "string",
            "description": "Internal session identifier"
          }
        }
      },
      "CreateSubmerchantRequest": {
        "type": "object",
        "required": ["companyName", "legalForm", "country"],
        "properties": {
          "companyName": {
            "type": "string",
            "description": "Legal company name of the submerchant"
          },
          "tradeName": {
            "type": "string",
            "description": "Trading name of the submerchant"
          },
          "legalForm": {
            "type": "string",
            "description": "Legal form of the company"
          },
          "registrationNumber": {
            "type": "string",
            "description": "Company registration number"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code",
            "pattern": "^[A-Z]{2}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Contact email"
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "mcc": {
            "type": "string",
            "description": "Merchant Category Code"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "Submerchant website URL"
          }
        }
      },
      "UpdateSubmerchantRequest": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string"
          },
          "tradeName": {
            "type": "string"
          },
          "legalForm": {
            "type": "string"
          },
          "registrationNumber": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "mcc": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "SubmerchantResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique submerchant identifier"
          },
          "companyName": {
            "type": "string"
          },
          "tradeName": {
            "type": "string"
          },
          "legalForm": {
            "type": "string"
          },
          "registrationNumber": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "mcc": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Current submerchant status",
            "enum": ["ACTIVE", "INACTIVE", "PENDING", "SUSPENDED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SubmerchantListResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubmerchantResponse"
            }
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "streetAddress": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "ReportDefinitionListResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportDefinition"
            }
          }
        }
      },
      "ReportDefinition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique definition identifier"
          },
          "name": {
            "type": "string",
            "description": "Human-readable report name"
          },
          "description": {
            "type": "string",
            "description": "Report description"
          },
          "availableFilters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "operators": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "availableColumns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreatePlannerRequest": {
        "type": "object",
        "required": ["definitionId", "name"],
        "properties": {
          "definitionId": {
            "type": "string",
            "description": "Report definition to use"
          },
          "name": {
            "type": "string",
            "description": "Planner display name"
          },
          "cronExpression": {
            "type": "string",
            "description": "Cron expression for scheduled execution"
          },
          "triggerDate": {
            "type": "string",
            "format": "date-time",
            "description": "Single-date trigger for one-time execution"
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "operator": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdatePlannerRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cronExpression": {
            "type": "string"
          },
          "triggerDate": {
            "type": "string",
            "format": "date-time"
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "operator": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "PlannerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "definitionId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cronExpression": {
            "type": "string"
          },
          "triggerDate": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "PAUSED", "COMPLETED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlannerListResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlannerResponse"
            }
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "TriggerExecutionRequest": {
        "type": "object",
        "required": ["plannerId"],
        "properties": {
          "plannerId": {
            "type": "string",
            "description": "Planner to execute immediately"
          }
        }
      },
      "ExecutionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "plannerId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rowCount": {
            "type": "integer",
            "description": "Number of rows in the generated report"
          }
        }
      },
      "ExecutionListResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
