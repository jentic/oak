{
  "openapi": "3.0.3",
  "info": {
    "title": "Dalenys (Payplug) Payment Platform API",
    "description": "Dalenys (now Payplug) Payment Platform API providing authentication, payment facilitation, reporting, and self-onboarding capabilities for marketplace and payment facilitator integrations. Supports submerchant management, KYC processing, report generation, and bearer token authentication via OAuth2 client credentials flow.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://developer.dalenys.com/ui/developer-doc/openapi/index.html",
    "contact": {
      "name": "Dalenys (Payplug) Developer Portal",
      "url": "https://developer.dalenys.com"
    }
  },
  "servers": [
    {
      "url": "https://payment.dalenys.com",
      "description": "Dalenys Production API"
    },
    {
      "url": "https://sandbox-payment.dlns.io",
      "description": "Dalenys Sandbox API"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Bearer token management via OAuth2 client credentials"
    },
    {
      "name": "Payment Facilitator",
      "description": "Submerchant management for payment facilitators"
    },
    {
      "name": "Report Definitions",
      "description": "Report resource definitions and configurations"
    },
    {
      "name": "Report Planners",
      "description": "Scheduled report execution management"
    },
    {
      "name": "Report Executions",
      "description": "Report execution traces and downloads"
    },
    {
      "name": "Self-Onboarding - Submerchants",
      "description": "Draft submerchant lifecycle management"
    },
    {
      "name": "Self-Onboarding - Bank Accounts",
      "description": "Draft bank account management for submerchants"
    },
    {
      "name": "Self-Onboarding - KYC",
      "description": "Know Your Customer document management"
    },
    {
      "name": "Self-Onboarding - Invitations",
      "description": "Submerchant invitation management"
    }
  ],
  "paths": {
    "/iam/token": {
      "post": {
        "operationId": "requestAccessToken",
        "summary": "Request Access Token",
        "description": "Generate a bearer token using OAuth2 client credentials flow. The token is used to authenticate subsequent API requests.",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bearer token generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid credentials or parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - insufficient scope or permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payment_facilitator": {
      "post": {
        "operationId": "createSubmerchant",
        "summary": "Create Submerchant",
        "description": "Create a new submerchant under the payment facilitator account.",
        "tags": ["Payment Facilitator"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSubmerchantRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Submerchant created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmerchantResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid submerchant data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listSubmerchants",
        "summary": "List Submerchants",
        "description": "Retrieve a paginated list of submerchants under the payment facilitator account.",
        "tags": ["Payment Facilitator"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Number of results per page",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of submerchants retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmerchantListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/paymentFacilitators/submerchants/{submerchantId}": {
      "get": {
        "operationId": "getSubmerchant",
        "summary": "Get Submerchant Details",
        "description": "Retrieve the details of a specific submerchant by its unique identifier.",
        "tags": ["Payment Facilitator"],
        "parameters": [
          {
            "name": "submerchantId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the submerchant",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Submerchant details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmerchantResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Submerchant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateSubmerchant",
        "summary": "Update Submerchant",
        "description": "Update the details of an existing submerchant.",
        "tags": ["Payment Facilitator"],
        "parameters": [
          {
            "name": "submerchantId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the submerchant",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSubmerchantRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submerchant updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmerchantResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Submerchant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSubmerchant",
        "summary": "Delete Submerchant",
        "description": "Remove a submerchant from the payment facilitator account.",
        "tags": ["Payment Facilitator"],
        "parameters": [
          {
            "name": "submerchantId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the submerchant to delete",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Submerchant deleted successfully"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Submerchant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reports/definitions": {
      "get": {
        "operationId": "listReportDefinitions",
        "summary": "List Report Definitions",
        "description": "Retrieve a list of available report definitions describing report types, their resources, default behaviors, and possible filters.",
        "tags": ["Report Definitions"],
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response format - 'full' includes filters and columns, 'short' returns summary only",
            "schema": {
              "type": "string",
              "enum": ["full", "short"],
              "default": "short"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report definitions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportDefinitionListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reports/definitions/{definitionId}": {
      "get": {
        "operationId": "getReportDefinition",
        "summary": "Get Report Definition",
        "description": "Retrieve a specific report definition by its identifier including available filters, columns, and configuration options.",
        "tags": ["Report Definitions"],
        "parameters": [
          {
            "name": "definitionId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the report definition",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report definition retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportDefinition"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Definition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reports/planners": {
      "get": {
        "operationId": "listReportPlanners",
        "summary": "List Report Planners",
        "description": "Retrieve a paginated list of report planners (scheduled report executions).",
        "tags": ["Report Planners"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of planners",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlannerListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
