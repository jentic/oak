      "get": {
        "operationId": "getReportPlanner",
        "summary": "Get Report Planner",
        "description": "Retrieve details of a specific report planner.",
        "tags": ["Report Planners"],
        "parameters": [
          {
            "name": "plannerId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the planner",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
