          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteReportPlanner",
        "summary": "Delete Report Planner",
        "description": "Delete a report planner, stopping any scheduled executions.",
        "tags": ["Report Planners"],
        "parameters": [
          {
            "name": "plannerId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the planner to delete",
