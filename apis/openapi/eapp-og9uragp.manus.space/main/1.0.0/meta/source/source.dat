    "/automation/rules": {
      "get": {
        "tags": [
          "Automation"
        ],
        "summary": "List automation rules",
        "responses": {
          "200": {
            "description": "Automation rule list"
          }
        }
      },
      "post": {
        "tags": [
          "Automation"
        ],
        "summary": "Create an automation rule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "triggerEvent",
                  "actions"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "triggerEvent": {
                    "type": "string",
                    "description": "e.g. deal.stage_changed, payment.posted, lead.created"
                  },
                  "conditions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "operator": {
                          "type": "string",
                          "enum": [
                            "equals",
                            "not_equals",
                            "greater_than",
                            "less_than",
                            "contains"
                          ]
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "actionType": {
                          "type": "string",
                          "enum": [
                            "send_email",
                            "send_sms",
                            "create_task",
                            "update_field",
                            "notify_owner",
                            "webhook"
                          ]
                        },
                        "config": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  "isActive": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Automation rule created"
          }
        }
      }
    },
    "/automation/rules/{id}/toggle": {
      "patch": {
        "tags": [
          "Automation"
        ],
        "summary": "Enable or disable an automation rule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "isActive"
                ],
                "properties": {
                  "isActive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule toggled"
          }
        }
      }
    },
