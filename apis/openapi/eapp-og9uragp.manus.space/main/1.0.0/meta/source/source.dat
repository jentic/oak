            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Investor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 200
          },
          "name": {
            "type": "string",
            "example": "Apex Capital Partners"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "investorType": {
            "type": "string",
            "enum": [
              "individual",
              "corporate",
              "trust",
              "joint",
              "pension",
              "ira"
            ]
          },
          "kycStatus": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "accreditationStatus": {
            "type": "string",
            "enum": [
              "accredited",
              "non_accredited",
              "pending"
            ]
          },
          "taxCountry": {
            "type": "string",
            "example": "US"
          },
          "taxId": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateInvestorRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "investorType"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "investorType": {
            "type": "string",
            "enum": [
              "individual",
              "corporate",
              "trust",
              "joint",
              "pension",
              "ira"
            ]
          },
          "kycStatus": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "default": "pending"
          },
          "accreditationStatus": {
            "type": "string",
            "enum": [
              "accredited",
              "non_accredited",
              "pending"
            ],
            "default": "pending"
          },
          "taxCountry": {
            "type": "string",
            "default": "US"
          },
          "taxId": {
            "type": "string"
          }
        }
      },
      "CapitalCall": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "fundId": {
            "type": "integer"
          },
          "callNumber": {
            "type": "integer"
          },
          "totalAmount": {
            "type": "number",
            "example": 2000000
          },
          "collectedAmount": {
            "type": "number"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "issued",
              "partially_funded",
              "fully_funded",
              "cancelled"
            ]
          },
          "notes": {
            "type": "string"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ESignEnvelope": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "dealId": {
            "type": "integer"
          },
          "loanId": {
            "type": "integer"
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "sent",
              "delivered",
              "signed",
              "completed",
              "voided",
              "declined"
            ]
          },
          "signers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "role": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CollectionCase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "loanId": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "monitoring",
              "legal",
              "resolved",
              "closed"
            ]
          },
          "escalationLevel": {
            "type": "string",
            "enum": [
              "pre_foreclosure",
              "foreclosure",
              "reo"
            ]
          },
          "assignedTo": {
            "type": "integer"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "loans": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "active": {
                "type": "integer"
              },
              "delinquent": {
                "type": "integer"
              },
              "totalPortfolio": {
                "type": "number"
              },
              "totalAccruedInterest": {
                "type": "number"
              }
            }
          },
          "funds": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "active": {
                "type": "integer"
              },
              "totalAUM": {
                "type": "number"
              },
              "totalCommitted": {
                "type": "number"
              },
              "totalInvestors": {
                "type": "integer"
              }
            }
          },
          "deals": {
            "type": "object",
            "properties": {
              "pipelineCount": {
                "type": "integer"
              },
              "fundedCount": {
                "type": "integer"
              },
              "stageCounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stage": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate and obtain access token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "officer@lendautomate.com",
                "password": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Invalidate the current session token",
        "responses": {
          "200": {
            "description": "Logged out successfully"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get the currently authenticated user's profile",
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/stats": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Get aggregated portfolio KPIs",
        "description": "Returns loan portfolio stats, fund AUM, deal pipeline counts, and pending action items for the authenticated tenant.",
        "responses": {
          "200": {
            "description": "Dashboard statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardStats"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/activity": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Get recent activity feed",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent activity events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "eventType": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "entityType": {
                        "type": "string"
                      },
                      "entityId": {
                        "type": "string"
                      },
                      "userId": {
                        "type": "integer"
                      },
                      "userName": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/leads": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "List all leads",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "contacted",
                "qualified",
                "proposal_sent",
                "negotiating",
                "converted",
                "lost",
                "duplicate"
              ]
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            }
          },
          {
            "name": "productType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "bridge",
                "construction",
                "rehab",
                "commercial"
              ]
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assignedTo",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Full-text search on name, company, address"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "name",
                "amount",
                "priority"
              ],
              "default": "createdAt"
            }
          },
          {
            "name": "sortDir",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of leads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Lead"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Leads"
        ],
        "summary": "Create a new lead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLeadRequest"
              },
              "example": {
                "firstName": "James",
                "lastName": "Morrison",
                "email": "james@morrisonholdings.com",
                "phone": "+1-555-0123",
                "productType": "bridge",
                "requestedAmount": 1500000,
                "propertyAddress": "123 Main St, Austin TX 78701",
                "priority": "high",
                "source": "referral"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lead created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lead"
                }
              }
            }
          }
        }
      }
    },
    "/leads/{id}": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Get a lead by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lead detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lead"
                }
              }
            }
          },
          "404": {
            "description": "Lead not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Leads"
        ],
        "summary": "Update a lead",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLeadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lead updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lead"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Leads"
        ],
        "summary": "Archive a lead",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Lead archived"
          }
        }
      }
    },
    "/leads/{id}/status": {
      "patch": {
        "tags": [
          "Leads"
        ],
        "summary": "Update lead status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "new",
                      "contacted",
                      "qualified",
                      "proposal_sent",
                      "negotiating",
                      "converted",
                      "lost",
                      "duplicate"
                    ]
                  },
                  "lostReason": {
                    "type": "string",
                    "maxLength": 255
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated"
          }
        }
      }
    },
    "/leads/{id}/assign": {
      "patch": {
        "tags": [
          "Leads"
        ],
        "summary": "Assign a lead to a loan officer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "assignedTo"
                ],
                "properties": {
                  "assignedTo": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lead assigned"
          }
        }
      }
    },
    "/leads/{id}/convert": {
      "post": {
        "tags": [
          "Leads"
        ],
        "summary": "Convert a lead to a deal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Deal created from lead",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dealId": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/deals": {
      "get": {
        "tags": [
          "Deals"
        ],
        "summary": "List deals",
        "parameters": [
          {
            "name": "stage",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "productType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "bridge",
                "construction",
                "rehab",
                "commercial"
              ]
            }
          },
          {
            "name": "assignedLO",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "assignedUW",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of deals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Deal"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Deals"
        ],
        "summary": "Create a new deal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDealRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Deal created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deal"
                }
              }
            }
          }
        }
      }
    },
    "/deals/{id}": {
      "get": {
        "tags": [
          "Deals"
        ],
        "summary": "Get a deal by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deal detail with documents, conditions, notes, and activity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deal"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Deals"
        ],
        "summary": "Update deal fields",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDealRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deal updated"
          }
        }
      }
    },
    "/deals/{id}/stage": {
      "patch": {
        "tags": [
          "Deals"
        ],
        "summary": "Advance or change deal stage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "enum": [
                      "application",
                      "processing",
                      "underwriting",
                      "approved",
                      "conditional_approval",
                      "clear_to_close",
                      "closing",
                      "funded",
                      "withdrawn",
                      "declined"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Required when declining or withdrawing"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stage updated"
          }
        }
      }
    },
    "/deals/{id}/assign": {
      "patch": {
        "tags": [
          "Deals"
        ],
        "summary": "Assign LO and/or UW to a deal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
