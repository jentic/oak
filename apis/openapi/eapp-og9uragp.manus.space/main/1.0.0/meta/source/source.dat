    "/esign/envelopes": {
      "get": {
        "tags": [
          "E-Sign"
        ],
        "summary": "List e-sign envelopes",
        "parameters": [
          {
            "name": "dealId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "loanId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "sent",
                "delivered",
                "signed",
                "completed",
                "voided",
                "declined"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ESignEnvelope"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "E-Sign"
        ],
        "summary": "Send a document for e-signature",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject",
                  "documentId",
                  "signers"
                ],
                "properties": {
                  "dealId": {
                    "type": "integer"
                  },
                  "loanId": {
                    "type": "integer"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "documentId": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  },
                  "signers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "email",
                        "role"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "borrower",
                            "co_borrower",
                            "guarantor",
                            "lender",
                            "investor"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Envelope sent"
          }
        }
      }
    },
    "/esign/envelopes/{id}/sync": {
      "post": {
        "tags": [
          "E-Sign"
        ],
        "summary": "Sync envelope status from the e-sign provider",
