            "type": "string",
            "enum": [
              "new",
              "contacted",
              "qualified",
              "proposal_sent",
              "negotiating",
              "converted",
              "lost",
              "duplicate"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "website",
              "referral",
              "broker",
              "direct",
              "social",
              "email_campaign",
              "phone",
              "other"
            ]
          },
          "assignedTo": {
            "type": "integer",
            "example": 5
          },
          "referredBy": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "followUpAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
