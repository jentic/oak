{
  "openapi": "3.1.1",
  "info": {
    "title": "Loyalty BFF API",
    "version": "1.0.0",
    "description": "Backend-For-Frontend (BFF) API for the Loyalty & Rewards system. This API acts as a secure proxy to the SoftGamings Loyalty Engine.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ptgsoftltd/LoyaltyAPIBFF/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.kraken.ptops.net/api/v1",
      "description": "Production Environment"
    },
    {
      "url": "https://api.dev.kraken.ptops.net/api/v1",
      "description": "UAT Environment"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/loyalty/status": {
      "get": {
        "summary": "Get player's loyalty status",
        "description": "Retrieves the current loyalty level, points progression, and balance blocked by bonuses.",
        "operationId": "getLoyaltyStatus",
        "tags": [
          "Loyalty"
        ],
        "responses": {
          "200": {
            "description": "Successful response with loyalty data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoyaltyStatusResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/loyalty/levels": {
      "get": {
        "summary": "Loyalty Levels Catalog",
        "description": "Retrieves the catalog of all available loyalty levels and their configuration.",
        "operationId": "getLoyaltyLevels",
        "tags": [
          "Loyalty"
        ],
        "responses": {
          "200": {
            "description": "A list of loyalty levels.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoyaltyLevelsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/loyalty/bonuses": {
      "get": {
        "summary": "List available and active bonuses",
        "description": "Retrieves a list of all available bonuses for the user, indicating which are selected or active.",
        "operationId": "getLoyaltyBonuses",
        "tags": [
          "Bonuses"
        ],
        "responses": {
          "200": {
            "description": "A list of bonuses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BonusesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/loyalty/bonuses/history": {
      "get": {
        "summary": "Bonus History",
        "description": "Retrieves the user's historical bonuses and their final statuses.",
        "operationId": "getBonusHistory",
        "tags": [
          "Bonuses"
        ],
        "responses": {
          "200": {
            "description": "A list of historical bonuses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BonusHistoryResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/loyalty/bonuses/activate": {
      "post": {
        "summary": "Activate or Select Bonus",
        "description": "Opt-in to a selected bonus. Can optionally include a promo code.",
        "operationId": "activateBonus",
        "tags": [
          "Bonuses"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BonusActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bonus activation or deselection processed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/loyalty/bonuses/cancel": {
      "post": {
        "summary": "Cancel an active bonus",
        "description": "Forfeits a currently active bonus and its associated bonus balance.",
        "operationId": "cancelBonus",
        "tags": [
          "Bonuses"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BonusActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bonus cancelled successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Standard JWT token containing the user's session and internal ID."
      }
    },
    "schemas": {
      "ErrorWrapper": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "INVALID_REQUEST"
              },
              "description": {
                "type": "string",
                "description": "Sanitized error message safe for frontend display.",
                "example": "The requested bonus is no longer available."
              }
            }
          }
        }
      },
      "LoyaltyStatusResponse": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/LoyaltyStatus"
          }
        }
      },
      "LoyaltyLevelsResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoyaltyLevel"
            }
          }
        }
      },
      "BonusesResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bonus"
            }
          }
        }
      },
      "BonusHistoryResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BonusHistoryItem"
            }
          }
        }
      },
      "LoyaltyStatus": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "description": "Current loyalty level of the user.",
            "example": 2
          },
          "points": {
            "type": "number",
            "format": "float",
            "description": "Current amount of accumulated loyalty points.",
            "example": 1200.5
          },
          "next_level_points": {
            "type": "integer",
            "description": "Total points required to reach the next level.",
            "example": 2800
          },
          "block": {
            "type": "number",
            "format": "float",
            "description": "Amount of real funds blocked by active bonuses. A value of -1 means the entire balance is blocked.",
            "example": 50.0
          }
        }
      },
      "LoyaltyLevel": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "description": "The level identifier.",
            "example": 2
          },
          "name": {
            "type": "string",
            "description": "The name of the level.",
            "example": "Silver"
          },
          "next_level_points": {
            "type": "integer",
            "description": "Points a player needs to earn to switch to the next level.",
            "example": 1500
          },
          "confirm_points": {
            "type": "integer",
            "description": "Points a player needs to earn to keep the current level at the check date.",
            "example": 200
          },
          "coef": {
            "type": "number",
            "format": "float",
            "description": "Coefficient multiplied by the user's bet for earned points calculation.",
            "example": 1.5
          }
        }
      },
      "Bonus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier of the bonus.",
            "example": 361803
          },
          "name": {
            "type": "string",
            "description": "Localized name of the bonus.",
            "example": "Welcome Deposit Bonus"
          },
          "event": {
            "type": "string",
            "description": "The trigger for the bonus (e.g., Registration, Login, Deposit, Bet, Level up).",
            "example": "Deposit"
          },
          "selected": {
            "type": "boolean",
            "description": "true if the bonus is selected (subscribed) by the user, false otherwise.",
            "enum": [
              true,
              false
            ],
            "example": true
          },
          "active": {
            "type": "boolean",
            "description": "true if the bonus is currently active (in progress), false otherwise.",
            "enum": [
              true,
              false
            ],
            "example": true
          },
          "status": {
            "type": "string",
            "description": "The final outcome of the bonus.",
            "enum": [
              "active",
              "completed",
              "canceled",
              "deleted",
              "expired"
            ],
            "example": "active"
          },
          "bonus": {
            "type": "float",
            "description": "Bonus shows the actual bonus value calculated on activation.",
            "example": 50.0
          },
          "wagering": {
            "type": "float",
            "description": "Wagering shows the actual wagering calculated on activation minus the sum of bet event amounts.",
            "example": 25.0
          },
          "max_bet": {
            "type": "float",
            "description": "Wagering shows the actual wagering calculated on activation minus the sum of bet event amounts.",
            "example": 25.0
          },
          "min_bet": {
            "type": "float",
            "description": "Wagering shows the actual wagering calculated on activation minus the sum of bet event amounts.",
            "example": 25.0
          },
          "bonus_type": {
            "type": "string",
            "description": "bonus type.",
            "example": "general"
          },
          "expire": {
            "type": "string",
            "description": "Bonus expiration date.",
            "example": "2019-09-10"
          },
          "expire_days": {
            "type": "string",
            "description": "Number of days until the bonus expires.",
            "example": "3"
          },
          "starts": {
            "type": "string",
            "description": "Bonus start date.",
            "example": "2019-09-02"
          },
          "ends": {
            "type": "string",
            "description": "Bonus end date.",
            "example": "2019-09-10"
          },
          "group": {
            "type": "string",
            "description": "Group to which the bonus belongs.",
            "example": "BonusesUnitTest"
          }
        }
      },
      "BonusHistoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier of the bonus.",
            "example": 1101773
          },
          "name": {
            "type": "string",
            "description": "Name of the historical bonus.",
            "example": "Weekend Free Spins"
          },
          "event": {
            "type": "string",
            "description": "The trigger for the bonus (e.g., Registration, Login, Deposit, Bet, Level up).",
            "example": "Deposit"
          },
          "status": {
            "type": "string",
            "description": "The final outcome of the bonus.",
            "enum": [
              "completed",
              "canceled",
              "deleted",
              "expired"
            ],
            "example": "completed"
          },
          "bonus": {
            "type": "float",
            "description": "Bonus shows the actual bonus value calculated on activation.",
            "example": 972.76
          },
          "bonus_awarded": {
            "type": "float",
            "description": "bonus_awarded shows the rewarded bonus.",
            "example": 972.76
          },
          "wagering": {
            "type": "float",
            "description": "Wagering shows the actual wagering calculated on activation minus the sum of bet event amounts.",
            "example": 25.0
          },
          "ended": {
            "type": "boolean",
            "description": "True if it's finished",
            "enum": [
              true,
              false
            ],
            "example": true
          },
          "start": {
            "type": "string",
            "description": "Bonus start date.",
            "example": "2022-07-12 11:58:55"
          },
          "end": {
            "type": "string",
            "description": "Bonus end date.",
            "example": "2022-07-12 12:02:03"
          },
          "subscribe_date": {
            "type": "string",
            "description": "Subscription date.",
            "example": "2022-07-12 11:58:55"
          },
          "group": {
            "type": "string",
            "description": "Group to which the bonus belongs.",
            "example": "383866"
          },
          "promo_code_used": {
            "type": "string",
            "description": "Promo code used.",
            "example": ""
          },
          "bonus_type": {
            "type": "string",
            "description": "bonus type.",
            "example": "sport"
          },
          "loyalty_points": {
            "type": "string",
            "description": "Loyalty points.",
            "example": "0.00"
          }
        }
      },
      "BonusActionRequest": {
        "type": "object",
        "required": [
          "bonus_id"
        ],
        "properties": {
          "bonus_id": {
            "type": "integer",
            "description": "The ID of the bonus to interact with.",
            "example": 361803
          },
          "promo_code": {
            "type": "string",
            "description": "Optional promo code (used only for activation).",
            "example": "WELCOME100"
          }
        }
      },
      "ActionResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "description": "The outcome of the action.  Returns 'success' for activation/cancellation, and 'deselected' if a bonus was toggled off.\n",
                "enum": [
                  "success",
                  "deselected"
                ],
                "example": "success"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequestError": {
        "description": "The request was invalid or malformed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorWrapper"
            }
          }
        }
      },
      "UnauthorizedError": {
        "description": "Authentication token is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorWrapper"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "An unexpected error occurred on the server.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorWrapper"
            }
          }
        }
      }
    }
  }
}