    "/act_{ad_account_id}/broadtargetingcategories": {
      "get": {
        "operationId": "getBroadTargetingCategories",
        "summary": "Get broad targeting categories for an ad account",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          {
            "name": "custom_categories_only",
            "in": "query",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Broad targeting categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "parent_category": { "type": "string" },
                          "size_lower_bound": { "type": "integer" },
                          "size_upper_bound": { "type": "integer" },
                          "type_name": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
