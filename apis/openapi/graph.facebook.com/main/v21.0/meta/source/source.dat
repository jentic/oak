    "/act_{ad_account_id}/activities": {
      "get": {
        "operationId": "getAdAccountActivities",
        "summary": "Get activity log for an ad account",
        "tags": ["Ad Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/after" },
          {
            "name": "since",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "until",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity log entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "event_time": { "type": "string", "format": "date-time" },
                          "event_type": { "type": "string" },
                          "actor_id": { "type": "string" },
                          "actor_name": { "type": "string" },
                          "object_id": { "type": "string" },
                          "object_name": { "type": "string" },
                          "extra_data": { "type": "string" }
                        }
                      }
                    },
                    "paging": { "$ref": "#/components/schemas/Paging" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "oauth2",
        "description": "Facebook OAuth 2.0 access token authentication",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://www.facebook.com/v21.0/dialog/oauth",
            "tokenUrl": "https://graph.facebook.com/v21.0/oauth/access_token",
            "scopes": {
              "ads_management": "Create, edit, and manage ads",
              "ads_read": "Read ads reporting data",
              "business_management": "Manage business assets",
              "pages_read_engagement": "Read page engagement data"
            }
          }
        }
      }
    },
    "parameters": {
      "adAccountId": {
        "name": "ad_account_id",
        "in": "path",
        "required": true,
        "description": "Ad account ID (numeric, without the act_ prefix)",
        "schema": { "type": "string" }
      },
      "campaignId": {
        "name": "campaign_id",
        "in": "path",
        "required": true,
        "description": "Campaign ID",
        "schema": { "type": "string" }
      },
      "adSetId": {
        "name": "ad_set_id",
        "in": "path",
        "required": true,
        "description": "Ad set ID",
        "schema": { "type": "string" }
      },
      "adId": {
        "name": "ad_id",
        "in": "path",
        "required": true,
        "description": "Ad ID",
        "schema": { "type": "string" }
      },
      "creativeId": {
        "name": "creative_id",
        "in": "path",
        "required": true,
        "description": "Ad creative ID",
        "schema": { "type": "string" }
      },
      "customAudienceId": {
        "name": "custom_audience_id",
        "in": "path",
        "required": true,
        "description": "Custom audience ID",
        "schema": { "type": "string" }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "description": "Comma-separated list of fields to return",
        "schema": { "type": "string" }
      },
      "insightFields": {
        "name": "fields",
        "in": "query",
        "description": "Comma-separated list of insight metrics (e.g., impressions,clicks,spend,reach,cpm,cpc,ctr,actions,cost_per_action_type,frequency,unique_clicks,conversions,cost_per_conversion,video_views,video_avg_time_watched_actions)",
        "schema": { "type": "string" }
      },
      "datePreset": {
        "name": "date_preset",
        "in": "query",
        "description": "Predefined date range",
        "schema": {
          "type": "string",
          "enum": [
            "today",
            "yesterday",
            "this_month",
            "last_month",
            "this_quarter",
            "maximum",
            "data_maximum",
            "last_3d",
            "last_7d",
            "last_14d",
            "last_28d",
            "last_30d",
            "last_90d",
            "last_week_mon_sun",
            "last_week_sun_sat",
            "last_quarter",
            "last_year",
            "this_week_mon_today",
            "this_week_sun_today",
            "this_year"
          ]
        }
      },
      "timeRange": {
        "name": "time_range",
        "in": "query",
        "description": "Custom time range as JSON object with 'since' and 'until' in YYYY-MM-DD format",
        "schema": { "type": "string" }
      },
      "timeIncrement": {
        "name": "time_increment",
        "in": "query",
        "description": "Number of days for each data point (1-90), or 'monthly' or 'all_days'",
        "schema": { "type": "string" }
      },
      "breakdowns": {
        "name": "breakdowns",
        "in": "query",
        "description": "Breakdown dimensions (e.g., age, gender, country, placement, device_platform, publisher_platform, impression_device, product_id)",
        "schema": { "type": "string" }
      },
      "level": {
        "name": "level",
        "in": "query",
        "description": "Aggregation level for results",
        "schema": {
          "type": "string",
          "enum": ["ad", "adset", "campaign", "account"]
        }
      },
      "filtering": {
        "name": "filtering",
        "in": "query",
        "description": "JSON-encoded array of filter objects with field, operator, and value",
        "schema": { "type": "string" }
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "description": "Sort order (e.g., reach_descending, impressions_ascending)",
        "schema": { "type": "string" }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of results per page",
        "schema": { "type": "integer", "default": 25 }
      },
      "after": {
        "name": "after",
        "in": "query",
        "description": "Cursor for pagination (next page)",
        "schema": { "type": "string" }
      },
      "before": {
        "name": "before",
        "in": "query",
        "description": "Cursor for pagination (previous page)",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "AdAccount": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Ad account ID (e.g., act_123456)" },
          "account_id": { "type": "string", "description": "Numeric account ID" },
          "name": { "type": "string" },
          "account_status": {
            "type": "integer",
            "description": "1=ACTIVE, 2=DISABLED, 3=UNSETTLED, 7=PENDING_RISK_REVIEW, 8=PENDING_SETTLEMENT, 9=IN_GRACE_PERIOD, 100=PENDING_CLOSURE, 101=CLOSED, 201=ANY_ACTIVE, 202=ANY_CLOSED"
          },
          "age": { "type": "number" },
          "amount_spent": { "type": "string" },
          "balance": { "type": "string" },
          "business": { "type": "object" },
          "business_city": { "type": "string" },
          "business_country_code": { "type": "string" },
          "business_name": { "type": "string" },
          "business_street": { "type": "string" },
          "business_zip": { "type": "string" },
          "currency": { "type": "string" },
          "disable_reason": { "type": "integer" },
          "end_advertiser": { "type": "string" },
          "end_advertiser_name": { "type": "string" },
          "media_agency": { "type": "string" },
          "partner": { "type": "string" },
          "spend_cap": { "type": "string" },
          "timezone_id": { "type": "integer" },
          "timezone_name": { "type": "string" },
          "timezone_offset_hours_utc": { "type": "number" },
          "created_time": { "type": "string", "format": "date-time" }
        }
      },
      "Campaign": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED"] },
          "effective_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED", "IN_PROCESS", "WITH_ISSUES"] },
          "objective": {
            "type": "string",
            "enum": [
              "APP_INSTALLS", "BRAND_AWARENESS", "CONVERSIONS", "EVENT_RESPONSES",
              "LEAD_GENERATION", "LINK_CLICKS", "LOCAL_AWARENESS", "MESSAGES",
              "OFFER_CLAIMS", "OUTCOME_APP_PROMOTION", "OUTCOME_AWARENESS",
              "OUTCOME_ENGAGEMENT", "OUTCOME_LEADS", "OUTCOME_SALES",
              "OUTCOME_TRAFFIC", "PAGE_LIKES", "POST_ENGAGEMENT",
              "PRODUCT_CATALOG_SALES", "REACH", "STORE_VISITS", "VIDEO_VIEWS"
            ]
          },
          "buying_type": { "type": "string", "enum": ["AUCTION", "RESERVED"] },
          "bid_strategy": { "type": "string", "enum": ["LOWEST_COST_WITHOUT_CAP", "LOWEST_COST_WITH_BID_CAP", "COST_CAP", "LOWEST_COST_WITH_MIN_ROAS"] },
          "daily_budget": { "type": "string" },
          "lifetime_budget": { "type": "string" },
          "spend_cap": { "type": "string" },
          "budget_remaining": { "type": "string" },
          "budget_rebalance_flag": { "type": "boolean" },
          "special_ad_categories": {
            "type": "array",
            "items": { "type": "string", "enum": ["NONE", "EMPLOYMENT", "HOUSING", "CREDIT", "ISSUES_ELECTIONS_POLITICS", "ONLINE_GAMBLING_AND_GAMING", "FINANCIAL_PRODUCTS_SERVICES"] }
          },
          "special_ad_category_country": { "type": "array", "items": { "type": "string" } },
          "start_time": { "type": "string", "format": "date-time" },
          "stop_time": { "type": "string", "format": "date-time" },
          "created_time": { "type": "string", "format": "date-time" },
          "updated_time": { "type": "string", "format": "date-time" }
        }
      },
      "CampaignCreate": {
        "type": "object",
        "required": ["name", "objective", "special_ad_categories", "status"],
        "properties": {
          "name": { "type": "string" },
          "objective": { "type": "string", "enum": ["APP_INSTALLS", "BRAND_AWARENESS", "CONVERSIONS", "EVENT_RESPONSES", "LEAD_GENERATION", "LINK_CLICKS", "LOCAL_AWARENESS", "MESSAGES", "OFFER_CLAIMS", "OUTCOME_APP_PROMOTION", "OUTCOME_AWARENESS", "OUTCOME_ENGAGEMENT", "OUTCOME_LEADS", "OUTCOME_SALES", "OUTCOME_TRAFFIC", "PAGE_LIKES", "POST_ENGAGEMENT", "PRODUCT_CATALOG_SALES", "REACH", "STORE_VISITS", "VIDEO_VIEWS"] },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED"] },
          "special_ad_categories": { "type": "array", "items": { "type": "string", "enum": ["NONE", "EMPLOYMENT", "HOUSING", "CREDIT", "ISSUES_ELECTIONS_POLITICS", "ONLINE_GAMBLING_AND_GAMING", "FINANCIAL_PRODUCTS_SERVICES"] } },
          "buying_type": { "type": "string", "enum": ["AUCTION", "RESERVED"] },
          "bid_strategy": { "type": "string", "enum": ["LOWEST_COST_WITHOUT_CAP", "LOWEST_COST_WITH_BID_CAP", "COST_CAP", "LOWEST_COST_WITH_MIN_ROAS"] },
          "daily_budget": { "type": "integer", "description": "Daily budget in account currency (cents)" },
          "lifetime_budget": { "type": "integer", "description": "Lifetime budget in account currency (cents)" },
          "spend_cap": { "type": "integer", "description": "Spend cap in account currency (cents), minimum $100 equivalent" },
          "start_time": { "type": "string", "format": "date-time" },
          "stop_time": { "type": "string", "format": "date-time" },
          "adlabels": { "type": "array", "items": { "type": "object" } }
        }
      },
      "CampaignUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED"] },
          "bid_strategy": { "type": "string", "enum": ["LOWEST_COST_WITHOUT_CAP", "LOWEST_COST_WITH_BID_CAP", "COST_CAP", "LOWEST_COST_WITH_MIN_ROAS"] },
          "daily_budget": { "type": "integer" },
          "lifetime_budget": { "type": "integer" },
          "spend_cap": { "type": "integer" },
          "budget_rebalance_flag": { "type": "boolean" },
          "start_time": { "type": "string", "format": "date-time" },
          "stop_time": { "type": "string", "format": "date-time" },
          "adlabels": { "type": "array", "items": { "type": "object" } }
        }
      },
      "AdSet": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "campaign_id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED"] },
          "effective_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED", "IN_PROCESS", "WITH_ISSUES", "CAMPAIGN_PAUSED"] },
          "bid_amount": { "type": "integer", "description": "Bid amount in cents" },
          "bid_strategy": { "type": "string" },
          "billing_event": { "type": "string", "enum": ["IMPRESSIONS", "CLICKS", "LINK_CLICKS", "APP_INSTALLS", "OFFER_CLAIMS", "PAGE_LIKES", "POST_ENGAGEMENT", "THRUPLAY", "PURCHASE"] },
          "optimization_goal": { "type": "string", "enum": ["APP_INSTALLS", "AD_RECALL_LIFT", "CLICKS", "ENGAGED_USERS", "EVENT_RESPONSES", "IMPRESSIONS", "LEAD_GENERATION", "LINK_CLICKS", "OFFSITE_CONVERSIONS", "PAGE_LIKES", "POST_ENGAGEMENT", "QUALITY_CALL", "QUALITY_LEAD", "REACH", "LANDING_PAGE_VIEWS", "CONVERSATIONS", "VALUE", "THRUPLAY", "DERIVED_EVENTS", "VISIT_INSTAGRAM_PROFILE", "MESSAGING_PURCHASE_CONVERSION"] },
          "daily_budget": { "type": "string" },
          "lifetime_budget": { "type": "string" },
          "budget_remaining": { "type": "string" },
          "targeting": { "$ref": "#/components/schemas/TargetingSpec" },
          "promoted_object": { "type": "object" },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "adset_schedule": { "type": "array", "items": { "type": "object" } },
          "pacing_type": { "type": "array", "items": { "type": "string" } },
          "destination_type": { "type": "string" },
          "attribution_spec": { "type": "array", "items": { "type": "object" } },
          "created_time": { "type": "string", "format": "date-time" },
          "updated_time": { "type": "string", "format": "date-time" }
        }
      },
      "AdSetCreate": {
        "type": "object",
        "required": ["campaign_id", "name", "billing_event", "optimization_goal", "targeting", "status"],
        "properties": {
          "campaign_id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED"] },
          "billing_event": { "type": "string", "enum": ["IMPRESSIONS", "CLICKS", "LINK_CLICKS", "APP_INSTALLS", "OFFER_CLAIMS", "PAGE_LIKES", "POST_ENGAGEMENT", "THRUPLAY", "PURCHASE"] },
          "optimization_goal": { "type": "string", "enum": ["APP_INSTALLS", "AD_RECALL_LIFT", "CLICKS", "ENGAGED_USERS", "EVENT_RESPONSES", "IMPRESSIONS", "LEAD_GENERATION", "LINK_CLICKS", "OFFSITE_CONVERSIONS", "PAGE_LIKES", "POST_ENGAGEMENT", "QUALITY_CALL", "QUALITY_LEAD", "REACH", "LANDING_PAGE_VIEWS", "CONVERSATIONS", "VALUE", "THRUPLAY", "DERIVED_EVENTS", "VISIT_INSTAGRAM_PROFILE", "MESSAGING_PURCHASE_CONVERSION"] },
          "bid_amount": { "type": "integer", "description": "Bid amount in cents" },
          "bid_strategy": { "type": "string", "enum": ["LOWEST_COST_WITHOUT_CAP", "LOWEST_COST_WITH_BID_CAP", "COST_CAP", "LOWEST_COST_WITH_MIN_ROAS"] },
          "daily_budget": { "type": "integer", "description": "Daily budget in cents" },
          "lifetime_budget": { "type": "integer", "description": "Lifetime budget in cents" },
          "targeting": { "$ref": "#/components/schemas/TargetingSpec" },
          "promoted_object": {
            "type": "object",
            "properties": {
              "pixel_id": { "type": "string" },
              "custom_event_type": { "type": "string" },
              "application_id": { "type": "string" },
              "object_store_url": { "type": "string" },
              "page_id": { "type": "string" },
              "offer_id": { "type": "string" },
              "product_set_id": { "type": "string" }
            }
          },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "adset_schedule": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_minute": { "type": "integer" },
                "end_minute": { "type": "integer" },
                "days": { "type": "array", "items": { "type": "integer" } },
                "timezone_type": { "type": "string", "enum": ["USER", "ADVERTISER"] }
              }
            }
          },
          "pacing_type": { "type": "array", "items": { "type": "string", "enum": ["standard", "no_pacing", "day_parting"] } },
          "destination_type": { "type": "string" },
          "attribution_spec": { "type": "array", "items": { "type": "object" } },
          "adlabels": { "type": "array", "items": { "type": "object" } }
        }
      },
      "AdSetUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED"] },
          "billing_event": { "type": "string" },
          "optimization_goal": { "type": "string" },
          "bid_amount": { "type": "integer" },
          "bid_strategy": { "type": "string" },
          "daily_budget": { "type": "integer" },
          "lifetime_budget": { "type": "integer" },
          "targeting": { "$ref": "#/components/schemas/TargetingSpec" },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "adset_schedule": { "type": "array", "items": { "type": "object" } },
          "promoted_object": { "type": "object" },
          "adlabels": { "type": "array", "items": { "type": "object" } }
        }
      },
      "TargetingSpec": {
        "type": "object",
        "description": "Targeting specification for ad delivery",
        "properties": {
          "age_min": { "type": "integer", "minimum": 13, "description": "Minimum age" },
          "age_max": { "type": "integer", "maximum": 65, "description": "Maximum age (65 means 65+)" },
          "genders": { "type": "array", "items": { "type": "integer" }, "description": "1=male, 2=female" },
          "geo_locations": {
            "type": "object",
            "properties": {
              "countries": { "type": "array", "items": { "type": "string" } },
              "regions": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" } } } },
              "cities": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" }, "radius": { "type": "integer" }, "distance_unit": { "type": "string" } } } },
              "zips": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" } } } },
              "location_types": { "type": "array", "items": { "type": "string", "enum": ["home", "recent"] } }
            }
          },
          "excluded_geo_locations": { "type": "object", "description": "Same structure as geo_locations" },
          "locales": { "type": "array", "items": { "type": "integer" }, "description": "Locale IDs" },
          "flexible_spec": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "interests": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "behaviors": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "life_events": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "work_employers": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "education_schools": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "education_majors": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "family_statuses": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "income": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                "industries": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } }
              }
            }
          },
          "exclusions": { "type": "object", "description": "Same structure as flexible_spec items" },
          "custom_audiences": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" } } } },
          "excluded_custom_audiences": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" } } } },
          "device_platforms": { "type": "array", "items": { "type": "string", "enum": ["mobile", "desktop"] } },
          "publisher_platforms": { "type": "array", "items": { "type": "string", "enum": ["facebook", "instagram", "messenger", "audience_network"] } },
          "facebook_positions": { "type": "array", "items": { "type": "string", "enum": ["feed", "right_hand_column", "instant_article", "marketplace", "video_feeds", "story", "search", "reels"] } },
          "instagram_positions": { "type": "array", "items": { "type": "string", "enum": ["stream", "story", "explore", "reels", "profile_feed", "ig_search", "shop"] } },
          "messenger_positions": { "type": "array", "items": { "type": "string", "enum": ["messenger_home", "sponsored_messages", "story"] } },
          "audience_network_positions": { "type": "array", "items": { "type": "string", "enum": ["classic", "rewarded_video"] } },
          "user_os": { "type": "array", "items": { "type": "string" } },
          "user_device": { "type": "array", "items": { "type": "string" } },
          "wireless_carrier": { "type": "array", "items": { "type": "string" } },
          "targeting_optimization": { "type": "string" }
        }
      },
      "Ad": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "adset_id": { "type": "string" },
          "campaign_id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED"] },
          "effective_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED", "IN_PROCESS", "WITH_ISSUES", "PENDING_REVIEW", "DISAPPROVED", "PREAPPROVED", "PENDING_BILLING_INFO", "CAMPAIGN_PAUSED", "ADSET_PAUSED"] },
          "creative": { "type": "object", "properties": { "id": { "type": "string" } } },
          "tracking_specs": { "type": "array", "items": { "type": "object" } },
          "conversion_specs": { "type": "array", "items": { "type": "object" } },
          "bid_amount": { "type": "integer" },
          "ad_review_feedback": { "type": "object" },
          "created_time": { "type": "string", "format": "date-time" },
          "updated_time": { "type": "string", "format": "date-time" }
        }
      },
      "AdCreate": {
        "type": "object",
        "required": ["name", "adset_id", "creative", "status"],
        "properties": {
          "name": { "type": "string" },
          "adset_id": { "type": "string" },
          "creative": {
            "type": "object",
            "properties": {
              "creative_id": { "type": "string", "description": "Existing creative ID" }
            },
            "description": "Creative specification or reference to existing creative"
          },
          "status": { "type": "string", "enum": ["ACTIVE", "PAUSED"] },
          "tracking_specs": { "type": "array", "items": { "type": "object" } },
          "ad_schedule_start_time": { "type": "string", "format": "date-time" },
          "ad_schedule_end_time": { "type": "string", "format": "date-time" },
          "adlabels": { "type": "array", "items": { "type": "object" } }
        }
      },
      "AdCreative": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "DELETED"] },
          "object_story_id": { "type": "string", "description": "Page post ID (page_id_post_id format)" },
          "object_story_spec": { "$ref": "#/components/schemas/ObjectStorySpec" },
          "effective_object_story_id": { "type": "string" },
          "asset_feed_spec": { "type": "object", "description": "Dynamic creative asset feed specification" },
          "thumbnail_url": { "type": "string" },
          "image_hash": { "type": "string" },
          "image_url": { "type": "string" },
          "url_tags": { "type": "string" },
          "authorization_category": { "type": "string" },
          "body": { "type": "string" },
          "title": { "type": "string" },
          "call_to_action_type": { "type": "string" },
          "link_url": { "type": "string" },
          "created_time": { "type": "string", "format": "date-time" }
        }
      },
      "AdCreativeCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 100 },
          "object_story_spec": { "$ref": "#/components/schemas/ObjectStorySpec" },
          "object_story_id": { "type": "string" },
          "asset_feed_spec": {
            "type": "object",
            "description": "Dynamic creative optimization spec with multiple images, text, etc.",
            "properties": {
              "images": { "type": "array", "items": { "type": "object", "properties": { "hash": { "type": "string" }, "url": { "type": "string" } } } },
              "videos": { "type": "array", "items": { "type": "object", "properties": { "video_id": { "type": "string" }, "thumbnail_url": { "type": "string" } } } },
              "bodies": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" } } } },
              "titles": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" } } } },
              "descriptions": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" } } } },
              "call_to_action_types": { "type": "array", "items": { "type": "string" } },
              "link_urls": { "type": "array", "items": { "type": "object", "properties": { "website_url": { "type": "string" } } } },
              "ad_formats": { "type": "array", "items": { "type": "string" } }
            }
          },
          "url_tags": { "type": "string" },
          "authorization_category": { "type": "string", "enum": ["POLITICAL", "NONE"] },
          "adlabels": { "type": "array", "items": { "type": "object" } }
        }
      },
      "ObjectStorySpec": {
        "type": "object",
        "description": "Specification for creating an inline page post",
        "properties": {
          "page_id": { "type": "string", "description": "Facebook Page ID" },
          "instagram_actor_id": { "type": "string", "description": "Instagram account ID" },
          "link_data": {
            "type": "object",
            "properties": {
              "link": { "type": "string", "description": "URL to promote" },
              "message": { "type": "string", "description": "Post body text" },
              "name": { "type": "string", "description": "Link title" },
              "description": { "type": "string", "description": "Link description" },
              "caption": { "type": "string" },
              "image_hash": { "type": "string" },
              "picture": { "type": "string", "description": "Image URL" },
              "call_to_action": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["SHOP_NOW", "LEARN_MORE", "SIGN_UP", "BOOK_TRAVEL", "DOWNLOAD", "GET_OFFER", "GET_QUOTE", "SUBSCRIBE", "CONTACT_US", "APPLY_NOW", "BUY_NOW", "GET_DIRECTIONS", "SEND_MESSAGE", "WATCH_MORE", "ORDER_NOW", "OPEN_LINK", "NO_BUTTON"] },
                  "value": { "type": "object", "properties": { "link": { "type": "string" } } }
                }
              },
              "child_attachments": { "type": "array", "items": { "type": "object" }, "description": "Carousel cards" }
            }
          },
          "photo_data": {
            "type": "object",
            "properties": {
              "image_hash": { "type": "string" },
              "url": { "type": "string" },
              "caption": { "type": "string" }
            }
          },
          "video_data": {
            "type": "object",
            "properties": {
              "video_id": { "type": "string" },
              "image_hash": { "type": "string", "description": "Thumbnail image hash" },
              "image_url": { "type": "string", "description": "Thumbnail image URL" },
              "title": { "type": "string" },
              "message": { "type": "string" },
              "call_to_action": { "type": "object" }
            }
          },
          "text_data": {
            "type": "object",
            "properties": {
              "message": { "type": "string" }
            }
          },
          "template_data": { "type": "object", "description": "Dynamic ad template data" }
        }
      },
      "CustomAudience": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "subtype": { "type": "string", "enum": ["CUSTOM", "WEBSITE", "APP", "OFFLINE_CONVERSION", "CLAIM", "PARTNER", "MANAGED", "VIDEO", "LOOKALIKE", "ENGAGEMENT", "BAG_OF_ACCOUNTS", "STUDY_RULE_AUDIENCE", "FOX", "MEASUREMENT", "REGULATED_CATEGORIES_AUDIENCE"] },
          "approximate_count_lower_bound": { "type": "integer" },
          "approximate_count_upper_bound": { "type": "integer" },
          "customer_file_source": { "type": "string" },
          "delivery_status": { "type": "object" },
          "operation_status": { "type": "object" },
          "retention_days": { "type": "integer" },
          "rule": { "type": "string" },
          "lookalike_spec": {
            "type": "object",
            "properties": {
              "origin": { "type": "array", "items": { "type": "object" } },
              "country": { "type": "string" },
              "ratio": { "type": "number", "description": "0.01 to 0.20 (1% to 20%)" },
              "type": { "type": "string" }
            }
          },
          "time_created": { "type": "string", "format": "date-time" },
          "time_updated": { "type": "string", "format": "date-time" }
        }
      },
      "CustomAudienceCreate": {
        "type": "object",
        "required": ["name", "subtype"],
        "properties": {
          "name": { "type": "string" },
          "subtype": { "type": "string", "enum": ["CUSTOM", "WEBSITE", "APP", "OFFLINE_CONVERSION", "CLAIM", "PARTNER", "MANAGED", "VIDEO", "LOOKALIKE", "ENGAGEMENT"] },
          "description": { "type": "string" },
          "customer_file_source": { "type": "string", "enum": ["USER_PROVIDED_ONLY", "PARTNER_PROVIDED_ONLY", "BOTH_USER_AND_PARTNER_PROVIDED"] },
          "rule": { "type": "string", "description": "JSON-encoded rule for website/app audiences" },
          "retention_days": { "type": "integer", "description": "Number of days to retain audience members" },
          "lookalike_spec": {
            "type": "object",
            "description": "Specification for creating a lookalike audience",
            "properties": {
              "origin": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "Source audience ID" },
                    "type": { "type": "string", "enum": ["custom_audience", "page", "conversion_pixel"] },
                    "name": { "type": "string" }
                  }
                }
              },
              "country": { "type": "string", "description": "ISO country code for the lookalike" },
              "ratio": { "type": "number", "minimum": 0.01, "maximum": 0.20, "description": "Audience size ratio (1%-20%)" },
              "starting_ratio": { "type": "number" },
              "type": { "type": "string", "enum": ["similarity", "reach", "custom_ratio"] }
            }
          },
          "event_source_group": { "type": "string" },
          "product_set_id": { "type": "string" },
          "content_type": { "type": "string" },
          "claim_objective": { "type": "string" }
        }
      },
      "InsightsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "account_id": { "type": "string" },
                "account_name": { "type": "string" },
                "campaign_id": { "type": "string" },
                "campaign_name": { "type": "string" },
                "adset_id": { "type": "string" },
                "adset_name": { "type": "string" },
                "ad_id": { "type": "string" },
                "ad_name": { "type": "string" },
                "impressions": { "type": "string" },
                "clicks": { "type": "string" },
                "spend": { "type": "string" },
                "reach": { "type": "string" },
                "frequency": { "type": "string" },
                "cpc": { "type": "string" },
                "cpm": { "type": "string" },
                "cpp": { "type": "string" },
                "ctr": { "type": "string" },
                "unique_clicks": { "type": "string" },
                "unique_ctr": { "type": "string" },
                "cost_per_unique_click": { "type": "string" },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action_type": { "type": "string" },
                      "value": { "type": "string" }
                    }
                  }
                },
                "cost_per_action_type": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action_type": { "type": "string" },
                      "value": { "type": "string" }
                    }
                  }
                },
                "conversions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action_type": { "type": "string" },
                      "value": { "type": "string" }
                    }
                  }
                },
                "cost_per_conversion": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action_type": { "type": "string" },
                      "value": { "type": "string" }
                    }
                  }
                },
                "video_avg_time_watched_actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action_type": { "type": "string" },
                      "value": { "type": "string" }
                    }
                  }
                },
                "video_p25_watched_actions": { "type": "array", "items": { "type": "object" } },
                "video_p50_watched_actions": { "type": "array", "items": { "type": "object" } },
                "video_p75_watched_actions": { "type": "array", "items": { "type": "object" } },
                "video_p100_watched_actions": { "type": "array", "items": { "type": "object" } },
                "purchase_roas": { "type": "array", "items": { "type": "object" } },
                "website_purchase_roas": { "type": "array", "items": { "type": "object" } },
                "date_start": { "type": "string", "format": "date" },
                "date_stop": { "type": "string", "format": "date" },
                "objective": { "type": "string" }
              }
            }
          },
          "paging": { "$ref": "#/components/schemas/Paging" }
        }
      },
      "InsightsRequest": {
        "type": "object",
        "properties": {
          "fields": { "type": "array", "items": { "type": "string" } },
          "date_preset": { "type": "string" },
          "time_range": {
            "type": "object",
            "properties": {
              "since": { "type": "string", "format": "date" },
              "until": { "type": "string", "format": "date" }
            }
          },
          "time_increment": { "type": "string" },
          "breakdowns": { "type": "array", "items": { "type": "string" } },
          "level": { "type": "string", "enum": ["ad", "adset", "campaign", "account"] },
          "filtering": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "operator": { "type": "string", "enum": ["EQUAL", "NOT_EQUAL", "GREATER_THAN", "GREATER_THAN_OR_EQUAL", "LESS_THAN", "LESS_THAN_OR_EQUAL", "IN_RANGE", "NOT_IN_RANGE", "CONTAIN", "NOT_CONTAIN", "IN", "NOT_IN", "STARTS_WITH", "ANY", "ALL", "AFTER", "BEFORE", "NONE"] },
                "value": { "type": "string" }
              }
            }
          },
          "sort": { "type": "array", "items": { "type": "string" } },
          "action_attribution_windows": { "type": "array", "items": { "type": "string" } },
          "limit": { "type": "integer" }
        }
      },
      "AdImage": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "hash": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "url_128": { "type": "string" },
          "permalink_url": { "type": "string" },
          "original_height": { "type": "integer" },
          "original_width": { "type": "integer" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "status": { "type": "string" },
          "created_time": { "type": "string", "format": "date-time" },
          "updated_time": { "type": "string", "format": "date-time" }
        }
      },
      "AdVideo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string" },
          "picture": { "type": "string" },
          "length": { "type": "number", "description": "Duration in seconds" },
          "status": { "type": "object", "properties": { "video_status": { "type": "string" } } },
          "created_time": { "type": "string", "format": "date-time" },
          "updated_time": { "type": "string", "format": "date-time" }
        }
      },
      "Paging": {
        "type": "object",
        "properties": {
          "cursors": {
            "type": "object",
            "properties": {
              "before": { "type": "string" },
              "after": { "type": "string" }
            }
          },
          "next": { "type": "string", "description": "URL for next page" },
          "previous": { "type": "string", "description": "URL for previous page" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string" },
              "code": { "type": "integer" },
              "error_subcode": { "type": "integer" },
              "error_user_title": { "type": "string" },
              "error_user_msg": { "type": "string" },
              "fbtrace_id": { "type": "string" }
            }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Successful operation",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad request - invalid parameters or missing required fields",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - invalid or expired access token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}