                    "type": "array",
                    "items": { "$ref": "#/components/schemas/AdCreate" },
                    "description": "Array of ad specifications to create"
                  },
                  "notification_uri": { "type": "string", "description": "Webhook URL for completion notification" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Async request set created",
