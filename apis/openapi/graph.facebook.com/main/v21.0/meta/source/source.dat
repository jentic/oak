{
  "openapi": "3.0.3",
  "info": {
    "title": "Meta Marketing API",
    "description": "The Meta Marketing API is a collection of Graph API endpoints that lets you create and manage ads on Facebook, Instagram, Messenger, and the Audience Network. It covers campaign management, audience targeting, creative management, and performance reporting.",
    "version": "v21.0",
    "x-jentic-source-url": "https://developers.facebook.com/docs/marketing-apis/"
  },
  "servers": [
    {
      "url": "https://graph.facebook.com/v21.0",
      "description": "Meta Graph API v21.0"
    }
  ],
  "security": [
    {
      "accessToken": []
    }
  ],
  "tags": [
    { "name": "Campaigns", "description": "Campaign management endpoints" },
    { "name": "Ad Sets", "description": "Ad set management endpoints" },
    { "name": "Ads", "description": "Ad management endpoints" },
    { "name": "Creatives", "description": "Ad creative management endpoints" },
    { "name": "Audiences", "description": "Custom and lookalike audience endpoints" },
    { "name": "Insights", "description": "Performance reporting and analytics endpoints" },
    { "name": "Targeting", "description": "Targeting search and category endpoints" },
    { "name": "Ad Accounts", "description": "Ad account management endpoints" },
    { "name": "Images", "description": "Ad image upload and management" },
    { "name": "Videos", "description": "Ad video upload and management" }
  ],
  "paths": {
    "/act_{ad_account_id}": {
      "get": {
        "operationId": "getAdAccount",
        "summary": "Get ad account details",
        "tags": ["Ad Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          { "$ref": "#/components/parameters/fields" }
        ],
        "responses": {
          "200": {
            "description": "Ad account details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdAccount" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "updateAdAccount",
        "summary": "Update ad account settings",
        "tags": ["Ad Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "Account name" },
                  "spend_cap": { "type": "string", "description": "Maximum spend limit in account currency" },
                  "is_notifications_enabled": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/act_{ad_account_id}/assigned_users": {
      "post": {
        "operationId": "assignAdAccountUser",
        "summary": "Assign a user to an ad account with specific permissions",
        "tags": ["Ad Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user", "tasks"],
                "properties": {
                  "user": { "type": "string", "description": "Business or system user ID" },
                  "tasks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["MANAGE", "ADVERTISE", "ANALYZE", "DRAFT", "AA_ANALYZE"]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/act_{ad_account_id}/ads_volume": {
      "get": {
        "operationId": "getAdAccountAdsVolume",
        "summary": "Get count of ads running or under review",
        "tags": ["Ad Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" }
        ],
        "responses": {
          "200": {
            "description": "Ads volume data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ads_running_or_in_review_count": { "type": "integer" },
                          "current_account_ads_running_or_in_review_count": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/act_{ad_account_id}/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "summary": "List all campaigns for an ad account",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/datePreset" },
          { "$ref": "#/components/parameters/timeRange" },
          { "$ref": "#/components/parameters/filtering" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/after" },
          { "$ref": "#/components/parameters/before" }
        ],
        "responses": {
          "200": {
            "description": "List of campaigns",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Campaign" }
                    },
                    "paging": { "$ref": "#/components/schemas/Paging" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createCampaign",
        "summary": "Create a new campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CampaignCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created campaign",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "Campaign ID" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteAccountCampaigns",
        "summary": "Delete campaigns from an ad account",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          {
            "name": "before_date",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Delete campaigns created before this date"
          },
          {
            "name": "delete_strategy",
            "in": "query",
            "schema": { "type": "string", "enum": ["DELETE_ANY", "DELETE_OLDEST", "DELETE_ARCHIVED_BEFORE"] }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{campaign_id}": {
      "get": {
        "operationId": "getCampaign",
        "summary": "Get a specific campaign by ID",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/campaignId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/datePreset" },
          { "$ref": "#/components/parameters/timeRange" }
        ],
        "responses": {
          "200": {
            "description": "Campaign details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Campaign" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "updateCampaign",
        "summary": "Update an existing campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/campaignId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CampaignUpdate" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteCampaign",
        "summary": "Delete a campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/campaignId" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{campaign_id}/adsets": {
      "get": {
        "operationId": "listCampaignAdSets",
        "summary": "List ad sets for a campaign",
        "tags": ["Campaigns", "Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/campaignId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/after" }
        ],
        "responses": {
          "200": {
            "description": "List of ad sets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AdSet" }
                    },
                    "paging": { "$ref": "#/components/schemas/Paging" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{campaign_id}/ads": {
      "get": {
        "operationId": "listCampaignAds",
        "summary": "List ads for a campaign",
        "tags": ["Campaigns", "Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/campaignId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/after" }
        ],
        "responses": {
          "200": {
            "description": "List of ads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Ad" }
                    },
                    "paging": { "$ref": "#/components/schemas/Paging" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{campaign_id}/copies": {
      "post": {
        "operationId": "copyCampaign",
        "summary": "Create a copy of a campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/campaignId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rename_options": { "type": "object", "description": "Rename copied objects" },
                  "deep_copy": { "type": "boolean", "description": "Whether to deep copy ad sets and ads" },
                  "status_option": { "type": "string", "enum": ["ACTIVE", "PAUSED", "INHERITED_FROM_SOURCE"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Copied campaign ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "copied_campaign_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/act_{ad_account_id}/adsets": {
      "get": {
        "operationId": "listAdSets",
        "summary": "List all ad sets for an ad account",
        "tags": ["Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/datePreset" },
          { "$ref": "#/components/parameters/timeRange" },
          { "$ref": "#/components/parameters/filtering" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/after" },
          { "$ref": "#/components/parameters/before" }
        ],
        "responses": {
          "200": {
            "description": "List of ad sets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AdSet" }
                    },
                    "paging": { "$ref": "#/components/schemas/Paging" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createAdSet",
        "summary": "Create a new ad set",
        "tags": ["Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdSetCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created ad set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "Ad set ID" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{ad_set_id}": {
      "get": {
        "operationId": "getAdSet",
        "summary": "Get a specific ad set by ID",
        "tags": ["Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/adSetId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/datePreset" },
          { "$ref": "#/components/parameters/timeRange" }
        ],
        "responses": {
          "200": {
            "description": "Ad set details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdSet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "updateAdSet",
        "summary": "Update an existing ad set",
        "tags": ["Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/adSetId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdSetUpdate" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteAdSet",
        "summary": "Delete an ad set",
        "tags": ["Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/adSetId" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{ad_set_id}/ads": {
      "get": {
        "operationId": "listAdSetAds",
        "summary": "List ads in an ad set",
        "tags": ["Ad Sets", "Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/adSetId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/after" }
        ],
        "responses": {
          "200": {
            "description": "List of ads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Ad" }
                    },
                    "paging": { "$ref": "#/components/schemas/Paging" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{ad_set_id}/copies": {
      "post": {
        "operationId": "copyAdSet",
        "summary": "Create a copy of an ad set",
        "tags": ["Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/adSetId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "campaign_id": { "type": "string", "description": "Target campaign ID" },
                  "rename_options": { "type": "object" },
                  "deep_copy": { "type": "boolean" },
                  "status_option": { "type": "string", "enum": ["ACTIVE", "PAUSED", "INHERITED_FROM_SOURCE"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Copied ad set ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "copied_adset_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{ad_set_id}/delivery_estimate": {
      "get": {
        "operationId": "getAdSetDeliveryEstimate",
        "summary": "Get delivery estimate for an ad set",
        "tags": ["Ad Sets"],
        "parameters": [
          { "$ref": "#/components/parameters/adSetId" },
          {
            "name": "optimization_goal",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "targeting_spec",
            "in": "query",
            "schema": { "type": "string", "description": "JSON-encoded targeting spec" }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery estimate",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "daily_outcomes_curve": { "type": "array", "items": { "type": "object" } },
                          "estimate_dau": { "type": "integer" },
                          "estimate_mau_lower_bound": { "type": "integer" },
                          "estimate_mau_upper_bound": { "type": "integer" },
                          "estimate_ready": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/act_{ad_account_id}/ads": {
      "get": {
        "operationId": "listAds",
        "summary": "List all ads for an ad account",
        "tags": ["Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/datePreset" },
          { "$ref": "#/components/parameters/timeRange" },
          { "$ref": "#/components/parameters/filtering" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/after" },
          { "$ref": "#/components/parameters/before" }
        ],
        "responses": {
          "200": {
            "description": "List of ads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Ad" }
                    },
                    "paging": { "$ref": "#/components/schemas/Paging" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createAd",
        "summary": "Create a new ad",
        "tags": ["Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created ad",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "Ad ID" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/{ad_id}": {
      "get": {
        "operationId": "getAd",
        "summary": "Get a specific ad by ID",
        "tags": ["Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/adId" },
          { "$ref": "#/components/parameters/fields" },
          { "$ref": "#/components/parameters/datePreset" },
          { "$ref": "#/components/parameters/timeRange" }
        ],
        "responses": {
          "200": {
            "description": "Ad details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ad" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "updateAd",
        "summary": "Update an existing ad",
        "tags": ["Ads"],
        "parameters": [
          { "$ref": "#/components/parameters/adId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DELETED", "ARCHIVED"] },
                  "adset_id": { "type": "string" },
                  "creative": { "type": "object" },
                  "tracking_specs": { "type": "array", "items": { "type": "object" } },
                  "adlabels": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
