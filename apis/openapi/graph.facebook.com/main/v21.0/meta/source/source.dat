    "/search": {
      "get": {
        "operationId": "searchTargeting",
        "summary": "Search for targeting options including interests, demographics, behaviors, and locations",
        "tags": ["Targeting"],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "description": "Type of targeting to search for",
            "schema": {
              "type": "string",
              "enum": [
                "adinterest",
                "adinterestsuggestion",
                "adinterestvalid",
                "adgeolocation",
                "adeducationschool",
                "adeducationmajor",
                "adworkemployer",
                "adworkposition",
                "adlocale",
                "adTargetingCategory"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Search query string",
            "schema": { "type": "string" }
          },
          {
            "name": "class",
            "in": "query",
            "description": "Category class for adTargetingCategory type (demographics, behaviors, interests, life_events, industries, income, family_statuses, user_device)",
            "schema": { "type": "string" }
          },
          {
            "name": "interest_list",
            "in": "query",
            "description": "Array of interest terms for suggestion or validation",
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          {
            "name": "location_types",
            "in": "query",
            "description": "Location types for geo targeting (country, region, city, zip, geo_market, electoral_district)",
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          {
            "name": "country_code",
            "in": "query",
            "description": "Country code filter for geo targeting",
            "schema": { "type": "string" }
          },
          {
            "name": "region_id",
            "in": "query",
            "description": "Region ID filter for geo targeting",
            "schema": { "type": "string" }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Locale for localized results",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (default 8)",
            "schema": { "type": "integer", "default": 8 }
          }
        ],
        "responses": {
          "200": {
            "description": "Targeting search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "type": { "type": "string" },
                          "path": { "type": "array", "items": { "type": "string" } },
                          "audience_size_lower_bound": { "type": "integer" },
                          "audience_size_upper_bound": { "type": "integer" },
                          "description": { "type": "string" },
                          "country_code": { "type": "string" },
                          "key": { "type": "string" },
                          "region": { "type": "string" },
                          "region_id": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/act_{ad_account_id}/reachestimate": {
      "get": {
        "operationId": "getReachEstimate",
        "summary": "Get estimated audience reach for targeting criteria",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          {
            "name": "targeting_spec",
            "in": "query",
            "required": true,
            "description": "JSON-encoded targeting specification",
            "schema": { "type": "string" }
          },
          {
            "name": "optimize_for",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Reach estimate",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "users_lower_bound": { "type": "integer" },
                        "users_upper_bound": { "type": "integer" },
                        "estimate_ready": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/act_{ad_account_id}/targetingsentencelines": {
      "get": {
        "operationId": "getTargetingSentenceLines",
        "summary": "Get human-readable targeting descriptions",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/adAccountId" },
          {
            "name": "targeting_spec",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "JSON-encoded targeting specification"
          }
        ],
        "responses": {
          "200": {
            "description": "Targeting sentence lines",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "targetingsentencelines": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "content": { "type": "string" },
                              "children": { "type": "array", "items": { "type": "string" } }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
