    "/{custom_audience_id}/users": {
      "post": {
        "operationId": "addUsersToCustomAudience",
        "summary": "Add or remove users from a custom audience",
        "tags": ["Audiences"],
        "parameters": [
          { "$ref": "#/components/parameters/customAudienceId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["payload"],
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Array of schema types (e.g., EMAIL, PHONE, FN, LN)"
                      },
                      "data": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "description": "Array of hashed user data"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Users added/removed result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "audience_id": { "type": "string" },
                    "num_received": { "type": "integer" },
                    "num_invalid_entries": { "type": "integer" },
                    "invalid_entry_samples": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "removeUsersFromCustomAudience",
        "summary": "Remove users from a custom audience",
        "tags": ["Audiences"],
        "parameters": [
          { "$ref": "#/components/parameters/customAudienceId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["payload"],
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "data": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
