{
  "openapi": "3.0.3",
  "info": {
    "title": "Mathpix OCR API",
    "description": "Mathpix OCR API for processing images, documents, and equations. Converts images and PDFs to structured text formats including LaTeX, Markdown, DOCX, and HTML.",
    "version": "3.0",
    "x-jentic-source-url": "https://docs.mathpix.com/reference",
    "contact": {
      "name": "Mathpix",
      "url": "https://mathpix.com",
      "email": "support@mathpix.com"
    }
  },
  "servers": [
    {
      "url": "https://api.mathpix.com",
      "description": "Mathpix API production server"
    }
  ],
  "security": [
    {
      "appAuth": []
    }
  ],
  "paths": {
    "/v3/text": {
      "post": {
        "operationId": "processImage",
        "summary": "Process a single image",
        "description": "Process a single image for OCR, returning recognized text, LaTeX, and other formats.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "description": "Image URL or base64-encoded image"
                  },
                  "formats": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "text",
                        "data",
                        "html",
                        "latex_styled"
                      ]
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rm_spaces": {
                    "type": "boolean",
                    "default": true
                  },
                  "rm_fonts": {
                    "type": "boolean",
                    "default": false
                  },
                  "include_line_data": {
                    "type": "boolean",
                    "default": false
                  },
                  "include_word_data": {
                    "type": "boolean",
                    "default": false
                  },
                  "include_smiles": {
                    "type": "boolean",
                    "default": false
                  },
                  "include_detected_alphabets": {
                    "type": "boolean",
                    "default": false
                  },
                  "confidence_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "confidence_rate_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.75
                  },
                  "math_inline_delimiters": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "math_display_delimiters": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "data_options": {
                    "type": "object",
                    "properties": {
                      "include_svg": {
                        "type": "boolean"
                      },
                      "include_table_html": {
                        "type": "boolean"
                      },
                      "include_latex": {
                        "type": "boolean"
                      },
                      "include_tsv": {
                        "type": "boolean"
                      },
                      "include_asciimath": {
                        "type": "boolean"
                      },
                      "include_mathml": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OCR results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/v3/pdf": {
      "post": {
        "operationId": "processDocument",
        "summary": "Submit a document for OCR processing",
        "description": "Submit a PDF or document for asynchronous OCR processing. Returns a pdf_id for tracking.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "HTTP URL to download file from"
                  },
                  "streaming": {
                    "type": "boolean",
                    "default": false
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "conversion_formats": {
                    "type": "object",
                    "description": "Desired output formats"
                  },
                  "page_ranges": {
                    "type": "string",
                    "description": "Page ranges e.g. '2,4-6'"
                  },
                  "rm_spaces": {
                    "type": "boolean",
                    "default": true
                  },
                  "include_smiles": {
                    "type": "boolean",
                    "default": true
                  },
                  "enable_tables_fallback": {
                    "type": "boolean"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "options_json": {
                    "type": "string",
                    "description": "JSON string of processing options"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pdf_id": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "error_info": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v3/pdf/{pdf_id}": {
      "get": {
        "operationId": "getDocumentStatus",
        "summary": "Check document processing status",
        "parameters": [
          {
            "name": "pdf_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Processing status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentStatus"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteDocument",
        "summary": "Permanently delete document results",
        "parameters": [
          {
            "name": "pdf_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document deleted"
          }
        }
      }
    },
    "/v3/pdf/{pdf_id}/stream": {
      "get": {
        "operationId": "streamDocumentResults",
        "summary": "Stream document results via SSE",
        "parameters": [
          {
            "name": "pdf_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v3/pdf/{pdf_id}.{ext}": {
      "get": {
        "operationId": "downloadDocumentResult",
        "summary": "Download processed document results",
        "description": "Download the processed document in the specified format.",
        "parameters": [
          {
            "name": "pdf_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ext",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "mmd",
                "md",
                "docx",
                "tex.zip",
                "html",
                "pdf",
                "latex.pdf",
                "pptx",
                "mmd.zip",
                "md.zip",
                "html.zip",
                "lines.json",
                "lines.mmd.json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File download",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v3/strokes": {
      "post": {
        "operationId": "processStrokes",
        "summary": "Process handwriting stroke coordinates",
        "description": "Process handwriting stroke coordinates for OCR recognition.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "strokes": {
                    "type": "object",
                    "description": "Stroke coordinate data"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OCR results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageResult"
                }
              }
            }
          }
        }
      }
    },
    "/v3/batch": {
      "post": {
        "operationId": "processBatch",
        "summary": "Process multiple images in one request",
        "description": "Submit multiple images for batch OCR processing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Array of image URLs to process"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch processing results"
          }
        }
      }
    },
    "/v3/converter": {
      "post": {
        "operationId": "convertMarkdown",
        "summary": "Convert Mathpix Markdown to other formats",
        "description": "Transform Mathpix Markdown to DOCX, LaTeX, HTML, and other formats.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mmd": {
                    "type": "string",
                    "description": "Mathpix Markdown content"
                  },
                  "formats": {
                    "type": "object",
                    "description": "Output format options"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversion results"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImageResult": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "Recognized text in Mathpix Markdown"
          },
          "latex_styled": {
            "type": "string",
            "description": "LaTeX equation (single equation)"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "is_printed": {
            "type": "boolean"
          },
          "is_handwritten": {
            "type": "boolean"
          },
          "image_width": {
            "type": "integer"
          },
          "image_height": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "line_data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "word_data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "error": {
            "type": "string"
          },
          "error_info": {
            "type": "object"
          }
        }
      },
      "DocumentStatus": {
        "type": "object",
        "properties": {
          "pdf_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "loaded",
              "split",
              "completed",
              "error"
            ]
          },
          "num_pages": {
            "type": "integer"
          },
          "num_pages_completed": {
            "type": "integer"
          },
          "percent_done": {
            "type": "number"
          },
          "conversion_status": {
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {
      "appAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "app_key",
        "description": "Mathpix API key (also requires app_id header)"
      }
    }
  }
}