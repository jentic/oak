{
  "openapi": "3.1.0",
  "info": {
    "title": "Assumptive Quotes API",
    "version": "1.0.0",
    "description": "The Assumptive Quotes API allows integrator CRMs to create indicative quotes with partial data on behalf of a broker.\n\nThis OpenAPI file defines the external contract only.\n",
    "contact": {
      "name": "3XD Broker Portal API Support",
      "email": "info@3xd.co.uk",
      "url": "https://3xd.co.uk"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://3xd.co.uk"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/GARRYSUKHIJA/assumptive-quotes-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://portal.3xd.co.uk/api",
      "description": "Production"
    },
    {
      "url": "https://portal.uat.3xd.uk/api",
      "description": "UAT"
    },
    {
      "url": "https://portal.sandbox.3xd.uk/api",
      "description": "Sandbox"
    }
  ],
  "security": [
    {
      "OAuth2": [
        "assumptive_quotes:create",
        "quotes:read"
      ]
    }
  ],
  "tags": [
    {
      "name": "AssumptiveQuotes",
      "description": "Create assumptive quotes with partial data."
    },
    {
      "name": "Quotes",
      "description": "List and view broker quotes."
    }
  ],
  "paths": {
    "/integrators/{integratorId}/assumptive-quotes": {
      "post": {
        "operationId": "createAssumptiveQuote",
        "tags": [
          "AssumptiveQuotes"
        ],
        "summary": "Create an assumptive quote",
        "description": "Creates an assumptive quote using as much or as little input data as the client provides.\n\nThe client SHOULD send `Idempotency-Key` to safely retry. The server MUST apply integrator-defined completion rules\nand MUST return `assumptionsApplied` describing all applied completions/assumptions.\n",
        "security": [
          {
            "OAuth2": [
              "assumptive_quotes:create"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/integratorId"
          },
          {
            "$ref": "#/components/parameters/xCorrelationId"
          },
          {
            "$ref": "#/components/parameters/idempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/requests.yaml#/components/schemas/CreateAssumptiveQuoteRequest"
              },
              "examples": {
                "minimal": {
                  "summary": "Minimal request (empty payload)",
                  "value": {}
                },
                "partialHome": {
                  "summary": "Partial Home request",
                  "value": {
                    "reference": "CRM-12345",
                    "requestedProducts": [
                      "home"
                    ],
                    "home": {
                      "details": {
                        "policyStartDate": "2026-02-10"
                      },
                      "riskAddress": {
                        "line1": "1 High Street",
                        "postcode": "SW1A 1AA"
                      },
                      "applicantOne": {
                        "title": "Mr",
                        "firstName": "Alex",
                        "lastName": "Taylor",
                        "dateOfBirth": "1985-05-10",
                        "occupation": "Software Engineer",
                        "isUkResident": true
                      },
                      "buildingsInsurance": {
                        "isRequired": true,
                        "levelOfCover": 500000
                      },
                      "contentsInsurance": {
                        "isRequired": false
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote created",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/xCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/responses.yaml#/components/schemas/CreateAssumptiveQuoteResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Success response with assumptions",
                    "value": {
                      "quoteId": "2c0c1a5f-2fd7-44c4-8ef0-1cbfe0b58c2b",
                      "correlationId": "corr_abc123",
                      "portalSummaryUrl": "https://portal.3xd.co.uk/quotes/2c0c1a5f-2fd7-44c4-8ef0-1cbfe0b58c2b?source=integrator&integratorId=demo&interactionId=CRM-12345",
                      "quotePanel": [
                        {
                          "productType": "home",
                          "premium": 123.45,
                          "currency": "GBP",
                          "coverageSummary": "Buildings cover"
                        }
                      ],
                      "fullQuoteModel": {
                        "home": {
                          "details": {
                            "policyStartDate": "2026-02-10",
                            "reference": "CRM-12345"
                          },
                          "applicantOne": {
                            "title": "Mr",
                            "firstName": "Alex",
                            "lastName": "Taylor",
                            "dateOfBirth": "1985-05-10",
                            "occupation": "Software Engineer",
                            "isUkResident": true,
                            "countryOfResidence": null
                          },
                          "riskAddress": {
                            "line1": "1 High Street",
                            "line2": null,
                            "line3": null,
                            "line4": null,
                            "postcode": "SW1A 1AA",
                            "uprn": null
                          },
                          "buildingsInsurance": {
                            "isRequired": true,
                            "levelOfCover": 500000,
                            "noClaims": "0 Years",
                            "excess": 250,
                            "includeAccidentalDamage": "Standard"
                          }
                        }
                      },
                      "assumptionsApplied": [
                        {
                          "fieldName": "home.buildingsInsurance.noClaims",
                          "appliedValue": "0 Years",
                          "reason": "Not provided; completed using integrator rules"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "409": {
            "$ref": "#/components/responses/conflict"
          },
          "422": {
            "$ref": "#/components/responses/unprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/internalServerError"
          },
          "502": {
            "$ref": "#/components/responses/badGateway"
          },
          "504": {
            "$ref": "#/components/responses/gatewayTimeout"
          }
        }
      }
    },
    "/integrators/{integratorId}/brokers/me/quotes": {
      "get": {
        "operationId": "listBrokerQuotes",
        "tags": [
          "Quotes"
        ],
        "summary": "List the authenticated broker's quotes",
        "description": "Returns a lightweight, cursor-paginated list of the authenticated broker's quotes.",
        "security": [
          {
            "OAuth2": [
              "quotes:read"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/integratorId"
          },
          {
            "$ref": "#/components/parameters/xCorrelationId"
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/status"
          },
          {
            "$ref": "#/components/parameters/source"
          }
        ],
        "responses": {
          "200": {
            "description": "Quote list",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/xCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/responses.yaml#/components/schemas/ListQuotesResponse"
                },
                "examples": {
                  "firstPage": {
                    "summary": "First page (no filters)",
                    "value": {
                      "correlationId": "corr_abc123",
                      "pageSize": 20,
                      "nextPageToken": "token_opaque_123",
                      "items": [
                        {
                          "quoteId": "2c0c1a5f-2fd7-44c4-8ef0-1cbfe0b58c2b",
                          "createdAt": "2026-02-02T15:04:05Z",
                          "lastUpdatedAt": "2026-02-02T15:05:10Z",
                          "status": "draft",
                          "displayName": "Alex Taylor - Home",
                          "portalSummaryUrl": "https://portal.3xd.co.uk/quotes/2c0c1a5f-2fd7-44c4-8ef0-1cbfe0b58c2b",
                          "source": "api"
                        }
                      ]
                    }
                  },
                  "empty": {
                    "summary": "No quotes",
                    "value": {
                      "correlationId": "corr_abc123",
                      "pageSize": 20,
                      "items": []
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "500": {
            "$ref": "#/components/responses/internalServerError"
          }
        }
      }
    },
    "/oauth/authorize": {
      "get": {
        "operationId": "oauthAuthorizeReference",
        "tags": [
          "OAuthReference"
        ],
        "summary": "OAuth authorization endpoint",
        "description": "Please ignore at the moment as this will be updated in a future version.",
        "responses": {
          "302": {
            "description": "Redirect to integrator redirect_uri with authorization code."
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "operationId": "oauthTokenReference",
        "tags": [
          "OAuthReference"
        ],
        "summary": "OAuth token endpoint",
        "description": "Please ignore at the moment as this will be updated in a future version.",
        "responses": {
          "200": {
            "description": "Token response."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 Authorization Code + PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://portal.3xd.co.uk/oauth/authorize",
            "tokenUrl": "https://portal.3xd.co.uk/oauth/token",
            "refreshUrl": "https://portal.3xd.co.uk/oauth/token",
            "scopes": {
              "assumptive_quotes:create": "Create assumptive quotes",
              "quotes:read": "List broker quotes"
            }
          }
        }
      }
    },
    "parameters": {
      "integratorId": {
        "name": "integratorId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 50
        },
        "description": "Integrator tenant identifier."
      },
      "xCorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "$ref": "./schemas/requests.yaml#/components/schemas/CorrelationId"
        },
        "description": "Optional client-provided correlation identifier."
      },
      "idempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "$ref": "./schemas/requests.yaml#/components/schemas/IdempotencyKey"
        },
        "description": "Idempotency key for create requests."
      },
      "pageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100
        },
        "description": "Number of items to return per page."
      },
      "pageToken": {
        "name": "pageToken",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4000
        },
        "description": "Opaque cursor token returned by a previous response."
      },
      "from": {
        "name": "from",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "description": "Inclusive lower bound on createdAt (UTC). createdAt >= from"
      },
      "to": {
        "name": "to",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "description": "Exclusive upper bound on createdAt (UTC). createdAt < to"
      },
      "status": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "./schemas/responses.yaml#/components/schemas/QuoteStatus"
        },
        "description": "Optional filter by quote status."
      },
      "source": {
        "name": "source",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "api",
            "portal",
            "any"
          ],
          "default": "any"
        },
        "description": "Optional filter by creation source."
      }
    },
    "headers": {
      "xCorrelationId": {
        "schema": {
          "$ref": "./schemas/requests.yaml#/components/schemas/CorrelationId"
        },
        "description": "Correlation identifier echoed by the server."
      }
    },
    "responses": {
      "badRequest": {
        "description": "Malformed request or invalid pagination token.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "invalidRequest": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/invalid-request",
                  "title": "Bad Request",
                  "status": 400,
                  "detail": "The request is malformed or contains invalid parameters.",
                  "instance": "/integrators/demo/brokers/me/quotes",
                  "correlationId": "corr_abc123"
                }
              },
              "paginationTokenInvalid": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/pagination-token-invalid",
                  "title": "Pagination token invalid",
                  "status": 400,
                  "detail": "The supplied pageToken is invalid or has expired.",
                  "instance": "/integrators/demo/brokers/me/quotes",
                  "correlationId": "corr_abc123"
                }
              }
            }
          }
        }
      },
      "unauthorized": {
        "description": "Missing, invalid, or expired access token.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          },
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "invalidToken": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/invalid-token",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "The access token is missing, invalid, or expired.",
                  "instance": "/integrators/demo/assumptive-quotes",
                  "correlationId": "corr_abc123"
                }
              }
            }
          }
        }
      },
      "forbidden": {
        "description": "Integrator mismatch or insufficient authorization.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "integratorMismatch": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/integrator-mismatch",
                  "title": "Forbidden",
                  "status": 403,
                  "detail": "The integratorId does not match the token tenant context.",
                  "instance": "/integrators/wrong/assumptive-quotes",
                  "correlationId": "corr_abc123"
                }
              }
            }
          }
        }
      },
      "conflict": {
        "description": "Idempotency key reused with a different normalized payload.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "idempotencyConflict": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/idempotency-conflict",
                  "title": "Conflict",
                  "status": 409,
                  "detail": "The Idempotency-Key was already used with a different request payload.",
                  "instance": "/integrators/demo/assumptive-quotes",
                  "correlationId": "corr_abc123"
                }
              }
            }
          }
        }
      },
      "unprocessableEntity": {
        "description": "Domain validation failed.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "validationFailed": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/validation-failed",
                  "title": "Validation failed",
                  "status": 422,
                  "detail": "One or more fields are missing or invalid.",
                  "instance": "/integrators/demo/assumptive-quotes",
                  "correlationId": "corr_abc123",
                  "errors": [
                    {
                      "field": "home.contentsInsurance.levelOfCover",
                      "message": "Required when contentsInsurance.isRequired=true."
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "internalServerError": {
        "description": "Unexpected server error.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "internalError": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/internal-error",
                  "title": "Internal Server Error",
                  "status": 500,
                  "detail": "An unexpected error occurred.",
                  "instance": "/integrators/demo/assumptive-quotes",
                  "correlationId": "corr_abc123"
                }
              }
            }
          }
        }
      },
      "badGateway": {
        "description": "Upstream dependency failure.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "upstreamFailure": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/upstream-failure",
                  "title": "Upstream failure",
                  "status": 502,
                  "detail": "Pricing could not be completed due to an upstream dependency failure.",
                  "instance": "/integrators/demo/assumptive-quotes",
                  "correlationId": "corr_abc123"
                }
              }
            }
          }
        }
      },
      "gatewayTimeout": {
        "description": "The operation exceeded the hard timeout.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/xCorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "./schemas/errors.yaml#/components/schemas/ProblemDetails"
            },
            "examples": {
              "timeout": {
                "value": {
                  "type": "https://api.portal.3xd.co.uk/errors/timeout",
                  "title": "Timeout",
                  "status": 504,
                  "detail": "The request exceeded the maximum processing time.",
                  "instance": "/integrators/demo/assumptive-quotes",
                  "correlationId": "corr_abc123"
                }
              }
            }
          }
        }
      }
    }
  }
}