{
  "openapi": "3.0.0",
  "info": {
    "title": "Quickteller E-Wallet Transfer API",
    "description": "The Quickteller E-Wallet Transfer API provides secure RESTful endpoints \nfor authentication, wallet account management, and fund transfers \nwithin the Quickteller ecosystem.\n\nAll monetary operations are idempotent and protected via JWT authentication.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Quickteller API Support",
      "email": "blard@interswitchng.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/personal-250-850/Quickteller-Transfer-Wallet-API/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.quickteller.com/v1",
      "description": "Production"
    },
    {
      "url": "https://sandbox.quickteller.com/v1",
      "description": "Sandbox"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Users"
    },
    {
      "name": "Accounts"
    },
    {
      "name": "Transfers"
    },
    {
      "name": "Transactions"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "example": {
                  "id": "123e4567-e89b-12d3-a456-426614174000",
                  "username": "johndoe",
                  "email": "johndoe@email.com",
                  "createdAt": "2026-03-01T12:00:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "refreshToken": "dGhpc2lzYXJlZnJlc2h0b2tlbg==",
                  "expiresIn": 3600
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user details",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved",
            "content": {
              "application/json": {
                "example": {
                  "id": "123e4567-e89b-12d3-a456-426614174000",
                  "username": "johndoe",
                  "email": "johndoe@email.com",
                  "phone": "+2348012345678",
                  "createdAt": "2026-03-01T12:00:00Z"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/accounts": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Create wallet account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "example": {
                  "id": "987e6543-e21b-12d3-a456-426614174999",
                  "userId": "123e4567-e89b-12d3-a456-426614174000",
                  "currency": "NGN",
                  "status": "ACTIVE",
                  "createdAt": "2026-03-01T12:10:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountId}/balance": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get account balance",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Balance retrieved",
            "content": {
              "application/json": {
                "example": {
                  "availableBalance": 10000.5,
                  "ledgerBalance": 10000.5,
                  "currency": "NGN"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/transfers": {
      "post": {
        "tags": [
          "Transfers"
        ],
        "summary": "Transfer funds between accounts",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transfer successful",
            "content": {
              "application/json": {
                "example": {
                  "id": "555e4444-e21b-12d3-a456-426614174abc",
                  "fromAccountId": "987e6543-e21b-12d3-a456-426614174999",
                  "toAccountId": "123e4567-e89b-12d3-a456-426614174000",
                  "amount": 5000.0,
                  "currency": "NGN",
                  "status": "SUCCESS",
                  "createdAt": "2026-03-02T09:00:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "List transactions (paginated)",
        "parameters": [
          {
            "in": "query",
            "name": "accountId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated transaction list",
            "content": {
              "application/json": {
                "example": {
                  "content": [
                    {
                      "id": "555e4444-e21b-12d3-a456-426614174abc",
                      "amount": 5000.0,
                      "currency": "NGN",
                      "status": "SUCCESS",
                      "createdAt": "2026-03-02T09:00:00Z"
                    }
                  ],
                  "page": 0,
                  "size": 20,
                  "totalElements": 120,
                  "totalPages": 6
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transactionId}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get transaction details",
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction retrieved",
            "content": {
              "application/json": {
                "example": {
                  "id": "555e4444-e21b-12d3-a456-426614174abc",
                  "fromAccountId": "987e6543-e21b-12d3-a456-426614174999",
                  "toAccountId": "123e4567-e89b-12d3-a456-426614174000",
                  "amount": 5000.0,
                  "currency": "NGN",
                  "status": "SUCCESS",
                  "createdAt": "2026-03-02T09:00:00Z"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "example": {
              "timestamp": "2026-03-02T10:00:00Z",
              "status": 400,
              "error": "BAD_REQUEST",
              "message": "Invalid request payload",
              "path": "/transfers"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed",
        "content": {
          "application/json": {
            "example": {
              "timestamp": "2026-03-02T10:00:00Z",
              "status": 401,
              "error": "UNAUTHORIZED",
              "message": "Invalid or expired token",
              "path": "/accounts"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "example": {
              "timestamp": "2026-03-02T10:00:00Z",
              "status": 404,
              "error": "NOT_FOUND",
              "message": "Account not found",
              "path": "/accounts/123"
            }
          }
        }
      },
      "Conflict": {
        "description": "Resource conflict",
        "content": {
          "application/json": {
            "example": {
              "timestamp": "2026-03-02T10:00:00Z",
              "status": 409,
              "error": "CONFLICT",
              "message": "User already exists",
              "path": "/auth/register"
            }
          }
        }
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "username",
          "password",
          "email"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "required": [
          "userId",
          "currency"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "example": "NGN"
          }
        }
      },
      "TransferRequest": {
        "type": "object",
        "required": [
          "fromAccountId",
          "toAccountId",
          "amount",
          "currency"
        ],
        "properties": {
          "fromAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "toAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "minimum": 0.01
          },
          "currency": {
            "type": "string",
            "example": "NGN"
          },
          "narration": {
            "type": "string"
          }
        }
      }
    }
  }
}