{
  "openapi": "3.0.3",
  "info": {
    "title": "HealthData.gov Socrata Open Data API",
    "description": "HealthData.gov provides access to U.S. health datasets through the Socrata Open Data API (SODA). The platform hosts datasets from HHS, CDC, CMS, and other agencies covering topics like COVID-19, hospital capacity, Medicare, environmental health, and community health indicators. Datasets can be discovered via the catalog API and queried individually using SoQL (Socrata Query Language).",
    "version": "1.0.0",
    "contact": {
      "name": "HealthData.gov",
      "url": "https://healthdata.gov"
    },
    "license": {
      "name": "U.S. Public Domain",
      "url": "https://www.usa.gov/government-works"
    },
    "x-jentic-source-url": "https://healthdata.gov",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://healthdata.gov",
      "description": "HealthData.gov Socrata SODA API"
    }
  ],
  "security": [
    {},
    {
      "appToken": []
    }
  ],
  "paths": {
    "/api/catalog/v1": {
      "get": {
        "operationId": "searchCatalog",
        "summary": "Search and browse the dataset catalog",
        "description": "Search for datasets across the HealthData.gov catalog. Returns dataset metadata including resource IDs needed for querying individual datasets.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Full-text search query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domains",
            "in": "query",
            "description": "Filter by domain",
            "schema": {
              "type": "string",
              "default": "healthdata.gov"
            }
          },
          {
            "name": "only",
            "in": "query",
            "description": "Filter by asset type",
            "schema": {
              "type": "string",
              "enum": ["datasets", "maps", "charts", "calendars", "filters", "stories"]
            }
          },
          {
            "name": "categories",
            "in": "query",
            "description": "Filter by category",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Filter by tag",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results to return",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of results to skip for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort order for results",
            "schema": {
              "type": "string",
              "enum": ["relevance", "most_accessed", "newest", "recently_updated", "alpha"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CatalogEntry"
                      }
                    },
                    "resultSetSize": {
                      "type": "integer",
                      "description": "Total number of matching results"
                    },
                    "timings": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/resource/{datasetId}.json": {
      "get": {
        "operationId": "queryDataset",
        "summary": "Query a specific dataset using SoQL",
        "description": "Retrieve rows from a specific dataset. Supports Socrata Query Language (SoQL) for filtering, aggregation, sorting, and pagination. Each dataset has its own schema of columns.",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "Four-by-four dataset identifier (e.g., abcd-1234)",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$"
            }
          },
          {
            "name": "$where",
            "in": "query",
            "description": "SoQL WHERE clause for filtering (e.g., column_name='value')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "description": "Comma-separated list of columns to return, or aggregate expressions",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$order",
            "in": "query",
            "description": "Column(s) to sort by, with optional ASC/DESC",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$group",
            "in": "query",
            "description": "Column(s) for GROUP BY aggregation",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$having",
            "in": "query",
            "description": "Filter on aggregated values (used with $group)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$limit",
            "in": "query",
            "description": "Maximum number of rows to return",
            "schema": {
              "type": "integer",
              "default": 1000,
              "maximum": 50000
            }
          },
          {
            "name": "$offset",
            "in": "query",
            "description": "Number of rows to skip for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "$q",
            "in": "query",
            "description": "Full-text search across all text columns",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$$exclude_system_fields",
            "in": "query",
            "description": "Exclude system fields like :id and :updated_at",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of matching rows from the dataset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query syntax or unknown column name"
          },
          "403": {
            "description": "Access denied - private dataset requires authentication"
          },
          "404": {
            "description": "Dataset not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string" },
                    "error": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded - provide app token to increase limits"
          }
        }
      }
    },
    "/api/views/{datasetId}.json": {
      "get": {
        "operationId": "getDatasetMetadata",
        "summary": "Get metadata for a specific dataset",
        "description": "Retrieve detailed metadata about a dataset including its name, description, columns, tags, license, update frequency, and row count.",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "Four-by-four dataset identifier",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dataset metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetMetadata"
                }
              }
            }
          },
          "404": {
            "description": "Dataset not found"
          }
        }
      }
    },
    "/resource/{datasetId}.csv": {
      "get": {
        "operationId": "queryDatasetCsv",
        "summary": "Query a dataset and return results as CSV",
        "description": "Same as the JSON query endpoint but returns results in CSV format.",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "Four-by-four dataset identifier",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$"
            }
          },
          {
            "name": "$where",
            "in": "query",
            "description": "SoQL WHERE clause for filtering",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "description": "Columns to return",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$limit",
            "in": "query",
            "description": "Maximum number of rows",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          },
          {
            "name": "$offset",
            "in": "query",
            "description": "Number of rows to skip",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query results in CSV format",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/views/{datasetId}/rows.json": {
      "get": {
        "operationId": "getDatasetRows",
        "summary": "Get rows from a dataset via the legacy views API",
        "description": "Retrieve data rows using the legacy Socrata views API. Prefer /resource/{id}.json for new integrations.",
        "parameters": [
          {
            "name": "datasetId",
            "in": "path",
            "required": true,
            "description": "Four-by-four dataset identifier",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$"
            }
          },
          {
            "name": "accessType",
            "in": "query",
            "description": "Access type for the data",
            "schema": {
              "type": "string",
              "enum": ["DOWNLOAD", "API"],
              "default": "API"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dataset rows with metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object",
                      "properties": {
                        "view": {
                          "$ref": "#/components/schemas/DatasetMetadata"
                        }
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "appToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Token",
        "description": "Socrata application token. Not required for public datasets, but recommended to avoid rate limiting. Register at https://healthdata.gov/signup"
      }
    },
    "schemas": {
      "CatalogEntry": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "id": {
                "type": "string",
                "description": "Four-by-four dataset identifier"
              },
              "description": { "type": "string" },
              "attribution": { "type": "string" },
              "type": { "type": "string" },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "columns_name": {
                "type": "array",
                "items": { "type": "string" }
              },
              "columns_datatype": {
                "type": "array",
                "items": { "type": "string" }
              },
              "download_count": { "type": "integer" },
              "page_views": {
                "type": "object",
                "properties": {
                  "page_views_last_week": { "type": "integer" },
                  "page_views_last_month": { "type": "integer" },
                  "page_views_total": { "type": "integer" }
                }
              }
            }
          },
          "classification": {
            "type": "object",
            "properties": {
              "categories": {
                "type": "array",
                "items": { "type": "string" }
              },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "domain_category": { "type": "string" }
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "domain": { "type": "string" }
            }
          },
          "permalink": {
            "type": "string",
            "format": "uri"
          },
          "link": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "DatasetMetadata": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "attribution": { "type": "string" },
          "category": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rowsUpdatedAt": { "type": "integer" },
          "createdAt": { "type": "integer" },
          "viewCount": { "type": "integer" },
          "downloadCount": { "type": "integer" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "dataTypeName": { "type": "string" },
                "fieldName": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "license": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "termsLink": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Catalog",
      "description": "Dataset discovery and search"
    },
    {
      "name": "Data",
      "description": "Dataset query and retrieval"
    }
  ]
}
