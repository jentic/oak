            "schema": {
              "type": "string",
              "enum": [
                "A",
                "S",
                "Q",
                "M"
              ]
            }
          },
          {
            "name": "head",
            "in": "query",
            "description": "Include header metadata in response (T/F)",
            "schema": {
              "type": "string",
              "enum": [
                "T",
                "F"
              ],
              "default": "F"
            }
          },
          {
            "name": "decimals",
            "in": "query",
            "description": "Number of decimal places",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "max",
            "in": "query",
            "description": "Maximum number of records to return",
            "schema": {
              "type": "integer",
              "default": 500
            }
          },
          {
            "name": "fmt",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "Query mode (full or codes)",
            "schema": {
              "type": "string",
              "enum": [
                "full",
                "codes"
              ],
              "default": "full"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Language code (1=English, 2=French, 3=Spanish)",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ],
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with timeseries datapoints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Dataset": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ReportingEconomy": {
                            "type": "string"
                          },
                          "ReportingEconomyCode": {
                            "type": "string"
                          },
                          "PartnerEconomy": {
                            "type": "string"
                          },
                          "PartnerEconomyCode": {
                            "type": "string"
                          },
                          "ProductOrSector": {
                            "type": "string"
                          },
                          "ProductOrSectorCode": {
                            "type": "string"
                          },
                          "ProductOrSectorClassification": {
                            "type": "string"
                          },
                          "Indicator": {
                            "type": "string"
                          },
                          "IndicatorCode": {
                            "type": "string"
                          },
                          "Year": {
                            "type": "string"
                          },
                          "Period": {
                            "type": "string"
                          },
                          "Frequency": {
                            "type": "string"
                          },
                          "Unit": {
                            "type": "string"
                          },
                          "Value": {
                            "type": "number",
                            "nullable": true
                          },
                          "ValueFlagCode": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing subscription key"
          }
        }
      }
