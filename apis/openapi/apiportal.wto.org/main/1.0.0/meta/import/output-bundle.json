    "/data": {
      "get": {
        "operationId": "getTimeSeriesData",
        "summary": "Get timeseries datapoints",
        "description": "Returns timeseries datapoints based on the specified filter criteria. This is the primary data retrieval endpoint.",
        "parameters": [
