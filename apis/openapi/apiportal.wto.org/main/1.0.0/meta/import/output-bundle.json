{
  "openapi": "3.0.3",
  "info": {
    "title": "WTO Timeseries API",
    "description": "The WTO flagship Timeseries API provides programmatic access to statistical indicators related to WTO issues, including merchandise trade and trade in services statistics (annual, quarterly, monthly), market access indicators (tariffs), and non-tariff information.",
    "version": "1.0.0",
    "contact": {
      "name": "World Trade Organization",
      "url": "https://apiportal.wto.org/"
    },
    "x-jentic-source-url": "https://apiportal.wto.org/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.wto.org/timeseries/v1",
      "description": "WTO Timeseries API v1 Production Server"
    }
  ],
  "paths": {
    "/indicators": {
      "get": {
        "operationId": "getIndicators",
        "summary": "Get list of available indicators",
        "description": "Returns a list of all available statistical indicators in the WTO Timeseries database.",
        "parameters": [
          {
            "name": "i",
            "in": "query",
            "description": "Indicator code filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "t",
            "in": "query",
            "description": "Topic code filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Language code (1=English, 2=French, 3=Spanish)",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ],
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of indicators",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "description": "Indicator code"
                      },
                      "name": {
                        "type": "string",
                        "description": "Indicator name"
                      },
                      "categoryCode": {
                        "type": "string"
                      },
                      "categoryLabel": {
                        "type": "string"
                      },
                      "subcategoryCode": {
                        "type": "string"
                      },
                      "subcategoryLabel": {
                        "type": "string"
                      },
                      "unitCode": {
                        "type": "string"
                      },
                      "unitLabel": {
                        "type": "string"
                      },
                      "startYear": {
                        "type": "integer"
                      },
                      "endYear": {
                        "type": "integer"
                      },
                      "frequencyCode": {
                        "type": "string"
                      },
                      "frequencyLabel": {
                        "type": "string"
                      },
                      "numberReporters": {
                        "type": "integer"
                      },
                      "numberPartners": {
                        "type": "integer"
                      },
                      "numberOfProducts": {
                        "type": "integer"
                      },
                      "hasMetadata": {
                        "type": "boolean"
                      },
                      "numberDecimals": {
                        "type": "integer"
                      },
                      "numberDatapoints": {
                        "type": "integer"
                      },
                      "topicCode": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing subscription key"
          }
        }
      }
    },
