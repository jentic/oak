          },
          {
            "in": "query",
            "name": "created_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Labels by created timestamp"
          },
          {
            "in": "query",
            "name": "created_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Labels by created timestamp"
          },
          {
            "in": "query",
            "name": "eids",
            "schema": {
              "type": "string"
            },
            "description": "Filter Labels by associated Product EIDs"
          },
          {
            "in": "query",
            "name": "gtins",
            "schema": {
              "type": "string"
            },
            "description": "Filter Labels by associated Product GTINs"
          },
          {
            "in": "query",
            "name": "internal_ids",
            "schema": {
              "type": "string"
            },
            "description": "Filter Labels by associated Product internal_ids"
          },
          {
            "in": "query",
            "name": "is_associated",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by whether or not Label is associated. ex. `true` or `false`"
          },
          {
            "in": "query",
            "name": "item_tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Labels by Item tags separated by commas"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "modified_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Labels by modified timestamp"
          },
          {
            "in": "query",
            "name": "modified_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Labels by modified timestamp"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-created",
                  "-id",
                  "-modified",
                  "-reference_id_namespace",
                  "-type",
                  "created",
                  "id",
                  "modified",
                  "reference_id_namespace",
                  "type"
                ]
              }
            },
            "description": "Order labels by `created`, `modified`, `id`, `reference_id_namespace`, and `type` fields\n\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `id` - Id\n* `-id` - Id (descending)\n* `reference_id_namespace` - Reference id namespace\n* `-reference_id_namespace` - Reference id namespace (descending)\n* `type` - Type\n* `-type` - Type (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "reference_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "reference_id_namespace",
            "schema": {
              "type": "string"
            },
            "description": "Filter Labels by reference_id_namespace"
          },
          {
            "in": "query",
            "name": "skip_count",
            "schema": {
              "type": "string"
            },
            "description": "If provided, the response will not include a count of total objects, and will not execute a COUNT(*) query. This can improve performance on large datasets where the total count is not needed. Next and previous URLs will still be provided.",
            "examples": {
              "SkipCount": {
                "value": true,
                "summary": "Skip Count"
              }
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Labels by tags separated by commas"
          }
        ],
        "tags": [
          "Labels - List"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
