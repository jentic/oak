    },
    "/api/v2/items/{filter}/{id}/ser/{serial}/assets/": {
      "get": {
        "operationId": "Retrieve Item Assets Data by filter, id, serial",
        "description": "Retrieve assets associated with an Item using a single \"reference_id\" or a combination of a filter (eid/gtin/internal_id) along with their respective \"id\" and \"serial\".",
        "parameters": [
          {
            "in": "path",
            "name": "filter",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "property",
            "schema": {
              "type": "string"
            },
            "description": "Filter assets by property",
            "examples": {
              "FilterProperty": {
                "value": "photograph",
                "summary": "Filter property"
              }
            }
          },
          {
            "in": "query",
            "name": "reference",
            "schema": {
              "type": "string"
            },
            "description": "Filter assets by reference",
            "examples": {
              "FilterReference": {
                "value": "front",
                "summary": "Filter reference"
              }
            }
          },
          {
            "in": "query",
            "name": "reference_group",
            "schema": {
              "type": "string"
            },
            "description": "Filter assets by reference_group",
            "examples": {
              "FilterReferenceGroup": {
                "value": "images-collection-a",
                "summary": "Filter reference_group"
              }
            }
          },
          {
            "in": "path",
            "name": "serial",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": [
          "Items - Assets"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAssetList"
                }
              }
            },
            "description": "Successful Operation"
          }
        }
      },
      "post": {
