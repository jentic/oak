    "/api/v2/folders/": {
      "get": {
        "operationId": "Folder List",
        "description": "Retrieve a list of all Folders.",
        "summary": "List Folders",
        "parameters": [
          {
            "in": "query",
            "name": "description",
            "schema": {
              "type": "string"
            },
            "description": "Filter folders by description, case insensitive"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "name",
            "schema": {
              "type": "string"
            },
            "description": "Filter folders by name, case insensitive"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-id",
                  "-name",
                  "-parent_id",
                  "id",
                  "name",
                  "parent_id"
                ]
              }
            },
            "description": "Order folders by `id`, `name` and `parent_id` fields\n\n* `id` - Id\n* `-id` - Id (descending)\n* `name` - Name\n* `-name` - Name (descending)\n* `parent_id` - Parent id\n* `-parent_id` - Parent id (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "parent_id",
            "schema": {
              "type": "number"
            },
            "description": "Filter folders by parent folder ID"
          },
          {
            "in": "query",
            "name": "parent_id__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter folders by parent folder ID exists or not"
          }
        ],
        "tags": [
          "Folders - List"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedFolderList"
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "Folder Create",
        "description": "Create a Folder.",
        "tags": [
          "Folders - Create"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/FolderRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/FolderRequest"
              }
            }
          },
          "required": true
        },
        "security": [
