            "in": "query",
            "name": "release_date_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by release_date timestamp."
          },
          {
            "in": "query",
            "name": "sku",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter products by tags separated by commas"
          },
          {
            "in": "query",
            "name": "upcoming_release",
            "schema": {
              "type": "boolean"
            },
            "description": "Include only Products that have a release_date within two weeks from now."
          }
        ],
        "tags": [
          "Products - Async Actions"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductAdvancedExportRequestRequest"
              },
              "examples": {
                "FilterDSL-Basic": {
                  "value": {
                    "input_filter": {
                      "quantifier": "ALL",
                      "conditions": [
                        {
                          "field": "name",
                          "operator": "contains",
                          "value": "Sneaker"
                        }
                      ]
                    }
                  },
                  "summary": "Filter Products by name contains",
                  "description": "Example of using FilterDSL to filter Products."
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ProductAdvancedExportRequestRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ProductAdvancedExportRequestRequest"
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncJob"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
