            "in": "query",
            "name": "name__not_in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding multiple names (comma-separated)"
          },
          {
            "in": "query",
            "name": "not_exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-existence (is null or blank)"
