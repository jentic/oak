    "/api/v2/schemas/": {
      "get": {
        "operationId": "Schema List",
        "description": "Mixin that provides schema retrieval functionality for any model.\n\nThis mixin allows retrieving JSON schemas from predefined files in the predefined_eon_schemas/ directory.\nThe schema files should be organized by type (e.g. json) and named according to the pattern:\n{schema_title}_{schema_version}_schema.{schema_type}\n\nExample schema file structure:\npredefined_eon_schemas/\n\u251c\u2500\u2500 json/\n\u2502   \u251c\u2500\u2500 product_core_schema.json\n\u2502   \u251c\u2500\u2500 product_v2_schema.json\n\u2502   \u2514\u2500\u2500 item_core_schema.json\n\u2514\u2500\u2500 yaml/\n    \u2514\u2500\u2500 product_core_schema.yaml\n\nExample request:\nGET /api/v2/schemas/predefined/json/core_product/\n\nAttributes:\n    schema_type (str): Default schema type\n    schema_title (str): Default schema title\n    schema_version (str): Optional schema version",
        "parameters": [
          {
            "in": "query",
            "name": "created_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter schemas by created timestamp"
          },
          {
            "in": "query",
            "name": "created_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter schemas by created timestamp"
          },
          {
            "in": "query",
            "name": "field_group",
            "schema": {
              "type": "string"
            },
            "description": "Filter schemas by field group separated by commas"
          },
          {
            "in": "query",
            "name": "is_system_schema",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter schemas by whether or not they are available system-wide"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "modified_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter schemas by modified timestamp"
          },
          {
            "in": "query",
            "name": "modified_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter schemas by modified timestamp"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-created",
                  "-description",
                  "-id",
                  "-modified",
                  "-name",
                  "created",
                  "description",
                  "id",
                  "modified",
                  "name"
                ]
              }
            },
            "description": "Order schemas by `created`, `modified`, `id`, `name` and `description` fields\n\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `id` - Id\n* `-id` - Id (descending)\n* `name` - Name\n* `-name` - Name (descending)\n* `description` - Description\n* `-description` - Description (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "description": "Filter Schemas by partial query on name, description and field group, case insensitive"
          }
        ],
        "tags": [
          "Schemas"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedSchemaList"
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "Schema Create",
        "description": "Create an Schema.",
        "summary": "Create an Schema.",
        "tags": [
          "Schemas - Create"
        ],
        "requestBody": {
          "content": {
