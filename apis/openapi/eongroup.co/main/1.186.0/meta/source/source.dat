{
  "openapi": "3.0.3",
  "info": {
    "title": "EON API - Documentation Device",
    "version": "1.186.0",
    "description": "API Documentation for Documentation Device\n\nThis schema is filtered to show only the endpoints accessible with this device. \n\nOrganization: EON Group\nDevice Type: Custom\n",
