    "/api/v2/products/generate-batch/": {
      "post": {
        "operationId": "Generate Batch",
        "description": "Generate a batch of Items.\n        Note on tagging: a tag that is prefixed with 'pipeline-run' will be applied to all related models including the Batch.\n        Only one tag prefixed with 'pipeline-run' may be provided. If more than one is specified, the first specified will be used.\n        ",
