      "Material": {
        "type": "object",
        "description": "This serializer allows for materials to be attached to child_materials recursively.\nThe validation is performed at the serializer level, as such, there is potential for a cyclical reference if Models are persisted via a different means.\nIdeally, we would have some constraint on the DB to prevent a cyclical reference\nTODO: Find a better way to retrieve child materials recursively in a single DB Query\nTODO: Find a better way to prevent cyclical references",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "internal_id": {
            "type": "string",
            "nullable": true,
            "description": "ID that is unique to the Organization.",
            "pattern": "[<>\"#\\'%{}|\\\\^~[+\\/\\]`]",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "title": "Material Name",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "custom_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "readOnly": true
          },
          "supplier": {
            "type": "integer",
            "nullable": true
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "modified": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "child_materials": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "readOnly": true
          },
          "structured_data": {
            "description": "Structured data as per the associated schema."
          },
          "structured_data_schema": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the schema associated with the structured data."
          }
        },
        "required": [
          "child_materials",
          "created",
          "custom_tags",
          "id",
          "modified",
          "name"
        ]
      },
      "MaterialRequest": {
        "type": "object",
        "description": "This serializer allows for materials to be attached to child_materials recursively.\nThe validation is performed at the serializer level, as such, there is potential for a cyclical reference if Models are persisted via a different means.\nIdeally, we would have some constraint on the DB to prevent a cyclical reference\nTODO: Find a better way to retrieve child materials recursively in a single DB Query\nTODO: Find a better way to prevent cyclical references",
        "properties": {
          "internal_id": {
            "type": "string",
            "nullable": true,
            "description": "ID that is unique to the Organization.",
            "pattern": "[<>\"#\\'%{}|\\\\^~[+\\/\\]`]",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Material Name",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "supplier": {
            "type": "integer",
            "nullable": true
          },
          "structured_data": {
            "description": "Structured data as per the associated schema."
          },
          "structured_data_schema": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the schema associated with the structured data."
          }
        },
        "required": [
          "name"
        ]
      },
      "MetricTypeEnum": {
        "enum": [
          "avg",
          "percentiles",
          "cardinality",
          "count",
          "sum",
          "min",
          "max"
        ],
        "type": "string",
        "description": "* `avg` - avg\n* `percentiles` - percentiles\n* `cardinality` - cardinality\n* `count` - count\n* `sum` - sum\n* `min` - min\n* `max` - max"
      },
