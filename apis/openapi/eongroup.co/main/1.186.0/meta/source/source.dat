  "components": {
    "schemas": {
      "AccessEnum": {
        "enum": [
          "public",
          "private"
        ],
        "type": "string",
        "description": "* `public` - public\n* `private` - private"
      },
      "AggregationCustomMetric": {
        "type": "object",
        "description": "Note: this inherits from all other Serializers in order to pass data for all prospective fields through the validation process. Otherwise,\nthe parent serializer will strip out unknown fields from `data`, even though the child serializers may need them.\n\nNot entirely sure this is the best way to handle this, but it works for now.",
        "properties": {
          "metric_type": {
            "type": "string",
            "description": "The type of custom aggregation to use."
          },
          "name": {
            "type": "string",
            "description": "The name of the aggregation."
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TypeB89Enum"
              }
            ],
            "description": "The type of interaction to use as a marker.\n\n* `manufactured` - manufactured\n* `item_data_updated` - item_data_updated\n* `label_associated` - label_associated\n* `aggregated` - aggregated\n* `disaggregated` - disaggregated\n* `destroyed` - destroyed\n* `upcrafted` - upcrafted\n* `disassembled` - disassembled\n* `transformed` - transformed\n* `recycled` - recycled\n* `product_care` - product_care\n* `restored` - restored\n* `remade` - remade\n* `in_transit` - in_transit\n* `associated` - associated\n* `disassociated` - disassociated\n* `repaired` - repaired\n* `rental_returned` - rental_returned\n* `resold` - resold\n* `sold` - sold\n* `shipped` - shipped\n* `received` - received\n* `sorted` - sorted\n* `listed` - listed\n* `delisted` - delisted\n* `lost_stolen` - lost_stolen\n* `returned` - returned\n* `return` - return\n* `quality_assessed` - quality_assessed\n* `rental_allocated` - rental_allocated\n* `quality_controlled` - quality_controlled\n* `released` - released\n* `made_available` - made_available\n* `issued` - issued\n* `takeback` - takeback\n* `claimed` - claimed\n* `transferred_ownership` - transferred_ownership\n* `exchanged` - exchanged\n* `traded_in` - traded_in\n* `gifted` - gifted\n* `cancelled` - cancelled\n* `user_label_scan` - user_label_scan\n* `cx_interaction` - cx_interaction\n* `recorded_customer_feedback` - recorded_customer_feedback\n* `redirect_resale` - redirect_resale\n* `redirect_cx` - redirect_cx\n* `redirect_compliance` - redirect_compliance\n* `item_data_api_retrieval` - item_data_api_retrieval\n* `vqr_authenticated` - vqr_authenticated\n* `vqr_failed_authentication` - vqr_failed_authentication"
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "end_date": {
            "type": "string",
            "format": "date-time"
          },
          "count_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CountTypeEnum"
              }
            ],
            "description": "The type of interaction that should be counted after the specified \"type\".\n\n* `manufactured` - manufactured\n* `item_data_updated` - item_data_updated\n* `label_associated` - label_associated\n* `aggregated` - aggregated\n* `disaggregated` - disaggregated\n* `destroyed` - destroyed\n* `upcrafted` - upcrafted\n* `disassembled` - disassembled\n* `transformed` - transformed\n* `recycled` - recycled\n* `product_care` - product_care\n* `restored` - restored\n* `remade` - remade\n* `in_transit` - in_transit\n* `associated` - associated\n* `disassociated` - disassociated\n* `repaired` - repaired\n* `rental_returned` - rental_returned\n* `resold` - resold\n* `sold` - sold\n* `shipped` - shipped\n* `received` - received\n* `sorted` - sorted\n* `listed` - listed\n* `delisted` - delisted\n* `lost_stolen` - lost_stolen\n* `returned` - returned\n* `return` - return\n* `quality_assessed` - quality_assessed\n* `rental_allocated` - rental_allocated\n* `quality_controlled` - quality_controlled\n* `released` - released\n* `made_available` - made_available\n* `issued` - issued\n* `takeback` - takeback\n* `claimed` - claimed\n* `transferred_ownership` - transferred_ownership\n* `exchanged` - exchanged\n* `traded_in` - traded_in\n* `gifted` - gifted\n* `cancelled` - cancelled\n* `user_label_scan` - user_label_scan\n* `cx_interaction` - cx_interaction\n* `recorded_customer_feedback` - recorded_customer_feedback\n* `redirect_resale` - redirect_resale\n* `redirect_cx` - redirect_cx\n* `redirect_compliance` - redirect_compliance\n* `item_data_api_retrieval` - item_data_api_retrieval\n* `vqr_authenticated` - vqr_authenticated\n* `vqr_failed_authentication` - vqr_failed_authentication"
          },
          "aggregation_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AggregationTypeEnum"
              }
            ],
            "default": "avg",
            "description": "The type of aggregation to use.\n\n* `avg` - avg\n* `percentiles` - percentiles\n* `cardinality` - cardinality\n* `count` - count\n* `sum` - sum\n* `min` - min\n* `max` - max"
