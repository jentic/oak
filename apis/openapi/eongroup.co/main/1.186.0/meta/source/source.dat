              },
              "IncludeSystemTagsAndCustomData": {
                "value": "system_tags&include=custom_data",
                "summary": "Include System Tags and Custom Data"
              }
            }
          },
          {
            "in": "query",
            "name": "is_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' blankness (is blank)"
          },
          {
            "in": "query",
            "name": "is_not_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-blankness (is not blank)"
          },
          {
            "in": "query",
            "name": "is_not_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-nullness (is not null)"
          },
          {
            "in": "query",
            "name": "is_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' nullness (is null)"
          },
          {
            "in": "query",
            "name": "is_product_released",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Items by whether or not Product is released"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "modified_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Items by modified timestamp"
          },
          {
            "in": "query",
            "name": "modified_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Items by modified timestamp"
          },
          {
            "in": "query",
            "name": "not_exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-existence (is null or blank)"
          },
          {
            "name": "offset",
