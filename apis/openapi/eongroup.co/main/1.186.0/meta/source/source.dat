            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by tags separated by commas (all tags must be present)"
          },
          {
            "in": "query",
            "name": "tags__not",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding assets that have any of the specified tags (comma-separated)"
          }
