    "/api/v2/items/async-bulk-update/validate/": {
      "post": {
        "operationId": "Validate Async Bulk Update Request",
        "description": "Validate an async bulk update request without queuing the job.",
        "tags": [
          "Items - Async Actions"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemAsyncBulkUpdateRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ItemAsyncBulkUpdateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ItemAsyncBulkUpdateRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemAsyncBulkUpdateValidationResponse"
                }
              }
            },
            "description": "Validation Results"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemAsyncBulkUpdateValidationResponse"
                },
                "examples": {
                  "InvalidRequest": {
                    "value": {
                      "errors": {
                        "override_data": [
                          "Additional properties are not allowed (\"invalid_field\" was unexpected)"
                        ],
                        "total_count": "Queryset size 345031 exceeds the maximum allowed 350000."
                      },
                      "total_count": 345031,
                      "is_valid": false
                    },
                    "summary": "Invalid Request"
                  }
                }
              }
            },
            "description": "Validation Errors"
          }
        }
      }
    },
