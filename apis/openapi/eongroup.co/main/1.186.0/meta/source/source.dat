      "Schema": {
        "type": "object",
        "description": "If `?merge` query params are specified on a PATCH request, merge JSON field data into existing data\nrather than overwriting for specified fields.\n\nRequires `merge_fields` to be set: list of mergeable fields.",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "description": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/SchemaTypeEnum"
          },
          "field_group": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/FieldGroupEnum"
              },
              {
                "$ref": "#/components/schemas/BlankEnum"
              },
              {
                "$ref": "#/components/schemas/NullEnum"
              }
            ]
          },
          "is_system_schema": {
            "type": "boolean"
          },
          "raw_schema": {}
        },
        "required": [
          "id"
        ]
      },
      "SchemaFieldGroup": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "schema": {}
        },
        "required": [
          "label",
          "schema",
          "value"
        ]
      },
      "SchemaRequest": {
        "type": "object",
        "description": "If `?merge` query params are specified on a PATCH request, merge JSON field data into existing data\nrather than overwriting for specified fields.\n\nRequires `merge_fields` to be set: list of mergeable fields.",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/SchemaTypeEnum"
          },
          "field_group": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/FieldGroupEnum"
              },
              {
                "$ref": "#/components/schemas/BlankEnum"
              },
              {
                "$ref": "#/components/schemas/NullEnum"
              }
            ]
          },
          "is_system_schema": {
            "type": "boolean"
          },
          "raw_schema": {}
        }
      },
      "SchemaTypeEnum": {
        "enum": [
          "JSON"
        ],
        "type": "string",
        "description": "* `JSON` - JSON"
      },
      "StatusEnum": {
        "enum": [
          "unevaluated",
          "compliant",
          "non_compliant",
          "error"
        ],
        "type": "string",
        "description": "* `unevaluated` - Unevaluated\n* `compliant` - Compliant\n* `non_compliant` - Non-Compliant\n* `error` - Error"
      },
      "Tag": {
        "type": "object",
        "description": "TODO; Refactor the internal API tags serializer, this is a temporary clone of the serializer until the internal API is refactored.",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "type": {
            "$ref": "#/components/schemas/TagTypeEnum"
          }
        },
        "required": [
          "name"
        ]
      },
      "TagTypeEnum": {
        "enum": [
          "batch",
          "custom",
          "date",
          "origin"
        ],
        "type": "string",
        "description": "* `batch` - Batch\n* `custom` - Custom\n* `date` - Date\n* `origin` - Origin"
      },
