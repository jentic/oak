            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-created",
                  "-gtin",
                  "-id",
                  "-internal_id",
                  "-item_count",
                  "-modified",
                  "-name",
                  "-release_date",
                  "-sku",
                  "created",
                  "gtin",
                  "id",
                  "internal_id",
                  "item_count",
                  "modified",
                  "name",
                  "release_date",
                  "sku"
                ]
              }
            },
            "description": "Order products by `created`, `modified`, `id`, `internal_id`, `gtin`, `release_date`, `name` and `sku` fields, as well as by the count of Items.\n\n* `id` - Id\n* `-id` - Id (descending)\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `internal_id` - Internal id\n* `-internal_id` - Internal id (descending)\n* `gtin` - Gtin\n* `-gtin` - Gtin (descending)\n* `release_date` - Release date\n* `-release_date` - Release date (descending)\n* `name` - Name\n* `-name` - Name (descending)\n* `sku` - Sku\n* `-sku` - Sku (descending)\n* `item_count` - Item count\n* `-item_count` - Item count (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "redirect_url",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "redirect_url_empty",
            "schema": {
              "type": "boolean"
            },
            "description": "Include only Products without a redirect_url."
          },
          {
            "in": "query",
            "name": "redirect_url_filled",
            "schema": {
              "type": "boolean"
            },
            "description": "Include only Products with a redirect_url."
          },
          {
            "in": "query",
            "name": "release_date_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by release_date timestamp."
          },
          {
            "in": "query",
            "name": "release_date_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by release_date timestamp."
          },
          {
            "in": "query",
            "name": "sku",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter products by tags separated by commas"
          },
          {
            "in": "query",
            "name": "upcoming_release",
            "schema": {
              "type": "boolean"
            },
            "description": "Include only Products that have a release_date within two weeks from now."
          }
        ],
        "tags": [
          "Products - Async Actions"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductExportIdentifierDataRequest"
              },
              "examples": {
                "FilterDSL-Items": {
                  "value": {
                    "input_filter": {
                      "quantifier": "ALL",
                      "conditions": [
                        {
                          "field": "tags.name",
                          "operator": "contains",
                          "value": [
                            "agec"
                          ]
                        }
                      ]
                    }
                  },
                  "summary": "Filter Items by tag contains \"agec\"",
                  "description": "Example of using FilterDSL to filter Items."
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ProductExportIdentifierDataRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ProductExportIdentifierDataRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncJob"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
