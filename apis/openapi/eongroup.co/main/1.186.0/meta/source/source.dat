            "in": "query",
            "description": "The initial index from which to return the results.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-created",
                  "-id",
                  "-modified",
                  "-serial",
                  "created",
                  "id",
                  "modified",
                  "serial"
                ]
              }
            },
            "description": "Order items by `created`, `modified` and `serial` fields\n\n* `id` - Id\n* `-id` - Id (descending)\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `serial` - Serial\n* `-serial` - Serial (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "override_data",
            "schema": {
              "type": "string"
            },
            "description": "Filter Items by internal override_data key separated by commas"
          },
          {
            "in": "query",
            "name": "product_tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Items by Product tags separated by commas"
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "A search term.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "serial",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "skip_count",
            "schema": {
              "type": "string"
            },
            "description": "If provided, the response will not include a count of total objects, and will not execute a COUNT(*) query. This can improve performance on large datasets where the total count is not needed. Next and previous URLs will still be provided.",
            "examples": {
              "SkipCount": {
                "value": true,
                "summary": "Skip Count"
              }
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Items by Item tags separated by commas"
