    "/api/v2/products/": {
      "get": {
        "operationId": "Product List",
        "description": "Get a collection of Products.",
        "parameters": [
          {
            "in": "query",
            "name": "core_data",
            "schema": {
              "type": "string"
            },
            "description": "Filter Products by an internal core_data value separated by commas"
          },
          {
            "in": "query",
            "name": "created_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by created timestamp"
          },
          {
            "in": "query",
            "name": "created_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by created timestamp"
          },
          {
            "in": "query",
            "name": "custom_data",
            "schema": {
              "type": "string"
            },
            "description": "Filter Products by an internal custom_data value separated by commas"
          },
          {
            "in": "query",
            "name": "eids",
            "schema": {
              "type": "string"
            },
            "description": "Filter products by eids separated by commas"
          },
          {
            "in": "query",
            "name": "exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' existence (is not null or blank)"
          },
          {
            "in": "query",
            "name": "gtins",
            "schema": {
              "type": "string"
            },
            "description": "Filter products by gtins separated by commas"
          },
          {
            "in": "query",
            "name": "has_release_date",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Products by whether or not they have a release_date."
          },
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "include",
            "schema": {
              "type": "string"
            },
            "description": "Include fields that otherwise will be omitted from the response and unavailable for create/update.",
            "examples": {
              "IncludeCustomTags": {
                "value": "custom_tags",
                "summary": "Include Custom Tags"
              },
              "IncludeSystemTagsAndCustomData": {
                "value": "system_tags&include=custom_data",
                "summary": "Include System Tags and Custom Data"
              }
            }
          },
          {
            "in": "query",
            "name": "internal_ids",
            "schema": {
              "type": "string"
            },
            "description": "Filter products by internal_ids separated by commas"
          },
          {
            "in": "query",
            "name": "is_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' blankness (is blank)"
          },
          {
            "in": "query",
            "name": "is_not_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-blankness (is not blank)"
          },
          {
            "in": "query",
            "name": "is_not_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-nullness (is not null)"
          },
          {
            "in": "query",
            "name": "is_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' nullness (is null)"
          },
          {
            "in": "query",
            "name": "is_redirect_enabled",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "is_released",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Products by the release data being in the past."
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "modified_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by modified timestamp"
          },
          {
            "in": "query",
            "name": "modified_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by modified timestamp"
          },
          {
            "in": "query",
            "name": "not_exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-existence (is null or blank)"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-created",
                  "-gtin",
                  "-id",
                  "-internal_id",
                  "-item_count",
                  "-modified",
                  "-name",
                  "-release_date",
                  "-sku",
                  "created",
                  "gtin",
                  "id",
                  "internal_id",
                  "item_count",
                  "modified",
                  "name",
                  "release_date",
                  "sku"
                ]
              }
            },
            "description": "Order products by `created`, `modified`, `id`, `internal_id`, `gtin`, `release_date`, `name` and `sku` fields, as well as by the count of Items.\n\n* `id` - Id\n* `-id` - Id (descending)\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `internal_id` - Internal id\n* `-internal_id` - Internal id (descending)\n* `gtin` - Gtin\n* `-gtin` - Gtin (descending)\n* `release_date` - Release date\n* `-release_date` - Release date (descending)\n* `name` - Name\n* `-name` - Name (descending)\n* `sku` - Sku\n* `-sku` - Sku (descending)\n* `item_count` - Item count\n* `-item_count` - Item count (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "redirect_url",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "redirect_url_empty",
            "schema": {
              "type": "boolean"
            },
            "description": "Include only Products without a redirect_url."
          },
          {
            "in": "query",
            "name": "redirect_url_filled",
            "schema": {
              "type": "boolean"
            },
            "description": "Include only Products with a redirect_url."
          },
          {
            "in": "query",
            "name": "release_date_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by release_date timestamp."
          },
          {
            "in": "query",
            "name": "release_date_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter products by release_date timestamp."
          },
          {
            "in": "query",
            "name": "skip",
            "schema": {
              "type": "string"
            },
            "description": "If provided, the response will not include the specified fields in the response.",
            "examples": {
              "SkipItemsCount": {
                "value": "items_count",
                "summary": "Skip items_count"
              }
            }
          },
          {
            "in": "query",
            "name": "skip_count",
            "schema": {
              "type": "string"
            },
            "description": "If provided, the response will not include a count of total objects, and will not execute a COUNT(*) query. This can improve performance on large datasets where the total count is not needed. Next and previous URLs will still be provided.",
            "examples": {
              "SkipCount": {
                "value": true,
                "summary": "Skip Count"
              }
            }
          },
          {
            "in": "query",
            "name": "sku",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter products by tags separated by commas"
          },
          {
            "in": "query",
            "name": "upcoming_release",
            "schema": {
              "type": "boolean"
            },
            "description": "Include only Products that have a release_date within two weeks from now."
          }
        ],
        "tags": [
          "Products - List"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
