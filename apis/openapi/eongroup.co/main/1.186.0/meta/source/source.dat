                  "gtin",
                  "id",
                  "internal_id",
                  "item_count",
                  "modified",
                  "name",
                  "release_date",
                  "sku"
                ]
              }
            },
            "description": "Order products by `created`, `modified`, `id`, `internal_id`, `gtin`, `release_date`, `name` and `sku` fields, as well as by the count of Items.\n\n* `id` - Id\n* `-id` - Id (descending)\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `internal_id` - Internal id\n* `-internal_id` - Internal id (descending)\n* `gtin` - Gtin\n* `-gtin` - Gtin (descending)\n* `release_date` - Release date\n* `-release_date` - Release date (descending)\n* `name` - Name\n* `-name` - Name (descending)\n* `sku` - Sku\n* `-sku` - Sku (descending)\n* `item_count` - Item count\n* `-item_count` - Item count (descending)",
            "explode": false,
            "style": "form"
          },
