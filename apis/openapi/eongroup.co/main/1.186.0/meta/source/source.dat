    "/api/v2/items/export/": {
      "post": {
        "operationId": "Advanced Data Export_2",
        "description": "Queue a job to export arbitrary Item data fields as defined in the provided schema.",
        "parameters": [
          {
            "in": "query",
            "name": "batch",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter Items by Batch UUID"
          },
          {
            "in": "query",
            "name": "created_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Items by created timestamp"
          },
          {
            "in": "query",
            "name": "created_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Items by created timestamp"
          },
          {
            "in": "query",
            "name": "eids",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Filter Items by Product IDs separated by commas",
            "explode": true,
            "style": "form"
          },
          {
            "in": "query",
            "name": "exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' existence (is not null or blank)"
          },
          {
            "in": "query",
            "name": "gtins",
            "schema": {
              "type": "string"
            },
            "description": "Filter Items by Product gtins separated by commas"
          },
          {
            "in": "query",
            "name": "has_nfc_label",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by whether or not Item has associated NFC Label"
          },
          {
            "in": "query",
            "name": "has_qr_label",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by whether or not Item has associated QR Label"
          },
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "is_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' blankness (is blank)"
          },
          {
            "in": "query",
            "name": "is_not_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-blankness (is not blank)"
          },
          {
            "in": "query",
            "name": "is_not_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-nullness (is not null)"
          },
          {
            "in": "query",
            "name": "is_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' nullness (is null)"
          },
          {
            "in": "query",
            "name": "is_product_released",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Items by whether or not Product is released"
          },
          {
            "in": "query",
            "name": "modified_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Items by modified timestamp"
          },
          {
            "in": "query",
            "name": "modified_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter Items by modified timestamp"
          },
          {
            "in": "query",
            "name": "not_exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-existence (is null or blank)"
          },
          {
            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-created",
                  "-id",
                  "-modified",
                  "-serial",
                  "created",
                  "id",
                  "modified",
                  "serial"
                ]
              }
            },
            "description": "Order items by `created`, `modified` and `serial` fields\n\n* `id` - Id\n* `-id` - Id (descending)\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `serial` - Serial\n* `-serial` - Serial (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "override_data",
            "schema": {
              "type": "string"
            },
            "description": "Filter Items by internal override_data key separated by commas"
          },
          {
            "in": "query",
            "name": "product_tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Items by Product tags separated by commas"
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "A search term.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "serial",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Items by Item tags separated by commas"
          }
        ],
        "tags": [
          "Items - Async Actions"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemAdvancedExportRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ItemAdvancedExportRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ItemAdvancedExportRequest"
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncJob"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
