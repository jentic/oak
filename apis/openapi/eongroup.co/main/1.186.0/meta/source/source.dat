      "ProductAdvancedExportRequestRequest": {
        "type": "object",
        "description": "Mixin that allows adding filters used in search to a request. Used in async job requests\nto filter the query made to the database by the results of a search.\n\nFiltering: supports legacy `filters` and the new `input_filter` (FilterDSL). When `input_filter` is provided,\nit is translated to an Elasticsearch filter and preferred over legacy `filters`.",
        "properties": {
          "es_query": {
            "type": "string",
            "minLength": 1,
            "description": "ElasticSearch query string to filter results by. Internal use only, do not set directly."
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AggregationFilterRequest"
            },
            "description": "List of filters to apply to the aggregation. Legacy filter, will be deprecated in favor of input_filter."
          },
          "input_filter": {
            "type": "object",
            "additionalProperties": {},
            "description": "FilterDSL to apply to ElasticSearch (preferred when provided)."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "callback_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            },
            "description": "Callback URLs to send job completion notifications to."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Fields to include in the export. Defaults to an empty list, which will export nothing if other options are not chosen."
          },
          "include_identifiers": {
            "type": "boolean",
            "default": true,
            "description": "Include Product identifiers: eid, gtin, and internal_id."
          },
          "user_id": {
            "type": "integer",
            "description": "User ID to send an email to upon job completion."
          },
          "export_all_flattened_default_schema_fields": {
            "type": "boolean",
            "default": false,
            "description": "Flatten and include all fields in the default schema."
          },
          "default_schema": {
            "type": "object",
            "additionalProperties": {},
            "description": "Can optionally provide an alternate default schema for export."
          },
          "default_schema__schema_id": {
            "type": "integer",
            "description": "Can optionally specify the ID of an existing schema to use for export."
          },
          "default_schema__schema_name": {
            "type": "string",
            "minLength": 1,
            "description": "Can optionally specify the name of an existing schema to use for export."
          },
          "item_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Item tags to filter the export by."
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FormatEnum"
              }
            ],
            "default": "xlsx",
            "description": "Format of the export. Defaults to xlsx.\n\n* `csv` - csv\n* `xlsx` - xlsx"
          },
          "export_all_flattened_core_data_schema_fields": {
            "type": "boolean",
            "default": false,
            "description": "Flatten and include all fields in the core_data field, based on a core_data_schema. Must provide a core_data_schema to use this option."
          },
          "core_data_schema": {
            "type": "object",
            "additionalProperties": {},
            "description": "Can optionally provide an alternate core_data schema for export."
          },
          "core_data_schema__schema_id": {
            "type": "integer",
            "description": "Can optionally specify the ID of an existing schema to use for exporting core_data."
          },
          "core_data_schema__schema_name": {
            "type": "string",
            "minLength": 1,
            "description": "Can optionally specify the name of an existing schema to use for exporting core_data."
          },
          "export_all_flattened_custom_data_schema_fields": {
            "type": "boolean",
            "default": false,
            "description": "Flatten and include all fields in the custom_data field, based on a custom_data_schema. Must provide a custom_data_schema to use this option."
          },
          "custom_data_schema": {
            "type": "object",
            "additionalProperties": {},
            "description": "Can optionally provide an alternate custom_data schema for export."
          },
          "custom_data_schema__schema_id": {
            "type": "integer",
            "description": "Can optionally specify the ID of an existing schema to use for exporting custom_data."
          },
          "custom_data_schema__schema_name": {
            "type": "string",
            "minLength": 1,
            "description": "Can optionally specify the name of an existing schema to use for exporting custom_data."
          }
        }
      },
