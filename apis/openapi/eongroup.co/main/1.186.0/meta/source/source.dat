      "PatchedFacilityRequest": {
        "type": "object",
        "description": "Mixin that adds structured_data and structured_data_schema fields to a serializer.\n\nShould be mixed into a serializer for a model that implements SchemaStructuredDataMixin.",
        "properties": {
          "internal_id": {
            "type": "string",
            "nullable": true,
            "description": "ID that is unique to the Organization.",
            "pattern": "[<>\"#\\'%{}|\\\\^~[+\\/\\]`]",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Facility Name",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "external_identifier": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "metadata": {},
          "country": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SaleCountryEnum"
              },
              {
                "$ref": "#/components/schemas/BlankEnum"
              }
            ]
          },
          "region": {
            "type": "string",
            "maxLength": 255
          },
          "structured_data": {
            "description": "Structured data as per the associated schema."
          },
          "structured_data_schema": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the schema associated with the structured data."
          }
