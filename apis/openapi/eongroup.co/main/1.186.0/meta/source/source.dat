    "/api/v2/interactions/": {
      "get": {
        "operationId": "Interaction List by ",
        "description": "List Interactions.",
        "parameters": [
          {
            "in": "query",
            "name": "created_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter interactions by created timestamp"
          },
          {
            "in": "query",
            "name": "created_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter interactions by created timestamp"
          },
          {
            "in": "query",
            "name": "domain",
            "schema": {
              "type": "string"
            },
            "description": "Filter interactions by domain"
          },
          {
            "in": "query",
            "name": "eids",
            "schema": {
              "type": "string"
            },
            "description": "Filter interactions by product ids separated by commas"
          },
          {
            "in": "query",
            "name": "exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' existence (is not null or blank)"
          },
          {
            "in": "query",
            "name": "include",
            "schema": {
              "type": "string"
            },
            "description": "Include Product identifiers (eid, gtin, internal_id, and Item serial).",
            "examples": {
              "IncludeProductIdentifiers": {
                "value": "product_identifiers",
                "summary": "Include Product Identifiers"
              }
            }
          },
          {
            "in": "query",
            "name": "is_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' blankness (is blank)"
          },
          {
            "in": "query",
            "name": "is_not_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-blankness (is not blank)"
          },
          {
            "in": "query",
            "name": "is_not_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-nullness (is not null)"
          },
          {
            "in": "query",
            "name": "is_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' nullness (is null)"
          },
          {
            "in": "query",
            "name": "item_tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter interactions by item tags separated by commas"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "lookup_label_type",
            "schema": {
              "type": "string"
            },
            "description": "Filter interactions by value in metadata `lookup_label_type` field"
          },
          {
            "in": "query",
            "name": "lookup_reference_id",
            "schema": {
              "type": "string"
            },
            "description": "Filter interactions by value in metadata `lookup_reference_id` field"
          },
          {
            "in": "query",
            "name": "metadata",
            "schema": {
              "type": "string"
            },
            "description": "Filter interactions by internal metadata key separated by commas"
          },
          {
            "in": "query",
            "name": "modified_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter interactions by modified timestamp"
          },
          {
            "in": "query",
            "name": "modified_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter interactions by modified timestamp"
          },
          {
            "in": "query",
            "name": "not_exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-existence (is null or blank)"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "ordering",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "-created",
                  "-domain",
                  "-id",
                  "-modified",
                  "-type",
                  "created",
                  "domain",
                  "id",
                  "modified",
                  "type"
                ]
              }
            },
            "description": "Order interactions by `created`, `modified`, `id`, `type` and `domain` fields\n\n* `created` - Created\n* `-created` - Created (descending)\n* `modified` - Modified\n* `-modified` - Modified (descending)\n* `id` - Id\n* `-id` - Id (descending)\n* `type` - Type\n* `-type` - Type (descending)\n* `domain` - Domain\n* `-domain` - Domain (descending)",
            "explode": false,
            "style": "form"
          },
          {
            "in": "query",
            "name": "skip_count",
            "schema": {
              "type": "string"
            },
            "description": "If provided, the response will not include a count of total objects, and will not execute a COUNT(*) query. This can improve performance on large datasets where the total count is not needed. Next and previous URLs will still be provided.",
            "examples": {
              "SkipCount": {
                "value": true,
                "summary": "Skip Count"
              }
            }
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string"
            },
            "description": "Filter interactions by type"
          }
        ],
        "tags": [
          "Interactions - List"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedInteractionList"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
