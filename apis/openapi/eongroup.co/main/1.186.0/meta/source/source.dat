          {
            "in": "query",
            "name": "name__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by name exists or not"
          },
          {
            "in": "query",
            "name": "name__not",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding exact name"
          },
