    "/api/v2/items/async-bulk-delete/": {
      "post": {
        "operationId": "Async Bulk Delete",
        "description": "Delete Items in bulk based on standard filtering parameters.\nNote that this does not actually delete the Items from the database,\nbut rather marks them as deleted, so that they will not be available via API or other means.\n\nThe request requires the issuer to input the expected number of Items to be deleted,\nand will return an error if the actual number of Items that match the filter parameters does not match this number,\nas a safeguard against unintended mass deletions. This validation is done within the job, however, because the\nqueryset is evaluated at the time the job runs, not at the time the request is made, so that any changes to the data in the interim are accounted for.",
        "tags": [
          "Items"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemAsyncBulkDeleteRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ItemAsyncBulkDeleteRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ItemAsyncBulkDeleteRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemAsyncBulkDelete"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
