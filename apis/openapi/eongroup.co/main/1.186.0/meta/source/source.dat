  "paths": {
    "/api/v2/assets/": {
      "get": {
        "operationId": "Asset List",
        "description": "List assets.",
        "parameters": [
          {
            "in": "query",
            "name": "access",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by access level"
          },
          {
            "in": "query",
            "name": "content_length",
            "schema": {
              "type": "integer"
            },
            "description": "Filter Asset by content length"
          },
          {
            "in": "query",
            "name": "content_length__gt",
            "schema": {
              "type": "integer"
            },
            "description": "Filter Asset by content length greater than"
          },
          {
            "in": "query",
            "name": "content_length__gte",
            "schema": {
              "type": "integer"
            },
            "description": "Filter Asset by content length greater than or equal"
          },
          {
            "in": "query",
            "name": "content_length__in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by multiple content lengths (comma-separated)"
          },
          {
            "in": "query",
            "name": "content_length__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by content length exists or not"
          },
          {
            "in": "query",
            "name": "content_length__lt",
            "schema": {
              "type": "integer"
            },
            "description": "Filter Asset by content length less than"
          },
          {
            "in": "query",
            "name": "content_length__lte",
            "schema": {
              "type": "integer"
            },
            "description": "Filter Asset by content length less than or equal"
          },
          {
            "in": "query",
            "name": "content_length__not",
            "schema": {
              "type": "integer"
            },
            "description": "Filter Asset by excluding specific content length"
          },
          {
            "in": "query",
            "name": "content_length__not_in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding multiple content lengths (comma-separated)"
          },
          {
            "in": "query",
            "name": "content_type",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by content type(s), supports partial matches (e.g. \"image\" for all images, \"pdf,jpeg\" for PDFs and JPEGs)"
          },
          {
            "in": "query",
            "name": "content_type__in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by multiple content types (comma-separated)"
          },
          {
            "in": "query",
            "name": "content_type__isempty",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by content type being empty (NULL or empty string)"
          },
          {
            "in": "query",
            "name": "content_type__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by content type exists or not"
          },
          {
            "in": "query",
            "name": "content_type__not",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding specific content type"
          },
          {
            "in": "query",
            "name": "content_type__not_in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding multiple content types (comma-separated)"
          },
          {
            "in": "query",
            "name": "created__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by created timestamp exists or not"
          },
          {
            "in": "query",
            "name": "created_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter assets by creation timestamp"
          },
          {
            "in": "query",
            "name": "created_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter assets by creation timestamp"
          },
          {
            "in": "query",
            "name": "exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' existence (is not null or blank)"
          },
          {
            "in": "query",
            "name": "folder_id",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by folder id"
          },
          {
            "in": "query",
            "name": "folder_id__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by folder ID exists or not"
          },
          {
            "in": "query",
            "name": "include",
            "schema": {
              "type": "string"
            },
            "description": "Include asset versions.",
            "examples": {
              "IncludeVersions_": {
                "value": "versions",
                "summary": "Include Versions "
              }
            }
          },
          {
            "in": "query",
            "name": "internal_id",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by internal ID"
          },
          {
            "in": "query",
            "name": "internal_id__in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by multiple internal IDs (comma-separated)"
          },
          {
            "in": "query",
            "name": "internal_id__isempty",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by internal ID being empty (NULL or empty string)"
          },
          {
            "in": "query",
            "name": "internal_id__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by internal ID exists or not"
          },
          {
            "in": "query",
            "name": "internal_id__not",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding specific internal ID"
          },
          {
            "in": "query",
            "name": "internal_id__not_in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding multiple internal IDs (comma-separated)"
          },
          {
            "in": "query",
            "name": "is_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' blankness (is blank)"
          },
          {
            "in": "query",
            "name": "is_not_empty",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-blankness (is not blank)"
          },
          {
            "in": "query",
            "name": "is_not_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-nullness (is not null)"
          },
          {
            "in": "query",
            "name": "is_null",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' nullness (is null)"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "modified__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by modified timestamp exists or not"
          },
          {
            "in": "query",
            "name": "modified_after",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter assets by modified timestamp"
          },
          {
            "in": "query",
            "name": "modified_before",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter assets by modified timestamp"
          },
          {
            "in": "query",
            "name": "name",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by exact name"
          },
          {
            "in": "query",
            "name": "name__in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by multiple names (comma-separated)"
          },
          {
            "in": "query",
            "name": "name__isempty",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by name being empty (NULL or empty string)"
          },
          {
            "in": "query",
            "name": "name__isnull",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter Asset by name exists or not"
          },
          {
            "in": "query",
            "name": "name__not",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding exact name"
          },
          {
            "in": "query",
            "name": "name__not_in",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding multiple names (comma-separated)"
          },
          {
            "in": "query",
            "name": "not_exists",
            "schema": {
              "type": "string"
            },
            "description": "Filter by fields' non-existence (is null or blank)"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ordering",
            "required": false,
            "in": "query",
            "description": "Which field to use when ordering the results.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "prefix",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by prefix"
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by partial query on name, tags, metadata-key and metadata-value, case insensitive"
          },
          {
            "in": "query",
            "name": "skip_count",
            "schema": {
              "type": "string"
            },
            "description": "If provided, the response will not include a count of total objects, and will not execute a COUNT(*) query. This can improve performance on large datasets where the total count is not needed. Next and previous URLs will still be provided.",
            "examples": {
              "SkipCount": {
                "value": true,
                "summary": "Skip Count"
              }
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by tags separated by commas (all tags must be present)"
          },
          {
            "in": "query",
            "name": "tags__not",
            "schema": {
              "type": "string"
            },
            "description": "Filter Asset by excluding assets that have any of the specified tags (comma-separated)"
          }
        ],
        "tags": [
          "Assets - List"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAssetList"
                }
              }
            },
            "description": "Successful Operation"
          }
        }
      },
      "post": {
        "operationId": "Asset Create",
        "description": "Add a new asset to the assets storage.",
        "tags": [
          "Assets - Create"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "201": {
            "headers": {
              "X-Content-Url": {
                "schema": {
                  "type": "string"
                },
                "description": "The location of the asset content with write permissions in the url, this url is temporary and should not be publicly exposed.",
                "required": true
              },
              "X-Content-Url-Expires": {
                "schema": {
                  "type": "string"
                },
                "description": "The expiration timestamp of the asset content location url.",
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            },
            "description": "Successful Operation"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidFileName": {
                    "value": {
                      "name": [
                        "Invalid characters in name starts with a period (.)"
                      ]
                    },
                    "summary": "invalid file name"
                  },
                  "InvalidAccessType": {
                    "value": {
                      "access": [
                        " ' ' is not a valid choice"
                      ]
                    },
                    "summary": "Invalid access type"
                  },
                  "FileAlreadyExists": {
                    "value": {
                      "name": [
                        " 'text/EON_AZURE_API.postman_collection ' already exists"
                      ]
                    },
                    "summary": "file already exists"
                  },
                  "RequiredFieldNotGiven": {
                    "value": {
                      "name": [
                        "this field is required"
                      ]
                    },
                    "summary": "required field not given"
                  },
                  "BlankName": {
                    "value": {
                      "name": [
                        "this field may not be blank"
                      ]
                    },
                    "summary": "blank name"
                  }
                }
              }
            },
            "description": "Bad Request"
          }
        }
      }
    },
