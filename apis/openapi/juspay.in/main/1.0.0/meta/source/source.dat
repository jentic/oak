                "payment_method": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "payment_method_issuer": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
