{
  "openapi": "3.0.3",
  "info": {
    "title": "Juspay Payment Gateway API",
    "description": "Juspay is an Indian payment orchestration platform providing APIs for session-based payment flows, order management, refunds, and payment method tokenization. Supports HyperCheckout and Express Checkout integration modes.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://juspay.io/in/docs/"
  },
  "servers": [
    {
      "url": "https://api.juspay.in",
      "description": "Production server"
    },
    {
      "url": "https://sandbox.juspay.in",
      "description": "Sandbox server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/session": {
      "post": {
        "operationId": "createSession",
        "summary": "Create Payment Session",
        "description": "Creates a new payment session for initiating a payment flow. The session contains order details, customer information, and payment configuration. Returns a session ID and payment links used by the client SDK.",
        "tags": ["Session"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create Order",
        "description": "Creates a new order with the specified amount, currency, and customer details. The order ID is used to track the payment lifecycle.",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "operationId": "getOrderStatus",
        "summary": "Get Order Status",
        "description": "Retrieves the current status and details of an existing order, including payment status, transaction details, and refund information.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "Unique order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid order ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/txns": {
      "post": {
        "operationId": "initiateTransaction",
        "summary": "Initiate Transaction",
        "description": "Initiates a payment transaction for an existing order using the specified payment method. Supports cards, UPI, net banking, and wallets.",
        "tags": ["Transactions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/InitiateTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/refunds": {
      "post": {
        "operationId": "createRefund",
        "summary": "Create Refund",
        "description": "Initiates a full or partial refund for a completed payment order. The refund is processed asynchronously and the status can be tracked via the order status API.",
        "tags": ["Refunds"],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "Order ID for which refund is to be initiated",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RefundRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or refund not possible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}/payment_methods": {
      "get": {
        "operationId": "listPaymentMethods",
        "summary": "List Saved Payment Methods",
        "description": "Retrieves all saved payment methods (cards, UPI VPAs, wallets) for a customer. Used to display saved instruments during checkout.",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "description": "Unique customer identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment methods retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethodsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid customer ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}/payment_methods/{payment_method_id}": {
      "delete": {
        "operationId": "deletePaymentMethod",
        "summary": "Delete Saved Payment Method",
        "description": "Removes a saved payment method from a customer's account.",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "description": "Unique customer identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payment_method_id",
            "in": "path",
            "required": true,
            "description": "Payment method identifier to delete",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment method deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "DELETED"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payment_methods": {
      "get": {
        "operationId": "getPaymentMethodsForMerchant",
        "summary": "Get Available Payment Methods",
        "description": "Retrieves all payment methods available for the merchant, including cards, UPI, net banking, and wallets with their current status.",
        "tags": ["Payment Methods"],
        "parameters": [
          {
            "name": "merchant_id",
            "in": "query",
            "required": true,
            "description": "Merchant identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment methods retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MerchantPaymentMethodsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Base64 encoded API key. Use your Juspay API key as the username and leave password empty."
      }
    },
    "schemas": {
      "CreateSessionRequest": {
        "type": "object",
        "required": ["order_id", "amount", "customer_id", "payment_page_client_id"],
        "properties": {
          "order_id": {
            "type": "string",
            "description": "Unique order identifier"
          },
          "amount": {
            "type": "string",
            "description": "Payment amount"
          },
          "customer_id": {
            "type": "string",
            "description": "Unique customer identifier"
          },
          "customer_email": {
            "type": "string",
            "description": "Customer email address"
          },
          "customer_phone": {
            "type": "string",
            "description": "Customer phone number"
          },
          "payment_page_client_id": {
            "type": "string",
            "description": "Client ID for the payment page"
          },
          "action": {
            "type": "string",
            "description": "Payment action type",
            "enum": ["paymentPage", "paymentManagement"]
          },
          "return_url": {
            "type": "string",
            "description": "URL to redirect after payment completion"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "default": "INR"
          },
          "description": {
            "type": "string",
            "description": "Description of the payment"
          },
          "first_name": {
            "type": "string",
            "description": "Customer first name"
          },
          "last_name": {
            "type": "string",
            "description": "Customer last name"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Session creation status",
            "example": "NEW"
          },
          "id": {
            "type": "string",
            "description": "Unique session identifier"
          },
          "order_id": {
            "type": "string",
            "description": "Associated order ID"
          },
          "payment_links": {
            "type": "object",
            "properties": {
              "web": {
                "type": "string",
                "description": "Web payment page URL"
              },
              "mobile": {
                "type": "string",
                "description": "Mobile payment page URL"
              },
              "iframe": {
                "type": "string",
                "description": "Embeddable iframe URL"
              }
            }
          },
          "sdk_payload": {
            "type": "object",
            "description": "Payload for client SDK initialization",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "service": {
                "type": "string"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "clientId": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "string"
                  },
                  "merchantId": {
                    "type": "string"
                  },
                  "clientAuthToken": {
                    "type": "string"
                  },
                  "clientAuthTokenExpiry": {
                    "type": "string"
                  },
                  "environment": {
                    "type": "string"
                  },
                  "orderId": {
                    "type": "string"
                  },
                  "customerEmail": {
                    "type": "string"
                  },
                  "customerPhone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["order_id", "amount"],
        "properties": {
          "order_id": {
            "type": "string",
            "description": "Unique order identifier (merchant-generated)"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Payment amount"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "default": "INR"
          },
          "customer_id": {
            "type": "string",
            "description": "Customer identifier"
          },
          "customer_email": {
            "type": "string",
            "description": "Customer email"
          },
          "customer_phone": {
            "type": "string",
            "description": "Customer phone number"
          },
          "description": {
            "type": "string",
            "description": "Order description"
          },
          "return_url": {
            "type": "string",
            "description": "URL to redirect after payment"
          },
          "product_id": {
            "type": "string",
            "description": "Product identifier"
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Order status",
            "enum": ["NEW", "CHARGED", "PENDING_VBV", "AUTHORIZATION_FAILED", "AUTHENTICATION_FAILED"]
          },
          "status_id": {
            "type": "integer",
            "description": "Numeric status code"
          },
          "order_id": {
            "type": "string",
            "description": "Order identifier"
          },
          "id": {
            "type": "string",
            "description": "Juspay internal order ID"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "customer_email": {
            "type": "string"
          },
          "customer_phone": {
            "type": "string"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "merchant_id": {
            "type": "string"
          },
          "return_url": {
            "type": "string"
          }
        }
      },
      "OrderStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Current order status",
            "enum": ["NEW", "CHARGED", "PENDING_VBV", "AUTHORIZATION_FAILED", "AUTHENTICATION_FAILED", "JUSPAY_DECLINED", "AUTHORIZING", "COD_INITIATED", "VOIDED", "AUTO_REFUNDED"]
          },
          "status_id": {
            "type": "integer"
          },
          "order_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "customer_email": {
            "type": "string"
          },
          "customer_phone": {
            "type": "string"
          },
          "merchant_id": {
            "type": "string"
          },
          "date_created": {
            "type": "string",
            "format": "date-time"
          },
          "txn_id": {
            "type": "string",
            "description": "Transaction identifier"
          },
          "txn_uuid": {
            "type": "string",
            "description": "Transaction UUID"
          },
          "gateway_id": {
            "type": "integer",
            "description": "Payment gateway identifier"
          },
          "gateway_reference_id": {
            "type": "string",
            "description": "Gateway transaction reference"
          },
          "bank_error_code": {
            "type": "string"
          },
          "bank_error_message": {
            "type": "string"
          },
          "payment_method_type": {
            "type": "string",
            "description": "Type of payment method used"
          },
          "payment_method": {
            "type": "string",
            "description": "Specific payment method"
          },
          "refunded": {
            "type": "boolean",
            "description": "Whether the payment has been refunded"
          },
          "amount_refunded": {
            "type": "number",
            "format": "double"
          },
          "refunds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RefundDetail"
            }
          }
        }
      },
      "InitiateTransactionRequest": {
        "type": "object",
        "required": ["order_id", "merchant_id", "payment_method_type", "payment_method"],
        "properties": {
          "order_id": {
            "type": "string",
            "description": "Order ID to pay for"
          },
          "merchant_id": {
            "type": "string",
            "description": "Merchant identifier"
          },
          "payment_method_type": {
            "type": "string",
            "description": "Type of payment method",
            "enum": ["CARD", "NB", "WALLET", "UPI", "EMI"]
          },
          "payment_method": {
            "type": "string",
            "description": "Specific payment instrument (e.g., VISA, MASTERCARD, HDFC_NB, PAYTM)"
          },
          "card_number": {
            "type": "string",
            "description": "Card number (for card payments)"
          },
          "card_exp_month": {
            "type": "string",
            "description": "Card expiry month"
          },
          "card_exp_year": {
            "type": "string",
            "description": "Card expiry year"
          },
          "card_security_code": {
            "type": "string",
            "description": "Card CVV/CVC"
          },
          "name_on_card": {
            "type": "string",
            "description": "Cardholder name"
          },
          "save_to_locker": {
            "type": "boolean",
            "description": "Whether to save the card for future use"
          },
          "redirect_after_payment": {
            "type": "boolean",
            "description": "Whether to redirect after payment"
          },
          "format": {
            "type": "string",
            "description": "Response format",
            "enum": ["json"]
          },
          "upi_vpa": {
            "type": "string",
            "description": "UPI Virtual Payment Address (for UPI payments)"
          },
          "card_token": {
            "type": "string",
            "description": "Saved card token (for token-based payments)"
          }
        }
      },
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "txn_id": {
            "type": "string",
            "description": "Transaction identifier"
          },
          "txn_uuid": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["CHARGED", "PENDING_VBV", "AUTHORIZATION_FAILED", "AUTHENTICATION_FAILED"]
          },
          "order_id": {
            "type": "string"
          },
          "gateway_id": {
            "type": "integer"
          },
          "payment": {
            "type": "object",
            "properties": {
              "authentication": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "description": "3DS redirect URL for VBV authentication"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "RefundRequest": {
        "type": "object",
        "required": ["unique_request_id", "amount"],
        "properties": {
          "unique_request_id": {
            "type": "string",
            "description": "Idempotency key for the refund request"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Amount to refund"
          }
        }
      },
      "RefundResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Refund status",
            "enum": ["SUCCESS", "PENDING", "FAILURE"]
          },
          "id": {
            "type": "string",
            "description": "Refund identifier"
          },
          "order_id": {
            "type": "string"
          },
          "unique_request_id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "ref": {
            "type": "object",
            "properties": {
              "txn_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "RefundDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "unique_request_id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentMethodsResponse": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "card_token": {
                  "type": "string"
                },
                "card_reference": {
                  "type": "string"
                },
                "card_fingerprint": {
                  "type": "string"
                },
                "card_type": {
                  "type": "string",
                  "enum": ["CREDIT", "DEBIT"]
                },
                "card_issuer": {
                  "type": "string"
                },
                "card_brand": {
                  "type": "string",
                  "enum": ["VISA", "MASTERCARD", "AMEX", "RUPAY", "MAESTRO", "DINERS"]
                },
                "card_number_mask": {
                  "type": "string",
                  "description": "Masked card number"
                },
                "name_on_card": {
                  "type": "string"
                },
                "expired": {
                  "type": "boolean"
                },
                "card_exp_month": {
                  "type": "string"
                },
                "card_exp_year": {
                  "type": "string"
                }
              }
            }
          },
          "wallets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "wallet_name": {
                  "type": "string"
                },
                "wallet_id": {
                  "type": "string"
                },
                "linked": {
                  "type": "boolean"
                },
                "token": {
                  "type": "string"
                }
              }
            }
          },
          "upi_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "vpa": {
                  "type": "string",
                  "description": "UPI Virtual Payment Address"
                }
              }
            }
          }
        }
      },
      "MerchantPaymentMethodsResponse": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string"
          },
          "payment_methods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "payment_method_type": {
                  "type": "string",
                  "enum": ["CARD", "NB", "WALLET", "UPI", "EMI"]
