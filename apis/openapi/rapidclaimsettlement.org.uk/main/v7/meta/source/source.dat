          },
          {
            "name": "a2aNotification",
            "in": "query",
            "description": "Flag to delete the A2A notifications. Must be set to \u201ctrue\u201d to delete the A2A notifications. Don't pass the parameter or set it to \u201cfalse\u201d to delete web browser notifications. Note that only the A2A user can delete A2A notifications.",
            "schema": {
