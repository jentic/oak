              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claimId}/attachments": {
      "post": {
        "tags": [
          "attachments"
        ],
        "summary": "addAttachment",
        "description": "This request provides the functionality to add an attachment to a particular `claim`:\n* in case of file, the attachment has to be passed as a stream of bytes\n* in case of note, the note has to be passed as a text. \n\nThe attachment is identified in the system with an attachment ID, a title and a description. \n\n<b>Max size:</b> 4MB for each attachment for a maximum of 20MB in total for all the attachments.\n<b>FROM RELEASE 6 ON:</b>\n* Max Number of attachments allowed for CR: 40 attachments\n* Max Number of attachments allowed for COMP: 10 attachments\n\nThis means that the CR can attach up to 40 attachments to each claim and\nthe COMP can attach up to 10 attachments to each claim irrespective of the\nnumber of attachments added by the counterpart (subject to the 4 MB individual and 20\nMB total size limits).\n\n<b>Releases</b>: All\n",
        "operationId": "addAttachment",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "claimId",
            "in": "path",
            "description": "Unique identifier of the claim on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/addAttachmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/addAttachmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
