    "/claims/search": {
      "post": {
        "tags": [
          "claims"
        ],
        "summary": "searchClaims",
        "description": "This request provides the functionality to search for a `claim` specifying a set of search criteria.\n\nDates description: <br/>\n<b>\u00b7 Start Date:</b> The date that the first CNF is created on the system (the CR user creates the CNF and saves it as a draft without sending it to the compensator).<br/>\n<b>\u00b7 Sent Date:</b> The date that the first CNF is actually sent to the compensator.<br/>\n<b>\u00b7 Dispatch Date:</b> The date when the claim changes in status; this occurs every time the claim passes from one party to another.\n\n<b>Releases</b>: All\n",
        "operationId": "searchClaims",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/searchClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/searchClaimResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claimId}/claim-status": {
      "post": {
        "tags": [
          "claims"
        ],
        "summary": "getClaimsStatus",
        "description": "This request provides the functionality to retrieve the status of a particular `claim`. \n\n<b>Use case:</b> It can be used in order to know the position in the process of a particular claim and to update the claim using the correct _activityEngineGuid_.\n\n<b>Releases</b>: All\n",
        "operationId": "getClaimsStatus",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "claimId",
            "in": "path",
            "description": "Unique identifier of the claim on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/claimStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claimId}": {
      "get": {
        "tags": [
          "claims"
        ],
        "summary": "getClaim",
        "description": "This request provides the functionality to get all the information stored within a particular `claim` up to the phase in which the claim has arrived.<br>The information returned includes process and business information.\n\n<b>Releases</b>: All\n",
        "operationId": "getClaim",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "claimId",
            "in": "path",
            "description": "Unique identifier of the claim on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/getClaim_claimData"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
