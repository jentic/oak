      "ctAccidentDetails": {
        "type": "object",
        "properties": {
          "driver": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctPersonalDetailsGetclaim"
              }
            ],
            "description": "Under AccidentData/AccidentDetails/ returned ONLY IF driverIsDefendant = NO"
          },
          "owner": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctPersonalDetailsGetclaim"
              }
            ],
            "description": "Under AccidentData/AccidentDetails/ returned ONLY IF driverIsDefendant = NO"
          },
          "vehicle": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctVehicle"
              }
            ],
            "description": "Under AccidentData/AccidentDetails/ returned ONLY IF driverIsDefendant = NO"
          },
          "insuranceCompanyInformation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctCompanyDetails"
              }
            ],
            "description": "Under AccidentData/AccidentDetails/ returned ONLY IF driverIsDefendant = NO"
          },
          "weatherConditions": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctWeatherConditions"
              }
            ],
            "description": "At least one of the conditions must be set to YES (1)"
          },
          "roadConditions": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctRoadConditions"
              }
            ],
            "description": "At least one of the conditions must be set to YES (1)"
          },
          "accidentCircumstances": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctAccidentCircumstances"
              }
            ],
            "description": "At least one of the conditions must be set to YES (1)"
          },
          "policeDetails": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctPoliceDetails"
              }
            ],
            "description": "Returned ONLY IF policeReported = YES"
          },
          "occupantsNumber": {
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "integer"
          },
          "claimantType": {
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5,
              6
            ],
            "type": "number",
            "description": "* 0 - The driver\n* 1 - The owner of the vehicle but not  driving  \n* 2 - A passenger in a vehicle owned by  someone else\n* 3 - A pedestrian\n* 4 - A cyclist\n* 5 - A motorcyclist\n* 6 - Other\n"
          },
          "otherType": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "IF ClaimantType ='Other', OtherType  must be provided"
          },
          "seatbelt": {
            "type": "number",
            "description": "* 1 - YES\n* 0 - NO\n* 2 = Seatbelt not supplied  \nIF ClaimantType =0,1,2, Seatbelt must be  provided\n"
          },
          "accidentDate": {
            "type": "string",
            "description": "YYYY-MM-DD",
            "format": "date-time"
          },
          "accidentTime": {
            "type": "string",
            "description": "HH-MM"
          },
          "accidentLocation": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "accidentDescription": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "driverIsDefendant": {
            "type": "boolean",
            "description": "IF ClaimantType =2, DriverIsDefendant  must be provided"
          },
          "policeReported": {
            "enum": [
              1,
              0,
              2
            ],
            "type": "number",
            "description": "* 1 - YES\n* 0 - NO\n* 2 - Not known\n"
          }
        }
      },
      "ctBusCoach": {
        "type": "object",
        "properties": {
          "bussOrCoach": {
            "type": "boolean",
            "description": "\u201cDid the accident involve a bus or a coach?\u201d"
          },
          "driverName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "driverId": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "driverDescription": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "vehicleDescription": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "numberOfPassengers": {
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "integer"
          },
          "evidence": {
            "type": "boolean",
            "description": "IF BusOrCoach = YES.\n\u201cIs evidence of travel available?\u201d\n"
          },
          "comments": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "IF BusOrCoach = YES.\nIf Evidence NO in this field will be reported the reason why the evidence is not available.\n"
          }
        }
      },
      "accidentData": {
        "type": "object",
        "properties": {
          "accidentDetails": {
            "$ref": "#/components/schemas/ctAccidentDetails"
          },
          "busCoach": {
            "$ref": "#/components/schemas/ctBusCoach"
          }
        }
      },
      "ctOtherParty": {
        "type": "object",
        "properties": {
          "personalDetails": {
            "$ref": "#/components/schemas/ctPersonalDetailsGetclaim"
          },
          "vehicleInformation": {
            "$ref": "#/components/schemas/ctVehicle"
          },
          "insuranceCompanyInformation": {
            "$ref": "#/components/schemas/ctCompanyDetails"
          },
          "opType": {
            "enum": [
              "W",
              "O"
            ],
            "type": "string",
            "description": "* W - Witness\n* O - Other\n"
          },
          "opOther": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "IF OPType = Other, OPOther must be provided"
          }
        }
      },
      "otherPartyDetails": {
        "type": "object",
        "properties": {
          "otherParty": {
            "maxItems": 6,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ctOtherParty"
            },
            "description": "There can be from 0 to 6 Other parties (from 0 to 6 nodes \u201cOtherParty\u201d)."
          }
        }
      },
      "ctLiability": {
        "type": "object",
        "properties": {
          "defendantResponsibility": {
            "type": "string"
          },
          "op1Responsibility": {
            "type": "boolean",
            "description": "Value returned only if Other Party 1 is present."
          },
          "op2Responsibility": {
            "type": "boolean",
            "description": "Value returned only if Other Party 2 is present."
          },
          "op3Responsibility": {
            "type": "boolean",
            "description": "Value returned only if Other Party 3 is present."
          },
          "op4Responsibility": {
            "type": "boolean",
            "description": "Value returned only if Other Party 4 is present."
          },
          "op5Responsibility": {
            "type": "boolean",
            "description": "Value returned only if Other Party 5 is present."
          },
          "op6Responsibility": {
            "type": "boolean",
            "description": "Value returned only if Other Party 6 is present."
          }
        }
      },
      "liabilityFunding.funding": {
        "type": "object",
        "properties": {
          "fundingUndertaken": {
            "type": "boolean",
            "description": "FROM RELEASE 6: Not present.<br/>\n(\u201cHas the claimant undertaken a funding arrangement within the meaning of CPR rule 43.2(1)(k)?\u201d).<br/>\nIf fundingUndertaken = true then at least one of Section58, Section29, MembershipOrganisation, Other must = true \n"
          },
          "section58": {
            "type": "boolean",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true then it must be provided.<br/> \n(\u201cThe claimant has entered into a conditional fee agreement in relation to this claim, which provides for a success fee within the meaning of section 58(2) of the Courts and Legal Services Act 1990\u201d)\n"
          },
          "conditionalFeeDate": {
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section58 = true, conditionalFeeDate must be provided<br/>\n(\u201cDate conditional fee arrangement was entered into.\u201d)\n",
            "format": "date-time"
          },
          "section29": {
            "type": "boolean",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true then it must be provided.<br/> \n(\u201cThe claimant has taken out an insurance policy to which section 29 of the Access Justice Act 1999 applies\u201d)\n"
          },
          "icName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section29 = true, icName must be provided<br/>\n(\u201cInsurance Company Name\u201d)\n"
          },
          "icAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section29 = true, icAddress must be provided<br/>\n(\u201cInsurance Company Name\u201d)\n"
          },
          "policyNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section29 = true, policyNumber must be provided\n"
          },
          "policyDate": {
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section29 = true, policyDate must be provided\n",
            "format": "date-time"
          },
          "levelOfCover": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section29 = true, levelOfCover must be provided\n"
          },
          "premiumStaged": {
            "type": "boolean",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section29 = true, premiumStaged must be provided<br/>\n(\u201cAre the insurance premiums stages?\u201d)\n"
          },
          "increasingPoint": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and section29 = true, increasingPoint must be provided<br/>\n(\u201cAt which point is an increased premium payable?\u201d)\n"
          },
          "membershipOrganisation": {
            "type": "boolean",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true, membershipOrganisation must be provided<br/>\n(\u201cThe claimant has an agreement with a membership organisation to meet their legal costs?\u201d)\n"
          },
          "organisationName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and membershipOrganisation = true, organisationName must be provided\n"
          },
          "agreementDate": {
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and membershipOrganisation = true, agreementDate must be provided<br/>\nFROM RELEASE 3 ON: Validation (AgreementDate >= AccidentDate) is removed\n",
            "format": "date-time"
          },
          "other": {
            "type": "boolean",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true other must be provided\n"
          },
          "otherDetails": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and other = true, otherDetails must be provided\n"
          },
          "consideredFreeLegalExpIns": {
            "type": "boolean",
            "description": "FROM RELEASE 6: Not present.<br/>\nIf fundingUndertaken = true and ONLY IF it is a MIB CLAIM, consideredFreeLegalExpIns must be provided. Otherwise it must be skipped.\n"
          },
          "comments": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "description": "Section M \u201cOther relevant Information\u201d"
          }
        }
      },
      "liabilityFunding": {
        "type": "object",
        "properties": {
          "liability": {
            "$ref": "#/components/schemas/ctLiability"
          },
          "funding": {
