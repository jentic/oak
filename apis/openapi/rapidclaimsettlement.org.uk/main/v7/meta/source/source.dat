      "ctAddress": {
        "type": "object",
        "properties": {
          "country": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string",
            "description": "Usually filled in with United Kingdom"
          },
          "postCode": {
            "maxLength": 8,
            "minLength": 0,
            "type": "string",
            "description": "* The Post Code is a 6 to 8 characters field including  spaces.\n* The Post Code must be in two parts separated by a space.\n* The first part must be in one of these formats:AN, AAN, AANA, AANN, ANA, ANN\n* The second part must be in the format NAA\n"
          },
          "district": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string"
          },
          "county": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "city": {
            "maxLength": 25,
            "minLength": 1,
            "type": "string"
          },
          "street1": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "street2": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "houseName": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "houseNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "addressType": {
            "$ref": "#/components/schemas/c01AddressType"
          }
        }
      },
      "ctCompanyDetails": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/ctAddress"
          },
          "companyName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Name of the Claimant Representative company.\nFROM RELEASE 6 ON\n  The claim will be recorded with the Company Name  present on the Administration site. Please note that if the Company Name is not  present on the system adding a claim the system will return an error and it will be not possible to add the  claim. Please contact your administrator to  ensure that the Company Name is correctly filled  in on the Administration site.\n"
          },
          "branchName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "FROM RELEASE 6 ON  \nField available from Release 6 on. For this field is  allowed two types of input: \n * Prefilled by the system: in order to use the login-as User's branch name present on the Administration site this field must be filled in with the value [PREFILLED]. Please  note that if the Branch Name is not  present on the system adding a claim the system will return an error and it will be not  possible to add the claims. Please contact your administrator to ensure that the  Branch Name is correctly filled in on the  Administration site.  \n * Value different from the value on the  system: value different from  [PREFILLED]. If the value is different  from [PREFILLED] the length of the value must be of at least 1 char.\n"
          },
          "emailAddress": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "contactName": {
            "maxLength": 25,
            "minLength": 1,
            "type": "string",
            "description": "Name of the user that created this claim"
          },
          "contactMiddleName": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string",
            "description": "Middle Name of the user that created this claim"
          },
          "contactSurname": {
            "maxLength": 25,
            "minLength": 1,
            "type": "string"
          },
          "telephoneNumber": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "referenceNumber": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "[^|\u00a6#$,\u00a3~\\^`\\[\\]\\{\\}_\u20ac\u00ac][A-Za-z0-9 \\/.-]{0,48}[A-Za-z0-9]{0,1}",
            "type": "string",
            "description": "Defendant Insurer Reference Number must not be all blanks or all zeros or combination of blanks and zeros\nNot allowed chars:\n* | (Pipe character)\n* \u00a6 (half pipe)\n* \\# (hash)\n* $\n* ,\n* \u00a3\n* ~\n* ^\n* `\n* [\n* ]\n* {\n* }\n* _\n* \u20ac\n* \u00ac\n"
          },
          "policyNumber": {
            "maxLength": 16,
            "minLength": 0,
            "type": "string"
          },
          "providerAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ctClaimantRepresentative": {
        "type": "object",
        "properties": {
          "companyDetails": {
            "$ref": "#/components/schemas/ctCompanyDetails"
          },
          "litigantInPerson": {
            "type": "boolean",
            "description": "IGNORE IT"
          },
          "paymentMoreRequested": {
            "type": "boolean",
            "description": "Is a payment of more than \u00a31000 being requested? \nFROM RELEASE 2 ON - This field is automatically set by the system after the user sends the Interim Settlement pack, depending on the value of \u201cValue of interim request (\u00a3)\u201d\n"
          }
        }
      },
      "ctPersonalDetailsGetclaim": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/ctAddress"
          },
          "name": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string",
            "description": "Name of the Defendant"
          },
          "middleName": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string",
            "description": "Middle Name of the Defendant"
          },
          "surname": {
            "maxLength": 25,
            "minLength": 1,
            "type": "string",
            "description": "Surname of the Defendant  C- Mandatory if DefendantStatus=Personal"
          },
          "sex": {
            "$ref": "#/components/schemas/c08Sex"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Not returned under AccidentData/AccidentDetails/Driver. OtherPartyDetails/OtherParty/PersonalDetails",
            "format": "date-time"
          },
          "titleType": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5"
            ],
            "type": "string",
            "description": "* 1 - Mr\n* 2 - Mrs.\n* 3 - Ms\n* 4 - Miss\n* 5 - other\n"
          },
          "otherTitle": {
            "maxLength": 9,
            "minLength": 0,
            "pattern": "[A-Za-z0-9 \\.]{0,8}([A-Za-z1-9\\.]{1})|([A-Za-z1-9\\.]{0,1})",
            "type": "string",
            "description": "Other must not be all blanks or all zeros or combination of blanks and  zeros. C-If Defendant Title is 'Other', OtherTitle  must be provided"
          },
          "age": {
            "maximum": 150,
            "exclusiveMaximum": false,
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "integer",
            "description": "Not returned in case of Defendant. Not returned in case of Claimant. Not returned under AccidentData/AccidentDetails/Driver. OtherPartyDetails/OtherParty/PersonalDetails."
          },
          "occupation": {
            "type": "string",
            "description": "Not returned in case of Defendant. Not returned in case of Claimant. Not returned under AccidentData/AccidentDetails/Driver. OtherPartyDetails/OtherParty/PersonalDetails"
          }
        }
      },
      "ctVehicle": {
        "type": "object",
        "properties": {
          "vrn": {
            "maxLength": 12,
            "minLength": 0,
            "type": "string",
            "description": "VRN of the Defendant"
          },
          "make": {
            "maxLength": 14,
            "minLength": 0,
            "type": "string",
            "description": "Not returned in case of Claimant's vehicle."
          },
          "model": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string",
            "description": "Not returned in case of Claimant's vehicle."
          },
          "engineSize": {
            "maxLength": 6,
            "minLength": 6,
            "type": "integer",
            "description": "Not returned in case of Defendant's vehicle. Not returned in case of Claimant's vehicle. Not returned under AccidentData/AccidentDetails/Vehicle. Not returned under OtherPartyDetails/OtherParty/VehicleInformation."
          },
          "color": {
            "maxLength": 16,
            "minLength": 0,
            "type": "string",
            "description": "Not returned in case of Claimant's vehicle. Not returned under AccidentData/AccidentDetails/Vehicle."
          }
        }
      },
      "ctBranchDetails": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string"
