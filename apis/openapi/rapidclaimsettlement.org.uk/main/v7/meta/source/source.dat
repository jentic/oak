      "stage2AdditionalDamagesPack.claimantRepresentative.companyDetails.address": {
        "type": "object",
        "properties": {
          "addressType": {
            "$ref": "#/components/schemas/c01AddressType"
          },
          "city": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string"
          },
          "country": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Usually filled in with United Kingdom"
          },
          "houseNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "postCode": {
            "maxLength": 8,
            "minLength": 0,
            "type": "string",
            "description": "* The Post Code is a 6 to 8 characters field including  spaces.\n* The Post Code must be in two parts separated by a space.\n* The first part must be in one of these formats:AN, AAN, AANA, AANN, ANA, ANN\n* The second part must be in the format NAA\n"
          },
          "street1": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "stage2AdditionalDamagesPack.claimantRepresentative.companyDetails": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/stage2AdditionalDamagesPack.claimantRepresentative.companyDetails.address"
          },
          "companyName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Name of the Claimant Representative company"
          },
          "contactName": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string",
            "description": "Name of the user that created this claim"
          },
          "contactSurname": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string",
            "description": "Surname of the user that created this claim"
          },
          "emailAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "referenceNumber": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "[^|\u00a6#$,\u00a3~\\^`\\[\\]\\{\\}_\u20ac\u00ac][A-Za-z0-9 \\/.-]{0,48}[A-Za-z0-9]{0,1}",
            "type": "string",
            "description": "Claimant representative Reference Number must not be all blanks or all zeros or combination of blanks and zeros\nNot allowed chars:\n* | (Pipe character)\n* \u00a6 (half pipe)\n* \\# (hash)\n* $\n* ,\n* \u00a3\n* ~\n* ^\n* `\n* [\n* ]\n* {\n* }\n* _\n* \u20ac\n* \u00ac\n"
          },
          "telephoneNumber": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "policyNumber": {
            "type": "string",
            "description": "IGNORE IT"
          },
          "providerAddress": {
            "type": "string",
            "description": "IGNORE IT"
          },
          "contactMiddleName": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string",
            "description": "Middle Name of the user that created this claim"
          }
        }
      },
      "stage2AdditionalDamagesPack.claimantRepresentative": {
        "type": "object",
        "properties": {
          "companyDetails": {
            "$ref": "#/components/schemas/stage2AdditionalDamagesPack.claimantRepresentative.companyDetails"
          }
        }
      },
      "stage2AdditionalDamagesPack.defendantRepresentative.defendantsInsurer": {
        "type": "object",
