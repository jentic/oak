      "ctProvidedServices": {
        "type": "object",
        "properties": {
          "defendantsInsurer": {
            "$ref": "#/components/schemas/ctCompanyDetails"
          },
          "preparedToProvideRehabilitation": {
            "type": "boolean"
          },
          "rehabilitationProvided": {
            "type": "boolean"
          },
          "rehabilitationDetails": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Returned if RehabilitationProvided = YES"
          },
          "altVchlProvided": {
            "type": "boolean"
          },
          "altVhclDetails": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "repairsProvided": {
            "type": "boolean"
          },
          "repairsDetails": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Returned if  RepairsProvided = YES"
          },
          "notificationDate": {
