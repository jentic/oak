                "schema": {
                  "$ref": "#/components/schemas/searchCompensatorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/compensators/compensators-by-insurer-index": {
      "post": {
        "tags": [
          "compensators"
        ],
        "summary": "searchCompensatorsByInsurerIndex",
        "description": "The POST /compensators-by-insurer-index must be used to retrieve the information needed to send the claim to the correct Compensator, such as:\n* rapidInsurerPath (organisationId)\n* InsurerName\n* insurerOrganisationPath (rapidInsurerPath)      \n\n<b>Frequency</b>\n\nThis functionality should only be used when searching for the insurer/compensator when creating a new CNF or when re-assigning the claim to another insurer/compensator.\n",
        "operationId": "searchCompensatorsByInsurerIndex",
        "parameters": [
          {
            "name": "login-as",
