              {
                "$ref": "#/components/schemas/stage2AdditionalDamagesPack"
              }
            ]
          },
          "courtProceedingsPack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/courtProceedingsPack"
              }
            ]
          },
          "timeouts": {
            "allOf": [
              {
                "$ref": "#/components/schemas/timeouts"
              }
            ]
          }
        }
