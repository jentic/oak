    "/claims/attachments/{attachmentId}": {
      "get": {
        "tags": [
          "attachments"
        ],
        "summary": "getAttachment",
        "description": "This request provides the functionality to get an `attachment` of a particular `claim` as a stream of bytes.\n\n<b>Frequency</b>\n\nThis functionality should be used when a new attachment is included in the retrieved list using the GET /claims/{claimId}/attachments/ functionality.\n",
        "operationId": "getAttachment",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attachmentId",
            "in": "path",
            "description": "Unique identifier of the attachment on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/attachmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claimId}/attachments/": {
      "get": {
        "tags": [
          "attachments"
        ],
        "summary": "getAttachmentsList",
        "description": "This request provides the functionality to get the list of attachments of a particular `claim`:\n\nThe attachment is identified in the system with an attachment ID, a title, and a description.\n\n<b>Max size</b>: Max size: 4MB for each attachment, with a maximum of 20MB in total for all attachments.\n\n* Max Number of attachments allowed for Claimant Representative: 40 attachments\n* Max Number of attachments allowed for Compensator: 10 attachments\n\nThis means that the CR can attach up to 40 attachments to each claim, and the COMP can attach up to 10 attachments to each claim, irrespective of the number of attachments added by the counterpart (subject to the 4MB individual and 20MB total size limits).\n\n<b>Frequency</b>\n\nThis functionality should be used once when a claim moves from one phase to another, as this is the moment when the attachments are most likely to be updated by both parties.\n",
        "operationId": "getAttachmentsList",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "claimId",
            "in": "path",
            "description": "Unique identifier of the claim on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/attachmentListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/branches": {
      "get": {
        "tags": [
          "branches"
        ],
        "summary": "getBranchesList",
        "description": "This request provides the functionality to get the list of the `branches` of the Organisation of calling user. \n\nSince the list of branches does not frequently change, it should be called only in case of reasonable doubts that the list was updated after the last time the same function was called.\n\n<b>Releases</b>: All\n",
        "operationId": "getBranchesList",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/branchesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
