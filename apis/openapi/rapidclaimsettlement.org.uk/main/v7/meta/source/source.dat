              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/notifications": {
      "get": {
        "tags": [
          "notifications"
        ],
        "summary": "getNotificationsList",
        "description": "\nThis request provides the functionality to get the list of notifications available to the \u201clogin-as\u201d user (and displayed to this user in the \u201cNotifications\u201d section of the webUI) that have not yet been deleted from the system.\nPlease refer to the documentation for details regarding Bulk Transfer notifications and how to retrieve them.\n\n<b>Frequency</b>\n\nSince the bulk transfer activity is an overnight process, the GET /claims/notifications method set to retrieve the bulk transfer notifications must be called daily as the first task in the morning.\nThe other notifications are updated four times per hour. Therefore, the GET /claims/notifications method set to retrieve these notifications must not be called more than four times per hour during business hours (8 AM - 9 PM Mon-Fri, 8 AM - 2 PM Saturday). Calling this method outside the business hours is unnecessary.\n",
        "operationId": "getNotificationsList",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "a2aNotification",
            "in": "query",
            "description": "Flag to extract the A2A notifications. Must be set to \u201ctrue\u201d to download the A2A notifications. Don't pass the parameter or set it to \u201cfalse\u201d to download web browser notifications. Note that only the A2A user can download A2A notifications.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/notificationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/printable-documents/{printableDocumentId}": {
      "post": {
        "tags": [
          "printableDocuments"
        ],
        "summary": "getPrintableDocument",
        "description": "This request provides the functionality to get a `Printable Document` of a specific claim.\n\n<b>NOTE</b>: the printable document with title \u201cDefendant only Claim Notification Form\u201d can be downloaded only by the Claimant Representatives, Compensators are not allowed to download this printable document.\n\n<b>Frequency</b>\n\nPrintable documents are added only when the claim changes ownership. Consequently, when taking ownership of a claim, it is possible to download new printable documents. While maintaining ownership of the claim, there is no need to check for further changes to the list of printable documents.\n",
        "operationId": "getPrintableDocument",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "printableDocumentId",
            "in": "path",
            "description": "Unique identifier of the printable document on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/getPrintableDocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
