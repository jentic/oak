            "minLength": 0,
            "type": "string"
          },
          "postCode": {
            "maxLength": 8,
            "minLength": 0,
            "type": "string",
            "description": "* The Post Code is a 6 to 8 characters field including  spaces.\n* The Post Code must be in two parts separated by a space.\n* The first part must be in one of these formats:AN, AAN, AANA, AANN, ANA, ANN\n* The second part must be in the format NAA\n"
          }
        }
      },
      "medicalDetails": {
        "type": "object",
        "properties": {
          "injury": {
            "$ref": "#/components/schemas/ctInjury"
          },
          "hospital": {
            "maxItems": 4,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ctHospital"
            },
            "description": "There can be from 0 to 4 hospitals.  If there is at least one hospital, HospitalAttendance must YES and if HospitalAttendance must YES, then at least one hospital must be input."
          },
          "rehabilitation": {
            "$ref": "#/components/schemas/ctRehabilitation"
          },
          "hospitalSearch": {
            "$ref": "#/components/schemas/medicalDetails.hospitalSearch"
          }
        }
      },
      "ctInputAlternativeCompany": {
        "type": "object",
        "properties": {
          "companyName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "address": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "telephoneNumber": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "referenceNumber": {
            "type": "string"
          }
        }
      },
      "ctRepairs": {
        "type": "object",
        "properties": {
          "alternativeCompany": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctInputAlternativeCompany"
              }
            ],
            "description": "If the claim for vehicle damage is proceeding through an alternative company, ThroughAlternativeCompany must be = 1(YES)"
          },
          "claimingDamageOwnVehicle": {
            "type": "boolean"
          },
          "detailsOfTheInsurance": {
            "enum": [
              0,
              1,
              2,
              3
            ],
            "type": "number",
            "description": "ONLY IF claimingDamageOwnVehicle = YES  \n* 0 - Comprehensive  \n* 1 - Third party fire and theft  \n* 2 - Third party only  \n* 3 - Other  \nIf ClaimingDamageOwnVehicle=yes,  DetailsOfTheInsurance must be provided  (Details of the insurance cover held for the vehicle?)\n"
          },
          "otherDetails": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "ONLY IF claimingDamageOwnVehicle = YES  \nIF DetailsOfTheInsurance='Other', OtherDetails must be provided\n"
          },
          "throughClaimantInsurer": {
            "type": "boolean",
            "description": "ONLY IF claimingDamageOwnVehicle = YES \nIf ClaimingDamageOwnVehicle=yes, ThroughClaimantInsurer must be provided  (Is the claim for vehicle damage proceeding through the  claimant\u2019s insurer?)\n"
          },
          "throughAlternativeCompany": {
            "type": "boolean",
            "description": "ONLY IF claimingDamageOwnVehicle = YES \nIF ThroughClaimantInsurer=no,ThroughAlternativeCompany must be provided  (If No, is the claim for vehicle damage proceeding through an alternative company?)\n"
          },
          "repairsPosition": {
            "enum": [
              0,
              1,
              2,
              3
            ],
            "type": "number",
            "description": "ONLY IF claimingDamageOwnVehicle = YES \n  * 0 - Complete\n  * 1 - Authorised\n  * 2 - Not yet authorised\n  * 3 - Not known  \nIF TotalLoss = NO (TotalLoss=1) RepairsPosition must be provided (If not, what is current position with the repairs?)\n"
          },
          "defendantInsInspection": {
            "type": "boolean",
            "description": "ONLY IF claimingDamageOwnVehicle = YES\nIF TotalLoss = NO (TotalLoss=1)  DefendantInsInspection must be provided  (Do you require the defendant\u2019s insurer to organise the  repairs and/or inspection of the vehicle?)\n"
          },
          "location": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "ONLY IF claimingDamageOwnVehicle = YES.\nIF DefendantInsInspection = yes  Location must be provided\n"
          },
          "contactDetails": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "ONLY IF claimingDamageOwnVehicle = YES. \nIF DefendantInsInspection = yes  ContactDetails must be provided\n"
          },
          "totalLoss": {
            "enum": [
              0,
              1,
              2
            ],
            "type": "number",
            "description": "ONLY IF claimingDamageOwnVehicle = YES.\n* 0 - YES\n* 1 - NO  \n* 2 - Don't know\nIf ClaimingDamageOwnVehicle=yes, TotalLoss must  be provided  (Is the vehicle a Total Loss or likely to be?)\n"
          }
        }
      },
      "ctProvider": {
        "type": "object",
        "properties": {
          "vehicle": {
            "$ref": "#/components/schemas/ctVehicle"
          },
          "providerName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "referenceNumber": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "[^|\u00a6#$,\u00a3~\\^`\\[\\]\\{\\}_\u20ac\u00ac][A-Za-z0-9 \\/.-]{0,48}[A-Za-z0-9]{0,1}",
            "type": "string",
            "description": "Defendant Insurer Reference Number must not be all blanks or all zeros or combination of blanks and zeros\nNot allowed chars:\n* | (Pipe character)\n* \u00a6 (half pipe)\n* \\# (hash)\n* $\n* ,\n* \u00a3\n* ~\n* ^\n* `\n* [\n* ]\n* {\n* }\n* _\n* \u20ac\n* \u00ac\n"
          },
          "providerAddress": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "description": "Please note that this has been defined as a  string on purpose, to allow entering more  details if an end date is not applicable (for  example to allow entering \u201cstill ongoing\u201d)"
          }
        }
      },
      "ctAlternativeVehicleProvision": {
        "type": "object",
        "properties": {
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctProvider"
              }
            ],
            "description": "Returned ONLY IF avProvided = true"
          },
          "claimantEntitled": {
            "type": "boolean",
            "description": "\u201cHas the claimant been provided a vehicle by their insurer?\u201d"
          },
          "avRequiredByCl": {
            "type": "boolean",
            "description": "Returned ONLY IF claimantEntitled = false. \nIF claimantEntitled = false avRequiredByCl must be provided (\u201cDoes the claimant require the use of an alternative vehicle?\u201d)\n"
          },
          "avProvided": {
            "type": "boolean",
            "description": "Returned ONLY IF claimantEntitled = false. \n(\u201cHas the claimant been provided with the use of an alternative vehicle?\u201d)\n"
          },
          "hireNeed": {
            "type": "boolean",
            "description": "Returned ONLY IF claimantEntitled = false. \nIF avProvided = true => HireNeed must be provided(\u201cIf Yes, is the hire need  still on going?\u201d)\n"
          },
          "avRequiredByCr": {
            "type": "boolean",
            "description": "Returned ONLY IF claimantEntitled = false. \n(\u201cDo you require the defendant's insurer to provide your client with an alternative  vehicle?\u201d)\n"
          },
          "vehicleType": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Returned ONLY IF claimantEntitled = false. \nIF avRequiredByCr = true vehicleType must be provided \n(\u201cWhat type of vehicle is required\u201d)\n"
          },
          "contactName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Returned ONLY IF claimantEntitled = false. \nIF avRequiredByCr = true contactName must be provided\n"
          },
          "telephoneNumber": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Returned ONLY IF claimantEntitled = false.\nIF avRequiredByCr = true telephoneNumber must be provided\n"
          }
        }
      },
      "repairsAndAlternativeVehicleProvision": {
        "type": "object",
        "properties": {
          "repairs": {
            "$ref": "#/components/schemas/ctRepairs"
          },
          "alternativeVehicleProvision": {
            "$ref": "#/components/schemas/ctAlternativeVehicleProvision"
          }
        }
      },
