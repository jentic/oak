      "ctInjury": {
        "type": "object",
        "properties": {
          "softTissue": {
            "type": "boolean"
          },
          "boneInjury": {
            "type": "boolean"
          },
          "whiplash": {
            "type": "boolean"
          },
          "other": {
            "type": "boolean"
          },
          "injurySustainedDescription": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Description of the injury"
          },
          "timeOffRequired": {
            "type": "boolean",
            "description": "Has the claimant had to take any time off  work as a result of the injury?"
          },
          "timeOffPeriod": {
            "maximum": 99999,
            "exclusiveMaximum": false,
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "integer",
            "description": "If StillOffWork=no, TimeOffPeriod must  be provided  If no, for how many days was off work?"
          },
          "stillOffWork": {
            "type": "boolean",
            "description": "If StillOffWork=no, TimeOffPeriod must  be provided. If no, for how many days was off work?"
          },
          "medicalAttentionSeeking": {
            "type": "boolean",
            "description": "Has the claimant sought any medical  attention?"
          },
          "medicalAttentionFirstDate": {
            "type": "string",
            "description": "The date format can include additional information, e.g. the Time Zone. Ensure that only the required information, i.e. YYYY-MM-DD are provided.",
            "format": "date-time"
          },
          "hospitalAttendance": {
            "type": "boolean",
            "description": "Did the claimant attend hospital as a result  of the accident?"
          },
          "overnightDetention": {
            "type": "boolean",
            "description": "If HospitalAttendance=yes, OvernightDetention must be provided"
          },
          "daysNumber": {
            "type": "string",
            "description": "If OvernightDetention =yes, DaysNumber must be provided"
          }
        }
      },
      "cthospitalAddress": {
        "type": "object",
        "properties": {
          "addressLine1": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "addressLine2": {
            "maxLength": 100,
