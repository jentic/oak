    "/claims/{claimId}/lock-claim": {
      "post": {
        "tags": [
          "claims"
        ],
        "summary": "lockClaim",
        "description": "This request provides the functionality to lock the provided `claim`. <br><b>Please note that:</b>\n* Only the user who has locked the claim can change the flow step or adds data to the claim. \n* The claim can be unlocked by the same user who has locked using an unlock claim method or can be unlocked by other users using the force unlock method.\n* The life scope of the lock established by /lock-claim is up to the execution of the next action which changes the flow step or adds data to the claim; to maintain the lock after such action a new /lock-claim must be executed.\n\n<b>Releases</b>: All\n",
        "operationId": "lockClaim",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "claimId",
            "in": "path",
            "description": "Unique identifier of the claim on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/activityEngineGuid"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claimId}/notifications/{notificationId}": {
      "delete": {
        "tags": [
          "notifications"
        ],
        "summary": "removeNotification",
        "description": "This request provides the functionality to delete, for the provided `claim`, the `notification` identified by the provided notificationId.\n\n<b>Releases</b>: All        \n",
        "operationId": "removeNotification",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
