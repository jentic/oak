      "ctApplicationIds": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "description": "Id of the Claim (it\u2019s the Application Id)"
          },
          "representativeId": {
            "type": "string",
            "description": "ID of the Claimant Representative  Organisation"
          },
          "representativeName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Name of the Claimant Representative  Organisation"
          },
          "representativeBranchId": {
            "type": "string",
            "description": "ID of the Branch in the Claimant  Representative Organisation"
          },
          "representativeBranchName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Name of the Branch of the Claimant  Representative Organisation"
          },
          "representativeOrgPath": {
            "type": "string"
          },
          "insurerId": {
            "type": "string",
            "description": "D of the Compensator Organisation"
          },
          "insurerName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Name of Compensator Organisation"
          },
          "insurerBranchId": {
            "type": "string",
            "description": "ID of the Branch in the Compensator  Organisation"
          },
          "insurerBranchName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Name of the Branch of the Compensator  Organisation"
          },
          "insurerAcceptingBranchId": {
            "type": "string"
          },
          "insurerAcceptingBranchName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "endDate": {
            "type": "string",
            "description": "Date of End of the claim",
            "format": "date-time"
          },
          "mainApplicant": {
            "type": "string"
          },
          "allocatedUserId": {
            "type": "string",
            "description": "ID of the User to which the claim is allocated  (IF it was allocated via the function Allocate  To user) WITHIN THE ORGANISATION  THAT IS HANDLING THE CLAIM at the  moment"
          },
          "allocatedUserName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "allocatedSurname": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "insurerClaimReferenceNumber": {
            "type": "string",
            "description": "optional value for the Defendant Insurer Claim Reference Number (introduced within Release 1)"
          },
          "claimValue": {
            "enum": [
              "1",
              "2"
            ],
            "type": "string",
            "description": "FROM RELEASE 3 ON  Flag that indicates the claim value: <br>\n* 1 = Up to \u00a310,000\n* 2 = Up to \u00a325,000\n"
          },
          "askCuePiReference": {
            "maxLength": 18,
            "minLength": 1,
            "type": "string",
            "description": "The latest AskCUEPI Reference number  inserted for this claim during its lifecycle"
          },
          "medCoCaseId": {
            "maxLength": 11,
            "minLength": 3,
            "type": "string",
            "description": "The latest MedCoCase Reference number  inserted for this claim during its lifecycle  (Note that the MedCoCase Reference number  can be inserted in both the Interim Settlement  Pack form and in the Stage 2 Settlement Pack  form)"
          },
          "cruReferenceNumber": {
            "pattern": "([a-zA-Z]{3})([0-9]{3})",
            "type": "string",
            "description": "FROM RELEASE 6 ON-  - First 3 chars- 3 alpha (either uppercase or lowercase)  - Next 3 chars- 3 Numeric  Please note that if present the CRUReference number cannot be empty"
          }
        }
      },
      "ctClaimDetails2": {
        "type": "object",
        "properties": {
          "sentDate": {
            "type": "string",
            "description": "The date in which the CNF was sent by the  CR",
            "format": "date-time"
          },
          "article75": {
            "type": "boolean",
            "description": "Flag that indicates if article75 was applied or  not"
          },
          "claimValue": {
            "enum": [
              "1",
              "2"
            ],
            "type": "string",
            "description": "Flag that indicates the claim value. Possible values:\n* 1 - Up to \u00a310,000\n* 2 - Up to \u00a325,000  \n"
          },
          "interimPaymentTimeoutExtended": {
            "type": "boolean",
            "description": "Flag that indicates whether the timeframe to  take a decision for the Interim Payment was  extended or not"
          },
          "oicReferenceNumber": {
            "pattern": "(OIC-)[0-9\\-]{1,28}",
            "type": "string",
            "description": "FROM RELEASE 7 ON. \nTo be used to add to the claim the OIC reference number used in case of claims previously opened on the OIC portal.\nIt can be present only if accident date is equal  or greater than 31/05/2021\n",
            "example": "OIC-06-2021-1234567890123456789"
          }
        }
      },
      "applicationData.claimantDetails": {
        "type": "object",
        "properties": {
          "isClaimantChildAtStage1Response": {
            "type": "boolean",
            "description": "Flag that indicates if the claimant was a  child when the Stage 1 Insurer response  was sent by the Compensator"
          },
          "isClaimantChildAtStage2Agreement": {
            "type": "boolean",
            "description": "Flag that indicates if the claimant was a  child when the Stage 2 Settlement pack  request was sent to the Compensator"
          },
          "isClaimantChildAtStage2AgreementAd": {
            "type": "boolean",
            "description": "Flag that indicates if the claimant was a  child when the Stage 2 Settlement pack was  agreed"
          },
          "isClaimantChildAtStage2Request": {
            "type": "boolean",
            "description": "Flag that indicates if the claimant was a  child when the Stage 2 Settlement pack  additional damages was agreed"
          }
        }
      },
      "ctReject2": {
        "type": "object",
        "properties": {
          "fraudReasonCode": {
            "enum": [
              0,
              1,
              2
            ],
            "type": "number",
            "description": "Possible Values:\n* 0 - Fraud stated\n* 1 - Reason 2 (DEPRECATED) \n* 2 - Reason 3 (DEPRECATED)\n"
          },
          "fraudComment": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ctStatementsOfTruth2": {
        "type": "object",
        "properties": {
          "signatoryType": {
            "$ref": "#/components/schemas/c16SignatoryType"
          },
          "retainedSignedCopy": {
            "type": "boolean",
            "description": "Always 1"
          }
        }
      },
      "ctExitCr": {
        "type": "object",
        "properties": {
          "exitReasonCode": {
            "enum": [
              "2",
              "3",
              "4",
              "5",
              "6",
              "7",
              "8",
              "10",
              "11",
              "12",
              "13",
              "16"
            ],
            "type": "string",
            "description": "These reason codes are used by the CR. Possible values:\n  * 2 - Value of claim below \u00a31,000\n  * 3 - Value of claim exceeds the upper  limit  \n  * 4 - Claim is too complex for process\n  * 5 - Withdrawal of claim\n  * 6 - Duplicated claim\n  * 7 - Withdrawal of offer\n  * 8 - Interim payment for child  claimant\n  * 10 - Other\n  * 11 - Stage 1 costs not paid on time (FROM RELEASE 2)\n  * 12 - Interim Payment partial offer not accepted (FROM RELEASE 2)\n  * 13 - Interim Payment request not answered and/or paid on time (FROM RELEASE 2)\n  * 16 - Wrong Portal (FROM RELEASE 7 ON. It can be used only for claims with accident date from 31/05/2021)\n"
          },
          "exitComment": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ctExitCm": {
        "type": "object",
        "properties": {
          "exitReasonCode": {
            "enum": [
              1,
              2,
              3,
              6,
              7,
              9,
              10,
              16
            ],
            "type": "number",
            "description": "These reason codes are used by the CM. Possible values: \n * 1 - Incomplete information provided on CNF (please note that this code is valid only during Stage 1)\n * 2 - Value of claim below \u20ac 1,000 (please note that this no longer applies)\n * 3 - Value of claim exceeds the upper limit\n * 6 - Duplicated claim\n * 7 - Withdrawal of offer\n * 9 - Claim requires further investigation\n * 10 - Other\n * 16 - Wrong Portal (FROM RELEASE 7 ON. It can be used only for claims with accident date from 31/05/2021)\n"
          },
          "exitComment": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "applicationData.exitProcess": {
        "type": "object",
        "properties": {
          "exitCr": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ctExitCr"
