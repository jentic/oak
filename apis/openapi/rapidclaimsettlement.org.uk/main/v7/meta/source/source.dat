    "/claims/{claimId}/allocate-user": {
      "post": {
        "tags": [
          "claims"
        ],
        "summary": "allocateUser",
        "description": "<b>If performed by a Claimant Representative (CR):</b>\n\nThis request provides the functionality for a CR to allocate a `claim` to a specific user, can be executed only if the login-as User has the CR Team Leader profile. \n_<br>This will impact the dispatch of the claim.<br>_\nTo deallocate the claim from a specific user, see /deallocate-user method.\n\n<b>If performed by a Compensator (COMP):</b>\n\nThis request provides the functionality for a COMP to allocate a `claim` to a specific user, can be executed only if the login-as User has the COMP Claim handler Team Leader profile.\n_This will impact the dispatch of the claim._<br>\n<b>Please note</b> that the target user should have one of the following profiles:\n* COMP Claim Handler\n* COMP Team Leader\n* COMP Branch Claim Handler (but only if belongs to the same branch).\n\nTo deallocate the claim from a specific user, see /allocate-claim-to-branch method.\n\n<b>Releases</b>: All\n",
        "operationId": "allocateUser",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "claimId",
            "in": "path",
            "description": "Unique identifier of the claim on the Claims Portal system.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/allocateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/successfullResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Process not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claimId}/deallocate-user": {
      "post": {
        "tags": [
          "claims"
        ],
        "summary": "deallocateUser",
        "description": "This request provides the functionality for a Claimant Representative to de-allocate a specific `claim` from the allocated user. <br><b>Please note that:</b>\n* it can be executed only if the login-as User has CR Team Leader profile.\n* this will impact the dispatch of the claim and the notifications related to such claim.\n* Please note that for Compensators, should be used instead /allocate-claim-to-branch\n\n<b>Releases</b>: All\n",
        "operationId": "deallocateUser",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
