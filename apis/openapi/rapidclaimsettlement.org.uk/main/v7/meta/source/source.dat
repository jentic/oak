    "/compensators": {
      "post": {
        "tags": [
          "compensators"
        ],
        "summary": "searchCompensators",
        "description": "This request provides the functionality to search a compensator, in order to get the organisationId to send the claim. The search is performed with a partial match on the organisationName.\n\n<b>Releases</b>: All\n\n_<b>WARNING</b>_\n\n_This command is deprecated since its search result do not mimic the behaviour of the web portal: this means that does not correctly accesses the mapping between brands and insurers/third party insurers. To ensure a correct routing of the claim to the relevant insurer, it is strongly suggested to use instead the /compensators-by-insurer-index method._\n",
        "operationId": "searchCompensators",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/searchCompensatorRequest"
              }
            }
