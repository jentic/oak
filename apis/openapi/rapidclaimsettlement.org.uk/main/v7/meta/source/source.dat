    {
      "url": "https://api-integration.rapidclaimsettlement.org.uk/api/rta-static/v7"
    }
  ],
  "paths": {
    "/processes/system-process-version": {
      "get": {
        "tags": [
          "processes"
        ],
        "summary": "getSystemProcessVersion",
        "description": "This method returns the most recent process version running in the system. \n\n<b>Releases</b>: All\n",
        "operationId": "getSystemProcessVersion",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
            "required": true,
            "schema": {
              "type": "string"
            }
