    "/hospitals": {
      "post": {
        "tags": [
          "hospitals"
        ],
        "summary": "getHospitalsList",
        "description": "Used to search within the list of NHS Hospitals in the system, given some search criteria.<br>\n\n<b>Frequency</b>\n\nDue the frequency of updates it is sufficient to download the hospital list once a day.\n",
