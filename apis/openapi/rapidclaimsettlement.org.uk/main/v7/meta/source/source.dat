  "components": {
    "schemas": {
      "errorResponse": {
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Code of the error on the system."
          },
          "message": {
            "type": "string",
            "description": "Error message."
          },
          "traceId": {
            "type": "string",
            "description": "Unique identifier of the error on the system. If an email is sent to the HelpDesk this detail needs to be included in the message."
          },
          "details": {
            "type": "string",
            "description": "Further details of the error."
          },
          "processError": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/errors"
            }
          }
        }
      },
      "errors": {
        "type": "object",
        "properties": {
          "errorMessage": {
            "type": "string",
            "description": "Error message."
          },
          "fieldName": {
            "type": "string",
            "description": "Name of the field affected by the issue."
          },
          "fieldsetName": {
            "type": "string",
            "description": "Name of the set of fields the affected field belongs to."
          }
        }
      },
      "systemProcessVersionResponse": {
        "type": "object",
        "properties": {
          "processName": {
            "type": "string",
            "description": "Always \u201cPersonal Injury Process\u201d"
          },
          "versionMajor": {
            "type": "number",
            "description": "Major version of the system process version."
          },
          "versionMinor": {
            "type": "number",
            "description": "Minor version of the system process version."
          }
        }
      },
      "organisationResponse": {
        "type": "object",
        "properties": {
          "organisationId": {
            "type": "string"
          },
          "organisationName": {
            "type": "string"
          },
          "organisationPath": {
            "type": "string",
            "description": "Returned as \"/organisationId\""
          },
          "address": {
            "$ref": "#/components/schemas/address"
          }
        }
      },
      "hospitalsRequest": {
        "type": "object",
        "properties": {
          "hospitalName": {
            "type": "string",
            "description": "Text to be searched in the hospital name"
          },
          "postCode": {
            "type": "string",
            "description": "Postcode to be searched"
          }
        }
      },
      "hospitalsResponse": {
        "type": "object",
        "properties": {
          "hospitalsList": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/hospital"
            }
          }
        }
      },
      "searchClaimRequest": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "branchPath": {
            "type": "string",
            "description": "filter available to Claimant Representatives only"
          },
          "cmRreferenceNumber": {
            "type": "string",
            "description": "Claim CM Reference number"
          },
          "crReferenceNumber": {
            "type": "string",
            "description": "Claim CR Reference Number"
          },
          "dispatchDateFrom": {
            "type": "string",
            "description": "The initial dispatch date (refer to date description) from which the lookup should return the results",
            "format": "date-time"
          },
          "dispatchDateTo": {
            "type": "string",
            "description": "The final dispatch date (refer to date description) to which the lookup should return the results",
            "format": "date-time"
          },
          "phaseCacheId": {
            "type": "string"
          },
          "sentDateFrom": {
            "type": "string",
            "description": "The initial sent date (refer to date description) from which the lookup should return the results",
            "format": "date-time"
          },
          "sentDateTo": {
            "type": "string",
            "description": "The final sent date (refer to date description) to which the lookup should return the results",
            "format": "date-time"
          },
          "sortField": {
            "enum": [
              "startDate",
              "updateDate",
              "applicationId",
              "priority",
              "dispatchDate"
            ],
            "type": "string"
          },
          "sortOrder": {
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
          "startDateFrom": {
            "type": "string",
            "description": "The initial start date (refer to date description) from which the lookup should return the results",
            "format": "date-time"
          },
          "startDateTo": {
            "type": "string",
            "description": "The final start date (refer to date description) to which the lookup should return the results",
            "format": "date-time"
          }
        }
      },
      "searchClaimResponse": {
        "type": "object",
        "properties": {
          "claimsList": {
            "maxItems": 5000,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/claim"
            },
            "description": "The list of claims belonging matching the given criteria and visible to the \u201clogin-as\u201d User"
          }
        }
      },
      "claimStatusResponse": {
        "type": "object",
        "properties": {
          "activityEngineGuid": {
            "type": "string",
            "format": "uuid"
          },
          "applicationId": {
            "type": "string"
          },
          "phaseCacheId": {
            "type": "string"
          },
          "phaseCacheName": {
            "type": "string"
          },
          "gdprClaimDeleted": {
            "type": "number",
            "description": "Field present with attribute ClaimDeleted equal to 1 only if the claim has been deleted for GDPR reasons"
          },
          "versionMajor": {
            "type": "number"
          },
          "versionMinor": {
            "type": "number"
          },
          "processReleaseNumber": {
            "type": "number"
          }
        }
      },
      "getClaim_claimData": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/data"
          }
        }
      },
      "addAttachmentRequest": {
        "type": "object",
        "properties": {
          "dataAttachmentFileName": {
            "type": "string",
            "description": "Attachment's filename, empty if attaching a note."
          },
          "dataAttachmentFileZip": {
            "type": "string",
            "description": "Stream of bytes base64 encoded, representing the file to be uploaded (not compressed with Zip), empty if attaching a note."
          },
          "dataAttachmentTitle": {
            "type": "string",
            "description": "Attachment's title, describing the file content and usage."
          },
          "dataAttachmentDesc": {
            "type": "string",
            "description": "Attachment's description."
          }
        }
      },
      "addAttachmentResponse": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "ID of the Attachment"
          }
        }
      },
      "allocateClaimToBranchRequest": {
        "type": "object",
        "properties": {
          "activityEngineGuid": {
            "type": "string",
            "format": "uuid"
          },
          "branchId": {
            "type": "string"
          }
        }
      },
      "successfullResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "activityEngineGuid": {
            "type": "string",
            "format": "uuid"
          },
          "phaseCacheId": {
            "type": "string"
          },
          "phaseCacheName": {
            "type": "string"
          }
        }
      },
      "attachmentResponse": {
        "type": "object",
        "properties": {
          "dataAttachmentGuid": {
            "type": "string",
            "description": "Attachment's Id",
            "format": "uuid"
          },
