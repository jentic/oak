      "ctInsurerInformation": {
        "type": "object",
        "properties": {
          "branchDetails": {
            "$ref": "#/components/schemas/ctBranchDetails"
          },
          "insurerType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/c13InsurerType"
              }
            ],
            "description": "InsurerType=\"I\" for Insurers </br> InsurerType=\"M\" for MIB </br> InsurerType=\"S\" for self insures </br> InsurerType=\"LF\" for law firm </br> InsurerType=\"CMMISC\" for miscellaneous </br> InsurerType=\"TPADA\" for Third party or delegated authority"
          },
