              }
            ],
            "description": "This node contains the data shown in the Section B \u201cInjury and medical details\u201d and Section C \u201cRehabilitation\u201d of the CNF"
          },
          "repairsAndAlternativeVehicleProvision": {
            "allOf": [
              {
                "$ref": "#/components/schemas/repairsAndAlternativeVehicleProvision"
              }
            ],
            "description": "This node contains the data shown in the Section D \u201cRepairs\u201d and Section E \u201cAlternative vehicle provision\u201d of the CNF"
          },
          "accidentData": {
            "allOf": [
              {
                "$ref": "#/components/schemas/accidentData"
              }
            ],
            "description": "This node contains the data shown in the Section F \u201cAccident Details\u201d, Section G \u201cAccident time, location and description\u201d and Section J \u201cAccidents involving a bus or a  coach\u201d of the CNF"
          },
          "otherPartyDetails": {
            "allOf": [
              {
                "$ref": "#/components/schemas/otherPartyDetails"
              }
            ],
            "description": "This node contains the data shown in the Section I \u201cOther Party Details\u201d of the CNF. Fields used if there is at leas one Other Party."
          },
          "liabilityFunding": {
            "allOf": [
              {
                "$ref": "#/components/schemas/liabilityFunding"
              }
            ],
            "description": "This node contains the data shown in the Section K \u201cLiability and Section M \u201cOther relevant information\u201d of the CNF. FROM RELEASE 6 ON the fields related to the Section L \u201cFunding\u201d are removed from the system. The field Comments has not been removes."
          },
          "insurerResponse": {
            "allOf": [
              {
                "$ref": "#/components/schemas/insurerResponse"
              }
            ],
            "description": "This node contains the data shown in the Section A \u201cLiability/Causation\u201d, Section B1 \u201cServices provided by the insurer - Rehabilitation\u201d, Section B2 \u201cServices provided by the insurer \u2013 Alternative vehicle provision\u201d, Section B3 \u201cServices provided by the insurer \u2013 Repairs/Inspection\u201d and Section C \u201cServices provided by the insurer \u2013 Response information\u201d of the Insurer Response to the CNF"
          },
          "interimSettlementPackList": {
            "allOf": [
              {
                "$ref": "#/components/schemas/data.interimSettlementPackList"
              }
            ],
            "description": "The node InterimSettlementPackList contains the list of Interim Settlement Packs and it is made of a sequence of InterimSettlementPack elements"
          },
          "stage2SettlementPack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/stage2SettlementPack"
              }
            ]
          },
          "stage2AdditionalDamagesPack": {
