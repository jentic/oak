            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "houseNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "postCode": {
            "maxLength": 8,
            "minLength": 0,
            "type": "string",
            "description": "* The Post Code is a 6 to 8 characters field including  spaces.\n* The Post Code must be in two parts separated by a space.\n* The first part must be in one of these formats:AN, AAN, AANA, AANN, ANA, ANN\n* The second part must be in the format NAA\n"
          },
          "street1": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "courtProceedingsPack.claimantRepresentative.companyDetails": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/courtProceedingsPack.claimantRepresentative.companyDetails.address"
          },
          "companyName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "contactMiddleName": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string"
          },
          "contactName": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string"
          },
          "contactSurname": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string"
          },
          "emailAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "referenceNumber": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "[^|\u00a6#$,\u00a3~\\^`\\[\\]\\{\\}_\u20ac\u00ac][A-Za-z0-9 \\/.-]{0,48}[A-Za-z0-9]{0,1}",
            "type": "string",
            "description": "Claimant representative Reference Number must not be all blanks or all zeros or combination of blanks and zeros\nNot allowed chars:\n* | (Pipe character)\n* \u00a6 (half pipe)\n* \\# (hash)\n* $\n* ,\n* \u00a3\n* ~\n* ^\n* `\n* [\n* ]\n* {\n* }\n* _\n* \u20ac\n* \u00ac\n"
          },
          "telephoneNumber": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "policyNumber": {
            "maxLength": 16,
            "minLength": 0,
            "type": "string"
          },
          "providerAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "courtProceedingsPack.claimantRepresentative": {
        "type": "object",
        "properties": {
          "companyDetails": {
            "$ref": "#/components/schemas/courtProceedingsPack.claimantRepresentative.companyDetails"
          }
