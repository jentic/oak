{
  "openapi": "3.0.1",
  "info": {
    "title": "Swagger rta-static-release-7 - OpenAPI 3.0",
    "description": "Claims Portal rta-static API, available for both CR and COMP. The Release 7 is compatible with all the previous releases.",
    "version": "v7",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CASCANTONIO_1/swagger-rta-static-release-7-openapi-30/v7"
