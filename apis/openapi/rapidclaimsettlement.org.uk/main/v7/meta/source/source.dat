          },
          "stage1PaymentTimeout": {
            "type": "string",
            "description": "Timeout for the Stage 1 payment"
          }
        }
      },
      "timeouts.preCalculatedTimeouts.claimNotificationForm.mibOrArt75": {
        "type": "object",
        "properties": {
          "liabilityDecisionTimeout": {
            "type": "string",
            "description": "Timeout for the liability decision"
          },
