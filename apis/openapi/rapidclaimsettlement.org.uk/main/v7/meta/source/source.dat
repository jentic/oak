      "timeouts.currentTimeout": {
        "type": "object",
        "properties": {
          "selectedTimeOut": {
            "type": "string",
            "description": "This is the currently active timeout date"
          },
          "timeOutType": {
            "type": "string",
            "description": "This is an internal code to keep track of the applicable timeout phas\n* <missing element> => during Stage 1  \n* 1Payment: after executing the AddInsurerResponse()\n* 21: after executing AddInterimSPFRequest()\n* 221: after executing AddS2SPFRequest()\n* 222: after executing AddS2SPFResponse()\n* f370: after executing AddCPPFRequest()\n* 22ex: during a Extend Time request\n* 21ex: during an Interim Settlement Pack Extend Time request\n* 22ad: after executing AddS2SPFAdditionalDamagesRequest()\n* 22adex: during an Additional Damages Extend Time request\n"
          }
        }
      },
      "timeouts.preCalculatedTimeouts.claimNotificationForm.insurer": {
