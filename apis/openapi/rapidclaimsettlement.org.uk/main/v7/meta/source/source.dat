    "/claims/{claimId}/reassign-to-another-cm": {
      "post": {
        "tags": [
          "claims"
        ],
        "summary": "reassignToAnotherCM",
        "description": "This request provides the functionality for a Compensator to re-assign the `claim` to another Compensator.\n\n<b>NOTE</b>: this functionality is available to Compensator users only.\n\n<b>Releases</b>: All\n",
        "operationId": "reassignToAnotherCM",
        "parameters": [
          {
            "name": "login-as",
            "in": "header",
            "description": "Login user",
