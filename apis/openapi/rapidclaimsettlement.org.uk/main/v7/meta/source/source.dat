      "ctClaimantDetails": {
        "type": "object",
        "properties": {
          "personalDetails": {
            "$ref": "#/components/schemas/ctPersonalDetailsGetclaim"
          },
          "vehicle": {
            "$ref": "#/components/schemas/ctVehicle"
          },
          "occupation": {
            "type": "string"
          },
          "childClaim": {
            "type": "boolean"
          },
          "nationalInsuranceNumber": {
            "maxLength": 9,
            "minLength": 0,
            "pattern": "[A-CEGHJ-PR-TW-Z]{1}[A-CEGHJ-NPR-TW-Z]{1}[0-9]{6}[A-D ]{1}",
            "type": "string",
            "description": "* Characters 1-2 must be in the range AA-ZZ  \n* Character 1 must not be D, F, I, Q, U, V \n* Character 2 must not be D, F, I, O, Q, U, V\n* Characters 1-2 must not be one of the following combinations: FY, GB, NK, TN, TT, ZZ\n* Characters 3-6 must be in the range 0000 - 9999\n* Characters 7-8 must be in the range 00 - 99\n* Character 9 must be in the range A - D\n"
          },
          "ninComment": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Always returned if NationalInsuranceNumber is empty"
          }
        }
      },
