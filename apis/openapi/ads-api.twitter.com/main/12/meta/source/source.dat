    "/accounts/{account_id}/custom_audiences/{custom_audience_id}/users": {
      "post": {
        "operationId": "updateCustomAudienceUsers",
        "summary": "Add or remove users from a custom audience",
        "description": "Upload hashed user identifiers (email, phone, device ID, Twitter ID, handle) to add or remove from a custom audience.",
        "tags": ["Audiences"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "custom_audience_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["operation_type", "users"],
                "properties": {
                  "operation_type": { "type": "string", "enum": ["Update", "Delete"], "description": "Whether to add or remove users" },
                  "effective_at": { "type": "string", "format": "date-time" },
                  "expires_at": { "type": "string", "format": "date-time" },
                  "users": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "email": { "type": "array", "items": { "type": "string" }, "description": "SHA-256 hashed emails" },
                        "device_id": { "type": "array", "items": { "type": "string" }, "description": "SHA-256 hashed device IDs" },
                        "handle": { "type": "array", "items": { "type": "string" }, "description": "SHA-256 hashed Twitter handles" },
                        "twitter_id": { "type": "array", "items": { "type": "string" }, "description": "SHA-256 hashed Twitter user IDs" },
                        "phone_number": { "type": "array", "items": { "type": "string" }, "description": "SHA-256 hashed phone numbers" },
                        "partner_user_id": { "type": "array", "items": { "type": "string" }, "description": "SHA-256 hashed partner user IDs" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "success_count": { "type": "integer" },
                        "total_count": { "type": "integer" }
                      }
                    },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
