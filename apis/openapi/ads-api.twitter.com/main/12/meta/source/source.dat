{
  "openapi": "3.0.3",
  "info": {
    "title": "Twitter/X Ads API",
    "description": "The Twitter/X Ads API enables programmatic management of advertising campaigns, audiences, creatives, targeting, and analytics on the X (formerly Twitter) platform.",
    "version": "12",
    "x-jentic-source-url": "https://developer.twitter.com/en/docs/twitter-ads-api"
  },
  "servers": [
    {
      "url": "https://ads-api.twitter.com/12",
      "description": "Twitter/X Ads API v12 production server"
    }
  ],
  "security": [
    {
      "oauth1": []
    }
  ],
  "tags": [
    { "name": "Campaigns", "description": "Create, read, update, and manage ad campaigns" },
    { "name": "Line Items", "description": "Create, read, update, and manage line items (ad groups)" },
    { "name": "Promoted Tweets", "description": "Create, read, and manage promoted tweets/ads" },
    { "name": "Targeting", "description": "Create, read, delete targeting criteria and lookup targeting options" },
    { "name": "Analytics", "description": "Retrieve campaign, line item, and promoted tweet analytics" },
    { "name": "Audiences", "description": "Manage custom/tailored audiences and audience users" },
    { "name": "Media", "description": "Manage media creatives, cards, and media library assets" },
    { "name": "Accounts", "description": "Manage advertising accounts" },
    { "name": "Funding Instruments", "description": "Retrieve funding instrument information" }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "List advertising accounts",
        "description": "Retrieve all advertising accounts the authenticated user has access to.",
        "tags": ["Accounts"],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Search query for account name" },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" }, "description": "Sort field and order" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false }, "description": "Include deleted accounts" },
          { "name": "cursor", "in": "query", "schema": { "type": "string" }, "description": "Pagination cursor" },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 }, "description": "Number of results per page" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/AccountListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Retrieve a specific advertising account",
        "tags": ["Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/AccountResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "operationId": "updateAccount",
        "summary": "Update an advertising account",
        "tags": ["Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "Account name" },
                  "industry_type": { "type": "string", "description": "Industry classification" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/AccountResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "summary": "List campaigns for an account",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "campaign_ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list of campaign IDs to filter" },
          { "name": "funding_instrument_ids", "in": "query", "schema": { "type": "string" }, "description": "Filter by funding instrument IDs" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false }, "description": "Include deleted campaigns" },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false }, "description": "Include total count in response" },
          { "name": "cursor", "in": "query", "schema": { "type": "string" }, "description": "Pagination cursor" },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 }, "description": "Number of results" },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" }, "description": "Sort field and order" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Search query" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CampaignListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createCampaign",
        "summary": "Create a new campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["name", "funding_instrument_id"],
                "properties": {
                  "name": { "type": "string", "description": "Campaign name" },
                  "funding_instrument_id": { "type": "string", "description": "Funding instrument ID" },
                  "daily_budget_amount_local_micro": { "type": "integer", "format": "int64", "description": "Daily budget in microcurrency" },
                  "total_budget_amount_local_micro": { "type": "integer", "format": "int64", "description": "Total budget in microcurrency" },
                  "start_time": { "type": "string", "format": "date-time", "description": "Campaign start time (ISO 8601)" },
                  "end_time": { "type": "string", "format": "date-time", "description": "Campaign end time (ISO 8601)" },
                  "entity_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DRAFT"], "description": "Campaign status" },
                  "standard_delivery": { "type": "boolean", "description": "Use standard delivery (true) or accelerated (false)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/CampaignResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/campaigns/{campaign_id}": {
      "get": {
        "operationId": "getCampaign",
        "summary": "Retrieve a specific campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "$ref": "#/components/parameters/CampaignId" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CampaignResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "operationId": "updateCampaign",
        "summary": "Update an existing campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "$ref": "#/components/parameters/CampaignId" }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "daily_budget_amount_local_micro": { "type": "integer", "format": "int64" },
                  "total_budget_amount_local_micro": { "type": "integer", "format": "int64" },
                  "start_time": { "type": "string", "format": "date-time" },
                  "end_time": { "type": "string", "format": "date-time" },
                  "entity_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DRAFT"] },
                  "standard_delivery": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/CampaignResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteCampaign",
        "summary": "Delete a campaign",
        "tags": ["Campaigns"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "$ref": "#/components/parameters/CampaignId" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CampaignResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/line_items": {
      "get": {
        "operationId": "listLineItems",
        "summary": "List line items for an account",
        "tags": ["Line Items"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "line_item_ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list of line item IDs" },
          { "name": "campaign_ids", "in": "query", "schema": { "type": "string" }, "description": "Filter by campaign IDs" },
          { "name": "funding_instrument_ids", "in": "query", "schema": { "type": "string" }, "description": "Filter by funding instrument IDs" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LineItemListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createLineItem",
        "summary": "Create a new line item (ad group)",
        "tags": ["Line Items"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["campaign_id", "objective", "placements", "product_type"],
                "properties": {
                  "campaign_id": { "type": "string", "description": "Campaign ID this line item belongs to" },
                  "name": { "type": "string", "description": "Line item name" },
                  "product_type": { "type": "string", "enum": ["PROMOTED_TWEETS", "PROMOTED_ACCOUNT", "PROMOTED_TRENDS"], "description": "Product type" },
                  "objective": { "type": "string", "enum": ["APP_ENGAGEMENTS", "APP_INSTALLS", "AWARENESS", "ENGAGEMENTS", "FOLLOWERS", "PREROLL_VIEWS", "REACH", "VIDEO_VIEWS", "WEBSITE_CLICKS", "WEBSITE_CONVERSIONS"], "description": "Campaign objective" },
                  "placements": { "type": "string", "enum": ["ALL_ON_TWITTER", "PUBLISHER_NETWORK", "TWITTER_PROFILE", "TWITTER_SEARCH", "TWITTER_TIMELINE"], "description": "Ad placement" },
                  "bid_amount_local_micro": { "type": "integer", "format": "int64", "description": "Bid amount in microcurrency" },
                  "bid_type": { "type": "string", "enum": ["AUTO", "MAX", "TARGET"], "description": "Bidding strategy" },
                  "total_budget_amount_local_micro": { "type": "integer", "format": "int64" },
                  "start_time": { "type": "string", "format": "date-time" },
                  "end_time": { "type": "string", "format": "date-time" },
                  "entity_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DRAFT"] },
                  "automatically_select_bid": { "type": "boolean" },
                  "advertiser_domain": { "type": "string" },
                  "categories": { "type": "string" },
                  "charge_by": { "type": "string", "enum": ["IMPRESSION", "ENGAGEMENT", "APP_CLICK", "VIDEO_VIEW"] },
                  "optimization": { "type": "string" },
                  "audience_expansion": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/LineItemResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/line_items/{line_item_id}": {
      "get": {
        "operationId": "getLineItem",
        "summary": "Retrieve a specific line item",
        "tags": ["Line Items"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "$ref": "#/components/parameters/LineItemId" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LineItemResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "operationId": "updateLineItem",
        "summary": "Update a line item",
        "tags": ["Line Items"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "$ref": "#/components/parameters/LineItemId" }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "bid_amount_local_micro": { "type": "integer", "format": "int64" },
                  "bid_type": { "type": "string", "enum": ["AUTO", "MAX", "TARGET"] },
                  "total_budget_amount_local_micro": { "type": "integer", "format": "int64" },
                  "start_time": { "type": "string", "format": "date-time" },
                  "end_time": { "type": "string", "format": "date-time" },
                  "entity_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DRAFT"] },
                  "automatically_select_bid": { "type": "boolean" },
                  "audience_expansion": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/LineItemResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteLineItem",
        "summary": "Delete a line item",
        "tags": ["Line Items"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "$ref": "#/components/parameters/LineItemId" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/LineItemResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/promoted_tweets": {
      "get": {
        "operationId": "listPromotedTweets",
        "summary": "List promoted tweets for an account",
        "tags": ["Promoted Tweets"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "promoted_tweet_ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated promoted tweet IDs" },
          { "name": "line_item_ids", "in": "query", "schema": { "type": "string" }, "description": "Filter by line item IDs" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PromotedTweetListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createPromotedTweet",
        "summary": "Create a promoted tweet",
        "tags": ["Promoted Tweets"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["line_item_id", "tweet_ids"],
                "properties": {
                  "line_item_id": { "type": "string", "description": "Line item ID to associate with" },
                  "tweet_ids": { "type": "string", "description": "Comma-separated tweet IDs to promote" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/PromotedTweetResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/promoted_tweets/{promoted_tweet_id}": {
      "get": {
        "operationId": "getPromotedTweet",
        "summary": "Retrieve a specific promoted tweet",
        "tags": ["Promoted Tweets"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "promoted_tweet_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PromotedTweetResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deletePromotedTweet",
        "summary": "Delete a promoted tweet",
        "tags": ["Promoted Tweets"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "promoted_tweet_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PromotedTweetResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/funding_instruments": {
      "get": {
        "operationId": "listFundingInstruments",
        "summary": "List funding instruments for an account",
        "tags": ["Funding Instruments"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "funding_instrument_ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated funding instrument IDs" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/FundingInstrumentListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/funding_instruments/{funding_instrument_id}": {
      "get": {
        "operationId": "getFundingInstrument",
        "summary": "Retrieve a specific funding instrument",
        "tags": ["Funding Instruments"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "funding_instrument_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/FundingInstrumentResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/targeting_criteria": {
      "get": {
        "operationId": "listTargetingCriteria",
        "summary": "List targeting criteria for an account",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "line_item_ids", "in": "query", "schema": { "type": "string" }, "description": "Filter by line item IDs" },
          { "name": "targeting_criteria_ids", "in": "query", "schema": { "type": "string" } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/TargetingCriteriaListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createTargetingCriteria",
        "summary": "Create targeting criteria for a line item",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["line_item_id", "targeting_type", "targeting_value"],
                "properties": {
                  "line_item_id": { "type": "string", "description": "Line item ID to apply targeting to" },
                  "targeting_type": { "type": "string", "enum": ["AGE", "BEHAVIOR", "BROAD_KEYWORD", "CONVERSATION", "DEVICE", "EVENT", "FOLLOWERS_OF_USER", "GENDER", "INTEREST", "KEYWORD", "LANGUAGE", "LOCATION", "NETWORK_OPERATOR", "PLATFORM", "PLATFORM_VERSION", "SIMILAR_TO_FOLLOWERS_OF_USER", "TV_SHOW", "WIFI_ONLY"], "description": "Type of targeting" },
                  "targeting_value": { "type": "string", "description": "Targeting value (e.g., location ID, interest ID)" },
                  "operator_type": { "type": "string", "enum": ["EQ", "NE", "GTE", "LTE"], "description": "Operator for targeting comparison" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/TargetingCriteriaResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/targeting_criteria/{targeting_criteria_id}": {
      "get": {
        "operationId": "getTargetingCriteria",
        "summary": "Retrieve specific targeting criteria",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "targeting_criteria_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
