                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "total_audience_reach": { "type": "integer" },
                          "average_frequency": { "type": "number", "format": "double" }
                        }
                      }
                    },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
