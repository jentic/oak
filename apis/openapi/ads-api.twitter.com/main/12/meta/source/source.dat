        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "card_ids", "in": "query", "schema": { "type": "string" } },
          { "name": "card_types", "in": "query", "schema": { "type": "string" } },
          { "name": "card_uris", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "include_legacy_cards", "in": "query", "schema": { "type": "boolean" } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CardListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createCard",
        "summary": "Create a card (website card, app card, etc.)",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "components"],
                "properties": {
                  "name": { "type": "string", "description": "Card name" },
                  "components": {
                    "type": "array",
                    "description": "Card components array defining the card layout and content",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": { "type": "string", "description": "Component type (e.g., MEDIA, DETAILS, BUTTON)" },
                        "media_key": { "type": "string" },
                        "title": { "type": "string" },
                        "destination": {
                          "type": "object",
                          "properties": {
                            "type": { "type": "string" },
                            "url": { "type": "string" }
                          }
                        }
                      }
                    }
                  },
                  "slides": {
                    "type": "array",
                    "description": "Carousel card slides",
                    "items": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/CardResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/cards/{card_id}": {
      "get": {
        "operationId": "getCard",
        "summary": "Retrieve a specific card",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "card_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CardResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "operationId": "updateCard",
        "summary": "Update a card",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "card_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "components": { "type": "array", "items": { "type": "object" } },
                  "slides": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/CardResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteCard",
        "summary": "Delete a card",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "card_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/CardResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/media_library": {
      "get": {
        "operationId": "listMediaLibrary",
        "summary": "List media library assets",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "media_keys", "in": "query", "schema": { "type": "string" } },
          { "name": "media_type", "in": "query", "schema": { "type": "string", "enum": ["IMAGE", "VIDEO", "GIF"] } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/MediaLibraryListResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createMediaLibraryAsset",
        "summary": "Add media to the media library",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["media_key"],
                "properties": {
                  "media_key": { "type": "string", "description": "Media key from media upload" },
                  "file_name": { "type": "string" },
                  "name": { "type": "string" },
                  "media_category": { "type": "string", "enum": ["TWEET_IMAGE", "TWEET_GIF", "TWEET_VIDEO", "AMPLIFY_VIDEO"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/MediaLibraryResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/media_creatives": {
      "get": {
        "operationId": "listMediaCreatives",
        "summary": "List media creatives for an account",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "media_creative_ids", "in": "query", "schema": { "type": "string" } },
          { "name": "line_item_ids", "in": "query", "schema": { "type": "string" } },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of media creatives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/MediaCreative" }
                    },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createMediaCreative",
        "summary": "Create a media creative",
        "tags": ["Media"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["line_item_id", "account_media_id"],
                "properties": {
                  "line_item_id": { "type": "string", "description": "Line item to associate with" },
                  "account_media_id": { "type": "string", "description": "Account media ID" },
                  "landing_url": { "type": "string", "description": "Click-through URL" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created media creative",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/MediaCreative" },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/tweet": {
      "post": {
        "operationId": "createTweet",
        "summary": "Create a tweet (including promoted-only tweets)",
        "tags": ["Promoted Tweets"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "description": "Tweet text content" },
                  "as_user_id": { "type": "string", "description": "User ID to tweet as" },
                  "card_uri": { "type": "string", "description": "Card URI to attach" },
                  "media_ids": { "type": "string", "description": "Comma-separated media IDs" },
                  "nullcast": { "type": "boolean", "description": "If true, creates a promoted-only tweet" },
                  "trim_user": { "type": "boolean" },
                  "video_cta": { "type": "string" },
                  "video_cta_value": { "type": "string" },
                  "video_title": { "type": "string" },
                  "video_description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created tweet",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "id_str": { "type": "string" },
                        "text": { "type": "string" },
                        "created_at": { "type": "string" },
                        "user": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/promotable_users": {
      "get": {
        "operationId": "listPromotableUsers",
        "summary": "List promotable users for an account",
        "tags": ["Accounts"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "with_deleted", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } }
        ],
        "responses": {
          "200": {
            "description": "List of promotable users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "user_id": { "type": "string" },
                          "promotable_user_type": { "type": "string" },
                          "created_at": { "type": "string", "format": "date-time" },
                          "updated_at": { "type": "string", "format": "date-time" },
                          "deleted": { "type": "boolean" }
                        }
                      }
                    },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/scoped_timeline": {
      "get": {
        "operationId": "getScopedTimeline",
        "summary": "Retrieve tweets scoped to an ad account (including promoted-only)",
        "tags": ["Promoted Tweets"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "tweet_ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated tweet IDs" },
          { "name": "user_id", "in": "query", "schema": { "type": "string" } },
          { "name": "tweet_type", "in": "query", "schema": { "type": "string", "enum": ["PUBLISHED", "SCHEDULED", "DRAFT"] } },
          { "name": "timeline_type", "in": "query", "schema": { "type": "string" } },
          { "name": "trim_user", "in": "query", "schema": { "type": "boolean" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of tweets",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/batch/accounts/{account_id}/targeting_criteria": {
      "post": {
        "operationId": "batchCreateTargetingCriteria",
        "summary": "Batch create targeting criteria",
        "tags": ["Targeting"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["operation_type", "params"],
                  "properties": {
                    "operation_type": { "type": "string", "enum": ["Create", "Delete"] },
                    "params": {
                      "type": "object",
                      "properties": {
                        "line_item_id": { "type": "string" },
                        "targeting_type": { "type": "string" },
                        "targeting_value": { "type": "string" },
                        "operator_type": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch targeting results",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/insights/keywords/search": {
      "get": {
        "operationId": "searchKeywordInsights",
        "summary": "Search keyword insights and tweet volume",
        "tags": ["Analytics"],
        "parameters": [
          { "name": "keywords", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Comma-separated keywords to analyze" },
          { "name": "start_time", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "granularity", "in": "query", "required": true, "schema": { "type": "string", "enum": ["DAY", "HOUR"] } },
          { "name": "location", "in": "query", "schema": { "type": "string" }, "description": "Location filter" },
          { "name": "negative_keywords", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Keyword insights data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "related_keywords": { "type": "array", "items": { "type": "string" } },
                          "tweet_volume": { "type": "array", "items": { "type": "integer" } }
                        }
                      }
                    },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/line_items/placements": {
      "get": {
        "operationId": "listPlacementOptions",
        "summary": "List valid placement options by product type and objective",
        "tags": ["Line Items"],
        "parameters": [
          { "name": "product_type", "in": "query", "schema": { "type": "string" } },
          { "name": "objective", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Valid placement combinations",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/custom_audiences/{custom_audience_id}/permissions": {
      "get": {
        "operationId": "listCustomAudiencePermissions",
        "summary": "List permissions for a custom audience",
        "tags": ["Audiences"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "custom_audience_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "granted_account_ids", "in": "query", "schema": { "type": "string" } },
          { "name": "custom_audience_permission_ids", "in": "query", "schema": { "type": "string" } },
          { "name": "with_total_count", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "sort_by", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of audience permissions",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createCustomAudiencePermission",
        "summary": "Grant permission on a custom audience to another account",
        "tags": ["Audiences"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "custom_audience_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["granted_account_id", "permission_level"],
                "properties": {
                  "granted_account_id": { "type": "string", "description": "Account ID to grant access to" },
                  "permission_level": { "type": "string", "enum": ["READ_ONLY", "READ_WRITE"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created permission",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}/custom_audiences/{custom_audience_id}/permissions/{permission_id}": {
      "delete": {
        "operationId": "deleteCustomAudiencePermission",
        "summary": "Revoke a custom audience permission",
        "tags": ["Audiences"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "custom_audience_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "permission_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Deleted permission",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth1": {
        "type": "http",
        "scheme": "OAuth",
        "description": "OAuth 1.0a authentication. Requires consumer key, consumer secret, access token, and access token secret. All requests must be signed using HMAC-SHA1."
      }
    },
    "parameters": {
      "AccountId": {
        "name": "account_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "The identifier for the leveraged account"
      },
      "CampaignId": {
        "name": "campaign_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "The identifier for the campaign"
      },
      "LineItemId": {
        "name": "line_item_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "The identifier for the line item"
      }
    },
    "schemas": {
      "Campaign": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Campaign ID" },
          "name": { "type": "string" },
          "account_id": { "type": "string" },
          "funding_instrument_id": { "type": "string" },
          "daily_budget_amount_local_micro": { "type": "integer", "format": "int64" },
          "total_budget_amount_local_micro": { "type": "integer", "format": "int64" },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "entity_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DRAFT"] },
          "standard_delivery": { "type": "boolean" },
          "servable": { "type": "boolean" },
          "reasons_not_servable": { "type": "array", "items": { "type": "string" } },
          "currency": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "deleted": { "type": "boolean" }
        }
      },
      "LineItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "account_id": { "type": "string" },
          "campaign_id": { "type": "string" },
          "bid_amount_local_micro": { "type": "integer", "format": "int64" },
          "bid_type": { "type": "string", "enum": ["AUTO", "MAX", "TARGET"] },
          "product_type": { "type": "string" },
          "objective": { "type": "string" },
