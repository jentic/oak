                    "video_views_75": { "type": "array", "items": { "type": "integer" } },
                    "video_views_100": { "type": "array", "items": { "type": "integer" } },
                    "video_cta_clicks": { "type": "array", "items": { "type": "integer" } },
                    "video_content_starts": { "type": "array", "items": { "type": "integer" } },
                    "video_mrc_views": { "type": "array", "items": { "type": "integer" } },
                    "media_views": { "type": "array", "items": { "type": "integer" } },
                    "media_engagements": { "type": "array", "items": { "type": "integer" } }
                  }
                }
              }
            }
          }
        }
