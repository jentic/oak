    "/stats/accounts/{account_id}": {
      "get": {
        "operationId": "getSynchronousAnalytics",
        "summary": "Retrieve synchronous analytics for an account",
        "description": "Retrieve real-time analytics with a maximum 7-day range for campaigns, line items, promoted tweets, and other entities.",
        "tags": ["Analytics"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "entity", "in": "query", "required": true, "schema": { "type": "string", "enum": ["ACCOUNT", "CAMPAIGN", "FUNDING_INSTRUMENT", "LINE_ITEM", "ORGANIC_TWEET", "PROMOTED_ACCOUNT", "PROMOTED_TWEET", "MEDIA_CREATIVE"] }, "description": "Entity type" },
          { "name": "entity_ids", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Comma-separated entity IDs (max 20)" },
          { "name": "start_time", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" }, "description": "Start time (ISO 8601, whole hours)" },
          { "name": "end_time", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" }, "description": "End time (ISO 8601, whole hours)" },
          { "name": "granularity", "in": "query", "required": true, "schema": { "type": "string", "enum": ["DAY", "HOUR", "TOTAL"] }, "description": "Data granularity" },
          { "name": "metric_groups", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Comma-separated metric groups: BILLING, ENGAGEMENT, LIFE_TIME_VALUE_MOBILE_CONVERSION, MEDIA, MOBILE_CONVERSION, VIDEO, WEB_CONVERSION" },
          { "name": "placement", "in": "query", "required": true, "schema": { "type": "string", "enum": ["ALL_ON_TWITTER", "PUBLISHER_NETWORK"] }, "description": "Ad placement filter" }
        ],
        "responses": {
          "200": {
            "description": "Analytics data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AnalyticsData" }
                    },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/stats/jobs/accounts/{account_id}": {
      "get": {
        "operationId": "listAsyncAnalyticsJobs",
        "summary": "List asynchronous analytics jobs",
        "tags": ["Analytics"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "job_ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated job IDs (max 200)" },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of analytics jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AnalyticsJob" }
                    },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createAsyncAnalyticsJob",
        "summary": "Create an asynchronous analytics job",
        "description": "Create an async analytics job supporting up to 90-day ranges with segmentation capabilities.",
        "tags": ["Analytics"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["entity", "entity_ids", "start_time", "end_time", "granularity", "metric_groups", "placement"],
                "properties": {
                  "entity": { "type": "string", "enum": ["ACCOUNT", "CAMPAIGN", "FUNDING_INSTRUMENT", "LINE_ITEM", "ORGANIC_TWEET", "PROMOTED_ACCOUNT", "PROMOTED_TWEET", "MEDIA_CREATIVE"] },
                  "entity_ids": { "type": "string", "description": "Comma-separated entity IDs (max 20)" },
                  "start_time": { "type": "string", "format": "date-time" },
                  "end_time": { "type": "string", "format": "date-time" },
                  "granularity": { "type": "string", "enum": ["DAY", "HOUR", "TOTAL"] },
                  "metric_groups": { "type": "string" },
                  "placement": { "type": "string", "enum": ["ALL_ON_TWITTER", "PUBLISHER_NETWORK"] },
                  "segmentation_type": { "type": "string", "enum": ["AGE", "GENDER", "LOCATIONS", "INTERESTS", "KEYWORDS", "PLATFORMS", "PLATFORM_VERSIONS", "DEVICES", "CITIES", "REGIONS", "POSTAL_CODES", "METROS", "CONVERSATIONS", "MEDIA_CREATIVES", "SIMILAR_TO_FOLLOWERS_OF_USER", "EVENTS"], "description": "Optional segmentation dimension" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created analytics job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/AnalyticsJob" },
                    "request": { "$ref": "#/components/schemas/RequestInfo" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/stats/accounts/{account_id}/reach/campaigns": {
      "get": {
        "operationId": "getCampaignReach",
        "summary": "Retrieve campaign reach and frequency metrics",
        "tags": ["Analytics"],
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          { "name": "campaign_ids", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Comma-separated campaign IDs" },
          { "name": "start_time", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "end_time", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
