{
  "openapi": "3.0.3",
  "info": {
    "title": "Bureau of Labor Statistics Public Data API",
    "description": "Access employment, price index, compensation, and other labor statistics data from the U.S. Bureau of Labor Statistics. Version 2 requires an API key and offers higher daily query limits, multiple series requests, calculations, and annual averages.",
    "version": "2.0.0",
    "contact": {
      "name": "Bureau of Labor Statistics",
      "url": "https://www.bls.gov/developers/"
    },
    "x-jentic-source-url": "https://www.bls.gov/developers/"
  },
  "x-jentic-provenance": "jentic-generated",
  "servers": [
    {
      "url": "https://api.bls.gov/publicAPI/v2",
      "description": "BLS Public Data API v2"
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    }
  ],
  "paths": {
    "/timeseries/data/": {
      "post": {
        "operationId": "getMultipleTimeseries",
        "summary": "Retrieve data for one or more time series",
        "description": "Returns data for one or more BLS time series. Supports date ranges, calculations, annual averages, and optional catalog metadata. V2 allows up to 50 series per request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "seriesid",
                  "registrationkey"
                ],
                "properties": {
                  "seriesid": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Array of BLS series IDs (max 50 for v2)",
                    "example": [
                      "CUUR0000SA0",
                      "SUUR0000SA0"
                    ]
                  },
                  "startyear": {
                    "type": "string",
                    "description": "Start year for data retrieval (4-digit year)",
                    "example": "2020"
                  },
                  "endyear": {
                    "type": "string",
                    "description": "End year for data retrieval (4-digit year)",
                    "example": "2024"
                  },
                  "catalog": {
                    "type": "boolean",
                    "description": "Include catalog metadata in response (v2 only)",
                    "default": false
                  },
                  "calculations": {
                    "type": "boolean",
                    "description": "Include net and percent change calculations (v2 only)",
                    "default": false
                  },
                  "annualaverage": {
                    "type": "boolean",
                    "description": "Include annual average values (v2 only)",
                    "default": false
                  },
                  "aspects": {
                    "type": "boolean",
                    "description": "Include footnotes and aspects (v2 only)",
                    "default": false
                  },
                  "registrationkey": {
                    "type": "string",
                    "description": "API registration key for v2 access"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with time series data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeseriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or missing registration key"
          },
          "429": {
            "description": "Too many requests - daily query limit exceeded"
          }
        }
      }
    },
    "/timeseries/data/{seriesId}": {
      "get": {
        "operationId": "getSingleTimeseries",
        "summary": "Retrieve data for a single time series",
        "description": "Returns data for a single BLS time series by its series ID using a GET request.",
        "parameters": [
          {
            "name": "seriesId",
            "in": "path",
            "required": true,
            "description": "BLS time series identifier",
            "schema": {
              "type": "string"
            },
            "example": "CUUR0000SA0"
          },
          {
            "name": "registrationkey",
            "in": "query",
            "required": true,
            "description": "API registration key",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startyear",
            "in": "query",
            "required": false,
            "description": "Start year (4-digit)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endyear",
            "in": "query",
            "required": false,
            "description": "End year (4-digit)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with time series data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeseriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/timeseries/popular": {
      "get": {
        "operationId": "getPopularSeries",
        "summary": "Retrieve popular time series",
        "description": "Returns a list of popular BLS time series including CPI, unemployment rate, and other commonly requested data.",
        "parameters": [
          {
            "name": "registrationkey",
            "in": "query",
            "required": true,
            "description": "API registration key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with popular series list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "responseTime": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "Results": {
                      "type": "object",
                      "properties": {
                        "series": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/SeriesSummary"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/surveys": {
      "get": {
        "operationId": "getSurveys",
        "summary": "List available BLS surveys",
        "description": "Returns a list of all BLS surveys and their identifiers that can be used to look up time series.",
        "parameters": [
          {
            "name": "registrationkey",
            "in": "query",
            "required": true,
            "description": "API registration key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of surveys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "responseTime": {
                      "type": "integer"
                    },
                    "Results": {
                      "type": "object",
                      "properties": {
                        "survey": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "survey_name": {
                                "type": "string"
                              },
                              "survey_abbreviation": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timeseries/data/{seriesId}/latest": {
      "get": {
        "operationId": "getLatestTimeseries",
        "summary": "Retrieve latest observation for a time series",
        "description": "Returns the most recent data point for the specified BLS time series.",
        "parameters": [
          {
            "name": "seriesId",
            "in": "path",
            "required": true,
            "description": "BLS time series identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "registrationkey",
            "in": "query",
            "required": true,
            "description": "API registration key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with latest data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeseriesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "query",
        "name": "registrationkey",
        "description": "BLS API v2 registration key. Register at https://data.bls.gov/registrationEngine/"
      }
    },
    "schemas": {
      "TimeseriesResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "REQUEST_SUCCEEDED",
              "REQUEST_FAILED",
              "REQUEST_NOT_PROCESSED"
            ]
          },
          "responseTime": {
            "type": "integer",
            "description": "Response time in milliseconds"
          },
          "message": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Results": {
            "type": "object",
            "properties": {
              "series": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            }
          }
        }
      },
      "Series": {
        "type": "object",
        "properties": {
          "seriesID": {
            "type": "string"
          },
          "catalog": {
            "type": "object",
            "properties": {
              "series_title": {
                "type": "string"
              },
              "series_id": {
                "type": "string"
              },
              "seasonality": {
                "type": "string"
              },
              "survey_name": {
                "type": "string"
              },
              "survey_abbreviation": {
                "type": "string"
              },
              "measure_data_type": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "item": {
                "type": "string"
              }
            }
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataPoint"
            }
          }
        }
      },
      "DataPoint": {
        "type": "object",
        "properties": {
          "year": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "periodName": {
            "type": "string"
          },
          "latest": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "footnotes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "calculations": {
            "type": "object",
            "properties": {
              "net_changes": {
                "type": "object",
                "properties": {
                  "1": {
                    "type": "string"
                  },
                  "3": {
                    "type": "string"
                  },
                  "6": {
                    "type": "string"
                  },
                  "12": {
                    "type": "string"
                  }
                }
              },
              "pct_changes": {
                "type": "object",
                "properties": {
                  "1": {
                    "type": "string"
                  },
                  "3": {
                    "type": "string"
                  },
                  "6": {
                    "type": "string"
                  },
                  "12": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "SeriesSummary": {
        "type": "object",
        "properties": {
          "seriesID": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "survey_name": {
            "type": "string"
          }
        }
      }
    }
  }
}
