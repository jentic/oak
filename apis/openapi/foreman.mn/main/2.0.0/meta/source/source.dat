{
  "openapi": "3.0.2",
  "info": {
    "title": "Foreman API",
    "description": "The following documentation captures the majority of the user-facing endpoints exposed via the Foreman API. Token-based authentication is required and the necessary Client ID and API Key can be obtained from your dashboard [here](https://dashboard.foreman.mn/dashboard/profile/).",
    "version": "2.0.0",
    "contact": {
      "url": "https://support.foreman.mn/hc/en-us"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/foremanmining/foreman-api/2.0.0"
  },
  "servers": [
    {
      "url": "https://api.foreman.mn/api/v2"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "ping",
      "description": "Test endpoint for validating connectivity and authentication tokens."
    },
    {
      "name": "system",
      "description": "For obtaining system-related information (supported miners, models, etc)."
    },
    {
      "name": "firmware",
      "description": "Returns information related to firmware available in the system."
    },
    {
      "name": "tags",
      "description": "For assigning and managing miner tags."
    },
    {
      "name": "clients",
      "description": "Endpoints for obtaining client-related information."
    },
    {
      "name": "groups",
      "description": "Obtains client group information."
    },
    {
      "name": "miners",
      "description": "Obtains miner-related information."
    },
    {
      "name": "logs",
      "description": "Obtains the currently stored logs."
    },
    {
      "name": "pickaxes",
      "description": "Obtains pickaxe-related information."
    },
    {
      "name": "site-map",
      "description": "Endpoints for obtaining Site Map-related information (group IDs, rack IDs, etc)."
    },
    {
      "name": "actions",
      "description": "Run actions against miners."
    },
    {
      "name": "reports",
      "description": "Create and retrieve CSV reports."
    },
    {
      "name": "curtailment",
      "description": "Reduce site power draw in a controlled manner."
    },
    {
      "name": "custom",
      "description": "Obtain and change custom information for miner(s)"
    },
    {
      "name": "dispatches",
      "description": "Anything regarding dispatching for curtailment"
    },
    {
      "name": "fiat",
      "description": "Fiat conversion-related info."
    },
    {
      "name": "voltus",
      "description": "Endpoints for processing dispatches from Voltus."
    },
    {
      "name": "cpower",
      "description": "Endpoints for processing dispatches from CPower."
    },
    {
      "name": "csd",
      "description": "Endpoints for processing dispatches from CSD."
    },
    {
      "name": "qse",
      "description": "Endpoints for integrating with QSEs."
    },
    {
      "name": "pool-keys",
      "description": "Obtains pool authentication info."
    },
    {
      "name": "hive",
      "description": "HiveOS integration-related endpoints."
    },
    {
      "name": "tickets",
      "description": "Anything regarding tickets"
    },
    {
      "name": "assets",
      "description": "Anything regarding assets"
    },
    {
      "name": "inventory",
      "description": "Anything regarding inventory"
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "summary": "Verifies connectivity. Not authenticated.",
        "security": [],
        "tags": [
          "ping"
        ],
        "description": "Verifies that the API is responsive.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ping"
                }
              }
            }
          }
        }
      }
    },
    "/ping/{clientId}": {
      "get": {
        "summary": "Verifies connectivity. Authenticated.",
        "tags": [
          "ping"
        ],
        "description": "Verifies that the API is responsive and that the provided crendentials are correct.",
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ping"
                }
              }
            }
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this client."
          }
        }
      }
    },
    "/actions/status/{commandId}": {
      "get": {
        "summary": "Obtains the status of a command.",
        "tags": [
          "actions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "commandId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "The Command ID."
          }
        ],
        "description": "Obtains the status of an existing command. Commands can be in progress or completed.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandStatus"
                }
              }
            }
          },
          "403": {
            "description": "User doesn't have access to this miner."
          },
          "404": {
            "description": "Miner doesn't exist."
          }
        }
      }
    },
    "/actions/reboot/{minerId}": {
      "post": {
        "summary": "Reboots the miner.",
        "tags": [
          "actions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "description": "Changes the miner. Currently only ASIC support.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Request was malformed."
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner doesn't exist."
          }
        }
      }
    },
    "/actions/change-pools/{minerId}": {
      "post": {
        "summary": "Changes mining pools.",
        "tags": [
          "actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/changePools"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "description": "Changes the pools of a miner. Currently only ASIC support.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner not found or bad request."
          }
        }
      }
    },
    "/actions/change-pools/bulk/{clientId}": {
      "post": {
        "summary": "Bulk change mining pools for multiple miners.",
        "tags": [
          "actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/bulkChangePools"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          }
        ],
        "description": "Perform multiple bulk change pools on different group of miners",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bulkCommandAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Client not found or provided"
          },
          "401": {
            "description": "No credentials provided."
          }
        }
      }
    },
    "/actions/network/{minerId}": {
      "post": {
        "summary": "Apply a static IP configuration.",
        "tags": [
          "actions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/networkConfig"
              }
            }
          }
        },
        "description": "Changes the network configuration of a miner. Currently only ASIC support.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner not found or bad request."
          },
          "409": {
            "description": "Miner already exists using this IP."
          }
        }
      }
    },
    "/actions/power-mode/{minerId}": {
      "post": {
        "summary": "Change the power mode.",
        "description": "Changes the power mode of a miner.  Currently only ASIC support.\n\nNote: some modes may only be available to certain miner models and manufacturers.\n",
        "tags": [
          "actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/powerMode"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Request was malformed."
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner doesn't exist."
          }
        }
      }
    },
    "/actions/change-password/{minerId}": {
      "post": {
        "summary": "Change the miner password.",
        "tags": [
          "actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/passwords"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "description": "Changes the password of a miner. Currently only ASIC support.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Request was malformed."
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner doesn't exist."
          }
        }
      }
    },
    "/actions/blink/{minerId}": {
      "post": {
        "summary": "Blink the miner's LEDs.",
        "tags": [
          "actions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/blink"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "description": "Blinks the LEDs on a miner. Currently only ASIC support.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Request was malformed."
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner doesn't exist."
          }
        }
      }
    },
    "/actions/fetch-miner-logs/{minerId}": {
      "post": {
        "summary": "Initiates the fetch of a miner log.",
        "tags": [
          "actions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "description": "Fetches the miner logs.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Request was malformed."
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner doesn't exist."
          }
        }
      }
    },
    "/actions/vnish-overclock/{minerId}": {
      "post": {
        "summary": "Endpoint to overclock vnish firmware.",
        "tags": [
          "actions"
        ],
        "requestBody": {
          "required": true,
          "description": "The request body would contain either the profile or the frequency and voltage, not all three",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/vnishOverclock"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "description": "Endpoint to overclock vnish firmware. * must have proper permission to use endpoint *",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/commandAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Request was malformed."
          },
          "401": {
            "description": "No credentials provided."
          },
          "403": {
            "description": "User doesn't have access to this miner or isn't allowed to run this command."
          },
          "404": {
            "description": "Miner doesn't exist."
          }
        }
      }
    },
    "/custom-field/{clientId}": {
      "get": {
        "summary": "Get all miners and custom field information",
        "tags": [
          "custom"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          }
        ],
        "description": "Get all miners and custom field information",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customField"
                }
              }
            }
          }
        }
      }
    },
    "/custom-field/{clientId}/{minerId}": {
      "get": {
        "summary": "Get all of a single miners custom field information",
        "tags": [
          "custom"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          },
          {
            "$ref": "#/components/parameters/minerIdPath"
          }
        ],
        "description": "Get all of a single miners custom field information",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customField"
                }
              }
            }
          }
        }
      }
    },
    "/custom-field/{clientId}/{customField}": {
      "get": {
        "summary": "Get specific custom field information for all miners",
        "tags": [
          "custom"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          },
          {
            "$ref": "#/components/parameters/customField"
          }
        ],
        "description": "Get specific custom field information for all miners",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customField"
                }
              }
            }
          }
        }
      }
    },
    "/custom-field/{clientId}/{minerId}/{customField}": {
      "get": {
        "summary": "Get specific custom field information for a specific miners",
        "tags": [
          "custom"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          },
          {
            "$ref": "#/components/parameters/minerIdPath"
          },
          {
            "$ref": "#/components/parameters/customField"
          }
        ],
        "description": "Get specific custom field information for a specific miners",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customField"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Adds a custom field value to a specific miner",
        "tags": [
          "custom"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          },
          {
            "$ref": "#/components/parameters/minerIdPath"
          },
          {
            "$ref": "#/components/parameters/customField"
          }
        ],
        "description": "Adds a custom field value to a specific miner",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "example": "Example value"
                  }
                },
                "required": [
                  "value"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/curtailment/{clientId}/once": {
      "post": {
        "summary": "Creates a single-fire curtailment.",
        "tags": [
          "curtailment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/curtailmentScheduledPlan"
              },
              "examples": {
                "withoutFiltering": {
                  "$ref": "#/components/examples/withoutFiltering"
                },
                "withoutFilteringPhaseBalanced": {
                  "$ref": "#/components/examples/withoutFilteringPhaseBalanced"
                },
                "filterByPickaxe": {
                  "$ref": "#/components/examples/filterByPickaxe"
                },
                "filterByIpRange": {
                  "$ref": "#/components/examples/filterByIpRange"
                },
                "filterByTags": {
                  "$ref": "#/components/examples/filterByTags"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          }
        ],
        "description": "Creates a single-fire curtailment.  This is intended to be the mechanism to connect the system to a utility signal.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/curtailmentScheduled"
                }
              }
            }
          },
          "403": {
            "description": "User doesn't have access to this client or the user doesn't have permission to run instant curtailments."
          },
          "404": {
            "description": "Client doesn't exist."
          }
        }
      }
    },
    "/curtailment/{clientId}/plans": {
      "get": {
        "summary": "Returns all of the curtailment plans for the provided client.",
        "tags": [
          "curtailment"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          }
        ],
        "description": "Returns all of the curtailment plans for the provided client.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/curtailmentScheduledPlans"
                }
              }
            }
          },
          "403": {
            "description": "User doesn't have access to this client."
          },
          "404": {
            "description": "Client doesn't exist."
          }
        }
      },
      "post": {
        "summary": "Creates a new curtailment plan.",
        "tags": [
          "curtailment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/curtailmentScheduledPlan"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/clientIdPath"
          }
        ],
        "description": "Creates a new curtailment plan.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/curtailmentPlanCreated"
                }
              }
            }
          },
          "403": {
            "description": "User doesn't have access to this client or the user doesn't have permission to create new plans."
          },
          "404": {
            "description": "Client doesn't exist."
          }
        }
      }
    },
    "/curtailment/plans/{planId}": {
      "post": {
        "summary": "Edits an existing curtailment plan.",
        "tags": [
          "curtailment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/curtailmentScheduledPlan"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "planId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "The curtailment plan ID."
          }
        ],
        "description": "Edits an existing curtailment plan.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/curtailmentPlanCreated"
                }
              }
            }
          },
          "403": {
            "description": "User doesn't have access to this client or the user doesn't have permission to edit plans."
          },
          "404": {
            "description": "Plan doesn't exist."
          }
        }
      },
      "delete": {
        "summary": "Deletes an existing curtailment plan.",
        "tags": [
          "curtailment"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "planId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "The curtailment plan ID."
          }
        ],
        "description": "Deletes an existing curtailment plan.",
        "responses": {
          "200": {
            "description": "Deleted."
          },
          "403": {
            "description": "User doesn't have access to this client or the user doesn't have permission to delete plans."
          },
          "404": {
            "description": "Plan doesn't exist."
          }
        }
      }
    },
    "/curtailment/plans/{planId}/run": {
      "post": {
        "summary": "Runs an existing curtailment plan.",
        "tags": [
          "curtailment"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "planId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "The curtailment plan ID."
          }
