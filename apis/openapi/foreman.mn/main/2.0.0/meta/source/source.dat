            "description": "The unique Pickaxe UUID.",
            "example": "02361878-5fa3-42e6-9cb2-db386d2dad99"
          },
          "version": {
            "type": "string",
            "description": "The Pickaxe version.",
            "example": "3.100.0"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "When Pickaxe last queried the dashboard.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "hostname": {
            "type": "string",
            "description": "The hostname running the agent.",
            "example": "dans-desktop"
          },
          "ip": {
            "type": "string",
            "description": "The IP running the agent.",
            "example": "96.244.57.42"
          },
          "config": {
            "$ref": "#/components/schemas/pickaxeConfig"
          }
        }
      },
      "pickaxeConfig": {
        "type": "object",
        "properties": {
          "readSocketTimeout": {
            "type": "number",
            "description": "The read socket timeout.",
            "example": 1
          },
          "readSocketTimeoutUnits": {
            "type": "string",
            "enum": [
              "SECONDS"
            ],
            "description": "The read socket timeout (units)."
          },
          "writeSocketTimeout": {
            "type": "number",
            "description": "The write socket timeout.",
            "example": 1
          },
          "writeSocketTimeoutUnits": {
            "type": "string",
            "enum": [
              "SECONDS"
            ],
            "description": "The write socket timeout (units)."
          },
          "commandCompletionBatchSize": {
            "type": "number",
            "description": "How many commands completions to bundle together before POSTing.",
            "example": 500
          },
          "commandThreadsOverride": {
            "type": "number",
            "description": "The number of threads to use for running commands.",
            "example": 500
          },
          "statsThreadsOverride": {
            "type": "number",
            "description": "The number of threads to use for querying for metrics.",
            "example": 500
          },
          "metricsThreadsOverride": {
            "type": "number",
            "description": "The number of threads to use for publishing metrics.",
            "example": 500
          },
          "collectDelay": {
            "type": "number",
            "description": "How long to wait between metrics collection iterations.",
            "example": 30
          },
          "collectDelayUnits": {
            "type": "string",
            "enum": [
              "SECONDS"
            ],
            "description": "How long to wait between metrics collection iterations (units)."
          },
          "metricsPushDelay": {
            "type": "number",
            "description": "How long to wait between metrics pushes to the Foreman API.",
            "example": 60
          },
          "metricsPushDelayUnits": {
            "type": "string",
            "enum": [
              "SECONDS",
              "MINUTES"
            ],
            "description": "How long to wait between metrics pushed to the Foreman API."
          }
        }
      },
