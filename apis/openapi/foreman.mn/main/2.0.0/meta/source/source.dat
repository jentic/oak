      "curtailmentRun": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "number",
            "description": "The plan ID.",
            "example": 102
          },
          "submitter": {
            "type": "string",
            "description": "The submitter's email.",
            "example": "contact@obm.io"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the run was created.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "predictedEnd": {
            "type": "string",
            "format": "date-time",
            "description": "When the run is expected to end.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "minerIds": {
            "type": "array",
            "items": {
              "type": "number",
              "description": "The miner IDs that were modified."
            },
            "example": [
              123,
              456
            ]
          },
          "isRevert": {
            "type": "boolean",
            "description": "Whether a revert.",
            "example": false
          },
          "reason": {
            "type": "string",
            "enum": [
              "manual",
              "4cp",
              "clr",
              "strike",
              "csp"
            ],
            "example": "4cp"
          }
        }
      },
      "curtailmentRunStatus": {
        "type": "object",
        "properties": {
          "progress": {
            "type": "number",
            "format": "double",
