            "example": "Normal",
            "description": "The Priority of a Ticket"
          },
          "owners": {
            "type": "string",
            "example": "Unassigned",
            "description": "The Assigned Owners of a Ticket"
          },
          "lastUpdated": {
            "type": "string",
            "example": "2024-06-17T14:44:15.561495Z",
            "description": "The Last Time a Ticket was Updated"
          },
          "created": {
            "type": "string",
            "example": "2024-06-17T14:44:15.561495Z",
            "description": "The Creation Date of a Ticket"
          },
