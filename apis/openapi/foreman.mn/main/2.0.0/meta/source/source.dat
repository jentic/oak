            ]
          },
          "owner": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "description": "The owning client ID.",
                "example": 1
              },
              "label": {
                "type": "string",
                "description": "The owning client's name.",
                "example": "Consultant Company"
              }
            }
          }
        }
      },
      "client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The client ID.",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "The client name.",
            "example": "My Company Name"
          },
          "type": {
            "type": "string",
            "description": "The client type.",
            "enum": [
              "private",
              "colo"
            ],
            "example": "private"
          },
          "owner": {
            "type": "string",
            "description": "The client owner.",
            "example": "dan@obm.mn"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When the client was created.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "powerCost": {
            "$ref": "#/components/schemas/powerCost"
          },
          "group": {
            "type": "number",
            "description": "The group ID that the client belongs to.",
            "example": 1
          },
          "hashRate": {
            "type": "number",
            "description": "The client's aggregated hash rate (Hs).",
            "example": 123456789
          },
          "miners": {
            "type": "object",
            "properties": {
              "total": {
                "type": "number",
                "description": "The total number of miners.",
                "example": 7002
              },
              "online": {
                "type": "number",
                "description": "The number of miners online.",
                "example": 6987
              },
              "offline": {
                "type": "number",
                "description": "The number of miners offline.",
                "example": 5
              },
              "pending": {
                "type": "number",
                "description": "The number of miners that have yet to be seen.",
                "example": 0
              },
              "disabled": {
                "type": "number",
                "description": "The number of miners disabled.",
                "example": 10
              }
            }
          },
          "powerDraw": {
            "type": "number",
            "description": "The total power consumption (W).",
            "example": 4656
          },
          "curtailmentOptIn": {
            "type": "boolean",
            "description": "Whether the client is accepting curtailments.",
            "example": true
          },
          "strike": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "description": "The price source.",
                "example": "ppm-lz-west"
              },
              "price": {
                "type": "number",
                "description": "The strike price.",
                "example": 100
              },
              "curtailAfter": {
                "type": "number",
                "description": "The number of windows where pricing must clear above the strike before being curtailed.",
                "example": 1
              },
              "resumeAfter": {
                "type": "number",
                "description": "The number of windows where pricing must clear below the strike before being ramped back up.",
                "example": 3
              }
            }
          }
        }
      },
      "powerCost": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number",
            "description": "The cost per kWh.",
            "example": 0.05
          },
          "currency": {
            "type": "string",
            "description": "The cost per kWh currency.",
            "example": "USD"
          }
        }
