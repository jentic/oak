              "pending": {
                "type": "integer",
                "description": "The number of commands that are pending.",
                "example": 0
              },
              "inProgress": {
                "type": "integer",
                "description": "The number of commands that are in-progress.",
                "example": 0
              },
              "success": {
                "type": "integer",
                "description": "The number of commands that were successfully ran.",
                "example": 5
              },
              "failed": {
                "type": "integer",
                "description": "The number of commands that failed to run.",
                "example": 1
              },
              "complete": {
                "type": "integer",
                "description": "The number of commands that are finished.",
                "example": 6
              },
              "total": {
                "type": "integer",
                "description": "The total number of commands.",
                "example": 6
              }
            }
          },
          "minerIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "description": "The miners that were curtailed."
            },
            "example": [
              417411,
              133481,
              776115,
              89134,
              447134
            ]
          }
        }
      },
