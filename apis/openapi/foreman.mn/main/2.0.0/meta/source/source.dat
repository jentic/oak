            "type": "string",
            "example": "Description of a Ticket",
            "description": "The added description of a Ticket"
          },
          "attachedDevices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/attachedDevices"
            },
            "description": "The devices and inventory attached to a Ticket (inventory, miner, assets, infrastructure, etc)"
          },
          "customValues": {
            "type": "string",
            "description": "An object containing all the custom fields and values",
            "example": {}
          }
        }
      },
      "attachedDevices": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 324,
            "description": "Asset, Miner, Inventory, etc ID value"
          },
          "text": {
            "type": "string",
            "example": "Antminer S19 - 12.0.0.1",
            "description": "Name of the Asset, Miner, Inventory, etc"
          },
          "type": {
            "type": "string",
            "example": "ASIC Miner",
            "description": "The type of the device"
          },
          "location": {
            "type": "string",
            "example": null,
            "description": "Only will show up for Asset Devices"
          },
          "deviceType": {
            "type": "string",
            "example": "Asset Item",
            "description": "The exact what device type the item is"
          }
        }
      },
      "brokerDispatches": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/brokerDispatch"
        }
      },
      "brokerDispatch": {
        "type": "object",
        "required": [
          "eventId",
          "type",
          "clientId",
          "created",
          "startTime",
          "cancelled",
          "startPlanId"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "example": 1,
            "description": "The event ID."
          },
          "type": {
            "type": "string",
            "enum": [
              "broker"
            ],
            "example": "csd",
            "description": "The broker type."
          },
          "clientId": {
            "type": "number",
            "example": 1,
            "description": "The Foreman client ID."
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2021-09-27T23:30:50.52Z",
            "description": "When the dispatch starts."
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2021-09-27T23:50:50.52Z",
            "description": "When the dispatch ends."
          },
          "cancelled": {
            "type": "boolean",
            "example": false,
            "description": "Whether the dispatch was cancelled."
          },
          "startPlanId": {
            "type": "integer",
            "example": 1,
            "description": "The corresponding Foreman start curtailment plan ID."
          },
          "endPlanId": {
            "type": "integer",
            "example": 1,
            "description": "The corresponding Foreman end curtailment plan ID."
          }
        }
      },
      "cspDispatches": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/cspDispatch"
        }
      },
      "cspDispatch": {
        "type": "object",
        "required": [
          "eventId",
          "type",
          "clientId",
          "created",
          "startTime",
          "cancelled",
          "startPlanId"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "example": 1,
            "description": "The csp event ID."
          },
          "type": {
            "type": "string",
            "enum": [
              "cpower",
              "voltus"
            ],
            "example": "cpower",
            "description": "The csp type."
          },
          "clientId": {
            "type": "number",
            "example": 1,
            "description": "The Foreman client ID."
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2021-09-27T23:30:50.52Z",
            "description": "When the dispatch starts."
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2021-09-27T23:50:50.52Z",
            "description": "When the dispatch ends."
          },
          "cancelled": {
            "type": "boolean",
            "example": false,
            "description": "Whether the dispatch was cancelled."
          },
          "startPlanId": {
            "type": "integer",
            "example": 1,
            "description": "The corresponding Foreman start curtailment plan ID."
          },
          "endPlanId": {
            "type": "integer",
            "example": 1,
            "description": "The corresponding Foreman end curtailment plan ID."
          }
        }
      },
      "cspDispatchCancel": {
        "type": "object",
        "properties": {
          "started": {
            "type": "boolean",
            "example": true,
            "description": "Whether the curtailment was already started."
          },
          "deletedStart": {
            "type": "boolean",
            "example": false,
            "description": "How the curtailment was halted (wasn't started yet, so possibly deleted)."
          },
          "revertedStart": {
            "type": "boolean",
            "example": true,
            "description": "The curtailment was already started and no end plan existed yet, so the start was reverted."
          },
          "ranEnd": {
            "type": "boolean",
            "example": false,
            "description": "The curtailment was ran, with an end time set, so the end plan was executed to cancel the dispatch."
          }
        }
      },
      "hiveKeys": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/hiveKey"
        }
      },
      "hiveKey": {
        "type": "object",
        "required": [
          "clientId",
          "farmId",
          "key"
        ],
        "properties": {
          "clientId": {
            "type": "number",
            "example": 1,
            "description": "The client ID."
          },
          "farmId": {
            "type": "number",
            "example": 105638,
            "description": "The HiveOS farm ID."
          },
          "key": {
            "type": "string",
            "example": "AAAAAAAAAAAAAAAAAAAAAMLheAAAAAAA0%2BuSeid%2BULvsea4JtiGRiSDSJSI%3DEUifiRBkKG5E2XzMDjRfl76ZC9Ub0wnz4XsNiRVBChTYbJcE3F",
            "description": "The HiveOS authentication token."
          }
        }
      },
      "hiveMappings": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/hiveMapping"
        }
      },
      "hiveMapping": {
        "type": "object",
        "required": [
          "hive",
          "foreman"
        ],
        "properties": {
          "hive": {
            "type": "string",
            "example": "t-rex",
            "description": "The HiveOS executable name."
          },
          "foreman": {
            "type": "string",
            "example": "trex",
            "description": "The Foreman executable name."
          }
        }
      },
      "createReport": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "power",
              "power-hash-rate",
              "five-minute-client-stats",
              "growth-report",
              "hourly-client-stats",
              "hourly-miner-consumption",
              "site-report-groups"
            ],
            "example": "power",
            "description": "The type of report to run."
          },
          "timeFrame": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month",
              "custom"
            ],
            "example": "custom",
            "description": "The time frame for the report."
          },
          "reportTimeStart": {
            "type": "string",
            "format": "date-time",
            "description": "Starting date and time of the report (custom time frame only).",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "reportTimeEnd": {
            "type": "string",
            "format": "date-time",
            "description": "Ending date and time of the report (custom time frame only).",
            "example": "2021-07-29T22:56:18.521000Z"
          }
        }
      },
      "reportCreated": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid",
            "example": "2d70b5d6-4390-41c0-82a8-52e4dd3a44af",
            "description": "The key of the report, used to retrieve the results"
          }
        }
      },
      "reportResults": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid",
            "example": "2d70b5d6-4390-41c0-82a8-52e4dd3a44af",
            "description": "The key of the report."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in-progress",
              "complete"
            ],
            "example": "complete",
            "description": "The status of the report run"
          },
          "resultUrls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "https://csv.url.1",
              "https://csv.url.2"
            ],
            "description": "The URLs of the CSVs containing data"
          }
        }
      },
      "dispatchType": {
        "type": "string",
        "description": "The type of the dispatch.",
        "example": "demand-response",
        "enum": [
          "peak",
          "demand-response",
          "target",
          "external"
        ]
      },
      "dispatch": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "example": "39d72d49-0190-4e1b-8ee6-35fae172d3b4",
            "maxLength": 50,
            "description": "The eventId associated with the dispatch. Will default to a UUID if none is provided."
          },
          "type": {
            "$ref": "#/components/schemas/dispatchType"
          },
          "clientId": {
            "type": "number",
            "example": 1,
            "description": "The client the dispatch belongs to."
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time the dispatch was created.",
            "example": "2021-06-29T15:56:18.521000Z",
            "readOnly": true
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time the dispatch begins.",
            "example": "2021-06-29T16:00:00.000000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time the dispatch ends.",
            "example": "2021-06-29T20:00:00.000000Z"
          },
          "cancelled": {
            "type": "boolean",
            "default": false,
            "example": false,
            "description": "Whether the dispatch was cancelled or not."
          },
          "targetDraw": {
            "type": "number",
            "default": 0,
            "example": 5000000,
            "description": "The target draw the curtailment should curtail to."
          },
          "targetUnits": {
            "type": "string",
            "default": "W",
            "example": "W",
            "description": "The units for the target draw.",
            "enum": [
              "W",
              "kW",
              "MW"
            ]
          },
          "bufferDraw": {
            "type": "number",
            "default": 0,
            "example": 50000,
            "description": "The buffer window for the target draw."
          },
          "bufferUnits": {
            "type": "string",
            "default": "W",
            "example": "W",
            "description": "The units for the buffer draw."
          }
        },
        "required": [
          "type",
          "clientId",
          "startTime",
          "endTime"
        ]
      },
      "dispatchResults": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/dispatch"
        }
      },
      "currentDispatchResults": {
        "type": "object",
        "properties": {
          "dispatches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dispatch"
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "example": "2021-06-29T15:56:18.521000Z",
                "description": "The current date and time when the stats were generated."
              },
              "curtailmentDownInterval": {
                "type": "number",
                "example": 1,
                "description": "The interval to spread curtailment power downs across in minutes."
              },
              "curtailmentUpInterval": {
                "type": "number",
                "example": 1,
                "description": "The interval to spread curtailment power ups across in minutes."
              },
              "strikeCurtailAfter": {
                "type": "number",
                "example": 1,
                "description": "How many consecutive windows the power price must exceed the strike price before the client is curtailed."
              },
              "strikeResumeAfter": {
                "type": "number",
                "example": 1,
                "description": "How many consecutive windows the power price must be below the strike price before the curtailment ends."
              },
              "powerCostType": {
                "type": "string",
                "example": "fixed",
                "enum": [
                  "fixed",
                  "variable"
                ],
                "description": "Whether the client's power cost is fixed or variable."
              },
              "strikePrice": {
                "type": "number",
                "example": 100.0,
                "description": "The power price to curtail after."
              },
              "autoStrikePrice": {
                "type": "boolean",
                "example": true,
                "description": "Whether the client is enrolled in auto strike price calculations."
              },
              "powerCostMwhAdder": {
                "type": "number",
                "example": 10.0,
                "description": "Power cost adder per MWh."
              },
              "lmp": {
                "type": "string",
                "example": "aeec",
                "description": "ISO zone the client is configured for if they are using variable pricing."
              },
              "market": {
                "type": "string",
                "example": "real-time",
                "description": "The ISO market the client is configured for if they are using variable pricing."
              },
              "iso": {
                "type": "string",
                "example": "ercot",
                "description": "The ISO the client is configured for if they are using variable pricing.",
                "enum": [
                  "ieso",
                  "nyiso",
                  "miso",
                  "iso-ne",
                  "ercot",
                  "spp"
                ]
              },
              "online": {
                "type": "number",
                "example": 1,
                "description": "Number of miners online."
              },
              "sleeping": {
                "type": "number",
                "example": 1,
                "description": "Number of miners sleeping."
              },
              "totalWattage": {
                "type": "number",
                "example": 1,
                "description": "Total wattage of the client's miners."
              }
            }
          }
        }
      }
    }
  }
}