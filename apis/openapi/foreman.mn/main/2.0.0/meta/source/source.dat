      }
    },
    "/dispatches/{clientId}/{eventId}": {
      "get": {
        "summary": "List dispatches for the client. This is a paid feature disabled by default.",
        "tags": [
          "dispatches",
          "paid"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "description": "The client ID to get dispatches for.",
            "schema": {
              "type": "number",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "eventId",
            "example": "39d72d49-0190-4e1b-8ee6-35fae172d3b4",
            "description": "The event ID to get dispatches for.",
            "required": true,
            "schema": {
              "type": "string",
              "default": false
            }
          },
          {
            "in": "query",
            "name": "noEnd",
            "description": "Only list dispatches without an end time.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "description": "PAID FEATURE: List dispatches for a given client ID and event ID",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dispatchResults"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create or edit a dispatch for the client. This is a paid feature disabled by default.",
        "tags": [
          "dispatches",
          "paid"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "description": "The client ID to create or edit dispatches for.",
            "schema": {
              "type": "number",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "eventId",
            "example": "39d72d49-0190-4e1b-8ee6-35fae172d3b4",
            "description": "The event ID to get dispatches for.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/dispatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dispatch"
                }
              }
            }
          }
        }
      }
    },
    "/dispatches/{clientId}/{eventId}/cancel": {
      "post": {
        "summary": "Cancel dispatches for the given client and event ID. This is a paid feature disabled by default.",
        "tags": [
          "dispatches",
          "paid"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "description": "The client ID to get dispatches for.",
            "schema": {
              "type": "number",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "eventId",
            "example": "39d72d49-0190-4e1b-8ee6-35fae172d3b4",
            "description": "The event ID to get dispatches for.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "PAID FEATURE: List dispatches for a given client ID and event ID",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "examples": {
      "withoutFiltering": {
        "value": {
          "name": "my-plan",
          "target": "reduce-by",
          "targetDraw": 5,
          "targetUnits": "MW",
          "deadlineMinutes": 10,
          "selectionMethod": "random",
          "direction": "up",
          "minerTarget": "all-miners"
        }
      },
      "withoutFilteringPhaseBalanced": {
        "value": {
          "name": "my-plan",
          "target": "reduce-by",
          "targetDraw": 5,
          "targetUnits": "MW",
          "deadlineMinutes": 10,
          "selectionMethod": "random-balanced",
          "minerTarget": "all-miners",
          "direction": "up"
        }
      },
      "filterByPickaxe": {
        "value": {
          "name": "my-plan",
          "target": "power-limit",
          "targetDraw": 6230,
          "targetUnits": "kW",
          "deadlineMinutes": 5,
          "scheduledStart": "2021-09-27T23:20:50.52Z",
          "selectionMethod": "random",
          "direction": "down",
          "minerTarget": "subset-miners",
          "minersFilter": "{\"key\":\"pickaxe\",\"value\":[\"24\"]}"
        }
      },
      "filterByIpRange": {
        "value": {
          "name": "my-plan",
          "target": "reduce-by",
          "targetDraw": 1,
          "targetUnits": "MW",
          "deadlineMinutes": 2,
          "selectionMethod": "random",
          "direction": "down",
          "minerTarget": "subset-miners",
          "minersFilter": "{\"key\":\"miner_ip_range\",\"value\":\"10.0.0.0,10.0.1.255\"}"
        }
      },
      "filterByTags": {
        "value": {
          "name": "my-plan",
          "target": "power-limit",
          "targetDraw": 5,
          "targetUnits": "MW",
          "deadlineMinutes": 10,
          "selectionMethod": "random",
          "direction": "down",
          "minersFilter": "{\"key\":\"tag\",\"value\":[\"11\"]}"
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "description": "Used to authentication requests. Authorization header value must be 'Token <api_key_here>'",
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    },
    "parameters": {
      "customField": {
        "in": "path",
        "name": "customField",
        "required": true,
        "description": "The custom field of a miner",
        "schema": {
          "type": "string"
        }
      },
      "limit": {
        "in": "query",
        "name": "limit",
        "required": true,
        "description": "How many entries to display per page.",
        "schema": {
          "type": "number",
          "maximum": 500
        }
      },
      "offset": {
        "in": "query",
        "name": "offset",
        "required": true,
        "description": "The paging index.",
        "schema": {
          "type": "number"
        }
      },
      "since": {
        "in": "query",
        "name": "since",
        "required": true,
        "description": "Objects since a certain date",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "before": {
        "in": "query",
        "name": "before",
        "required": true,
        "description": "Objects before a certain date",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "clientIdPath": {
        "in": "path",
        "name": "clientId",
        "required": true,
        "description": "The client ID.",
        "schema": {
          "type": "number",
          "minimum": 1
        }
      },
      "dispatchEventId": {
        "in": "path",
        "name": "eventId",
        "required": true,
        "description": "Dispatch event ID.",
        "schema": {
          "type": "number",
          "minimum": 1
        }
      },
      "pickaxeKeyPath": {
        "in": "path",
        "name": "pickaxeKey",
        "required": true,
        "description": "The pickaxe key.",
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "c9e672e8-c219-462a-8446-432cc0949082"
        }
      },
      "cspEventIdPath": {
        "in": "path",
        "name": "eventId",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "The event ID."
      },
      "cspPath": {
        "in": "path",
        "name": "csp",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "cpower",
            "voltus"
          ],
          "example": "cpower"
        },
        "description": "The curtailment service provider."
      },
      "brokerPath": {
        "in": "path",
        "name": "broker",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "csd"
          ],
          "example": "csd"
        },
        "description": "The broker."
      },
      "tagIdPath": {
        "in": "path",
        "name": "tagId",
        "required": true,
        "description": "The tag ID.",
        "schema": {
          "type": "number",
          "minimum": 1
        }
      },
      "pickaxeIdPath": {
        "in": "path",
        "name": "pickaxeId",
        "required": true,
        "description": "The pickaxe ID.",
        "schema": {
          "type": "number"
        }
      },
      "minerIdPath": {
        "in": "path",
        "name": "minerId",
        "description": "The miner ID.",
        "required": true,
        "schema": {
          "type": "number",
          "minimum": 1
        }
      },
      "pickaxe": {
        "in": "query",
        "name": "pickaxe",
        "description": "The Pickaxe ID.",
        "schema": {
          "type": "number"
        }
      },
      "minerId": {
        "in": "query",
        "name": "minerId",
        "description": "The miner ID.",
        "schema": {
          "type": "number"
        }
      },
      "hardware": {
        "in": "query",
        "name": "hardware",
        "description": "The hardware type.",
        "schema": {
          "type": "string",
          "enum": [
            "ASIC",
            "RIG"
          ]
        }
      },
      "minerPool": {
        "in": "query",
        "name": "minerPool",
        "description": "The miner is configured to use the provided pool.",
        "schema": {
          "type": "string"
        }
      },
      "workerName": {
        "in": "query",
        "name": "workerName",
        "description": "The miner is configured to use the provided worker name.",
        "schema": {
          "type": "string"
        }
      },
      "workerNameExact": {
        "in": "query",
        "name": "workerNameExact",
        "description": "The miner is configured to use the provided worker name (a full string match).",
        "schema": {
          "type": "string"
        }
      },
      "minerName": {
        "in": "query",
        "name": "minerName",
        "description": "The miner's name.",
        "schema": {
          "type": "string"
        }
      },
      "minerNameExact": {
        "in": "query",
        "name": "minerNameExact",
        "description": "The miner's name (a full string match).",
        "schema": {
          "type": "string"
        }
      },
      "minerIp": {
        "in": "query",
        "name": "minerIp",
        "description": "The miner's IP.",
        "schema": {
          "type": "string"
        }
      },
      "minerMac": {
        "in": "query",
        "name": "minerMac",
        "description": "The miner's MAC.",
        "schema": {
          "type": "string"
        }
      },
      "minerIpRange": {
        "in": "query",
        "name": "minerIpRange",
        "description": "The miner's IP falls within the provided range. The range should be a comma-separated start and end, like '192.168.1.1,192.168.1.255'",
        "schema": {
          "type": "string"
        }
      },
      "minerType": {
        "in": "query",
        "name": "minerType",
        "description": "The miner type ID to match.",
        "schema": {
          "type": "number"
        }
      },
      "activePool": {
        "in": "query",
        "name": "activePool",
        "description": "The miner is currently mining to the provided pool.",
        "schema": {
          "type": "string"
        }
      },
      "activeWorker": {
        "in": "query",
        "name": "activeWorker",
        "description": "The miner is currently using the provided worker name.",
        "schema": {
          "type": "string"
        }
      },
      "activeWorkerExact": {
        "in": "query",
        "name": "activeWorkerExact",
        "description": "The miner is currently using the provided worker name (a full string match).",
        "schema": {
          "type": "string"
        }
      },
      "tag": {
        "in": "query",
        "name": "tag",
        "description": "The miner must be tagged with the provided tag ID.",
        "schema": {
          "type": "number"
        }
      },
      "powerMode": {
        "in": "query",
        "name": "powerMode",
        "description": "The miner must be in the provided power mode.",
        "schema": {
          "type": "string",
          "enum": [
            "normal",
            "sleeping",
            "idle",
            "low",
            "high"
          ]
        }
      },
      "serial": {
        "in": "query",
        "name": "serial",
        "description": "The miner must have the provided serial number.",
        "schema": {
          "type": "string"
        }
      },
      "minerLocationGroup": {
        "in": "query",
        "name": "minerLocationGroup",
        "description": "The miner must be in the provided Site Map group ID.",
        "schema": {
          "type": "number"
        }
      },
      "minerLocationRack": {
        "in": "query",
        "name": "minerLocationRack",
        "description": "The miner must be in the provided Site Map rack ID.",
        "schema": {
          "type": "number"
        }
      },
      "minerLocationRow": {
        "in": "query",
        "name": "minerLocationRow",
        "description": "The miner must be in the provided Site Map rack row.",
        "schema": {
          "type": "number"
        }
      },
      "minerLocationIndex": {
        "in": "query",
        "name": "minerLocationIndex",
        "description": "The miner must be in the provided Site Map rack index.",
        "schema": {
          "type": "number"
        }
      },
      "minerTempExceeds": {
        "in": "query",
        "name": "minerTempExceeds",
        "description": "The miner must have a temperature that exceeds the provided value.",
        "schema": {
          "type": "number"
        }
      },
      "minerHashRateRange": {
        "in": "query",
        "name": "minerHashRateRange",
        "description": "The miner's hash rate must be between the provided range.  The range must be a comma-separate value, like '0,120000'.",
        "schema": {
          "type": "string"
        }
      },
      "issueNotUpdating": {
        "in": "query",
        "name": "issueNotUpdating",
        "description": "The miner must not be updating.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueNotUpdatingRecent": {
        "in": "query",
        "name": "issueNotUpdatingRecent",
        "description": "The miner must not be updating (recent).",
        "schema": {
          "type": "boolean"
        }
      },
      "issueNotUpdatingOneDay": {
        "in": "query",
        "name": "issueNotUpdatingOneDay",
        "description": "The miner must not be updating (one day).",
        "schema": {
          "type": "boolean"
        }
      },
      "issueNotUpdatingTwoDays": {
        "in": "query",
        "name": "issueNotUpdatingTwoDays",
        "description": "The miner must not be updating (two days).",
        "schema": {
          "type": "boolean"
        }
      },
      "issuePickaxeOffline": {
        "in": "query",
        "name": "issuePickaxeOffline",
        "description": "The pickaxe must be offline.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueRebooted": {
        "in": "query",
        "name": "issueRebooted",
        "description": "The miner must have recently rebooted.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueHashRate": {
        "in": "query",
        "name": "issueHashRate",
        "description": "The miner must be under the desired hash rate.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueTemps": {
        "in": "query",
        "name": "issueTemps",
        "description": "The miner must be failing for temps.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueFansHigh": {
        "in": "query",
        "name": "issueFansHigh",
        "description": "The miner must have fan speeds that are too high.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueFansLow": {
        "in": "query",
        "name": "issueFansLow",
        "description": "The miner must have fan speeds that are too low.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueNotSubmittingShares": {
        "in": "query",
        "name": "issueNotSubmittingShares",
        "description": "The miner must be not submitting shares.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueHwErrors": {
        "in": "query",
        "name": "issueHwErrors",
        "description": "The miner must have hardware errors.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueMissingHashBoards": {
        "in": "query",
        "name": "issueMissingHashBoards",
        "description": "The miner must have missing hash boards.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueMissingFan": {
        "in": "query",
        "name": "issueMissingFan",
        "description": "The miner must have missing fans.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueZeroHashRate": {
        "in": "query",
        "name": "issueZeroHashRate",
        "description": "The miner must have a 0 hash rate.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueAbnormalHashRate": {
        "in": "query",
        "name": "issueAbnormalHashRate",
        "description": "The miner must have an abnormal hash rate.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueNoPoolsConfigured": {
        "in": "query",
        "name": "issueNoPoolsConfigured",
        "description": "The miner must have no pools configured.",
        "schema": {
          "type": "boolean"
        }
      },
      "issueDuplicateMac": {
        "in": "query",
        "name": "issueDuplicateMac",
        "description": "The miner must have a duplicate MAC in the system.",
        "schema": {
          "type": "boolean"
        }
      },
      "errorCode": {
        "in": "query",
        "name": "errorCode",
        "description": "The miner must have the provided error code.",
        "schema": {
          "type": "integer"
        }
      },
      "minerUpdatedSince": {
        "in": "query",
        "name": "minerUpdatedSince",
        "description": "A cut off time, in minutes, for how recently a miner has updated.",
        "schema": {
          "type": "integer"
        }
      },
      "reportKey": {
        "in": "query",
        "name": "key",
        "description": "The UUID of the report to retrieve.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "limit": {
        "type": "number",
        "description": "How many entries to display per page.",
        "example": 500
      },
      "offset": {
        "type": "number",
        "description": "The paging index.",
        "example": 0
      },
      "total": {
        "type": "number",
        "description": "The total number of result entries.",
        "example": 2315
      },
      "status": {
        "type": "string",
        "enum": [
          "okay",
          "warn",
          "fail"
        ],
        "example": "fail"
      },
      "resultStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "description": "Whether or not successful.",
            "example": true
          }
        }
      },
      "miners": {
        "type": "object",
        "properties": {
          "limit": {
            "$ref": "#/components/schemas/limit"
          },
          "offset": {
            "$ref": "#/components/schemas/offset"
          },
          "total": {
            "$ref": "#/components/schemas/total"
          },
          "results": {
            "$ref": "#/components/schemas/minersArray"
          }
        }
      },
      "minersArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/miner"
        }
      },
      "minerSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The miner's ID.",
            "example": 571
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "When the miner was last observed.",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "type": {
            "type": "object",
            "description": "The miner type.",
            "properties": {
              "id": {
                "type": "number",
                "description": "The system ID.",
                "example": 13
              },
              "name": {
                "type": "string",
                "description": "The system name.",
                "example": "Antminer S19j Pro (110T)"
              }
            }
          },
          "serial": {
            "type": "string",
            "description": "The serial number.",
            "example": "ASDFASF113123A"
          },
          "workers": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "The worker name.",
              "example": "obm.miner1"
            }
          },
          "hashrate": {
            "type": "number",
            "description": "The hash rate.",
            "example": 110123181838181
          }
        }
      },
      "minersSummaryArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/minerSummary"
        }
      },
      "groupStats": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "minersOnline": {
              "type": "number",
              "description": "The number of miners online.",
              "example": 101
            },
            "minersTotal": {
              "type": "number",
              "description": "The total number of miners.",
              "example": 150
            },
            "minersHashing": {
              "type": "number",
              "description": "The total number of miners hashing.",
              "example": 148
            },
            "averageHashRate": {
              "type": "number",
              "description": "The average hash rate for the model.",
              "example": 110000000000000
            },
            "totalHashRate": {
              "type": "number",
              "description": "The aggregated hash rate.",
              "example": 16500000000000000
            },
            "totalFans": {
              "type": "number",
              "description": "The total number of fans.",
              "example": 450
            },
            "averageFanSpeed": {
              "type": "number",
              "description": "The average fan speed.",
              "example": 3298
            },
            "aggregateFanSpeed": {
              "type": "number",
              "description": "The aggregate fan speed.",
              "example": 1978800
            },
            "model": {
              "type": "string",
              "description": "The miner model.",
              "example": "Antminer S19j Pro (96T)"
            }
          }
        }
      },
      "groupRackStats": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The rack name.",
              "example": "a001 - 0"
            },
            "hashrate": {
              "type": "number",
              "description": "The aggregated hashrate.",
              "example": 7414407692551643
            },
            "hashrateIdeal": {
              "type": "number",
              "description": "The aggregated ideal hashrate.",
              "example": 5472000000000000
            },
            "consumption": {
              "type": "number",
              "description": "The aggregated consumption (W).",
              "example": 231840
            },
            "consumptionManufacturer": {
              "type": "number",
              "description": "The aggregated manufacturer sticker consumption (W).",
              "example": 231840
            },
            "tempMin": {
              "type": "number",
              "description": "The lowest temp reading.",
              "example": 79
            },
            "tempMax": {
              "type": "number",
              "description": "The highest temp reading.",
              "example": 106
            },
            "tempAvg": {
              "type": "number",
              "description": "The average temp reading.",
              "example": 85.44675925925925
            },
            "minersTotal": {
              "type": "number",
              "description": "The total number of miners.",
              "example": 72
            },
            "minersOnline": {
              "type": "number",
              "description": "The total number of miners online.",
              "example": 72
            },
            "minersHashing": {
              "type": "number",
              "description": "The total number of miners hashing.",
              "example": 72
            }
          }
        }
      },
      "groupSummary": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "description": "The group name (closest site map group).",
            "example": "a001"
          },
          "stats": {
            "$ref": "#/components/schemas/groupStats"
          },
          "racks": {
            "$ref": "#/components/schemas/groupRackStats"
          }
        }
      },
      "groupSummaryArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/groupSummary"
        }
      },
      "bulkMiner": {
        "type": "array",
        "items": {
          "type": "number",
          "description": "The miner ids that successfully moved to the new client and optionally the pickaxe provided"
        },
        "example": [
          1,
          2
        ]
      },
      "miner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The miner's ID.",
            "example": 571
          },
          "name": {
            "type": "string",
            "description": "The miner's name.",
            "example": "Antminer S19j Pro - 10.10.1.5"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ASIC",
              "RIG"
            ],
            "description": "The platform type.",
            "example": "ASIC"
          },
          "type": {
            "type": "object",
            "description": "The miner type.",
            "properties": {
              "id": {
                "type": "number",
                "description": "The system ID.",
                "example": 13
              },
              "name": {
                "type": "string",
                "description": "The system name.",
                "example": "Antminer S19j Pro (110T)"
              }
            }
          },
          "ip": {
            "type": "string",
            "description": "The IP.",
            "example": "10.10.1.5"
          },
          "apiIp": {
            "type": "number",
            "description": "The API port.",
            "example": 4028
          },
          "mac": {
            "type": "string",
            "description": "The MAC address.",
            "example": "ca:fe:de:fe:ca:12"
          },
          "serial": {
            "type": "string",
            "description": "The miner's serial.",
            "example": "SN2987987981128928"
          },
          "description": {
            "type": "string",
            "description": "The user defined description.",
            "example": "My favorite miner."
          },
          "pickaxe": {
            "type": "number",
            "description": "The Pickaxe ID.",
            "example": 13413
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When the miner was added.",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "When the miner was last observed.",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "seen": {
            "type": "boolean",
            "description": "Whether the miner has been observed.",
            "example": true
          },
          "active": {
            "type": "boolean",
            "description": "Whether the miner is active and expected to be hashing.",
            "example": true
          },
          "hive": {
            "$ref": "#/components/schemas/hive"
          },
          "core": {
            "$ref": "#/components/schemas/core"
          },
          "location": {
            "$ref": "#/components/schemas/location"
          },
          "pools": {
            "$ref": "#/components/schemas/poolsInfo"
          },
          "firmware": {
            "$ref": "#/components/schemas/firmware"
          },
          "network": {
            "$ref": "#/components/schemas/network"
          },
          "alerting": {
            "type": "object",
            "properties": {
              "ignoreHwErrors": {
                "type": "boolean",
                "description": "Whether hardware errors (missing chips) should be ignored.",
                "example": false
              },
              "ignoreMissingBoards": {
                "type": "boolean",
                "description": "Whether missing hash boards should be ignored.",
                "example": false
              },
              "ignoreMissingFan": {
                "type": "boolean",
                "description": "Whether missing fans should be ignored.",
                "example": false
              },
              "ignoreReboots": {
                "type": "boolean",
                "description": "Whether reboots should be ignored.",
                "example": false
              },
              "ignoreDuplicateMac": {
                "type": "boolean",
                "description": "Whether duplicate MACs should be ignored.",
                "example": false
              },
              "temps": {
                "$ref": "#/components/schemas/sliderConfig"
              },
              "hashRate": {
                "$ref": "#/components/schemas/sliderConfig"
              },
              "fanLow": {
                "$ref": "#/components/schemas/sliderConfig"
              },
              "fanHigh": {
                "$ref": "#/components/schemas/sliderConfig"
              }
            }
          }
        }
      },
      "sliderConfig": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether the criteria should be monitored.",
            "example": true
          },
          "warnAt": {
            "type": "number",
            "description": "When to WARN.",
            "example": 90
          },
          "failAt": {
            "type": "number",
            "description": "When to FAIL."
          }
        }
      },
      "siteMapElements": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/siteMapElement"
        }
      },
      "siteMapElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The group ID.",
            "example": 291
          },
          "name": {
            "type": "string",
            "description": "The Site Map group name.",
            "example": "C1"
          },
          "groupId": {
            "type": "number",
            "description": "The owning group ID.",
            "example": 291
          },
          "row": {
            "type": "number",
            "description": "The row.",
            "example": 0
          },
          "column": {
            "type": "number",
            "description": "The column.",
            "example": 1
          }
        },
        "required": [
          "id",
          "name",
          "row",
          "column"
        ]
      },
      "siteMapLocation": {
        "type": "object",
        "properties": {
          "rack": {
            "type": "string",
            "description": "The name of the rack.",
            "example": "A001 - R1"
          },
          "row": {
            "type": "number",
            "description": "The rack row.",
            "example": 0
          },
          "index": {
            "type": "number",
            "description": "The rack index/column.",
            "example": 0
          }
        }
      },
      "issues": {
        "properties": {
          "limit": {
            "$ref": "#/components/schemas/limit"
          },
          "offset": {
            "$ref": "#/components/schemas/offset"
          },
          "total": {
            "$ref": "#/components/schemas/total"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/issue"
            }
          }
        }
      },
      "issue": {
        "type": "object",
        "properties": {
          "minerId": {
            "type": "number",
            "description": "The miner ID.",
            "example": 567
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/issueInfo"
            }
          }
        }
      },
      "issueInfo": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the data was sampled. For non-historical queries, this will represent the receipt time of the miner's most recent metrics.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "abnormalHashRate": {
            "type": "boolean",
            "description": "Whether or not the hash rate was found to be abnormal.",
            "example": true
          },
          "abnormalHashRateStatus": {
            "$ref": "#/components/schemas/status"
          },
          "abnormalHashRateSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "zeroHashRate": {
            "type": "boolean",
            "description": "If the hash rate is 0."
          },
          "zeroHashRateStatus": {
            "$ref": "#/components/schemas/status"
          },
          "zeroHashRateSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "rebooted": {
            "type": "boolean",
            "description": "If the miner recently rebooted."
          },
          "rebootedStatus": {
            "$ref": "#/components/schemas/status"
          },
          "rebootedSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "hashRate": {
            "type": "boolean",
            "description": "If the miner's hash rate is low."
          },
          "hashRateStatus": {
            "$ref": "#/components/schemas/status"
          },
          "hashRateSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "temps": {
            "type": "boolean",
            "description": "If the miner's temp is high."
          },
          "tempsStatus": {
            "$ref": "#/components/schemas/status"
          },
          "tempsSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "fansHigh": {
            "type": "boolean",
            "description": "If the miner's fans are high."
          },
          "fansHighStatus": {
            "$ref": "#/components/schemas/status"
          },
          "fansHighSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "fansLow": {
            "type": "boolean",
            "description": "If the miner's fans are low."
          },
          "fansLowStatus": {
            "$ref": "#/components/schemas/status"
          },
          "fansLowSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "notSubmittingShares": {
            "type": "boolean",
            "description": "If the miner isn't submitting shares."
          },
          "notSubmittingSharesStatus": {
            "$ref": "#/components/schemas/status"
          },
          "notSubmittingSharesSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "hwErrors": {
            "type": "boolean",
            "description": "If the miner has hardware errors."
          },
          "hwErrorsStatus": {
            "$ref": "#/components/schemas/status"
          },
          "hwErrorsSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "missingHashBoards": {
            "type": "boolean",
            "description": "If the miner's missing hash boards."
          },
          "missingHashBoardsStatus": {
            "$ref": "#/components/schemas/status"
          },
          "missingHashBoardsSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "missingFan": {
            "type": "boolean",
            "description": "If the miner's missing fans."
          },
          "missingFanStatus": {
            "$ref": "#/components/schemas/status"
          },
          "missingFanSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "notUpdating": {
            "type": "boolean",
            "description": "If the miner isn't reachable."
          },
          "notUpdatingStatus": {
            "$ref": "#/components/schemas/status"
          },
          "notUpdatingSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "notUpdatingRecent": {
            "type": "boolean",
            "description": "If the miner isn't reachable (today)."
          },
          "notUpdatingRecentStatus": {
            "$ref": "#/components/schemas/status"
          },
          "notUpdatingOneDay": {
            "type": "boolean",
            "description": "If the miner isn't reachable (> 1 day)."
          },
          "notUpdatingOneDayStatus": {
            "$ref": "#/components/schemas/status"
          },
          "notUpdatingTwoDays": {
            "type": "boolean",
            "description": "If the miner isn't reachable (> 2 days)."
          },
          "notUpdatingTwoDaysStatus": {
            "$ref": "#/components/schemas/status"
          },
          "pickaxeOffline": {
            "type": "boolean",
            "description": "If the miner's pickaxe is offline."
          },
          "pickaxeOfflineStatus": {
            "$ref": "#/components/schemas/status"
          },
          "pickaxeOfflineSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "noPoolsConfigured": {
            "type": "boolean",
            "description": "If the miner doesn't have pools configured."
          },
          "noPoolsConfiguredStatus": {
            "$ref": "#/components/schemas/status"
          },
          "noPoolsConfiguredSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          },
          "duplicateMac": {
            "type": "boolean",
            "description": "If the miner has a MAC that appears to be duplicated."
          },
          "duplicateMacStatus": {
            "$ref": "#/components/schemas/status"
          },
          "duplicateMacSince": {
            "type": "string",
            "format": "date-time",
            "example": "2021-06-29T22:56:18.521000Z"
          }
        }
      },
      "fiat": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "The symbol.",
            "example": "USD"
          },
          "exchangeRate": {
            "type": "number",
            "description": "The conversion rate to USD.",
            "example": 1
          }
        }
      },
      "fiats": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/fiat"
        }
      },
      "metrics": {
        "properties": {
          "limit": {
            "$ref": "#/components/schemas/limit"
          },
          "offset": {
            "$ref": "#/components/schemas/offset"
          },
          "total": {
            "$ref": "#/components/schemas/total"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/metric"
            }
          }
        }
      },
      "metric": {
        "type": "object",
        "properties": {
          "minerId": {
            "type": "number",
            "description": "The miner ID.",
            "example": 567
          },
          "metric": {
            "$ref": "#/components/schemas/metricInfo"
          }
        }
      },
      "metricInfo": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the data was sampled. For non-historical queries, this will represent the receipt time of the miner's most recent metrics.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "online": {
            "type": "boolean",
            "description": "Whether the miner is currently online.",
            "example": true
          },
          "hashRate": {
            "type": "number",
            "description": "The hash rate (Hs).",
            "example": 120000
          },
          "hashRateIdeal": {
            "type": "number",
            "description": "The miner's reported ideal hash rate.",
            "example": 124000
          },
          "boards": {
            "type": "array",
            "description": "The hash boards.",
            "items": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the board is enabled.",
                  "example": true
                },
                "status": {
                  "type": "boolean",
                  "description": "Whether the board is active.",
                  "example": true
                },
                "temperature": {
                  "type": "number",
                  "description": "The board temp.",
                  "example": 94
                },
                "effectiveChips": {
                  "type": "number",
                  "description": "The number of effective chips.",
                  "example": 111
                },
                "chipStatus": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "description": "The chip status.",
                    "example": 0
                  }
                },
                "chipFrequency": {
                  "type": "number",
                  "description": "The chip frequency.",
                  "example": 617
                },
                "chipTempMin": {
                  "type": "number",
                  "description": "The minimum chip temp.",
                  "example": 65
                },
                "chipTempMax": {
                  "type": "number",
                  "description": "The maximum chip temp.",
                  "example": 87.7
                },
                "chipTempAvg": {
                  "type": "number",
                  "description": "The average chipt emp.",
                  "example": 80.36
                },
                "hardwareErrors": {
                  "type": "number",
                  "description": "The number of hardware errors.",
                  "example": 324
                },
                "serial": {
                  "type": "string",
                  "description": "The board serial number.",
                  "example": "H3M14S6F200114K10102"
                }
              },
              "required": [
                "enabled",
                "status"
              ]
            }
          },
          "fans": {
            "$ref": "#/components/schemas/fans"
          },
          "temps": {
            "type": "array",
            "items": {
              "type": "number",
              "description": "The temperature readings.",
              "example": [
                34,
                90,
                91,
                92
              ]
            }
          },
          "powerMode": {
            "type": "string",
            "description": "The miner's current power mode.",
            "enum": [
              "sleeping",
              "normal",
              "idle",
              "low",
              "high"
            ],
            "example": "normal"
          },
          "powerReported": {
            "type": "boolean",
            "description": "Whether the miner reported its power draw or of the returned value is calculated.",
            "example": true
          },
          "power": {
            "type": "number",
            "description": "The miner's current power consumption (W).",
            "example": 3200
          },
          "powerManufacturer": {
            "type": "number",
            "description": "The miner's power consumption as indicated by the manufacturer.",
            "example": 3250
          },
          "voltage": {
            "type": "number",
            "description": "The miner's current voltage."
          },
          "voltageInput": {
            "type": "number",
            "description": "The miner's input voltage."
          },
          "currentInput": {
            "type": "number",
            "description": "The miner's current input."
          },
          "pools": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "The miner's pools.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The stratum URL.",
                  "example": "btc.foundryusapool.com:3333"
                },
                "worker": {
                  "type": "string",
                  "description": "The worker name.",
                  "example": "miners.worker1"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the pool is enabled on the miner.",
                  "example": true
                },
                "status": {
                  "type": "boolean",
                  "description": "Whether the pool is connected.",
                  "example": true
                },
                "priority": {
                  "type": "number",
                  "description": "The pool priority.",
                  "example": 0
                },
                "accepted": {
                  "type": "number",
                  "description": "The total accepted share count."
                },
                "rejected": {
                  "type": "number",
                  "description": "The total rejected share count."
                },
                "stale": {
                  "type": "number",
                  "description": "The total stale share count."
                }
              }
            }
          },
          "errorCodes": {
            "type": "array",
            "items": {
              "type": "number",
              "description": "The existing, manufacturer-specific error codes.",
              "example": [
                201,
                202
              ]
            }
          }
        },
        "required": [
          "hashRate",
          "hasErrors",
          "fans",
          "temps",
          "powerMode",
          "powerReported",
          "pools",
          "boards"
        ]
      },
      "hive": {
        "type": "object",
        "required": [
          "id",
          "farmId"
        ],
        "properties": {
          "id": {
            "type": "number",
            "description": "The HiveOS worker ID.",
            "example": 788113
          },
          "farmId": {
            "type": "number",
            "description": "The HiveOS farm ID.",
            "example": 105687
          }
        }
      },
      "core": {
        "type": "object",
        "required": [
          "customerId",
          "rigId"
        ],
        "properties": {
          "customerId": {
            "type": "number",
            "description": "The customer ID.",
            "example": 113
          },
          "rigId": {
            "type": "number",
            "description": "The rig ID.",
            "example": "cal1-A195753"
          }
        }
      },
      "location": {
        "type": "object",
        "properties": {
          "rackId": {
            "type": "number",
            "description": "The rack ID.",
            "example": 251
          },
          "row": {
            "type": "number",
            "description": "The rack row.",
            "example": 0
          },
          "index": {
            "type": "number",
            "description": "The rack row index.",
            "example": 1
          }
        }
      },
      "changePools": {
        "type": "object",
        "properties": {
          "pools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "description": "The stratum URL (without the prefix).",
                  "example": "btc.foundryusapool.com:3333"
                },
                "user": {
                  "type": "string",
                  "description": "The workername.",
                  "example": "obminc.worker1"
                },
                "pass": {
                  "type": "string",
                  "description": "The password.",
                  "example": "x"
                }
              }
            }
          },
          "algo": {
            "type": "string",
            "example": null
          }
        }
      },
      "bulkChangePools": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "miners": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "example": [
                1,
                2,
                3,
                4
              ]
            },
            "pools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "The stratum URL (without the prefix).",
                    "example": "btc.foundryusapool.com:3333"
                  },
                  "user": {
                    "type": "string",
                    "description": "The workername.",
                    "example": "obminc.worker1"
                  },
                  "pass": {
                    "type": "string",
                    "description": "The password.",
                    "example": "x"
                  }
                }
              }
            }
          }
        }
      },
      "pools": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/pool"
        }
      },
      "pool": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The stratum URL.",
            "example": "btc.foundryusapool.com:3333"
          },
          "worker": {
            "type": "string",
            "description": "The stratum worker name.",
            "example": "miners.miner1"
          }
        }
      },
      "firmware": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "description": "The miner's firmware.",
            "enum": [
              "stock",
              "vnish",
              "braiins",
              "hiveon"
            ],
            "example": "stock"
          },
          "version": {
            "type": "string",
            "description": "The miner's indicated compile time.",
            "example": "Fri Nov 26 16:19:01 CST 2021"
