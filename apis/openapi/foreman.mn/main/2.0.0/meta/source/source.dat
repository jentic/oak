      "curtailmentRuns": {
        "type": "object",
        "properties": {
          "limit": {
            "$ref": "#/components/schemas/limit"
          },
          "offset": {
            "$ref": "#/components/schemas/offset"
          },
          "total": {
            "$ref": "#/components/schemas/total"
          },
          "results": {
            "$ref": "#/components/schemas/curtailmentRunArray"
          }
        }
      },
      "curtailmentRunArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/curtailmentRun"
        }
