            "schema": {
              "type": "number",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "noEnd",
            "description": "Only list dispatches without an end time",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "description": "PAID FEATURE: List dispatches for a given client ID.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dispatchResults"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a dispatch for the client. This is a paid feature disabled by default.",
        "tags": [
          "dispatches",
          "paid"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "description": "The client ID to create or edit dispatches for.",
            "schema": {
              "type": "number",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/dispatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dispatch"
                }
              }
            }
          }
        },
        "description": "PAID FEATURE: Create a dispatch for a client."
      }
    },
