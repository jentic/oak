            "type": "string",
            "description": "The client type.",
            "enum": [
              "private",
              "colo"
            ],
            "example": "private"
          },
          "powerCost": {
            "$ref": "#/components/schemas/powerCost"
          },
          "group": {
            "type": "number",
            "description": "The group ID that the client belongs to.",
            "example": 1
          },
          "curtailmentOptIn": {
            "type": "boolean",
            "description": "Whether the client is accepting curtailments.",
            "example": true
          }
        }
      },
      "updateClient": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The client name.",
            "example": "My New Client"
          },
          "type": {
            "type": "string",
            "description": "The client type.",
            "enum": [
              "private",
              "colo"
            ],
            "example": "private"
          },
          "powerCost": {
            "$ref": "#/components/schemas/powerCost"
          },
          "curtailmentOptIn": {
            "type": "boolean",
            "description": "Whether the client is accepting curtailments.",
            "example": true
          },
          "curtailmentRetry": {
            "type": "boolean",
            "description": "Retry curtailments.",
            "example": true
          },
          "curtailmentRetryDuration": {
            "type": "integer",
            "description": "How long to continue to retry curtailments (minutes).",
            "example": 15
          }
        }
      },
      "createMiners": {
        "type": "object",
        "properties": {
          "pickaxe": {
            "type": "string",
            "description": "The Pickaxe key.",
            "example": "69cd901d-e82c-4a56-903a-3ee8526b62be"
          },
          "miners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/createMiner"
            }
          }
        }
      },
      "moveMiner": {
        "type": "object",
        "properties": {
          "newClientId": {
            "type": "number",
            "description": "The new owning client.",
            "example": 112
          },
          "newPickaxeId": {
            "type": "number",
            "description": "The pickaxe ID.",
            "example": 11234
          }
        },
        "required": [
          "newClientId"
        ]
      },
      "bulkMoveMiner": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "miners": {
              "type": "array",
              "items": {
                "type": "number",
                "description": "The miner ids to move to a different client and pickaxe"
              },
              "example": [
                1,
                2,
                3,
                4
              ]
            },
            "newClientId": {
              "type": "number",
              "description": "The client id that miners will move to",
              "example": 1125
            },
            "newPickaxeId": {
              "type": "number",
              "description": "The pickaxe id that miners can optionally move to",
              "example": 112345
            }
          }
        }
      },
      "curtailmentScheduledPlanOnce": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the curtailment plan."
          },
          "target": {
            "type": "string",
            "enum": [
              "power-limit",
              "reduce-by",
              "all-miners"
            ],
            "description": "The type of curtailment to run."
          },
          "targetDraw": {
            "type": "integer",
            "example": 6230,
            "description": "The target power draw (only required if target is 'power-limit' or 'reduce-by').  Unused if 'all-miners' target, but must exist (can be empty, or 0)."
          },
          "targetUnits": {
            "type": "string",
            "enum": [
              "W",
              "kW",
              "MW"
            ],
            "description": "The target power draw units (only required if target is 'power-limit' or 'reduce-by').  Unused if 'all-miners' target, but must contain a valid value.",
            "example": "kW"
          },
          "deadlineMinutes": {
            "type": "integer",
            "example": 5,
            "description": "How long until the optional must complete.",
            "minimum": 1
          },
          "scheduledStart": {
            "type": "string",
            "format": "date-time",
            "description": "When the plan should automatically start. Will start immediately if this isn't provided.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "selectionMethod": {
            "type": "string",
            "enum": [
              "random",
              "random-balanced"
            ],
            "description": "Determines the order of selection for miners in a curtailment. When an operation is segmented by power phases and PDUs (via a Site Map), phase balanced options are available.",
            "example": "random",
            "default": "random"
          },
          "direction": {
            "type": "string",
            "enum": [
              "down",
              "up"
            ],
            "description": "The curtailment direction.",
            "default": "down"
          },
          "minersFilter": {
            "type": "object",
            "description": "A JSON-formatted miner filter."
          }
        },
        "required": [
          "name",
          "direction",
          "target",
          "targetDraw",
          "targetUnits",
          "deadlineMinutes"
        ]
      },
      "curtailmentScheduledPlan": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the curtailment plan."
          },
          "target": {
            "type": "string",
            "enum": [
              "power-limit",
              "reduce-by",
              "all-miners"
            ],
            "description": "The type of curtailment to run."
          },
          "targetDraw": {
            "type": "integer",
            "example": 6230,
            "description": "The target power draw (only required if target is 'power-limit' or 'reduce-by').  Unused if 'all-miners' target, but must exist (can be empty, or 0)."
          },
          "targetUnits": {
            "type": "string",
            "enum": [
              "W",
              "kW",
              "MW"
            ],
            "description": "The target power draw units (only required if target is 'power-limit' or 'reduce-by').  Unused if 'all-miners' target, but must contain a valid value.",
            "example": "kW"
          },
          "deadlineMinutes": {
            "type": "integer",
            "example": 5,
            "description": "How long until the optional must complete.",
            "minimum": 1
          },
          "scheduledStart": {
            "type": "string",
            "format": "date-time",
            "description": "When the plan should automatically start. Will start immediately if this isn't provided.",
            "example": "2021-09-27T23:20:50.52Z"
          },
          "selectionMethod": {
            "type": "string",
            "enum": [
              "random",
              "random-balanced"
            ],
            "description": "Determines the order of selection for miners in a curtailment. When an operation is segmented by power phases and PDUs (via a Site Map), phase balanced options are available.",
            "example": "random",
            "default": "random"
          },
          "direction": {
            "type": "string",
            "enum": [
              "down",
              "up"
            ],
            "description": "The curtailment direction.",
            "default": "down"
          },
          "minerTarget": {
            "type": "string",
            "enum": [
              "all-miners",
              "subset-miners",
              "subset-negative-filter"
            ],
            "description": "How to select which miners to adjust. If a filter is applied, this would typically be 'subset-miners'.",
            "example": "subset-miners"
          },
          "minersFilter": {
            "type": "object",
            "description": "A JSON-formatted miner filter."
          }
        },
        "required": [
          "name",
          "direction",
          "target",
          "targetDraw",
          "targetUnits",
          "deadlineMinutes",
          "minerTarget"
        ]
      },
