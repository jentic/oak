            "type": "string",
            "description": "The system name.",
            "example": "Antminer S19j Pro"
          },
          "ip": {
            "type": "string",
            "description": "The miner's IP.",
            "example": "10.10.1.2"
          },
          "api_port": {
            "type": "number",
            "description": "The miner's API port.",
            "example": 4028
          },
          "mac": {
            "type": "string",
            "description": "The miner's MAC address.",
            "example": "ca:fe:ba:be:de:ad"
          },
