  "components": {
    "schemas": {
      "Bug": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Bug identifier"
          },
          "designation": {
            "type": "string",
            "description": "Bug name/designation"
          },
          "description": {
            "type": "string",
            "description": "Bug description"
          },
          "url": {
            "type": "string",
            "description": "URL where the bug was found"
          },
          "priority_id": {
            "type": "string",
            "description": "Priority identifier"
          },
          "status_id": {
            "type": "string",
            "description": "Current status identifier"
          },
          "operating_system": {
            "type": "string",
            "description": "Operating system"
          },
          "browser": {
            "type": "string",
            "description": "Browser"
          },
          "resolution": {
            "type": "string",
            "description": "Screen resolution"
