    "/api/zapier/subscription/{action}": {
      "post": {
        "operationId": "createSubscription",
        "summary": "Subscribe to a webhook",
        "description": "Creates a webhook subscription for the specified action trigger.",
        "tags": ["Webhooks"],
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "description": "Trigger action name",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["bug-created", "bug-updated-comment", "bug-updated-info", "bug-updated-sc", "bug-updated-status", "project-updated-info"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "webhook_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Webhook URL to receive notifications"
                  }
                },
                "required": ["webhook_url"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSubscription",
        "summary": "Unsubscribe from a webhook",
        "description": "Removes a webhook subscription for the specified action trigger.",
        "tags": ["Webhooks"],
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "description": "Trigger action name",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["bug-created", "bug-updated-comment", "bug-updated-info", "bug-updated-sc", "bug-updated-status", "project-updated-info"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "webhook_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Webhook URL to unsubscribe"
                  }
                },
                "required": ["webhook_url"]
              }
            }
          }
        },
        "responses": {
          "200": {
