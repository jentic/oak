          },
          {
            "name": "offset",
            "description": "offset in the result list",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "channel",
            "description": "channel designation",
            "in": "query",
            "required": false,
