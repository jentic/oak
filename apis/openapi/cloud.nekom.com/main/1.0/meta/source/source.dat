    "HistoricalOrder": {
      "type": "object",
      "properties": {
        "orderType": {
          "type": "string",
          "description": "order type; accepted values: order"
        },
        "customer": {
          "$ref": "#/definitions/Customer",
          "description": "customer data; if customer.uuid is set, customer will be matched by UUID; if customer.email is set, customer will be matched by e-mail address; otherwise, new customer will be created; not used: gender, birth date, addresses"
        },
        "billingAddress": {
          "$ref": "#/definitions/Address",
          "description": "billing address data; not used: city add-on"
        },
        "shippingAddress": {
          "$ref": "#/definitions/Address",
          "description": "shipping address data; not used: city add-on"
        },
        "shippingTypeUuid": {
          "type": "string",
          "description": "shipping type UUID"
        },
        "shippingType": {
          "type": "string",
          "description": "shipping type description; evaluated if shippingTypeUuid is empty"
        },
        "paymentTypeUuid": {
          "type": "string",
          "description": "payment type UUID"
        },
        "paymentType": {
          "type": "string",
          "description": "payment type designation; evaluated if paymentTypeUUID is empty"
        },
        "paymentReference": {
          "type": "string",
          "description": "the reference number of the PSP"
        },
        "orderNr": {
          "type": "string",
          "format": "int64",
          "description": "order number in NEKOM; if empty, a new order number is generated"
        },
        "externalOrderNr": {
          "type": "string",
          "description": "order number in the external system"
        },
        "orderValueGross": {
          "type": "string",
          "format": "int64",
          "description": "gross order value * 10 000"
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 alphabetic three-letter currency code"
        },
        "voucherAmount": {
          "type": "string",
          "format": "int64",
          "description": "voucher amount * 10 000"
        },
        "orderposition": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Ordersposition"
          },
          "description": "list of order lines; for items, item.uuid or item.itemnumber are used; for storages, only storageUUID is used; not used: position text(s), serial number, tracking link"
        },
        "shippingCosts": {
          "type": "string",
          "format": "int64",
          "description": "shipping cost * 10 000"
        },
        "voucherCode": {
          "type": "string",
          "description": "applied voucher code"
        },
        "affiliateReference": {
          "type": "string",
          "description": "reference to the affiliate network"
        },
        "channelUuid": {
          "type": "string",
          "description": "channel UUID"
        },
        "marketplaceID": {
          "type": "string",
          "description": "external marketplace ID"
        },
        "extOrderID": {
          "type": "string",
          "description": "external order ID; alternative reference to order in the external system"
        },
        "extInvoiceNr": {
          "type": "string",
          "description": "external invoice number"
        },
        "invoiceDate": {
          "type": "string",
          "format": "YYYYMMDD",
          "description": "invoice date"
        },
        "shippingDate": {
          "type": "string",
          "format": "YYYYMMDD",
          "description": "shipping date"
        }
      },
      "description": "Contains historical order data.\n\nAddresses are only added on order (not on customer).\nOnly billing address is required, shipping address will be created as a copy.\nFor new customers, customer addresses will be created from order address(es).",
      "title": "HistoricalOrder"
    },
