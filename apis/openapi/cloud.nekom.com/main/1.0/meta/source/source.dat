    "OrderRequest": {
      "type": "object",
      "example": {
        "externalordernr": "c1a6a8fc-a8a9-4a2a-0f3e-a355c02d7819",
        "customer": {
          "email": "test+100@nekom.com",
          "firstname": "Carsten",
          "lastname": "test",
          "customerid": "9999999"
        },
        "orderType": "order",
        "shippingType": "DHL",
        "paymentType": "Rechnung",
        "orderValueGross": "299900",
        "currency": "EUR",
        "channel": "commercetools",
        "orderposition": [
          {
            "item": {
              "itemnumber": "1050-1003"
            },
            "itemdescription": null,
            "orderquantity": 1,
            "sellingprice": 299900,
            "positionvalue": 299900,
            "taxrate": 19
          }
        ],
        "billingAddress": {
          "firstName": "Carsten",
          "lastName": "test",
          "addressType": "B",
          "street": "5",
          "houseNr": "5",
          "city": "Gescher",
          "zip": "48712",
          "country": "Deu"
        },
        "shippingAddress": {
          "firstName": "Carsten",
          "lastName": "test",
          "addressType": "S",
          "street": "Am Campus",
          "houseNr": "5",
          "city": "Gescher",
          "zip": "48712",
          "country": "Deu"
        }
      },
      "properties": {
        "orderType": {
          "type": "string",
          "description": "order type; accepted values: order, shippingonly, refund, goodwill,dispo",
          "title": "order=Order, refund=Credit"
        },
        "customer": {
          "$ref": "#/definitions/Customer",
          "description": "customer data for this order"
        },
        "billingAddress": {
          "$ref": "#/definitions/Address",
          "description": "the billing address used for this order"
        },
        "shippingAddress": {
          "$ref": "#/definitions/Address",
          "description": "the shipping address used for this order"
        },
        "shippingType": {
          "type": "string",
          "example": "dhl_de",
          "description": "shipping type; short description or external ID can be used"
        },
        "paymentType": {
          "type": "string",
          "example": "Apple Pay",
          "description": "payment type; designation or ID can be used"
        },
        "paymentReference": {
          "type": "string",
          "description": "the reference number of the PSP"
        },
        "ordernr": {
          "type": "string",
          "format": "int64",
          "description": "the order number used in the system where order was created; if empty, a new order number is generated"
        },
        "externalOrderNr": {
          "type": "string",
          "description": "alternative reference for order number from the calling system"
        },
        "orderValueGross": {
          "type": "string",
          "format": "gross order value * 10 000",
          "description": "gross order value"
        },
        "orderDate": {
          "type": "string",
          "format": "int64",
          "title": "the order creation date in format YYYYMMDD; not used"
        },
        "orderTime": {
          "type": "string",
          "format": "int64",
          "title": "the order creation time in format HHMMSS; not used"
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 alphabetic three-letter currency code"
        },
        "voucherAmount": {
          "type": "string",
          "format": "voucher amount * 10 000",
          "description": "voucher amount used in this order"
        },
        "orderposition": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Ordersposition"
          },
          "description": "list of order lines"
        },
        "shippingcosts": {
          "type": "string",
          "format": "shipping cost * 10 000",
          "description": "shipping cost amount for this order"
        },
        "vouchercode": {
          "type": "string",
          "description": "voucher code of the applied voucher"
        },
        "mincartamount": {
          "type": "string",
          "format": "minimum cart amount * 10 000",
          "description": "minimum cart amount for applying the voucher"
        },
        "affiliatereference": {
          "type": "string",
          "description": "reference to the affiliate network where the order is coming from"
        },
        "channel": {
          "type": "string",
          "description": "channel uuid or designation",
          "title": "channel uuid or designation"
        },
        "clientorderstatus": {
          "type": "string",
          "description": "client order status designation"
        },
        "marketplaceID": {
          "type": "string",
          "description": "Stores external marketplace ID"
        },
        "masterorderUUID": {
          "type": "string",
          "description": "references a related order; mandatory for GS orders"
        },
        "isDirectOrder": {
          "type": "boolean",
          "description": "direct order flag"
        },
        "extorderid": {
          "type": "string",
          "description": "external order id"
        },
        "text": {
          "type": "string",
          "description": "order additional text"
        },
        "orderreferenceUuids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "list of order uuids which shall be referenced with this order"
        },
        "createInStatusNew": {
          "type": "boolean",
          "description": "creates the order in status \"NEW\" instead of \"IMPORTED\""
        },
        "isGuestOrder": {
          "type": "boolean",
          "description": "guest order flag"
        },
        "giftCardPaidAmount": {
          "type": "string",
          "format": "gift card amount * 10 000",
          "description": "amount paid by gift card"
        },
        "eventOrderStatuses": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/EventOrderstatus"
          },
          "description": "list of assigned event-orderstatuses"
        },
        "nomailsend": {
          "type": "boolean",
          "description": "do not send an email for this order"
        }
      },
      "title": "OrderRequest"
    },
    "OrderResponse": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "description": "the order UUID"
        },
        "aktiv": {
          "type": "string",
          "format": "int64",
          "description": "1=exists, 0=deleted"
        },
        "orderType": {
          "type": "string",
          "description": "The type of this order (order, refund, goodwill (only money is returend, no stock change),shippingonly (only product are transfered without invoice)"
        },
        "customer": {
          "$ref": "#/definitions/Customer",
          "description": "customer data for this order"
        },
        "orderNr": {
          "type": "string",
          "format": "int64",
          "description": "NEKOM order number "
        },
        "billingAddress": {
          "$ref": "#/definitions/Address",
          "description": "billing address used for this order"
        },
        "shippingAddress": {
          "$ref": "#/definitions/Address",
          "description": "shipping address used for this order"
        },
        "shippingType": {
          "type": "string",
          "description": "shipping type"
        },
        "paymentType": {
          "type": "string",
          "description": "payment type"
        },
        "paymentReference": {
          "type": "string",
          "description": "the payment reference number of the PSP"
        },
        "externalOrderNr": {
          "type": "string",
          "description": "order number used in the system where order was created"
        },
        "orderStatus": {
          "type": "string",
          "format": "int64",
          "description": "the status code of the order (10=NEW,20=BILLED,3=SHIPPED,5=WAIT FOR PREPAYMENT,98=CANCELED,80=ERROR)"
        },
        "invoiceNr": {
          "type": "string",
          "format": "int64",
          "description": "invoice number, in case the invoice is already created"
        },
        "invoiceDate": {
          "type": "string",
          "format": "YYYYMMDD",
          "description": "invoice date"
        },
        "orderValueGross": {
          "type": "string",
          "format": "gross order value * 10 000",
          "description": "gross order value"
        },
        "shippingDate": {
          "type": "string",
          "format": "YYYYMMDD",
          "description": "shipping date"
        },
        "shippingTime": {
          "type": "string",
          "format": "HHMMSS",
          "description": "shipping time"
        },
        "shippingCosts": {
          "type": "string",
          "format": "shipping cost * 10 000",
          "description": "shipping cost amount for this order"
        },
        "orderDate": {
          "type": "string",
          "format": "YYYYMMDD",
          "description": "order creation date"
        },
        "orderTime": {
          "type": "string",
          "format": "HHMMSS",
          "description": "order creation time"
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 alphabetic three-letter currency code"
        },
        "billingDate": {
          "type": "string",
          "format": "int64",
          "description": "the date when the billing has been done"
        },
        "creditNr": {
          "type": "string",
          "format": "int64",
          "description": "credit number, in case the order type is refund"
        },
        "voucherAmount": {
          "type": "string",
          "format": "voucher amount * 10 000",
          "description": "voucher amount used in this order"
        },
        "orderposition": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Ordersposition"
          },
          "description": "list of order lines"
        },
        "channel": {
          "type": "string",
          "description": "channel designation"
        },
        "shipcomplete": {
          "type": "boolean",
          "description": "flags if partial shipping allowed"
        },
        "minvoucheramount": {
          "type": "string",
          "format": "min voucher amount * 10 000",
          "description": "amount deciding whether voucher will get returned or not"
        },
        "vouchercode": {
          "type": "string",
          "description": "voucher code of the applied voucher"
        },
        "supplier": {
          "$ref": "#/definitions/Supplier",
          "description": "the supplier of this order (used in case the order is a dispo order)"
        },
        "b2b": {
          "type": "boolean",
          "description": "If true the order is an B2B order"
        },
        "ordertext": {
          "type": "string",
          "description": "last additional text of the order which can be printed on the invoice"
        },
        "orderValuenet": {
          "type": "string",
          "format": "net order value * 10 000",
          "description": "net order value"
        },
        "shippingTypeuuid": {
          "type": "string",
          "description": "shipping type UUID"
        },
        "extorderid": {
          "type": "string",
          "description": "external order ID from shop system or others"
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "list of order additional texts"
        },
        "clientOrderStatus": {
          "$ref": "#/definitions/ClientOrderStatus",
          "description": "detail order status which describes more detail information then the orderstatus"
        },
        "estimatedDeliveryDate": {
          "type": "string",
          "description": "estimated delivery date, order will not be billed before this date"
        },
        "channeluuid": {
          "type": "string",
          "description": "uuid of the assigned channel"
        },
        "isCashRegister": {
          "type": "boolean",
          "description": "true = cash register order, false = non-cash register order"
        },
        "typeOfPaymentTypeOrdinal": {
          "type": "integer",
          "format": "int32",
          "description": "java enum ordinal as stored in z_payment.type (see WALLETDATA_TYPE in nekom-backend)"
        },
        "eventOrderstatuses": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/EventOrderstatus"
          },
          "description": "List of order related events"
        },
        "extInvoiceNr": {
          "type": "string",
          "description": "External invoice number"
        },
        "marketplaceId": {
          "type": "string",
          "description": "External marketplace ID"
        },
        "billingTime": {
          "type": "string",
          "format": "int64",
          "description": "the time when the billing has been done"
        },
        "paymentTypeUuid": {
          "type": "string",
          "description": "uuid of the assigned payment"
        },
        "invoiceCorrectionAllowed": {
          "type": "boolean",
          "description": "flag if invoice correction process can be applied"
        }
      },
