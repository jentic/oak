    "/api/v1/orders/logs": {
      "get": {
        "summary": "Get order logs.",
        "description": "Returns last 40 created, order-specific web service logs.\nIf no search value is given, only logs with non-empty message texts are returned.\nIf a search value is given, it is compared to orders' external IDs or searched for within request body.\n\nNOTE: Request fields other than 'searchvalue' are disregarded.",
        "operationId": "OrdersConnector_getOrderLog",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/OrderLogResponse"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "searchvalue",
            "description": "text value for searching",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "description": "order status code number; see StatusUpdateRequest",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "description": "search result offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "description": "search result limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "creditNotes",
            "description": "search for credit notes",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "sortAsc",
            "description": "ascending takes precedence over descending\n\nsort columns in ascending order",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "UUID",
                "CHANNEL",
                "ORDER_TYPE",
                "ORDER_NR",
                "ORDER_DATE",
                "COMPANY",
                "LAST_NAME",
                "FIRST_NAME",
                "STREET",
                "HOUSE_NR",
                "ZIP",
                "CITY",
                "COUNTRY",
                "NUM_POSITIONS",
                "ORDER_VALUE_GROSS",
                "ORDER_VALUE_NET",
                "CLIENT_ORDER_STATUS",
                "INVOICE_DATE",
                "INVOICE_NR",
                "PAYMENT_TYPE",
                "PAYMENT_REFERENCE",
                "SHIPPING_TYPE",
                "SHIPPING_COSTS",
                "BILLING_DATE",
                "SHIPPING_DATE",
                "VOUCHER_AMOUNT",
                "EXT_ORDER_ID"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "sortDesc",
            "description": "sort columns in descending order",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "UUID",
                "CHANNEL",
                "ORDER_TYPE",
                "ORDER_NR",
                "ORDER_DATE",
                "COMPANY",
                "LAST_NAME",
                "FIRST_NAME",
                "STREET",
                "HOUSE_NR",
                "ZIP",
                "CITY",
                "COUNTRY",
                "NUM_POSITIONS",
                "ORDER_VALUE_GROSS",
                "ORDER_VALUE_NET",
                "CLIENT_ORDER_STATUS",
                "INVOICE_DATE",
                "INVOICE_NR",
                "PAYMENT_TYPE",
                "PAYMENT_REFERENCE",
                "SHIPPING_TYPE",
                "SHIPPING_COSTS",
                "BILLING_DATE",
                "SHIPPING_DATE",
                "VOUCHER_AMOUNT",
                "EXT_ORDER_ID"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "orderDateFrom",
            "description": "filter order date from (inclusive)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "orderDateTo",
            "description": "filter order date to (exclusive)",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "channel",
            "description": "filter channel",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "orderType",
            "description": "filter order type",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "shippingType",
            "description": "filter shipping type uuid",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "paymentType",
            "description": "filter payment type uuid",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "storageName",
            "description": "filter storage name",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "clientOrderStatus",
            "description": "filter client order status uuid",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "statuses",
            "description": "filter order statuses, superceeds status",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "updatedInLastH",
            "description": "filter orders updated in last n hours",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "filterpartiallycanceled",
            "description": "filter orders which are partially canceled",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "currency",
            "description": "filter currency",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      }
    },
