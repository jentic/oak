  "definitions": {
    "AddOrderTextRequest": {
      "type": "object",
      "properties": {
        "orderUUID": {
          "type": "string",
          "description": "order UUID to assign the text to",
          "title": "order UUID to assign the text to; required"
        },
        "text": {
          "type": "string",
          "description": "order text content",
          "title": "order text content; required; 510 characters max",
          "maxLength": 510
        },
        "flag": {
          "type": "boolean",
          "description": "boolean flag",
          "title": "boolean flag"
        },
        "flagValue": {
          "type": "integer",
          "format": "int32",
          "description": "flag defining order text type"
        }
      },
      "description": "Request for creating a new order text record",
      "title": "AddOrderTextRequest",
      "required": [
        "orderUUID",
        "text"
      ]
    },
    "AddPositionTextRequest": {
      "type": "object",
      "properties": {
        "positionUUID": {
          "type": "string",
          "description": "order position UUID to assign the text to",
          "title": "order position UUID to assign the text to; required"
        },
        "text": {
          "type": "string",
          "description": "order position text content",
          "title": "order position text content; required; 510 characters max",
          "maxLength": 510
        },
        "flag": {
          "type": "boolean",
          "description": "boolean flag",
          "title": "boolean flag"
        }
      },
      "description": "Request for creating a new order position text record",
      "title": "AddPositionTextRequest",
      "required": [
        "positionUUID",
        "text"
      ]
    },
    "Address": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "description": "address UUID"
        },
        "firstName": {
          "type": "string",
          "description": "first name of the customer"
        },
        "lastName": {
          "type": "string",
          "description": "last name of the customer"
        },
        "addressType": {
          "type": "string",
          "description": "address type; accepted values: B, S",
          "title": "B=Billing address, S=Shipping address"
        },
        "street": {
          "type": "string",
          "description": "street name"
        },
        "houseNr": {
          "type": "string",
          "description": "house number"
        },
        "city": {
          "type": "string",
          "description": "city name"
        },
        "zip": {
          "type": "string",
          "description": "zip/postal code"
        },
        "country": {
          "type": "string",
          "example": "DEU",
          "description": "ISO 3166-1 alpha-3 three-letter country code"
        },
        "forAttention": {
          "type": "string",
          "description": "for attention of the customer"
        },
        "cityAddon": {
          "type": "string",
          "description": "city add-on data"
        },
        "streetAddon": {
          "type": "string",
          "description": "street add-on data"
        },
        "company": {
          "type": "string",
          "description": "company name"
        },
        "countryuuid": {
          "type": "string",
          "description": "country UUID"
        },
        "stateUuid": {
          "type": "string",
          "description": "country's state UUID"
        },
        "stateIso": {
          "type": "string",
          "description": "country's state ISO code"
        },
        "uid": {
          "type": "string",
          "description": "VAT ID for address. If not filled -> customer's UID is taken as a default. Can be used to specify a different VAT ID for shipping address. Gets stored only for delivery/shipping address."
        },
        "email": {
          "type": "string",
          "description": "email of this specific address"
        },
        "phone": {
          "type": "string",
          "description": "phone of this specific address"
        }
      },
      "title": "Address"
    },
    "AlreadyRefundedResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "errorMessage": {
          "type": "string"
        },
        "errorType": {
          "type": "string"
        },
        "alreadyrefundedamount": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "ClientOrderStatus": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "description": "detail order status UUID"
        },
        "designation": {
          "type": "string",
          "description": "detail order status designation"
        }
      },
      "title": "ClientOrderStatus"
    },
    "CopyOrderRequest": {
      "type": "object",
      "properties": {
        "orderUuid": {
          "type": "string",
          "description": "order UUID to be copied"
        }
      },
      "title": "CopyOrderRequest",
      "required": [
        "orderUuid"
      ]
    },
    "CreateDirectOrderResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "success indicates of the requested operation was successful"
        },
        "errorMessage": {
          "type": "string",
          "description": "error message gives additional information about the error"
        },
        "errorType": {
          "$ref": "#/definitions/DIRECT_ORDER_ERROR_TYPE",
          "description": "specific error info"
        },
        "orderUuid": {
          "type": "string",
          "description": "order UUID"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Document"
          },
          "description": "list of documents created during order processing (invoice etc.)"
        }
      }
    },
    "CreateResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "success indicates of the requested operation was successful"
        },
        "errorMessage": {
          "type": "string",
          "description": "error message gives additional information about the error"
        },
        "errorType": {
          "type": "string",
          "description": "HTTP style error type"
        },
        "orderUuid": {
          "type": "string",
          "description": "order UUID"
        },
        "customerUuid": {
          "type": "string",
          "description": "customer UUID"
        },
        "directOrderErrorType": {
          "$ref": "#/definitions/DIRECT_ORDER_ERROR_TYPE",
          "description": "specific error info while creating a direct order"
        }
      },
