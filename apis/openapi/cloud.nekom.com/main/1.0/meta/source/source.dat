    },
    "UpdatePositionTextRequest": {
      "type": "object",
      "properties": {
        "UUID": {
          "type": "string",
          "description": "order position text UUID",
          "title": "order position text UUID"
        },
        "text": {
          "type": "string",
          "description": "order position text content",
          "title": "order position text content"
        },
        "flag": {
          "type": "boolean",
          "description": "boolean flag",
          "title": "boolean flag"
        }
      },
      "description": "Request for updating an existing order position text",
      "title": "UpdatePositionTextRequest"
    },
    "UploadDocumentRequest": {
      "type": "object",
      "properties": {
        "ordernr": {
          "type": "string",
          "format": "int64",
          "description": "order number",
          "title": "order number"
        },
        "extordernr": {
          "type": "string",
          "description": "external order number",
          "title": "external order number, aka 'extorderid'"
        },
        "orderuuid": {
          "type": "string",
          "description": "order UUID",
          "title": "order UUID"
        },
        "file": {
          "type": "string",
          "description": "document content; base 64 encoded",
          "title": "document content; base 64 encoded"
        },
        "filetype": {
          "$ref": "#/definitions/DocumentDocType",
          "description": "document type",
          "title": "document type"
        },
        "filenameSuffix": {
          "type": "string",
          "description": "(optional) filename suffix",
          "title": "filename suffix"
        },
        "replaceInvoice": {
          "type": "boolean",
          "description": "when the document is an invoice. replace any current invoice with this one",
          "title": "when the document is an invoice. replace any current invoice with this one"
        }
      },
      "description": "Request for uploading a file for order.\nAt least one order ID is required (ordernr, extordernr or orderuuid).\nNon-empty order IDs are processed in order and multiple order IDs must match (reference the same order).\nAllowed document types: INVOICE, RETURNSLIP, PICKINGSLIP, OTHER (codes: RE, EXRE, LS and OT, respectively).\n\nTODO: [stankovic.s] file extension? @tomasevic.m: use signintech/gopdf",
      "title": "UploadDocumentRequest"
    },
    "logresponse": {
      "type": "object",
      "properties": {
        "externalid": {
          "type": "string",
          "description": "order's external ID"
        },
        "request": {
          "type": "string",
          "description": "request body"
        },
        "message": {
          "type": "string",
          "description": "log message"
        },
        "aldatum": {
          "type": "string",
          "format": "YYYYMMDD",
          "description": "date when log was created"
        },
        "alzeit": {
          "type": "string",
          "format": "HHMMSS",
          "description": "time when log was created"
        }
      },
      "title": "logresponse"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
