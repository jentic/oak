          },
          {
            "name": "orderdatefrom",
            "description": "orderdate start for filtering",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "YYYYMMDD"
          },
          {
            "name": "orderdateto",
            "description": "orderdate end for filtering",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "YYYYMMDD"
          },
          {
            "name": "changedhours",
            "description": "amount of hours we look back since the order has been changed",
