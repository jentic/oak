      "post": {
        "summary": "Upload document for order",
        "description": "Allows uploading and saving document types: INVOICE, RETURNSLIP, PICKINGSLIP, OTHER (codes: RE, EXRE, LS and OT, respectively).\nExpected file types: PDF, image (JPEG, PNG, SVG).\nReturns the saved file's details.",
        "operationId": "OrdersConnector_UploadDocumentForOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/DocumentResponse"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Request for uploading a file for order.\nAt least one order ID is required (ordernr, extordernr or orderuuid).\nNon-empty order IDs are processed in order and multiple order IDs must match (reference the same order).\nAllowed document types: INVOICE, RETURNSLIP, PICKINGSLIP, OTHER (codes: RE, EXRE, LS and OT, respectively).\n\nTODO: [stankovic.s] file extension? @tomasevic.m: use signintech/gopdf",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UploadDocumentRequest"
            }
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      }
    },
