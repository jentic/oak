          "description": "success indicates of the requested operation was successful"
        },
        "errorMessage": {
          "type": "string",
          "description": "error message gives additional information about the error"
        },
        "errorType": {
          "type": "string",
          "description": "HTTP style error type"
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/OrderResponse"
          },
          "description": "order data returned for a successful operation"
        }
      },
      "title": "Response"
    },
    "SerialNumber": {
      "type": "object",
      "properties": {
        "itemserialUuid": {
          "type": "string",
          "description": "if defined -> it gets stored with ordersposition",
          "title": "if defined -> it gets stored with ordersposition"
        },
        "serialnumber": {
          "type": "string",
          "description": "serial number. Used in GET, not used in POST/PUT requests",
          "title": "used in GET, not used in POST/PUT requests"
        }
      }
    },
    "SortColumn": {
      "type": "string",
      "enum": [
        "UUID",
        "CHANNEL",
        "ORDER_TYPE",
        "ORDER_NR",
        "ORDER_DATE",
        "COMPANY",
        "LAST_NAME",
        "FIRST_NAME",
        "STREET",
        "HOUSE_NR",
        "ZIP",
        "CITY",
        "COUNTRY",
        "NUM_POSITIONS",
        "ORDER_VALUE_GROSS",
        "ORDER_VALUE_NET",
        "CLIENT_ORDER_STATUS",
        "INVOICE_DATE",
        "INVOICE_NR",
        "PAYMENT_TYPE",
        "PAYMENT_REFERENCE",
        "SHIPPING_TYPE",
        "SHIPPING_COSTS",
        "BILLING_DATE",
        "SHIPPING_DATE",
        "VOUCHER_AMOUNT",
        "EXT_ORDER_ID"
      ],
      "default": "UUID",
      "title": "SortColumn"
    },
    "SplitPositionByQuantity": {
      "type": "object",
      "properties": {
        "positionUuid": {
          "type": "string"
        },
        "orderQuantities": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "description": "Position defined by positionuuid gets split based on order quantities.\nDelivery quantity of the existing position has to be lower or equal to the FIRST entry in the orderquantity list,\nbecause delivery quantity cannot be split.\nexample: existing position.orderquantity = 15, request: orderQuantities = [5,3,7] --> three positions get created (position.orderquantity = 5, position.orderquantity = 3, position.orderquantity = 7)\nresult: existing position's order quantity gets updated to 5 and two new positions with order quantity 3, respectively 7 gets created."
        }
      }
    },
    "StatusUpdateRequest": {
      "type": "object",
      "properties": {
        "orderuuid": {
          "type": "string",
          "description": "order UUID"
        },
        "status": {
          "type": "string",
          "format": "int64",
          "description": "new status code number; accepted values:<br>1 cleared<br>2 check address<br>3 sent<br>4 wait for payment confirmation<br>5 pre-payment to pay<br>10 new<br>11 imported<br>15 partially billed<br>20 billed<br>31 sent imported<br>32 sent pick-up<br>40 offer open<br>41 offer OK<br>42 offer finished<br>65 partially delivered<br>70 delivered<br>80 error<br>98 cancel<br>99 in billing"
        },
        "username": {
          "type": "string",
          "description": "username of the changing user"
        },
        "text": {
          "type": "string",
          "description": "order additional text"
        }
      },
      "title": "StatusUpdateRequest"
    },
    "StorageplaceData": {
      "type": "object",
      "properties": {
        "storageplaceuuid": {
          "type": "string",
          "description": "storageplace UUID"
        },
        "storageplacename": {
          "type": "string",
          "description": "storageplace name"
        },
        "storageuuid": {
          "type": "string",
          "description": "storage UUID"
        },
        "storagename": {
          "type": "string",
          "description": "storage name"
        }
      }
    },
    "Supplier": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "description": "supplier UUID"
        },
        "sid": {
          "type": "string",
          "description": "supplier ID"
        },
        "name1": {
          "type": "string",
          "description": "supplier name (part 1)"
        },
        "name2": {
          "type": "string",
          "description": "supplier name (part 2)"
        },
        "email": {
          "type": "string",
          "description": "contact e-mail address"
        },
        "internalSupplier": {
          "type": "boolean",
          "description": "flags if the supplier is only used internally"
        },
        "supplyment": {
          "type": "string",
          "description": "supply method, e.g. cross-docking"
        },
        "shippingTime": {
          "type": "string",
          "format": "int64",
          "description": "shipping time in days"
        },
        "address": {
          "$ref": "#/definitions/Address",
          "description": "supplier address"
        }
      },
      "title": "Supplier"
    },
    "TourUpdateRequest": {
      "type": "object",
