{
  "swagger": "2.0",
  "info": {
    "title": "NEKOM Orders API",
    "description": "With this API it is possible to get different information about orders from the NEKOM system. To get access to this order you   need the clientuuid and the token of the interface user of this client.",
    "version": "1.0",
    "contact": {
      "name": "Stefan Kahr",
      "email": "kahr.s@nekom.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/nekomccgmbh/nekom-orders-api/1.0"
  },
  "tags": [
    {
      "name": "OrdersConnector"
    }
  ],
  "host": "cloud.nekom.com",
  "basePath": "/app1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/directorders": {
      "get": {
        "summary": "Check direct order configuration.",
        "description": "Returns the current status of the direct order configuration.\nContains info on whether the direct order configuration is ready for use, and a reason for why if not.",
        "operationId": "OrdersConnector_getDirectOrderConfiguration",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/DirectOrderCheckResponse"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "OrdersConnector"
        ]
      },
      "post": {
        "summary": "Create new direct order.",
        "description": "A single Customer/paymenttype/tour exists for a client. These entities are used for the order creation.\nCustomer can be adjusted via email address. If email address is specified a customer based on this address is used.\nTypically used when customer buys product(s) directly in a physical store.",
        "operationId": "OrdersConnector_createDirectOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/CreateDirectOrderResponse"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DirectOrderRequest"
            }
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      }
    },
    "/api/v1/orders": {
      "get": {
        "summary": "Get orders by status code.",
        "description": "Returns a list of orders with order positions for given status code (and, optionally, channel designation).\nReturns up to 50 AU and LIAU orders.",
        "operationId": "OrdersConnector_getOrdersByStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "status",
            "description": "order status code",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "description": "offset in the result list",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "channel",
            "description": "channel designation",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "orderdatefrom",
            "description": "orderdate start for filtering",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "YYYYMMDD"
          },
          {
            "name": "orderdateto",
            "description": "orderdate end for filtering",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "YYYYMMDD"
          },
          {
            "name": "changedhours",
            "description": "amount of hours we look back since the order has been changed",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      },
      "post": {
        "summary": "Create new order.",
        "description": "Creates a new order for given data.\nExisting customer data is updated.New customer is created if it doesn't already exist.\nReturns newly created order UUID and customer UUID.",
        "operationId": "OrdersConnector_createOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/CreateResponse"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OrderRequest"
            }
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      }
    },
    "/api/v1/orders/addposition": {
      "post": {
        "summary": "Add order position",
        "description": "Adds a new order position to an existing order with given data.",
        "operationId": "OrdersConnector_addOrderposition",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/OrderpositionAddResponse"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OrderpositionAddRequest"
            }
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      }
    },
    "/api/v1/orders/copy": {
      "post": {
        "summary": "Copy order.",
        "description": "Creates a copy of the given order with a new order number and without an invoice.\nReturns the new order.",
        "operationId": "OrdersConnector_copyOrder",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CopyOrderRequest"
            }
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      }
    },
    "/api/v1/orders/copy/{orderUuid}": {
      "post": {
        "summary": "Copy order.",
        "description": "Creates a copy of the given order with a new order number and without an invoice.\nReturns the new order.",
        "operationId": "OrdersConnector_copyOrder2",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          },
          "400": {
            "description": "Returned if the request does not contain adequate parameters.",
            "schema": {}
          },
          "401": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {}
          },
          "404": {
            "description": "Returned if there is no entity that matches requested parameters.",
            "schema": {}
          },
          "500": {
            "description": "Returned if the service as encountered an internal error.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "orderUuid",
            "description": "order UUID to be copied",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "OrdersConnector"
        ]
      }
    },
    "/api/v1/orders/credits": {
      "get": {
        "summary": "Get credit orders by status code.",
        "description": "Returns a list of orders with order positions for given status code (and, optionally, channel designation).\nReturns up to 50 GW and GS orders.",
        "operationId": "OrdersConnector_getCreditOrdersByStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
