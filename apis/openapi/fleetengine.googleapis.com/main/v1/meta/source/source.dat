      "get": {
        "description": "Gets all `DeliveryVehicle`s that meet the specified filtering criteria.",
        "operationId": "fleetengine.providers.deliveryVehicles.list",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
