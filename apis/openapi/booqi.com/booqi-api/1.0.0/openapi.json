        }
      },
      "delete": {
        "operationId": "cancelOrderTicket",
        "summary": "Cancel single ticket",
        "tags": ["Orders"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "ticket_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
