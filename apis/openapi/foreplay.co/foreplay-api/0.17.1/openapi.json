{
  "openapi": "3.0.3",
  "info": {
    "title": "Foreplay Public API",
    "version": "0.17.1",
    "description": "Programmatic search, filter, and analysis of ads and brands database.",
    "x-jentic-source-url": "https://docs.foreplay.co/"
  },
  "servers": [
    {
      "url": "https://public.api.foreplay.co"
    }
