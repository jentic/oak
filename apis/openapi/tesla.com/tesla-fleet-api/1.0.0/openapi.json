  "components": {
    "schemas": {
      "VehicleListResponse": {
        "type": "object",
        "properties": {
          "response": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vehicle"
            }
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "VehicleResponse": {
        "type": "object",
        "properties": {
          "response": {
            "$ref": "#/components/schemas/Vehicle"
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "vehicle_id": {
            "type": "integer"
          },
          "vin": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "online",
              "asleep",
              "offline"
            ]
          },
          "access_type": {
            "type": "string"
          }
        }
      },
      "VehicleDataResponse": {
        "type": "object",
        "properties": {
          "response": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "vehicle_id": {
                "type": "integer"
              },
              "vin": {
                "type": "string"
              },
              "charge_state": {
                "type": "object"
              },
              "climate_state": {
                "type": "object"
              },
              "drive_state": {
                "type": "object"
              },
              "gui_settings": {
                "type": "object"
              },
              "vehicle_state": {
                "type": "object"
              },
              "vehicle_config": {
                "type": "object"
              }
            }
          }
        }
      },
      "CommandResponse": {
        "type": "object",
        "properties": {
          "response": {
            "type": "object",
            "properties": {
              "result": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.tesla.com/oauth2/v3/authorize",
            "tokenUrl": "https://auth.tesla.com/oauth2/v3/token",
            "scopes": {
              "openid": "OpenID",
              "vehicle_device_data": "Vehicle data",
              "vehicle_cmds": "Vehicle commands",
              "vehicle_charging_cmds": "Charging commands",
              "energy_device_data": "Energy data"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": []
    }
  ]
}