{
  "openapi": "3.0.3",
  "info": {
    "title": "Tesla Fleet API",
    "version": "1.0.0",
    "description": "Tesla Fleet API for vehicle management, charging, energy products, and fleet operations. Provides endpoints for vehicle commands, state queries, telemetry, and partner integration.",
    "x-jentic-source-url": "https://developer.tesla.com/docs/fleet-api"
  },
  "servers": [
    {
      "url": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1"
    }
  ],
  "paths": {
    "/vehicles": {
      "get": {
        "operationId": "listVehicles",
        "summary": "List all vehicles",
        "description": "Returns a list of vehicles associated with the authenticated account.",
        "tags": [
          "Vehicles"
        ],
        "responses": {
          "200": {
            "description": "Vehicle list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/{id}": {
      "get": {
        "operationId": "getVehicle",
        "summary": "Get vehicle details",
        "tags": [
          "Vehicles"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/{id}/vehicle_data": {
      "get": {
        "operationId": "getVehicleData",
        "summary": "Get all vehicle data",
        "description": "Returns all data points for the vehicle including charge state, climate state, drive state, GUI settings, and vehicle state.",
        "tags": [
          "Vehicles"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endpoints",
            "in": "query",
            "description": "Semicolon-separated list of data endpoints to fetch",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleDataResponse"
