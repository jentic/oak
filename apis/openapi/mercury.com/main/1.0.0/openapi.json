    "/organization": {
      "get": {
        "operationId": "getOrganization",
        "summary": "Get organization information",
        "description": "Retrieve information about the authenticated Mercury organization, including legal business name and DBAs.",
        "tags": [
          "Organization"
        ],
        "responses": {
          "200": {
            "description": "Organization information.",
