{
  "openapi": "3.0.3",
  "info": {
    "title": "PayPal Subscriptions API",
    "version": "1.0",
    "description": "PayPal Subscriptions API enables creation and management of subscription billing plans and subscriptions.",
    "x-jentic-source-url": "https://developer.paypal.com/docs/api/subscriptions/v1/"
  },
  "servers": [
    {
      "url": "https://api-m.paypal.com/v1"
    }
  ],
