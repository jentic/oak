    "/billing/subscriptions/{subscriptionId}/transactions": {
      "get": {
        "operationId": "listSubscriptionTransactions",
        "summary": "List subscription transactions",
        "tags": [
          "Subscriptions"
        ],
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "required": true,
