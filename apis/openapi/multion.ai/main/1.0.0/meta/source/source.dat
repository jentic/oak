{
  "openapi": "3.0.3",
  "info": {
    "title": "MultiOn Web API",
    "description": "MultiOn provides agent browser control capabilities, allowing AI agents to browse the web, extract data, and manage browser sessions programmatically using natural language commands.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.multion.ai/",
    "x-provenance": "vendor-official"
  },
  "servers": [
    {
      "url": "https://api.multion.ai/v1/web"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/browse": {
      "post": {
        "operationId": "browse",
        "summary": "Browse the web using natural language commands",
        "description": "Allows for browsing the web using detailed natural language commands. Supports multi-step command execution based on the CONTINUE status of the Agent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cmd"],
                "properties": {
                  "cmd": {
                    "type": "string",
                    "description": "A specific natural language instruction for the agent to execute"
                  },
                  "url": {
                    "type": "string",
                    "description": "The URL to start or continue browsing from. Default: google.com"
                  },
                  "local": {
                    "type": "boolean",
                    "description": "If true, session runs locally via Chrome extension. If false, runs in cloud. Default: false"
                  },
                  "session_id": {
                    "type": "string",
                    "description": "Continues the session with session_id if provided"
                  },
                  "max_steps": {
                    "type": "integer",
                    "default": 20,
                    "description": "Maximum number of steps to execute. Default: 20"
                  },
                  "include_screenshot": {
                    "type": "boolean",
                    "description": "Include a screenshot of the final page. Default: false"
                  },
                  "temperature": {
                    "type": "number",
                    "format": "double",
                    "description": "The temperature of the model"
                  },
                  "agent_id": {
                    "type": "string",
                    "description": "The agent id to use for the session"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["fast", "standard"],
                    "description": "The mode for the session: fast or standard"
                  },
                  "use_proxy": {
                    "type": "boolean",
                    "description": "Use a proxy for the session. Each session gets a new Residential IP. Default: false"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful browse result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowseOutput"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/retrieve": {
      "post": {
        "operationId": "retrieve",
        "summary": "Retrieve data from a webpage using natural language",
        "description": "Retrieve structured data from a webpage based on a URL and natural language command that guides the agent's data extraction process.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cmd"],
                "properties": {
                  "cmd": {
                    "type": "string",
                    "description": "A specific natural language instruction on data the agent should extract"
                  },
                  "url": {
                    "type": "string",
                    "description": "The URL to create or continue session from"
                  },
                  "session_id": {
                    "type": "string",
                    "description": "Continues the session with session_id if provided"
                  },
                  "local": {
                    "type": "boolean",
                    "description": "Run locally via Chrome extension if true. Default: false"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of fields (columns) to be outputted in data"
                  },
                  "format": {
                    "type": "string",
                    "enum": ["json", "markdown"],
                    "description": "The format of the response data. Default: json"
                  },
                  "max_items": {
                    "type": "number",
                    "default": 100,
                    "description": "Maximum number of data items to retrieve. Default: 100"
                  },
                  "full_page": {
                    "type": "boolean",
                    "description": "Retrieve full page. Default: true"
                  },
                  "render_js": {
                    "type": "boolean",
                    "description": "Include rich JS and ARIA elements in data. Default: false"
                  },
                  "scroll_to_bottom": {
                    "type": "boolean",
                    "description": "Scroll to bottom of page before extraction. Default: false"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["standard", "fast", "ludicrous"],
                    "default": "fast",
                    "description": "Session mode: standard, fast, or ludicrous"
                  },
                  "include_screenshot": {
                    "type": "boolean",
                    "description": "Include a screenshot with the response. Default: false"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful data retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrieveOutput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/session": {
      "post": {
        "operationId": "createSession",
        "summary": "Create a new browser session",
        "description": "Creates a new session and returns session details including a unique session ID. A session remains active for 10 minutes of inactivity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "The URL to create the session from"
                  },
                  "local": {
                    "type": "boolean",
                    "description": "Run locally via Chrome extension if true. Default: false"
                  },
                  "agent_id": {
                    "type": "string",
                    "description": "The agent id to use for the session"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["fast", "standard"],
                    "description": "Session mode: fast or standard"
                  },
                  "use_proxy": {
                    "type": "boolean",
                    "description": "Use a proxy for the session. Default: false"
                  },
                  "browser_params": {
                    "type": "object",
                    "properties": {
                      "height": {
                        "type": "number"
                      },
                      "width": {
                        "type": "number"
                      }
                    },
                    "description": "Browser screen size dimensions"
                  },
                  "include_screenshot": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/session/{session_id}": {
      "post": {
        "operationId": "stepSession",
        "summary": "Execute a step in a browser session",
        "description": "Execute a browsing step using natural language instructions within an existing session.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The session ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cmd", "stream"],
                "properties": {
                  "cmd": {
                    "type": "string",
                    "description": "A specific natural language instruction for the next step"
                  },
                  "stream": {
                    "type": "boolean",
                    "description": "Stream results back to the client"
                  },
                  "url": {
                    "type": "string",
                    "description": "The URL to continue session from"
                  },
                  "temperature": {
                    "type": "number",
                    "format": "double",
                    "description": "The temperature of the model"
                  },
                  "agent_id": {
                    "type": "string",
                    "description": "The agent id to use for the session"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["fast", "standard"],
                    "description": "Session mode: fast or standard"
                  },
                  "include_screenshot": {
                    "type": "boolean"
                  },
                  "browser_params": {
                    "type": "object",
                    "properties": {
                      "height": {
                        "type": "number"
                      },
                      "width": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Step result (streamed or non-streamed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStepSuccess"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "closeSession",
        "summary": "Close a browser session",
        "description": "Closes the specified browser session.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The session ID to close"
          }
        ],
        "responses": {
          "200": {
            "description": "Session closed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/screenshot/{session_id}": {
      "get": {
        "operationId": "getScreenshot",
        "summary": "Get a screenshot of a session",
        "description": "Retrieve a screenshot of the current state of the browser session.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The session ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Screenshot retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "screenshot": {
                      "type": "string",
                      "description": "Image URL of the screenshot"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "operationId": "listSessions",
        "summary": "List active browser sessions",
        "description": "Retrieve a list of active session IDs.",
        "responses": {
          "200": {
            "description": "List of sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of active session IDs"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BrowseOutput": {
        "type": "object",
        "required": ["message", "status", "url", "screenshot", "session_id"],
        "properties": {
          "message": {
            "type": "string",
            "description": "The final message or result of the browsing session"
          },
          "status": {
            "type": "string",
            "description": "Session status: CONTINUE, ASK_USER, or DONE"
          },
          "url": {
            "type": "string",
            "description": "The current URL of the session"
          },
          "screenshot": {
            "type": "string",
            "description": "Image URL of the screenshot"
          },
          "session_id": {
            "type": "string",
            "description": "The unique session identifier"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "step_count": {
                "type": "integer"
              },
              "processing_time": {
                "type": "integer"
              },
              "temperature": {
                "type": "number"
              }
            }
          }
        }
      },
      "RetrieveOutput": {
        "type": "object",
        "required": ["message", "url", "status", "data"],
        "properties": {
          "message": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "screenshot": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "SessionCreated": {
        "type": "object",
        "required": ["status", "message", "session_id", "url", "screenshot"],
        "properties": {
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "screenshot": {
            "type": "string"
          }
        }
      },
      "SessionStepSuccess": {
        "type": "object",
        "required": ["status", "message", "session_id", "url", "screenshot"],
        "properties": {
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "screenshot": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "loc": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X_MULTION_API_KEY",
        "description": "MultiOn API key for authentication"
      }
    }
  }
}