          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reportedTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AbuseCampaignListResponse": {
        "type": "object",
        "properties": {
          "campaigns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AbuseCampaign"
            }
          },
          "pageNumber": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
