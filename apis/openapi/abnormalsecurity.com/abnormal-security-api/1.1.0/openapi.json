            }
          },
          "pageNumber": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "CaseActionsResponse": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actionType": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "AbuseCampaign": {
        "type": "object",
        "properties": {
