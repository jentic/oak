  "components": {
    "schemas": {
      "Threat": {
        "type": "object",
        "properties": {
          "threatId": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "fromAddress": {
            "type": "string"
          },
          "toAddress": {
            "type": "string"
          },
          "receivedTime": {
            "type": "string",
            "format": "date-time"
          },
          "attackType": {
            "type": "string"
          },
          "attackStrategy": {
            "type": "string"
          },
          "sentimentScore": {
            "type": "number"
          },
          "isRead": {
            "type": "boolean"
          }
        }
      },
      "ThreatListResponse": {
        "type": "object",
        "properties": {
          "threats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Threat"
            }
          },
          "pageNumber": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "ThreatActionsResponse": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actionType": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Case": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CaseListResponse": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
