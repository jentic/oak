    "/edge/pg/order": {
      "post": {
        "operationId": "post_pg_order",
        "summary": "Create order",
        "description": "Create an order from a shopping cart. This endpoint should be called after payment has been successfully processed by P&G's payment system.",
        "tags": [
          "Order"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostPgOrderRequest"
              },
              "examples": {
                "pickup": {
                  "summary": "Pickup order",
                  "value": {
                    "shoppingcart": "9WQX3N37g3o7VnZXW1MeW2L9Sr0VMRvR7nUXX4zU4zLfwxycdf4qXTT51f0MfWlxW4fsrJRyhwvt",
                    "location_brand": "2PJNQG60Z6t0GgLaOZlATBKYMAjG8gIdgzX7j8X5fY5v",
                    "customer": "guestuser",
                    "requested_date": "2025-01-15T12:00:00.000Z",
                    "details": {
                      "order_type": "pickup",
                      "name": "John Doe",
                      "receiptEmail": "user@pg.com",
                      "phone": "+1-555-123-4567"
                    }
                  }
                },
                "delivery": {
                  "summary": "Delivery order",
                  "value": {
                    "shoppingcart": "9WQX3N37g3o7VnZXW1MeW2L9Sr0VMRvR7nUXX4zU4zLfwxycdf4qXTT51f0MfWlxW4fsrJRyhwvt",
                    "location_brand": "2PJNQG60Z6t0GgLaOZlATBKYMAjG8gIdgzX7j8X5fY5v",
                    "customer": "guestuser",
                    "requested_date": "2025-01-15T12:00:00.000Z",
                    "details": {
                      "order_type": "delivery",
                      "name": "Jane Smith",
                      "receiptEmail": "jane@pg.com",
                      "phone": "+1-555-987-6543",
                      "delivery_address": {
                        "street": "456 Oak Ave",
                        "city": "Chicago",
                        "state": "IL",
                        "zip": "60602",
                        "apartment": "Apt 3B"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPgOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Cart is empty or missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "empty_cart": {
                    "summary": "Empty cart",
                    "value": {
                      "code": 400.25,
                      "message": "Shopping cart contains no items"
                    }
                  },
                  "missing_receipt_email": {
                    "summary": "Missing receipt email",
                    "value": {
                      "code": 400,
                      "message": "receiptEmail is required in details"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Shopping cart not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/edge/pg/order/{order_id}": {
      "get": {
        "operationId": "get_pg_order",
        "summary": "Get order status",
        "description": "Get current order status and details.",
        "tags": [
          "Order"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "Order identifier",
            "schema": {
              "type": "string",
              "example": "1YSZ5P59i5q9XpZYZ3OgY4N1Ut2XOtxT9pVZZ6bW6bNhzyzaef6sZVV73h2OhYznzZ6hutLTzjyxv"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPgOrderResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Vendor token obtained from GET /vendor/auth"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic authentication using vendor client_id and client_password"
      }
    },
    "schemas": {
      "PostPgUserTokenRequest": {
        "type": "object",
        "required": [
          "email",
          "realm"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address (required)",
            "example": "user@pg.com"
          },
          "realm": {
            "type": "string",
            "description": "Realm identifier",
            "example": "thrive",
            "enum": [
              "thrive"
            ]
          }
        }
      },
      "PostPgUserTokenResponse": {
        "type": "object",
        "required": [
          "access"
        ],
        "properties": {
          "access": {
            "$ref": "#/components/schemas/AccessToken"
          }
        }
      },
      "AccessToken": {
        "type": "object",
        "required": [
          "token",
          "expires"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyX2lkIiwiaWF0IjoxNTE2MjM5MDIyfQ.example"
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "description": "Token expiration timestamp",
            "example": "2025-01-15T13:00:00.000Z"
          }
        }
      },
      "GetPgLocationResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brands"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Location identifier",
            "example": "Ne9O6BK6vWh080XvYQr4FXO5E2Kl3OFLoK0gNRO7sNmyQyRjjZClEwrlgWQPtAgRYd8v2Yug0Pa"
          },
          "name": {
            "type": "string",
            "description": "Location name",
            "example": "Campus Location"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "brands": {
            "type": "array",
            "description": "Available brands at this location",
            "items": {
              "$ref": "#/components/schemas/Brand"
            }
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "example": "123 Main St"
          },
          "city": {
            "type": "string",
            "example": "Chicago"
          },
          "state": {
            "type": "string",
            "example": "IL"
          },
          "zip": {
            "type": "string",
            "example": "60601"
          }
        }
      },
      "Brand": {
        "type": "object",
        "required": [
          "id",
          "name",
          "menus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Brand identifier",
            "example": "2PJNQG60Z6t0GgLaOZlATBKYMAjG8gIdgzX7j8X5fY5v"
          },
          "name": {
            "type": "string",
            "description": "Brand name",
            "example": "Campus Cafe"
          },
          "menus": {
            "type": "array",
            "description": "Available menus for this brand",
            "items": {
              "$ref": "#/components/schemas/MenuSummary"
            }
          }
        }
      },
      "MenuSummary": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Menu identifier",
            "example": "3QKO7H71a7i1PhYQr5GYQ6F3Ml4PGLpL1hORO8tO8tFzqswxzf8kRNN95Z4GZQfqQ8zlmDLsbqn"
          },
          "label": {
            "$ref": "#/components/schemas/Label"
          }
        }
      },
      "Label": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "description": "English label",
            "example": "Breakfast Menu"
          },
          "fr": {
            "type": "string",
            "description": "French label"
          }
        }
      },
      "GetPgMenuResponse": {
        "type": "object",
        "required": [
          "id",
          "label",
          "groups"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Menu identifier",
            "example": "3QKO7H71a7i1PhYQr5GYQ6F3Ml4PGLpL1hORO8tO8tFzqswxzf8kRNN95Z4GZQfqQ8zlmDLsbqn"
          },
          "label": {
            "$ref": "#/components/schemas/Label"
          },
          "groups": {
            "type": "array",
            "description": "Menu groups/categories",
            "items": {
              "$ref": "#/components/schemas/MenuGroup"
            }
          }
        }
      },
      "MenuGroup": {
        "type": "object",
        "required": [
          "id",
          "label",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Group identifier",
            "example": "5SMT9J93c9k3RjZSt7IaS8H5On6RINrN3jQTQ0vQ0vHbsuyzbh0mTPP17b6IbShtS0bnoFNudsp"
          },
          "label": {
            "$ref": "#/components/schemas/Label"
          },
          "items": {
            "type": "array",
            "description": "Menu items in this group",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        }
      },
      "MenuItem": {
        "type": "object",
        "required": [
          "id",
          "label",
          "price"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Item identifier",
            "example": "6TNU0K04d0l4SkZTu8JbT9I6Po7SJOsO4kRUU1wR1wIctvzac1nUQQ28c7JcTiuT1copGOvetq"
          },
          "label": {
            "$ref": "#/components/schemas/Label"
          },
          "description": {
            "$ref": "#/components/schemas/Label"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "modifiers": {
            "type": "array",
            "description": "Available modifiers for this item",
            "items": {
              "$ref": "#/components/schemas/Modifier"
            }
          }
        }
      },
      "Price": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "description": "Price amount",
            "example": 10.99
          },
          "currency": {
            "type": "string",
            "description": "Currency code",
            "example": "USD"
          }
        }
      },
      "Modifier": {
        "type": "object",
        "required": [
          "id",
          "group_id",
          "label",
          "price"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Modifier identifier",
            "example": "7UOV1L15e1m5TlZUV9KcU0J7Qp8TKPtP5lSVV2xS2xJduwzbd2oVRR39d8KdUjvU2dpqHPwfur"
          },
          "group_id": {
            "type": "string",
            "description": "Modifier group identifier",
            "example": "8VPW2M26f2n6UmZWV0LdV1K8Rq9ULQuQ6mTWW3yT3yKevxace3pWSS40e9LeVkwV3eqrIQxgvs"
          },
          "label": {
            "$ref": "#/components/schemas/Label"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          }
        }
      },
      "PostPgCartRequest": {
        "type": "object",
        "required": [
          "location",
          "brand",
          "menu"
        ],
        "properties": {
          "location": {
            "type": "string",
            "description": "Location identifier",
            "example": "Ne9O6BK6vWh080XvYQr4FXO5E2Kl3OFLoK0gNRO7sNmyQyRjjZClEwrlgWQPtAgRYd8v2Yug0Pa"
          },
          "brand": {
            "type": "string",
            "description": "Brand identifier",
            "example": "2PJNQG60Z6t0GgLaOZlATBKYMAjG8gIdgzX7j8X5fY5v"
          },
          "menu": {
            "type": "string",
            "description": "Menu identifier",
            "example": "3QKO7H71a7i1PhYQr5GYQ6F3Ml4PGLpL1hORO8tO8tFzqswxzf8kRNN95Z4GZQfqQ8zlmDLsbqn"
          }
        }
      },
      "PostPgCartResponse": {
        "type": "object",
        "required": [
          "id",
          "items",
          "sub_total",
          "taxes",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Shopping cart identifier",
            "example": "9WQX3N37g3o7VnZXW1MeW2L9Sr0VMRvR7nUXX4zU4zLfwxycdf4qXTT51f0MfWlxW4fsrJRyhwvt"
          },
          "items": {
            "type": "array",
            "description": "Cart items",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "sub_total": {
            "$ref": "#/components/schemas/Price"
          },
          "taxes": {
            "$ref": "#/components/schemas/Tax"
          },
          "total": {
            "$ref": "#/components/schemas/Price"
          }
        }
      },
      "Tax": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "description": "Tax amount",
            "example": 2.18
          },
          "currency": {
            "type": "string",
            "description": "Currency code",
            "example": "USD"
          },
          "rate": {
            "type": "number",
            "description": "Tax rate",
            "example": 0.095
          }
        }
      },
      "GetPgCartResponse": {
        "$ref": "#/components/schemas/PostPgCartResponse"
      },
      "PutPgCartItemsRequest": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "Cart items to add or update",
            "items": {
              "$ref": "#/components/schemas/CartItemRequest"
            }
          }
        }
      },
      "CartItemRequest": {
        "type": "object",
        "required": [
          "item",
          "quantity"
        ],
        "properties": {
          "item": {
            "type": "string",
            "description": "Item identifier",
            "example": "6TNU0K04d0l4SkZTu8JbT9I6Po7SJOsO4kRUU1wR1wIctvzac1nUQQ28c7JcTiuT1copGOvetq"
          },
          "quantity": {
            "type": "integer",
            "description": "Item quantity",
            "minimum": 1,
            "example": 2
          },
          "modifiers": {
            "type": "array",
            "description": "Selected modifiers",
            "items": {
              "$ref": "#/components/schemas/CartModifier"
            }
          }
        }
      },
      "CartModifier": {
        "type": "object",
        "required": [
          "modifier_group",
          "modifier"
        ],
        "properties": {
          "modifier_group": {
            "type": "string",
            "description": "Modifier group identifier",
            "example": "8VPW2M26f2n6UmZWV0LdV1K8Rq9ULQuQ6mTWW3yT3yKevxace3pWSS40e9LeVkwV3eqrIQxgvs"
          },
          "modifier": {
            "type": "string",
            "description": "Modifier identifier",
            "example": "7UOV1L15e1m5TlZUV9KcU0J7Qp8TKPtP5lSVV2xS2xJduwzbd2oVRR39d8KdUjvU2dpqHPwfur"
          }
        }
      },
      "PutPgCartItemsResponse": {
        "$ref": "#/components/schemas/PostPgCartResponse"
      },
      "CartItem": {
        "type": "object",
        "required": [
          "id",
          "item",
          "quantity",
          "sub_total"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Cart item identifier",
            "example": "0XRY4O48h4p8WoZYX2NfX3M0Ts1WNswS8oVYY5aV5aMgxyzdge5rYUU62g1NgXmyX5gtsKSzixwu"
          },
          "item": {
            "$ref": "#/components/schemas/MenuItem"
          },
          "quantity": {
            "type": "integer",
            "description": "Item quantity",
            "example": 2
          },
          "modifiers": {
            "type": "array",
            "description": "Selected modifiers",
            "items": {
              "$ref": "#/components/schemas/CartModifier"
            }
          },
          "sub_total": {
            "$ref": "#/components/schemas/Price"
          }
        }
      },
      "PostPgOrderRequest": {
        "type": "object",
        "required": [
          "shoppingcart",
          "location_brand",
          "customer",
          "requested_date",
          "details"
        ],
        "properties": {
          "shoppingcart": {
            "type": "string",
            "description": "Shopping cart identifier",
            "example": "9WQX3N37g3o7VnZXW1MeW2L9Sr0VMRvR7nUXX4zU4zLfwxycdf4qXTT51f0MfWlxW4fsrJRyhwvt"
          },
          "location_brand": {
            "type": "string",
            "description": "Brand identifier",
            "example": "2PJNQG60Z6t0GgLaOZlATBKYMAjG8gIdgzX7j8X5fY5v"
          },
          "customer": {
            "type": "string",
            "description": "Customer identifier - must be 'guestuser'",
            "example": "guestuser",
            "enum": [
              "guestuser"
            ]
          },
          "requested_date": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp for when order should be ready",
            "example": "2025-01-15T12:00:00.000Z"
          },
          "details": {
            "$ref": "#/components/schemas/OrderDetails"
          }
        }
      },
      "OrderDetails": {
        "type": "object",
        "required": [
          "order_type",
          "name",
          "receiptEmail"
        ],
        "properties": {
          "order_type": {
            "type": "string",
            "description": "Order type",
            "enum": [
              "pickup",
              "delivery"
            ],
            "example": "pickup"
          },
          "name": {
            "type": "string",
            "description": "Customer name for pickup/delivery",
            "example": "John Doe"
          },
          "receiptEmail": {
            "type": "string",
            "format": "email",
            "description": "Email address where order notifications will be sent",
            "example": "user@pg.com"
          },
          "phone": {
            "type": "string",
            "description": "Customer phone number",
            "example": "+1-555-123-4567"
          },
          "delivery_address": {
            "$ref": "#/components/schemas/DeliveryAddress",
            "description": "Delivery address (required for delivery orders)"
          }
        }
      },
      "DeliveryAddress": {
        "type": "object",
        "required": [
          "street",
          "city",
          "state",
          "zip"
        ],
        "properties": {
          "street": {
            "type": "string",
            "description": "Street address",
            "example": "456 Oak Ave"
          },
          "city": {
            "type": "string",
            "description": "City",
            "example": "Chicago"
          },
          "state": {
            "type": "string",
            "description": "State code",
            "example": "IL"
          },
          "zip": {
            "type": "string",
            "description": "ZIP code",
            "example": "60602"
          },
          "apartment": {
            "type": "string",
            "description": "Apartment/unit number",
            "example": "Apt 3B"
          }
        }
      },
      "PostPgOrderResponse": {
        "type": "object",
        "required": [
          "id",
          "details",
          "status",
          "meta"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Order identifier",
            "example": "1YSZ5P59i5q9XpZYZ3OgY4N1Ut2XOtxT9pVZZ6bW6bNhzyzaef6sZVV73h2OhYznzZ6hutLTzjyxv"
          },
          "details": {
            "$ref": "#/components/schemas/OrderResponseDetails"
          },
          "status": {
            "type": "string",
            "description": "Order status",
            "enum": [
              "pending",
              "in_progress",
              "ready",
              "completed",
              "cancelled"
            ],
            "example": "pending"
          },
          "items": {
            "type": "array",
            "description": "Order items",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "sub_total": {
            "$ref": "#/components/schemas/Price"
          },
          "taxes": {
            "$ref": "#/components/schemas/Tax"
          },
          "total": {
            "$ref": "#/components/schemas/Price"
          },
          "meta": {
            "$ref": "#/components/schemas/OrderMeta"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Order creation timestamp",
            "example": "2025-01-15T10:30:00.000Z"
          }
        }
      },
      "OrderResponseDetails": {
        "type": "object",
        "required": [
          "display_id",
          "receiptEmail"
        ],
        "properties": {
          "display_id": {
            "type": "string",
            "description": "Human-readable order ID",
            "example": "ORD-12345"
          },
          "order_type": {
            "type": "string",
            "enum": [
              "pickup",
              "delivery"
            ],
            "example": "pickup"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "receiptEmail": {
            "type": "string",
            "format": "email",
            "example": "user@pg.com"
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": [
          "id",
          "item",
          "quantity",
          "price"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Order item identifier",
            "example": "2ZTa6Q60j6r0YqZZa4PhZ5O2Vu3YPuyU0qWaa7cX7cOiazabfg7tZWW84i3PiZao0a7ivuMU0kzyw"
          },
          "item": {
            "$ref": "#/components/schemas/MenuItem"
          },
          "quantity": {
            "type": "integer",
            "example": 2
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          }
        }
      },
      "OrderMeta": {
        "type": "object",
        "required": [
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "description": "Whether the order is active",
            "example": true
          }
        }
      },
      "GetPgOrderResponse": {
        "type": "object",
        "required": [
          "id",
          "details",
          "status",
          "meta"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Order identifier",
            "example": "1YSZ5P59i5q9XpZYZ3OgY4N1Ut2XOtxT9pVZZ6bW6bNhzyzaef6sZVV73h2OhYznzZ6hutLTzjyxv"
          },
          "details": {
            "$ref": "#/components/schemas/OrderResponseDetails"
          },
          "status": {
            "type": "string",
            "description": "Order status",
            "enum": [
              "pending",
              "in_progress",
              "ready",
              "completed",
              "cancelled"
            ],
            "example": "pending"
          },
          "items": {
            "type": "array",
            "description": "Order items",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "sub_total": {
            "$ref": "#/components/schemas/Price"
          },
          "taxes": {
            "$ref": "#/components/schemas/Tax"
          },
          "total": {
            "$ref": "#/components/schemas/Price"
          },
          "meta": {
            "$ref": "#/components/schemas/OrderMeta"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Order creation timestamp",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Order last update timestamp",
            "example": "2025-01-15T10:45:00.000Z"
          },
          "ready_at": {
            "type": "string",
            "format": "date-time",
            "description": "Order ready timestamp (when status is 'ready')",
            "example": "2025-01-15T11:00:00.000Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "number",
            "description": "Error code",
            "example": 400.25
          },
          "message": {
            "type": "string",
            "description": "Error message",
            "example": "Shopping cart contains no items"
          },
          "data": {
            "type": "object",
            "description": "Additional error data",
            "additionalProperties": true
          }
        }
      }
    }
  }
}