                  "value": {
                    "location": "Ne9O6BK6vWh080XvYQr4FXO5E2Kl3OFLoK0gNRO7sNmyQyRjjZClEwrlgWQPtAgRYd8v2Yug0Pa",
                    "brand": "2PJNQG60Z6t0GgLaOZlATBKYMAjG8gIdgzX7j8X5fY5v",
                    "menu": "3QKO7H71a7i1PhYQr5GYQ6F3Ml4PGLpL1hORO8tO8tFzqswxzf8kRNN95Z4GZQfqQ8zlmDLsbqn"
                  }
                }
              }
            }
          }
        },
        "responses": {
