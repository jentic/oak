  "info": {
    "title": "P&G Integration Edge Service",
    "description": "API for P&G integration where payment is handled externally and orders are posted after payment completion.",
    "version": "1.0.0",
    "contact": {},
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/cdl-562/pg-integration-edge-service/1.0.0"
