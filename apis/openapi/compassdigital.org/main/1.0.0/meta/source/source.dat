      "url": "https://dev.api.compassdigital.org",
      "description": "Development"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Vendor authentication endpoints"
    },
    {
      "name": "Location",
      "description": "Location information endpoints"
    },
    {
      "name": "Menu",
      "description": "Menu browsing endpoints"
    },
    {
      "name": "Cart",
      "description": "Shopping cart management endpoints"
    },
    {
      "name": "Order",
      "description": "Order creation and status endpoints"
    }
  ],
  "paths": {
    "/edge/pg/user/token": {
      "post": {
        "operationId": "post_pg_user_token",
        "summary": "Get user token",
        "description": "Generate a user token for a given email address. Email is required in the request body. Creates a user account if one doesn't exist.",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostPgUserTokenRequest"
              },
              "examples": {
                "default": {
                  "summary": "Default example",
                  "value": {
                    "email": "user@pg.com",
                    "realm": "thrive"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully generated user token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPgUserTokenResponse"
                },
                "example": {
                  "access": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyX2lkIiwiaWF0IjoxNTE2MjM5MDIyfQ.example",
                    "expires": "2025-01-15T13:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid vendor credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
