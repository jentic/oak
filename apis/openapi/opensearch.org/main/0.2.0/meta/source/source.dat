          format: int64
          minimum: 0
          maximum: 2147483647
        next_doc:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        next_doc_count:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        score:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        score_count:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        compute_max_score:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        compute_max_score_count:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        set_min_competitive_score:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        set_min_competitive_score_count:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
      required:
