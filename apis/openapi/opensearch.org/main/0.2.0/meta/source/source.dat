      description: If `true`, the response includes term offsets.
      schema:
        type: boolean
        default: true
      style: form
      example: true
    mtermvectors___query.payloads:
      in: query
      name: payloads
      description: If `true`, the response includes term payloads.
      schema:
        type: boolean
        default: true
      style: form
      example: true
    mtermvectors___query.positions:
      in: query
      name: positions
      description: If `true`, the response includes term positions.
      schema:
        type: boolean
        default: true
      style: form
      example: true
    mtermvectors___query.preference:
      in: query
      name: preference
      description: 'Specifies the node or shard the operation should be performed on.

        Random by default.'
      schema:
        type: string
        default: random
      style: form
      example: random
    mtermvectors___query.realtime:
      in: query
      name: realtime
      description: If `true`, the request is real-time as opposed to near-real-time.
      schema:
        type: boolean
        default: true
      style: form
      example: true
    mtermvectors___query.routing:
      in: query
      name: routing
      description: Custom value used to route operations to a specific shard.
      schema:
        $ref: '#/components/schemas/_common___RoutingInQueryString'
      style: form
      example: example
    mtermvectors___query.term_statistics:
      in: query
      name: term_statistics
      description: If `true`, the response includes term frequency and document frequency.
      schema:
        type: boolean
        default: false
      style: form
      example: false
    mtermvectors___query.version:
      in: query
