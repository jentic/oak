            description: An array of values for which to calculate the percentile ranks.
            type: array
            items:
              type: number
              format: double
          hdr:
            $ref: '#/components/schemas/_common.aggregations___HdrMethod'
          tdigest:
            $ref: '#/components/schemas/_common.aggregations___TDigest'
