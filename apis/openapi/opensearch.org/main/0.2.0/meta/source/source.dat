        _explanation:
          $ref: '#/components/schemas/_core.explain___Explanation'
        fields:
          type: object
          additionalProperties: true
        highlight:
          type: object
          additionalProperties:
            type: array
            items:
              type: string
        inner_hits:
          type: object
          additionalProperties:
