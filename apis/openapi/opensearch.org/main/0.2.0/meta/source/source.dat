      - min_chars
    _common.mapping___TextProperty:
      allOf:
      - $ref: '#/components/schemas/_common.mapping___CorePropertyBase'
      - type: object
        properties:
          analyzer:
            type: string
          boost:
            type: number
            format: double
            minimum: 0
            maximum: 1000000000
          eager_global_ordinals:
