        _seq_no:
          $ref: '#/components/schemas/_common___SequenceNumber'
        _primary_term:
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        _version:
          $ref: '#/components/schemas/_common___VersionNumber'
        sort:
          $ref: '#/components/schemas/_common___SortResults'
    _core.search___HitsMetadata:
