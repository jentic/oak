      schema:
        $ref: '#/components/schemas/_common___VersionType'
      style: form
      example: external
    neural.stats___path.node_id:
      name: node_id
      in: path
      description: Comma-separated list of node IDs or names to limit the returned information; leave empty to get information from all nodes.
      schema:
        type: string
      required: true
      example: example
    neural.stats___path.stat:
      name: stat
      in: path
      description: Comma-separated list of stats to retrieve; use empty string to retrieve all stats.
      schema:
        type: string
        enum:
        - cluster_version
        - text_embedding_executions
        - text_embedding_processors_in_pipelines
      required: true
      example: cluster_version
    neural.stats___query.flat_stat_paths:
      in: query
      name: flat_stat_paths
      description: "Whether to return stats in the flat form, which can improve readability, especially for heavily nested stats.\nFor example, the flat form of `\"processors\": { \"ingest\": { \"text_embedding_executions\": 20181212 } }` is \n`\"processors.ingest.text_embedding_executions\": \"20181212\"`."
      schema:
        type: boolean
        default: false
      style: form
      example: false
    neural.stats___query.include_metadata:
      in: query
      name: include_metadata
      description: 'Whether to return stat metadata instead of the raw stat value, includes additional information about the stat.

        These can include things like type hints, time since last stats being recorded, or recent rolling interval values'
      schema:
        type: boolean
        default: false
      style: form
      example: false
    nodes.hot_threads___path.node_id:
      name: node_id
      in: path
      description: A comma-separated list of node IDs or names to limit the returned information; use `_local` to return information from the node you're connecting to, leave empty to get information from all nodes.
      schema:
        type: array
        description: A comma-separated list of node IDs or names to limit the returned information; use `_local` to return information from the node you're connecting to, leave empty to get information from all nodes.
        items:
          type: string
      required: true
      example:
      - example
    nodes.hot_threads___query.ignore_idle_threads:
      name: ignore_idle_threads
      in: query
      description: Whether to show threads that are in known-idle places, such as waiting on a socket select or pulling from an empty task queue.
      schema:
        type: boolean
        default: true
      example: true
    nodes.hot_threads___query.interval:
      name: interval
      in: query
      description: The time interval between thread stack trace samples.
