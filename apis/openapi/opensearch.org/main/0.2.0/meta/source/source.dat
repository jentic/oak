          minimum: 0
          maximum: 2147483647
        incompatible_diffs:
          description: Number of incompatible differences between published cluster states.
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
        compatible_diffs:
          description: Number of compatible differences between published cluster states.
          type: integer
          format: int64
          minimum: 0
          maximum: 2147483647
