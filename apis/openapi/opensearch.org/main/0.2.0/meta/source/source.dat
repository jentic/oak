      - date_nanos
      - double
      - geo_point
      - ip
      - long
      - number
      - numeric
      - string
    _common.aggregations___VariableWidthHistogramAggregate:
      allOf:
      - $ref: '#/components/schemas/_common.aggregations___MultiBucketAggregateBaseVariableWidthHistogramBucket'
      - type: object
        additionalProperties: true
    _common.aggregations___VariableWidthHistogramAggregation:
      type: object
      properties:
        field:
          $ref: '#/components/schemas/_common___Field'
        buckets:
          description: The target number of buckets.
          type: integer
          format: int32
          minimum: 0
          maximum: 2147483647
        shard_size:
          description: 'The number of buckets that the coordinating node will request from each shard.

            Defaults to `buckets * 50`.'
          type: integer
          format: int32
          minimum: 0
          maximum: 2147483647
        initial_buffer:
          description: 'Specifies the number of individual documents that will be stored in memory on a shard before the initial bucketing algorithm is run.

            Defaults to `min(10 * shard_size, 50000)`.'
          type: integer
          format: int32
          minimum: 0
          maximum: 2147483647
