    _common.mapping___TypeMapping:
      type: object
      properties:
        all_field:
          $ref: '#/components/schemas/_common.mapping___AllField'
        date_detection:
          type: boolean
        dynamic:
          $ref: '#/components/schemas/_common.mapping___DynamicMapping'
        dynamic_date_formats:
          type: array
          items:
            type: string
        dynamic_templates:
          type: array
