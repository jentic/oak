    "/emails/search": {
      "post": {
        "tags": [
          "EmailController"
        ],
        "summary": "Get all emails by search criteria. Return in paginated form.",
        "description": "Search emails by given criteria return matches in paginated format. Searches against email recipients, sender, subject, email address and ID. Does not search email body",
