            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/emails/{emailId}/raw/json": {
      "get": {
        "tags": [
          "EmailController"
        ],
        "summary": "Get raw email in JSON. Unparsed SMTP message in JSON wrapper format.",
        "description": "Returns a raw, unparsed, and unprocessed email wrapped in a JSON response object for easier handling when compared with the getRawEmail text/plain response",
        "operationId": "getRawEmailJson",
        "parameters": [
          {
            "name": "emailId",
