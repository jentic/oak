                }
              }
            }
          }
        }
      }
    },
    "/emails/{emailId}/links": {
      "get": {
        "tags": [
          "EmailController"
        ],
        "summary": "Parse and return list of links found in an email (only works for HTML content)",
        "description": "HTML parsing uses JSoup and UNIX line separators. Searches content for href attributes",
        "operationId": "getEmailLinks",
        "parameters": [
          {
            "name": "emailId",
            "in": "path",
