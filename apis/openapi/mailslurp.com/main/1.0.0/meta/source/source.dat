            "minimum": 0,
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "minProperties": {
            "minimum": 0,
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "maximum": {
            "type": "number",
            "nullable": true
          },
          "minimum": {
            "type": "number",
            "nullable": true
          },
          "nullable": {
            "type": "boolean",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "description": "Primitive JSON schema types with a fallback CUSTOM for unknown values.",
            "nullable": true,
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array",
