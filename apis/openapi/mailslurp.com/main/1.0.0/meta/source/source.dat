    "/emails/{emailId}/textLines": {
      "get": {
        "tags": [
          "EmailController"
        ],
        "summary": "Parse and return text from an email, stripping HTML and decoding encoded characters",
        "description": "Parse an email body and return the content as an array of strings. HTML parsing uses JSoup and UNIX line separators.",
        "operationId": "getEmailTextLines",
        "parameters": [
          {
            "name": "emailId",
            "in": "path",
            "description": "ID of email to fetch text for",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "decodeHtmlEntities",
