        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EmailTextLinesResult"
                }
              }
            }
          }
        }
      }
    },
    "/emails/{emailId}/summary": {
      "get": {
        "tags": [
          "EmailController"
        ],
        "summary": "Get email data including headers but not body. Expects email to exist by ID. For emails that may not have arrived yet use the WaitForController.",
        "description": "Returns a email summary object with headers. To retrieve the body see getEmail and to get raw unparsed email use the getRawEmail endpoints",
        "operationId": "getEmailSummary",
        "parameters": [
          {
            "name": "emailId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "decode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EmailPreview"
                }
              }
            }
          }
        }
      }
    },
    "/emails/{emailId}/raw": {
      "get": {
        "tags": [
          "EmailController"
        ],
        "summary": "Get raw email string. Returns unparsed raw SMTP message with headers and body.",
        "description": "Returns a raw, unparsed, and unprocessed email. If your client has issues processing the response it is likely due to the response content-type which is text/plain. If you need a JSON response content-type use the getRawEmailJson endpoint",
        "operationId": "getRawEmailContents",
        "parameters": [
          {
            "name": "emailId",
            "in": "path",
            "description": "ID of email",
