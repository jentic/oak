              "description": "List of `BCC` recipients email addresses that the email was addressed to. See recipients object for names."
            }
          },
          "subject": {
            "type": "string",
            "description": "The subject line of the email message as specified by SMTP subject header",
            "nullable": true
          },
          "attachmentMetaDatas": {
            "type": "array",
            "description": "List of attachment meta data objects if attachments present",
            "items": {
              "$ref": "#/components/schemas/AttachmentMetaData"
            }
          }
        },
        "description": "NEW_EMAIL webhook payload. Sent to your webhook url endpoint via HTTP POST when an email is received by the inbox that your webhook is attached to. Use the email ID to fetch the full email body or attachments."
      },
