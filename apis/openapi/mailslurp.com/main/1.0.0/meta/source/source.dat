          }
        }
      },
      "TestRulesetReceivingOptions": {
        "required": [
          "fromSender"
        ],
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "phoneId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "fromSender": {
            "type": "string"
