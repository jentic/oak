        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneNumberDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "PhoneController"
        ],
        "summary": "Delete a phone number",
        "description": "Remove phone number from account",
        "operationId": "deletePhoneNumber",
        "parameters": [
          {
            "name": "phoneNumberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
