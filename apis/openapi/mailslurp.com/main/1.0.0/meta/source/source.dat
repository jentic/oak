            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Filter for emails that were before after the given timestamp",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Filter for emails that were received after the given timestamp",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort direction",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          },
          {
            "name": "delay",
            "in": "query",
            "description": "Max milliseconds delay between calls",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
