        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "AttachmentController"
        ],
        "summary": "Delete all attachments",
        "description": "Delete all attachments",
        "operationId": "deleteAllAttachments",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
