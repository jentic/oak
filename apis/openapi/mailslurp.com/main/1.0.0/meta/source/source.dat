            "format": "uuid",
            "nullable": true
          },
          "templateVariables": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "description": "Template variable values",
              "nullable": true
            },
            "description": "Template variable values",
            "nullable": true
          }
        },
        "description": "Options for updating an inbox replier"
      },
