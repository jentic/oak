{
  "openapi": "3.0.3",
  "info": {
    "title": "OVHcloud API",
    "description": "OVHcloud REST API for managing cloud infrastructure, dedicated servers, VPS, domains, DNS, IP addresses, SSL certificates, and billing. Provides programmatic access to all OVHcloud services.",
    "version": "1.0",
    "contact": {
      "name": "OVHcloud",
      "url": "https://www.ovhcloud.com",
      "email": "api-subscribe@ml.ovh.net"
    },
    "x-jentic-source-url": "https://api.ovh.com/"
  },
  "servers": [
    {
      "url": "https://api.ovh.com/1.0",
      "description": "OVHcloud API (Global / Default)"
    },
    {
      "url": "https://eu.api.ovh.com/1.0",
      "description": "OVHcloud API (Europe)"
    },
    {
      "url": "https://ca.api.ovh.com/1.0",
      "description": "OVHcloud API (Canada)"
    }
  ],
  "security": [
    {
      "ovhAuth": []
    }
  ],
  "tags": [
    { "name": "Cloud", "description": "Public Cloud project management including instances, images, flavors, networks, volumes, and snapshots" },
    { "name": "Domain", "description": "Domain name registration and management" },
    { "name": "Dedicated Servers", "description": "Dedicated server management, provisioning, and monitoring" },
    { "name": "VPS", "description": "Virtual Private Server management" },
    { "name": "IP", "description": "IP address management, failover, firewall, and reverse DNS" },
    { "name": "DNS", "description": "DNS zone and record management" },
    { "name": "SSL", "description": "SSL certificate management" },
    { "name": "Billing", "description": "Billing, orders, debts, and account financial management" },
    { "name": "Authentication", "description": "API authentication and credential management" }
  ],
  "paths": {
    "/auth/credential": {
      "post": {
        "tags": ["Authentication"],
        "operationId": "requestNewCredential",
        "summary": "Request a new credential for your application",
        "description": "Creates a new consumer key credential for authenticating API requests. Returns a validation URL and consumer key.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accessRules": {
                    "type": "array",
                    "description": "Access rules for the credential",
                    "items": {
                      "$ref": "#/components/schemas/AccessRule"
                    }
                  },
                  "redirection": {
                    "type": "string",
                    "description": "URL to redirect after validation"
                  }
                },
                "required": ["accessRules"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credential created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "validationUrl": { "type": "string" },
                    "consumerKey": { "type": "string" },
                    "state": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/currentCredential": {
      "get": {
        "tags": ["Authentication"],
        "operationId": "getCurrentCredential",
        "summary": "Get current credential details",
        "description": "Retrieve details about the current API credential being used for authentication.",
        "responses": {
          "200": {
            "description": "Current credential details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiCredential"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "operationId": "logout",
        "summary": "Expire current credential",
        "description": "Invalidates the current consumer key credential, ending the session.",
        "responses": {
          "200": { "description": "Successfully logged out" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/time": {
      "get": {
        "tags": ["Authentication"],
        "operationId": "getServerTime",
        "summary": "Get current OVH server time",
        "description": "Returns the current server UNIX timestamp. Used for signature computation.",
        "security": [],
        "responses": {
          "200": {
            "description": "Current server UNIX timestamp",
            "content": {
              "application/json": {
                "schema": { "type": "integer" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "listCloudProjects",
        "summary": "List all public cloud projects",
        "description": "Returns an array of project IDs for all public cloud projects associated with the account.",
        "responses": {
          "200": {
            "description": "List of project IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "getCloudProject",
        "summary": "Get cloud project details",
        "description": "Retrieve the properties and details of a specific public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "responses": {
          "200": {
            "description": "Cloud project details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudProject" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "tags": ["Cloud"],
        "operationId": "updateCloudProject",
        "summary": "Update cloud project properties",
        "description": "Modify the properties of a specific public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CloudProject" }
            }
          }
        },
        "responses": {
          "200": { "description": "Project updated successfully" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/instance": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "listCloudInstances",
        "summary": "List cloud project instances",
        "description": "Retrieve all compute instances within a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by region",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of instances",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CloudInstance" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Cloud"],
        "operationId": "createCloudInstance",
        "summary": "Create a new cloud instance",
        "description": "Launch a new compute instance within a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["flavorId", "imageId", "name", "region"],
                "properties": {
                  "flavorId": { "type": "string", "description": "Instance flavor ID" },
                  "imageId": { "type": "string", "description": "Image ID for the instance" },
                  "name": { "type": "string", "description": "Instance name" },
                  "region": { "type": "string", "description": "Region for deployment" },
                  "sshKeyId": { "type": "string", "description": "SSH key ID" },
                  "monthlyBilling": { "type": "boolean", "description": "Enable monthly billing" },
                  "userData": { "type": "string", "description": "Cloud-init user data" },
                  "networks": {
                    "type": "array",
                    "description": "Networks to attach",
                    "items": {
                      "type": "object",
                      "properties": {
                        "networkId": { "type": "string" },
                        "ip": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Instance created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudInstance" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/instance/{instanceId}": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "getCloudInstance",
        "summary": "Get cloud instance details",
        "description": "Retrieve the details of a specific compute instance.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          { "$ref": "#/components/parameters/InstanceId" }
        ],
        "responses": {
          "200": {
            "description": "Instance details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudInstance" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "tags": ["Cloud"],
        "operationId": "updateCloudInstance",
        "summary": "Update a cloud instance",
        "description": "Modify the properties of a specific compute instance.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          { "$ref": "#/components/parameters/InstanceId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instanceName": { "type": "string", "description": "New instance name" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Instance updated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["Cloud"],
        "operationId": "deleteCloudInstance",
        "summary": "Delete a cloud instance",
        "description": "Permanently delete a compute instance from the project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          { "$ref": "#/components/parameters/InstanceId" }
        ],
        "responses": {
          "200": { "description": "Instance deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/image": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "listCloudImages",
        "summary": "List available cloud images",
        "description": "Retrieve all available images for a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by region",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of images",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CloudImage" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/image/{imageId}": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "getCloudImage",
        "summary": "Get cloud image details",
        "description": "Retrieve the details of a specific image.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "imageId",
            "in": "path",
            "required": true,
            "description": "Image ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Image details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudImage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/flavor": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "listCloudFlavors",
        "summary": "List available instance flavors",
        "description": "Retrieve all available instance flavors (sizes) for a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by region",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of flavors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CloudFlavor" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/flavor/{flavorId}": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "getCloudFlavor",
        "summary": "Get flavor details",
        "description": "Retrieve the details of a specific instance flavor.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "flavorId",
            "in": "path",
            "required": true,
            "description": "Flavor ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Flavor details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudFlavor" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/network/private": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "listCloudPrivateNetworks",
        "summary": "List private networks",
        "description": "Retrieve all private networks within a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "responses": {
          "200": {
            "description": "List of private networks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CloudNetwork" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Cloud"],
        "operationId": "createCloudPrivateNetwork",
        "summary": "Create a private network",
        "description": "Create a new private network within a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "description": "Network name" },
                  "vlanId": { "type": "integer", "description": "VLAN ID (1-4000)" },
                  "regions": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Regions where the network is available"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Network created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudNetwork" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/network/private/{networkId}": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "getCloudPrivateNetwork",
        "summary": "Get private network details",
        "description": "Retrieve details of a specific private network.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "networkId",
            "in": "path",
            "required": true,
            "description": "Network ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Network details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudNetwork" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["Cloud"],
        "operationId": "deleteCloudPrivateNetwork",
        "summary": "Delete a private network",
        "description": "Delete a specific private network from the project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "networkId",
            "in": "path",
            "required": true,
            "description": "Network ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Network deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/volume": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "listCloudVolumes",
        "summary": "List cloud volumes",
        "description": "Retrieve all block storage volumes within a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by region",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of volumes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CloudVolume" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Cloud"],
        "operationId": "createCloudVolume",
        "summary": "Create a cloud volume",
        "description": "Create a new block storage volume within a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "region", "size"],
                "properties": {
                  "name": { "type": "string", "description": "Volume name" },
                  "region": { "type": "string", "description": "Region for the volume" },
                  "size": { "type": "integer", "description": "Size in GB" },
                  "type": { "type": "string", "enum": ["classic", "high-speed"], "description": "Volume type" },
                  "description": { "type": "string", "description": "Volume description" },
                  "snapshotId": { "type": "string", "description": "Snapshot to create the volume from" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Volume created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudVolume" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/volume/{volumeId}": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "getCloudVolume",
        "summary": "Get cloud volume details",
        "description": "Retrieve the details of a specific block storage volume.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          { "$ref": "#/components/parameters/VolumeId" }
        ],
        "responses": {
          "200": {
            "description": "Volume details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudVolume" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["Cloud"],
        "operationId": "deleteCloudVolume",
        "summary": "Delete a cloud volume",
        "description": "Delete a specific block storage volume.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          { "$ref": "#/components/parameters/VolumeId" }
        ],
        "responses": {
          "200": { "description": "Volume deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/volume/{volumeId}/attach": {
      "post": {
        "tags": ["Cloud"],
        "operationId": "attachCloudVolume",
        "summary": "Attach a volume to an instance",
        "description": "Attach a block storage volume to a compute instance.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          { "$ref": "#/components/parameters/VolumeId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["instanceId"],
                "properties": {
                  "instanceId": { "type": "string", "description": "Instance ID to attach to" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Volume attached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudVolume" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/volume/{volumeId}/detach": {
      "post": {
        "tags": ["Cloud"],
        "operationId": "detachCloudVolume",
        "summary": "Detach a volume from an instance",
        "description": "Detach a block storage volume from its attached compute instance.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          { "$ref": "#/components/parameters/VolumeId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["instanceId"],
                "properties": {
                  "instanceId": { "type": "string", "description": "Instance ID to detach from" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Volume detached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloudVolume" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/cloud/project/{serviceName}/snapshot": {
      "get": {
        "tags": ["Cloud"],
        "operationId": "listCloudSnapshots",
        "summary": "List cloud snapshots",
        "description": "Retrieve all snapshots within a public cloud project.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
