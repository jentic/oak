          { "$ref": "#/components/parameters/IpBlock" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ipOnMitigation"],
                "properties": {
                  "ipOnMitigation": { "type": "string", "description": "IP address to protect" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Mitigation enabled" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/ssl": {
      "get": {
        "tags": ["SSL"],
        "operationId": "listSslCertificates",
        "summary": "List SSL certificates",
        "description": "Retrieve all SSL certificate services associated with the account.",
        "responses": {
          "200": {
            "description": "List of SSL certificate service names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/ssl/{serviceName}": {
      "get": {
        "tags": ["SSL"],
        "operationId": "getSslCertificate",
        "summary": "Get SSL certificate details",
        "description": "Retrieve the properties and details of a specific SSL certificate.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "responses": {
          "200": {
            "description": "SSL certificate details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SslCertificate" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/ssl/{serviceName}/tasks": {
      "get": {
        "tags": ["SSL"],
        "operationId": "listSslTasks",
        "summary": "List SSL certificate tasks",
        "description": "Retrieve all tasks for a specific SSL certificate service.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "responses": {
          "200": {
            "description": "List of task IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "integer" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/ssl/{serviceName}/tasks/{taskId}": {
      "get": {
        "tags": ["SSL"],
        "operationId": "getSslTask",
        "summary": "Get SSL task details",
        "description": "Retrieve the details and status of a specific SSL certificate task.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "description": "Task ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Billing"],
        "operationId": "getAccountInfo",
        "summary": "Get account information",
        "description": "Retrieve the properties and details of the authenticated account.",
        "responses": {
          "200": {
            "description": "Account details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/bill": {
      "get": {
        "tags": ["Billing"],
        "operationId": "listBills",
