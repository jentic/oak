        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by IP type",
            "schema": { "type": "string", "enum": ["cdn", "cloud", "dedicated", "failover", "hosted_ssl", "housing", "loadBalancing", "mail", "overthebox", "pcc", "pci", "private", "vpn", "vps", "vrack", "xdsl"] }
          },
          {
            "name": "ip",
            "in": "query",
            "description": "Filter by IP block",
            "schema": { "type": "string" }
          },
          {
            "name": "routedTo.serviceName",
            "in": "query",
            "description": "Filter by service the IP is routed to",
            "schema": { "type": "string" }
          },
          {
            "name": "description",
            "in": "query",
            "description": "Filter by description",
            "schema": { "type": "string" }
          },
          {
            "name": "version",
            "in": "query",
            "description": "Filter by IP version",
            "schema": { "type": "integer", "enum": [4, 6] }
          }
        ],
        "responses": {
          "200": {
            "description": "List of IP blocks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
