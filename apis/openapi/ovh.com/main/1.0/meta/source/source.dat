            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to"],
                "properties": {
                  "to": { "type": "string", "description": "Destination service name" },
                  "nexthop": { "type": "string", "description": "Next hop IP address" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
