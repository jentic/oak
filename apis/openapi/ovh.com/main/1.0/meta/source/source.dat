    "/domain/zone/{zoneName}/record": {
      "get": {
        "tags": ["DNS"],
        "operationId": "listDnsRecords",
        "summary": "List DNS records",
        "description": "Retrieve all DNS records for a specific zone.",
        "parameters": [
          { "$ref": "#/components/parameters/ZoneName" },
          {
            "name": "fieldType",
            "in": "query",
            "description": "Filter by record type",
            "schema": { "type": "string", "enum": ["A", "AAAA", "CNAME", "DKIM", "LOC", "MX", "NAPTR", "NS", "PTR", "SPF", "SRV", "SSHFP", "TLSA", "TXT"] }
          },
          {
            "name": "subDomain",
            "in": "query",
            "description": "Filter by subdomain",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of record IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "integer" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["DNS"],
        "operationId": "createDnsRecord",
        "summary": "Create a DNS record",
        "description": "Create a new DNS record in the specified zone.",
        "parameters": [
          { "$ref": "#/components/parameters/ZoneName" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fieldType", "target"],
                "properties": {
                  "fieldType": { "type": "string", "enum": ["A", "AAAA", "CNAME", "DKIM", "LOC", "MX", "NAPTR", "NS", "PTR", "SPF", "SRV", "SSHFP", "TLSA", "TXT"], "description": "Record type" },
                  "subDomain": { "type": "string", "description": "Subdomain name" },
                  "target": { "type": "string", "description": "Record value/target" },
                  "ttl": { "type": "integer", "description": "TTL in seconds" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Record created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DnsRecord" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
