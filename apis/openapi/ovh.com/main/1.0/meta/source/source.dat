    "/me/debtAccount": {
      "get": {
        "tags": ["Billing"],
        "operationId": "getDebtAccount",
        "summary": "Get debt account balance",
        "description": "Retrieve the debt account balance for the authenticated account.",
        "responses": {
          "200": {
            "description": "Debt account details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "active": { "type": "boolean" },
                    "dueAmount": { "type": "number", "format": "double" },
                    "pendingAmount": { "type": "number", "format": "double" },
                    "todoAmount": { "type": "number", "format": "double" },
                    "unmaturedAmount": { "type": "number", "format": "double" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/debtAccount/debt": {
      "get": {
        "tags": ["Billing"],
        "operationId": "listDebts",
        "summary": "List all debts",
        "description": "Retrieve all debts associated with the account.",
        "responses": {
          "200": {
            "description": "List of debt IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "integer" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/debtAccount/debt/{debtId}": {
      "get": {
        "tags": ["Billing"],
        "operationId": "getDebt",
        "summary": "Get debt details",
        "description": "Retrieve the details of a specific debt.",
        "parameters": [
          {
            "name": "debtId",
            "in": "path",
            "required": true,
            "description": "Debt ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Debt details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "debtId": { "type": "integer" },
                    "amount": { "type": "number", "format": "double" },
                    "date": { "type": "string", "format": "date-time" },
                    "status": { "type": "string" },
                    "orderId": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/debtAccount/pay": {
      "post": {
        "tags": ["Billing"],
        "operationId": "payAllDebts",
        "summary": "Pay all due debts",
        "description": "Create an order to pay all due debts on the account.",
        "responses": {
          "200": {
            "description": "Payment order created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": { "type": "integer" },
                    "url": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/order": {
      "get": {
        "tags": ["Billing"],
        "operationId": "listOrders",
        "summary": "List all orders",
        "description": "Retrieve all orders placed on the account.",
        "parameters": [
          {
            "name": "date.from",
            "in": "query",
            "description": "Filter orders from this date",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "date.to",
            "in": "query",
            "description": "Filter orders until this date",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of order IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "integer" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/order/{orderId}": {
      "get": {
        "tags": ["Billing"],
        "operationId": "getOrder",
        "summary": "Get order details",
        "description": "Retrieve the details of a specific order.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Order ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/order/{orderId}/status": {
      "get": {
        "tags": ["Billing"],
        "operationId": "getOrderStatus",
        "summary": "Get order status",
        "description": "Retrieve the current status of a specific order.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Order ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Order status",
            "content": {
              "application/json": {
                "schema": { "type": "string", "enum": ["cancelled", "delivered", "delivering", "delivered", "notPaid", "unknown"] }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/autorenew": {
      "get": {
        "tags": ["Billing"],
        "operationId": "getAutoRenew",
        "summary": "Get auto-renewal settings",
        "description": "Retrieve auto-renewal configuration for the account.",
        "responses": {
          "200": {
            "description": "Auto-renewal settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "active": { "type": "boolean" },
                    "lastRenew": { "type": "string", "format": "date-time" },
                    "renewDay": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ovhAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Ovh-Application",
        "description": "OVHcloud API authentication uses three headers: X-Ovh-Application (Application Key), X-Ovh-Consumer (Consumer Key), X-Ovh-Timestamp (UNIX timestamp), and X-Ovh-Signature (SHA1 signature computed as '$1$' + SHA1(AS+'+'+CK+'+'+METHOD+'+'+QUERY+'+'+BODY+'+'+TSTAMP) where AS=Application Secret, CK=Consumer Key). Obtain credentials at https://api.ovh.com/createApp/"
      }
    },
    "parameters": {
      "ServiceName": {
        "name": "serviceName",
        "in": "path",
        "required": true,
        "description": "Service name identifier",
        "schema": { "type": "string" }
      },
      "InstanceId": {
        "name": "instanceId",
        "in": "path",
        "required": true,
        "description": "Instance ID",
        "schema": { "type": "string" }
      },
      "VolumeId": {
        "name": "volumeId",
        "in": "path",
        "required": true,
        "description": "Volume ID",
        "schema": { "type": "string" }
      },
      "ZoneName": {
        "name": "zoneName",
        "in": "path",
        "required": true,
        "description": "DNS zone name",
        "schema": { "type": "string" }
      },
      "RecordId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "DNS record ID",
        "schema": { "type": "integer" }
      },
      "IpBlock": {
        "name": "ip",
        "in": "path",
        "required": true,
        "description": "IP block (CIDR notation, e.g. 1.2.3.4/32)",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - invalid parameters or malformed request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or invalid credentials",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "errorCode": { "type": "string", "description": "Error code identifier" },
          "httpCode": { "type": "string", "description": "HTTP status message" },
          "message": { "type": "string", "description": "Human-readable error message" }
        }
      },
      "AccessRule": {
        "type": "object",
        "properties": {
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"], "description": "HTTP method" },
          "path": { "type": "string", "description": "API path pattern (supports wildcards)" }
        },
        "required": ["method", "path"]
      },
      "ApiCredential": {
        "type": "object",
        "properties": {
          "credentialId": { "type": "integer" },
          "applicationId": { "type": "integer" },
          "creation": { "type": "string", "format": "date-time" },
          "expiration": { "type": "string", "format": "date-time" },
          "lastUse": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["expired", "pendingValidation", "refused", "validated"] },
          "rules": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessRule" }
          }
        }
      },
      "CloudProject": {
        "type": "object",
        "properties": {
          "projectId": { "type": "string" },
          "projectName": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["creating", "deleting", "ok", "suspended"] },
          "creationDate": { "type": "string", "format": "date-time" },
          "expiration": { "type": "string", "format": "date-time" },
          "unleash": { "type": "boolean" },
          "access": { "type": "string", "enum": ["full", "restricted"] }
        }
      },
      "CloudInstance": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "flavorId": { "type": "string" },
          "imageId": { "type": "string" },
          "region": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "BUILD", "DELETED", "DELETING", "ERROR", "HARD_REBOOT", "MIGRATING", "PASSWORD", "PAUSED", "REBOOT", "REBUILD", "RESCUED", "RESIZED", "REVERT_RESIZE", "SHUTOFF", "SOFT_DELETED", "STOPPED", "SUSPENDED", "UNKNOWN", "VERIFY_RESIZE"] },
          "created": { "type": "string", "format": "date-time" },
          "ipAddresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ip": { "type": "string" },
                "type": { "type": "string", "enum": ["private", "public"] },
                "version": { "type": "integer" }
              }
            }
          },
          "monthlyBilling": {
            "type": "object",
            "nullable": true,
            "properties": {
              "since": { "type": "string", "format": "date-time" },
              "status": { "type": "string" }
            }
          },
          "sshKey": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      },
      "CloudImage": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "visibility": { "type": "string" },
          "type": { "type": "string", "enum": ["linux", "windows"] },
          "status": { "type": "string" },
          "minDisk": { "type": "integer", "description": "Minimum disk size in GB" },
          "minRam": { "type": "integer", "description": "Minimum RAM in MB" },
          "size": { "type": "number", "description": "Image size in bytes" },
          "creationDate": { "type": "string", "format": "date-time" }
        }
      },
      "CloudFlavor": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "ram": { "type": "integer", "description": "RAM in MB" },
          "disk": { "type": "integer", "description": "Disk size in GB" },
          "vcpus": { "type": "integer", "description": "Number of virtual CPUs" },
          "type": { "type": "string" },
          "available": { "type": "boolean" },
          "osType": { "type": "string" }
        }
      },
      "CloudNetwork": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "BUILDING"] },
          "type": { "type": "string" },
          "vlanId": { "type": "integer" },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "region": { "type": "string" },
                "status": { "type": "string" }
              }
            }
          }
        }
      },
      "CloudVolume": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "region": { "type": "string" },
          "size": { "type": "integer", "description": "Size in GB" },
          "status": { "type": "string", "enum": ["available", "creating", "deleting", "error", "in-use"] },
          "type": { "type": "string", "enum": ["classic", "high-speed"] },
          "attachedTo": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Instance IDs the volume is attached to"
          },
          "bootable": { "type": "boolean" },
          "creationDate": { "type": "string", "format": "date-time" }
        }
      },
      "CloudSnapshot": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "status": { "type": "string" },
          "size": { "type": "number", "description": "Size in bytes" },
          "minDisk": { "type": "integer", "description": "Minimum disk in GB" },
          "minRam": { "type": "integer", "description": "Minimum RAM in MB" },
          "visibility": { "type": "string" },
          "creationDate": { "type": "string", "format": "date-time" }
        }
      },
      "DnsZone": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "hasDnsAnycast": { "type": "boolean" },
          "lastUpdate": { "type": "string", "format": "date-time" },
          "nameServers": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "DnsRecord": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "fieldType": { "type": "string", "enum": ["A", "AAAA", "CNAME", "DKIM", "LOC", "MX", "NAPTR", "NS", "PTR", "SPF", "SRV", "SSHFP", "TLSA", "TXT"] },
          "subDomain": { "type": "string" },
          "target": { "type": "string" },
          "ttl": { "type": "integer" },
          "zone": { "type": "string" }
        }
      },
      "Domain": {
        "type": "object",
        "properties": {
          "domain": { "type": "string" },
          "nameServerType": { "type": "string", "enum": ["external", "hosted"] },
          "offer": { "type": "string" },
          "transferLockStatus": { "type": "string", "enum": ["locked", "locking", "unavailable", "unlocked", "unlocking"] },
          "whoisOwner": { "type": "string" },
          "lastUpdate": { "type": "string", "format": "date-time" },
          "expirationDate": { "type": "string", "format": "date-time" }
        }
      },
      "DedicatedServer": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "ip": { "type": "string" },
          "datacenter": { "type": "string" },
          "commercialRange": { "type": "string" },
          "os": { "type": "string" },
          "reverse": { "type": "string" },
          "state": { "type": "string", "enum": ["error", "hacked", "hackedBlocked", "ok"] },
          "monitoring": { "type": "boolean" },
          "rack": { "type": "string" },
          "supportLevel": { "type": "string", "enum": ["critical", "fastpath", "gs", "pro", "technic"] },
          "professionalUse": { "type": "boolean" },
          "bootId": { "type": "integer" },
          "rescueMail": { "type": "string" },
          "linkSpeed": { "type": "integer", "description": "Network link speed in Mbps" }
        }
      },
      "Vps": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "displayName": { "type": "string" },
          "model": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "offer": { "type": "string" },
              "memory": { "type": "integer" },
              "vcore": { "type": "integer" },
              "disk": { "type": "integer" }
            }
          },
          "cluster": { "type": "string" },
          "zone": { "type": "string" },
          "state": { "type": "string", "enum": ["backuping", "installing", "maintenance", "rebooting", "rescued", "running", "snapshotting", "stopped", "stopping", "upgrading"] },
          "netbootMode": { "type": "string", "enum": ["local", "rescue"] },
          "keymap": { "type": "string" },
          "slaMonitoring": { "type": "boolean" },
          "offerType": { "type": "string" }
        }
      },
      "IpBlock": {
        "type": "object",
        "properties": {
          "ip": { "type": "string", "description": "IP block in CIDR notation" },
          "description": { "type": "string" },
          "canBeTerminated": { "type": "boolean" },
          "country": { "type": "string" },
          "type": { "type": "string", "enum": ["cdn", "cloud", "dedicated", "failover", "hosted_ssl", "housing", "loadBalancing", "mail", "overthebox", "pcc", "pci", "private", "vpn", "vps", "vrack", "xdsl"] },
          "routedTo": {
            "type": "object",
            "properties": {
              "serviceName": { "type": "string" }
            }
          },
          "organisationId": { "type": "string" },
          "version": { "type": "integer", "enum": [4, 6] }
        }
      },
      "IpReverse": {
        "type": "object",
        "properties": {
          "ipReverse": { "type": "string", "description": "IP address" },
          "reverse": { "type": "string", "description": "Reverse DNS hostname" }
        }
      },
      "SslCertificate": {
        "type": "object",
        "properties": {
          "serviceName": { "type": "string" },
          "cn": { "type": "string", "description": "Common name" },
          "status": { "type": "string", "enum": ["creating", "error", "ok", "validating"] },
          "type": { "type": "string" },
          "subjectAltName": {
            "type": "array",
            "items": { "type": "string" }
          },
          "authority": { "type": "string" },
          "certificateSigningRequest": { "type": "string" },
          "certificate": { "type": "string" },
          "chain": { "type": "string" },
          "expirationDate": { "type": "string", "format": "date-time" },
          "creationDate": { "type": "string", "format": "date-time" }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "nichandle": { "type": "string" },
          "email": { "type": "string" },
          "firstname": { "type": "string" },
          "name": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" },
          "currency": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "symbol": { "type": "string" }
            }
          },
          "legalform": { "type": "string" },
          "organisation": { "type": "string" },
          "ovhCompany": { "type": "string" },
          "ovhSubsidiary": { "type": "string" },
          "state": { "type": "string" }
        }
      },
      "Bill": {
        "type": "object",
        "properties": {
          "billId": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "orderId": { "type": "integer" },
          "password": { "type": "string" },
          "pdfUrl": { "type": "string" },
          "priceWithTax": {
            "type": "object",
            "properties": {
              "currencyCode": { "type": "string" },
              "text": { "type": "string" },
              "value": { "type": "number", "format": "double" }
            }
          },
          "priceWithoutTax": {
            "type": "object",
            "properties": {
              "currencyCode": { "type": "string" },
              "text": { "type": "string" },
              "value": { "type": "number", "format": "double" }
            }
          },
          "tax": {
            "type": "object",
            "properties": {
              "currencyCode": { "type": "string" },
              "text": { "type": "string" },
              "value": { "type": "number", "format": "double" }
            }
          },
          "url": { "type": "string" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "orderId": { "type": "integer" },
          "date": { "type": "string", "format": "date-time" },
          "expirationDate": { "type": "string", "format": "date-time" },
          "password": { "type": "string" },
          "pdfUrl": { "type": "string" },
          "url": { "type": "string" },
          "priceWithTax": {
            "type": "object",
            "properties": {
              "currencyCode": { "type": "string" },
              "text": { "type": "string" },
              "value": { "type": "number", "format": "double" }
            }
          },
          "priceWithoutTax": {
            "type": "object",
            "properties": {
              "currencyCode": { "type": "string" },
              "text": { "type": "string" },
              "value": { "type": "number", "format": "double" }
            }
          },
          "tax": {
            "type": "object",
            "properties": {
              "currencyCode": { "type": "string" },
              "text": { "type": "string" },
              "value": { "type": "number", "format": "double" }
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "taskId": { "type": "integer" },
          "function": { "type": "string" },
          "status": { "type": "string", "enum": ["cancelled", "customerError", "doing", "done", "init", "ovhError", "todo"] },
          "startDate": { "type": "string", "format": "date-time" },
          "doneDate": { "type": "string", "format": "date-time" },
          "lastUpdate": { "type": "string", "format": "date-time" },
          "comment": { "type": "string" }
        }
      }
    }
  }
}