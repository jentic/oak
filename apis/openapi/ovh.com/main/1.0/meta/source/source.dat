    "/dedicated/server/{serviceName}/specifications/hardware": {
      "get": {
        "tags": ["Dedicated Servers"],
        "operationId": "getDedicatedServerHardware",
        "summary": "Get server hardware specifications",
        "description": "Retrieve CPU, RAM, storage, and other hardware specifications of a dedicated server.",
        "parameters": [
          { "$ref": "#/components/parameters/ServiceName" }
        ],
        "responses": {
          "200": {
            "description": "Hardware specifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "motherboard": { "type": "string" },
                    "numberOfProcessors": { "type": "integer" },
                    "processorName": { "type": "string" },
                    "memorySize": { "type": "integer", "description": "Memory size in MB" },
                    "diskGroups": {
                      "type": "array",
                      "items": {
                        "type": "object",
