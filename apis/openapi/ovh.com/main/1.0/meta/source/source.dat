                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["IP"],
        "operationId": "addIpToFirewall",
        "summary": "Enable firewall on an IP",
        "description": "Add an IP address to the firewall for rule management.",
        "parameters": [
          { "$ref": "#/components/parameters/IpBlock" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ipOnFirewall"],
                "properties": {
                  "ipOnFirewall": { "type": "string", "description": "IP address to add to firewall" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "IP added to firewall" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/ip/{ip}/firewall/{ipOnFirewall}/rule": {
      "get": {
        "tags": ["IP"],
        "operationId": "listFirewallRules",
        "summary": "List firewall rules for an IP",
        "description": "Retrieve all firewall rules configured for a specific IP address.",
        "parameters": [
          { "$ref": "#/components/parameters/IpBlock" },
          {
            "name": "ipOnFirewall",
            "in": "path",
            "required": true,
            "description": "IP address on the firewall",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of rule sequence numbers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "integer" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["IP"],
        "operationId": "createFirewallRule",
        "summary": "Create a firewall rule",
        "description": "Create a new firewall rule for a specific IP address.",
        "parameters": [
          { "$ref": "#/components/parameters/IpBlock" },
          {
            "name": "ipOnFirewall",
            "in": "path",
            "required": true,
            "description": "IP address on the firewall",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "protocol", "sequence"],
                "properties": {
                  "action": { "type": "string", "enum": ["deny", "permit"], "description": "Rule action" },
                  "protocol": { "type": "string", "enum": ["ah", "esp", "gre", "icmp", "ipv4", "tcp", "udp"], "description": "Protocol" },
                  "sequence": { "type": "integer", "description": "Rule priority (0-19)" },
                  "source": { "type": "string", "description": "Source IP or CIDR" },
                  "sourcePort": { "type": "integer", "description": "Source port" },
                  "destinationPort": { "type": "integer", "description": "Destination port" },
                  "tcpOption": { "type": "string", "description": "TCP option flags" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Firewall rule created" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
