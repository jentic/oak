{
  "openapi": "3.0.3",
  "info": {
    "title": "Linkup Search API",
    "description": "Linkup provides real-time web searching with source-backed answers and comprehensive result gathering through natural language queries. Useful for AI agents needing web search capabilities.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.linkup.so/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.linkup.so"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/search": {
      "post": {
        "operationId": "searchWeb",
        "summary": "Search the web for content matching a query",
        "description": "Retrieve web content using natural language queries with multiple output formats including search results, sourced answers, and structured data.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["q", "depth"],
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "The search query string"
                  },
                  "depth": {
                    "type": "string",
                    "enum": ["standard", "deep"],
                    "description": "Search depth - standard for quick results, deep for comprehensive research"
                  },
                  "outputType": {
                    "type": "string",
                    "enum": ["searchResults", "sourcedAnswer", "structured"],
                    "description": "Format of the output"
                  },
                  "fromDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Filter results from this date"
                  },
                  "toDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Filter results up to this date"
                  },
                  "includeDomains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 100,
                    "description": "Restrict search to these domains"
                  },
                  "excludeDomains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Exclude these domains from search"
                  },
                  "maxResults": {
                    "type": "integer",
                    "description": "Maximum number of results to return"
                  },
                  "structuredOutputSchema": {
                    "type": "object",
                    "description": "JSON schema for structured output format"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "content": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "answer": {
                      "type": "string",
                      "description": "Sourced answer when outputType is sourcedAnswer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "402": {
            "description": "Payment required - insufficient credits"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/v1/fetch": {
      "post": {
        "operationId": "fetchWebpage",
        "summary": "Fetch content from a single webpage",
        "description": "Retrieve the content of a single webpage given its URL, with optional JavaScript rendering and image extraction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL of the webpage to fetch"
                  },
                  "renderJs": {
                    "type": "boolean",
                    "description": "Whether to render JavaScript on the page"
                  },
                  "includeRawHtml": {
                    "type": "boolean",
                    "description": "Whether to include raw HTML in the response"
                  },
                  "extractImages": {
                    "type": "boolean",
                    "description": "Whether to extract images from the page"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully fetched webpage content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "markdown": {
                      "type": "string",
                      "description": "Page content as markdown"
                    },
                    "rawHtml": {
                      "type": "string",
                      "description": "Raw HTML of the page"
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Extracted image URLs"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/responses": {
      "post": {
        "operationId": "createResponse",
        "summary": "Generate an AI response using web search context",
        "description": "OpenAI-compatible response generation endpoint that uses web search to ground responses.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input", "model"],
                "properties": {
                  "input": {
                    "type": "string",
                    "description": "The input prompt or question"
                  },
                  "model": {
                    "type": "string",
                    "description": "The model identifier to use"
                  },
                  "instructions": {
                    "type": "string",
                    "description": "Optional system instructions"
                  },
                  "text": {
                    "type": "object",
                    "description": "Text formatting options"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response generation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/credits/balance": {
      "get": {
        "operationId": "getCreditsBalance",
        "summary": "Retrieve current credits balance",
        "description": "Get the current credit balance for the authenticated organization.",
        "responses": {
          "200": {
            "description": "Current balance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "balance": {
                      "type": "number",
                      "description": "Current credit balance"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/research": {
      "post": {
        "operationId": "createResearchTask",
        "summary": "Create an asynchronous research task",
        "description": "Creates a comprehensive web research task that runs asynchronously. Beta feature.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["q"],
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "The research query"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Research task created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The research task ID"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      },
      "get": {
        "operationId": "listResearchTasks",
        "summary": "List all research tasks",
        "description": "Lists all research tasks for the authenticated organization. Beta feature.",
        "responses": {
          "200": {
            "description": "List of research tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/research/{id}": {
      "get": {
        "operationId": "getResearchTask",
        "summary": "Retrieve a specific research task",
        "description": "Get the status and results of a specific research task by ID. Beta feature.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The research task ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Research task details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "result": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "404": {
            "description": "Research task not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Linkup API key passed as Bearer token. Obtain from https://app.linkup.so"
      }
    }
  }
}