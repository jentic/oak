  "components": {
    "schemas": {
      "EmailVerifyRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "EmailVerifyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "email_address": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "BulkVerifyRequest": {
        "type": "object",
        "properties": {
          "emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BulkVerifyResponse": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "BulkProgressResponse": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          }
        }
      },
      "CreditsResponse": {
        "type": "object",
        "properties": {
          "credits": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
