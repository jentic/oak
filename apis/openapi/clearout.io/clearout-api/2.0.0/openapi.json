        "operationId": "getBulkVerifyStatus",
        "summary": "Check bulk verification status",
        "tags": [
          "Email Verification"
        ],
        "parameters": [
          {
            "name": "list_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
