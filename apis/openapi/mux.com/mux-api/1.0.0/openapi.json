  "components": {
    "schemas": {
      "Asset": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "status": {"type": "string", "enum": ["preparing", "ready", "errored"]},
          "duration": {"type": "number"},
          "playback_ids": {"type": "array", "items": {"$ref": "#/components/schemas/PlaybackId"}},
          "tracks": {"type": "array", "items": {"type": "object"}}
        }
      },
      "CreateAssetRequest": {
        "type": "object",
        "properties": {
          "input": {"type": "array", "items": {"type": "object", "properties": {"url": {"type": "string"}}}},
          "playback_policy": {"type": "array", "items": {"type": "string", "enum": ["public", "signed"]}}
        }
      },
      "UpdateAssetRequest": {
        "type": "object",
        "properties": {
          "passthrough": {"type": "string"}
        }
      },
      "AssetResponse": {
        "type": "object",
        "properties": {
          "data": {"$ref": "#/components/schemas/Asset"}
        }
      },
      "AssetListResponse": {
        "type": "object",
        "properties": {
          "data": {"type": "array", "items": {"$ref": "#/components/schemas/Asset"}}
        }
      },
      "PlaybackId": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "policy": {"type": "string", "enum": ["public", "signed"]}
        }
      },
      "PlaybackIdResponse": {
        "type": "object",
        "properties": {
          "data": {"$ref": "#/components/schemas/PlaybackId"}
        }
      },
      "LiveStream": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "stream_key": {"type": "string"},
          "status": {"type": "string", "enum": ["idle", "active", "disabled"]},
          "playback_ids": {"type": "array", "items": {"$ref": "#/components/schemas/PlaybackId"}}
        }
      },
      "CreateLiveStreamRequest": {
        "type": "object",
        "properties": {
          "playback_policy": {"type": "array", "items": {"type": "string", "enum": ["public", "signed"]}},
          "new_asset_settings": {"type": "object"}
        }
      },
      "UpdateLiveStreamRequest": {
        "type": "object",
        "properties": {
          "passthrough": {"type": "string"},
          "latency_mode": {"type": "string"}
        }
      },
      "LiveStreamResponse": {
        "type": "object",
        "properties": {
          "data": {"$ref": "#/components/schemas/LiveStream"}
        }
      },
      "LiveStreamListResponse": {
        "type": "object",
        "properties": {
          "data": {"type": "array", "items": {"$ref": "#/components/schemas/LiveStream"}}
        }
      },
      "SigningKeyResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "created_at": {"type": "string", "format": "date-time"},
              "private_key": {"type": "string"}
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "message": {"type": "string"}
            }
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic authentication using Mux API access token ID and secret key"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}