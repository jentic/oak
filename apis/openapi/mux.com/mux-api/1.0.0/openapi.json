{
  "openapi": "3.0.3",
  "info": {
    "title": "Mux API",
    "version": "1.0.0",
    "description": "Mux is an API-first platform for video and data. The Mux API provides endpoints for managing video assets, live streams, playback IDs, signing keys, direct uploads, playback restrictions, DRM configurations, delivery usage, and data/analytics.",
    "x-jentic-source-url": "https://docs.mux.com/"
  },
  "servers": [
    {
      "url": "https://api.mux.com"
    }
  ],
