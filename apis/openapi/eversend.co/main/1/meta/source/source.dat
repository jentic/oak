{
  "openapi": "3.0.3",
  "info": {
    "title": "Eversend Money Transfer & Payments API",
    "description": "Eversend is a money transfer and payments API that enables businesses to manage multi-currency wallets, send payouts via mobile money and bank transfers, collect payments, exchange currencies, manage beneficiaries, handle crypto transactions, and issue virtual cards. It covers Africa and global markets with support for multiple payment rails.",
    "version": "1",
    "x-jentic-source-url": "https://eversend.readme.io/"
  },
  "servers": [
    {
      "url": "https://api.eversend.co/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/auth/token": {
      "get": {
        "operationId": "generateAuthToken",
        "summary": "Generate authentication token",
        "description": "Exchange client credentials for a Bearer token used to authenticate subsequent API requests.",
        "tags": ["Authentication"],
        "security": [],
        "parameters": [
          {
            "name": "clientId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Your Eversend client ID"
          },
          {
            "name": "clientSecret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Your Eversend client secret"
          }
        ],
        "responses": {
          "200": {
            "description": "Token generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "token": {
                      "type": "string",
                      "description": "JWT Bearer token for authentication"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/wallets": {
      "get": {
        "operationId": "getWallets",
        "summary": "Get all wallets",
        "description": "Retrieve a list of all wallets associated with your account, including balances and enabled status.",
        "tags": ["Wallets"],
        "responses": {
          "200": {
            "description": "Wallets retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Wallet"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/wallets/{walletId}": {
      "get": {
        "operationId": "getWalletById",
        "summary": "Get a specific wallet",
        "description": "Retrieve details of a specific wallet by its ID.",
        "tags": ["Wallets"],
        "parameters": [
          {
            "name": "walletId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The wallet identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Wallet"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/wallets/activate": {
      "post": {
        "operationId": "activateWallet",
        "summary": "Activate a wallet",
        "description": "Activate a wallet for a specific currency.",
        "tags": ["Wallets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["wallet"],
                "properties": {
                  "wallet": {
                    "type": "string",
                    "description": "The currency code of the wallet to activate (e.g., USD, KES, NGN)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Wallet activated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/wallets/deactivate": {
      "post": {
        "operationId": "deactivateWallet",
        "summary": "Deactivate a wallet",
        "description": "Deactivate a wallet for a specific currency.",
        "tags": ["Wallets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["wallet"],
                "properties": {
                  "wallet": {
                    "type": "string",
                    "description": "The currency code of the wallet to deactivate"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Wallet deactivated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/account": {
      "get": {
        "operationId": "getAccountProfile",
        "summary": "Get account profile",
        "description": "Retrieve account profile information including name, email, phone, address, and verification status.",
        "tags": ["Accounts"],
        "responses": {
          "200": {
            "description": "Account profile retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/AccountProfile"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/exchanges/quotation": {
      "post": {
        "operationId": "createExchangeQuotation",
        "summary": "Create an exchange quotation",
        "description": "Get a quotation for exchanging between two currencies. The returned token must be used within the expiration window to execute the exchange.",
        "tags": ["Exchange"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["from", "to", "amount"],
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "Source currency code (e.g., USD)"
                  },
                  "to": {
                    "type": "string",
                    "description": "Destination currency code (e.g., KES)"
                  },
                  "amount": {
                    "type": "number",
                    "description": "Amount to exchange in source currency"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quotation created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "JWT token containing quotation data"
                        },
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "number"
                        },
                        "exchangeRate": {
                          "type": "number"
                        },
                        "convertedAmount": {
                          "type": "number"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/exchanges": {
      "post": {
        "operationId": "createExchange",
        "summary": "Execute a currency exchange",
        "description": "Execute a currency exchange using a quotation token obtained from the quotation endpoint.",
        "tags": ["Exchange"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "The quotation token from the create quotation response"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exchange executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "transactionId": {
                          "type": "string"
                        },
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "number"
                        },
                        "convertedAmount": {
                          "type": "number"
                        },
                        "exchangeRate": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - expired or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/beneficiaries": {
      "post": {
        "operationId": "createBeneficiaries",
        "summary": "Create beneficiaries",
        "description": "Create one or more beneficiaries for future payouts.",
        "tags": ["Beneficiaries"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BeneficiaryInput"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Beneficiaries created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Beneficiary"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getBeneficiaries",
        "summary": "Get beneficiaries",
        "description": "Retrieve a paginated list of beneficiaries, optionally filtered by type or search term.",
        "tags": ["Beneficiaries"],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["momo", "bank", "eversend"]
            },
            "description": "Filter by beneficiary type"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search by name or account details"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Number of results per page"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Page number"
          }
        ],
        "responses": {
          "200": {
            "description": "Beneficiaries retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Beneficiary"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/beneficiaries/{beneficiaryId}": {
      "get": {
        "operationId": "getBeneficiaryById",
        "summary": "Get a beneficiary",
        "description": "Retrieve details of a specific beneficiary.",
        "tags": ["Beneficiaries"],
        "parameters": [
          {
            "name": "beneficiaryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The beneficiary identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Beneficiary details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Beneficiary"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "editBeneficiary",
        "summary": "Edit a beneficiary",
        "description": "Update details of an existing beneficiary.",
        "tags": ["Beneficiaries"],
        "parameters": [
          {
            "name": "beneficiaryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The beneficiary identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "phoneNumber": {
                    "type": "string"
                  },
                  "bankName": {
                    "type": "string"
                  },
                  "bankCode": {
                    "type": "string"
                  },
                  "bankAccountName": {
                    "type": "string"
                  },
                  "bankAccountNumber": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Beneficiary updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Beneficiary"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteBeneficiary",
        "summary": "Delete a beneficiary",
        "description": "Delete a beneficiary by ID.",
        "tags": ["Beneficiaries"],
        "parameters": [
          {
            "name": "beneficiaryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The beneficiary identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Beneficiary deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/beneficiaries/accounts/banks": {
      "post": {
        "operationId": "getBankAccountDetails",
        "summary": "Get bank account details",
        "description": "Verify and retrieve bank account details for a given account number and bank code.",
        "tags": ["Beneficiaries"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["countryCode", "bankCode", "accountNumber"],
                "properties": {
                  "countryCode": {
                    "type": "string",
                    "description": "ISO 2-character country code"
                  },
                  "bankCode": {
                    "type": "string",
                    "description": "The bank code"
                  },
                  "accountNumber": {
                    "type": "string",
                    "description": "The bank account number to verify"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bank details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "bankCode": {
                          "type": "string"
                        },
                        "accountNumber": {
                          "type": "string"
                        },
                        "accountName": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/beneficiaries/accounts/eversend": {
      "post": {
        "operationId": "checkEversendAccount",
        "summary": "Check Eversend account",
        "description": "Look up an Eversend user account by phone number or email to verify they exist.",
        "tags": ["Beneficiaries"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "description": "Phone number to look up"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address to look up"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "exists": {
                          "type": "boolean"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payouts/countries": {
      "get": {
        "operationId": "getDeliveryCountries",
        "summary": "Get delivery countries",
        "description": "Retrieve the list of countries where payouts can be delivered, along with supported payment types and phone prefixes.",
        "tags": ["Payouts"],
        "responses": {
          "200": {
            "description": "Delivery countries retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "country": {
                            "type": "string"
                          },
                          "countryCode": {
                            "type": "string"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "paymentTypes": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": ["momo", "bank"]
                            }
                          },
                          "phonePrefixes": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payouts/banks/{country}": {
      "get": {
        "operationId": "getDeliveryBanks",
        "summary": "Get delivery banks for a country",
        "description": "Retrieve the list of banks available for payouts in a specific country.",
        "tags": ["Payouts"],
        "parameters": [
          {
            "name": "country",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The two-letter country code (e.g., UG, KE, NG)"
          }
        ],
        "responses": {
          "200": {
            "description": "Banks retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bankName": {
                            "type": "string"
                          },
                          "bankCode": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payouts/quotation": {
      "post": {
        "operationId": "createPayoutQuotation",
        "summary": "Create payout quotation (Momo & Bank)",
        "description": "Get a quotation for a mobile money or bank transfer payout, including exchange rates and fees.",
        "tags": ["Payouts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sourceWallet", "amount", "type", "destinationCountry", "destinationCurrency"],
                "properties": {
                  "sourceWallet": {
                    "type": "string",
                    "description": "Source wallet currency code"
                  },
                  "amount": {
                    "type": "number",
                    "description": "Amount to send"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["momo", "bank"],
                    "description": "Payout type"
                  },
                  "destinationCountry": {
                    "type": "string",
                    "description": "Destination country code"
                  },
                  "destinationCurrency": {
                    "type": "string",
                    "description": "Destination currency code"
                  },
                  "amountType": {
                    "type": "string",
                    "enum": ["SOURCE", "DESTINATION"],
                    "description": "Whether amount is in source or destination currency"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason for the payout"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payout quotation created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "Quotation token to use for creating the payout"
                        },
                        "sourceAmount": {
                          "type": "number"
                        },
                        "destinationAmount": {
                          "type": "number"
                        },
                        "exchangeRate": {
                          "type": "number"
                        },
                        "fees": {
                          "type": "number"
                        },
                        "totalAmount": {
                          "type": "number"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payouts": {
      "post": {
        "operationId": "createPayoutTransaction",
        "summary": "Create payout transaction",
        "description": "Execute a payout transaction using a quotation token. Supports non-beneficiary mobile money, non-beneficiary bank transfer, and beneficiary-based payouts.",
        "tags": ["Payouts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Quotation token from payout quotation endpoint"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Recipient phone number (for non-beneficiary momo payouts)"
                  },
                  "firstName": {
                    "type": "string",
                    "description": "Recipient first name"
                  },
                  "lastName": {
                    "type": "string",
                    "description": "Recipient last name"
                  },
                  "country": {
                    "type": "string",
                    "description": "Recipient country code"
                  },
                  "bankName": {
                    "type": "string",
                    "description": "Recipient bank name (for bank payouts)"
                  },
                  "bankAccountName": {
                    "type": "string",
                    "description": "Recipient bank account name (for bank payouts)"
                  },
                  "bankCode": {
                    "type": "string",
                    "description": "Recipient bank code (for bank payouts)"
                  },
                  "bankAccountNumber": {
                    "type": "string",
                    "description": "Recipient bank account number (for bank payouts)"
                  },
                  "beneficiaryId": {
                    "type": "string",
                    "description": "Beneficiary ID (for beneficiary-based payouts)"
                  },
                  "transactionRef": {
                    "type": "string",
                    "description": "Your own transaction reference"
                  },
                  "sender": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "address": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payout transaction created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Transaction"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payouts/quotation/eversend": {
      "post": {
        "operationId": "createEversendPayoutQuotation",
