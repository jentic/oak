{
  "openapi": "3.0.3",
  "info": {
    "title": "DCBaas API",
    "description": "DCBaaS voorzag standaard enkel een webomgeving voor het uitvoeren van certificaat\u2011lifecyclebeheer. We stellen echter vast dat de toepassing steeds breder wordt ingezet en dat de nood aan kortere certificaatlevenscycli blijft toenemen. Hierdoor wordt het manueel vervangen van certificaten steeds minder werkbaar. Om aan deze evolutie tegemoet te komen, werd een API toegevoegd aan DCBaaS.",
    "contact": {
      "email": "vodcb@vlaanderen.be"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/DCBaaS-Team/DCBaaS-API/1.0.0"
  },
  "servers": [
    {
      "description": "DCBaaS Productie omgeving",
      "url": "https://extapi.dcb.vlaanderen.be"
    },
    {
      "description": "DCBaaS T&I omgeving",
      "url": "https://extapi.dcb-ti.vlaanderen.be"
    },
    {
      "description": "DCBaaS DEV omgeving",
      "url": "https://extapi.dcb-dev.vlaanderen.be"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authenticatie",
      "description": "Hier vind je de endpoint die je gebruikt om in eerste instantie te connecteren om zo een Bearer Token te verkrijgen om de calls naar DCBaaS API te doen."
    },
    {
      "name": "Health",
      "description": "Hier vind je alle endpoints die te maken hebben met health"
    },
    {
      "name": "Toepassing",
      "description": "Hier vind je alle endpoints die te maken hebben met toepassingen",
      "externalDocs": {
        "description": "Voor meer info over wat een toepassing is kan je hier terecht",
        "url": "https://vlaamseoverheid.atlassian.net/wiki/x/r4HVqQE"
      }
    },
    {
      "name": "Certificaat",
      "description": "Hier vind je alle endpoints die te maken hebben met certificaten",
      "externalDocs": {
        "description": "Voor meer info over wat een certificaat is kan je hier terecht",
        "url": "https://vlaamseoverheid.atlassian.net/wiki/x/F4LVqQE"
      }
    }
  ],
  "paths": {
    "/op/v1/token": {
      "post": {
        "tags": [
          "Authenticatie"
        ],
        "servers": [
          {
            "url": "https://authenticatie.vlaanderen.be",
            "description": "Authenticatie server voor Productie"
          },
          {
            "url": "https://authenticatie-ti.vlaanderen.be",
            "description": "Authenticatie server voor T&I en DEV"
          }
        ],
        "summary": "Token aanvragen (kies juiste auth server volgens API omgeving)",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "example": "client_credentials"
                  },
                  "audience": {
                    "type": "string",
                    "example": "Client ID DCBaaS API"
                  },
                  "client_assertion_type": {
                    "type": "string",
                    "example": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
                  },
                  "client_assertion": {
                    "type": "string",
                    "example": "JWT Token"
                  }
                },
                "required": [
                  "grant_type",
                  "audience",
                  "client_assertion_type",
                  "client_assertion"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": []
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "description": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/application/add": {
      "post": {
        "tags": [
          "Toepassing"
        ],
        "summary": "Toepassing aanmaken",
        "description": "Deze endpoint dient voor het aanmaken van een toepassing",
        "operationId": "applicationAdd",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "DCBaaS"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/application_add_body"
              },
              "examples": {
                "Application add": {
                  "value": {
                    "name": "domein/toepassingsnaam",
                    "reason": "Vul hier de reden in"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/application/update": {
      "post": {
        "tags": [
          "Toepassing"
        ],
        "summary": "Toepassing aanpassen",
        "description": "Deze endpoint dient om de reden aan te passen in de toepassing",
        "operationId": "applicationUpdate",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "localhost"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/application_update_body"
              },
              "examples": {
                "Application update": {
                  "value": {
                    "name": "domein/toepassingsnaam",
                    "reason": "Vul hier een nieuwe reden in"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/application/delegate": {
      "post": {
        "tags": [
          "Toepassing"
        ],
        "summary": "Toepassing delegeren",
        "description": "Deze endpoint dient om de toepassing te delegeren naar een andere organisatie",
        "operationId": "applicationDelegate",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "localhost"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/application_delegate_body"
              },
              "examples": {
                "Application delegate": {
                  "value": {
                    "duration": 1,
                    "name": "domein/toepassingsnaam",
                    "organization_code": "OVOCode KBOnummer Instellingsnummer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/application/delete": {
      "post": {
        "tags": [
          "Toepassing"
        ],
        "summary": "Toepassing verwijderen",
        "description": "Deze endpoint dient om een toepassing te verwijderen",
        "operationId": "applicationDelete",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "localhost"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/application_delete_body"
              },
              "examples": {
                "Application delete": {
                  "value": {
                    "name": "domein/toepassingsnaam"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/certificate/add": {
      "post": {
        "tags": [
          "Certificaat"
        ],
        "summary": "Certificaat toevoegen",
        "description": "Deze endpoint dient om een certificaat toe te voegen",
        "operationId": "certificateAdd",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "localhost"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/certificate_add_body"
              },
              "examples": {
                "Certificate add": {
                  "value": {
                    "application_name": "domein/toepassingsnaam",
                    "certificate_template": "SSL Client",
                    "contact_person": [
                      "email@adres.tld"
                    ],
                    "description": "Dit is de reden",
                    "duration": 3,
                    "file": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/certificate/revoke": {
      "post": {
        "tags": [
          "Certificaat"
        ],
        "summary": "Certificaat intrekken",
        "description": "Deze endpoint dient om het certificaat in te trekken",
        "operationId": "certificateRevoke",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "localhost"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/certificate_revoke_body"
              },
              "examples": {
                "Certificate revoke": {
                  "value": {
                    "application_name": "domein/toepassingsnaam",
                    "description": "Dit is de reden",
                    "revoke_reason": "Dit is de reden om het certificaat in te trekken",
                    "serial_number": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/certificate/renew": {
      "post": {
        "tags": [
          "Certificaat"
        ],
        "summary": "Certificaat hernieuwen",
        "description": "Deze endpoint dient om een certificaat te hernieuwen",
        "operationId": "certificateRenew",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "localhost"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/certificate_renew_body"
              },
              "examples": {
                "Certificate renew": {
                  "value": {
                    "application_name": "domein/toepassingsnaam",
                    "duration": 6,
                    "file": "",
                    "serial_number": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/certificate/search": {
      "post": {
        "tags": [
          "Certificaat"
        ],
        "summary": "Certificaat zoeken",
        "description": "Deze endpoint dient om een certificaat te zoeken",
        "operationId": "certificateSearch",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "localhost"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/certificate_search_body"
              },
              "examples": {
                "Certificate Search": {
                  "value": {
                    "application_name": "domein/toepassingsnaam"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "application_approve_body": {
        "type": "object",
        "properties": {
          "duration": {
            "type": "number",
            "example": "0,1,3,6,12,24"
          },
          "name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          }
        }
      },
      "application_update_body": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          },
          "reason": {
            "type": "string",
            "example": "Vul hier een nieuwe reden in"
          },
          "organization_code": {
            "type": "string",
            "example": "KBOnummer/OVOcode/Instellingsnummer"
          }
        }
      },
      "certificate_revoke_body": {
        "type": "object",
        "properties": {
          "application_name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          },
          "revoke_reason": {
            "type": "string",
            "example": "Dit is de reden om het certificaat in te trekken"
          },
          "serial_number": {
            "type": "string",
            "example": ""
          }
        }
      },
      "certificate_renew_body": {
        "type": "object",
        "properties": {
          "application_name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          },
          "duration": {
            "type": "number",
            "example": "3,6,12,18,24"
          },
          "file": {
            "type": "string",
            "example": ""
          },
          "serial_number": {
            "type": "string",
            "example": ""
          }
        }
      },
      "application_add_body": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          },
          "reason": {
            "type": "string",
            "example": "Vul hier de reden in"
          },
          "organization_code": {
            "type": "string",
            "example": "KBOnummer/OVOcode/Instellingsnummer"
          }
        }
      },
      "certificate_add_body": {
        "type": "object",
        "properties": {
          "application_name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          },
          "certificate_template": {
            "type": "string",
            "example": "SSL Server, SSL Client, SSL signing, SSL Client + Signing, Machine Authenticatie, ECC Client + Signing"
          },
          "contact_person": {
            "type": "array",
            "example": [
              "test@test.be"
            ],
            "items": {
              "type": "string",
              "example": "email@adres.tld"
            }
          },
          "description": {
            "type": "string",
            "example": "Dit is de reden"
          },
          "duration": {
            "type": "number",
            "example": "3,6,12,18,24"
          },
          "file": {
            "type": "string",
            "example": ""
          }
        }
      },
      "application_delete_body": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          }
        }
      },
      "application_delegate_body": {
        "type": "object",
        "properties": {
          "duration": {
            "type": "number",
            "example": "0,1,3,6,12,24"
          },
          "name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          },
          "organization_code": {
            "type": "string",
            "example": "OVOCode KBOnummer Instellingsnummer"
          }
        }
      },
      "certificate_search_body": {
        "type": "object",
        "properties": {
          "application_name": {
            "type": "string",
            "example": "domein/toepassingsnaam"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}