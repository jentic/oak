            "type": "array",
            "description": "The list of choices when the `question_type` is `choices` or `multiple_choices`",
            "items": {
              "type": "string"
            }
          },
          "appraisal_mapping": {
            "description": "The mapping attribute to find the question on your side"
          },
          "question_type": {
            "type": "string",
            "description": "The type of the question",
            "enum": [
              "text",
              "choices",
              "multiple_choices",
              "percentage"
            ]
          },
          "draw_progress_step": {
            "type": "number",
            "description": "The progress step for each line item. 1 will go from 1% to 2%. 25 will go from 0% to 25%, etc."
          },
          "budget": {
            "type": "string",
            "description": "The draw item budget in dollar format, example: '1452' for $1425.00"
          },
          "minimal_numeric_value": {
            "type": "number",
            "description": "Minimal value for the answer. To get values higher than 50% for example, use 50 on this field."
          },
          "default_answer": {
            "type": "string",
            "description": "The default answer for a question, it needs to be a text. If the question has an array of choices, this needs to be one of the provided choices."
          },
          "qa_only": {
            "type": "boolean",
            "description": "Determine if the question will be displayed to the Data Collector or not. True means that it is hidden for the Data Collector and only available for our QA team."
          }
        }
      },
