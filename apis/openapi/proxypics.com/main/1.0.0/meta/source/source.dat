    "/appraisal-requests": {
      "get": {
        "tags": [
          "Appraisal Requests"
        ],
        "summary": "List Appraisal Requests",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AppraisalRequest"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/AppraisalRequestsListMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      },
      "post": {
        "tags": [
          "Appraisal Requests"
        ],
        "summary": "Create Appraisal Request",
        "description": "When creating the Appraisal Request you need to choose which appraisal product you want and this is defined by the `type` field.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "address",
                  "type"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "description": "The photo request address (we'll run a geolocation lookup here)"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "AutomatedValuationRequest",
                      "EvaluationRequest",
                      "AppraisalFormRequest"
                    ],
                    "description": "`AutomatedValuationRequest` - AVM\n`EvaluationRequest` - Simple BPO\n`AppraisalFormRequest` - BPO with adjustments\n"
                  },
                  "report_provider": {
                    "type": "string",
                    "enum": [
                      "ca",
                      "quantarium"
                    ],
                    "description": "`ca` - Collateral Analytics\n`quantarium` - Quantarium\n"
                  },
                  "loan_number": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string",
                    "description": "If it is a condo the unit is important"
                  },
                  "occupancy": {
                    "type": "string",
                    "description": "Property occupancy"
                  },
                  "borrower_name": {
                    "type": "string"
                  },
                  "borrower_email": {
                    "type": "string"
                  },
                  "borrower_phone": {
                    "type": "string"
                  },
                  "borrower_optin": {
                    "type": "boolean"
                  },
                  "second_borrower_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppraisalRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
