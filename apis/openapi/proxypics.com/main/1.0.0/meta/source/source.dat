                "type": "number",
                "nullable": true
              },
              "assigned": {
                "type": "number",
                "nullable": true
              },
              "completed": {
                "type": "number",
                "nullable": true
              },
              "fulfilled": {
                "type": "number",
                "nullable": true
              },
              "expired": {
                "type": "number",
                "nullable": true
              },
              "rejected": {
                "type": "number",
                "nullable": true
              }
