            }
          }
        }
      },
      "CSVUpload": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Title"
          },
          "status": {
            "type": "string",
            "description": "Status"
          },
          "file_url": {
            "type": "string",
            "description": "CSV file URL used to create the bulk request"
          },
          "total_photo_requests_created": {
            "type": "number",
            "description": "Total photo requests created"
          },
          "total_photo_requests_with_error": {
            "type": "number",
            "description": "Total photo requests with error"
          },
          "total_photo_requests": {
            "type": "number",
            "description": "Total photo requests defined in the CSV file"
          },
          "download_token": {
            "type": "string",
            "description": "A token to download the CSV Summary Output"
          },
          "created_at": {
            "type": "string",
            "description": "Creation date"
          },
          "total_completed_photo_requests": {
            "type": "number",
            "description": "Total completed photo requests"
          },
          "download_report_url": {
            "type": "string",
            "description": "CSV Summary Output download URL"
          }
        }
      },
      "PhotoRequestCreateRequest": {
        "type": "object",
        "description": "Create a Photo Request.\n\nWhen creating the photo request you can specifically define the Photo Request shape\n(Tasks, Unlimited Tasks, Question Groups) or you can previously create a *Photo Request Template*\nin the ProxyPics platform, then simply pass the provided token. The latter is highly advised.\n\nFields specific to Crowdsource platform:\n- `expires_at` - The time the photo request will be available for photo takers to pick it up\n- `price_boost` - An amount you may want to add to the request price to make it more appeal for photo takers\n\nFields specific to Direct platform:\n- `property_owner_phone` (required) - The phone number to directly assign the request\n- `direct_due_date` (required) - The time the assignment will be available for completion\n\nNote on templates:\n- `template_token` - NOT NEEDED IF PDR/UPD. When you use the template token all the fields below are not considered.\n  The template token is the \"Product\" token. So the photo request is created with all the tasks and questions defined\n  in the template (product)\n\nUPD:\n- If `uniform_property_dataset_report_attributes` is set, we'll ignore the template token and use our own UPD template\n  to create the PhotoRequest.\n",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "description": "The photo request address (we'll run a geolocation lookup here)"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "If not provided, the photo request will expire in 24h"
          },
          "loan_number": {
            "type": "string",
            "description": "An identifier number defined by you"
          },
          "borrower_name": {
            "type": "string",
            "description": "An identifier for the borrower name"
          },
          "price_boost": {
            "type": "number",
            "description": "Increase the amount paid to users, expressed in cents, only used when `photo request platform` is `crowdsource`"
          },
          "property_owner_phone": {
            "type": "string",
            "description": "Required if `photo_request_platform` is `direct`, it is used to send the SMS and create a temporary account for the photo taker to take the photos"
          },
          "template_token": {
            "type": "string",
            "description": "NOT NEEDED IF PDR/UPD.\nWhen you use the `template token` all the fields below are not considered.\n"
          },
          "direct_due_date": {
            "type": "string",
            "format": "date-time",
            "description": "Required when `photo_request_platform` is `direct`"
          },
          "photo_request_platform": {
            "type": "string",
            "description": "Required if you are creating a photo request without providing the template token",
            "enum": [
              "crowdsource",
              "direct"
            ]
          },
          "unlimited_tasks": {
            "type": "boolean",
            "description": "Allow extra photo tasks to be freely taken by the photo taker"
          },
          "unlimited_tasks_descriptions": {
            "type": "string",
            "description": "Guidelines for the photo taker on what extra photo tasks should looks like"
          },
          "unlimited_sections_attributes": {
            "type": "array",
            "description": "If `unlimited_tasks` is true you need to provide at least one `unlimited_section`. Unlimited sections are meant to request unlimited photos for a specific room/place e.g. \"Bathrooms\".",
            "items": {
              "$ref": "#/components/schemas/UnlimitedSection"
            }
          },
          "lockbox": {
            "type": "string",
            "description": "Lockbox number"
          },
          "external_id": {
            "type": "string",
            "description": "External ID to associate this photo request with"
          },
          "additional_notes": {
            "type": "string",
            "description": "Additional notes to Data Collector"
          },
          "behalf_of": {
            "type": "string",
            "description": "Job's behalf"
          },
          "appointment": {
            "type": "boolean",
            "description": "Set to `true` if this job needs an appointment schedule"
          },
          "condo_unit_number": {
            "type": "string",
            "description": "Condo unit number"
          },
          "condo": {
            "type": "boolean",
            "description": "Set this attribute to true if you're using Condo unit number and you need to share this information with the Data Collector"
          },
          "tasks": {
            "type": "array",
            "nullable": true,
            "description": "It should be `null` if you pass the `template_token` otherwise it is `required`",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "question_groups": {
            "type": "array",
            "nullable": true,
            "description": "Behaves the same as `tasks`",
            "items": {
              "$ref": "#/components/schemas/QuestionGroup"
            }
          },
          "contacts_attributes": {
            "type": "array",
            "description": "Attributes for Point of Contacts",
            "items": {
              "$ref": "#/components/schemas/Contact"
            }
          },
          "appraisal_request_id": {
            "type": "number",
            "description": "The id of the appraisal request to associate this photo request with"
          },
          "report_for": {
            "type": "string",
            "description": "If provided, this value will be used inside the PDF report on 'For: ...' section."
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "The date/time (ISO8601 format) of the scheduled date (UTC). The order will be moved from \"scheduled\" to an active status after that date."
          },
          "uniform_property_dataset_report_attributes": {
            "$ref": "#/components/schemas/UniformPropertyDatasetReport"
          }
        }
      },
      "PhotoRequestExtendRequest": {
        "type": "object",
        "required": [
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "The date/time (ISO8601 format)"
          }
        }
      },
      "PhotoRequestRejectRequest": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Reason for rejection.",
            "enum": [
              "unspecified",
              "blurry_photo",
              "wrong_direction",
              "incorrect_property",
              "people_in_photo",
              "property_not_visible",
              "other"
            ]
          },
          "clarification": {
            "type": "string",
            "nullable": true,
            "description": "Clarification for rejection. It helps reviewers to understand what went wrong. It's required only if `other` reason is specified."
          }
        }
      },
      "WebhookCreateRequest": {
        "type": "object",
        "required": [
          "url",
          "method"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "The url that will receive the request"
          },
          "method": {
            "type": "string",
            "enum": [
              "get",
              "post"
            ]
          },
          "username": {
            "type": "string",
            "nullable": true,
            "description": "Username for basic authentication"
          },
          "password": {
            "type": "string",
            "nullable": true,
            "description": "Password for basic authentication"
          }
        }
      },
      "MessageCreateRequest": {
        "type": "object",
        "required": [
          "text",
          "photo_request_id"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Message content"
          },
          "photo_request_id": {
            "type": "number",
            "description": "Photo Request identifier"
          }
        }
      },
      "CompanyUpdateRequest": {
        "type": "object",
        "description": "Update your company account.\nSet notification types you want to subscribe.\n",
        "properties": {
          "name": {
            "type": "string",
            "description": "Company name"
          },
          "automatic_approve": {
            "type": "boolean",
            "description": "Automatic approve photo requests"
          },
          "direct_sms_content": {
            "type": "string",
            "description": "Direct SMS content"
          },
          "photo_request_report_disclaimer": {
            "type": "string",
            "description": "Photo request report disclaimer"
          },
          "amc_id": {
            "type": "string",
            "description": "AMC ID"
          },
          "amc_name": {
            "type": "string",
            "description": "AMC name"
          },
          "notify_webhook_photo_request_unassigned": {
            "type": "string",
            "description": "Notify webhook photo request unassigned ('true' or 'false')"
          },
          "notify_webhook_photo_request_assigned": {
            "type": "string",
            "description": "Notify webhook photo request assigned ('true' or 'false')"
          },
          "notify_webhook_photo_request_completed": {
            "type": "string",
            "description": "Notify webhook photo request completed ('true' or 'false')"
          },
          "notify_webhook_photo_request_expired": {
            "type": "string",
            "description": "Notify webhook photo request expired ('true' or 'false')"
          },
          "notify_webhook_photo_request_canceled": {
            "type": "string",
            "description": "Notify webhook photo request canceled ('true' or 'false')"
          },
          "notify_webhook_photo_request_fulfilled": {
            "type": "string",
            "description": "Notify webhook photo request fulfilled ('true' or 'false')"
          },
          "notify_webhook_photo_request_report_generated": {
            "type": "string",
            "description": "Notify webhook photo request report generated ('true' or 'false')"
          },
          "notify_webhook_appointment_scheduled": {
            "type": "string",
            "description": "Notify webhook appointment scheduled ('true' or 'false')"
          },
          "notify_webhook_assignment_accepted": {
            "type": "string",
            "description": "Notify webhook assignment accepted ('true' or 'false')"
          },
          "notify_webhook_error_occurred": {
            "type": "string",
