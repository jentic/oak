    "/photo-requests/{id}/approve": {
      "put": {
        "tags": [
          "Photo Requests"
        ],
        "summary": "Approve Photo Request",
        "description": "When a request is in `completed` state and you want to approve it you can call the Approve.\n\nApproved jobs get fulfilled after payment confirmation, after the Job gets fulfilled the report is generated automatically,\na webhook will be trigerred and you'll have access to the report PDF URL.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParamInteger"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/photo-requests/{id}/reject": {
      "put": {
        "tags": [
          "Photo Requests"
        ],
        "summary": "Reject Photo Request",
        "description": "When a request is in `completed` state and you want to reject it you can call the Reject.\n\nRejected jobs get reviewed and the responsible photo taker gets notified and he can submit the photos again.\nIf needed, the job could go to `unassigned` status again and the submission will be repeated with another photo taker.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParamInteger"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhotoRequestRejectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/photo-requests/{id}/resend-sms-to-direct-property-owner": {
      "post": {
        "tags": [
