          },
          "report_header_image_url": {
            "type": "string",
            "description": "Report header image url"
          },
          "report_footer_image_url": {
            "type": "string",
            "description": "Report footer image url"
          },
          "quality_assurance": {
            "type": "boolean",
            "description": "Quality assurance"
          },
          "pdr_enabled": {
            "type": "boolean",
            "description": "PDR enabled"
          },
          "direct_sms_content": {
            "type": "string",
            "description": "Direct SMS content"
          },
          "photo_request_report_disclaimer": {
            "type": "string",
            "description": "Photo request report disclaimer"
          },
          "amc_id": {
            "type": "string",
            "description": "AMC ID"
          },
          "amc_name": {
            "type": "string",
            "description": "AMC name"
          },
          "photo_datetime_label": {
            "type": "string",
            "description": "Photo datetime label"
          },
          "show_report_signature": {
            "type": "boolean",
            "description": "Show report signature"
          },
          "payments_report_token": {
            "type": "string",
            "description": "Payments report token"
          },
          "address": {
            "type": "string",
            "description": "Address"
          },
          "small_address": {
            "type": "string",
            "description": "Address without city, state, zip and country"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "state": {
            "type": "string",
            "description": "State"
          },
          "zip": {
            "type": "string",
            "description": "Zip"
          },
          "orders_never_expire": {
            "type": "boolean",
            "description": "Orders never expire"
          },
          "notify_webhook": {
            "type": "array",
            "description": "Webhook notifications",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "notify_email": {
            "type": "array",
            "description": "Email notifications",
            "items": {
