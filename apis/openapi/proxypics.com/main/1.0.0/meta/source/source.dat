  "paths": {
    "/photo-requests": {
      "get": {
        "tags": [
          "Photo Requests"
        ],
        "summary": "List Photo Requests",
        "description": "List your photo requests.\n\nPagination:\n- `page` (default 1)\n- `per_page` (default 10)\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PhotoRequest"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PhotoRequestsListMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      },
      "post": {
        "tags": [
          "Photo Requests",
          "UPD/PDR/PDC"
        ],
        "summary": "Create Photo Request (including UPD)",
        "description": "When creating the photo request you can specifically define the Photo Request shape (Tasks, Unlimited Tasks, Question Groups)\nor you can previously create a *Photo Request Template* in the ProxyPics platform, then simply pass the provided token.\nThe latter is highly advised.\n\nFields specific to Crowdsource platform:\n- `expires_at` - The time the photo request will be available for photo takers to pick it up\n- `price_boost` - An amount you may want to add to the request price to make it more appeal for photo takers\n\nFields specific to Direct platform:\n- `property_owner_phone` (required) - The phone number to directly assign the request\n- `direct_due_date` (required) - The time the assignment will be available for completion\n\nUPD/PDR/PDC:\n- To create a UPD order, just provide the address and UPD fields inside `uniform_property_dataset_report_attributes`.\n- The UPD template is automatically chosen by the system, you don't need to submit the `template_token` field for UPDs.\n- If this field is set, we'll ignore the template token and use our own UPD template to create the PhotoRequest.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhotoRequestCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/photo-requests/{id}": {
      "get": {
        "tags": [
          "Photo Requests"
        ],
        "summary": "Show Photo Request",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParamInteger"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      },
      "delete": {
        "tags": [
          "Photo Requests"
        ],
        "summary": "Cancel Photo Request",
        "description": "If you need to cancel a PhotoRequest, you can send a DELETE request for the PhotoRequest ID.\nIf it's 'unassigned' we will cancel the Photo Request and a successful reponse will be returned.\nIf your Photo Request status isn't 'unassigned', our support team will be notified about your cancelation request\nand we'll work to cancel the Photo Request for you.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParamInteger"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/photo-requests/{id}/duplicate-order": {
      "post": {
        "tags": [
          "Photo Requests"
        ],
        "summary": "Duplicate Photo Request",
        "description": "If you need to duplicate a PhotoRequest, creating a new one with the same template, tasks, unlimited sections, questions, etc.,\nyou can send a POST request to this endpoint providing a PhotoRequestId.\n\nThe created PhotoRequest will be related to the provided one by a `parent_id` field, adding up to DrawInspections for the address, for example.\n\nUseful for Draw Inspections, it creates a new Photo Request exactly the same as the provided ID, creating a Draw 2 from Draw 1 for example.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParamInteger"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Original Photo Request ID on the URL"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          }
        }
      }
    },
    "/photo-requests/{id}/extend": {
      "put": {
        "tags": [
          "Photo Requests"
        ],
        "summary": "Extend Photo Request",
        "description": "When a request is in `expired` state and you want to make it available again you can call the Extend.\n\nIt'll behave slightly different whether the Photo Request is for Crowdsource or it is for Direct.\n\nWhen it is for Crowdsource, the `expires_at` date will be updated to the parameter you passed and the request will be `unassigned`,\nmeaning that it is avalable for photo takers to pick it up again.\n\nWhen it is for Direct, the assignment `expires_at` will be updated to the parameter you passed, the request will `assigned`\nand the assignment will be back to `pending` state, meaning that the photo taker firstly assigned to it will still be able to submit it.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParamInteger"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhotoRequestExtendRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
