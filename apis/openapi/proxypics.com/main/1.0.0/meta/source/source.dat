          },
          "type": {
            "type": "string",
            "enum": [
              "AutomatedValuationRequest",
              "EvaluationRequest",
              "AppraisalFormRequest"
            ],
            "description": "`AutomatedValuationRequest` - AVM\n`EvaluationRequest` - Simple BPO\n`AppraisalFormRequest` - BPO with adjustments\n"
          },
          "report_provider": {
            "type": "string",
            "enum": [
              "ca",
              "quantarium"
            ],
            "description": "`ca` - Collateral Analytics\n`quantarium` - Quantarium\n"
          },
          "occupancy": {
            "type": "string"
          },
          "borrower_name": {
            "type": "string"
          },
          "borrower_email": {
            "type": "string"
          },
          "borrower_phone": {
            "type": "string"
          },
          "borrower_optin": {
            "type": "boolean"
          },
          "second_borrower_name": {
            "type": "string"
          },
          "photo_request_status": {
            "type": "string",
            "enum": [
              "unassigned",
              "assigned",
              "completed",
              "rejected",
              "expired",
              "fulfilled"
            ]
          },
          "download_report_url": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Status",
            "enum": [
              "pending_data",
              "error",
              "unassigned",
              "assigned",
              "in_review",
              "quality_control",
              "completed",
              "client_request",
              "fulfilled",
              "canceled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "The date/time (ISO8601 format)"
          }
        }
      },
      "PhotoRequest": {
        "type": "object",
        "description": "PhotoRequest",
        "properties": {
          "id": {
            "type": "number",
            "description": "Unique identifier"
          },
          "address": {
            "type": "string",
            "description": "Full address (street, city, state, zip and country)"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
