{
  "openapi": "3.0.3",
  "info": {
    "title": "Geoapify API",
    "description": "Geoapify provides geocoding, reverse geocoding, places, and routing APIs for location-based applications.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://apidocs.geoapify.com/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.geoapify.com",
      "description": "Geoapify API"
    }
  ],
  "security": [
    {
      "apiKeyQuery": []
    }
  ],
  "paths": {
    "/v1/geocode/search": {
      "get": {
        "operationId": "forwardGeocode",
        "summary": "Convert an address or place name to geographic coordinates (forward geocoding)",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "description": "Free-form address or place name to geocode",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language for results (e.g., en, de, fr)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results to return",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filter by place type (e.g., city, street, amenity)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Filter by geographic area (e.g., countrycode:us,gb or rect:lon1,lat1,lon2,lat2 or circle:lon,lat,radiusMeters)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bias",
            "in": "query",
            "required": false,
            "description": "Bias results toward a location (e.g., proximity:lon,lat or countrycode:us)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response format (json or geojson)",
            "schema": {
              "type": "string",
              "enum": ["json", "geojson"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Geocoding results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid API key"
          },
          "400": {
            "description": "Bad request - invalid parameters"
          }
        }
      }
    },
    "/v1/geocode/reverse": {
      "get": {
        "operationId": "reverseGeocode",
        "summary": "Convert geographic coordinates to an address (reverse geocoding)",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "description": "Latitude",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "description": "Longitude",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language for results",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filter by place type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json", "geojson"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reverse geocoding result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/geocode/autocomplete": {
      "get": {
        "operationId": "autocompleteAddress",
        "summary": "Get address suggestions from partial input (autocomplete)",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "description": "Partial address text for autocomplete",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language for results",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of suggestions",
            "schema": {
              "type": "integer",
              "default": 5
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filter by place type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Filter by geographic area",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bias",
            "in": "query",
            "required": false,
            "description": "Bias results toward a location",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json", "geojson"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Autocomplete suggestions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2/places": {
      "get": {
        "operationId": "getPlaces",
        "summary": "Search for places (POIs) by category and location",
        "parameters": [
          {
            "name": "categories",
            "in": "query",
            "required": true,
            "description": "Comma-separated place categories (e.g., accommodation.hotel, catering.restaurant)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": true,
            "description": "Geographic filter (e.g., circle:lon,lat,radiusMeters or rect:lon1,lat1,lon2,lat2)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results (max 500)",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 500
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Offset for pagination",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "conditions",
            "in": "query",
            "required": false,
            "description": "Additional filter conditions",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bias",
            "in": "query",
            "required": false,
            "description": "Bias results toward a location",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language for results",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of places",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["FeatureCollection"]
                    },
                    "features": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlaceFeature"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/routing": {
      "get": {
        "operationId": "getRoute",
        "summary": "Calculate a route between waypoints",
        "parameters": [
          {
            "name": "waypoints",
            "in": "query",
            "required": true,
            "description": "Pipe-separated waypoints as lat,lon pairs (e.g., 50.96,11.03|50.429,11.144)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "description": "Travel mode",
            "schema": {
              "type": "string",
              "enum": ["drive", "truck", "bicycle", "walk", "transit", "approximated_transit"]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language for turn-by-turn instructions",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "units",
            "in": "query",
            "required": false,
            "description": "Unit system for distances",
            "schema": {
              "type": "string",
              "enum": ["metric", "imperial"]
            }
          },
          {
            "name": "avoid",
            "in": "query",
            "required": false,
            "description": "Comma-separated features to avoid (e.g., tolls,highways,ferries)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Route in GeoJSON format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["FeatureCollection"]
                    },
                    "features": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "geometry": {
                            "type": "object"
                          },
                          "properties": {
                            "type": "object",
                            "properties": {
                              "mode": {
                                "type": "string"
                              },
                              "distance": {
                                "type": "number",
                                "description": "Distance in meters"
                              },
                              "time": {
                                "type": "number",
                                "description": "Travel time in seconds"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "API key passed as query parameter"
      }
    },
    "schemas": {
      "GeocodingResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "geometry": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "coordinates": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "properties": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "country": {
                      "type": "string"
                    },
                    "country_code": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    },
                    "city": {
                      "type": "string"
                    },
                    "postcode": {
                      "type": "string"
                    },
                    "street": {
                      "type": "string"
                    },
                    "housenumber": {
                      "type": "string"
                    },
                    "formatted": {
                      "type": "string"
                    },
                    "lat": {
                      "type": "number"
                    },
                    "lon": {
                      "type": "number"
                    },
                    "timezone": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "offset_STD": {
                          "type": "string"
                        }
                      }
                    },
                    "result_type": {
                      "type": "string"
                    },
                    "rank": {
                      "type": "object",
                      "properties": {
                        "confidence": {
                          "type": "number"
                        },
                        "match_type": {
                          "type": "string"
                        }
                      }
                    },
                    "place_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PlaceFeature": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "properties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "formatted": {
                "type": "string"
              },
              "place_id": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
