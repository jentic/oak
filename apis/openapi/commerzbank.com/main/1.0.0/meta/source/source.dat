{
  "openapi": "3.0.3",
  "info": {
    "title": "Commerzbank PSD2 Open Banking API",
    "description": "Commerzbank PSD2-compliant Open Banking APIs implementing the Berlin Group NextGenPSD2 XS2A Framework v1.3.11. Provides Account Information Service (AIS), Payment Initiation Service (PIS), Funds Confirmation Service (FCS), and OAuth2 authorization endpoints for third-party providers (TPPs).",
    "version": "1.0.0",
    "x-jentic-source-url": "https://psd2.developer.commerzbank.com/apis",
    "contact": {
      "name": "Commerzbank Developer Portal",
      "url": "https://psd2.developer.commerzbank.com"
    }
  },
  "servers": [
    {
      "url": "https://psd2.api.commerzbank.com",
      "description": "Commerzbank PSD2 Production API"
    }
  ],
  "security": [
    {
      "OAuth2": []
    }
  ],
  "tags": [
    {
      "name": "Account Information Service (AIS)",
      "description": "BerlinGroup XS2A Account Information Service endpoints"
    },
    {
      "name": "Consent Management",
      "description": "Consent lifecycle management endpoints"
    },
    {
      "name": "Payment Initiation Service (PIS)",
      "description": "BerlinGroup XS2A Payment Initiation Service endpoints"
    },
    {
      "name": "Funds Confirmation Service (FCS)",
      "description": "BerlinGroup XS2A Funds Confirmation Service endpoints"
    },
    {
      "name": "OAuth2 Authorization",
      "description": "OAuth2 authorization and token endpoints"
    }
  ],
  "paths": {
    "/berlingroup/v1/accounts": {
      "get": {
        "operationId": "getAccountList",
        "summary": "Read Account List",
        "description": "Retrieve the list of accessible accounts for the given consent. Returns basic account information including IBAN, currency, and account type.",
        "tags": ["Account Information Service (AIS)"],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier for idempotency and tracing",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Consent-ID",
            "in": "header",
            "required": true,
            "description": "Identifier of the consent resource granting access to the account information",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token (required for redirect workflow)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "withBalance",
            "in": "query",
            "required": false,
            "description": "If true, includes the booking balance in the account details",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of account list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters or missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - unknown consent, incorrect or missing certificate, or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests - max access frequency exceeded by TPP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/accounts/{account-id}": {
      "get": {
        "operationId": "getAccountDetails",
        "summary": "Read Account Details",
        "description": "Retrieve detailed information for a specific account identified by account-id.",
        "tags": ["Account Information Service (AIS)"],
        "parameters": [
          {
            "name": "account-id",
            "in": "path",
            "required": true,
            "description": "Unique resource identifier of the account",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Consent-ID",
            "in": "header",
            "required": true,
            "description": "Consent resource identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of account details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Account not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/accounts/{account-id}/balances": {
      "get": {
        "operationId": "getAccountBalances",
        "summary": "Read Balance",
        "description": "Retrieve the balance information for a specific account. Returns all available balance types including closingBooked, expected, authorised, and interimAvailable.",
        "tags": ["Account Information Service (AIS)"],
        "parameters": [
          {
            "name": "account-id",
            "in": "path",
            "required": true,
            "description": "Unique resource identifier of the account",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Consent-ID",
            "in": "header",
            "required": true,
            "description": "Consent resource identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of account balances",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalancesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - account unknown, invalid consent, or missing certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - consent unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/accounts/{account-id}/transactions": {
      "get": {
        "operationId": "getAccountTransactions",
        "summary": "Read Transaction List",
        "description": "Retrieve the transaction list for a given account. Supports filtering by date range, booking status, and pagination.",
        "tags": ["Account Information Service (AIS)"],
        "parameters": [
          {
            "name": "account-id",
            "in": "path",
            "required": true,
            "description": "Unique resource identifier of the account",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Consent-ID",
            "in": "header",
            "required": true,
            "description": "Consent resource identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "required": true,
            "description": "Starting date of the transaction list in ISO 8601 format (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "dateTo",
            "in": "query",
            "required": false,
            "description": "End date of the transaction list in ISO 8601 format (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "bookingStatus",
            "in": "query",
            "required": true,
            "description": "Permitted values: 'booked', 'pending', 'both'",
            "schema": {
              "type": "string",
              "enum": ["booked", "pending", "both"]
            }
          },
          {
            "name": "withBalance",
            "in": "query",
            "required": false,
            "description": "Include booking balance in the response",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page number to retrieve",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - consent unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/consents": {
      "post": {
        "operationId": "createConsent",
        "summary": "Create Consent",
        "description": "Create a new consent resource for account information access. The consent defines which accounts and services the TPP is allowed to access.",
        "tags": ["Consent Management"],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "PSU-IP-Address",
            "in": "header",
            "required": true,
            "description": "IP address of the PSU's device as seen by the TPP",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "TPP-Redirect-URI",
            "in": "header",
            "required": true,
            "description": "URI of the TPP where the user shall be redirected after consent authorization",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "TPP-Nok-Redirect-URI",
            "in": "header",
            "required": false,
            "description": "URI where the user shall be redirected in case of a negative SCA redirect result",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "TPP-Explicit-Authorisation-Preferred",
            "in": "header",
            "required": false,
            "description": "If true, the TPP prefers the explicit start of the authorisation process",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "PSU-ID",
            "in": "header",
            "required": false,
            "description": "Client ID of the PSU in the ASPSP interface",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "PSU-ID-TYPE",
            "in": "header",
            "required": false,
            "description": "Type of the PSU-ID when the PSU has multiple identifiers",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "PSU-Accept-Language",
            "in": "header",
            "required": false,
            "description": "Language and country preference (LanguageTag-CountryTag format)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConsentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consent created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateConsentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid consent parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - incorrect or missing certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/consents/{consent-id}": {
      "get": {
        "operationId": "getConsentDetails",
        "summary": "Get Consent Details",
        "description": "Retrieve the details of a consent resource including its status, access scope, and validity.",
        "tags": ["Consent Management"],
        "parameters": [
          {
            "name": "consent-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the consent resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consent details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteConsent",
        "summary": "Delete Consent",
        "description": "Revoke a given consent resource, terminating the TPP's access to the PSU's account data.",
        "tags": ["Consent Management"],
        "parameters": [
          {
            "name": "consent-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the consent resource to delete",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Consent successfully deleted"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/consents/{consent-id}/status": {
      "get": {
        "operationId": "getConsentStatus",
        "summary": "Get Consent Status",
        "description": "Retrieve the current status of a consent resource.",
        "tags": ["Consent Management"],
        "parameters": [
          {
            "name": "consent-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the consent resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consent status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/consents/{consent-id}/authorisations": {
      "post": {
        "operationId": "createConsentAuthorisation",
        "summary": "Start Consent Authorisation Process",
        "description": "Start the authorisation process for a consent resource. Creates an authorisation sub-resource for Strong Customer Authentication (SCA).",
        "tags": ["Consent Management"],
        "parameters": [
          {
            "name": "consent-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the consent resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "PSU-IP-Address",
            "in": "header",
            "required": true,
            "description": "IP address of the PSU's device",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Authorisation sub-resource created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorisationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listConsentAuthorisations",
        "summary": "List Consent Authorisation Sub-Resources",
        "description": "Retrieve a list of all authorisation sub-resource IDs associated with a consent.",
        "tags": ["Consent Management"],
        "parameters": [
          {
            "name": "consent-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the consent resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of authorisation IDs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorisationListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/consents/{consent-id}/authorisations/{authorisation-id}": {
      "get": {
        "operationId": "getConsentAuthorisationStatus",
        "summary": "Get Consent Authorisation SCA Status",
        "description": "Retrieve the SCA status of an authorisation sub-resource for a consent.",
        "tags": ["Consent Management"],
        "parameters": [
          {
            "name": "consent-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the consent resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorisation-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the authorisation sub-resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SCA status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScaStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/payments/{payment-product}": {
      "post": {
        "operationId": "initiateSinglePayment",
        "summary": "Initiate Single Payment",
        "description": "Initiate a single payment for the specified payment product (e.g., SEPA credit transfers).",
        "tags": ["Payment Initiation Service (PIS)"],
        "parameters": [
          {
            "name": "payment-product",
            "in": "path",
            "required": true,
            "description": "Payment product type (e.g., sepa-credit-transfers, instant-sepa-credit-transfers, cross-border-credit-transfers)",
            "schema": {
              "type": "string",
              "enum": ["sepa-credit-transfers", "instant-sepa-credit-transfers", "cross-border-credit-transfers"]
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "PSU-IP-Address",
            "in": "header",
            "required": true,
            "description": "IP address of the PSU's device",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "TPP-Redirect-URI",
            "in": "header",
            "required": true,
            "description": "URI where the user shall be redirected after payment authorization",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentInitiationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment initiation request created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentInitiationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid payment data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/payments/{payment-product}/{paymentId}": {
      "get": {
        "operationId": "getSinglePaymentDetails",
        "summary": "Get Single Payment Details",
        "description": "Retrieve the details of a previously initiated single payment.",
        "tags": ["Payment Initiation Service (PIS)"],
        "parameters": [
          {
            "name": "payment-product",
            "in": "path",
            "required": true,
            "description": "Payment product type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "Identifier of the payment resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelPayment",
        "summary": "Cancel Payment",
        "description": "Request cancellation of a previously initiated payment.",
        "tags": ["Payment Initiation Service (PIS)"],
        "parameters": [
          {
            "name": "payment-product",
            "in": "path",
            "required": true,
            "description": "Payment product type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "Identifier of the payment resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Payment cancellation accepted"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/payments/{payment-product}/{paymentId}/status": {
      "get": {
        "operationId": "getPaymentStatus",
        "summary": "Get Payment Initiation Status",
        "description": "Retrieve the current status of a payment initiation.",
        "tags": ["Payment Initiation Service (PIS)"],
        "parameters": [
          {
            "name": "payment-product",
            "in": "path",
            "required": true,
            "description": "Payment product type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "Identifier of the payment resource",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/funds-confirmations": {
      "post": {
        "operationId": "confirmFundsAvailability",
        "summary": "Confirmation of Funds Request",
        "description": "Check if funds are available on a specific account for a given amount. Used by Payment Instrument Issuing Service Providers (PIISP).",
        "tags": ["Funds Confirmation Service (FCS)"],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "description": "Unique client-generated request identifier",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "OAuth2 Bearer access token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FundsConfirmationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Funds confirmation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FundsConfirmationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/authorize/{authorization-id}": {
      "get": {
        "operationId": "authorizeOAuth2",
        "summary": "OAuth2 Authorize Request",
        "description": "Initiate the OAuth2 authorization process. Redirects the PSU to the ASPSP login page for Strong Customer Authentication.",
        "tags": ["OAuth2 Authorization"],
        "parameters": [
          {
            "name": "authorization-id",
            "in": "path",
            "required": true,
            "description": "Authorization resource identifier obtained from consent or payment initiation",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to ASPSP authorization page"
          },
          "400": {
            "description": "Bad request - invalid authorization ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/authorization/cancel/authorize/{authorization-id}": {
      "get": {
        "operationId": "cancelOAuth2Authorize",
        "summary": "OAuth2 Cancellation Authorize Request",
        "description": "Cancel an ongoing OAuth2 authorization process.",
        "tags": ["OAuth2 Authorization"],
        "parameters": [
          {
            "name": "authorization-id",
            "in": "path",
            "required": true,
            "description": "Authorization resource identifier to cancel",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect after cancellation"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/berlingroup/v1/token": {
      "post": {
        "operationId": "exchangeToken",
        "summary": "Exchange Authorization Code for Token",
        "description": "Exchange an authorization code for an OAuth2 access token using the token endpoint.",
        "tags": ["OAuth2 Authorization"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid grant or parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth2 authorization for PSD2 API access",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://psd2.api.commerzbank.com/berlingroup/authorize",
            "tokenUrl": "https://psd2.api.commerzbank.com/berlingroup/v1/token",
            "scopes": {
              "ais": "Account Information Service access",
              "pis": "Payment Initiation Service access",
              "fcs": "Funds Confirmation Service access"
            }
          }
        }
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer token obtained via OAuth2 flow"
      }
    },
    "schemas": {
      "AccountsResponse": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountDetails"
            }
          }
        },
        "required": ["accounts"]
      },
      "AccountDetails": {
        "type": "object",
        "required": ["id", "currency"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique account resource identifier"
          },
          "iban": {
            "type": "string",
            "description": "International Bank Account Number"
          },
          "bban": {
            "type": "string",
            "description": "Basic Bank Account Number"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string",
            "description": "Account name given by the bank",
            "maxLength": 70
          },
          "displayName": {
            "type": "string",
            "description": "Account name given by the PSU",
            "maxLength": 70
          },
          "accountType": {
            "type": "string",
            "description": "Product name of the bank for this account"
          },
          "bic": {
            "type": "string",
            "description": "Bank Identifier Code"
          },
          "balances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Balance"
            }
          },
          "_links": {
            "$ref": "#/components/schemas/AccountLinks"
          }
        }
      },
      "BalancesResponse": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "balances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Balance"
            }
          }
        },
        "required": ["balances"]
      },
      "Balance": {
        "type": "object",
        "required": ["balanceAmount", "balanceType"],
        "properties": {
          "balanceAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "balanceType": {
            "type": "string",
            "description": "Type of the balance",
            "enum": ["closingBooked", "expected", "authorised", "openingBooked", "interimAvailable", "forwardAvailable", "nonInvoiced", "available"]
          },
          "lastChangeDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the last balance change"
          },
          "lastCommittedTransaction": {
            "type": "string",
            "description": "Entry reference of the last committed transaction"
          },
          "referenceDate": {
            "type": "string",
            "format": "date",
            "description": "Reference date of the balance"
          }
        }
      },
      "TransactionsResponse": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "transactions": {
            "type": "object",
            "properties": {
              "booked": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Transaction"
                }
              },
              "pending": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "_links": {
            "$ref": "#/components/schemas/PaginationLinks"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "description": "Unique transaction identifier"
          },
          "entryReference": {
            "type": "string",
            "description": "Entry reference for the statement"
          },
          "bookingDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the transaction was booked"
          },
          "valueDate": {
            "type": "string",
            "format": "date",
            "description": "Value date of the transaction"
          },
          "transactionAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "creditorName": {
            "type": "string",
            "description": "Name of the creditor"
          },
          "creditorAccount": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "debtorName": {
            "type": "string",
            "description": "Name of the debtor"
          },
          "debtorAccount": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "remittanceInformationUnstructured": {
            "type": "string",
            "description": "Unstructured remittance information"
          },
          "bankTransactionCode": {
            "type": "string",
            "description": "Bank transaction code as used by the ASPSP"
          }
        }
      },
      "AccountReference": {
        "type": "object",
        "properties": {
          "iban": {
            "type": "string",
            "description": "International Bank Account Number"
          },
          "bban": {
            "type": "string",
            "description": "Basic Bank Account Number"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code"
          },
          "maskedPan": {
            "type": "string",
            "description": "Masked Primary Account Number"
          },
          "msisdn": {
            "type": "string",
            "description": "Mobile phone number in international format"
          }
        }
      },
      "Amount": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Amount value",
            "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,3})?$"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "CreateConsentRequest": {
        "type": "object",
        "required": ["access", "recurringIndicator", "validUntil", "frequencyPerDay", "combinedServiceIndicator"],
        "properties": {
          "access": {
            "type": "object",
            "description": "Requested access services",
            "properties": {
              "accounts": {
                "type": "array",
                "description": "List of accounts for which access is requested",
                "items": {
                  "$ref": "#/components/schemas/AccountReference"
                }
              },
              "balances": {
                "type": "array",
                "description": "List of accounts for balance access",
                "items": {
                  "$ref": "#/components/schemas/AccountReference"
                }
              },
              "transactions": {
                "type": "array",
                "description": "List of accounts for transaction access",
                "items": {
                  "$ref": "#/components/schemas/AccountReference"
                }
              },
              "availableAccounts": {
                "type": "string",
                "description": "Access to all available accounts",
                "enum": ["allAccounts", "allAccountsWithOwnerName"]
              }
            }
          },
          "recurringIndicator": {
            "type": "boolean",
            "description": "true if consent is for recurring access, false for one-time access"
          },
          "validUntil": {
            "type": "string",
            "format": "date",
            "description": "Expiration date of the consent in ISO 8601 format"
          },
          "frequencyPerDay": {
            "type": "integer",
            "description": "Requested maximum frequency of access per day",
            "minimum": 1,
            "maximum": 4
          },
          "combinedServiceIndicator": {
            "type": "boolean",
            "description": "If true, a payment initiation service will be addressed in the same session"
          }
        }
      },
      "CreateConsentResponse": {
        "type": "object",
        "required": ["consentId", "consentStatus"],
        "properties": {
          "consentId": {
            "type": "string",
            "description": "Unique identifier of the created consent resource"
          },
          "consentStatus": {
            "type": "string",
            "description": "Current status of the consent",
            "enum": ["received", "rejected", "valid", "revokedByPsu", "expired", "terminatedByTpp"]
          },
          "scaMethods": {
            "type": "array",
            "description": "Available SCA methods for the PSU",
            "items": {
              "$ref": "#/components/schemas/ScaMethod"
            }
          },
          "_links": {
            "type": "object",
            "description": "HATEOAS links for next actions",
            "properties": {
              "scaRedirect": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "scaStatus": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "self": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "status": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      },
      "ConsentDetails": {
        "type": "object",
        "properties": {
          "access": {
            "type": "object",
            "properties": {
              "accounts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AccountReference"
                }
              },
              "balances": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AccountReference"
                }
              },
              "transactions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AccountReference"
                }
              }
            }
          },
          "recurringIndicator": {
            "type": "boolean"
          },
          "validUntil": {
            "type": "string",
            "format": "date"
          },
          "frequencyPerDay": {
            "type": "integer"
          },
          "consentStatus": {
            "type": "string",
            "enum": ["received", "rejected", "valid", "revokedByPsu", "expired", "terminatedByTpp"]
          },
          "lastActionDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ConsentStatusResponse": {
        "type": "object",
        "required": ["consentStatus"],
        "properties": {
          "consentStatus": {
            "type": "string",
            "description": "Current status of the consent",
            "enum": ["received", "rejected", "valid", "revokedByPsu", "expired", "terminatedByTpp"]
          }
        }
      },
      "ScaMethod": {
        "type": "object",
        "properties": {
          "authenticationMethodId": {
            "type": "string",
            "description": "Unique ID of the SCA method"
          },
          "authenticationType": {
            "type": "string",
            "description": "Type of authentication method"
          },
          "authenticationVersion": {
            "type": "string",
            "description": "Version of the authentication method"
          },
          "name": {
            "type": "string",
            "description": "Display name of the SCA method"
          }
        }
      },
      "AuthorisationResponse": {
        "type": "object",
        "properties": {
          "authorisationId": {
            "type": "string",
            "description": "Identifier of the authorisation sub-resource"
          },
          "scaStatus": {
            "type": "string",
            "description": "SCA status of the authorisation",
            "enum": ["received", "psuIdentified", "psuAuthenticated", "scaMethodSelected", "started", "finalised", "failed", "exempted"]
          },
          "scaMethods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScaMethod"
            }
          },
          "_links": {
            "type": "object",
            "properties": {
              "scaRedirect": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      },
      "AuthorisationListResponse": {
        "type": "object",
        "properties": {
          "authorisationIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of authorisation sub-resource identifiers"
          }
        }
      },
      "ScaStatusResponse": {
        "type": "object",
        "required": ["scaStatus"],
        "properties": {
          "scaStatus": {
            "type": "string",
            "description": "Current SCA status",
            "enum": ["received", "psuIdentified", "psuAuthenticated", "scaMethodSelected", "started", "finalised", "failed", "exempted"]
          }
        }
      },
      "PaymentInitiationRequest": {
        "type": "object",
        "required": ["debtorAccount", "instructedAmount", "creditorAccount", "creditorName"],
        "properties": {
          "debtorAccount": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "instructedAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "creditorAccount": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "creditorName": {
            "type": "string",
            "description": "Name of the creditor",
            "maxLength": 70
          },
          "creditorAddress": {
            "type": "object",
            "properties": {
              "streetName": {
                "type": "string"
              },
              "buildingNumber": {
                "type": "string"
              },
              "postCode": {
                "type": "string"
              },
              "townName": {
                "type": "string"
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            }
          },
          "remittanceInformationUnstructured": {
            "type": "string",
            "description": "Unstructured remittance information",
            "maxLength": 140
          },
          "requestedExecutionDate": {
            "type": "string",
            "format": "date",
            "description": "Requested execution date for the payment"
          }
        }
      },
      "PaymentInitiationResponse": {
        "type": "object",
        "required": ["transactionStatus", "paymentId"],
        "properties": {
          "transactionStatus": {
            "type": "string",
            "description": "Status of the payment initiation",
            "enum": ["RCVD", "PDNG", "ACCP", "ACTC", "ACWC", "ACSC", "ACWP", "ACFC", "PATC", "RJCT", "CANC"]
          },
          "paymentId": {
            "type": "string",
            "description": "Unique identifier of the payment resource"
          },
          "scaMethods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScaMethod"
            }
          },
          "_links": {
            "type": "object",
            "properties": {
              "scaRedirect": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "self": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "status": {
                "type": "object",
                "properties": {
                  "href": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      },
      "PaymentDetails": {
        "type": "object",
        "properties": {
          "debtorAccount": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "instructedAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "creditorAccount": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "creditorName": {
            "type": "string"
          },
          "remittanceInformationUnstructured": {
            "type": "string"
          },
          "transactionStatus": {
            "type": "string",
            "enum": ["RCVD", "PDNG", "ACCP", "ACTC", "ACWC", "ACSC", "ACWP", "ACFC", "PATC", "RJCT", "CANC"]
          }
        }
      },
      "PaymentStatusResponse": {
        "type": "object",
        "required": ["transactionStatus"],
        "properties": {
          "transactionStatus": {
            "type": "string",
            "description": "Current status of the payment",
            "enum": ["RCVD", "PDNG", "ACCP", "ACTC", "ACWC", "ACSC", "ACWP", "ACFC", "PATC", "RJCT", "CANC"]
          }
        }
      },
      "FundsConfirmationRequest": {
        "type": "object",
        "required": ["account", "instructedAmount"],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountReference"
          },
          "instructedAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "cardNumber": {
            "type": "string",
            "description": "Card number of the card issued by the PIISP"
          },
          "payee": {
            "type": "string",
            "description": "Name of the payee"
          }
        }
      },
      "FundsConfirmationResponse": {
        "type": "object",
        "required": ["fundsAvailable"],
        "properties": {
          "fundsAvailable": {
            "type": "boolean",
            "description": "true if sufficient funds are available for the requested amount"
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "required": ["grant_type", "code", "redirect_uri"],
        "properties": {
          "grant_type": {
            "type": "string",
            "description": "OAuth2 grant type",
            "enum": ["authorization_code"]
          },
          "code": {
            "type": "string",
            "description": "Authorization code received from the authorize endpoint"
          },
          "redirect_uri": {
            "type": "string",
            "description": "Redirect URI used in the authorization request",
            "format": "uri"
          },
          "client_id": {
            "type": "string",
            "description": "Client ID of the TPP application"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "OAuth2 access token"
          },
          "token_type": {
            "type": "string",
            "description": "Token type (Bearer)",
            "enum": ["Bearer"]
          },
          "expires_in": {
            "type": "integer",
            "description": "Token lifetime in seconds"
          },
          "refresh_token": {
            "type": "string",
            "description": "Refresh token for obtaining new access tokens"
          },
          "scope": {
            "type": "string",
            "description": "Granted scopes"
          }
        }
      },
      "AccountLinks": {
        "type": "object",
        "properties": {
          "balances": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "transactions": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "download": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "first": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "next": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "previous": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "last": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "tppMessages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "description": "Error category",
                  "enum": ["ERROR", "WARNING"]
                },
                "code": {
                  "type": "string",
                  "description": "Error code defined by Berlin Group"
                },
                "text": {
                  "type": "string",
                  "description": "Human-readable error description"
                },
                "path": {
                  "type": "string",
                  "description": "Path to the field that caused the error"
                }
              }
            }
          }
        }
      }
    }
  }
}