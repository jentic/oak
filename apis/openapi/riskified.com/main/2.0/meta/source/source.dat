{
  "openapi": "3.0.3",
  "info": {
    "title": "Riskified E-Commerce API",
    "description": "Riskified's API enables merchants to submit orders for fraud review, receive decisions, and manage the order lifecycle including cancellations, refunds, fulfillments, and chargebacks. Also includes Account Action endpoints for login, account creation, and verification.",
    "version": "2.0",
    "contact": {
      "url": "https://www.riskified.com"
    },
    "x-jentic-source-url": "https://apiref.riskified.com/curl/"
  },
  "servers": [
    {
      "url": "https://wh.riskified.com",
      "description": "Production - Order Actions"
    },
    {
      "url": "https://sandbox.riskified.com",
      "description": "Sandbox - Order Actions"
    },
    {
      "url": "https://api.riskified.com",
      "description": "Production - Account Actions"
    },
    {
      "url": "https://api-sandbox.riskified.com",
      "description": "Sandbox - Account Actions"
    }
  ],
  "security": [
    {
      "hmacAuth": []
    }
  ],
  "paths": {
    "/api/checkout_create": {
      "post": {
        "summary": "Create checkout",
        "description": "Submit a new checkout for review before order creation",
        "operationId": "checkoutCreate",
        "tags": [
          "Order Actions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/shopDomain"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/checkout_denied": {
