                    "value": "-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAvpPXNkFbmnNc4wSB21Tb\np9hdCf1rq+urFaXr2BvWQ3kvJG3FBYs43kUHxif8+rqJ+o3ATMWcnmZUPpqxbJFZ\nPknpSO/dJPZnzBCFz6dG5PA5GlLEByw0/39GtDAZMtt/UYNNNc03LGKWrxsvXnjQ\nGnNrtOYgzTVk66GAFbfEg6OuobQVriPdGqPjCM41M9aE9PcwkBYTdcSBn3fBv9o+\n55yBE3lq6o4wcz2Q43eUTUqTRWRZm9Nu2fDOuAzTcA/Ehk+Eqg7ftaFAAZClVKKw\nUsWaR55mGvbdTabMBS2EbuOz4kflJI14HOVBL4bnkURSyxfp9tOehpcsDnKqaYPp\nLaZfCeJGf8pWFwVFXTttbRaCRk65zcEATrgDPCki/OjuVCdWAfqISxcufhKaQvsM\nOstKjgpFcMSG9+r965t7xwl7dngT4n2vXYBO2LB9J21h86yn7qtxnKlyqpgwP144\nStq7z7Au6rhDXyCglRRiX1K9qac/OVN7SjCud50EmfjnSBkpoxXRcepchjVZc3Oa\nf1lmbBFh6y1fnA7bVug4V+PBOh1SqgRfAcDLICiRd2D8EXd2KYM9Unr7nTRn8UtG\n0b0v1mB0AtfTyZCZSTm5J8vC8Vfe+BZJDILjmHkQ+ORfoz0FYG4/HpQjgaHuXqWu\n5PW15y7ej7d3eCjSMRKyUskCAwEAAQ==\n-----END PUBLIC KEY-----\n-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA1dG2zyU7LMZqs0H/90c0\n3mhSzzvQXoBWJhME4aa1wl0N/h1Z7dgIN3YWDKLtyo0+VO9HJ6RunnPpAu/ncfVO\neN/kjxXZXoRiwlCVztsXZuCdFfm5aYWmUEteO2iBolG9wxGi+3biejpvvgWEr+AM\nMMYAb2nKqmtgMhkmOcsBLvfb1VL1U2i7yg8VwSRnmSkmwRRimQRVpAb+7gCrAh7P\n+SyEcLuv38pJfFxLbZTv/NyvYLgmagrtmd/Mk9WeDMqiNpKXR1SBXiFNfUS/eBXy\n2dwFKNAbIIJYwGKAo3P+Et/j/E8mpSfGn8zeHHSSxwPO64Ergxb/vVweSAeobTMs\nxoHzK3198jz2n29JHaWV7fbM9vzoUuv8aEuIeMICtROR0/mKM2C/DFgfooPiykbU\nA9bxoFRFKUvUexGwuND8DVGBp2oSr6ngVZ3Isi/jFhGpoXUdeU4IxR4MpeInC7OO\nwLqIKgvXZAKtULOHmvY6WemERgsGWJYOQB7nlTr7NMva+gL7FApNtJRWnjeAMAQN\nW0NqaJd8dzp+Nkr2s/oIMwOi8rEeQgsKloU+JOM8P7yVXktgfFWEgw/FJqrHvSG2\nwXXdGC+maxPvATpmG0u+E7GO5Vw5clGBuShlTXTiJ6UjMgOADoZG6SA2lCJX7VCU\nkS59oiFSG9sWuX02mvLnCmECAwEAAQ==\n-----END PUBLIC KEY-----\n",
                    "summary": "PEM encoded public key.",
                    "description": "The PEM encoded payload can be used directly as a public key."
                  },
                  "example2": {
                    "value": "-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAvpPXNkFbmnNc4wSB21Tb\np9hdCf1rq+urFaXr2BvWQ3kvJG3FBYs43kUHxif8+rqJ+o3ATMWcnmZUPpqxbJFZ\nPknpSO/dJPZnzBCFz6dG5PA5GlLEByw0/39GtDAZMtt/UYNNNc03LGKWrxsvXnjQ\nGnNrtOYgzTVk66GAFbfEg6OuobQVriPdGqPjCM41M9aE9PcwkBYTdcSBn3fBv9o+\n55yBE3lq6o4wcz2Q43eUTUqTRWRZm9Nu2fDOuAzTcA/Ehk+Eqg7ftaFAAZClVKKw\nUsWaR55mGvbdTabMBS2EbuOz4kflJI14HOVBL4bnkURSyxfp9tOehpcsDnKqaYPp\nLaZfCeJGf8pWFwVFXTttbRaCRk65zcEATrgDPCki/OjuVCdWAfqISxcufhKaQvsM\nOstKjgpFcMSG9+r965t7xwl7dngT4n2vXYBO2LB9J21h86yn7qtxnKlyqpgwP144\nStq7z7Au6rhDXyCglRRiX1K9qac/OVN7SjCud50EmfjnSBkpoxXRcepchjVZc3Oa\nf1lmbBFh6y1fnA7bVug4V+PBOh1SqgRfAcDLICiRd2D8EXd2KYM9Unr7nTRn8UtG\n0b0v1mB0AtfTyZCZSTm5J8vC8Vfe+BZJDILjmHkQ+ORfoz0FYG4/HpQjgaHuXqWu\n5PW15y7ej7d3eCjSMRKyUskCAwEAAQ==\n-----END PUBLIC KEY-----\n-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA1dG2zyU7LMZqs0H/90c0\n3mhSzzvQXoBWJhME4aa1wl0N/h1Z7dgIN3YWDKLtyo0+VO9HJ6RunnPpAu/ncfVO\neN/kjxXZXoRiwlCVztsXZuCdFfm5aYWmUEteO2iBolG9wxGi+3biejpvvgWEr+AM\nMMYAb2nKqmtgMhkmOcsBLvfb1VL1U2i7yg8VwSRnmSkmwRRimQRVpAb+7gCrAh7P\n+SyEcLuv38pJfFxLbZTv/NyvYLgmagrtmd/Mk9WeDMqiNpKXR1SBXiFNfUS/eBXy\n2dwFKNAbIIJYwGKAo3P+Et/j/E8mpSfGn8zeHHSSxwPO64Ergxb/vVweSAeobTMs\nxoHzK3198jz2n29JHaWV7fbM9vzoUuv8aEuIeMICtROR0/mKM2C/DFgfooPiykbU\nA9bxoFRFKUvUexGwuND8DVGBp2oSr6ngVZ3Isi/jFhGpoXUdeU4IxR4MpeInC7OO\nwLqIKgvXZAKtULOHmvY6WemERgsGWJYOQB7nlTr7NMva+gL7FApNtJRWnjeAMAQN\nW0NqaJd8dzp+Nkr2s/oIMwOi8rEeQgsKloU+JOM8P7yVXktgfFWEgw/FJqrHvSG2\nwXXdGC+maxPvATpmG0u+E7GO5Vw5clGBuShlTXTiJ6UjMgOADoZG6SA2lCJX7VCU\nkS59oiFSG9sWuX02mvLnCmECAwEAAQ==\n-----END PUBLIC KEY-----\n",
                    "summary": "PEM encoded certificate.",
                    "description": "The PEM encoded payload is a certificate that contains the public key."
                  }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OIDCBasic": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "headers": {
      "SetCookieToken": {
        "schema": {
          "type": "string"
        },
        "description": "JWT for authentication of API calls."
      }
    },
    "schemas": {
      "token": "http://elasticbox.net/schemas/token",
      "access-token-request": "http://elasticbox.net/schemas/access-token-request",
      "access-token-response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT for authentication on product API endpoints.",
            "example": "eyJhbGciOiJSUzI1NiIsInR5c..."
          },
          "access_expires_in": {
            "type": "integer",
            "description": "Duration of the access token from the moment it is requested, in seconds.",
            "example": 300
          }
        }
      },
      "refresh-access-token-response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT for authentication on product API endpoints.",
            "example": "eyJhbGciOiJSUzI1NiIsInR5c..."
          },
          "access_expires_in": {
            "type": "integer",
            "description": "Duration of the access token from the moment it is requested, in seconds.",
            "example": 300
          },
          "refresh_token": {
            "type": "string",
            "description": "JWT for authentication on auth API endpoints (i.e. to obtain further access tokens).",
            "example": "eyJhbGciOiJSUzI1NiIsInR5c..."
          },
          "refresh_expires_in": {
            "type": "integer",
            "description": "Duration of the refresh token from the moment it is requested, in seconds.",
            "example": 3600
          }
        }
      },
      "token_response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Access token in JWT format.",
            "example": "eyJhbGciOiJSUzI1NiIsInR5c..."
          },
          "token_type": {
            "type": "string",
            "description": "Token type. Only `Bearer` is used.",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Expiration time in seconds.",
            "example": 3600
          }
        }
      },
      "oauth_token_response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refresh_token",
          "refresh_expires_in",
          "access_token",
          "access_expires_in",
          "token_type"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "Refresh token in JWT format.",
            "example": "eyJhbGciOiJSUzI1NiIsInR5c..."
          },
          "refresh_expires_in": {
            "type": "integer",
            "description": "Refresh token expiration time in seconds.",
            "example": 300
          },
          "access_token": {
            "type": "string",
            "description": "Access token in JWT format.",
            "example": "eyJhbGciOiJSUzI1NiIsInR5c..."
          },
          "access_expires_in": {
            "type": "integer",
            "description": "Access token expiration time in seconds.",
            "example": 300
          },
          "token_type": {
            "type": "string",
            "description": "Token type. Only `Bearer` is used.",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          }
        }
      },
      "user_details": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "userName": {
            "type": "string",
            "description": "Username.",
            "example": "user@centurylink.com"
          },
          "firstName": {
            "type": "string",
            "description": "First name.",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name.",
            "example": "Doe"
          },
          "emailAddress": {
            "type": "string",
            "description": "Email address",
            "example": "user@centurylink.com"
          },
          "multifactorRequired": {
            "type": "boolean",
            "description": "Whether multifactor is required for login."
          },
          "idpIdentifier": {
            "type": "string",
            "description": "Identity service provider user ID",
            "example": "user1"
          }
        }
      },
      "jwks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "description": "list of available keys.",
            "items": {
              "type": "object",
              "properties": {
                "e": {
                  "type": "string"
                },
                "kty": {
                  "type": "string",
                  "example": "RSA"
                },
                "n": {
                  "type": "string",
                  "description": "Key",
                  "example": "vfXAptp4XtBpI..."
                }
              }
            }
          }
        }
      },
      "openid-configuration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "description": "Identity provider.",
            "example": "https://auth.centurylink.com"
          },
          "authorization_endpoint": {
            "type": "string",
            "description": "Authorization endpoint.",
            "example": "https://auth.centurylink.com/services/security/oidc/authorize"
          },
          "token_endpoint": {
            "type": "string",
            "description": "Token endpoint.",
            "example": "https://auth.centurylink.com/services/security/oidc/token"
          },
          "userinfo_endpoint": {
            "type": "string",
            "description": "User information endpoint",
            "example": "https://auth.centurylink.com/services/security/oidc/userinfo"
          },
          "jwks_uri": {
            "type": "string",
            "description": "OIDC JSON Web Keys endpoint.",
            "example": "https://auth.centurylink.com/services/security/oidc/jwks"
          },
          "scopes_supported": {
            "type": "array",
            "description": "List of supported scopes",
            "items": {
              "type": "string"
            },
            "example": [
              "openid"
            ]
          },
          "response_types_supported": {
            "type": "array",
            "description": "List of supported response types",
            "items": {
              "type": "string"
            },
            "example": [
              "code"
            ]
          },
          "grant_types_supported": {
            "type": "array",
            "description": "List of supported grant types",
            "items": {
              "type": "string"
            },
            "example": [
              "authorization_code"
            ]
          },
          "subject_types_supported": {
            "type": "array",
            "description": "List of supported subject types",
            "items": {
              "type": "string"
            },
            "example": [
              "public",
              "pairwise"
            ]
          },
          "id_token_signing_alg_values_supported": {
            "type": "array",
            "description": "List of supported token signing algorithms",
            "items": {
              "type": "string"
            },
            "example": [
              "RS256"
            ]
          },
          "claims_supported": {
            "type": "array",
            "description": "List of supported claims",
            "items": {
              "type": "string"
            },
            "example": [
              "email"
            ]
          }
        }
      },
      "public-key-response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "public_key"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "description": "ID of the signing key. This corresponds to the `kid` field of the header in JWTs.",
            "example": "5f603df3-e406-41d8-b8cd-dfad7f820c1e"
          },
          "public_key": {
            "type": "string",
            "description": "PEM-encoded public key with new lines encoded as `\n`. The public key may be enclosed in a certificate.",
            "example": "-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA+4JWLMc7TWUPDICh7vW7\nC/KXRyhUFKQpZmfpmqZyo1Mcr4XwPtf1c8fgkcggwBgE+uVTQ/dGDt9wnFA3M6gA\n/zckSQnR1JTt45l9wp6bITYn7t94CCYKH4S06NROZHt49G4PIrffmAT9UB/F/rBC\n1K3KAwYBVkO6SXzcGS9gTai2Xas2OycN/H/hpfLfdVBDYDcZwC4dzCDtLd0zK1/k\nZ88ifZTmk60qP8fcI589ENdMXjVkrmqhv09svJ4PoBeT9h2LoDJlkT78h/SUMMdW\n3GidhiubkfuA18YqXourQbuNdq8OzGPGcjPZ5+toew8NEL5v2+WRFA5Zv2e3oMbw\n41STSpS5hg5za4q52IZo0pkZtiPSPz2W8/AIgOHlpnbsTM9B2tNAlAAJ4kWnhEl8\nq/xhgMMO6ANtVUKC7HbsucfAaDx+p6qCZzbuL0LuhceZioWkVkup2hwAQueJxGks\n2eTV7bC8f5SnZo5yADCic936bEetnMd+OfiTvVFROkqfGTPJhTMWwk3Uqvl+rh7o\nqz0iTPotCm//A6PzDGWt2PSCOu7AQIhl7xRNAiljP/VAyi7Rs80IzX7xrnc8PbOc\ngMxTkl6cveFRDVWvhaMCi7v9xi7CyXnIuyaxwynTc6j67r0JmkKZByo1GGmbkxA1\nPKDntq4yi8rRL59+Xivj3tcCAwEAAQ==\n-----END PUBLIC KEY-----\n"
          }
        }
      },
      "auth_methods": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ldap_url": {
            "type": "string",
            "description": "Endpoint to post the credentials to for LDAP authentication."
          },
          "password_url": {
            "type": "string",
            "description": "Endpoint to post the credentials to for user+password authentication"
          },
          "organization": {
            "type": "string",
            "description": "Organization name for which the authentication methods are reported."
          },
          "icon": {
            "type": "string",
            "description": "Path to the organization icon"
          },
          "onboard_checklist": {
            "type": "string",
            "description": "Whether the organization onboarding has been completed."
          },
          "email": {
            "type": "string",
            "description": "User email for which the authentication methods are reported."
          }
        }
      },
      "saml_metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organization": {
            "type": "object",
            "description": "Organization details",
            "properties": {
              "en-US": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "example": "http://cam.ctl.io"
                  },
                  "displayname": {
                    "type": "string",
                    "example": "ElasticBox SAML Service Provider"
                  },
                  "name": {
                    "type": "string",
                    "example": "ElasticBox"
                  }
                }
              }
            }
          },
          "security": {
            "type": "object",
            "properties": {
              "wantAssertionsSigned": {
                "type": "boolean"
              },
              "wantNameId": {
                "type": "boolean"
              },
              "requestedAuthnContext": {
                "type": "boolean"
              },
              "authnRequestsSigned": {
                "type": "boolean"
              }
            }
          },
          "sp": {
            "type": "object",
            "properties": {
              "assertionConsumerService": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "example": "https://cam.ctl.com/services/security/saml?organization=public"
                  },
                  "binding": {
                    "type": "string",
                    "example": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
                  }
                }
              },
              "x509cert": {
                "type": "string",
                "example": "-----BEGIN CERTIFICATE-----\nMI..."
              },
              "NameIDFormat": {
                "type": "string",
                "example": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified"
              },
              "privateKey": {
                "type": "string",
                "example": "-----BEGIN RSA PRIVATE KEY-----\nMI..."
              },
              "entityId": {
                "type": "string",
                "example": "cam.ctl.com"
              }
            }
          },
          "idp": {
            "type": "object",
            "properties": {
              "x509cert": {
                "type": "string",
                "example": "MII..."
              },
              "entityId": {
                "type": "string",
                "example": "https://fnst.centurylink.com/oam/fed"
              },
              "singleSignOnService": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "example": "https://fnst.centurylink.com/oamfed/idp/samlv20"
                  },
                  "binding": {
                    "type": "string",
                    "example": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
                  }
                }
              }
            }
          },
          "contactPerson": {
            "type": "object",
            "properties": {
              "support": {
                "type": "object",
                "properties": {
                  "givenName": {
                    "type": "string",
                    "example": "CAM support"
                  },
                  "emailAddress": {
                    "type": "string",
                    "example": "support@centurylink.com"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}