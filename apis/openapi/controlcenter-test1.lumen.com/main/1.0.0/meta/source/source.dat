    "/jwt_keys": {
      "get": {
        "summary": "Retrieve all JWT public signing keys that are valid.",
        "description": "Retrieve all PEM-formatted public keys that are valid that can be used to verify Portal Framework JWTs. Unexpired tokens may have been signed with any of these keys. The `Accept` header sets the return format: `application/json` returns an array of JSON documents with the key ID and a serialized public key with `\n` instead of new lines, while `text/plain` or `application/x-x509-ca-cert` returns a contcatenated list of public keys as plain text with valid new line characters.",
        "operationId": "getJwtKey",
        "tags": [
          "Signing keys"
        ],
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful Operation",
