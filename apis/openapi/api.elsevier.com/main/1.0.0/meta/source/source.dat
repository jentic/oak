{
  "openapi": "3.0.3",
  "info": {
    "title": "Elsevier Scopus API",
    "description": "The Elsevier Scopus API provides access to Scopus abstract and citation data including search, abstract retrieval, author retrieval, and affiliation retrieval.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://dev.elsevier.com/"
  },
  "servers": [
    {
      "url": "https://api.elsevier.com",
      "description": "Elsevier API production"
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    }
  ],
  "paths": {
    "/content/search/scopus": {
      "get": {
        "operationId": "searchScopus",
        "summary": "Search Scopus abstracts and citations",
        "description": "Search the Scopus database using Boolean query syntax.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Boolean search query string (URL-encoded)"
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["STANDARD", "COMPLETE"]
            },
            "description": "Response detail level"
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-delimited list of specific fields to return"
          },
          {
            "name": "start",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Results offset position"
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Maximum results per request"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort field (artnum, citedby-count, coverDate, creator, orig-load-date, pagecount, relevancy)"
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Year range filter (e.g., 2002-2007)"
          },
          {
            "name": "content",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["core", "dummy", "all"]
            },
            "description": "Content type filter"
          },
          {
            "name": "subj",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Subject area codes (AGRI, COMP, MEDI, etc.)"
          },
          {
            "name": "facets",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Facet fields (af-id, au-id, authname, country, language, pubyear, srctype, subjarea)"
          },
          {
            "name": "httpAccept",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["application/json", "application/atom+xml", "application/xml"]
            },
            "description": "Override Accept header"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Authorization error",
            "content": {
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Quota exceeded",
            "content": {
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/content/abstract/scopus_id/{scopusId}": {
      "get": {
        "operationId": "getAbstractByScopusId",
        "summary": "Retrieve abstract by Scopus ID",
        "parameters": [
          {
            "name": "scopusId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["META", "META_ABS", "FULL", "REF", "ENTITLED"]
            }
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Abstract retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbstractResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/content/abstract/doi/{doi}": {
      "get": {
        "operationId": "getAbstractByDoi",
        "summary": "Retrieve abstract by DOI",
        "parameters": [
          {
            "name": "doi",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["META", "META_ABS", "FULL", "REF", "ENTITLED"]
            }
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Abstract retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbstractResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/content/abstract/eid/{eid}": {
      "get": {
        "operationId": "getAbstractByEid",
        "summary": "Retrieve abstract by Electronic Identifier",
        "parameters": [
          {
            "name": "eid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["META", "META_ABS", "FULL", "REF", "ENTITLED"]
            }
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Abstract retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbstractResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/content/abstract/pii/{pii}": {
      "get": {
        "operationId": "getAbstractByPii",
        "summary": "Retrieve abstract by PII",
        "parameters": [
          {
            "name": "pii",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["META", "META_ABS", "FULL", "REF", "ENTITLED"]
            }
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Abstract retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbstractResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/content/abstract/pubmed_id/{pubmedId}": {
      "get": {
        "operationId": "getAbstractByPubmedId",
        "summary": "Retrieve abstract by PubMed ID",
        "parameters": [
          {
            "name": "pubmedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["META", "META_ABS", "FULL", "REF", "ENTITLED"]
            }
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Abstract retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbstractResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-ELS-APIKey",
        "description": "Elsevier Developer API key"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "Elsevier Developer API key as query parameter"
      }
    },
    "schemas": {
      "SearchResults": {
        "type": "object",
        "properties": {
          "search-results": {
            "type": "object",
            "properties": {
              "opensearch:totalResults": {
                "type": "string"
              },
              "opensearch:startIndex": {
                "type": "string"
              },
              "opensearch:itemsPerPage": {
                "type": "string"
              },
              "entry": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScopusEntry"
                }
              }
            }
          }
        }
      },
      "ScopusEntry": {
        "type": "object",
        "properties": {
          "dc:identifier": {
            "type": "string"
          },
          "dc:title": {
            "type": "string"
          },
          "dc:creator": {
            "type": "string"
          },
          "prism:publicationName": {
            "type": "string"
          },
          "prism:coverDate": {
            "type": "string"
          },
          "prism:doi": {
            "type": "string"
          },
          "citedby-count": {
            "type": "string"
          }
        }
      },
      "AbstractResponse": {
        "type": "object",
        "properties": {
          "abstracts-retrieval-response": {
            "type": "object"
          }
        }
      }
    }
  }
}