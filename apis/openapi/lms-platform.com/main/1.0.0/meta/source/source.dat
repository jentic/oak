  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "BulkCourseInput": {
        "type": "object",
        "required": [
          "course",
          "modules"
        ],
        "properties": {
          "course": {
            "$ref": "#/components/schemas/CourseInput"
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/BulkModuleInput"
            }
          }
        }
      },
      "BulkModuleInput": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "orderIndex": {
            "type": "integer"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkResourceInput"
            }
          }
        }
      },
      "BulkResourceInput": {
        "type": "object",
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "orderIndex": {
            "type": "integer"
          },
          "duration": {
            "type": "string",
            "description": "Required for Video/Audio"
          },
          "url": {
            "type": "string",
            "description": "Required for Video/Audio"
          },
          "fileUrl": {
            "type": "string",
            "description": "URL for PDF/Presentation files (if pre-uploaded)"
          },
          "questionIds": {
            "type": "array",
            "description": "Required for Assessment",
            "items": {
              "type": "string"
            }
          },
          "randomizeQuestions": {
            "type": "boolean"
          },
          "passingScore": {
            "type": "number"
          },
          "certificateTemplateId": {
            "type": "string",
            "description": "Required for Certificate"
          }
        }
      },
      "BulkCourseCreationResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "course": {
            "$ref": "#/components/schemas/Course"
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Module"
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "moduleId": {
                  "type": "string"
                },
                "type": {
                  "$ref": "#/components/schemas/ResourceType"
                },
                "title": {
                  "type": "string"
                },
                "orderIndex": {
                  "type": "integer"
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "totalModules": {
                "type": "integer"
              },
              "totalResources": {
                "type": "integer"
              },
              "resourceBreakdown": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CertificateTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "templateUrl": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "questionText": {
            "type": "string"
          },
          "questionType": {
            "type": "string",
            "enum": [
              "Single_Choice",
              "Multiple_Choice",
              "Fill_in_the_blanks"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For Single/Multiple choice"
          },
          "correctAnswer": {
            "type": "string",
            "description": "For Single choice and Fill in the blanks"
          },
          "correctAnswers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For Multiple choice"
          },
          "marks": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QuestionInput": {
        "type": "object",
        "required": [
          "questionText",
          "questionType",
          "marks"
        ],
        "properties": {
          "questionText": {
            "type": "string"
          },
          "questionType": {
            "type": "string",
            "enum": [
              "Single_Choice",
              "Multiple_Choice",
              "Fill_in_the_blanks"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correctAnswer": {
            "type": "string"
          },
          "correctAnswers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "marks": {
            "type": "number"
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "moduleCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CourseInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "category"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CourseDetailed": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Course"
          },
          {
            "type": "object",
            "properties": {
              "modules": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ModuleDetailed"
                }
              }
            }
          }
        ]
      },
      "CourseListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Module": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "orderIndex": {
            "type": "integer"
          },
          "resourceCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ModuleInput": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "orderIndex": {
            "type": "integer"
          }
        }
      },
      "ModuleDetailed": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Module"
          },
          {
            "type": "object",
            "properties": {
              "resources": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          }
        ]
      },
      "Resource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "orderIndex": {
            "type": "integer"
          },
          "duration": {
            "type": "string",
            "description": "For Video/Audio"
          },
          "url": {
            "type": "string",
            "description": "For Video/Audio, or stored file URL for PDF/Presentation"
          },
          "questionIds": {
            "type": "array",
            "description": "For Assessment",
            "items": {
              "type": "string"
            }
          },
          "randomizeQuestions": {
            "type": "boolean",
            "description": "For Assessment"
          },
          "passingScore": {
            "type": "number",
            "description": "For Assessment"
          },
          "currentAssessmentVersion": {
            "type": "string",
            "description": "For Assessment - Current version of the assessment",
            "example": "v2_20251118_160000"
          },
          "certificateTemplateId": {
            "type": "string",
            "description": "For Certificate - Required"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResourceInput": {
        "type": "object",
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "orderIndex": {
            "type": "integer"
          },
          "duration": {
            "type": "string",
            "description": "Required for Video/Audio"
          },
          "url": {
            "type": "string",
            "description": "Required for Video/Audio"
          },
          "questionIds": {
            "type": "array",
            "description": "Required for Assessment",
            "items": {
              "type": "string"
            }
          },
          "randomizeQuestions": {
            "type": "boolean"
          },
          "passingScore": {
            "type": "number"
          },
          "certificateTemplateId": {
            "type": "string",
            "description": "Required for Certificate"
          }
        }
      },
      "ResourceInputMultipart": {
        "type": "object",
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Video",
              "Audio",
              "PDF",
              "Presentation",
              "Assessment",
              "Certificate"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "orderIndex": {
            "type": "integer"
          },
          "duration": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "format": "binary",
            "description": "Required for PDF/Presentation uploads"
          },
          "questionIds": {
            "type": "string",
            "description": "JSON array string for Assessment"
          },
          "randomizeQuestions": {
            "type": "boolean"
          },
          "passingScore": {
            "type": "number"
          },
          "certificateTemplateId": {
            "type": "string",
            "description": "Required for Certificate"
          }
        }
      },
      "ResourceType": {
        "type": "string",
        "enum": [
          "Video",
          "Audio",
          "PDF",
          "Presentation",
          "Assessment",
          "Certificate"
        ],
        "example": "Video"
      },
      "AssessmentAttempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "studentId": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "assessmentId": {
            "type": "string"
          },
          "assessmentVersion": {
            "type": "string",
            "description": "Version identifier for the assessment snapshot stored in S3",
            "example": "v1_20251118_150000"
          },
          "s3FilePath": {
            "type": "string",
            "description": "S3 path where assessment questions are stored",
            "example": "assessments/course_67890/res_22222/v1_20251118_150000.json"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "abandoned"
            ]
          },
          "score": {
            "type": "number"
          },
          "totalMarks": {
            "type": "number"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StudentAnswersInput": {
        "type": "object",
        "required": [
          "answers"
        ],
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionId": {
                  "type": "string"
                },
                "answerType": {
                  "type": "string",
                  "enum": [
                    "Single_Choice",
                    "Multiple_Choice",
                    "Fill_in_the_blanks"
                  ]
                },
                "answer": {
                  "type": "string"
                },
                "answers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "questionId",
                "answerType"
              ]
            }
          }
        }
      },
      "AssessmentResult": {
        "type": "object",
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "totalMarks": {
            "type": "number"
          },
          "percentage": {
            "type": "number"
          },
          "passed": {
            "type": "boolean"
          },
          "passingScore": {
            "type": "number"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StudentProgress": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "overallProgress": {
            "type": "number"
          },
          "completedResources": {
            "type": "integer"
          },
          "totalResources": {
            "type": "integer"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "currentPage": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "totalItems": {
            "type": "integer"
          },
          "itemsPerPage": {
            "type": "integer"
          }
        }
      }
    }
  }
}