{
  "openapi": "3.0.3",
  "info": {
    "title": "Complete LMS API - With Bulk Course Creation",
    "description": "Complete API including bulk course creation with modules and resources, Certificate Templates, all 6 resource types, and file uploads",
    "version": "1.0.0",
    "contact": {
      "email": "api-support@lms-platform.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/enfin-9f0/complete-lms-api-with-bulk-course-creation/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.lms-platform.com/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Courses",
      "description": "Course management"
    },
    {
      "name": "Modules",
      "description": "Course modules"
    },
    {
      "name": "Resources",
      "description": "Module resources (Video, Audio, PDF, Presentation, Assessment, Certificate)"
    },
    {
      "name": "Bulk Operations",
      "description": "Bulk creation operations for courses with modules and resources"
    },
    {
      "name": "Certificate Templates",
      "description": "Manage certificate templates"
    },
    {
      "name": "Questions",
      "description": "Question bank"
    },
    {
      "name": "Student Progress",
      "description": "Student answers and progress"
    }
  ],
  "paths": {
    "/courses/bulk-create": {
      "post": {
        "tags": [
          "Bulk Operations"
        ],
        "summary": "Create complete course with modules and resources",
        "description": "Creates a course along with its modules and resources in a single API call. This endpoint allows you to create the entire course structure at once, including all modules and their associated resources (videos, PDFs, assessments, etc.)",
        "operationId": "bulkCreateCourse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkCourseInput"
              },
              "examples": {
                "completeCourse": {
                  "summary": "Complete course with multiple modules and resources",
                  "value": {
                    "course": {
                      "title": "Introduction to Web Development",
                      "description": "Learn the fundamentals of web development including HTML, CSS, and JavaScript",
                      "category": "Programming",
                      "thumbnailUrl": "https://example.com/thumbnails/web-dev.jpg",
                      "isActive": true
                    },
                    "modules": [
                      {
                        "title": "HTML Basics",
                        "description": "Learn the fundamentals of HTML",
                        "orderIndex": 1,
                        "resources": [
                          {
                            "type": "Video",
                            "title": "Introduction to HTML",
                            "description": "Overview of HTML structure and elements",
                            "orderIndex": 1,
                            "duration": "15:30",
                            "url": "https://videos.example.com/html-intro.mp4"
                          },
                          {
                            "type": "PDF",
                            "title": "HTML Cheat Sheet",
                            "description": "Quick reference guide for HTML tags",
                            "orderIndex": 2,
                            "fileUrl": "https://files.example.com/html-cheatsheet.pdf"
                          },
                          {
                            "type": "Assessment",
                            "title": "HTML Quiz",
                            "description": "Test your HTML knowledge",
                            "orderIndex": 3,
                            "questionIds": [
                              "q1",
                              "q2",
                              "q3",
                              "q4",
                              "q5"
                            ],
                            "randomizeQuestions": true,
                            "passingScore": 70
                          }
                        ]
                      },
                      {
                        "title": "CSS Fundamentals",
                        "description": "Master CSS styling and layouts",
                        "orderIndex": 2,
                        "resources": [
                          {
                            "type": "Video",
                            "title": "CSS Selectors and Properties",
                            "description": "Learn about CSS selectors and common properties",
                            "orderIndex": 1,
                            "duration": "20:45",
                            "url": "https://videos.example.com/css-basics.mp4"
                          },
                          {
                            "type": "Presentation",
                            "title": "CSS Flexbox Guide",
                            "description": "Visual guide to CSS Flexbox",
                            "orderIndex": 2,
                            "fileUrl": "https://files.example.com/flexbox-guide.pptx"
                          }
                        ]
                      },
                      {
                        "title": "Course Completion",
                        "description": "Final assessment and certificate",
                        "orderIndex": 3,
                        "resources": [
                          {
                            "type": "Assessment",
                            "title": "Final Exam",
                            "description": "Comprehensive assessment covering all topics",
                            "orderIndex": 1,
                            "questionIds": [
                              "q10",
                              "q11",
                              "q12",
                              "q13",
                              "q14",
                              "q15"
                            ],
                            "randomizeQuestions": true,
                            "passingScore": 80
                          },
                          {
                            "type": "Certificate",
                            "title": "Course Completion Certificate",
                            "description": "Certificate of completion for Web Development course",
                            "orderIndex": 2,
                            "certificateTemplateId": "template_123"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course with modules and resources created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkCourseCreationResponse"
                },
                "example": {
                  "message": "Course created successfully with modules and resources",
                  "course": {
                    "id": "course_12345",
                    "title": "Introduction to Web Development",
                    "description": "Learn the fundamentals of web development including HTML, CSS, and JavaScript",
                    "category": "Programming",
                    "thumbnailUrl": "https://example.com/thumbnails/web-dev.jpg",
                    "isActive": true,
                    "moduleCount": 3,
                    "createdAt": "2025-11-18T10:00:00Z",
                    "updatedAt": "2025-11-18T10:00:00Z"
                  },
                  "modules": [
                    {
                      "id": "module_001",
                      "courseId": "course_12345",
                      "title": "HTML Basics",
                      "description": "Learn the fundamentals of HTML",
                      "orderIndex": 1,
                      "resourceCount": 3,
                      "createdAt": "2025-11-18T10:00:01Z",
                      "updatedAt": "2025-11-18T10:00:01Z"
                    },
                    {
                      "id": "module_002",
                      "courseId": "course_12345",
                      "title": "CSS Fundamentals",
                      "description": "Master CSS styling and layouts",
                      "orderIndex": 2,
                      "resourceCount": 2,
                      "createdAt": "2025-11-18T10:00:02Z",
                      "updatedAt": "2025-11-18T10:00:02Z"
                    },
                    {
                      "id": "module_003",
                      "courseId": "course_12345",
                      "title": "Course Completion",
                      "description": "Final assessment and certificate",
                      "orderIndex": 3,
                      "resourceCount": 2,
                      "createdAt": "2025-11-18T10:00:03Z",
                      "updatedAt": "2025-11-18T10:00:03Z"
                    }
                  ],
                  "resources": [
                    {
                      "id": "res_001",
                      "moduleId": "module_001",
                      "type": "Video",
                      "title": "Introduction to HTML",
                      "orderIndex": 1
                    },
                    {
                      "id": "res_002",
                      "moduleId": "module_001",
                      "type": "PDF",
                      "title": "HTML Cheat Sheet",
                      "orderIndex": 2
                    },
                    {
                      "id": "res_003",
                      "moduleId": "module_001",
                      "type": "Assessment",
                      "title": "HTML Quiz",
                      "orderIndex": 3
                    },
                    {
                      "id": "res_004",
                      "moduleId": "module_002",
                      "type": "Video",
                      "title": "CSS Selectors and Properties",
                      "orderIndex": 1
                    },
                    {
                      "id": "res_005",
                      "moduleId": "module_002",
                      "type": "Presentation",
                      "title": "CSS Flexbox Guide",
                      "orderIndex": 2
                    },
                    {
                      "id": "res_006",
                      "moduleId": "module_003",
                      "type": "Assessment",
                      "title": "Final Exam",
                      "orderIndex": 1
                    },
                    {
                      "id": "res_007",
                      "moduleId": "module_003",
                      "type": "Certificate",
                      "title": "Course Completion Certificate",
                      "orderIndex": 2
                    }
                  ],
                  "summary": {
                    "totalModules": 3,
                    "totalResources": 7,
                    "resourceBreakdown": {
                      "Video": 2,
                      "PDF": 1,
                      "Presentation": 1,
                      "Assessment": 2,
                      "Certificate": 1
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Validation failed",
                  "message": "Course title is required",
                  "details": [
                    "course.title: Field is required",
                    "modules[0].resources[2].questionIds: Required for Assessment type"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/certificate-templates": {
      "get": {
        "tags": [
          "Certificate Templates"
        ],
        "summary": "Get all certificate templates",
        "description": "Retrieves list of certificate templates for selection",
        "operationId": "getCertificateTemplates",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CertificateTemplate"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Certificate Templates"
        ],
        "summary": "Create certificate template",
        "description": "Creates a new certificate template with image upload",
        "operationId": "createCertificateTemplate",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Course Completion Certificate"
                  },
                  "description": {
                    "type": "string"
                  },
                  "templateFile": {
                    "type": "string",
                    "format": "binary",
                    "description": "Certificate template image (PNG, JPG)"
                  },
                  "isActive": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "name",
                  "templateFile"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateTemplate"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/certificate-templates/{templateId}": {
      "get": {
        "tags": [
          "Certificate Templates"
        ],
        "summary": "Get certificate template by ID",
        "operationId": "getCertificateTemplateById",
        "parameters": [
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateTemplate"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Certificate Templates"
        ],
        "summary": "Update certificate template",
        "operationId": "updateCertificateTemplate",
        "parameters": [
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "templateFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "isActive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template updated"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Certificate Templates"
        ],
        "summary": "Delete certificate template",
        "operationId": "deleteCertificateTemplate",
        "parameters": [
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Template deleted"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/courses": {
      "get": {
