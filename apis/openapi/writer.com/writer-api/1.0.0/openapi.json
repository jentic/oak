{
  "openapi": "3.0.3",
  "info": {
    "title": "Writer AI Studio API",
    "version": "1.0.0",
    "description": "AI platform API providing chat completion, text generation, file management, knowledge graphs, AI detection, translation, and vision capabilities.",
