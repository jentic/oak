      "GridApi_Filter_IntegerListContainsModeEnum": {
        "type": "string",
        "description": "Defines how target list should be matched against the filter args:\n- `contains_any` - at least one element from the filter args should be in the target list;\n- `contains_all` - all elements from the filter args should be in the target list, but the target list can contain more elements;\n- `contains_only` - all elements from the filter args should be in the target list, and the target list should NOT contain other elements.\n",
        "enum": [
          "contains_any",
          "contains_all",
          "contains_only"
        ]
      },
      "GridApi_Filter_DateTimeRelativeUnitEnum": {
        "type": "string",
        "description": "Specifies the unit of time for the relative date filter.",
        "enum": [
          "minute",
          "hour",
          "day",
          "week",
          "month"
        ]
      },
      "GridApi_ConditionsMatchModeEnum": {
        "type": "string",
        "description": "Specifies how to combine results of multiple conditions when determining if a row should be included in the result:\n- `all` - all conditions must be met;\n- `any` - at least one condition must be met.\nDefault is `all`.\n",
        "enum": [
          "all",
          "any"
        ]
      },
