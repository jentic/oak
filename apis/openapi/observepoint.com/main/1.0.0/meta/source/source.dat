      "GridApi_SchemaColumnDef_EntityReference": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GridApi_SchemaColumnDef"
          },
          {
            "type": "object",
            "required": [
              "referenceType",
              "fields"
            ],
            "properties": {
              "referenceType": {
                "$ref": "#/components/schemas/GridApi_EntityReferenceTypeEnum"
              },
              "isEnum": {
                "type": "boolean",
                "default": false
              },
              "enumValues": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/GridApi_EntityReferenceEnumerationItem"
                }
              },
              "fields": {
                "type": "array",
                "description": "This array describes which fields (and in which order) are included in the response for this entity reference column.\nIf entity reference has more than 1 field, then each entity reference will be represented as a list of fields' values.\nIf entity reference has only 1 field, then each entity reference will be represented plain field value.\nExamples:\n1. when `'isList': false, 'fields': [{'fieldName': 'id'}, {'fieldName': 'name'}]`\n  - then each entity reference will be represented as a list of 2 values: id and name,\n  - example: `[1, 'John']`;\n2. when `'isList': true, 'fields': [{'fieldName': 'id'}, {'fieldName': 'name'}]`\n  - then each entity reference will be represented as a list of lists of 2 values: id and name,\n  - example: `[[1, 'John'], [2, 'Jane']]`;\n3. when `'isList': false, 'fields': [{'fieldName': 'id'}]`\n    - then each entity reference will be represented as a single value: id,\n    - example: `1`;\n4. when `'isList': true, 'fields': [{'fieldName': 'id'}]`\n    - then each entity reference will be represented as a list of plain values: id,\n    - example: `[1, 2]`.\n",
                "items": {
                  "$ref": "#/components/schemas/GridApi_EntityReference_FieldItem"
                }
              },
              "isList": {
                "type": "boolean",
                "description": "If true, column value contains a list of entity references",
                "default": false
              }
            }
          }
        ]
      },
      "GridApi_EntityReference_FieldItem": {
        "type": "object",
        "description": "Describes which fields (and in which order) are included in the response for this entity reference column.\n`fieldName` is the name of the field, `columnId` is the column ID of the field (if available in the Grid),\n`supportedFilterOperators` are filters supported by the field.\nThere are 2 possible cases:\n1. when `'isList': true, then each field will have `fieldName` and `supportedFilterOperators`\n   - example: `[{ 'fieldName': 'name', 'supportedFilterOperators': ['string_contains'] }]`\n2. when `'isList': false, then each field will have `fieldName` and `columnId` (associated column)\n   - example: `[{ 'fieldName': 'id', 'columnId': 'AUDIT_ID' }]`\n",
        "required": [
          "fieldName"
        ],
        "properties": {
          "fieldName": {
            "$ref": "#/components/schemas/GridApi_EntityReference_FieldTypeEnum"
          },
          "columnId": {
            "$ref": "#/components/schemas/GridApi_ColumnId"
          },
          "supportedFilterOperators": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/components/schemas/GridApi_FilterOperatorEnum"
            }
          },
          "referenceType": {
            "$ref": "#/components/schemas/GridApi_EntityReferenceTypeEnum"
          }
        }
      },
      "GridApi_EntityReference_FieldTypeEnum": {
        "type": "string",
        "description": "name of field of the entity reference object",
        "enum": [
          "id",
          "name",
          "preset_type",
          "domain",
          "link",
