      "GridApi_LinkToPageDetails_LinkParams": {
        "type": "object",
        "description": "This object specifies:\n1. column IDs which values are used to populate variables in Page Details link template, and\n2. the tab to open in the Page Details report.\nLink template example:\n\"/audit/{auditId}/run/{auditRunId}/report/page-details/{pageId}?tab={pageDetailsTab}\"\n",
