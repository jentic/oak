      "GridApi_SchemaUiHints_DisplayUnitEnum": {
        "type": "string",
        "description": "Values returned by the API always have the same unit, but UI can display them in different ways. The `displayUnit`\nproperty controls how the values are displayed in the UI.\n\n[unit of value returned by API] - [API value example] - [unit of display in UI] - [example on UI] correspondence:\n* duration, milliseconds - 3720000                     - `duration_human_friendly` - '1 hour 2 min'\n* duration, milliseconds - 372                         - `duration_ms`             - '372 ms'\n* duration, milliseconds - 1500                        - `duration_sec`            - '1.5 sec'\n* duration, milliseconds - 90000                       - `duration_min`            - '1.5 min'\n* decimal number         - 12.3                        - `percentage`              - '12.3%'\n* decimal number         - 0.42                        - `fraction`                - '0.42'\n* integer number         - 1234                        - `size_bytes`              - '1234 bytes'\n* integer number         - 1234                        - `size_kb`                 - '1.23 KB'\n* integer number         - 1234567                     - `size_mb`                 - '1.23 MB'\n* integer number         - 1234567890                  - `size_gb`                 - '1.23 GB'\n",
        "enum": [
          "count",
          "duration_human_friendly",
          "duration_ms",
          "duration_sec",
          "duration_min",
          "percentage",
          "fraction",
          "size_bytes",
          "size_kb",
          "size_mb",
          "size_gb",
          "audit_score",
          "accessibility_score"
        ]
      },
