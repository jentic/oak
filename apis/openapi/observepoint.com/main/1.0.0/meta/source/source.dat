          "pageDetailsTab": {
            "$ref": "#/components/schemas/GridApi_LinkToPageDetails_TabEnum"
          }
        }
      },
      "GridApi_LinkToPageDetails_TabEnum": {
        "type": "string",
        "description": "This enum is used to specify the tab to open in the Page Details report, FE should map from this enum to \nthe `tab` query parameter value of Page Details, examples:\n- \"info\" \u2192 \"?tab=page-information\"\n- \"tags\" \u2192 \"?tab=tags\"\n- \"tag_initiators\" \u2192 \"?tab=tag-initiators\"\nand so on.\n",
        "enum": [
