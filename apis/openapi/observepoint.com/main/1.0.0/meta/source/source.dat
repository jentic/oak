      "GridApi_LinkToAuditRun_ReportTypeEnum": {
        "description": "This enum is used to specify the type of the audit run report to link to, effectively allows FE to determine\nthe report link template, examples:\n- \"audit_summary\" \u2192 \"/audit/{auditId}/run/{auditRunId}/report/audit-summary\"\n- \"page_summary\" \u2192 \"/audit/{auditId}/run/{auditRunId}/report/page-summary\"\nand so on.\n",
        "type": "string",
        "enum": [
