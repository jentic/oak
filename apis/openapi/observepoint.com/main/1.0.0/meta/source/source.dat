            "$ref": "#/components/schemas/GridApi_ColumnId"
          },
          "webJourneyRunReportTab": {
            "$ref": "#/components/schemas/GridApi_LinkToWebJourneyRun_ReportTabEnum"
          }
        }
      },
      "GridApi_LinkToWebJourneyRun_ReportTabEnum": {
        "type": "string",
        "description": "This enum is used to specify the tab to open in the Web Journey Run report, FE should map from this enum to \nthe `tab` query parameter value of Web Journey Run, examples:\n- \"action_details\" \u2192 \"?action={actionSequenceNr}&tab=0\"\n- \"request_log\" \u2192 \"?action={actionSequenceNr}&tab=0\"\n- \"tag_presence\" \u2192 \"?action={actionSequenceNr}&tab=1\"\n- \"variable_summary\" \u2192 \"?action={actionSequenceNr}&tab=2\"\nand so on.\n",
        "enum": [
          "action_details",
          "request_log",
          "console_log",
          "tag_presence",
          "variable_summary",
          "cookies",
          "rules"
