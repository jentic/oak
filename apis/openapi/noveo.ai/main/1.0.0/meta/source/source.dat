{
  "openapi": "3.0.3",
  "info": {
    "title": "Conversation Processing API",
    "version": "1.0.0",
    "description": "Session-based conversation processing with explicit state machine. All endpoints require an API key via the `x-api-key` header. Global version prefix: `/v1`.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/noveo-26e/KMNV/1.0.0"
  },
  "servers": [
    {
      "description": "PROD API",
      "url": "https://4j50mw8ml5.execute-api.eu-west-1.amazonaws.com/v1"
    },
    {
      "description": "DEV API",
      "url": "https://q39ihw7lzd.execute-api.eu-west-1.amazonaws.com/v1"
    },
    {
      "description": "SwaggerHub API Auto Mocking",
      "url": "https://virtserver.swaggerhub.com/noveo-26e/KMNV/1.0.0"
    }
  ],
  "tags": [
    {
      "name": "Conversation"
    },
    {
      "name": "State"
    },
    {
      "name": "Result"
    },
    {
      "name": "History -- OUT OT THE POC SCOPE"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/conversation": {
      "post": {
        "tags": [
          "Conversation"
        ],
        "summary": "Create a new conversation session",
        "operationId": "createConversation",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation_id": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "created": {
                    "value": {
                      "status": "Success",
                      "id": "770ab3f8-2fa8-49e0-812b-53b7fb7841b9"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/conversation/{id}": {
      "get": {
        "tags": [
          "Conversation"
        ],
        "summary": "Get conversation metadata",
        "operationId": "getConversation",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_ConversationMeta"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "Success",
                      "data": {
                        "id": "b1cf4f7b-7f00-4a3c-8c2f-9a7a5f8d9c10",
                        "created_at": "2025-11-07T12:00:00Z",
                        "updated_at": "2025-11-07T12:05:13Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Conversation"
        ],
        "summary": "Delete a conversation and all associated data (metadata, state, history, results)",
        "operationId": "deleteConversation",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponseEmpty"
                },
                "examples": {
                  "deleted": {
                    "value": {
                      "status": "Success"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/conversation/{id}/message": {
      "post": {
        "tags": [
          "Conversation"
        ],
        "summary": "Post a message to the conversation",
        "operationId": "postMessage",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserMessage"
              },
              "examples": {
                "knowngeneral": {
                  "summary": "Known information with general knowledge",
                  "value": {
                    "text": "What is the amount of endogenous production of creatine?",
                    "options": {
                      "allow_general_knowledge": true
                    }
                  }
                },
                "knownnogeneral": {
                  "summary": "Known information without general knowledge",
                  "value": {
                    "text": "What is the amount of endogenous production of creatine?",
                    "options": {
                      "allow_general_knowledge": false
                    }
                  }
                },
                "unknowngeneral": {
                  "summary": "Unknown information with general knowledge",
                  "value": {
                    "text": "What is the distance from the Earth to the Moon?",
                    "options": {
                      "allow_general_knowledge": true
                    }
                  }
                },
                "unknownnogeneral": {
                  "summary": "Unknown information without general knowledge",
                  "value": {
                    "text": "What is the distance from the Earth to the Moon?",
                    "options": {
                      "allow_general_knowledge": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponseEmpty"
                },
                "examples": {
                  "accepted": {
                    "value": {
                      "status": "Success"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/conversation/{id}/state": {
      "get": {
        "tags": [
          "State"
        ],
        "summary": "Get the current conversation state",
        "operationId": "getConversationState",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK (always, unless an error occurs)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_State"
                },
                "examples": {
                  "idle": {
                    "value": {
                      "status": "Success",
                      "data": {
                        "state": "Idle"
                      }
                    }
                  },
                  "processing": {
                    "value": {
                      "status": "Success",
                      "data": {
                        "state": "Processing"
                      }
                    }
                  },
                  "ready": {
                    "value": {
                      "status": "Success",
                      "data": {
                        "state": "Ready"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/conversation/{id}/reset": {
      "post": {
        "tags": [
          "State"
        ],
        "summary": "Reset the conversation (idempotent)",
        "description": "If called during `Processing`, the session enters `Cancelling` until the cancellation completes, then transitions to `Idle`. If called during `Idle` or `Ready`, it clears the last result (if any) and leaves the session `Idle`. Repeated calls while `Cancelling` do nothing (returns 200).\n",
        "operationId": "resetConversation",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Reset accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponseEmpty"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "Success"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/conversation/{id}/result": {
      "get": {
        "tags": [
          "Result"
        ],
        "summary": "Get the latest completion result",
        "description": "Returns 200 with the latest result when state is `Ready`. Returns 409 (busy) when state is `Processing` or `Cancelling` (do not call before `/state` reports `Ready`).\n",
        "operationId": "getResult",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK (result ready)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_Result"
                },
                "examples": {
                  "result": {
                    "value": {
                      "status": "Success",
                      "data": {
                        "processing_started_at": "2025-11-28T18:37:51.925000+00:00",
                        "processing_finished_at": "2025-11-28T18:38:11.446471+00:00",
                        "result": {
                          "request": {
                            "text": "What is the amount of endogenous production of creatine?",
                            "options": {
                              "allow_general_knowledge": true
                            }
                          },
                          "response": {
                            "text": "According to our knowledge base, the endogenous production of creatine in humans is approximately 1 gram per day. This production primarily occurs in the liver and kidneys, with a smaller amount synthesized in the pancreas. This natural synthesis helps maintain the body's creatine stores, which are important for energy metabolism, particularly in muscle tissues.",
                            "properties": {
                              "general_knowledge": false,
                              "intent": "qa",
                              "history_included": false,
                              "conversation_complete": true,
                              "human_needed": false
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/ConflictBusy"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "parameters": {
      "ConversationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "description": "Opaque server-generated ID"
        },
        "description": "Conversation ID (opaque string)"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "description": "Page number (default 1)"
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "description": "Page size (default 20, max 100)"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Client-supplied idempotency key. **Not supported in the POC scope** (accepted but ignored).\n"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardResponseEmpty"
            },
            "examples": {
              "bad": {
                "value": {
                  "status": "Failure",
                  "error": {
                    "code": 400,
                    "message": "Malformed request"
                  }
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardResponseEmpty"
            },
            "examples": {
              "unauthorized": {
                "value": {
                  "status": "Failure",
                  "error": {
                    "code": 401,
                    "message": "Missing or invalid API key"
                  }
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardResponseEmpty"
            },
            "examples": {
              "forbidden": {
                "value": {
                  "status": "Failure",
                  "error": {
                    "code": 403,
                    "message": "Forbidden"
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardResponseEmpty"
            },
            "examples": {
              "notfound": {
                "value": {
                  "status": "Failure",
                  "error": {
                    "code": 404,
                    "message": "Conversation not found"
                  }
                }
              }
            }
          }
        }
      },
      "ConflictBusy": {
        "description": "Conflict (busy)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardResponseEmpty"
            },
            "examples": {
              "busy": {
                "value": {
                  "status": "Failure",
                  "error": {
                    "code": 409,
                    "message": "Conversation is busy"
                  }
                }
              }
            }
          }
        }
      },
      "ServerError": {
        "description": "Server Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardResponseEmpty"
            },
            "examples": {
              "servererr": {
                "value": {
                  "status": "Failure",
                  "error": {
                    "code": 500,
                    "message": "Internal server error"
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "StandardResponseEmpty": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Success",
              "Failure"
            ]
          },
          "error": {
            "$ref": "#/components/schemas/ErrorObject"
          }
        }
      },
      "StandardResponse_ConversationMeta": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponseEmpty"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ConversationMeta"
              }
            }
          }
        ]
      },
      "StandardResponse_State": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponseEmpty"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "$ref": "#/components/schemas/State"
                  }
                }
              }
            }
          }
        ]
      },
      "StandardResponse_Result": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponseEmpty"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ResultPayload"
              }
            }
          }
        ]
      },
      "StandardResponse_History": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponseEmpty"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "page",
                  "limit",
                  "total_count",
                  "history"
                ],
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "total_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "description": "Opaque entry; structure intentionally unspecified."
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ConversationMeta": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque server-generated ID (no format guarantees)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 UTC (e.g., 2025-11-07T12:00:00Z)"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 UTC (e.g., 2025-11-07T12:05:13Z)"
          }
        }
      },
      "State": {
        "type": "string",
        "enum": [
          "Idle",
          "Processing",
          "Ready",
          "Cancelling",
          "Error"
        ]
      },
      "ResultPayload": {
        "type": "object",
        "required": [
          "processing_started_at",
          "processing_finished_at",
          "result"
        ],
        "properties": {
          "processing_started_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 UTC"
          },
          "processing_finished_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 UTC"
          },
          "result": {
            "type": "object",
            "description": "Free-form/complex structure (intentionally unspecified)"
          }
        }
      },
      "UserMessage": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "UTF-8 text; no size limit"
          },
          "options": {
            "type": "object",
            "properties": {
              "allow_general_knowledge": {
                "type": "boolean",
                "default": false
              },
              "allow_clarification": {
                "type": "boolean",
                "default": false,
                "description": "Not implemented in the POC scope"
              },
              "allow_human_call": {
                "type": "boolean",
                "default": false,
                "description": "Not implemented in the POC scope"
              }
            }
          },
          "callback": {
            "type": "object",
            "description": "Kept for future compatibility; not implemented in the POC scope",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "authentication_type": {
                "type": "string",
                "description": "Omitted for API Key scenarios"
              },
              "api_key": {
                "type": "string"
              }
            }
          }
        }
      },
      "ErrorObject": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "Not set on success; HTTP status code on failure",
            "example": 404
          },
          "message": {
            "type": "string",
            "description": "Not set on success; short human-readable message on failure",
            "example": "Conversation not found"
          }
        }
      }
    }
  }
}