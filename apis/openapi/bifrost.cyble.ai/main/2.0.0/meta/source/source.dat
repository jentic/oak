{
  "openapi": "3.0.0",
  "info": {
    "title": "Alerts Management API",
    "version": "2.0.0",
    "description": "The Alerts API allows you to fetch, update, and comment on security alerts from Cyble Vision. \nIt provides advanced filtering, service discovery, and metadata endpoints.\n\n**Authentication:** All endpoints require Bearer token authentication in the Authorization header.\n\n**Date Format:** All dates are in UTC, ISO 8601 format: YYYY-MM-DDTHH:mm:ss.sssZ\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/pluscda/Cyble/2.0.0"
  },
  "servers": [
    {
      "url": "https://bifrost.cyble.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AlertsFetchRequest": {
        "type": "object",
        "required": [
          "companyUuid"
        ],
        "properties": {
          "companyUuid": {
            "type": "string",
            "format": "uuid",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "description": "Company UUID"
          },
          "orderBy": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "created_at",
                    "updated_at"
                  ]
                },
                "order": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              }
            },
            "example": [
              {
                "field": "created_at",
                "order": "desc"
              },
              {
                "field": "updated_at",
                "order": "desc"
              }
            ]
          },
          "filters": {
            "type": "object",
            "properties": {
              "service": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "darkweb_data_breaches",
                  "github"
                ],
                "description": "Service-specific filters require only one service"
              },
              "created_at": {
                "type": "object",
                "properties": {
                  "gte": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-06-01T18:30:00.000Z"
                  },
                  "lte": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-06-10T18:29:59.999Z"
                  }
                }
              },
              "status": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "UNREVIEWED",
                    "INFORMATIONAL",
                    "FALSE_POSITIVE",
                    "REVIEWED",
                    "IN_PROGRESS"
                  ]
                },
                "example": [
                  "UNREVIEWED"
                ]
              },
              "user_severity": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL"
                  ]
                },
                "example": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              }
            }
          },
          "excludes": {
            "type": "object",
            "properties": {
              "status": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "FALSE_POSITIVE"
                ]
              }
            }
          },
          "skip": {
            "type": "integer",
            "default": 0,
            "description": "Number of records to skip for pagination"
          },
          "take": {
            "type": "integer",
            "default": 10,
            "description": "Number of records to retrieve"
          },
          "countOnly": {
            "type": "boolean",
            "default": false,
            "description": "Use to get only the count"
          },
          "taggedAlert": {
            "type": "boolean",
            "default": false
          },
          "withDataMessage": {
            "type": "boolean",
            "default": false,
            "description": "Use to include alert data messages"
          }
        }
      },
      "AlertsFetchResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Alert"
              }
            }
          },
          "cached": {
            "type": "boolean"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "d4e5f6g7-h8i9-0123-defg-456789012345"
          },
          "service": {
            "type": "string",
            "example": "github"
          },
          "status": {
            "type": "string",
            "enum": [
              "UNREVIEWED",
              "INFORMATIONAL",
              "FALSE_POSITIVE",
              "REVIEWED",
              "IN_PROGRESS"
            ],
            "example": "UNREVIEWED"
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "example": "MEDIUM"
          },
          "user_severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "example": "HIGH"
          },
          "description": {
            "type": "string",
            "example": "test"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-01T10:30:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-01T10:30:00.000Z"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "test"
            ]
          }
        }
      },
      "AlertsUpdateRequest": {
        "type": "object",
        "required": [
          "alerts",
          "companyUuid"
        ],
        "properties": {
          "alerts": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "assignee_id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "b2c3d4e5-f6g7-8901-bcde-f23456789012"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "b2c3d4e5-f6g7-8901-bcde-f23456789012"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "UNREVIEWED",
                    "INFORMATIONAL",
                    "FALSE_POSITIVE",
                    "REVIEWED",
                    "IN_PROGRESS"
                  ],
                  "example": "INFORMATIONAL"
                },
                "user_severity": {
                  "type": "string",
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL"
                  ],
                  "example": "LOW"
                },
                "service": {
                  "type": "string",
                  "example": "github"
                }
              }
            }
          },
          "companyUuid": {
            "type": "string",
            "format": "uuid",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          }
        }
      },
      "AlertsUpdateResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "additionalProp1": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Alert"
                }
              },
              "additionalProp2": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Alert"
                }
              },
              "additionalProp3": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Alert"
                }
              }
            }
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "FilterDataRequest": {
        "type": "object",
        "required": [
          "companyUuid"
        ],
        "properties": {
          "companyUuid": {
            "type": "string",
            "format": "uuid",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "github",
              "darkweb_data_breaches"
            ]
          }
        }
      },
      "AddCommentRequest": {
        "type": "object",
        "required": [
          "comment",
          "companyUuid"
        ],
        "properties": {
          "comment": {
            "type": "string",
            "example": "This alert has been reviewed and marked as informational."
          },
          "companyUuid": {
            "type": "string",
            "format": "uuid",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          }
        }
      },
      "ServicesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "CompaniesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "UsersResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "format": "email"
                }
              }
            }
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "errorName": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/ar-apollo-v2/api/v2/y/alerts": {
      "post": {
        "tags": [
          "Alerts"
        ],
        "summary": "Fetch alerts",
        "description": "Fetch security alerts with advanced filtering, ordering, and pagination.\n\n**Notes:**\n- Use `countOnly: true` to get only the count.\n- Use `withDataMessage: true` to include alert data messages.\n- Service-specific filters require only one service in the filter.\n",
        "operationId": "fetchAlerts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertsFetchRequest"
              },
              "examples": {
                "basic_fetch": {
                  "summary": "Basic fetch",
                  "value": {
                    "companyUuid": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    "orderBy": [
                      {
                        "field": "created_at",
                        "order": "desc"
                      },
                      {
                        "field": "updated_at",
                        "order": "desc"
                      }
                    ],
                    "filters": {
                      "service": [
                        "darkweb_data_breaches",
                        "github"
                      ],
                      "created_at": {
                        "gte": "2025-06-01T18:30:00.000Z",
                        "lte": "2025-06-10T18:29:59.999Z"
                      },
                      "status": [
                        "UNREVIEWED"
                      ],
                      "user_severity": [
                        "LOW",
                        "MEDIUM",
                        "HIGH"
                      ]
                    },
                    "excludes": {
                      "status": [
                        "FALSE_POSITIVE"
                      ]
                    },
                    "skip": 0,
                    "take": 10,
                    "countOnly": false,
                    "taggedAlert": false,
                    "withDataMessage": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fetch alerts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsFetchResponse"
                },
                "examples": {
                  "alerts_with_data": {
                    "summary": "Alerts with data",
                    "value": {
                      "data": {
                        "github": [
                          {
                            "id": "d4e5f6g7-h8i9-0123-defg-456789012345",
                            "service": "github",
                            "status": "UNREVIEWED",
                            "severity": "MEDIUM",
                            "user_severity": "HIGH",
                            "description": "test",
                            "created_at": "2025-06-01T10:30:00.000Z",
                            "updated_at": "2025-06-01T10:30:00.000Z",
                            "tags": [
                              "test"
                            ]
                          }
                        ]
                      },
                      "cached": false,
                      "success": true
                    }
                  },
                  "count_only": {
                    "summary": "Count only",
                    "value": {
                      "data": {
                        "count": 42
                      },
                      "cached": false,
                      "success": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g., max limit exceeded)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "statusCode": 400,
                    "message": "Bad request",
                    "errorName": "BadRequestException",
                    "path": "/api/v2/y/alerts",
                    "requestId": "req-12345",
                    "timestamp": "2025-06-01T10:30:00.000Z"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (insufficient permissions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "statusCode": 403,
                    "message": "Forbidden",
                    "errorName": "ForbiddenException",
                    "path": "/api/v2/y/alerts",
                    "requestId": "req-12345",
                    "timestamp": "2025-06-01T10:30:00.000Z"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Alerts"
        ],
        "summary": "Update alerts",
        "description": "Update status, user_severity, or assignee of alerts (max 100 at a time).",
        "operationId": "updateAlerts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertsUpdateRequest"
              },
              "example": {
                "alerts": [
                  {
                    "assignee_id": "b2c3d4e5-f6g7-8901-bcde-f23456789012",
                    "id": "b2c3d4e5-f6g7-8901-bcde-f23456789012",
                    "status": "INFORMATIONAL",
                    "user_severity": "LOW",
                    "service": "github"
                  },
                  {
                    "id": "c3d4e5f6-g7h8-9012-cdef-345678901234",
                    "status": "INFORMATIONAL",
                    "service": "darkweb_data_breaches"
                  }
                ],
                "companyUuid": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update Alerts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsUpdateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g., too many alerts)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (insufficient permissions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ar-apollo-v2/api/v2/y/alerts/filter/data": {
      "post": {
        "tags": [
          "Alerts"
        ],
        "summary": "Fetch available filter data",
        "description": "Retrieve available filter options for alerts.",
        "operationId": "fetchFilterData",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FilterDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filter data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ar-apollo-v2/api/v2/y/alerts/{alertId}/comments": {
      "post": {
        "tags": [
          "Alerts"
        ],
        "summary": "Add comment to alert",
        "description": "Add a comment to a specific alert.",
        "operationId": "addCommentToAlert",
        "parameters": [
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Alert UUID",
            "example": "d4e5f6g7-h8i9-0123-defg-456789012345"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddCommentRequest"
              },
              "example": {
                "comment": "This alert has been reviewed and marked as informational.",
                "companyUuid": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/engine/api/v1/y/breach-details/{s3Key}": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Get breach details by S3 key",
        "description": "Retrieve breach details using an S3 key.",
        "operationId": "getBreachDetails",
        "parameters": [
          {
            "name": "s3Key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "S3 key for the breach details",
            "example": "breaches/2025/06/breach-12345.json"
          }
        ],
        "responses": {
          "200": {
            "description": "Breach details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ar-apollo-v2/api/v2/y/services": {
      "get": {
        "tags": [
          "Alert Services"
        ],
        "summary": "Fetch allowed services for alerts",
        "description": "Retrieve available alert data sources (services).",
        "operationId": "fetchServices",
        "responses": {
          "200": {
            "description": "Services retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicesResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ar-apollo-v2/api/v2/y/companies": {
      "get": {
        "tags": [
          "Companies"
        ],
        "summary": "Fetch companies",
        "description": "Retrieve companies accessible to the user.",
        "operationId": "fetchCompanies",
        "responses": {
          "200": {
            "description": "Companies retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompaniesResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ar-apollo-v2/api/v2/y/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Fetch users",
        "description": "Retrieve users in a company.",
        "operationId": "fetchUsers",
        "parameters": [
          {
            "name": "companyUuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Company UUID",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
