          {
            "$ref": "#/components/parameters/PropertyId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveInPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Move-in submission created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveDocument"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure or archived branch",
            "content": {
