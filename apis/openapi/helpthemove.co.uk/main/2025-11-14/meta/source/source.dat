          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/moves/{moveId}": {
      "get": {
        "tags": [
          "Moves"
        ],
        "summary": "Retrieve a move by numeric id or `their_id`",
        "parameters": [
          {
            "$ref": "#/components/parameters/MoveId"
          }
        ],
        "responses": {
          "200": {
            "description": "Move payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Moves"
        ],
        "summary": "Cancel a move submission",
        "parameters": [
          {
            "$ref": "#/components/parameters/MoveId"
          }
        ],
        "responses": {
          "200": {
            "description": "Move cancelled; returns the final move payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveDocument"
                }
              }
            }
          },
          "422": {
            "description": "Unable to cancel the submission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/moves/{moveId}/meter_reads": {
      "get": {
        "tags": [
          "MeterReads"
        ],
        "summary": "Fetch captured meter readings for a move",
        "parameters": [
          {
            "$ref": "#/components/parameters/MoveId"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter readings document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterReadsDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "MeterReads"
        ],
        "summary": "Update meter readings for a move",
        "parameters": [
          {
            "$ref": "#/components/parameters/MoveId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeterReadsUpdatePayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Meter readings updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterReadsDocument"
                }
              }
            }
          },
          "400": {
            "description": "Business rule violation (e.g. move cancelled, switch date too old)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
