{
  "openapi": "3.0.3",
  "info": {
    "title": "Help The Move Partner API",
    "version": "2025-11-14",
    "description": "Programmatic interface for agencies that manage branches, landlords, properties,\nand tenant moves inside Help The Move. All endpoints follow JSON:API-inspired\nconventions and require a partner API token passed via the `Authorization: Bearer`\nheader. The same contract is deployed to every white-label host listed in the\n`servers` section so that integrators can promote the exact same request bodies\nacross production, clone, and staging environments.\n",
    "contact": {
      "name": "Help The Move Engineering",
      "email": "api@helpthemove.co.uk"
    },
    "termsOfService": "https://helpthemove.co.uk/terms",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/helpthemove/help-the-move-partner-api/2025-11-14"
  },
  "servers": [
    {
      "url": "https://api.helpthemove.co.uk",
      "description": "Production - Direct"
    },
    {
      "url": "https://api-canopy.helpthemove.co.uk",
      "description": "Production \u2013 Canopy"
    },
    {
      "url": "https://api-homelet.helpthemove.co.uk",
      "description": "Production \u2013 HomeLet"
    },
    {
      "url": "https://api-letalliance.helpthemove.co.uk",
      "description": "Production \u2013 Let Alliance"
    },
    {
      "url": "https://api-ovo.helpthemove.co.uk",
      "description": "Production \u2013 OVO"
    },
    {
      "url": "https://api-rentshield.helpthemove.co.uk",
      "description": "Production \u2013 Rentshield"
    },
    {
      "url": "https://api-vouch.helpthemove.co.uk",
      "description": "Production \u2013 Vouch"
    },
    {
      "url": "https://api-clone.helpthemove.co.uk",
      "description": "Clone \u2013 multi-partner sandbox"
    },
    {
      "url": "https://api-canopy-clone.helpthemove.co.uk",
      "description": "Clone \u2013 Canopy"
    },
    {
      "url": "https://api-homelet-clone.helpthemove.co.uk",
      "description": "Clone \u2013 HomeLet"
    },
    {
      "url": "https://api-letalliance-clone.helpthemove.co.uk",
      "description": "Clone \u2013 Let Alliance"
    },
    {
      "url": "https://api-rentshield-clone.helpthemove.co.uk",
      "description": "Clone \u2013 Rentshield"
    },
    {
      "url": "https://api-vouch-clone.helpthemove.co.uk",
      "description": "Clone \u2013 Vouch"
    },
    {
      "url": "https://api-staging.helpthemove.co.uk",
      "description": "Staging"
    }
  ],
  "security": [
    {
      "PartnerToken": []
    }
  ],
  "tags": [
    {
      "name": "Branches",
      "description": "Manage partner branches and their scoped collections"
    },
    {
      "name": "Landlords",
      "description": "Search, create, and update landlords"
    },
    {
      "name": "Properties",
      "description": "Manage properties, address data, and scoped moves"
    },
    {
      "name": "Moves",
      "description": "Create move-in/out submissions and cancel moves"
    },
    {
      "name": "MeterReads",
      "description": "Retrieve and update meter readings for a submission"
    }
  ],
  "paths": {
    "/partner/branches": {
      "get": {
        "tags": [
          "Branches"
        ],
        "summary": "Search branches available to the authenticated partner",
        "description": "Returns a paginated search document containing branches that belong to the\nauthenticated organisation (or the filtered set exposed to Vision+ tokens).\nIf `query` is supplied it is matched against `name`, `uuid`, and `their_id`.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/QueryParam"
          },
          {
            "$ref": "#/components/parameters/TheirIdParam"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Branch search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchSearchDocument"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Branches"
        ],
        "summary": "Create a branch on behalf of the authenticated organisation",
        "description": "Requires that the API token belongs to a user that is mapped to an organisation. Validation errors are returned when required branch profile attributes are missing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BranchCreatePayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Branch created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchDocument"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/branches/{branchId}": {
      "get": {
        "tags": [
          "Branches"
        ],
        "summary": "Retrieve a single branch by numeric id or UUID",
        "parameters": [
          {
            "$ref": "#/components/parameters/BranchId"
          }
        ],
        "responses": {
          "200": {
            "description": "Branch payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/branches/{branchId}/meter_reads_required": {
      "get": {
        "tags": [
          "Branches"
        ],
        "summary": "List moves for the branch that still need meter readings",
        "parameters": [
          {
            "$ref": "#/components/parameters/BranchId"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of move summaries missing meter reads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterReadsRequiredList"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/branches/{branchId}/landlords": {
      "get": {
        "tags": [
          "Landlords"
        ],
        "summary": "Search landlords belonging to a branch",
        "parameters": [
          {
            "$ref": "#/components/parameters/BranchId"
          },
          {
            "$ref": "#/components/parameters/QueryParam"
          },
          {
            "$ref": "#/components/parameters/TheirIdParam"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Landlord search results scoped to the branch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandlordSearchDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Landlords"
        ],
        "summary": "Create a landlord under a branch",
        "parameters": [
          {
            "$ref": "#/components/parameters/BranchId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LandlordCreatePayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Landlord created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandlordDocument"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/branches/{branchId}/landlords/{landlordId}": {
      "get": {
        "tags": [
          "Landlords"
        ],
        "summary": "Retrieve a landlord through its parent branch",
        "parameters": [
          {
            "$ref": "#/components/parameters/BranchId"
          },
          {
            "$ref": "#/components/parameters/LandlordId"
          }
        ],
        "responses": {
          "200": {
            "description": "Landlord payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandlordDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/branches/{branchId}/properties": {
      "get": {
        "tags": [
          "Properties"
        ],
        "summary": "Search properties belonging to a branch",
        "parameters": [
          {
            "$ref": "#/components/parameters/BranchId"
          },
          {
            "$ref": "#/components/parameters/QueryParam"
          },
          {
            "$ref": "#/components/parameters/TheirIdParam"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Property search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchPropertySearchDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/branches/{branchId}/properties/{propertyId}": {
      "get": {
        "tags": [
          "Properties"
        ],
        "summary": "Retrieve a single property via its branch",
        "parameters": [
          {
            "$ref": "#/components/parameters/BranchId"
          },
          {
            "$ref": "#/components/parameters/PropertyId"
          }
        ],
        "responses": {
          "200": {
            "description": "Property payload with branch-specific links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/landlords": {
      "get": {
        "tags": [
          "Landlords"
        ],
        "summary": "Search landlords across all permitted branches",
        "parameters": [
          {
            "name": "first_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "$ref": "#/components/parameters/TheirIdParam"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Landlord search document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandlordSearchDocument"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/landlords/{landlordId}": {
      "get": {
        "tags": [
          "Landlords"
        ],
        "summary": "Retrieve a landlord by id or `their_id`",
        "parameters": [
          {
            "$ref": "#/components/parameters/LandlordId"
          }
        ],
        "responses": {
          "200": {
            "description": "Landlord payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandlordDocument"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "patch": {
        "tags": [
          "Landlords"
        ],
        "summary": "Update landlord profile data",
        "parameters": [
          {
            "$ref": "#/components/parameters/LandlordId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LandlordUpdatePayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Landlord updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandlordDocument"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/landlords/{landlordId}/properties": {
      "post": {
        "tags": [
          "Properties"
        ],
        "summary": "Create a property under a landlord",
        "parameters": [
          {
            "$ref": "#/components/parameters/LandlordId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertyCreatePayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Property created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyDocument"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure or duplicate detection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/properties": {
      "get": {
        "tags": [
          "Properties"
        ],
        "summary": "Search properties across all accessible branches",
        "parameters": [
          {
            "$ref": "#/components/parameters/QueryParam"
          },
          {
            "$ref": "#/components/parameters/TheirIdParam"
          },
          {
            "name": "address1",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "post_code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mpan",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mprn",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Property search document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertySearchDocument"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/partner/properties/{propertyId}": {
      "get": {
        "tags": [
          "Properties"
        ],
        "summary": "Retrieve a property by id or `their_id`",
