      }
    },
    "/partner/properties/{propertyId}/move_outs": {
      "post": {
        "tags": [
          "Moves"
        ],
        "summary": "Create a move-out submission for a property",
        "parameters": [
          {
            "$ref": "#/components/parameters/PropertyId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveOutPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Move-out submission created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoveDocument"
                }
              }
            }
