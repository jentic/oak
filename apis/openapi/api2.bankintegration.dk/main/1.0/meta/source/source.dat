            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a single country",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryResponse"
                },
                "example": {
                  "country": [
                    {
                      "countryId": "DK",
                      "name": "DANMARK",
                      "currencyId": "DKK",
                      "isEU": true,
                      "isSEPAenabled": true
                    }
                  ],
                  "requestId": "1234"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          }
        }
      }
    },
    "/currencies": {
      "get": {
