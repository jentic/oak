{
  "openapi": "3.0.1",
  "info": {
    "title": "BankIntegration Erp API",
    "description": "The BankIntegration ERP API makes it possible for ERP customers to administer their own customers in the BankIntegration system",
    "version": "1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/INFO_672/generel-erp-api/1.0"
  },
  "servers": [
    {
      "url": "https://api2.bankintegration.dk/erp"
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "tags": [
          "Utility"
        ],
        "summary": "A simple ping",
        "description": "Pings the service. Will always return a standard response.",
        "operationId": "ping",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Will be returned in response.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All requets will return 200"
          }
        }
      }
    },
    "/bankcentrals": {
      "get": {
        "tags": [
          "Banks"
        ],
        "summary": "Get bank centrals",
        "operationId": "get-bankcentrals",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Will be returned in response.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of available bank centrals",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankCentralsResponse"
                },
                "example": {
                  "bankCentrals": [
                    {
                      "id": "string",
                      "name": "string",
                      "countryId": "string"
                    }
                  ],
                  "requestId": "string",
                  "created": "string"
                }
              }
            }
          },
          "400": {
            "description": "Some error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          }
        }
      }
    },
    "/banks": {
      "get": {
        "tags": [
          "Banks"
        ],
        "summary": "Get banks",
        "description": "Gets a list of available banks",
        "operationId": "get-banks",
        "parameters": [
          {
            "name": "centralId",
            "in": "query",
            "description": "Id of bank central",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "countryId",
            "in": "query",
            "description": "Country code of bank. Defaults to \"DK\"",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Id will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bank is found and information returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanksResponse"
                },
                "example": {
                  "banks": [
                    {
                      "id": "DABADKKK",
                      "bic": "DABADKKK",
                      "name": "DANSKE BANK",
                      "centralId": "DBA",
                      "countryId": "DK"
                    }
                  ],
                  "requestId": "1234",
                  "created": "2024-09-26T10:04:46.0000000+00:00"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "404": {
            "description": "Bank not found"
          }
        }
      }
    },
    "/bank/{id}": {
      "get": {
        "tags": [
          "Banks"
        ],
        "summary": "Get bank",
        "description": "Get bank information",
        "operationId": "get-bank",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The BIC/Swift code of bank to get information for",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bank is found and information returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanksResponse"
                },
                "example": {
                  "banks": [
                    {
                      "id": "DABADKKK",
                      "bic": "DABADKKK",
                      "name": "DANSKE BANK",
                      "centralId": "DBA",
                      "countryId": "DK"
                    }
                  ],
                  "requestId": "1234",
                  "created": "2024-09-26T10:04:46.0000000+00:00"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "404": {
            "description": "Bank is not found"
          }
        }
      }
    },
    "/countries": {
      "get": {
        "tags": [
          "Countries"
        ],
        "summary": "Get countries",
        "operationId": "get-countries",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of countries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountriesResponse"
                },
                "example": {
                  "countries": [
                    {
                      "countryId": "DK",
                      "name": "DANMARK",
                      "currencyId": "DKK",
                      "isEU": true,
                      "isSEPAenabled": true
                    }
                  ],
                  "requestId": "1234"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          }
        }
      }
    },
    "/country/{id}": {
      "get": {
        "tags": [
          "Countries"
        ],
        "summary": "Get country",
        "operationId": "get-country",
