            "name": "requestId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the currency (\"e.g. \"DKK\", \"NOK\"\")",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of countries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrenciesResponse"
                },
                "example": {
                  "currencies": [
                    {
                      "currencyId": "DKK",
                      "name": "Dansk Krone"
                    }
                  ],
                  "requestId": "1234"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get users",
        "description": "Gets a list of users",
        "operationId": "get-users",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Id will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users are found and information returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersResponse"
                },
                "example": {
                  "users": [
                    {
                      "userId": "test@gmail.com",
                      "cvr": "12457889"
                    }
                  ],
                  "requestId": "1234",
                  "created": "2017-07-04 10:39:16"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "404": {
            "description": "Users not found"
          }
        }
      }
    },
    "/user": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create user",
        "description": "Creates a user",
        "operationId": "create-user",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Id will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "user": {
                    "cvr": "12345678",
                    "userId": "ph@lamper.dk",
                    "email": "ph@lamper.dk",
                    "displayName": "Poul Henningsen",
                    "lastLogin": "2026-01-12 19:20:26"
                  },
                  "requestId": "1234",
                  "created": "2017-07-04 10:39:16"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "409": {
            "description": "User already exists"
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user",
        "description": "Get user information",
        "operationId": "get-user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of user to get information for",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User is found and information returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "user": {
                    "userId": "ph@lamper.dk",
                    "companyId": "12345678",
                    "displayName": "Poul Henningsen",
                    "email": "ph@lamper.dk",
                    "phone": "22556644",
                    "lastLogin": "2026-01-12 19:20:26"
                  },
                  "requestId": "1234",
                  "created": "2017-07-04 10:39:16"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "404": {
            "description": "User is not found"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Change user",
        "description": "Change user information",
        "operationId": "put-user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of user to change",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User is changed and information returned"
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "404": {
            "description": "User is not found"
          }
        }
      }
    },
    "/company": {
      "post": {
        "tags": [
          "Companies"
        ],
        "summary": "Create companies",
        "description": "Creates a company. CVR is the id",
        "operationId": "create-company",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "description": "User to associate the company with",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requestId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCompanyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Company created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                },
                "example": {
                  "company": {
                    "cvr": "12345678",
                    "name": "BankIntegration ApS",
                    "email": "test@gmail.com",
                    "address": "Lykkeg\u00e5rdsvej 54",
                    "postalCode": "9210",
                    "city": "Aalborg S\u00d8",
                    "countryId": "DK",
                    "phone": "12345678"
                  },
                  "requestId": "1234"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "409": {
            "description": "Company already exists"
          }
        }
      }
    },
    "/company/{id}/updateFromCvr": {
      "post": {
        "tags": [
          "Companies"
        ],
        "summary": "Refresh company data from CVR",
