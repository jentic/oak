              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Company refreshed from CVR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "401": {
            "description": "Oauth Client ID or Secret invalid"
          },
          "404": {
            "description": "Company not found"
          }
        }
      }
    },
    "/companies": {
      "get": {
        "tags": [
          "Companies"
        ],
        "summary": "Get companies",
        "operationId": "get-companies",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Filter companies for a specific user",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Companies visible to calling ERP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompaniesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/company/{id}": {
      "get": {
