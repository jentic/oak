    "/agreements": {
      "get": {
        "tags": [
          "Agreements"
        ],
        "summary": "Get agreements",
        "description": "Returns agreements visible to the ERP.\nTwo agreement types exist: - WebService/BankConnect: does not expire (expires is null) - OpenBanking: expires after 90 days\n",
        "operationId": "get-agreements",
        "parameters": [
          {
            "name": "companyId",
            "in": "query",
            "description": "Filter by cvr.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by agreement type.",
            "schema": {
              "type": "string",
              "enum": [
                "WebService",
                "OpenBanking"
              ]
            }
          },
          {
            "name": "userId",
            "in": "query",
            "description": "Filter by userId",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "description": "Filter by active status.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Id will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreements are found and information returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgreementsResponse"
                },
                "example": {
                  "agreements": [
                    {
                      "agreementId": "1388",
                      "companyId": "231",
                      "type": "OpenBanking"
                    }
                  ],
                  "requestId": "1234",
                  "created": "2016-01-01T00:00:00Z"
                }
              }
            }
          },
          "400": {
            "description": "An error occurred"
          },
          "401": {
            "description": "OAuth Client ID or Secret invalid"
          },
          "404": {
            "description": "Agreements not found (or not visible within ERP scope)"
          }
        }
      },
      "post": {
        "tags": [
          "Agreements"
        ],
        "summary": "Create agreement",
        "description": "Creates an agreement.\nTwo agreement types exist: - WebService/BankConnect: does not expire - OpenBanking: expires after 90 days\n",
        "operationId": "create-agreement",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "description": "Your id of request. Id will be returned in answer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgreementRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agreement created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgreementResponse"
                },
                "example": {
                  "agreement": {
                    "id": 4,
                    "companyId": 3,
                    "bankId": 194,
                    "agreementKind": "WebService",
                    "name": "BankIntegration",
                    "customerId": "36217856847839984432",
