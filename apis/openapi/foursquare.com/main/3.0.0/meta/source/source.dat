{
  "openapi": "3.0.3",
  "info": {
    "title": "Foursquare Places API",
    "description": "Foursquare Places API v3 provides access to 200+ million places worldwide. Search for restaurants, attractions, hotels, and more with ratings, photos, tips, and real-time open status. Free tier: 100K calls/month.",
    "version": "3.0.0",
    "contact": {
      "name": "Foursquare",
      "url": "https://foursquare.com"
    },
    "x-jentic-source-url": "https://docs.foursquare.com/developer/reference/place-search"
  },
  "servers": [
    {
      "url": "https://api.foursquare.com/v3",
      "description": "Foursquare Places API v3"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/places/search": {
      "get": {
        "operationId": "searchPlaces",
        "summary": "Search places",
        "description": "Search for places by query text, location, categories, price, and open status. Returns matching places with details.",
        "parameters": [
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Free-text search (name, category, phone, taste, tips)." },
          { "name": "ll", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Latitude,longitude for center of search (e.g. 41.8781,-87.6298)." },
          { "name": "radius", "in": "query", "required": false, "schema": { "type": "integer", "maximum": 100000 }, "description": "Search radius in meters (max 100000, default 22000). Requires ll." },
          { "name": "near", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Geocodable locality (e.g. Chicago, IL). Alternative to ll." },
          { "name": "ne", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Northeast corner lat,lng for bounding box search." },
          { "name": "sw", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Southwest corner lat,lng for bounding box search." },
          { "name": "categories", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated Foursquare category IDs." },
          { "name": "chains", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated Foursquare chain IDs." },
          { "name": "exclude_all_chains", "in": "query", "required": false, "schema": { "type": "boolean" }, "description": "Exclude all chain/franchise places." },
          { "name": "fields", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated response fields to include." },
          { "name": "min_price", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 4 }, "description": "Minimum price level (1-4)." },
          { "name": "max_price", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 4 }, "description": "Maximum price level (1-4)." },
          { "name": "open_now", "in": "query", "required": false, "schema": { "type": "boolean" }, "description": "Only return places that are currently open." },
          { "name": "open_at", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Only return places open at specified time (format: DOWTHHMM, e.g. 1T2130)." },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["relevance", "rating", "distance", "popularity"] }, "description": "Sort order for results." },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "maximum": 50, "default": 10 }, "description": "Maximum results (up to 50, default 10)." },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Pagination cursor from previous response." }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaceSearchResponse" } } }
          },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/places/{fsq_id}": {
      "get": {
        "operationId": "getPlaceDetails",
        "summary": "Get place details",
        "description": "Get detailed information about a specific place by its Foursquare ID.",
        "parameters": [
          { "name": "fsq_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Foursquare place ID." },
          { "name": "fields", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated fields to include." }
        ],
        "responses": {
          "200": { "description": "Place details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Place" } } } },
          "404": { "description": "Place not found" }
        }
      }
    },
    "/places/{fsq_id}/photos": {
      "get": {
        "operationId": "getPlacePhotos",
        "summary": "Get place photos",
        "description": "Get photos for a specific place.",
        "parameters": [
          { "name": "fsq_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Foursquare place ID." },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Maximum photos to return." },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["popular", "newest"] }, "description": "Sort order." },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Pagination offset." }
        ],
        "responses": {
          "200": { "description": "Place photos", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Photo" } } } } }
        }
      }
    },
    "/places/{fsq_id}/tips": {
      "get": {
        "operationId": "getPlaceTips",
        "summary": "Get place tips and reviews",
        "description": "Get user tips and reviews for a specific place.",
        "parameters": [
          { "name": "fsq_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Foursquare place ID." },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Maximum tips to return." },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["popular", "newest"] }, "description": "Sort order." },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Pagination offset." }
        ],
        "responses": {
          "200": { "description": "Place tips", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Tip" } } } } }
        }
      }
    },
    "/places/nearby": {
      "get": {
        "operationId": "getNearbyPlaces",
        "summary": "Get nearby places",
        "description": "Find places near a specific location.",
        "parameters": [
          { "name": "ll", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Latitude,longitude (required)." },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Maximum results." },
          { "name": "fields", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated fields to include." }
        ],
        "responses": {
          "200": { "description": "Nearby places", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaceSearchResponse" } } } }
        }
      }
    },
    "/autocomplete": {
      "get": {
        "operationId": "autocomplete",
        "summary": "Autocomplete places",
        "description": "Get place, search, and geographic autocomplete suggestions as the user types.",
        "parameters": [
          { "name": "query", "in": "query", "required": true, "schema": { "type": "string", "minLength": 3 }, "description": "Search text (minimum 3 characters)." },
          { "name": "ll", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Lat,lng for geographic bias." },
          { "name": "radius", "in": "query", "required": false, "schema": { "type": "integer", "default": 5000 }, "description": "Bias radius in meters." },
          { "name": "types", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated result types: place, search, geo." },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "maximum": 50, "default": 10 }, "description": "Maximum suggestions." }
        ],
        "responses": {
          "200": { "description": "Autocomplete suggestions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutocompleteResponse" } } } }
        }
      }
    },
    "/places/categories": {
      "get": {
        "operationId": "getCategories",
        "summary": "Get place categories",
        "description": "Returns the full hierarchical tree of Foursquare place categories.",
        "responses": {
          "200": {
            "description": "Category tree",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "categories": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Foursquare API key (starts with fsq3...). Pass directly as the Authorization header value."
      }
    },
    "schemas": {
      "PlaceSearchResponse": {
        "type": "object",
        "properties": {
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Place" } },
          "context": { "type": "object", "properties": { "geo_bounds": { "type": "object" } } },
          "cursor": { "type": "string", "description": "Pagination cursor for next page." }
        }
      },
      "Place": {
        "type": "object",
        "properties": {
          "fsq_id": { "type": "string", "description": "Unique Foursquare place ID." },
          "name": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "distance": { "type": "integer", "description": "Distance from search point in meters." },
          "categories": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } },
          "location": {
            "type": "object",
            "properties": {
              "address": { "type": "string" },
              "locality": { "type": "string" },
              "region": { "type": "string" },
              "postcode": { "type": "string" },
              "country": { "type": "string" },
              "formatted_address": { "type": "string" }
            }
          },
          "geocodes": { "type": "object", "properties": { "main": { "type": "object", "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" } } } } },
          "hours": { "type": "object", "properties": { "display": { "type": "string" }, "open_now": { "type": "boolean" } } },
          "rating": { "type": "number", "description": "Rating from 1.0 to 10.0." },
          "price": { "type": "integer", "description": "Price level 1-4." },
          "popularity": { "type": "number", "description": "Popularity score 0.0 to 1.0." },
          "description": { "type": "string" },
          "tel": { "type": "string" },
          "website": { "type": "string", "format": "uri" },
          "tastes": { "type": "array", "items": { "type": "string" } },
          "stats": { "type": "object", "properties": { "total_photos": { "type": "integer" }, "total_ratings": { "type": "integer" }, "total_tips": { "type": "integer" } } },
          "photos": { "type": "array", "items": { "$ref": "#/components/schemas/Photo" } },
          "tips": { "type": "array", "items": { "$ref": "#/components/schemas/Tip" } }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "icon": { "type": "object", "properties": { "prefix": { "type": "string" }, "suffix": { "type": "string" } } },
          "categories": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
        }
      },
      "Photo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "prefix": { "type": "string", "description": "URL prefix for constructing photo URL." },
          "suffix": { "type": "string", "description": "File extension suffix." },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      },
      "Tip": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "text": { "type": "string" },
          "lang": { "type": "string" },
          "agree_count": { "type": "integer" },
          "disagree_count": { "type": "integer" }
        }
      },
      "AutocompleteResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["place", "search", "geo"] },
                "text": { "type": "object", "properties": { "primary": { "type": "string" }, "secondary": { "type": "string" } } },
                "place": { "$ref": "#/components/schemas/Place" }
              }
            }
          }
        }
      }
    }
  }
}
