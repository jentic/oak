    },
    "/hris/timeoff": {
      "get": { "operationId": "listTimeOff", "summary": "List time off", "tags": ["Time Off"], "parameters": [{ "name": "connection_id", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Successful response" }, "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } } }
