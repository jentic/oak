{
  "openapi": "3.0.3",
  "info": {
    "title": "Unified HRIS API",
    "version": "1.0.0",
    "description": "The Unified.to HRIS API provides a unified interface for accessing HR data across multiple HRIS platforms. It supports CRUD operations for employees, companies, groups, locations, time off, payslips, devices, and more.",
    "x-jentic-source-url": "https://unified.to/hris"
  },
  "servers": [{ "url": "https://api.unified.to" }],
