                    "type": "string",
                    "description": "Truck driver ID. If this parameter is present, truck_driver_number and truck_driver_license will be ignored."
                  },
                  "truck_driver_number": {
                    "type": "string",
                    "description": "Truck driver number. If truck_driver_id is present, this will be ignored."
                  },
                  "truck_driver_license": {
                    "type": "string",
                    "description": "Truck driver license number. If truck_driver_id or truck_driver_number is present, this will be ignored."
                  },
                  "truck": {
                    "type": "string",
                    "description": "Truck license plate number."
