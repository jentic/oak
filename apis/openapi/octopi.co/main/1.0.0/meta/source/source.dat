    "/invoices.json": {
      "get": {
        "tags": [
          "invoices"
        ],
        "summary": "Gets a list of invoices",
        "description": "This API endpoint allows you to access these invoices. To fetch invoices, it is mandatory to pass in two query parameters:\n* a __customer_type__ which can be either __Consignee__, __ShippingLine__ or __Agent__\n* a __customer_general_ledger_id__ which is a String and represents the General Ledger ID stored in Octopi (and the accounting system) for that Shipping Line or Consignee.\n\nIn addition, you can also pass in a parameter called 'created_during' to filter and only have access to specific invoices for that customer.\n\nIn Octopi, some invoices are generated automatically by the software (triggered by an event such as a gate out for example) or generated manually by a user (by clicking on a button to generate the invoice).\nWhen created automatically, the __creation_method__ returned by this API will be __AUTO__. For invoices generated manually by a user, __creation_method__ is set to __MANUAL__.\n\nFor Bill of Lading pro-formas, it is possible for a pro-forma to be created for all the containers in the Bill Of Lading or for only some of the containers in the Bill Of Lading.\nTo find out which containers were billed for in that pro-forma, there are two arrays called __bl_container_ids__ and __bl_container_numbers__ that return respectively an array of IDs and an array of container numbers for the containers that were billed in this pro-forma.\n\n",
        "operationId": "get_invoices.json",
        "parameters": [
          {
            "name": "line_items_q",
            "in": "query",
            "description": "line_items_q stands for line item query. It allows you to search invoices by line items description.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customer_type",
            "in": "query",
            "description": "The type of customer.",
            "schema": {
              "type": "string",
              "enum": [
                "ShippingLine",
                "Consignee",
                "Agent"
              ]
            }
          },
          {
            "name": "customer_general_ledger_id",
            "in": "query",
            "description": "The General Ledger ID for the customer. You must include a customer_type if you include a customer_general_ledger_id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_during",
            "in": "query",
            "description": "Filter invoices based on when they were created. Can be one of 'payment', 'gate_out', 'gate_in', 'tally', etc...",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "movement_id",
            "in": "query",
            "description": "Filter invoices by movement id.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "creation_method",
            "in": "query",
            "description": "Filter invoices by creation method. One of auto or manual.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "missing_general_ledger_id",
            "in": "query",
            "description": "Set to true to return all invoices that do not have a general ledger ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Filter invoices by currency",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bill_of_lading_number",
            "in": "query",
            "description": "Filter invoices by Bill of Lading Number",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bill_of_lading_id",
            "in": "query",
            "description": "Filter invoices by Bill of Lading ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tariff_id",
            "in": "query",
            "description": "Filter invoices by tariff",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "container_id",
            "in": "query",
            "description": "Filter invoices by container/cargo ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "container_number",
            "in": "query",
            "description": "Filter invoices by container number",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "voyage_id",
            "in": "query",
            "description": "Filter invoices by voyage ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "voyage_number",
            "in": "query",
            "description": "Filter invoices by voyage number",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "truck_visit_id",
            "in": "query",
            "description": "Filter invoices by truck visit ID",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "paid",
            "in": "query",
            "description": "Filter for paid invoices by setting to true. Or set to false to get all unpaid invoices. If absent, Octopi will return both paid and unpaid invoices.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "is_proforma",
            "in": "query",
            "description": "Filter for proforma invoices by setting to true. Or set to false to return all invoices that are not proformas. If absent, Octopi will return all invoices: proforma or not.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "approved",
            "in": "query",
            "description": "Filter for approved invoices by setting to true. Or set to false to get all not approved invoices. If absent, Octopi will return both approved and not approved invoices.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "general_ledger_id",
            "in": "query",
            "description": "Filter invoices by invoice general ledger ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "total",
            "in": "query",
            "description": "Filter invoices by total amount (matched after rounding to 2 decimal places).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Specify which page of results to fetch. This value defaults to 1.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "per",
            "in": "query",
            "description": "The number of items to be displayed. This value defaults to 10 and accepts a maximum of 100.",
            "schema": {
              "type": "number"
            }
