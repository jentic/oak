      "post": {
        "tags": [
          "truck_visits-interchanges"
        ],
        "summary": "Create an interchange for a truck visit.",
        "description": "    Create an interchange for a truck visit.\n\n    Note: Some parameters have conditional requirements based on organization settings:\n    - The 'usage' parameter is required for depot terminal organizations when container_status is 'full'\n    - The 'export_release_number' parameter is required for empty containers when the organization requires export releases\n",
        "operationId": "post_truck_visits_truck_visit_id_interchanges.json",
        "parameters": [
          {
            "name": "truck_visit_id",
            "in": "path",
            "description": "Truck visit ID.",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "purpose"
                ],
                "type": "object",
                "properties": {
                  "purpose": {
                    "type": "string",
                    "description": "Purpose of the interchange.",
                    "enum": [
                      "drop_off_container",
                      "pick_up_container",
                      "drop_off_chassis",
                      "pick_up_chassis",
                      "drop_off_genset",
                      "pick_up_genset"
                    ]
                  },
                  "container_number": {
                    "type": "string",
                    "description": "Container number to create interchange."
                  },
                  "container_status": {
                    "type": "string",
                    "description": "Container status.",
                    "enum": [
                      "full",
                      "empty"
                    ]
                  },
                  "usage": {
                    "type": "string",
                    "description": "Container usage type. Required for depot terminal organizations when container_status is 'full'.",
                    "enum": [
                      "import",
                      "export",
                      "unknown"
                    ]
                  },
                  "booking_number": {
                    "type": "string",
                    "description": "Booking number for the interchange."
                  },
                  "container_type_label": {
                    "type": "string",
                    "description": "Container type label."
                  },
                  "chassis_number": {
                    "type": "string",
                    "description": "Chassis number."
                  },
                  "genset_number": {
                    "type": "string",
                    "description": "Genset number."
                  },
                  "export_release_number": {
                    "type": "string",
                    "description": "Export release number for the interchange. Required for empty containers when organization requires export releases."
                  },
                  "bill_of_lading_number": {
                    "type": "string",
                    "description": "Bill of lading number for the interchange."
                  },
                  "delivery_order_number": {
                    "type": "string",
                    "description": "Delivery order number for the interchange."
                  },
                  "completed_at": {
                    "type": "string",
                    "description": "The date and time at which interchange was completed, in ISO 8601 format (Eg 2023-04-13T14:30:00Z). Providing this value will create the interchange with a completed status."
                  },
                  "temperature_letter_port_of_discharge": {
                    "type": "string",
                    "description": "Temperature letter port of discharge (eg. \"HTPAP\")"
                  },
                  "temperature_letter_vgm": {
                    "type": "number",
                    "description": "Temperature letter VGM in your organization's weight unit preference (eg. 2345.0)"
                  },
                  "flex_attributes": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Hash of flex field values for the container. Keys are flex field names, values are the field values."
                  }
                },
                "additionalProperties": false
              }
            }
          },
