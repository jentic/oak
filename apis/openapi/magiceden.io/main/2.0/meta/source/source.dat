{
  "openapi": "3.0.3",
  "info": {
    "title": "Magic Eden API",
    "version": "2.0",
    "description": "Magic Eden is the leading NFT marketplace. This API provides endpoints for listing, buying, and querying NFT collections, tokens, and activities across multiple blockchains.",
    "contact": {
      "url": "https://magiceden.io"
    },
    "x-jentic-source-url": "https://docs.magiceden.io/reference"
  },
  "servers": [
    {
      "url": "https://api-mainnet.magiceden.dev/v2",
      "description": "Magic Eden Mainnet API"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Magic Eden API Key"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/collections": {
      "get": {
        "summary": "Get Collections",
        "operationId": "getCollections",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of collections",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "symbol": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "image": {
                        "type": "string"
                      },
                      "floorPrice": {
                        "type": "number"
                      },
                      "volumeAll": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/collections/{symbol}": {
      "get": {
        "summary": "Get Collection by Symbol",
        "operationId": "getCollection",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collection details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "floorPrice": {
                      "type": "number"
                    },
                    "listedCount": {
                      "type": "integer"
                    },
                    "volumeAll": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/collections/{symbol}/listings": {
      "get": {
        "summary": "Get Listings by Collection",
        "operationId": "getListingsByCollection",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pdaAddress": {
                        "type": "string"
                      },
                      "auctionHouse": {
                        "type": "string"
                      },
                      "tokenAddress": {
                        "type": "string"
                      },
                      "tokenMint": {
                        "type": "string"
                      },
                      "seller": {
                        "type": "string"
                      },
                      "tokenSize": {
                        "type": "integer"
                      },
                      "price": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/collections/{symbol}/activities": {
      "get": {
        "summary": "Get Activities by Collection",
        "operationId": "getActivitiesByCollection",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "signature": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      },
                      "tokenMint": {
                        "type": "string"
                      },
                      "collectionSymbol": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "buyer": {
                        "type": "string"
                      },
                      "seller": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/collections/{symbol}/stats": {
      "get": {
        "summary": "Get Collection Stats",
        "operationId": "getCollectionStats",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collection statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "floorPrice": {
                      "type": "number"
                    },
                    "listedCount": {
                      "type": "integer"
                    },
                    "avgPrice24hr": {
                      "type": "number"
                    },
                    "volumeAll": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tokens/{token_mint}": {
      "get": {
        "summary": "Get Token by Mint Address",
        "operationId": "getToken",
        "parameters": [
          {
            "name": "token_mint",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mintAddress": {
                      "type": "string"
                    },
                    "owner": {
                      "type": "string"
                    },
                    "supply": {
                      "type": "integer"
                    },
                    "collection": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tokens/{token_mint}/listings": {
      "get": {
        "summary": "Get Token Listings",
        "operationId": "getTokenListings",
        "parameters": [
          {
            "name": "token_mint",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token listings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pdaAddress": {
                        "type": "string"
                      },
                      "tokenMint": {
                        "type": "string"
                      },
                      "seller": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tokens/{token_mint}/activities": {
      "get": {
        "summary": "Get Token Activities",
        "operationId": "getTokenActivities",
        "parameters": [
          {
            "name": "token_mint",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "signature": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "buyer": {
                        "type": "string"
                      },
                      "seller": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/wallets/{wallet_address}/tokens": {
      "get": {
        "summary": "Get Tokens by Wallet",
        "operationId": "getTokensByWallet",
        "parameters": [
          {
            "name": "wallet_address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "collection_symbol",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "mintAddress": {
                        "type": "string"
                      },
                      "owner": {
                        "type": "string"
                      },
                      "collection": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "image": {
                        "type": "string"
                      },
                      "listStatus": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/wallets/{wallet_address}/activities": {
      "get": {
        "summary": "Get Activities by Wallet",
        "operationId": "getActivitiesByWallet",
        "parameters": [
          {
            "name": "wallet_address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "signature": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "tokenMint": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}