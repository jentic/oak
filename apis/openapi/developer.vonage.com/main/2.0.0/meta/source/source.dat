{
  "openapi": "3.0.3",
  "info": {
    "title": "Vonage Video API (formerly OpenTok/TokBox)",
    "description": "The Vonage Video API provides REST endpoints for managing video sessions, archives, broadcasts, live captions, SIP interconnect, Experience Composer, audio connectors, and account/project management. Formerly known as OpenTok/TokBox.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://tokbox.com/developer/rest/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.opentok.com",
      "description": "Vonage Video API (OpenTok) production server"
    }
  ],
  "security": [
    {
      "OpenTokJWT": []
    }
  ],
  "paths": {
    "/session/create": {
      "post": {
        "operationId": "createSession",
        "summary": "Create a new video session",
        "description": "Generates a new session. The session ID is returned and can be used with the server SDKs to generate tokens.",
        "tags": ["Sessions"],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "archiveMode": {
                    "type": "string",
                    "enum": ["manual", "always"],
                    "default": "manual"
                  },
                  "p2p.preference": {
                    "type": "string",
                    "enum": ["disabled", "enabled"],
                    "default": "disabled"
                  },
                  "location": {
                    "type": "string",
                    "description": "An IP address that the Vonage server will use to determine the best data center"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "session_id": { "type": "string" },
                      "project_id": { "type": "string" },
                      "create_dt": { "type": "string" },
                      "media_server_url": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "403": { "description": "Authentication failed" }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/signal": {
      "post": {
        "operationId": "sendSignalToAll",
        "summary": "Send signal to all clients in a session",
        "tags": ["Signaling"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Your OpenTok API key" },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "The session ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "data"],
                "properties": {
                  "type": { "type": "string", "maxLength": 128 },
                  "data": { "type": "string", "maxLength": 8192 }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Signal sent successfully" },
          "400": { "description": "Invalid signal payload" },
          "404": { "description": "Session not found" }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/connection/{connectionId}/signal": {
      "post": {
        "operationId": "sendSignalToClient",
        "summary": "Send signal to a specific client",
        "tags": ["Signaling"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "data"],
                "properties": {
                  "type": { "type": "string" },
                  "data": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Signal sent" },
          "404": { "description": "Session or connection not found" }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/connection/{connectionId}": {
      "delete": {
        "operationId": "disconnectClient",
        "summary": "Disconnect a client from a session",
        "tags": ["Connections"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Client disconnected" },
          "404": { "description": "Connection not found" }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/connection": {
      "get": {
        "operationId": "listConnections",
        "summary": "List connections in a session",
        "tags": ["Connections"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of connections",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "connectionId": { "type": "string" },
                          "data": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/stream/{streamId}": {
      "get": {
        "operationId": "getStreamInfo",
        "summary": "Get information about a stream",
        "tags": ["Streams"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "streamId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Stream information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stream" }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/stream/": {
      "get": {
        "operationId": "listStreams",
        "summary": "List all streams in a session",
        "tags": ["Streams"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of streams",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Stream" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/stream/{streamId}/mute": {
      "post": {
        "operationId": "muteStream",
        "summary": "Mute a stream's audio",
        "tags": ["Streams"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "streamId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Stream muted" },
          "404": { "description": "Stream not found" }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/mute": {
      "post": {
        "operationId": "muteSession",
        "summary": "Mute all streams in a session",
        "tags": ["Streams"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "active": { "type": "boolean", "description": "Whether to mute streams" },
                  "excludedStreamIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Stream IDs to exclude from muting"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Session muted" }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/migrate": {
      "post": {
        "operationId": "migrateSession",
        "summary": "Migrate session to a different server",
        "tags": ["Sessions"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Session migrated" },
          "409": { "description": "Session migration conflict" }
        }
      }
    },
    "/v2/project/{apiKey}/archive": {
      "post": {
        "operationId": "startArchive",
        "summary": "Start recording an archive",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId"],
                "properties": {
                  "sessionId": { "type": "string" },
                  "hasAudio": { "type": "boolean", "default": true },
                  "hasVideo": { "type": "boolean", "default": true },
                  "name": { "type": "string" },
                  "outputMode": { "type": "string", "enum": ["composed", "individual"] },
                  "resolution": { "type": "string", "enum": ["640x480", "1280x720", "1920x1080"] },
                  "streamMode": { "type": "string", "enum": ["auto", "manual"] },
                  "layout": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["bestFit", "custom", "horizontalPresentation", "verticalPresentation", "pip"] },
                      "stylesheet": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Archive started",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Archive" }
              }
            }
          },
          "404": { "description": "Session not found" },
          "409": { "description": "Archive already in progress" }
        }
      },
      "get": {
        "operationId": "listArchives",
        "summary": "List all archives for a project",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "maximum": 1000 } },
          { "name": "sessionId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of archives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Archive" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/archive/{archiveId}": {
      "get": {
        "operationId": "getArchive",
        "summary": "Get archive information",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "archiveId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Archive information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Archive" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteArchive",
        "summary": "Delete an archive",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "archiveId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Archive deleted" },
          "404": { "description": "Archive not found" }
        }
      }
    },
    "/v2/project/{apiKey}/archive/{archiveId}/stop": {
      "post": {
        "operationId": "stopArchive",
        "summary": "Stop recording an archive",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "archiveId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Archive stopped",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Archive" }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/archive/{archiveId}/layout": {
      "put": {
        "operationId": "updateArchiveLayout",
        "summary": "Change the layout of a composed archive",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "archiveId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "stylesheet": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Layout updated" }
        }
      }
    },
    "/v2/project/{apiKey}/archive/{archiveId}/streams": {
      "patch": {
        "operationId": "updateArchiveStreams",
        "summary": "Select streams for an archive",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "archiveId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "addStream": { "type": "string" },
                  "removeStream": { "type": "string" },
                  "hasAudio": { "type": "boolean" },
                  "hasVideo": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Archive streams updated" }
        }
      }
    },
    "/v2/project/{apiKey}/archive/storage": {
      "put": {
        "operationId": "setArchiveStorage",
        "summary": "Set archive storage upload target (S3/Azure)",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["s3", "azure"] },
                  "config": {
                    "type": "object",
                    "properties": {
                      "accessKey": { "type": "string" },
                      "secretKey": { "type": "string" },
                      "bucket": { "type": "string" },
                      "endpoint": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Storage target set" }
        }
      },
      "delete": {
        "operationId": "removeArchiveStorage",
        "summary": "Remove archive storage upload target",
        "tags": ["Archiving"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Storage target removed" }
        }
      }
    },
    "/v2/project/{apiKey}/broadcast": {
      "post": {
        "operationId": "startBroadcast",
        "summary": "Start a live streaming broadcast",
        "tags": ["Broadcasts"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId", "outputs"],
                "properties": {
                  "sessionId": { "type": "string" },
                  "layout": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string" },
                      "stylesheet": { "type": "string" }
                    }
                  },
                  "maxDuration": { "type": "integer", "maximum": 36000 },
                  "maxBitrate": { "type": "integer" },
                  "outputs": {
                    "type": "object",
                    "properties": {
                      "hls": { "type": "object" },
                      "rtmp": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string" },
                            "serverUrl": { "type": "string" },
                            "streamName": { "type": "string" }
                          }
                        }
                      }
                    }
                  },
                  "resolution": { "type": "string" },
                  "streamMode": { "type": "string", "enum": ["auto", "manual"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Broadcast started",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Broadcast" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listBroadcasts",
        "summary": "List all broadcasts for a project",
        "tags": ["Broadcasts"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "count", "in": "query", "schema": { "type": "integer" } },
          { "name": "sessionId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of broadcasts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Broadcast" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/broadcast/{broadcastId}": {
      "get": {
        "operationId": "getBroadcast",
        "summary": "Get broadcast information",
        "tags": ["Broadcasts"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "broadcastId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Broadcast information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Broadcast" }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/broadcast/{broadcastId}/stop": {
      "post": {
        "operationId": "stopBroadcast",
        "summary": "Stop a live streaming broadcast",
        "tags": ["Broadcasts"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "broadcastId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Broadcast stopped",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Broadcast" }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/broadcast/{broadcastId}/layout": {
      "put": {
        "operationId": "updateBroadcastLayout",
        "summary": "Change the layout of a broadcast",
        "tags": ["Broadcasts"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "broadcastId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "stylesheet": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Layout updated" }
        }
      }
    },
    "/v2/project/{apiKey}/broadcast/{broadcastId}/streams": {
      "patch": {
        "operationId": "updateBroadcastStreams",
        "summary": "Select streams for a broadcast",
        "tags": ["Broadcasts"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "broadcastId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "addStream": { "type": "string" },
                  "removeStream": { "type": "string" },
                  "hasAudio": { "type": "boolean" },
                  "hasVideo": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Broadcast streams updated" }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/stream": {
      "put": {
        "operationId": "setStreamLayoutClasses",
        "summary": "Set layout classes for streams in a session",
        "tags": ["Streams"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "layoutClassList": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Layout classes set" }
        }
      }
    },
    "/v2/project/{apiKey}/dial": {
      "post": {
        "operationId": "sipDial",
        "summary": "Initiate a SIP call into a session",
        "tags": ["SIP Interconnect"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId", "token", "sip"],
                "properties": {
                  "sessionId": { "type": "string" },
                  "token": { "type": "string" },
                  "sip": {
                    "type": "object",
                    "required": ["uri"],
                    "properties": {
                      "uri": { "type": "string" },
                      "from": { "type": "string" },
                      "headers": { "type": "object" },
                      "auth": {
                        "type": "object",
                        "properties": {
                          "username": { "type": "string" },
                          "password": { "type": "string" }
                        }
                      },
                      "secure": { "type": "boolean" },
                      "video": { "type": "boolean" },
                      "observeForceMute": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SIP call initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "connectionId": { "type": "string" },
                    "streamId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/session/{sessionId}/connection/{connectionId}/dtmf": {
      "post": {
        "operationId": "sendDTMF",
        "summary": "Send DTMF digits to a SIP connection",
        "tags": ["SIP Interconnect"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "connectionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["digits"],
                "properties": {
                  "digits": { "type": "string", "pattern": "^[0-9*#p]+$" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "DTMF digits sent" }
        }
      }
    },
    "/v2/project/{apiKey}/captions": {
      "post": {
        "operationId": "startCaptions",
        "summary": "Start live captions for a session",
        "tags": ["Live Captions"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId", "token"],
                "properties": {
                  "sessionId": { "type": "string" },
                  "token": { "type": "string" },
                  "languageCode": { "type": "string", "default": "en-US" },
                  "maxDuration": { "type": "integer" },
                  "partialCaptions": { "type": "boolean", "default": true },
                  "statusCallbackUrl": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Captions started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "captionsId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/captions/{captionsId}/stop": {
      "post": {
        "operationId": "stopCaptions",
        "summary": "Stop live captions",
        "tags": ["Live Captions"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "captionsId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "202": { "description": "Captions stopped" }
        }
      }
    },
    "/v2/project/{apiKey}/render": {
      "post": {
        "operationId": "startExperienceComposer",
        "summary": "Start an Experience Composer render",
        "tags": ["Experience Composer"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId", "token", "url"],
                "properties": {
                  "sessionId": { "type": "string" },
                  "token": { "type": "string" },
                  "url": { "type": "string", "format": "uri" },
                  "maxDuration": { "type": "integer" },
                  "resolution": { "type": "string" },
                  "statusCallbackUrl": { "type": "string", "format": "uri" },
                  "properties": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Render started",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Render" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listExperienceComposers",
        "summary": "List Experience Composer renders",
        "tags": ["Experience Composer"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "count", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "List of renders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Render" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/project/{apiKey}/render/{renderId}": {
      "get": {
        "operationId": "getExperienceComposer",
        "summary": "Get Experience Composer render info",
        "tags": ["Experience Composer"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "renderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Render information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Render" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "stopExperienceComposer",
        "summary": "Stop an Experience Composer render",
        "tags": ["Experience Composer"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "renderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Render stopped" }
        }
      }
    },
    "/v2/project/{apiKey}/audio-connector": {
      "post": {
        "operationId": "startAudioConnector",
        "summary": "Start an Audio Connector WebSocket connection",
        "tags": ["Audio Connector"],
        "parameters": [
          { "name": "apiKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId", "token", "websocket"],
                "properties": {
                  "sessionId": { "type": "string" },
                  "token": { "type": "string" },
                  "websocket": {
                    "type": "object",
                    "required": ["uri"],
                    "properties": {
                      "uri": { "type": "string", "format": "uri" },
                      "streams": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "headers": { "type": "object" },
                      "audioRate": { "type": "integer", "enum": [8000, 16000] }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audio Connector started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "connectionId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/account/project": {
      "post": {
        "operationId": "createProject",
        "summary": "Create a new project",
        "description": "Creates a new project under the account. Requires account-level API key.",
        "tags": ["Account Management"],
        "responses": {
          "200": {
            "description": "Project created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listProjects",
        "summary": "List all projects under the account",
        "tags": ["Account Management"],
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Project" }
                }
              }
            }
          }
        }
      }
    },
    "/v2/account/project/{projectId}": {
      "patch": {
        "operationId": "updateProject",
        "summary": "Suspend or activate a project",
        "tags": ["Account Management"],
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Project updated" }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "summary": "Delete a project",
        "tags": ["Account Management"],
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Project deleted" }
        }
      }
    },
    "/v2/account/project/{projectId}/secret": {
      "post": {
        "operationId": "regenerateProjectSecret",
        "summary": "Generate a new API secret for a project",
        "tags": ["Account Management"],
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "New secret generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiSecret": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OpenTokJWT": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OPENTOK-AUTH",
        "description": "JWT token containing: iss (API key), ist ('project' or 'account'), iat (current timestamp), exp (expiration), jti (unique ID). Sign with your API secret using HS256."
      }
    },
    "schemas": {
      "Stream": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "videoType": { "type": "string", "enum": ["camera", "screen", "custom"] },
          "name": { "type": "string" },
          "layoutClassList": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "Archive": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["available", "expired", "failed", "paused", "started", "stopped", "uploaded"] },
          "name": { "type": "string" },
          "reason": { "type": "string" },
          "sessionId": { "type": "string" },
          "projectId": { "type": "integer" },
          "createdAt": { "type": "integer" },
          "size": { "type": "integer" },
          "duration": { "type": "integer" },
          "outputMode": { "type": "string", "enum": ["composed", "individual"] },
          "hasAudio": { "type": "boolean" },
          "hasVideo": { "type": "boolean" },
          "sha256sum": { "type": "string" },
          "password": { "type": "string" },
          "url": { "type": "string", "nullable": true },
          "resolution": { "type": "string" },
          "streamMode": { "type": "string" }
        }
      },
      "Broadcast": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sessionId": { "type": "string" },
          "projectId": { "type": "integer" },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "resolution": { "type": "string" },
          "status": { "type": "string" },
          "broadcastUrls": {
            "type": "object",
            "properties": {
              "hls": { "type": "string" },
              "hlsStatus": { "type": "string" },
              "rtmp": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "status": { "type": "string" },
                    "serverUrl": { "type": "string" },
                    "streamName": { "type": "string" }
                  }
                }
              }
            }
          },
          "streamMode": { "type": "string" },
          "streams": { "type": "array", "items": { "type": "string" } },
          "maxDuration": { "type": "integer" },
          "maxBitrate": { "type": "integer" }
        }
      },
      "Render": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sessionId": { "type": "string" },
          "projectId": { "type": "string" },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "url": { "type": "string" },
          "resolution": { "type": "string" },
          "status": { "type": "string", "enum": ["starting", "started", "stopped", "failed"] },
          "streamId": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "secret": { "type": "string" },
          "status": { "type": "string" },
          "name": { "type": "string" },
          "createdAt": { "type": "integer" },
          "environmentName": { "type": "string" },
          "environmentStatus": { "type": "string" }
        }
      }
    }
  }
}
