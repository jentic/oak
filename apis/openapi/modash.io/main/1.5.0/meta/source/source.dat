{
  "openapi": "3.0.3",
  "info": {
    "title": "Modash API",
    "description": "Modash is an influencer marketing and social media data API providing discovery, analytics, and raw data access for Instagram, TikTok, and YouTube creators. It includes influencer search, profile reports, audience overlap analysis, collaborations tracking, and AI-powered search capabilities.",
    "version": "1.5.0",
    "x-jentic-source-url": "https://docs.modash.io/"
  },
  "servers": [
    {
      "url": "https://api.modash.io/v1",
      "description": "Modash Production API v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/instagram/search": {
      "post": {
        "operationId": "searchInstagramInfluencers",
        "summary": "Search Instagram influencers",
        "description": "Search for Instagram influencers with filters for interests, locations, age, audience demographics, and more. Costs 0.01 credits per result.",
        "tags": ["Instagram", "Discovery"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InfluencerSearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InfluencerSearchResponse" }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/instagram/profile/{userId}/report": {
      "get": {
        "operationId": "getInstagramProfileReport",
        "summary": "Get Instagram influencer report",
        "description": "Returns a detailed analytics report for an Instagram influencer. Costs 1 credit.",
        "tags": ["Instagram", "Discovery"],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "description": "Instagram user ID", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Profile report",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileReport" }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/reports/audience/overlap": {
      "post": {
        "operationId": "getInstagramAudienceOverlap",
        "summary": "Get Instagram audience overlap report",
        "description": "Analyzes audience overlap between multiple Instagram influencers. Costs 1 credit.",
        "tags": ["Instagram", "Discovery"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "influencerIds": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["influencerIds"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Overlap report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AudienceOverlapResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/brands": {
      "get": {
        "operationId": "listInstagramBrands",
        "summary": "List Instagram partnership brands",
        "description": "Returns a brand dictionary for filtering. Free endpoint.",
        "tags": ["Instagram", "Discovery"],
        "parameters": [
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 20, "maximum": 1000000 } }
        ],
        "responses": {
          "200": { "description": "List of brands", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Brand" } } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/interests": {
      "get": {
        "operationId": "listInstagramInterests",
        "summary": "List Instagram interests",
        "description": "Returns available interest categories for search filtering. Free endpoint.",
        "tags": ["Instagram", "Discovery"],
        "parameters": [
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of interests", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/topics": {
      "get": {
        "operationId": "listInstagramTopics",
        "summary": "List Instagram topics",
        "description": "Returns available topic categories. Free endpoint.",
        "tags": ["Instagram", "Discovery"],
        "parameters": [
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of topics", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/locations": {
      "get": {
        "operationId": "listInstagramLocations",
        "summary": "List Instagram locations",
        "description": "Returns available locations for filtering. Free endpoint.",
        "tags": ["Instagram", "Discovery"],
        "parameters": [
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of locations", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "type": { "type": "string" } } } } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/users": {
      "get": {
        "operationId": "listInstagramUsers",
        "summary": "List Instagram users",
        "description": "Search for Instagram user profiles. Free endpoint.",
        "tags": ["Instagram", "Discovery"],
        "parameters": [
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of users", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "userId": { "type": "string" }, "username": { "type": "string" }, "fullname": { "type": "string" }, "picture": { "type": "string" } } } } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/hashtags": {
      "get": {
        "operationId": "listInstagramHashtags",
        "summary": "List Instagram hashtags",
        "description": "Returns hashtags matching a query. Free endpoint.",
        "tags": ["Instagram", "Discovery"],
        "parameters": [
          { "name": "query", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of hashtags", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "tag": { "type": "string" }, "mediaCount": { "type": "integer" } } } } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/instagram/languages": {
      "get": {
        "operationId": "listInstagramLanguages",
        "summary": "List Instagram languages",
        "description": "Returns available language codes for filtering. Free endpoint.",
        "tags": ["Instagram", "Discovery"],
        "responses": {
          "200": { "description": "List of languages", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "code": { "type": "string" }, "name": { "type": "string" } } } } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/youtube/search": {
      "post": {
        "operationId": "searchYoutubeInfluencers",
        "summary": "Search YouTube influencers",
        "description": "Search for YouTube creators with filters. Costs 0.01 credits per result.",
        "tags": ["YouTube", "Discovery"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InfluencerSearchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InfluencerSearchResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/youtube/profile/{userId}/report": {
      "get": {
        "operationId": "getYoutubeProfileReport",
        "summary": "Get YouTube influencer report",
        "description": "Returns a detailed analytics report for a YouTube creator. Costs 1 credit.",
        "tags": ["YouTube", "Discovery"],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Profile report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileReport" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/tiktok/search": {
      "post": {
        "operationId": "searchTiktokInfluencers",
        "summary": "Search TikTok influencers",
        "description": "Search for TikTok creators with filters. Costs 0.01 credits per result.",
        "tags": ["TikTok", "Discovery"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InfluencerSearchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InfluencerSearchResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/tiktok/profile/{userId}/report": {
      "get": {
        "operationId": "getTiktokProfileReport",
        "summary": "Get TikTok influencer report",
        "description": "Returns a detailed analytics report for a TikTok creator. Costs 1 credit.",
        "tags": ["TikTok", "Discovery"],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Profile report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileReport" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/email-search": {
      "post": {
        "operationId": "searchByEmail",
        "summary": "Search social accounts by email",
        "description": "Identifies social media accounts linked to provided email addresses. Costs 0.02 credits per matched email.",
        "tags": ["Discovery"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["emails"],
                "properties": {
                  "emails": { "type": "array", "items": { "type": "string", "format": "email" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matched social accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "email": { "type": "string" },
                      "accounts": { "type": "array", "items": { "type": "object", "properties": { "platform": { "type": "string" }, "userId": { "type": "string" }, "username": { "type": "string" } } } }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/ai/instagram/text-search": {
      "post": {
        "operationId": "aiInstagramTextSearch",
        "summary": "AI-powered Instagram text search",
        "description": "Search Instagram creators using natural language text queries. Costs 0.025 credits per result. Rate limited to 1 RPS.",
        "tags": ["AI Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AiSearchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "AI search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InfluencerSearchResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/ai/instagram/lookalikes": {
      "post": {
        "operationId": "aiInstagramLookalikes",
        "summary": "Find Instagram creator lookalikes",
        "description": "Find creators similar to a source creator using AI. Costs 0.025 credits per result.",
        "tags": ["AI Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["userId"],
                "properties": {
                  "userId": { "type": "string", "description": "Source creator ID or username" },
                  "targetPlatform": { "type": "string", "enum": ["instagram", "tiktok", "youtube"] },
                  "page": { "type": "integer", "default": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Lookalike results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InfluencerSearchResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/ai/tiktok/text-search": {
      "post": {
        "operationId": "aiTiktokTextSearch",
        "summary": "AI-powered TikTok text search",
        "description": "Search TikTok creators using natural language queries. Costs 0.025 credits per result.",
        "tags": ["AI Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AiSearchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "AI search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InfluencerSearchResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/ai/youtube/text-search": {
      "post": {
        "operationId": "aiYoutubeTextSearch",
        "summary": "AI-powered YouTube text search",
        "description": "Search YouTube creators using natural language queries. Costs 0.025 credits per result.",
        "tags": ["AI Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AiSearchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "AI search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InfluencerSearchResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/collaborations/posts": {
      "post": {
        "operationId": "getCollaborationPosts",
        "summary": "Get collaboration posts",
        "description": "Returns posts showing brand-influencer mentions and partnerships. Costs 0.2 credits.",
        "tags": ["Collaborations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CollaborationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Collaboration posts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CollaborationPostsResponse" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/collaborations/summary": {
      "post": {
        "operationId": "getCollaborationSummary",
        "summary": "Get collaboration summary",
        "description": "Returns aggregated metrics for brand-influencer collaborations. Costs 0.2 credits.",
        "tags": ["Collaborations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CollaborationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Collaboration summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalLikes": { "type": "integer" },
                    "totalShares": { "type": "integer" },
                    "totalViews": { "type": "integer" },
                    "totalEngagement": { "type": "number" },
                    "postsCount": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/ig/user-info": {
      "get": {
        "operationId": "getRawInstagramUserInfo",
        "summary": "Get raw Instagram user info",
        "description": "Returns real-time, unfiltered details about an Instagram user profile.",
        "tags": ["Raw Data", "Instagram"],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User info", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/ig/user-feed": {
      "get": {
        "operationId": "getRawInstagramUserFeed",
        "summary": "Get raw Instagram user feed",
        "description": "Returns a paginated media feed for an Instagram user. 12 posts per page.",
        "tags": ["Raw Data", "Instagram"],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User feed", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/ig/media-info": {
      "get": {
        "operationId": "getRawInstagramMediaInfo",
        "summary": "Get raw Instagram media info",
        "description": "Returns detailed information about an Instagram media item.",
        "tags": ["Raw Data", "Instagram"],
        "parameters": [
          { "name": "mediaId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Media info", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/ig/media-comments": {
      "get": {
        "operationId": "getRawInstagramMediaComments",
        "summary": "Get raw Instagram media comments",
        "description": "Returns comments on an Instagram media item.",
        "tags": ["Raw Data", "Instagram"],
        "parameters": [
          { "name": "mediaId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Media comments", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/tiktok/user-info": {
      "get": {
        "operationId": "getRawTiktokUserInfo",
        "summary": "Get raw TikTok user info",
        "description": "Returns real-time details about a TikTok user profile.",
        "tags": ["Raw Data", "TikTok"],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User info", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/tiktok/user-feed": {
      "get": {
        "operationId": "getRawTiktokUserFeed",
        "summary": "Get raw TikTok user feed",
        "description": "Returns user feed information by userId or username.",
        "tags": ["Raw Data", "TikTok"],
        "parameters": [
          { "name": "username", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "userId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User feed", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/youtube/channel-info": {
      "get": {
        "operationId": "getRawYoutubeChannelInfo",
        "summary": "Get raw YouTube channel info",
        "description": "Returns real-time details about a YouTube channel.",
        "tags": ["Raw Data", "YouTube"],
        "parameters": [
          { "name": "channelId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Channel info", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/youtube/video-info": {
      "get": {
        "operationId": "getRawYoutubeVideoInfo",
        "summary": "Get raw YouTube video info",
        "description": "Returns information about a YouTube video or live stream.",
        "tags": ["Raw Data", "YouTube"],
        "parameters": [
          { "name": "videoId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Video info", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/raw/youtube/video-comments": {
      "get": {
        "operationId": "getRawYoutubeVideoComments",
        "summary": "Get raw YouTube video comments",
        "description": "Returns 20 YouTube video or live comments.",
        "tags": ["Raw Data", "YouTube"],
        "parameters": [
          { "name": "videoId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Video comments", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/user/info": {
      "get": {
        "operationId": "getUserAccountInfo",
        "summary": "Get user account info",
        "description": "Returns the authenticated user's account details and credit balance.",
        "tags": ["Account"],
        "responses": {
          "200": {
            "description": "Account info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "type": "string" },
                    "credits": { "type": "number" },
                    "plan": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealthCheck",
        "summary": "Health check",
        "description": "Returns service health status (Healthy, Degraded, or Unhealthy).",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["Healthy", "Degraded", "Unhealthy"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token. Obtain access tokens at https://marketer.modash.io/developer"
      }
    },
    "schemas": {
      "InfluencerSearchRequest": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "influencer": {
                "type": "object",
                "properties": {
                  "followers": { "type": "object", "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } } },
                  "engagementRate": { "type": "object", "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
                  "interests": { "type": "array", "items": { "type": "string" } },
                  "locations": { "type": "array", "items": { "type": "string" } },
                  "language": { "type": "string" },
                  "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
                  "hasContactDetails": { "type": "boolean" }
                }
              },
              "audience": {
                "type": "object",
                "properties": {
                  "locations": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "weight": { "type": "number" } } } },
                  "age": { "type": "array", "items": { "type": "object", "properties": { "range": { "type": "string" }, "weight": { "type": "number" } } } },
                  "gender": { "type": "object", "properties": { "type": { "type": "string" }, "weight": { "type": "number" } } }
                }
              }
            }
          },
          "sort": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "direction": { "type": "string", "enum": ["asc", "desc"] }
            }
          },
          "page": { "type": "integer", "default": 0 }
        }
      },
      "InfluencerSearchResponse": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "lookalikes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": { "type": "string" },
                "username": { "type": "string" },
                "fullname": { "type": "string" },
                "picture": { "type": "string" },
                "followers": { "type": "integer" },
                "engagementRate": { "type": "number" },
                "isVerified": { "type": "boolean" }
              }
            }
          }
        }
      },
      "ProfileReport": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "username": { "type": "string" },
          "fullname": { "type": "string" },
          "picture": { "type": "string" },
          "followers": { "type": "integer" },
          "following": { "type": "integer" },
          "engagementRate": { "type": "number" },
          "avgLikes": { "type": "number" },
          "avgComments": { "type": "number" },
          "isVerified": { "type": "boolean" },
          "bio": { "type": "string" },
          "audienceDemographics": {
            "type": "object",
            "properties": {
              "genders": { "type": "array", "items": { "type": "object", "properties": { "type": { "type": "string" }, "weight": { "type": "number" } } } },
              "ages": { "type": "array", "items": { "type": "object", "properties": { "range": { "type": "string" }, "weight": { "type": "number" } } } },
              "countries": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "code": { "type": "string" }, "weight": { "type": "number" } } } }
            }
          },
          "recentPosts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "likes": { "type": "integer" },
                "comments": { "type": "integer" },
                "created": { "type": "string", "format": "date-time" },
                "url": { "type": "string" }
              }
            }
          }
        }
      },
      "AudienceOverlapResponse": {
        "type": "object",
        "properties": {
          "overlapPercentage": { "type": "number" },
          "sharedAudience": { "type": "integer" },
          "influencers": { "type": "array", "items": { "type": "object", "properties": { "userId": { "type": "string" }, "followers": { "type": "integer" } } } }
        }
      },
      "Brand": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "username": { "type": "string" },
          "picture": { "type": "string" }
        }
      },
      "AiSearchRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "description": "Natural language search query" },
          "filter": { "type": "object", "description": "Optional additional filters" },
          "page": { "type": "integer", "default": 0 }
        }
      },
      "CollaborationRequest": {
        "type": "object",
        "properties": {
          "influencerId": { "type": "string" },
          "brandId": { "type": "string" },
          "platform": { "type": "string", "enum": ["instagram", "tiktok", "youtube"] },
          "dateRange": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "format": "date" },
              "to": { "type": "string", "format": "date" }
            }
          }
        }
      },
      "CollaborationPostsResponse": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "platform": { "type": "string" },
                "type": { "type": "string" },
                "likes": { "type": "integer" },
                "comments": { "type": "integer" },
                "views": { "type": "integer" },
                "url": { "type": "string" },
                "created": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "code": { "type": "integer" },
          "message": { "type": "string" }
        }
      }
    }
  }
}