    "/report": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Count Specific Reports",
        "description": "Find and count all the reports depending on the filter.",
        "operationId": "get_reports",
        "parameters": [
          {
            "name": "_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "vehicle_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "corrections",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "[{\"property_name\":\"Hot Wheels Premium\",\"property_value\":\"Toyota Rav4\",\"property_value_new\":\"'91 BMW M5\"}]"
            },
            "description": "JSON string of corrections"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vehicle_sku",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vehicle_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updated_by",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Create a new report",
        "description": "Creates a new report item the DB",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report item successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Inserted ID": {
                      "type": "string",
                      "example": "663fc198e0e1a7b62e9f2c4a"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Reports"
        ],
        "summary": "Update a report",
        "description": "Update a report by content stack id",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report item successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Item updated"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Report not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Reports"
        ],
        "summary": "Delete a report",
        "description": "Delete a report by content stack ID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteReportRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report item successfully deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Item Deleted"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Report not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerError"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "description": "PROD",
      "url": "https://api.platform.mattel/v1/hw/catalog"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "components": {
    "schemas": {
      "MongoDBSearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search term or numeric value to look for. If numeric (e.g., '2022'), performs an exact match on integer fields. If string, performs a fuzzy text search.",
            "example": "2022"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of results to return. Default is 10 if limit is not provided",
            "default": 10,
            "example": 3
          },
          "path": {
            "type": "array",
            "description": "Selectable fields for path\n\n**Art Director**\n- `art_director.first_name`\n- `art_director.last_name`\n- `art_director.title`\n\n**Assortment**\n- `assortment.name`\n- `assortment.title`\n\n**Base Color**\n- `base_color.base_color`\n- `base_color.title`\n- `base_color_premium`\n- `base_color_source`\n- `base_material`\n\n**Body Color**\n- `body_color.title`\n- `body_color.base_color`\n- `body_color_premium.title`\n- `body_color_source`\n\n**Casting Designer**\n- `casting_designer.first_name`\n- `casting_designer.last_name`\n- `casting_designer.title`\n\n**Collector Images**\n- `collector_images.bytes`\n- `collector_images.created_at`\n- `collector_images.duration`\n- `collector_images.folder`\n- `collector_images.format`\n- `collector_images.height`\n- `collector_images.id`\n- `collector_images.metadata`\n- `collector_images.public_id`\n- `collector_images.resource_type`\n- `collector_images.secure_url`\n- `collector_images.tags`\n- `collector_images.url`\n- `collector_images.width`\n\n**Entry Attributes**\n- `created_at`\n- `created_by`\n- `locale`\n- `mainline_index`\n- `model`\n- `oem`\n- `release_name`\n- `release_year`\n- `scale`\n- `series_index`\n- `sku`\n- `sku_variation`\n- `tags`\n- `title`\n- `updated_at`\n- `updated_by`\n\n**Images**\n- `images.aspect_ratio`\n- `images.asset_id`\n- `images.bytes`\n- `images.created_at`\n- `images.filename`\n- `images.folder`\n- `images.format`\n- `images.height`\n- `images.pixels`\n- `images.public_id`\n- `images.resource_type`\n- `images.secure_url`\n- `images.status`\n- `images.uploaded_at`\n- `images.url`\n- `images.version`\n- `images.width`\n\n**Interior Color**\n- `interior_color.base_color`\n- `interior_color.title`\n- `interior_color_permium`\n- `interior_color_source`\n\n**Segment**\n- `segment.title`\n\n**Series**\n- `series.collection`\n- `series.minicollection`\n- `series.name`\n- `series.title`\n- `series.year`\n\n**Wheels**\n- `wheel_source`\n- `wheel_type.code`\n- `wheel_type.name`\n- `wheel_type.title`\n\n**Window Color**\n- `window_color.base_color`\n- `window_color.title`\n- `window_color_premium.title`\n- `window_color_source`",
            "items": {
              "type": "string",
              "enum": [
                "art_director.first_name",
                "art_director.last_name",
                "art_director.title",
                "assortment.name",
                "assortment.title",
                "base_color.base_color",
                "base_color.title",
                "base_color_premium",
                "base_color_source",
                "base_material",
                "body_color.title",
                "body_color.base_color",
                "body_color_premium.title",
                "body_color_source",
                "casting_designer.first_name",
                "casting_designer.last_name",
                "casting_designer.title",
                "collector_images.bytes",
                "collector_images.created_at",
                "collector_images.duration",
                "collector_images.folder",
                "collector_images.format",
                "collector_images.height",
                "collector_images.id",
                "collector_images.metadata",
                "collector_images.public_id",
                "collector_images.resource_type",
                "collector_images.secure_url",
                "collector_images.tags",
                "collector_images.url",
                "collector_images.width",
                "created_at",
                "created_by",
                "images.aspect_ratio",
                "images.asset_id",
                "images.bytes",
                "images.created_at",
                "images.filename",
                "images.folder",
                "images.format",
                "images.height",
                "images.pixels",
                "images.public_id",
                "images.resource_type",
                "images.secure_url",
                "images.status",
                "images.uploaded_at",
                "images.url",
                "images.version",
                "images.width",
                "interior_color.base_color",
                "interior_color.title",
                "interior_color_permium",
                "interior_color_source",
                "locale",
                "mainline_index",
                "model",
                "oem",
                "release_name",
                "release_year",
                "scale",
                "segment.title",
                "series.collection",
                "series.minicollection",
                "series.name",
                "series.title",
                "series.year",
                "series_index",
                "sku",
                "sku_variation",
                "tags",
                "title",
                "updated_at",
                "updated_by",
                "wheel_source",
                "wheel_type.code",
                "wheel_type.name",
                "wheel_type.title",
                "window_color.base_color",
                "window_color.title",
                "window_color_premium.title",
                "window_color_source"
              ]
            },
            "example": [
              "release_year",
              "series.year"
            ]
          }
        },
        "required": [
          "query"
        ]
      },
      "FormattedSearchResult": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "example": {
          "title": "Formatted Entry 1"
        }
      },
      "CatalogResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/VehicleItem"
                },
                {
                  "$ref": "#/components/schemas/SegmentItem"
                },
                {
                  "$ref": "#/components/schemas/WheelTypeItem"
                },
                {
                  "$ref": "#/components/schemas/AssortmentItem"
                },
                {
                  "$ref": "#/components/schemas/SeriesItem"
                }
              ]
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
