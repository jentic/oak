      "ReportRequest": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Content Stack Id",
            "example": "bltzijxgplk008ftus"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "corrections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CorrectionItem"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "APPROVED",
              "REJECTED"
            ]
          },
          "vehicle_sku": {
            "type": "string"
          },
          "vehicle_name": {
            "type": "string"
          },
          "updated_by": {
            "type": "string"
          }
        }
      },
      "UpdateReportRequest": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Content Stack Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "NEW",
              "REJECTED"
            ]
          },
          "updated_by": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "status",
          "updated_by"
        ]
      },
      "DeleteReportRequest": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          }
        },
        "required": [
          "_id"
        ]
      },
      "CorrectionItem": {
        "type": "object",
        "properties": {
          "property_name": {
            "type": "string"
          },
          "property_value": {
            "type": "string"
          },
          "property_value_new": {
            "type": "string"
          }
        }
      },
      "ReportResponse": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "example": 1
          },
          "message": {
            "type": "string",
            "example": "Report Items found"
          },
          "query": {
            "$ref": "#/components/schemas/ReportRequest"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "loc": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "loc",
                "msg",
                "type"
              ]
            }
          }
        }
      },
      "NotFoundError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "404 Not Found"
          }
        }
      },
      "ServerError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Server error"
          },
          "details": {
            "type": "string",
            "example": "Internal failure message"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "api_key",
        "in": "header"
      }
    }
  }
}