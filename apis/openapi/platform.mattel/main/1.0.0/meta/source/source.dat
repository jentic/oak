{
  "openapi": "3.0.2",
  "info": {
    "title": "Hot Wheels Catalog Service API",
    "description": "This API service provides administrative endpoints for interacting with a MongoDB database. The catalog service is designed to give authorized admins the ability to perform specific database operations through a controlled and auditable HTTP interface. \n\n By abstracting direct access to the database, this API enforces role-based access (through the use of Gloo), validation, and logging, reducing the risk of accidental or malicious data manipulation while still giving admins the tools they need to maintain data integrity. \n\n\nCurrent Features: \n - \u2705 `Catalog Endpoint`: Provides the capability to retrieve vehicles from our collections in our MongoDB database.\n- \u2705 `Report Endpoint`: Provides the capability to create, count, update, and delete reports in our MongoDB vehicle report colletion.\n- \u2705 `Search Endpoint`: Provides the capability to search for items in the collection using MongoDB's aggregate function, allowing flexible queries and pipeline-based filtering to return formatted search results.\n- \u2705 `Doc Generation`: Describes the full set of operations the service supports, including endpoint definitions, request/response schemas, and authentication requirements.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Mattel-Inc/hot-wheels-catalog-service-api/1.0.0"
  },
  "tags": [
    {
      "name": "Catalog",
      "description": "Manages a set of paginated records"
    },
    {
      "name": "Reports",
      "description": "Manages reports"
    },
    {
      "name": "Search",
      "description": "Reaches out to a search engine service (MongoDB Atlas Search)"
    }
  ],
  "paths": {
    "/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Search for items in MongoDB Atlas Search",
        "operationId": "searchItems",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MongoDBSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful search",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FormattedSearchResult"
                      }
                    }
                  }
                },
                "example": {
                  "results": [
                    {
                      "title": "Porsche"
                    },
                    {
                      "release_name": "Red Porsche"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request or validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
                  "error": "Validation failed",
                  "details": [
                    {
                      "loc": [
                        "requests",
                        0,
                        "field"
                      ],
                      "msg": "field is required",
                      "type": "value_error.missing"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Server error",
                  "details": "Unexpected exception occurred"
                }
              }
            }
          },
          "502": {
            "description": "MongoDB connection or operation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "MongoDB Connection Error",
                  "details": "Timed out after 5000ms"
                }
              }
            }
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Read All Items",
        "description": "Fetches all items in the catalog based on the collection name and pagination.",
        "operationId": "get_all_items",
        "parameters": [
          {
            "name": "collection",
            "in": "query",
            "description": "The name of the collection to read from (e.g., 'Vehicle_v1').",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page number (default: 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The number of items per page (default: 20)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
