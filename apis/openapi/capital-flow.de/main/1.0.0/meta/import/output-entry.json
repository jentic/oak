{
  "openapi": "3.0.0",
  "info": {
    "title": "CapitalFlow Public API",
    "description": "API for building custom integrations and apps on top of CapitalFlow. Authenticate using your API key via the `cf-api-key` header.",
    "version": "1.0.0",
    "contact": {
      "name": "CapitalFlow Developer Support",
      "email": "app@capital-flow.de"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/capitalflowgmbh/CapitalFlow/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.capital-flow.de",
      "description": "Production"
    }
  ],
  "paths": {
    "/integrations/v1/customers/{customerId}": {
      "get": {
        "description": "Returns a single customer with all related information including contact, address, occupation, education, tax, health, vehicle, pet, and property data.",
        "operationId": "getCustomer",
        "parameters": [
          {
            "name": "customerId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer with all relations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "API key does not have access to this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Get a customer by ID",
        "tags": [
          "Customers"
        ]
      }
    },
    "/integrations/v1/customers": {
      "post": {
        "description": "Creates a new customer with optional contact and address information. The customer is created as a main customer by default.",
        "operationId": "createCustomer",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomer"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "API key does not have access to this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Create a new customer",
        "tags": [
          "Customers"
        ]
      },
      "put": {
        "description": "Updates a customer identified by the ID in the request body. Contact and address information can be updated alongside the customer data.",
        "operationId": "updateCustomer",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "API key does not have access to this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Update an existing customer",
        "tags": [
          "Customers"
        ]
      }
    },
    "/integrations/v1/forms/customer/{customerId}/share-form": {
      "put": {
        "description": "Generates a shareable link and password for the customer data collection form. No email is sent automatically — use the returned URL and password to implement your own delivery logic.",
        "operationId": "shareCustomerForm",
        "parameters": [
          {
            "name": "customerId",
            "required": true,
            "in": "path",
            "description": "Unique customer identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form share link generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareForm"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Share customer data form",
        "tags": [
          "Shared Forms"
        ]
      }
    },
    "/integrations/v1/forms/cashflow/customer/{customerId}/share-form": {
      "put": {
        "description": "Generates a shareable link and password for the cashflow analysis form. No email is sent automatically — use the returned URL and password to implement your own delivery logic.",
        "operationId": "shareCashflowForm",
        "parameters": [
          {
            "name": "customerId",
            "required": true,
            "in": "path",
            "description": "Unique customer identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form share link generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareForm"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Share cashflow analysis form",
        "tags": [
          "Shared Forms"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "cf-api-key",
        "description": "Your API key. Generate one in the CapitalFlow dashboard under Settings → API Keys."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Validation failed",
            "description": "Error message or array of validation errors"
          },
          "error": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-14T12:00:00.000Z"
          },
          "path": {
            "type": "string",
            "example": "/integrations/v1/customers"
          }
        },
        "required": [
          "statusCode",
          "message",
          "timestamp",
          "path"
        ]
      },
      "CustomerContactInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "object",
            "example": "max@example.de",
            "format": "email"
          },
          "phone": {
            "type": "object",
            "example": "+4917612345678"
          }
        },
        "required": [
          "id"
        ]
      },
      "CustomerAddressInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "address": {
            "type": "object",
            "example": "Königstraße 1"
          },
          "zipcode": {
            "type": "object",
            "example": "70173"
          },
          "city": {
            "type": "object",
            "example": "Stuttgart"
          },
          "state": {
            "type": "string",
            "enum": [
              "bund",
              "baden_wuerttemberg",
              "bayern",
              "berlin",
              "brandenburg",
              "bremen",
              "hamburg",
              "hessen",
              "mecklenburg_vorpommern",
              "niedersachsen",
              "nordrhein_westfalen",
              "rheinland_pfalz",
              "saarland",
              "sachsen",
