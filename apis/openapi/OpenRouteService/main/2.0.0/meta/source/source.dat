{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenRouteService Directions API",
    "description": "Routing, geocoding, and isochrone services based on OpenStreetMap data. Supports driving, cycling, walking, and wheelchair profiles. Free tier: 2000 requests/day.",
    "version": "2.0.0",
    "contact": {
      "name": "OpenRouteService",
      "url": "https://openrouteservice.org"
    },
    "x-jentic-source-url": "https://openrouteservice.org/dev/#/api-docs"
  },
  "servers": [
    {
      "url": "https://api.openrouteservice.org",
      "description": "OpenRouteService production server"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/v2/directions/{profile}": {
      "get": {
        "operationId": "getDirections",
        "summary": "Get route directions",
        "description": "Calculate route between two coordinates with distance, duration, and step-by-step navigation.",
        "parameters": [
          { "name": "profile", "in": "path", "required": true, "schema": { "type": "string", "enum": ["driving-car", "driving-hgv", "cycling-regular", "cycling-road", "cycling-mountain", "cycling-electric", "foot-walking", "foot-hiking", "wheelchair"] }, "description": "Routing profile." },
          { "name": "start", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Start coordinate as lon,lat." },
          { "name": "end", "in": "query", "required": true, "schema": { "type": "string" }, "description": "End coordinate as lon,lat." }
        ],
        "responses": {
          "200": {
            "description": "Route directions in GeoJSON format",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DirectionsResponse" }
              }
            }
          },
          "401": { "description": "Invalid API key" },
          "404": { "description": "Route not found" }
        }
      },
      "post": {
        "operationId": "postDirections",
        "summary": "Get route directions (advanced)",
        "description": "Calculate route with advanced options including multiple waypoints, avoidance areas, and route preferences.",
        "parameters": [
          { "name": "profile", "in": "path", "required": true, "schema": { "type": "string", "enum": ["driving-car", "driving-hgv", "cycling-regular", "cycling-road", "cycling-mountain", "cycling-electric", "foot-walking", "foot-hiking", "wheelchair"] }, "description": "Routing profile." }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["coordinates"],
                "properties": {
                  "coordinates": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "description": "Array of [lon, lat] coordinate pairs." },
                  "language": { "type": "string", "default": "en", "description": "Language for instructions (ISO 639-1)." },
                  "units": { "type": "string", "enum": ["m", "km", "mi"], "default": "m", "description": "Distance units." },
                  "geometry": { "type": "boolean", "default": true, "description": "Include route geometry." },
                  "instructions": { "type": "boolean", "default": true, "description": "Include turn-by-turn instructions." },
                  "preference": { "type": "string", "enum": ["fastest", "shortest", "recommended"], "default": "recommended", "description": "Route preference." },
                  "avoid_features": { "type": "array", "items": { "type": "string", "enum": ["highways", "tollways", "ferries", "fords", "steps"] }, "description": "Road features to avoid." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Route directions",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DirectionsResponse" } } }
          },
          "401": { "description": "Invalid API key" }
        }
      }
    },
    "/geocode/search": {
      "get": {
        "operationId": "geocodeSearch",
        "summary": "Forward geocoding",
        "description": "Convert an address or place name to coordinates.",
        "parameters": [
          { "name": "text", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Address or place name to geocode." },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 10 }, "description": "Maximum number of results." },
          { "name": "boundary.country", "in": "query", "required": false, "schema": { "type": "string" }, "description": "ISO 3166-1 alpha-2/3 country code to limit results." },
          { "name": "focus.point.lon", "in": "query", "required": false, "schema": { "type": "number" }, "description": "Focus longitude for proximity ranking." },
          { "name": "focus.point.lat", "in": "query", "required": false, "schema": { "type": "number" }, "description": "Focus latitude for proximity ranking." },
          { "name": "layers", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated layers: venue, address, street, neighbourhood, locality, county, region, country." }
        ],
        "responses": {
          "200": {
            "description": "Geocoding results in GeoJSON",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeocodeResponse" } } }
          }
        }
      }
    },
    "/geocode/reverse": {
      "get": {
        "operationId": "geocodeReverse",
        "summary": "Reverse geocoding",
        "description": "Convert coordinates to an address.",
        "parameters": [
          { "name": "point.lon", "in": "query", "required": true, "schema": { "type": "number" }, "description": "Longitude." },
          { "name": "point.lat", "in": "query", "required": true, "schema": { "type": "number" }, "description": "Latitude." },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 10 }, "description": "Number of results." },
          { "name": "layers", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Filter by layer type." }
        ],
        "responses": {
          "200": {
            "description": "Reverse geocoding results",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeocodeResponse" } } }
          }
        }
      }
    },
    "/v2/isochrones/{profile}": {
      "post": {
        "operationId": "getIsochrones",
        "summary": "Calculate reachability areas",
        "description": "Calculate areas reachable from a point within given time or distance limits. Useful for 'what can I reach in 30 minutes?'",
        "parameters": [
          { "name": "profile", "in": "path", "required": true, "schema": { "type": "string", "enum": ["driving-car", "cycling-regular", "foot-walking"] }, "description": "Travel profile." }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["locations", "range"],
                "properties": {
                  "locations": { "type": "array", "items": { "type": "array", "items": { "type": "number" } }, "description": "Center points as [[lon, lat]]." },
                  "range": { "type": "array", "items": { "type": "integer" }, "description": "Range values in seconds (time) or meters (distance)." },
                  "range_type": { "type": "string", "enum": ["time", "distance"], "default": "time", "description": "Whether range is time or distance." },
                  "interval": { "type": "integer", "description": "Interval for multiple isochrone rings." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Isochrone polygons in GeoJSON",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "type": { "type": "string" }, "features": { "type": "array", "items": { "type": "object" } } } } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "OpenRouteService API key. Register free at openrouteservice.org/dev."
      }
    },
    "schemas": {
      "DirectionsResponse": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["FeatureCollection"] },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "geometry": { "type": "object", "properties": { "type": { "type": "string" }, "coordinates": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } } } },
                "properties": {
                  "type": "object",
                  "properties": {
                    "summary": { "type": "object", "properties": { "distance": { "type": "number", "description": "Total distance in meters." }, "duration": { "type": "number", "description": "Total duration in seconds." } } },
                    "segments": { "type": "array", "items": { "type": "object", "properties": { "distance": { "type": "number" }, "duration": { "type": "number" }, "steps": { "type": "array", "items": { "type": "object", "properties": { "distance": { "type": "number" }, "duration": { "type": "number" }, "type": { "type": "integer" }, "instruction": { "type": "string" }, "name": { "type": "string" } } } } } } }
                  }
                }
              }
            }
          }
        }
      },
      "GeocodeResponse": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "geometry": { "type": "object", "properties": { "type": { "type": "string" }, "coordinates": { "type": "array", "items": { "type": "number" } } } },
                "properties": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "label": { "type": "string" },
                    "country": { "type": "string" },
                    "region": { "type": "string" },
                    "locality": { "type": "string" },
                    "street": { "type": "string" },
                    "housenumber": { "type": "string" },
                    "postalcode": { "type": "string" },
                    "confidence": { "type": "number" },
                    "layer": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
