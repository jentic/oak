  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API key for authentication. Format: `Bearer YOUR_API_KEY`\n\nYou need to generate your unique API token on https://admin.eventee.co/ in 'Settings -> Features' section.\n"
      }
    },
    "schemas": {
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 420
          },
          "name": {
            "type": "string",
            "example": "Apple Special Event"
          },
          "description": {
            "type": "string",
            "example": "Learn how we're helping teachers ignite the creativity in every student...",
            "description": "HTML formatted text"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-27 09:00:00",
            "description": "Datetime in UTC"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-27 18:00:00",
            "description": "Datetime in UTC"
          },
          "hall_id": {
            "type": "integer",
            "example": 42,
            "description": "Hall object id to which session is assigned"
          },
          "type": {
            "type": "integer",
            "description": "0 = Lecture, 1 = Workshop",
            "enum": [
              0,
              1
            ],
            "example": 0
          },
          "discussion": {
            "type": "boolean",
            "example": true,
            "description": "If true, users can ask questions during session"
          },
          "moderating": {
            "type": "boolean",
            "example": true,
            "description": "Defines if questions are moderated"
          },
          "polling": {
            "type": "boolean",
            "example": true,
            "description": "Defines if polls are enabled for session"
          },
          "capacity": {
            "type": "integer",
            "nullable": true,
            "example": 12,
            "description": "For workshop type - defines how many users can book to workshop"
          },
          "speakers": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              444
            ],
            "description": "Array of speaker IDs"
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              758136
            ],
            "description": "Array of track/label IDs"
          },
          "booking_info": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingInfo"
            }
          },
          "stream": {
            "$ref": "#/components/schemas/LiveStream"
          },
          "virtual_meeting": {
            "$ref": "#/components/schemas/VirtualMeeting"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-15 23:05:04"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-29 03:39:53"
          }
        }
      },
      "SessionCreate": {
        "type": "object",
        "required": [
          "name",
          "start",
          "end",
          "hall_id",
          "speakers",
          "type",
          "tracks"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Apple Special Event",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "example": "Learn how we're helping teachers ignite the creativity...",
            "description": "HTML formatted text (optional)"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-27 09:00:00",
            "description": "Datetime in UTC. Must be before end"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-27 18:00:00",
            "description": "Datetime in UTC. Must be after start"
          },
          "hall_id": {
            "type": "integer",
            "example": 42,
            "description": "Hall object id to which session will be assigned"
          },
          "speakers": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              444
            ],
            "description": "Array of speaker IDs. Can be empty"
          },
          "discussion": {
            "type": "boolean",
            "default": false,
            "example": true,
            "description": "If true, users can ask questions during session"
          },
          "moderating": {
            "type": "boolean",
            "default": false,
            "example": true,
            "description": "Defines if questions are moderated"
          },
          "polling": {
            "type": "boolean",
            "default": false,
            "example": true,
            "description": "Defines if polls are enabled for session"
          },
          "capacity": {
            "type": "integer",
            "minimum": 0,
            "example": 12,
            "description": "For workshop type - defines how many users can book to workshop. Minimum is 0"
          },
          "type": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "example": 0,
            "description": "0 = Lecture, 1 = Workshop"
          },
          "stream": {
            "type": "string",
            "format": "uri",
            "example": "https://youtube.com/xxxxxxxxx",
            "description": "Live stream URL (optional)"
          },
          "virtual_meeting": {
            "type": "string",
            "format": "uri",
            "example": "https://meet.google.com/xxx-xxx-xxx",
            "description": "Virtual meeting link (optional)"
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              758136
            ],
            "description": "Array of track object IDs"
          }
        }
      },
      "SessionUpdate": {
        "type": "object",
        "required": [
          "name",
          "start",
          "end",
          "hall_id",
          "speakers",
          "type",
          "tracks"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Apple Special Event - Updated"
          },
          "description": {
            "type": "string",
            "example": "Updated description",
            "description": "HTML formatted text (optional)"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-27 09:00:00",
            "description": "Datetime in UTC"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "example": "2018-03-27 18:00:00",
            "description": "Datetime in UTC"
          },
          "hall_id": {
            "type": "integer",
            "example": 42
          },
          "speakers": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              444,
              445
            ]
          },
          "discussion": {
            "type": "boolean",
            "example": true
          },
          "moderating": {
            "type": "boolean",
            "example": true
          },
          "polling": {
            "type": "boolean",
            "example": true
          },
          "capacity": {
            "type": "integer",
            "minimum": 0,
            "example": 12
          },
          "type": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "example": 0
          },
          "stream": {
            "type": "string",
            "format": "uri",
            "example": "https://youtube.com/xxxxxxxxx"
          },
          "virtual_meeting": {
            "type": "string",
            "format": "uri",
            "example": "https://meet.google.com/xxx-xxx-xxx"
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [
              758136
            ]
          }
        }
      },
      "BookingInfo": {
        "type": "object",
        "description": "Booking information for workshops",
        "properties": {
          "available": {
            "type": "integer",
            "example": 3,
            "description": "Number of available slots"
          },
          "capacity": {
            "type": "integer",
            "example": 12,
            "description": "Workshop capacity"
          }
        }
      },
      "LiveStream": {
        "type": "object",
        "description": "Live stream information",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://youtube.com/watch?v=xxxxx"
          },
          "type": {
            "type": "string",
            "enum": [
              "youtube",
              "twitch",
              "vimeo",
              "facebook",
              "zoom",
              "slides-live",
              "other"
            ],
            "example": "youtube"
          }
        }
      },
      "VirtualMeeting": {
        "type": "object",
        "description": "Virtual meeting information",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://meet.google.com/xxx-xxx-xxx"
          },
          "service": {
            "type": "string",
            "example": "Google Meet"
          }
        }
      },
      "Speaker": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 444
          },
          "name": {
            "type": "string",
            "example": "Tim Cook"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "tim.cook@apple.com"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "example": "https://eventee.co/images/profile/1803790321499729.png",
            "description": "Full-size speaker photo"
          },
          "thumbnail": {
            "type": "string",
            "format": "uri",
