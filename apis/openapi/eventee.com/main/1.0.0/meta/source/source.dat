            "description": "Thumbnail version of photo"
          },
          "phone": {
            "type": "string",
            "example": "(999) 999 999"
          },
          "bio": {
            "type": "string",
            "example": "Timothy Donald \"Tim\" Cook je v\u00fdkonn\u00fd riadite\u013e spolo\u010dnosti Apple Inc..."
