{
  "openapi": "3.0.3",
  "info": {
    "title": "Eventee Public API",
    "description": "Welcome to Eventee public API documentation. You will find here detailed information about all available calls with specific request and response structure. You can easily implement it in your application.\n\n## Authentication\n\nYou need to generate your unique API token on https://admin.eventee.co/ in 'Settings -> Features' section. You will use this token to authenticate to Eventee public API.\n\nYou need to send Authorization header in every request. Authorization type is Bearer so you need to send your generated token in this format: \n\n`Authorization: Bearer <token>`\n\n## Recommended Headers\n\n- `Accept: application/json` - If you want to see possible errors in JSON format\n- `Content-Type: application/json` - If content of your request is in JSON format\n\n## Base URL\nAll endpoints are prefixed with `/public/v1`\n",
    "version": "1.0.0",
    "contact": {
      "name": "Eventee API Support",
      "url": "https://eventee.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/eventeesro/eventee-public-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.eventee.com/public/v1",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Content",
      "description": "Event content operations"
    },
    {
      "name": "Sessions",
      "description": "Manage event sessions (lectures and workshops)"
    },
    {
      "name": "Speakers",
      "description": "Manage event speakers"
    },
    {
      "name": "Halls",
      "description": "Manage event halls/venues"
    },
    {
      "name": "Partners",
      "description": "Manage event partners/sponsors"
    },
    {
      "name": "Labels",
      "description": "Manage session labels/tracks"
    },
    {
      "name": "Pauses",
      "description": "Manage event pauses/breaks"
    },
    {
      "name": "Attendees",
      "description": "Manage event attendees and registrations"
    },
    {
      "name": "Reviews",
      "description": "Event reviews and feedback"
    },
    {
      "name": "Groups",
      "description": "Event groups management"
    }
  ],
  "paths": {
    "/content": {
      "get": {
        "summary": "Get all event content",
        "description": "With this call you will receive all available content of your event including halls, sessions, breaks, speakers, and tracks.\n\nThis is a comprehensive endpoint that returns the complete event structure in a single call.\n",
        "tags": [
          "Content"
        ],
        "responses": {
          "200": {
            "description": "Successful response with complete event content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllContentResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/reviews": {
      "get": {
        "summary": "Get all event reviews",
        "description": "With this call you will receive all available user reviews for your event",
        "tags": [
          "Reviews"
        ],
        "responses": {
          "200": {
            "description": "Array of all event reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Review"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/groups": {
      "get": {
        "summary": "Get all event groups",
        "description": "This call will return array of available groups for your event",
        "tags": [
          "Groups"
        ],
        "responses": {
          "200": {
            "description": "Array of event groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Group"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/test/content": {
      "delete": {
        "summary": "Delete test content",
        "description": "With this call you will delete all tracks, pauses, speakers, workshops, lectures and halls from your event.\n\n**Warning:** This is a destructive operation and cannot be undone.\n",
        "tags": [
          "Content"
        ],
        "responses": {
          "204": {
            "description": "Test content successfully deleted"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/hall": {
      "post": {
        "summary": "Create a new hall",
        "description": "With this call you will create a new hall/venue for your event",
        "tags": [
          "Halls"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HallCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hall successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hall"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/hall/{hall}": {
      "parameters": [
        {
          "name": "hall",
          "in": "path",
          "required": true,
          "description": "Hall object id",
          "schema": {
            "type": "integer",
            "example": 20
          }
        }
      ],
      "patch": {
        "summary": "Update hall",
        "description": "With this call you will update an existing hall in your event",
        "tags": [
          "Halls"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HallUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hall successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hall"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "delete": {
        "summary": "Delete hall",
        "description": "With this call you will delete an existing hall from your event",
        "tags": [
          "Halls"
        ],
        "responses": {
          "204": {
            "description": "Hall successfully deleted"
          },
          "400": {
            "description": "Cannot delete hall",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "cannot_delete_only_hall",
                      "description": "Cannot delete the only remaining hall"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/lecture": {
      "post": {
        "summary": "Create a new lecture or workshop",
        "description": "With this call you will create a new lecture or workshop session for your event",
        "tags": [
          "Sessions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreate"
              },
              "examples": {
                "lecture": {
                  "summary": "Create a lecture",
                  "value": {
                    "name": "Apple Special Event",
                    "description": "Learn how we're helping teachers...",
                    "start": "2018-03-27 09:00:00",
                    "end": "2018-03-27 18:00:00",
                    "hall_id": 42,
                    "speakers": [
                      444
                    ],
                    "discussion": true,
                    "moderating": false,
                    "polling": true,
                    "type": 0,
                    "tracks": [
                      758136
                    ]
                  }
                },
                "workshop": {
                  "summary": "Create a workshop",
                  "value": {
                    "name": "Hands-on Machine Learning",
                    "description": "Practical ML workshop",
                    "start": "2018-03-27 14:00:00",
                    "end": "2018-03-27 16:00:00",
                    "hall_id": 42,
                    "speakers": [
                      444
                    ],
                    "capacity": 12,
                    "checkin": true,
                    "type": 1,
                    "tracks": [
                      758136
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/lecture/{lecture}": {
      "parameters": [
        {
          "name": "lecture",
          "in": "path",
          "required": true,
          "description": "Lecture/Workshop object id",
          "schema": {
            "type": "integer",
            "example": 20
          }
        }
      ],
      "patch": {
        "summary": "Update lecture or workshop",
        "description": "With this call you will update an existing lecture or workshop in your event",
        "tags": [
          "Sessions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "delete": {
        "summary": "Delete lecture or workshop",
        "description": "With this call you will delete an existing session from your event",
        "tags": [
          "Sessions"
        ],
        "responses": {
          "204": {
            "description": "Session successfully deleted"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/pause": {
      "post": {
        "summary": "Create a pause/break",
        "description": "Creates a new pause or break in the schedule",
        "tags": [
          "Pauses"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pause successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pause"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/pause/{pause}": {
      "parameters": [
        {
          "name": "pause",
          "in": "path",
          "required": true,
          "description": "Pause object id",
          "schema": {
            "type": "integer",
            "example": 20
          }
        }
      ],
      "patch": {
        "summary": "Update pause",
        "description": "With this call you will update an existing pause/break in your event",
        "tags": [
          "Pauses"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pause successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pause"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "delete": {
        "summary": "Delete pause",
        "description": "With this call you will delete an existing pause from your event",
        "tags": [
          "Pauses"
        ],
        "responses": {
          "204": {
            "description": "Pause successfully deleted"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/speaker": {
      "post": {
        "summary": "Create a new speaker",
        "description": "With this call you will create a new speaker profile for your event",
        "tags": [
          "Speakers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakerCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Speaker successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Speaker"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or image not readable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "image_not_readable"
                      ],
                      "example": "image_not_readable",
                      "description": "Input photo is not readable"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/speaker/{speakerTmp}": {
      "parameters": [
        {
          "name": "speakerTmp",
          "in": "path",
          "required": true,
          "description": "Speaker object id",
          "schema": {
            "type": "integer",
            "example": 20
          }
        }
      ],
      "patch": {
        "summary": "Update speaker",
        "description": "With this call you will update an existing speaker profile",
        "tags": [
          "Speakers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakerUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Speaker successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Speaker"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or image not readable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "image_not_readable"
                      ],
                      "example": "image_not_readable",
                      "description": "Input photo is not readable"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "delete": {
        "summary": "Delete speaker",
        "description": "With this call you will delete an existing speaker from your event",
        "tags": [
          "Speakers"
        ],
        "responses": {
          "204": {
            "description": "Speaker successfully deleted"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/registration/invite": {
      "put": {
        "summary": "Invite registrations",
        "description": "With this call you will invite registrants to your event",
        "tags": [
          "Attendees"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/attendee/invite": {
      "put": {
        "summary": "Invite attendees",
        "description": "With this call you will invite attendees to your event",
        "tags": [
          "Attendees"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/attendee/{attendee}/checkin": {
      "parameters": [
        {
          "name": "attendee",
          "in": "path",
          "required": true,
          "description": "Attendee object id",
          "schema": {
            "type": "integer",
            "example": 20
          }
        }
      ],
      "put": {
        "summary": "Update attendee check-in",
        "description": "With this call you can set checkin field of your attendee",
        "tags": [
          "Attendees"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check-in status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attendee"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/registrations": {
      "get": {
        "summary": "Get all registrations",
        "description": "This call will return info about all your registrations",
        "tags": [
          "Attendees"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of registrations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registration"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/participants": {
      "get": {
        "summary": "Get all participants",
        "description": "This call will return basic info about all your attendees",
        "tags": [
          "Attendees"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of participants/attendees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Attendee"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/registration": {
      "delete": {
        "summary": "Remove registration by email",
        "description": "With this call you remove invited registrant from your event.\n\nEmail must be URL encoded (e.g., `attendee%40example.com`).\n",
        "tags": [
          "Attendees"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "URL encoded email address of the registration to remove",
            "schema": {
              "type": "string",
              "format": "email",
              "example": "attendee%40example.com"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Registration successfully deleted"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/attendee": {
      "delete": {
        "summary": "Remove attendee by email",
        "description": "With this call you remove invited attendee from your event.\nIf attendee has already entered your event, they will lose access to your event and all information linking them to event will be removed.\n\nEmail must be URL encoded (e.g., `attendee%40example.com`).\n",
        "tags": [
          "Attendees"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "URL encoded email address of the attendee to remove",
            "schema": {
              "type": "string",
              "format": "email",
              "example": "attendee%40example.com"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Attendee successfully deleted"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/label": {
      "post": {
        "summary": "Create a new track/label",
        "description": "With this call you will create a new track (label) for your event",
        "tags": [
          "Labels"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabelCreate"
              }
            }
          }
        },
        "responses": {
