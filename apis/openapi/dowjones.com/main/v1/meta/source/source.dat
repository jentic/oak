        "type": "object",
        "description": "Represents the result of the last alert update of the match",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the alert update in ISO 8601 format",
            "example": "2025-07-10T12:15:44.730Z"
          },
          "changed_sections": {
            "type": "array",
            "description": "List of sections that were changed in the alert update",
            "items": {
              "type": "string",
              "enum": [
                "BASIC",
                "ENTITY",
                "PERSON",
                "RELATIONSHIP",
                "IMAGE_DETAILS",
                "STATE_OWNED_COMPANY",
                "ADVERSE_MEDIA",
                "LOCATION",
                "HIGH_RISK_FACTORS",
