                "WATCHLIST_SCO",
                "WATCHLIST_LIST_REF",
                "WATCHLIST_LIST_REF_SAN",
                "WATCHLIST_LIST_REF_OEL",
                "WATCHLIST_LIST_REF_OOL",
                "OTHER_CHANGES",
                "PROFILE_CREATED",
                "PROFILE_DELETED"
              ]
            },
            "example": [
              "RELATIONSHIP",
              "ENTITY"
            ]
          }
        }
