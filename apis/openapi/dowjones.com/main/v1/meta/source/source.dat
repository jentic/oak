        "summary": "Gets status of a bulk transaction",
        "description": "Returns the status and details of a bulk-associations transaction by case and transaction ID.",
        "operationId": "getBulkTransactionUsingGET",
        "parameters": [
          {
            "$ref": "#/components/parameters/Accept-Encoding"
          },
          {
            "name": "case_id",
            "in": "path",
            "description": "Id of the case.",
