    "/risk-entity-screening-cases/{case_id}/matches": {
      "get": {
        "tags": [
          "Risk and Compliance Screening and Monitoring"
        ],
        "summary": "Finds persons/entities matching search criteria given case ID",
        "description": "Returns matches (persons/entities) for a case with optional filters and pagination.",
        "operationId": "getMatchesByCaseIdUsingGET",
        "parameters": [
          {
            "$ref": "#/components/parameters/Accept-Encoding"
          },
          {
            "name": "case_id",
            "in": "path",
            "description": "Id of the case.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page[offset]",
            "in": "query",
            "description": "page offset",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "page[limit]",
            "in": "query",
            "description": "page limit",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          },
          {
            "name": "associationId",
            "in": "query",
            "description": "Optional filter by association Id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[association.id]",
            "in": "query",
            "description": "Optional filter by association Id only for version 3.0 or greater",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hasAlerts",
            "in": "query",
            "description": "Optional filter by matches with alerts only for version 1.0",
            "schema": {
              "$ref": "#/components/schemas/HasAlertsAndMatchValidity"
            }
          },
          {
            "name": "filter[has_alerts]",
            "in": "query",
            "description": "Optional filter by matches with alerts only for version 1.1 or greater",
            "schema": {
              "$ref": "#/components/schemas/HasAlertsAndMatchValidity"
            }
          },
          {
            "name": "filter[is_match_valid]",
            "in": "query",
            "description": "Optional filter by matches with validity only for version 1.1 or greater",
            "schema": {
              "$ref": "#/components/schemas/HasAlertsAndMatchValidity"
            }
          },
          {
            "name": "filter[match_update_date][timestamp_from]",
            "in": "query",
            "description": "Optional filter by match update from date only for version 3.0 or greater",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-06-10T15:00:00.000"
            }
          },
          {
            "name": "filter[match_update_date][timestamp_to]",
            "in": "query",
            "description": "Optional filter by match update to date only for version 3.0 or greater",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-06-11T15:00:00.000"
            }
          },
          {
            "name": "filter[alert_update.date][timestamp_from]",
            "in": "query",
            "description": "Optional filter by match alert update from date only for version 3.0 or greater",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-06-10T15:00:00.000"
            }
          },
          {
            "name": "filter[alert_update.date][timestamp_to]",
            "in": "query",
            "description": "Optional filter by match alert update to date only for version 3.0 or greater",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-06-11T15:00:00.000"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Optional sort parameter only for version 3.0 or greater. Format: +field (ascending) or -field (descending). Valid fields: percentage_match, match_update_date, match_creation_date, subscription_name",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "+percentage_match",
                "-percentage_match",
                "+match_update_date",
                "-match_update_date",
                "+match_creation_date",
                "-match_creation_date",
                "+subscription_name",
                "-subscription_name"
              ],
              "example": "-percentage_match"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.dowjones.dna.matches.v_1.1+json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListAssociationMatches"
                }
              },
              "application/vnd.dowjones.dna.matches.v_1.0+json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListAssociationMatches"
                }
              },
              "application/vnd.dowjones.dna.matches.v_1.2+json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListAssociationMatchesV12"
                }
              },
              "application/vnd.dowjones.dna.matches.v_2.0+json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListAssociationMatchesV20"
                }
              },
              "application/vnd.dowjones.dna.matches.v_3.0+json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListMatchesV30"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListAssociationMatches"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {}
          },
          "403": {
            "description": "Forbidden",
            "content": {}
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
