{
  "openapi": "3.0.3",
  "info": {
    "title": "SeekTable API",
    "version": "1.0.0",
    "description": "SeekTable Web API for report generation, data cube management, dashboard exports, and account operations.",
    "x-jentic-source-url": "https://www.seektable.com/help/web-api-integration"
  },
  "servers": [
    {
      "url": "https://www.seektable.com/api"
    }
  ],
  "paths": {
    "/report/{report_id}/export": {
      "get": {
        "operationId": "exportReport",
        "summary": "Export report",
        "description": "Export a saved report in the specified format",
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "html",
                "pdf",
                "csv",
                "excel",
                "excelpivottable",
                "json",
                "png"
              ]
            }
          },
          {
            "name": "report_parameters",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "JSON object with parameter values"
          },
          {
            "name": "html_inline_style",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "chart_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "value_formatting",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "row_mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "array",
                "object"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report content in requested format"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/report/{report_id}/share/email": {
      "post": {
        "operationId": "shareReportByEmail",
        "summary": "Share report by email",
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent successfully"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/report/{report_id}": {
      "get": {
        "operationId": "getReport",
        "summary": "Get report info",
