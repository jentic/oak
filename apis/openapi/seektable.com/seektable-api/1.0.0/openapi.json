    "/account/backup": {
      "get": {
        "operationId": "backupAccount",
        "summary": "Backup account data",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "XML backup of account data",
            "content": {
              "application/xml": {
