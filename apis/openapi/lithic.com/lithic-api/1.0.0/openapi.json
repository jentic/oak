              "VIRTUAL",
              "PHYSICAL",
              "MERCHANT_LOCKED",
              "SINGLE_USE"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "OPEN",
              "PAUSED",
              "CLOSED"
            ]
          },
          "memo": {
            "type": "string"
          },
          "spend_limit": {
            "type": "integer"
          },
          "spend_limit_duration": {
            "type": "string",
            "enum": [
              "ANNUALLY",
              "FOREVER",
              "MONTHLY",
              "TRANSACTION"
