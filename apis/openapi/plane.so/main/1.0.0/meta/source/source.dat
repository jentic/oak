{
  "openapi": "3.0.3",
  "info": {
    "title": "Plane API",
    "description": "Plane is an open-source project management tool (Jira/Linear alternative). This API provides programmatic access to manage projects, work items, cycles, modules, labels, states, and more.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://developers.plane.so/api-reference/introduction",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.plane.so/api/v1"
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    }
  ],
  "paths": {
    "/workspaces/{workspace_slug}/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List all projects in a workspace",
        "parameters": [
          {
            "name": "workspace_slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of projects.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } },
                    "next_cursor": { "type": "string" },
                    "prev_cursor": { "type": "string" },
                    "count": { "type": "integer" },
                    "total_results": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized." },
          "403": { "description": "Forbidden." }
        }
      },
      "post": {
        "operationId": "createProject",
        "summary": "Create a new project in a workspace",
        "parameters": [
          {
            "name": "workspace_slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "identifier": { "type": "string" },
                  "network": { "type": "integer", "description": "0 = Secret, 2 = Public" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "400": { "description": "Bad request." },
          "401": { "description": "Unauthorized." }
        }
      }
    },
    "/workspaces/{workspace_slug}/projects/{project_id}": {
      "get": {
        "operationId": "getProject",
        "summary": "Get project details",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Project details.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } }
          },
          "404": { "description": "Project not found." }
        }
      },
      "patch": {
        "operationId": "updateProject",
        "summary": "Update a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "network": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } }
          },
          "400": { "description": "Bad request." }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "summary": "Delete a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Project deleted." },
          "404": { "description": "Project not found." }
        }
      }
    },
    "/workspaces/{workspace_slug}/projects/{project_id}/work-items": {
      "get": {
        "operationId": "listWorkItems",
        "summary": "List work items in a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "per_page", "in": "query", "required": false, "schema": { "type": "integer", "default": 100 } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of work items.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/WorkItem" } },
                    "next_cursor": { "type": "string" },
                    "prev_cursor": { "type": "string" },
                    "count": { "type": "integer" },
                    "total_results": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWorkItem",
        "summary": "Create a work item in a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description_html": { "type": "string" },
                  "priority": { "type": "string", "enum": ["urgent", "high", "medium", "low", "none"] },
                  "state_id": { "type": "string", "format": "uuid" },
                  "assignees": { "type": "array", "items": { "type": "string", "format": "uuid" } },
                  "labels": { "type": "array", "items": { "type": "string", "format": "uuid" } },
                  "start_date": { "type": "string", "format": "date" },
                  "target_date": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Work item created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkItem" } } }
          },
          "400": { "description": "Bad request." }
        }
      }
    },
    "/workspaces/{workspace_slug}/projects/{project_id}/work-items/{work_item_id}": {
      "get": {
        "operationId": "getWorkItem",
        "summary": "Get work item details",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "work_item_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Work item details.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkItem" } } }
          },
          "404": { "description": "Work item not found." }
        }
      },
      "patch": {
        "operationId": "updateWorkItem",
        "summary": "Update a work item",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "work_item_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description_html": { "type": "string" },
                  "priority": { "type": "string" },
                  "state_id": { "type": "string", "format": "uuid" },
                  "assignees": { "type": "array", "items": { "type": "string", "format": "uuid" } },
                  "labels": { "type": "array", "items": { "type": "string", "format": "uuid" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Work item updated.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkItem" } } }
          }
        }
      },
      "delete": {
        "operationId": "deleteWorkItem",
        "summary": "Delete a work item",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "work_item_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Work item deleted." }
        }
      }
    },
    "/workspaces/{workspace_slug}/projects/{project_id}/cycles": {
      "get": {
        "operationId": "listCycles",
        "summary": "List cycles in a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "per_page", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of cycles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/Cycle" } },
                    "next_cursor": { "type": "string" },
                    "prev_cursor": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCycle",
        "summary": "Create a cycle",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "start_date": { "type": "string", "format": "date" },
                  "end_date": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cycle created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cycle" } } }
          }
        }
      }
    },
    "/workspaces/{workspace_slug}/projects/{project_id}/modules": {
      "get": {
        "operationId": "listModules",
        "summary": "List modules in a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "per_page", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of modules.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/Module" } },
                    "next_cursor": { "type": "string" },
                    "prev_cursor": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createModule",
        "summary": "Create a module",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "start_date": { "type": "string", "format": "date" },
                  "target_date": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Module created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Module" } } }
          }
        }
      }
    },
    "/workspaces/{workspace_slug}/projects/{project_id}/labels": {
      "get": {
        "operationId": "listLabels",
        "summary": "List labels in a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "List of labels.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "format": "uuid" },
                          "name": { "type": "string" },
                          "color": { "type": "string" },
                          "sort_order": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createLabel",
        "summary": "Create a label",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "color": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Label created." }
        }
      }
    },
    "/workspaces/{workspace_slug}/projects/{project_id}/states": {
      "get": {
        "operationId": "listStates",
        "summary": "List workflow states in a project",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "List of states.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "format": "uuid" },
                          "name": { "type": "string" },
                          "color": { "type": "string" },
                          "group": { "type": "string" },
                          "is_default": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_slug}/members": {
      "get": {
        "operationId": "listWorkspaceMembers",
        "summary": "List workspace members",
        "parameters": [
          { "name": "workspace_slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of workspace members.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "format": "uuid" },
                          "member": { "type": "object" },
                          "role": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Plane API key generated via Profile Settings > Personal Access Tokens."
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "identifier": { "type": "string" },
          "network": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "WorkItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description_html": { "type": "string" },
          "priority": { "type": "string" },
          "state_id": { "type": "string", "format": "uuid" },
          "assignees": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "labels": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "start_date": { "type": "string", "format": "date", "nullable": true },
          "target_date": { "type": "string", "format": "date", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Cycle": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "start_date": { "type": "string", "format": "date", "nullable": true },
          "end_date": { "type": "string", "format": "date", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Module": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "start_date": { "type": "string", "format": "date", "nullable": true },
          "target_date": { "type": "string", "format": "date", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
