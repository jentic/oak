          "service": {
            "$ref": "#/components/schemas/ServicePR"
          }
        },
        "type": "object"
      },
      "PlannedRouteLink": {
        "description": "Each link represents a time interval where a production function was performed at a physical location, or a transport line was active.\n",
        "properties": {
          "countryCode": {
            "description": "ISO 3166 alpha-2 country code of the production point or line.",
            "type": "string"
          },
          "deviation": {
            "description": "true if there are might be deviations at the current link for the function.",
            "type": "boolean"
          },
          "function": {
