  "components": {
    "parameters": {
      "additionalServiceCodesParam": {
        "description": "PostNord additional service codes (comma separated)\n* 10 (Before 9:00)\n* 20 (Before 12:00)\n* ..\n",
        "in": "query",
        "name": "additionalServiceCodes",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "apikeyParam": {
        "description": "The unique consumer (client) identifier 32 characters",
        "in": "query",
        "name": "apikey",
        "required": true,
        "schema": {
          "type": "string"
        },
        "x-data-threescale-name": "user_keys"
      },
      "currentProductionPointCountryCodeParam": {
        "description": "Current production point country code as ISO 3166-1 alpha-2, example DE. The parcel might have begun at the origin and is going to destination, but where is it currently? This information helps the API to better calculate a route.",
        "in": "query",
        "name": "currentProductionPointCountryCode",
        "required": false,
        "schema": {
          "pattern": "^[A-Za-z]{2}$",
          "type": "string"
        }
      },
      "currentProductionPointIdParam": {
        "description": "Id of current production point. The parcel might have begun at the origin and is going to destination, but where is it currently? This information helps the API to better calculate a route.",
        "in": "query",
        "name": "currentProductionPointId",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "currentProductionPointTypeParam": {
        "description": "Current production point type. The parcel might have begun at the origin and is going to destination, but where is it currently? This information helps the API to better calculate a route.",
        "in": "query",
        "name": "currentProductionPointType",
        "required": false,
        "schema": {
          "enum": [
            "hub",
            "depot",
            "servicepoint"
          ],
          "type": "string"
        }
      },
      "destinationCountryCodeParam": {
        "description": "Destination country code as ISO 3166-1 alpha-2, example FI",
        "in": "query",
        "name": "destinationCountryCode",
        "required": true,
        "schema": {
          "pattern": "^[A-Za-z]{2}$",
          "type": "string"
        }
      },
      "destinationPostCodeParam": {
        "description": "Post code of destination address",
        "in": "query",
        "name": "destinationPostCode",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "destinationProductionPointCountryCodeParam": {
        "description": "Destination production point country code as ISO 3166-1 alpha-2, example NO",
        "in": "query",
        "name": "destinationProductionPointCountryCode",
        "required": true,
        "schema": {
          "pattern": "^[A-Za-z]{2}$",
          "type": "string"
        }
      },
      "destinationProductionPointIdParam": {
        "description": "Id of destination production point id",
        "in": "query",
        "name": "destinationProductionPointId",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "destinationProductionPointTypeParam": {
        "description": "Destination production point type",
        "in": "query",
        "name": "destinationProductionPointType",
        "required": true,
        "schema": {
          "enum": [
            "hub",
            "depot",
            "servicepoint"
          ],
          "type": "string"
        }
      },
      "destinationStreetNameParam": {
        "description": "Street name of destination address. Providing this will allow for more accurate results",
        "in": "query",
        "name": "destinationStreetName",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "destinationStreetNumberParam": {
        "description": "Street number of destination address. Providing this will allow for more accurate results",
        "in": "query",
        "name": "destinationStreetNumber",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "isUnderDistributionParam": {
        "description": "Is the parcel under distribution or not? Sometimes a production point might appear more than once in the route, once for pickup and once for distribution. If underDistribution is set to true, then the API will assume the parcel is at the end of its journey and calculate the route accordingly.\n",
        "in": "query",
        "name": "underDistribution",
        "required": false,
        "schema": {
          "default": false,
          "type": "boolean"
        }
      },
      "originCountryCodeParam": {
        "description": "Origin country code as ISO 3166-1 alpha-2, example SE",
        "in": "query",
        "name": "originCountryCode",
        "required": true,
        "schema": {
          "pattern": "^[A-Za-z]{2}$",
          "type": "string"
        }
      },
      "originPostCodeParam": {
        "description": "Post code of origin address",
        "in": "query",
        "name": "originPostCode",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "originProductionPointCountryCodeParam": {
        "description": "Origin production point country code as ISO 3166-1 alpha-2, example DK",
        "in": "query",
        "name": "originProductionPointCountryCode",
        "required": true,
        "schema": {
          "pattern": "^[A-Za-z]{2}$",
          "type": "string"
        }
      },
      "originProductionPointIdParam": {
        "description": "Id of origin production point id",
        "in": "query",
        "name": "originProductionPointId",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "originProductionPointTypeParam": {
        "description": "Origin production point type",
        "in": "query",
        "name": "originProductionPointType",
        "required": true,
        "schema": {
          "enum": [
            "hub",
            "depot",
            "servicepoint"
          ],
          "type": "string"
        }
      },
      "originStreetNameParam": {
        "description": "Street name of origin address. Providing this will allow for more accurate results",
        "in": "query",
        "name": "originStreetName",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "originStreetNumberParam": {
        "description": "Street number of origin address. Providing this will allow for more accurate results",
        "in": "query",
        "name": "originStreetNumber",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "serviceCodeParam": {
        "description": "PostNord service code (comma separated)\n* 17 (Mypack Home) \n* 18 (Parcel)\n* 19 (Mypack Collect)\n* ..\n",
        "in": "query",
        "name": "serviceCode",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "startTimeParam": {
        "description": "Local date-time for origin ('yyyy-MM-ddTHH:mm:ss', without timezone)",
        "in": "query",
        "name": "startTime",
        "required": true,
        "schema": {
          "format": "date-time",
          "type": "string"
        }
      }
    },
