          },
          "inboundSort": {
            "type": "boolean"
          },
          "latestBooking": {
            "description": "The latest time for booking for PostNord to be able to pick-up the parcel the same day \n(only applicable for pick-up services). If booking is made before this time, then pick-up same day is possible.\nThis property is not considered in the planned route calculation\n",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "name of the production point or line.",
            "type": "string"
          },
          "stopTimeIn": {
            "description": "The start time of the function",
            "example": "14:00",
            "format": "date-time",
            "type": "string"
          },
          "stopTimeOut": {
            "description": "The end time of the function",
            "example": "21:00",
            "format": "date-time",
            "type": "string"
          },
          "transportDistance": {
            "format": "int32",
            "type": "integer"
          },
          "transportLegs": {
