          "estimatedTimeOfArrival": {
            "description": "Estimated time of arrival for the item. Can be null if the route is not complete or if foreignTransitTimeInterval is present instead.\n",
            "format": "date-time",
            "type": "string"
          },
          "eveningPickup": {
            "description": "true - if deviation of timeOfArrival can occur depending on exact origin or destination address.\n",
            "type": "boolean"
          },
          "foreignTransitTimeInterval": {
            "$ref": "#/components/schemas/ForeignTransitTimeInterval"
          },
          "links": {
            "description": "The links of the calculated route. The links are ordered chronologically, where the earliest link is first.",
