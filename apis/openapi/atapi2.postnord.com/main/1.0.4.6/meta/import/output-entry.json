            "items": {
              "$ref": "#/components/schemas/TransportLeg"
            },
            "type": "array"
          },
          "type": {
            "description": "\"LINE\" if this link represents a transport line. Otherwise the type of the production point\n",
            "type": "string"
          }
        },
        "type": "object"
