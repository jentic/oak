                "name": "ICA KVANTUM LIDING\u00d6",
                "function": "COLLECTION",
                "hubFunction": false,
                "inboundSort": false,
                "deviation": false
              }
            ]
          }
        }
      }
    },
    "Unauthorized": {
      "description": "API-key or authentication token is missing/invalid.",
      "schema": {
        "$ref": "#/definitions/errorResponse"
      }
    },
    "MethodNotAllowed": {
      "description": "The method received in the request-line is known by the origin server but not supported by the target resource.",
      "schema": {
        "$ref": "#/definitions/errorResponse"
      }
    },
    "InternalServerError": {
      "description": "The server encountered an unexpected condition that prevented it from fulfilling the request.",
      "schema": {
        "$ref": "#/definitions/errorResponse"
      }
    },
    "ServiceUnavailable": {
      "description": "The server is currently unable to handle the request due to a temporary overload or scheduled maintenance, which will likely be alleviated after some delay.",
      "schema": {
        "$ref": "#/definitions/errorResponse"
      }
    }
  },
  "definitions": {
    "PlannedRouteResponse": {
      "type": "object",
      "properties": {
        "metadata": {
          "$ref": "#/definitions/MetaData"
        },
        "plannedRoute": {
          "$ref": "#/definitions/PlannedRoute"
        },
        "noPlannedRouteReasonCode": {
          "description": "This property is present when it is not possible to calculate a complete route. The value is a description of what went wrong together with a fault code.\n",
          "type": "string"
        }
      }
    },
    "MetaData": {
      "type": "object",
      "properties": {
        "dataVersion": {
          "type": "string",
          "description": "Timestamp for extract of data which service operates on"
        }
      }
    },
    "PlannedRoute": {
      "type": "object",
      "properties": {
        "estimatedTimeOfArrival": {
          "description": "Estimated time of arrival for the item. Can be null if the route is not complete or if foreignTransitTimeInterval is present instead.\n",
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "description": "If true, then the route was successfully built. Else this is an incomplete route without an ETA. The returned route is how much was possible to build",
          "type": "boolean"
        },
        "foreignTransitTimeInterval": {
          "$ref": "#/definitions/ForeignTransitTimeInterval"
        },
        "deviationMayOccur": {
          "description": "true - if deviation of timeOfArrival can occur depending on exact origin or destination address.\n",
          "type": "boolean"
        },
        "eveningPickup": {
          "description": "true - if deviation of timeOfArrival can occur depending on exact origin or destination address.\n",
          "type": "boolean"
        },
        "daysPickup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "service": {
          "$ref": "#/definitions/ServicePR"
        },
        "additionalServices": {
          "type": "array",
          "description": "Present if the service code was combined with one or several additional service codes. Additional service code can affect the final time of arrival. For example if additional service code is \"before 9\"\n",
          "items": {
            "$ref": "#/definitions/AdditionalService"
          }
        },
        "links": {
          "type": "array",
          "description": "The links of the calculated route. The links are ordered chronologically, where the earliest link is first.",
          "items": {
            "$ref": "#/definitions/PlannedRouteLink"
          }
        }
      }
    },
    "ForeignTransitTimeInterval": {
      "type": "object",
      "description": "For some country codes or services, an exact time of arrival is not supported. Instead this property might be present to give an estimate of the time of arrival in a day range format. Can be null if estimatedTimeOfArrival is present instead.\n",
      "properties": {
        "daysMinimum": {
          "type": "integer"
        },
        "daysMaximum": {
          "type": "integer"
        }
      }
    },
    "ServicePR": {
      "type": "object",
      "description": "Represents the PostNord service that was used during this route calculation.",
      "properties": {
        "code": {
          "type": "string",
          "description": "The code of the PostNord product\n* 17 (Mypack Home) \n* 18 (Parcel)\n* 19 (Mypack Collect)\n* ..\n"
        },
        "groupCode": {
          "type": "string",
          "description": "Think of it as country code or \"DPD\". Valid values are;\n * SE for issuerCode=Z12\n * DK for issuerCode=Z11\n * NO for issuerCode=Z13\n * FI for issuerCode=Z14\n * DPD for DPD services\n"
        },
        "name": {
          "type": "string",
          "description": "Name of the PostNord product that the API used to calculated the transit time"
        },
        "pickup": {
          "type": "boolean",
          "description": "True - if service supports pickup at customer by default.\nFalse - if service instead supports drop off at service point by default\n"
        },
        "distribution": {
          "type": "boolean",
          "description": "True - if service supports distribution by default\nFalse - if service instead supports collection at a service point by default\n"
        }
      }
    },
    "AdditionalService": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "PostNord additional service codes (comma separated)\n* 10 (Before 9:00)\n* 20 (Before 12:00)\n* ..\n"
        },
        "name": {
          "type": "string",
          "description": "Name of the additional service."
        }
      }
    },
    "PlannedRouteLink": {
      "type": "object",
      "description": "Each link represents a time interval where a production function was performed at a physical location, or a transport line was active.\n",
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the production point or the transport line."
        },
        "type": {
          "type": "string",
          "description": "\"LINE\" if this link represents a transport line. Otherwise the type of the production point\n"
        },
        "countryCode": {
          "type": "string",
          "description": "ISO 3166 alpha-2 country code of the production point or line."
        },
        "name": {
          "type": "string",
          "description": "name of the production point or line."
        },
        "function": {
          "type": "string",
          "description": "\"TRANSPORT\" if the link represents a line. Otherwise it's the function being performed at the production point.\n",
          "example": "DISTRIBUTION"
        },
        "hubFunction": {
          "type": "boolean"
        },
        "inboundSort": {
          "type": "boolean"
        },
        "stopTimeIn": {
          "type": "string",
          "format": "date-time",
          "description": "The start time of the function",
          "example": "14:00"
        },
        "stopTimeOut": {
          "type": "string",
          "format": "date-time",
          "description": "The end time of the function",
          "example": "21:00"
        },
        "latestBooking": {
          "type": "string",
          "format": "date-time",
          "description": "The latest time for booking for PostNord to be able to pick-up the parcel the same day \n(only applicable for pick-up services). If booking is made before this time, then pick-up same day is possible.\nThis property is not considered in the planned route calculation\n"
        },
        "deviation": {
          "type": "boolean",
          "description": "true if there are might be deviations at the current link for the function."
        },
        "transportDistance": {
          "type": "integer",
          "format": "int32"
        },
        "transportLegs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TransportLeg"
          },
          "description": "The legs of the line if the link is a transport line."
        }
      }
    },
    "TransportLeg": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sequenceNumber": {
          "type": "integer",
          "format": "int32"
        },
        "timeOfDeparture": {
          "type": "string",
          "format": "date-time"
        },
        "timeOfArrival": {
          "type": "string",
          "format": "date-time"
        },
        "transportDistance": {
          "type": "integer",
          "format": "int32"
        },
        "fromProductionPoint": {
          "$ref": "#/definitions/ProductionPointIdentifier"
        },
        "toProductionPoint": {
          "$ref": "#/definitions/ProductionPointIdentifier"
        }
      }
    },
    "ProductionPointIdentifier": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "countryCode": {
          "type": "string"
        }
      }
    },
    "health": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UP"
          ]
        }
      }
    },
    "paramValue": {
      "type": "object",
      "required": [
        "param"
      ],
      "properties": {
        "param": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "fault": {
      "type": "object",
      "required": [
        "explanationText"
      ],
      "properties": {
        "paramValues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/paramValue"
          }
        },
        "explanationText": {
          "type": "string"
        },
        "faultCode": {
          "type": "string"
        }
      }
    },
    "compositeFault": {
      "type": "object",
      "properties": {
        "faults": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/fault"
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "compositeFault": {
          "$ref": "#/definitions/compositeFault"
        },
        "message": {
          "type": "string",
          "description": "High level error message."
        }
      }
    }
  }
}