{
  "openapi": "3.0.3",
  "info": {
    "title": "Coinbase Advanced Trade API",
    "description": "The Coinbase Advanced Trade API provides programmatic access to Coinbase's advanced trading features including accounts, orders, products, portfolios, fees, conversions, futures, and perpetuals.",
    "version": "3.0.0",
    "contact": {
      "name": "Coinbase Developer Platform",
      "url": "https://docs.cdp.coinbase.com"
    },
    "x-jentic-source-url": "https://docs.cdp.coinbase.com/advanced-trade/reference"
  },
  "servers": [
    {
      "url": "https://api.coinbase.com/api/v3/brokerage",
      "description": "Coinbase Advanced Trade API (Authenticated)"
    },
    {
      "url": "https://api.coinbase.com/api/v3/brokerage",
      "description": "Coinbase Advanced Trade API (Public)"
    }
  ],
  "tags": [
    { "name": "Accounts", "description": "Manage trading accounts" },
    { "name": "Orders", "description": "Create and manage orders" },
    { "name": "Products", "description": "Browse and query products and market data" },
    { "name": "Portfolios", "description": "Manage portfolios" },
    { "name": "Fees", "description": "View fee structures and transaction summaries" },
    { "name": "Convert", "description": "Currency conversion operations" },
    { "name": "Futures", "description": "Futures trading operations" },
    { "name": "Perpetuals", "description": "Perpetual futures operations" },
    { "name": "Payment Methods", "description": "View payment methods" },
    { "name": "Permissions", "description": "View API key permissions" },
    { "name": "Public", "description": "Public market data endpoints (no authentication required)" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "List Accounts",
        "description": "Get a list of authenticated accounts for the current user.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "The number of accounts to display per page (default 49, max 250).",
            "schema": { "type": "integer", "format": "int32", "default": 49, "maximum": 250 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor for retrieving subsequent pages.",
            "schema": { "type": "string" }
          },
          {
            "name": "retail_portfolio_id",
            "in": "query",
            "description": "Filter accounts by portfolio ID (deprecated for CDP keys).",
            "deprecated": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of accounts.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListAccountsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{account_id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Get Account",
        "description": "Get a single account by account ID.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "description": "The account UUID.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with account details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "account": { "$ref": "#/components/schemas/Account" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create Order",
        "description": "Create a new order on the exchange.",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order creation result.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateOrderResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/batch_cancel": {
      "post": {
        "operationId": "cancelOrders",
        "summary": "Cancel Orders",
        "description": "Initiate cancel requests for one or more orders.",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_ids"],
                "properties": {
                  "order_ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "The IDs of orders to cancel."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancel result for each order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "success": { "type": "boolean" },
                          "failure_reason": { "type": "string" },
                          "order_id": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/historical/batch": {
      "get": {
        "operationId": "listOrders",
        "summary": "List Orders",
        "description": "Get a list of orders filtered by optional query parameters.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_ids",
            "in": "query",
            "description": "The IDs of orders to retrieve.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "product_ids",
            "in": "query",
            "description": "Filter by product IDs.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "product_type",
            "in": "query",
            "description": "Filter by product type.",
            "schema": { "$ref": "#/components/schemas/ProductType" }
          },
          {
            "name": "order_status",
            "in": "query",
            "description": "Filter by order statuses.",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/components/schemas/OrderStatus" }
            }
          },
          {
            "name": "time_in_forces",
            "in": "query",
            "description": "Filter by time-in-force values.",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/components/schemas/TimeInForce" }
            }
          },
          {
            "name": "order_types",
            "in": "query",
            "description": "Filter by order types.",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/components/schemas/OrderType" }
            }
          },
          {
            "name": "order_side",
            "in": "query",
            "description": "Filter by order side.",
            "schema": { "$ref": "#/components/schemas/OrderSide" }
          },
          {
            "name": "start_date",
            "in": "query",
            "description": "Start date to fetch orders from (inclusive, RFC3339).",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "End date to fetch orders to (exclusive, RFC3339).",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "order_placement_source",
            "in": "query",
            "description": "Filter by placement source.",
            "schema": {
              "type": "string",
              "enum": ["UNKNOWN_PLACEMENT_SOURCE", "RETAIL_SIMPLE", "RETAIL_ADVANCED"]
            }
          },
          {
            "name": "contract_expiry_type",
            "in": "query",
            "description": "Filter by contract expiry type.",
            "schema": { "$ref": "#/components/schemas/ContractExpiryType" }
          },
          {
            "name": "asset_filters",
            "in": "query",
            "description": "Filter where quote, base, or underlying asset matches.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of orders to display per page.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort results by a field.",
            "schema": {
              "type": "string",
              "enum": ["UNKNOWN_SORT_BY", "LIMIT_PRICE", "LAST_FILL_TIME", "LAST_UPDATE_TIME"]
            }
          },
          {
            "name": "retail_portfolio_id",
            "in": "query",
            "deprecated": true,
            "description": "Filter by portfolio ID (deprecated).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of orders.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListOrdersResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/historical/fills": {
      "get": {
        "operationId": "listFills",
        "summary": "List Fills",
        "description": "Get a list of fills filtered by optional query parameters.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_ids",
            "in": "query",
            "description": "The IDs of orders to filter fills by.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "trade_ids",
            "in": "query",
            "description": "The IDs of trades to filter fills by.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "product_ids",
            "in": "query",
            "description": "Filter fills by product IDs.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "start_sequence_timestamp",
            "in": "query",
            "description": "Only fills with a trade time after this start date (RFC3339).",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "end_sequence_timestamp",
            "in": "query",
            "description": "Only fills with a trade time before this end date (RFC3339).",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of fills to return (default 100).",
            "schema": { "type": "integer", "format": "int64", "default": 100 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor.",
            "schema": { "type": "string" }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort results by a field.",
            "schema": {
              "type": "string",
              "enum": ["UNKNOWN_SORT_BY", "PRICE", "TRADE_TIME"]
            }
          },
          {
            "name": "order_side",
            "in": "query",
            "description": "Filter by order side.",
            "schema": { "$ref": "#/components/schemas/OrderSide" }
          },
          {
            "name": "asset_filters",
            "in": "query",
            "description": "Filter where quote, base, or underlying asset matches.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "product_types",
            "in": "query",
            "description": "Filter by product types.",
            "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProductType" } }
          },
          {
            "name": "retail_portfolio_id",
            "in": "query",
            "deprecated": true,
            "description": "Filter by portfolio ID (deprecated).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of fills.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListFillsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/historical/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get Order",
        "description": "Get a single order by order ID.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "The order ID.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with order details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order": { "$ref": "#/components/schemas/Order" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/orders/preview": {
      "post": {
        "operationId": "previewOrder",
        "summary": "Preview Order",
        "description": "Preview an order to estimate fees and total before submission.",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order preview result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_total": { "type": "string", "description": "Total order amount." },
                    "commission_total": { "type": "string", "description": "Total commission." },
                    "errs": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Any validation errors."
                    },
                    "warning": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Any warnings."
                    },
                    "quote_size": { "type": "string" },
                    "base_size": { "type": "string" },
                    "best_bid": { "type": "string" },
                    "best_ask": { "type": "string" },
                    "is_max": { "type": "boolean" },
                    "order_margin_total": { "type": "string" },
                    "leverage": { "type": "string" },
                    "long_leverage": { "type": "string" },
                    "short_leverage": { "type": "string" },
                    "slippage": { "type": "string" },
                    "average_filled_price": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List Products",
        "description": "Get a list of available currency pairs for trading.",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of products to return.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of products to skip.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "product_type",
            "in": "query",
            "description": "Filter by product type.",
            "schema": { "$ref": "#/components/schemas/ProductType" }
          },
          {
            "name": "product_ids",
            "in": "query",
            "description": "List of product IDs to filter by.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "contract_expiry_type",
            "in": "query",
            "description": "Filter by contract expiry type (futures only).",
            "schema": { "$ref": "#/components/schemas/ContractExpiryType" }
          },
          {
            "name": "expiring_contract_status",
            "in": "query",
            "description": "Filter by expiring contract status.",
            "schema": {
              "type": "string",
              "enum": ["UNKNOWN_EXPIRING_CONTRACT_STATUS", "STATUS_UNEXPIRED", "STATUS_EXPIRED", "STATUS_ALL"]
            }
          },
          {
            "name": "get_tradability_status",
            "in": "query",
            "description": "Populate tradability status for SPOT products.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "get_all_products",
            "in": "query",
            "description": "Return all products including expired futures contracts.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "products_sort_order",
            "in": "query",
            "description": "Sort order for products.",
            "schema": {
              "type": "string",
              "enum": ["PRODUCTS_SORT_ORDER_UNDEFINED", "PRODUCTS_SORT_ORDER_VOLUME_24H_DESCENDING", "PRODUCTS_SORT_ORDER_LIST_TIME_DESCENDING"]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor (base64-encoded).",
            "schema": { "type": "string" }
          },
          {
            "name": "futures_underlying_type",
            "in": "query",
            "description": "Filter futures by underlying type.",
            "schema": {
              "type": "string",
              "enum": ["SPOT", "INDEX", "EQUITY", "EQUITY_INDEX", "EQUITY_ETF", "PREIPO", "COMMOD", "COMMOD_ETF", "COMMOD_INDEX", "ADR", "FOREIGN_EQUITY", "OTC"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of products.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListProductsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/products/{product_id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Get Product",
        "description": "Get information on a single product by product ID.",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "description": "The trading pair (e.g. BTC-USD).",
            "schema": { "type": "string" }
          },
          {
            "name": "get_tradability_status",
            "in": "query",
            "description": "Populate tradability status.",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with product details.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/products/{product_id}/candles": {
      "get": {
        "operationId": "getProductCandles",
        "summary": "Get Product Candles",
        "description": "Get rates for a single product by product ID, grouped in buckets.",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "description": "The trading pair (e.g. BTC-USD).",
            "schema": { "type": "string" }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "description": "Timestamp for starting range of aggregations (Unix timestamp).",
            "schema": { "type": "string" }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "description": "Timestamp for ending range of aggregations (Unix timestamp).",
            "schema": { "type": "string" }
          },
          {
            "name": "granularity",
            "in": "query",
            "required": true,
            "description": "The time slice value for each candle.",
            "schema": {
              "type": "string",
              "enum": ["UNKNOWN_GRANULARITY", "ONE_MINUTE", "FIVE_MINUTE", "FIFTEEN_MINUTE", "THIRTY_MINUTE", "ONE_HOUR", "TWO_HOUR", "SIX_HOUR", "ONE_DAY"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of candles to return (max 350).",
            "schema": { "type": "integer", "format": "int32", "maximum": 350 }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with candle data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "candles": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Candle" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/products/{product_id}/ticker": {
      "get": {
        "operationId": "getMarketTrades",
        "summary": "Get Market Trades",
        "description": "Get snapshot information by product ID about the last trades (ticks) and best bid/ask.",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "description": "The trading pair (e.g. BTC-USD).",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Number of trades to return.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp (RFC3339 or Unix).",
            "schema": { "type": "string" }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp (RFC3339 or Unix).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with market trades.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trades": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Trade" }
                    },
                    "best_bid": { "type": "string" },
                    "best_ask": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/best_bid_ask": {
      "get": {
        "operationId": "getBestBidAsk",
        "summary": "Get Best Bid/Ask",
        "description": "Get the best bid/ask for all products or specific products.",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "product_ids",
            "in": "query",
            "description": "List of product IDs to get best bid/ask for.",
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with best bid/ask data.",
            "content": {
              "application/json": {
