                  "properties": {
                    "portfolio_balances": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "asset": { "type": "string" },
                          "quantity": { "type": "string" },
                          "hold": { "type": "string" },
                          "transfer_hold": { "type": "string" },
                          "collateral_value": { "type": "string" },
                          "collateral_weight": { "type": "string" },
                          "max_withdraw_amount": { "type": "string" },
                          "loan": { "type": "string" },
                          "loan_collateral_requirement_usd": { "type": "string" },
                          "pledged_quantity": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/intx/multi_asset_collateral": {
      "post": {
        "operationId": "optInOutMultiAssetCollateral",
        "summary": "Opt In/Out Multi-Asset Collateral",
        "description": "Opt into or out of multi-asset collateral for perpetuals.",
        "tags": ["Perpetuals"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "portfolio_uuid": {
                    "type": "string",
                    "description": "The portfolio UUID."
                  },
                  "multi_asset_collateral_enabled": {
                    "type": "boolean",
                    "description": "Whether to enable multi-asset collateral."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cross_collateral_enabled": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/intx/allocate": {
      "post": {
        "operationId": "allocatePerpetualsPortfolio",
        "summary": "Allocate Perpetuals Portfolio",
        "description": "Allocate capital to a perpetuals portfolio.",
        "tags": ["Perpetuals"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["portfolio_uuid", "symbol", "amount", "currency"],
                "properties": {
                  "portfolio_uuid": {
                    "type": "string",
                    "description": "The portfolio UUID."
                  },
                  "symbol": {
                    "type": "string",
                    "description": "The product symbol."
                  },
                  "amount": {
                    "type": "string",
                    "description": "The amount to allocate."
                  },
                  "currency": {
                    "type": "string",
                    "description": "The currency of the allocation."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Allocation successful.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payment_methods": {
      "get": {
        "operationId": "listPaymentMethods",
        "summary": "List Payment Methods",
        "description": "Get a list of payment methods for the current user.",
        "tags": ["Payment Methods"],
        "responses": {
          "200": {
            "description": "Successful response with payment methods.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment_methods": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/PaymentMethod" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/payment_methods/{payment_method_id}": {
      "get": {
        "operationId": "getPaymentMethod",
        "summary": "Get Payment Method",
        "description": "Get a single payment method by payment method ID.",
        "tags": ["Payment Methods"],
        "parameters": [
          {
            "name": "payment_method_id",
            "in": "path",
            "required": true,
            "description": "The payment method ID.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with payment method details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment_method": { "$ref": "#/components/schemas/PaymentMethod" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/key_permissions": {
      "get": {
        "operationId": "getApiKeyPermissions",
        "summary": "Get API Key Permissions",
        "description": "Get the permissions associated with the current API key.",
        "tags": ["Permissions"],
        "responses": {
          "200": {
            "description": "Successful response with key permissions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "can_view": { "type": "boolean", "description": "Whether the key has view permission." },
                    "can_trade": { "type": "boolean", "description": "Whether the key has trade permission." },
                    "can_transfer": { "type": "boolean", "description": "Whether the key has transfer permission." },
                    "portfolio_uuid": { "type": "string", "description": "The portfolio UUID associated with the key." },
                    "portfolio_type": { "type": "string", "description": "The type of portfolio." }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/time": {
      "get": {
        "operationId": "getServerTime",
        "summary": "Get Server Time",
        "description": "Get the current server time.",
        "tags": ["Public"],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response with server time.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "iso": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Server time in ISO 8601 format."
                    },
                    "epochSeconds": {
                      "type": "string",
                      "description": "Server time as Unix epoch seconds."
                    },
                    "epochMillis": {
                      "type": "string",
                      "description": "Server time as Unix epoch milliseconds."
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/market/product_book": {
      "get": {
        "operationId": "getPublicProductBook",
        "summary": "Get Public Product Book",
        "description": "Get the public order book for a product (no authentication required).",
        "tags": ["Public"],
        "security": [],
        "parameters": [
          {
            "name": "product_id",
            "in": "query",
            "required": true,
            "description": "The trading pair (e.g. BTC-USD).",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of bid/asks to return.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "aggregation_price_increment",
            "in": "query",
            "description": "Minimum price intervals for order book aggregation.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with order book.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetProductBookResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/market/products": {
      "get": {
        "operationId": "listPublicProducts",
        "summary": "List Public Products",
        "description": "Get a list of available products (no authentication required).",
        "tags": ["Public"],
        "security": [],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of products to return.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of products to skip.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "product_type",
            "in": "query",
            "description": "Filter by product type.",
            "schema": { "$ref": "#/components/schemas/ProductType" }
          },
          {
            "name": "product_ids",
            "in": "query",
            "description": "Filter by product IDs.",
            "schema": { "type": "array", "items": { "type": "string" } }
          },
          {
            "name": "products_sort_order",
            "in": "query",
            "description": "Sort order for products.",
            "schema": {
              "type": "string",
              "enum": ["PRODUCTS_SORT_ORDER_UNDEFINED", "PRODUCTS_SORT_ORDER_VOLUME_24H_DESCENDING", "PRODUCTS_SORT_ORDER_LIST_TIME_DESCENDING"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of products.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListProductsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/market/products/{product_id}": {
      "get": {
        "operationId": "getPublicProduct",
        "summary": "Get Public Product",
        "description": "Get information on a single product (no authentication required).",
        "tags": ["Public"],
        "security": [],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "description": "The trading pair (e.g. BTC-USD).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with product details.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/market/products/{product_id}/candles": {
      "get": {
        "operationId": "getPublicProductCandles",
        "summary": "Get Public Product Candles",
        "description": "Get OHLC candle data for a product (no authentication required).",
        "tags": ["Public"],
        "security": [],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "description": "The trading pair (e.g. BTC-USD).",
            "schema": { "type": "string" }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "description": "Start timestamp (Unix).",
            "schema": { "type": "string" }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "description": "End timestamp (Unix).",
            "schema": { "type": "string" }
          },
          {
            "name": "granularity",
            "in": "query",
            "required": true,
            "description": "Candle granularity.",
            "schema": {
              "type": "string",
              "enum": ["UNKNOWN_GRANULARITY", "ONE_MINUTE", "FIVE_MINUTE", "FIFTEEN_MINUTE", "THIRTY_MINUTE", "ONE_HOUR", "TWO_HOUR", "SIX_HOUR", "ONE_DAY"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of candles to return (max 350).",
            "schema": { "type": "integer", "format": "int32", "maximum": 350 }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with candle data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "candles": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Candle" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/market/products/{product_id}/ticker": {
      "get": {
        "operationId": "getPublicMarketTrades",
        "summary": "Get Public Market Trades",
        "description": "Get market trades for a product (no authentication required).",
        "tags": ["Public"],
        "security": [],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "description": "The trading pair (e.g. BTC-USD).",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Number of trades to return.",
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp.",
            "schema": { "type": "string" }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with market trades.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trades": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Trade" }
                    },
                    "best_bid": { "type": "string" },
                    "best_ask": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A JWT signed using your CDP API Key Secret, encoded in base64."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - invalid parameters or malformed request.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - invalid or missing authentication credentials.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "Error type." },
          "code": { "type": "integer", "format": "int32", "description": "Error code." },
          "message": { "type": "string", "description": "Human-readable error message." },
          "details": {
            "type": "array",
            "items": { "type": "object" },
            "description": "Additional error context."
          }
        }
      },
      "Amount": {
        "type": "object",
        "required": ["value", "currency"],
        "properties": {
          "value": { "type": "string", "description": "Monetary amount." },
          "currency": { "type": "string", "description": "Currency code." }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "description": "Unique account identifier." },
          "name": { "type": "string", "description": "Account name." },
          "currency": { "type": "string", "description": "Account currency." },
          "available_balance": { "$ref": "#/components/schemas/Amount" },
          "default": { "type": "boolean", "description": "Whether this is the default account." },
          "active": { "type": "boolean", "description": "Whether the account is active." },
          "created_at": { "type": "string", "format": "date-time", "description": "Account creation timestamp." },
          "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp." },
          "deleted_at": { "type": "string", "format": "date-time", "description": "Deletion timestamp if applicable." },
          "type": { "$ref": "#/components/schemas/AccountType" },
          "ready": { "type": "boolean", "description": "Whether the account is ready for trading." },
          "hold": { "$ref": "#/components/schemas/Amount" },
          "retail_portfolio_id": { "type": "string", "description": "Associated portfolio ID." },
          "platform": { "$ref": "#/components/schemas/AccountPlatform" }
        }
      },
      "AccountType": {
        "type": "string",
        "enum": ["ACCOUNT_TYPE_UNSPECIFIED", "ACCOUNT_TYPE_CRYPTO", "ACCOUNT_TYPE_FIAT", "ACCOUNT_TYPE_VAULT", "ACCOUNT_TYPE_PERP_FUTURES"]
      },
      "AccountPlatform": {
        "type": "string",
        "enum": ["ACCOUNT_PLATFORM_UNSPECIFIED", "ACCOUNT_PLATFORM_CONSUMER", "ACCOUNT_PLATFORM_CFM_CONSUMER", "ACCOUNT_PLATFORM_INTX"]
      },
      "ListAccountsResponse": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Account" }
          },
          "has_next": { "type": "boolean", "description": "Whether additional pages exist." },
          "cursor": { "type": "string", "description": "Pagination cursor." },
          "size": { "type": "integer", "format": "int32", "description": "Number of accounts returned." }
        },
        "required": ["accounts", "has_next"]
      },
      "OrderSide": {
        "type": "string",
        "enum": ["BUY", "SELL"]
      },
      "OrderStatus": {
        "type": "string",
        "enum": ["PENDING", "OPEN", "FILLED", "CANCELLED", "EXPIRED", "FAILED", "UNKNOWN_ORDER_STATUS", "QUEUED", "CANCEL_QUEUED", "EDIT_QUEUED"]
      },
      "OrderType": {
        "type": "string",
        "enum": ["UNKNOWN_ORDER_TYPE", "MARKET", "LIMIT", "STOP", "STOP_LIMIT", "BRACKET", "TWAP", "ROLL_OPEN", "ROLL_CLOSE", "LIQUIDATION", "SCALED"]
      },
      "TimeInForce": {
        "type": "string",
        "enum": ["UNKNOWN_TIME_IN_FORCE", "GOOD_UNTIL_DATE_TIME", "GOOD_UNTIL_CANCELLED", "IMMEDIATE_OR_CANCEL", "FILL_OR_KILL"]
      },
      "ProductType": {
        "type": "string",
        "enum": ["UNKNOWN_PRODUCT_TYPE", "SPOT", "FUTURE"]
      },
      "ContractExpiryType": {
        "type": "string",
        "enum": ["UNKNOWN_CONTRACT_EXPIRY_TYPE", "EXPIRING", "PERPETUAL"]
      },
      "MarginType": {
        "type": "string",
        "enum": ["CROSS", "ISOLATED"]
      },
      "PortfolioType": {
        "type": "string",
        "enum": ["UNDEFINED", "DEFAULT", "CONSUMER", "INTX"]
      },
      "StopDirection": {
        "type": "string",
        "enum": ["STOP_UP", "STOP_DOWN"]
      },
      "SorPreference": {
        "type": "string",
        "enum": ["SOR_PREFERENCE_UNSPECIFIED", "SOR_ENABLED", "SOR_DISABLED"]
      },
      "CostBasisMethod": {
        "type": "string",
        "enum": ["HIFO", "LIFO", "FIFO"]
      },
      "MarketMarketIoc": {
        "type": "object",
        "properties": {
          "quote_size": { "type": "string", "description": "Amount of quote currency to spend." },
          "base_size": { "type": "string", "description": "Amount of base currency to buy/sell." },
          "rfq_disabled": { "type": "boolean", "description": "Disable request-for-quote." }
        }
      },
      "MarketMarketFok": {
        "type": "object",
        "properties": {
          "quote_size": { "type": "string", "description": "Amount of quote currency." },
          "base_size": { "type": "string", "description": "Amount of base currency." },
          "rfq_disabled": { "type": "boolean", "description": "Disable request-for-quote." }
        }
      },
      "LimitLimitGtc": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string", "description": "Amount of base currency." },
          "limit_price": { "type": "string", "description": "Ceiling price for order." },
          "post_only": { "type": "boolean", "description": "Post-only flag." },
          "rfq_disabled": { "type": "boolean" }
        }
      },
      "LimitLimitGtd": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string", "description": "Amount of base currency." },
          "limit_price": { "type": "string", "description": "Ceiling price for order." },
          "end_time": { "type": "string", "format": "date-time", "description": "Time at which the order expires." },
          "post_only": { "type": "boolean", "description": "Post-only flag." },
          "rfq_disabled": { "type": "boolean" }
        }
      },
      "LimitLimitFok": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string", "description": "Amount of base currency." },
          "limit_price": { "type": "string", "description": "Ceiling price for order." },
          "rfq_disabled": { "type": "boolean" }
        }
      },
      "SorLimitIoc": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string" },
          "limit_price": { "type": "string" },
          "rfq_disabled": { "type": "boolean" }
        }
      },
      "StopLimitStopLimitGtc": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string", "description": "Amount of base currency." },
          "limit_price": { "type": "string", "description": "Limit price." },
          "stop_price": { "type": "string", "description": "Stop trigger price." },
          "stop_direction": { "$ref": "#/components/schemas/StopDirection" }
        }
      },
      "StopLimitStopLimitGtd": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string" },
          "limit_price": { "type": "string" },
          "stop_price": { "type": "string" },
          "stop_direction": { "$ref": "#/components/schemas/StopDirection" },
          "end_time": { "type": "string", "format": "date-time" }
        }
      },
      "TriggerBracketGtc": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string" },
          "limit_price": { "type": "string" },
          "stop_trigger_price": { "type": "string", "description": "Stop-loss trigger price." }
        }
      },
      "TriggerBracketGtd": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string" },
          "limit_price": { "type": "string" },
          "stop_trigger_price": { "type": "string" },
          "end_time": { "type": "string", "format": "date-time" }
        }
      },
      "TwapLimitGtd": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string" },
          "quote_size": { "type": "string" },
          "limit_price": { "type": "string" },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "number_buckets": { "type": "integer", "format": "int32" },
          "bucket_size": { "type": "string" },
          "bucket_duration": { "type": "string" }
        }
      },
      "ScaledLimitGtc": {
        "type": "object",
        "properties": {
          "base_size": { "type": "string" },
          "quote_size": { "type": "string" },
          "num_orders": { "type": "integer", "format": "int32" },
          "min_price": { "type": "string" },
          "max_price": { "type": "string" },
          "price_distribution": { "type": "string" },
          "size_distribution": { "type": "string" }
        }
      },
      "OrderConfiguration": {
        "type": "object",
        "description": "Configuration for order type and parameters. Only one of the following should be set.",
        "properties": {
          "market_market_ioc": { "$ref": "#/components/schemas/MarketMarketIoc" },
