              "properties": {
                "id": { "type": "string" },
                "link": { "type": "object" },
                "context": { "type": "object" },
                "code": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      },
      "CreateConvertQuoteRequest": {
        "type": "object",
        "required": ["from_account", "to_account", "amount"],
        "properties": {
          "from_account": { "type": "string", "description": "Currency to convert from (e.g. USD)." },
          "to_account": { "type": "string", "description": "Currency to convert to (e.g. USDC)." },
          "amount": { "type": "string", "description": "Amount to convert (denominated in from_account currency)." },
          "trade_incentive_metadata": {
            "type": "object",
            "properties": {
              "user_incentive_id": { "type": "string", "description": "User incentive identifier." },
              "code_val": { "type": "string", "description": "Promotional code for fee waiving." }
            }
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Payment method ID." },
          "type": { "type": "string", "description": "Payment method type." },
          "name": { "type": "string", "description": "Display name." },
          "currency": { "type": "string", "description": "Currency code." },
          "verified": { "type": "boolean" },
          "allow_buy": { "type": "boolean" },
          "allow_sell": { "type": "boolean" },
          "allow_deposit": { "type": "boolean" },
          "allow_withdraw": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}