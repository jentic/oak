{
  "openapi": "3.0.3",
  "info": {
    "title": "REST Countries API",
    "description": "Free API providing detailed information about countries including currencies, languages, timezones, borders, capitals, population, and more. Covers 250+ countries with data synced every 4 hours from 35+ sources.",
    "version": "5.0.0",
    "contact": {
      "name": "REST Countries",
      "url": "https://restcountries.com"
    },
    "x-jentic-source-url": "https://restcountries.com"
  },
  "servers": [
    {
      "url": "https://api.restcountries.com",
      "description": "REST Countries production server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/countries/v5/codes.alpha_2/{code}": {
      "get": {
        "operationId": "getCountryByAlpha2",
        "summary": "Get country by ISO alpha-2 code",
        "description": "Fetch detailed country information by its 2-letter ISO code (e.g. US, FR, JP).",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 2, "maxLength": 2 },
            "description": "ISO 3166-1 alpha-2 country code."
          },
          {
            "name": "response_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to include in the response."
          },
          {
            "name": "omit_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to exclude from the response."
          },
          {
            "name": "pretty",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "enum": [0, 1] },
            "description": "Pretty-print the JSON response."
          }
        ],
        "responses": {
          "200": {
            "description": "Country details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Country" } } }
          },
          "404": { "description": "Country not found" }
        }
      }
    },
    "/countries/v5/codes.alpha_3/{code}": {
      "get": {
        "operationId": "getCountryByAlpha3",
        "summary": "Get country by ISO alpha-3 code",
        "description": "Fetch detailed country information by its 3-letter ISO code (e.g. USA, FRA, JPN).",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 3, "maxLength": 3 },
            "description": "ISO 3166-1 alpha-3 country code."
          },
          {
            "name": "response_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated fields to include."
          },
          {
            "name": "omit_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated fields to exclude."
          }
        ],
        "responses": {
          "200": {
            "description": "Country details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Country" } } }
          },
          "404": { "description": "Country not found" }
        }
      }
    },
    "/countries/v5": {
      "get": {
        "operationId": "searchCountries",
        "summary": "Search countries",
        "description": "Search countries by name, capital, or code using fuzzy matching. Can also filter by region, currency, or membership.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Fuzzy-match a name, capital, or code."
          },
          {
            "name": "response_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated fields to include."
          },
          {
            "name": "omit_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated fields to exclude."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Maximum number of results."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Pagination offset."
          },
          {
            "name": "pretty",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "enum": [0, 1] },
            "description": "Pretty-print the JSON response."
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching countries",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Country" } } } }
          }
        }
      }
    },
    "/countries/v5/currencies/{currency_code}": {
      "get": {
        "operationId": "getCountriesByCurrency",
        "summary": "Get countries by currency",
        "description": "Find countries that use a specific currency code (e.g. EUR, USD, GBP).",
        "parameters": [
          {
            "name": "currency_code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Currency code (e.g. EUR, USD, JPY)."
          },
          {
            "name": "response_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated fields to include."
          }
        ],
        "responses": {
          "200": {
            "description": "Countries using the specified currency",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Country" } } } }
          }
        }
      }
    },
    "/countries/v5/region/{region}": {
      "get": {
        "operationId": "getCountriesByRegion",
        "summary": "Get countries by region",
        "description": "Filter countries by geographic region (e.g. Europe, Americas, Asia, Africa, Oceania).",
        "parameters": [
          {
            "name": "region",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Region name (e.g. Europe, Americas, Asia, Africa, Oceania)."
          },
          {
            "name": "response_fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated fields to include."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Maximum number of results."
          }
        ],
        "responses": {
          "200": {
            "description": "Countries in the specified region",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Country" } } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key passed as Bearer token in Authorization header."
      }
    },
    "schemas": {
      "Country": {
        "type": "object",
        "properties": {
          "names": {
            "type": "object",
            "properties": {
              "common": { "type": "string" },
              "official": { "type": "string" },
              "native": { "type": "object", "additionalProperties": { "type": "object", "properties": { "common": { "type": "string" }, "official": { "type": "string" } } } }
            }
          },
          "codes": {
            "type": "object",
            "properties": {
              "alpha_2": { "type": "string" },
              "alpha_3": { "type": "string" },
              "ccn3": { "type": "string" }
            }
          },
          "capitals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "primary": { "type": "boolean" },
                "coordinates": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } }
              }
            }
          },
          "flag": {
            "type": "object",
            "properties": {
              "emoji": { "type": "string" },
              "url_svg": { "type": "string", "format": "uri" },
              "url_png": { "type": "string", "format": "uri" }
            }
          },
          "region": { "type": "string" },
          "subregion": { "type": "string" },
          "population": { "type": "integer" },
          "area": { "type": "object", "properties": { "kilometers": { "type": "number" }, "miles": { "type": "number" } } },
          "borders": { "type": "array", "items": { "type": "string" } },
          "calling_codes": { "type": "array", "items": { "type": "string" } },
          "currencies": {
            "type": "array",
            "items": { "type": "object", "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "symbol": { "type": "string" } } }
          },
          "languages": {
            "type": "array",
            "items": { "type": "object", "properties": { "name": { "type": "string" }, "bcp47": { "type": "string" } } }
          },
          "timezones": { "type": "array", "items": { "type": "string" } },
          "tlds": { "type": "array", "items": { "type": "string" } },
          "memberships": {
            "type": "object",
            "properties": {
              "un": { "type": "boolean" },
              "eu": { "type": "boolean" },
              "nato": { "type": "boolean" },
              "g7": { "type": "boolean" },
              "g20": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
