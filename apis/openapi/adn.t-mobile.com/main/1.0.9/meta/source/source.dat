    "schemas": {
      "LineItem": {
        "type": "object",
        "properties": {
          "ratePlan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9]+$"
          },
          "preferredAreaCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "pattern": "^[A-Za-z0-9]+$"
          },
          "preferredZipCode": {
            "type": "string",
            "description": "preferred zipCode of the phone number to be activated",
            "example": 98001,
            "minLength": 4,
            "maxLength": 10,
            "pattern": "^\\d{5}(-\\d{4})?$"
          },
          "lineItemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9]+$"
          },
          "ppuAddress": {
            "type": "object",
            "properties": {
              "addressLine1": {
                "type": "string"
              },
              "addressLine2": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "zipCode": {
                "type": "string"
              },
              "country": {
                "type": "string"
              }
            }
          },
          "e911Address": {
            "type": "object",
            "properties": {
              "addressLine1": {
                "type": "string"
              },
              "addressLine2": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "zipCode": {
                "type": "string"
              },
              "country": {
                "type": "string"
              }
            }
          },
          "device": {
            "type": "object",
            "properties": {
              "deviceSKU": {
                "type": "string"
              },
              "deviceEnrollmentId": {
                "type": "string"
              },
              "deviceEnrollmentOptOut": {
                "type": "boolean"
              }
            }
          },
          "accessories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accessorySKU": {
                  "type": "string"
                }
              }
            }
          },
          "addOns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "addOnSKU": {
                  "type": "string"
                }
              }
            }
          },
          "quantity": {
            "type": "integer",
            "description": "Number of times this line item (plan with selected products) should be ordered",
            "example": 1
          },
          "itemTotalPrice": {
            "type": "object",
            "description": "Aggregated pricing details for this individual line item",
            "properties": {
              "oneTimeCharges": {
                "type": "object",
                "description": "One-time charges for the line item",
                "properties": {
                  "fee": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "SHIPPING",
                            "ACTIVATION"
                          ]
                        },
                        "amount": {
                          "type": "number",
                          "format": "float"
                        }
                      }
                    }
                  },
                  "deposit": {
                    "type": "number",
                    "format": "float",
                    "description": "Deposit amount"
                  },
                  "discountDueNow": {
                    "type": "number",
                    "format": "float",
                    "description": "Discount amount applied to one-time charges"
                  }
                }
              },
              "recurringCharges": {
                "type": "object",
                "description": "Recurring charges for the line item",
                "properties": {
                  "monthlyCharge": {
                    "type": "number",
                    "format": "float",
                    "description": "Standard monthly charge for this line item"
                  },
                  "discountDueMonthly": {
                    "type": "number",
                    "format": "float",
                    "description": "Discount amount applied to monthly charges"
                  }
                }
              },
              "notes": {
                "type": "array",
                "description": "Additional notes related to this line item's pricing",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "lineDetails": {
            "type": "array",
            "description": "Line information associated with line items",
            "items": {
              "type": "object",
              "properties": {
                "simNumber": {
                  "type": "string",
                  "description": "SIM number associated with the subscriber"
                },
                "phoneNumber": {
                  "type": "string",
                  "description": "Phone number assigned to the subscriber"
                },
                "statusDate": {
                  "type": "string",
                  "format": "date",
                  "description": "Date when the subscriber status got updated.For example when status code is 'active' then statusDate is activation date"
                },
                "statusCode": {
                  "type": "string",
                  "description": "Current status code of the subscriber"
                },
                "statusDescription": {
                  "type": "string",
                  "description": "Human-readable description of the subscriber status"
                },
                "eid": {
                  "type": "string",
                  "description": "EID associated with the subscriber line"
                },
                "imei": {
                  "type": "string",
                  "description": "IMEI associated with the subscriber line"
                },
                "portInRequestId": {
                  "type": "string",
                  "description": "An identifier for the original port in request.This may have been provided by the API in an earlier response when the port was initiated.",
                  "example": "12345"
                }
              }
            }
          },
          "lineType": {
            "type": "string",
            "enum": [
              "EQUIPMENTONLY",
              "ACCESSORYONLY"
            ],
            "description": "LineType provided during the order creation for these orderTypes DEVICEFULLPRICE, DEVICEINSTALLMENT, DEVICESUBSIDY,EQUIPMENTONLY,ACCESSORYONLY. Possible values returned are : EQUIPMENTONLY,ACCESSORYONLY."
          }
        }
      },
      "OrderResponse": {
        "example": {
          "orderStatus": {
            "statusCode": "COMPLETED",
            "statusDescription": "Order completed successfully",
            "statusUpdateDate": "2025-04-24T08:00:00Z"
          },
          "orderId": "d1c3a8e3-0829-4008-ad37-0065cfd8903"
        },
        "properties": {
          "orderId": {
            "description": "The unique identifier assigned to the order by T-Mobile. You will use this ID for any follow-up queries about the order. ",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[\\S ]+$",
            "type": "string",
            "example": "d1c3a8e3-0829-4008-ad37-0065cfd8900 or 10226529."
          },
          "serviceItems": {
            "type": "array",
            "description": "An array of service-item objects, each describing an action on an existing line (such as change phone number). This section will be returned only for orderType values CHANGEPHONENUMBER.",
            "items": {
              "type": "object",
              "properties": {
                "phoneNumber": {
                  "type": "string",
                  "description": "The original 10-digit phone number of the line being changed. This is the phone number provided in the request input.",
                  "example": "2065551234",
                  "minLength": 10,
                  "maxLength": 10
                },
                "newPhoneNumber": {
                  "type": "string",
                  "description": "The new 10-digit phone number assigned to the line after the change phone number is processed.",
                  "example": "2065551235",
                  "minLength": 10,
                  "maxLength": 10
                }
              }
            }
          },
          "orderStatus": {
            "description": "An object describing the status of the order. ",
            "maxLength": 256,
            "minLength": 1,
            "properties": {
              "statusCode": {
                "description": "A short code for the current order status. Examples of status codes include: **RECEIVED** (order received and pending processing), **INPROGRESS** (order is being processed), **COMPLETED** (order has finished processing), **CANCELLED**(order has cancelled).",
                "type": "string",
                "example": "RECEIVED"
              },
              "statusDescription": {
                "description": " A human-readable description of the status. This typically elaborates on the statusCode. ",
                "type": "string",
                "example": "Order received successfully for statusCode RECEIVED, or Order completed for a completed order."
              },
              "statusUpdateDate": {
                "description": "The date and time when the status was last updated. ",
                "format": "date-time",
                "type": "string",
                "example": "2025-04-24T08:00:00Z"
              }
            },
            "type": "object"
          },
          "relatedUrls": {
            "type": "array",
            "description": "A list of URLs related to this order",
            "items": {
              "type": "object",
              "description": "Details for a single related URL.",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "The category or purpose of the URL. Example values: 'Payment'."
                },
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the related URL entry."
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "The fully qualified URL for the resource, such as a payment redirect link."
                },
                "description": {
                  "type": "string",
                  "description": "A brief human-readable explanation of what this URL points to or should be used for."
                }
              }
            }
          }
        },
        "type": "object"
      },
      "OrderResponseReceived": {
        "properties": {
          "orderId": {
            "description": "The unique identifier assigned to the order by T-Mobile. You will use this ID for any follow-up queries about the order. ",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[\\S ]+$",
            "type": "string",
            "example": "d1c3a8e3-0829-4008-ad37-0065cfd8900."
          },
          "orderStatus": {
            "description": "An object describing the status of the order. ",
            "maxLength": 256,
            "minLength": 1,
            "properties": {
              "statusCode": {
                "description": "A short code for the current order status. Examples of status codes include: **RECEIVED** (order received and pending processing), **INPROGRESS** (order is being processed), **COMPLETED** (order has finished processing),**CANCELLED**(order has cancelled).",
                "type": "string",
                "example": "RECEIVED"
              },
              "statusDescription": {
                "description": " A human-readable description of the status. This typically elaborates on the statusCode. ",
                "type": "string",
                "example": "Order received successfully for statusCode RECEIVED, or Order completed for a completed order."
              },
              "statusUpdateDate": {
                "description": "The date and time when the status was last updated. ",
                "format": "date-time",
                "type": "string",
                "example": "2025-04-24T08:00:00Z"
              }
            },
            "type": "object"
          },
          "relatedUrls": {
            "type": "array",
            "description": "A list of URLs related to this order",
            "items": {
              "type": "object",
              "description": "Details for a single related URL.",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "The category or purpose of the URL. Example values: 'Payment'."
                },
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the related URL entry."
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "The fully qualified URL for the resource, such as a payment redirect link."
                },
                "description": {
                  "type": "string",
                  "description": "A brief human-readable explanation of what this URL points to or should be used for."
                }
              }
            }
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Error code relevant to the issue",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "[\\S]*$"
                },
                "userMessage": {
                  "type": "string",
                  "description": "Specific error message for individual issue",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "[\\S ]+$"
                },
                "systemMessage": {
                  "type": "string",
                  "description": "Short user-friendly message describing the error",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "[\\S ]+$"
                },
                "detailLink": {
                  "type": "string",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "[\\S ]+$"
                }
              }
            }
          }
        }
      },
      "UpdateOrderResponse": {
        "example": {
