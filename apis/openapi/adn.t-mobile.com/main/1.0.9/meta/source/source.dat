        ],
        "description": "To get detailed information about an order (including the final status, line details, tracking numbers, charges, etc.), use the /queryOrder endpoint. This endpoint returns a comprehensive view of the order.",
        "summary": "Query order",
        "tags": [
          "Orders"
        ],
        "x-api-pattern": "ExecuteFunction"
      }
    },
    "/updateOrder": {
      "put": {
        "operationId": "UpdateOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/Access-Control-Request-Headers"
          },
          {
            "$ref": "#/components/parameters/Access-Control-Request-Method"
          },
          {
            "$ref": "#/components/parameters/activity-id"
          },
          {
            "$ref": "#/components/parameters/interaction-id"
          },
          {
            "$ref": "#/components/parameters/service-transaction-id"
          },
          {
            "$ref": "#/components/parameters/session-id"
          },
          {
            "$ref": "#/components/parameters/workflow-id"
          },
          {
            "$ref": "#/components/parameters/channel-origin"
          },
          {
            "$ref": "#/components/parameters/x-auth-originator"
          },
          {
            "$ref": "#/components/parameters/x-authorization"
          },
          {
            "$ref": "#/components/parameters/idempotency-key"
          }
        ],
        "requestBody": {
          "required": true,
          "description": " Request Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string",
                    "description": "The unique order identifier, same as provided in the query and originally returned on submission. ",
                    "example": "order002"
                  },
                  "account": {
                    "type": "object",
                    "required": [
                      "billingAccountNumber"
                    ],
                    "properties": {
                      "billingAccountNumber": {
                        "type": "string",
                        "description": "The customer\u2019s T-Mobile account number used for billing. This number identifies which billing account the order applies to.",
                        "minLength": 9,
                        "maxLength": 9,
                        "example": 987654321
                      },
                      "contact": {
                        "type": "object",
                        "description": "An object with the primary contact details for this order/account. This is typically the person or entity responsible for the account or receiving communications.",
                        "properties": {
                          "type": {
                            "type": "string",
                            "description": "Indicates the type of contact. Allowed values are PRIMARY (primary account contact) or COMMUNICATIONS (alternate contact for communications). For example, use PRIMARY for the main account holder and COMMUNICATIONS for an alternate point of contact.",
                            "example": "PRIMARY",
                            "enum": [
                              "PRIMARY",
                              "COMMUNICATIONS"
                            ]
                          },
                          "firstName": {
                            "type": "string",
                            "description": "The contact\u2019s first name.",
                            "example": "Jane"
                          },
                          "middleName": {
                            "type": "string",
                            "description": "The contact\u2019s middle name or initial, if any.",
                            "example": "M"
                          },
                          "lastName": {
                            "type": "string",
                            "description": "The contact\u2019s last name.",
                            "example": "Doe"
                          },
                          "fullName": {
                            "type": "string",
                            "description": "The full name of the contact.",
                            "example": "Jane M Doe"
                          },
                          "businessName": {
                            "type": "string",
                            "description": "If the account is a business, this is the name of the business or organization.",
                            "example": "Example Corp"
                          },
                          "emailAddress": {
                            "type": "string",
                            "description": "The contact\u2019s email address. This is used for order notifications or communication.",
                            "example": "contact@example.com"
                          },
                          "phoneNumber": {
                            "type": "string",
                            "description": "The contact\u2019s phone number, used for notifications or verification. Provide as a 10-digit number (no dashes)",
                            "example": "2065551234"
                          }
                        },
                        "required": [
                          "emailAddress"
                        ]
                      }
                    }
                  },
                  "dealerCode": {
                    "type": "string",
                    "description": "A 7-digit numeric identifier uniquely assigned to each authorized T-Mobile dealer.",
                    "example": "1234567",
                    "maxLength": 7,
                    "minLength": 7,
                    "pattern": "^[0-9]{7}$"
                  },
                  "lineItems": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ratePlan": {
                          "type": "string",
                          "description": "The code of the service plan selected for this line. This is typically the SOC (Service Offer Code) or plan identifier for the mobile plan the customer is purchasing.",
                          "example": "ZBSUNBTE"
                        },
                        "preferredAreaCode": {
                          "type": "string",
                          "maxLength": 3,
                          "description": "If a new phone number is being assigned, this is the preferred 3-digit area code (NPA) for that number. The system will attempt to provide a number in this area code when preferred area code is provided in the request.",
                          "example": "425"
                        },
                        "preferredZipCode": {
                          "type": "string",
                          "description": "A 5-digit ZIP code used as an additional hint for assigning a new phone number. For example, the ZIP code helps choose a number local to a specific city or region. The system will use the zipCode only when preferredAreaCode is not provided in the request.",
                          "example": "98001"
                        },
                        "imei": {
                          "type": "string",
                          "description": "The IMEI of the device to be activated on this line. This is required in certain scenarios, for example when eid and simNumber is not provided for a BYOD (Bring Your Own Device) order. Providing the device\u2019s IMEI (15-digit number) helps verify device compatibility",
                          "example": "351234567890123"
                        },
                        "eid": {
                          "type": "string",
                          "description": "The eSIM identifier of the device (if applicable). This is required in certain scenarios, for example when imei and simNumber is not provided for a BYOD (Bring Your Own Device) order. It\u2019s a unique identifier for the eSIM chip, used when activating eSIM profiles.",
                          "example": "8909876543210987123456789"
                        },
                        "simNumber": {
                          "type": "string",
                          "description": "The ICCID of the SIM card to be used for this line. This is the serial number of a physical SIM card. If you are providing a SIM card in the order (e.g., for BYOD or device orders), include its number.",
                          "example": "8901123456789012345"
                        },
                        "lineItemId": {
                          "type": "string",
                          "description": "A client-defined unique ID for this line item (often used to correlate line items between request and response). If provided, it should be unique within the order. This ID will be returned in responses to help match the order results for each line/package.",
                          "example": "20346654"
                        },
                        "portInDetails": {
                          "type": "object",
                          "description": "An object containing information needed to port (transfer) an existing phone number from another carrier for this line. Include this section if the customer is bringing a phone number from another provider.\n\n Note:required for port-in scenarios",
                          "properties": {
                            "portInNumber": {
                              "type": "string",
                              "description": "The phone number that the customer wants to port in from the other carrier.",
                              "example": "4042554692"
                            },
                            "otherCarrierAccountNumber": {
                              "type": "string",
                              "description": "The customer\u2019s account number at the current (losing) carrier.",
                              "example": "5432109876"
                            },
                            "otherCarrierPassword": {
                              "type": "string",
                              "description": "The PIN or password for the customer\u2019s account at the other carrier (often required for port-out authorization)",
                              "example": "1234"
                            },
                            "portInDate": {
                              "type": "string",
                              "format": "date",
                              "description": "The requested UTC date for the port to occur (if scheduling a future port).The port will be completed by the end of the specified date. Format is YYYY-MM-DD.",
                              "example": "2025-07-01"
                            },
                            "portInRequestId": {
                              "type": "string",
                              "description": "An identifier for the original port in request.This may have been provided by the API in an earlier response when the port was initiated.",
                              "example": "12345"
                            },
                            "taxId": {
                              "type": "string",
                              "description": "The Tax ID associated with the other carrier\u2019s account.",
                              "example": "9999"
                            },
                            "firstName": {
                              "type": "string",
                              "description": "The first name of the account holder at the other carrier. Used for individual accounts.",
                              "example": "John"
                            },
                            "middleName": {
                              "type": "string",
                              "description": "The middle name or initial of the account holder at the other carrier, if available. Used for individual accounts.",
                              "example": "M"
                            },
                            "lastName": {
                              "type": "string",
                              "description": "The last name (surname) of the account holder at the other carrier. Used for individual accounts.",
                              "example": "Smith"
                            },
                            "fullName": {
                              "type": "string",
                              "description": "The complete name of the individual account holder at the other carrier",
                              "example": "John A. Smith"
                            },
                            "businessName": {
                              "type": "string",
                              "description": "The legal name of the business account holder at the other carrier. Used only for business accounts.",
                              "example": "ACME Corp"
                            },
                            "portInAddress": {
                              "type": "object",
                              "description": "Other Carrier Account Address \u2013 The billing/service address on file with the other carrier, associated with the number being ported.Provide this to ensure the port request matches the other carrier\u2019s records. ",
                              "properties": {
                                "addressLine1": {
                                  "type": "string",
                                  "description": "The first line of the  street address (street number and name or PO Box).",
                                  "example": "123 Test Street"
                                },
                                "addressLine2": {
                                  "type": "string",
                                  "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.)",
                                  "example": "Suite 500"
                                },
                                "city": {
                                  "type": "string",
                                  "description": "The city for the address",
                                  "example": "Tacoma"
                                },
                                "state": {
                                  "type": "string",
                                  "description": "The state or province for the address (use abbreviation for US states)",
                                  "example": "WA(Washington)."
                                },
                                "zipCode": {
                                  "type": "string",
                                  "description": "The postal code for the  address",
                                  "example": "98401"
                                },
                                "country": {
                                  "type": "string",
                                  "description": "The country for the  address. Use country name or standard code. ",
                                  "example": "USA"
                                }
                              }
                            }
                          }
                        },
                        "ppuAddress": {
                          "type": "object",
                          "description": "The primary place-of-use address for this line. This is the physical location where the device/line will primarily be used (for tax and E911 purposes). If not provided, the system may default to the billing address.",
                          "properties": {
                            "addressLine1": {
                              "type": "string",
                              "description": "The first line of the  street address (street number and name or PO Box).",
                              "example": "456 Test"
                            },
                            "addressLine2": {
                              "type": "string",
                              "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.)",
                              "example": "Apt 100"
                            },
                            "city": {
                              "type": "string",
                              "description": "The city for the address",
                              "example": "Tacoma"
                            },
                            "state": {
                              "type": "string",
                              "description": "The state or province for the address (use abbreviation for US states)",
                              "example": "WA(Washington)."
                            },
                            "zipCode": {
                              "type": "string",
                              "description": "The postal code for the  address",
                              "example": "98401"
                            },
                            "country": {
                              "type": "string",
                              "description": "The country for the  address. Use country name or standard code. ",
                              "example": "USA"
                            }
                          }
                        },
                        "e911Address": {
                          "type": "object",
                          "description": "The address to be used for E911 emergency services for this line. If provided, this is typically the same as the primary use address, but can differ. It uses the same address field structure as above. If not provided, the system may default to the ppu address.",
                          "properties": {
                            "addressLine1": {
                              "type": "string",
                              "description": "The first line of the  street address (street number and name or PO Box).",
                              "example": "456 Test"
                            },
                            "addressLine2": {
                              "type": "string",
                              "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.)",
                              "example": "Apt 100"
                            },
                            "city": {
                              "type": "string",
                              "description": "The city for the address",
                              "example": "Tacoma"
                            },
                            "state": {
                              "type": "string",
                              "description": "The state or province for the address (use abbreviation for US states)",
                              "example": "WA(Washington)."
                            },
                            "zipCode": {
                              "type": "string",
                              "description": "The postal code for the  address",
                              "example": "98401"
                            },
                            "country": {
                              "type": "string",
                              "description": "The country for the  address. Use country name or standard code. ",
                              "example": "USA"
                            }
                          }
                        },
                        "device": {
                          "description": "An object specifying a device being purchased or associated with this line. Include this if the order involves a device (e.g., a phone or tablet). (Optional for BYOD, required for device purchase).",
                          "type": "object",
                          "properties": {
                            "deviceSKU": {
                              "type": "string",
                              "description": "The stock-keeping unit code of the device being ordered. This is T-Mobile\u2019s product code for the specific device model and variant.",
                              "example": "IPHONE15-PRO-MAX"
                            },
                            "deviceEnrollmentId": {
                              "type": "string",
                              "description": "An identifier for any device enrollment program with this device. Use if the device is being enrolled in a program (for example, Apple device enrollment program)",
                              "example": "10000"
                            },
                            "deviceEnrollmentOptOut": {
                              "type": "boolean",
                              "description": "A boolean flag indicating if the customer opts out of the device enrollment program. If true, the customer chose not to enroll in an available program for this device. ",
                              "example": "true"
                            }
                          }
                        },
                        "accessories": {
                          "type": "array",
                          "description": "An array of accessory objects, each representing an accessory item being ordered along with this line. Use this if the order includes accessories (cases, chargers, etc.) tied to the line.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "accessorySKU": {
                                "type": "string",
                                "description": "The product code (SKU) of the accessory item. ",
                                "example": "WIRELESS-CHARGER"
                              }
                            }
                          }
                        },
                        "addOns": {
                          "type": "array",
                          "description": "Service Add-Ons - An array of add-on service objects for any extra services/features being added on this line.For example, international calling or insurance plans can be add-ons. ",
                          "items": {
                            "type": "object",
                            "properties": {
                              "addOnSKU": {
                                "type": "string",
                                "description": "The code for the add-on service. (This may also be referred to as SOC of the service.) ",
                                "example": "HOTSPOT-10GB"
                              }
                            }
                          }
                        },
                        "quantity": {
                          "type": "integer",
                          "description": "The number of identical items (lines or devices) to order in this line item entry. This is typically 1 for most orders. If, for example, a business is ordering multiple lines with the same configuration, this number can be higher.",
                          "example": 1
                        }
                      }
                    }
                  },
                  "serviceItems": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "phoneNumber": {
                          "type": "string",
                          "description": "The phone number of the line to be changed (cancelled, suspended, restored, or SIM swapped). Provide the 10-digit phone number for the line.",
                          "example": "9876543210",
                          "minLength": 10,
                          "maxLength": 10
                        },
                        "reasonCode": {
                          "type": "string",
                          "description": "A code indicating the reason for the cancellation, suspension, or restoration. Allowed values include LOWU and ELST, and possibly other internal codes. For example, ELST may indicate equipment lost/stolen (often used when suspending a line due to a lost device), and LOWU might be used for low usage or other account-related cancellations. CR indicates Customer/Employee request and LS indicates Lost/Stolen/Damaged SIM . (These codes are defined by T-Mobile policy.)",
                          "example": "ELST",
                          "enum": [
                            "LOWU",
                            "ELST",
                            "CR",
                            "LS"
                          ]
                        },
                        "effectiveDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date when the service action should take effect. For a cancellation or suspension, this can be immediate or a future date. If it\u2019s a future date, the action will occur on that date. Format is YYYY-MM-DD",
                          "example": "2025-10-23"
                        },
                        "futureRestoreDate": {
                          "type": "string",
                          "format": "date",
                          "description": "Used for suspensions only. If a line is being suspended (temporarily turned off), this optional field can specify the date when the line should automatically be restored (reactivated). Format is YYYY-MM-DD. If provided, the line will be reactivated on this date without further intervention.",
                          "example": "2025-11-23"
                        },
                        "waiverNeeded": {
                          "type": "boolean",
                          "description": "Used for line cancellations. A boolean indicating if a fee waiver is being requested as part of the cancellation. For example, if cancelling a line normally incurs a fee (like a device recovery fee), setting this to true indicates a request to waive that fee (often based on some policy or promotion, e.g., a \u201cDRF waiver\u201d).",
                          "example": true
                        },
                        "imei": {
                          "type": "string",
                          "description": "(New Device IMEI for SIM Swap) \u2013 Used for SIMSWAP (eSIM scenario). The IMEI of the device that will receive the new eSIM. This is required when targetSimType is eSIM, to ensure the eSIM can be downloaded/activated on the correct device. ",
                          "example": "358265073645123",
                          "minLength": 1,
                          "maxLength": 15
                        },
                        "eid": {
                          "type": "string",
                          "description": "(New eSIM EID) \u2013 Used for SIMSWAP (eSIM scenario). The embedded SIM identifier for the new eSIM to be activated. Required when targetSimType is eSIM (along with IMEI). ",
                          "example": "89049032005008888999",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "simNumber": {
                          "type": "string",
                          "description": "(New SIM Card Number) \u2013 Used for SIMSWAP (physical SIM scenario). The serial number of the new physical SIM card to activate on the line. This is required when targetSimType is pSIM (physical SIM).",
                          "example": "89012345678901234567",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "targetSimType": {
                          "type": "string",
                          "description": "Used for SIMSWAP. Indicates the type of SIM being put onto the line. Allowed values: pSIM for a physical SIM card, or eSIM for an embedded/electronic SIM. This determines which of the above fields (SIM number vs. EID/IMEI) are required.\n\n Note:Required for orderType- SIMSWAP",
                          "example": "eSIM",
                          "enum": [
                            "pSIM",
                            "eSIM"
                          ]
                        }
                      }
                    }
                  },
                  "orderAction": {
                    "type": "string",
                    "enum": [
                      "CANCELPORTIN",
                      "UPDATEPORTIN",
                      "CANCELORDER",
                      "UPDATESERVICEAGREEMENT",
                      "UPDATEINLINESIGN",
                      "SUBMITORDER"
                    ]
                  },
                  "shippingAddress": {
                    "type": "object",
                    "description": "The address where any physical items (devices, SIMs, accessories) in the order should be shipped. Include this object if the order involves shipping hardware to the customer. If all items are digital (or if no shipment is required), this can be omitted.",
                    "properties": {
                      "firstName": {
                        "type": "string",
                        "description": "First name of the person receiving the shipment. ",
                        "example": "Jane"
                      },
                      "middleName": {
                        "type": "string",
                        "description": "Middle name or initial of the recipient. ",
                        "example": "M"
                      },
                      "lastName": {
                        "type": "string",
                        "description": "Last name of the person receiving the shipment. ",
                        "example": "Doe"
                      },
                      "fullName": {
                        "type": "string",
                        "description": "Full name of the recipient (if provided, can be used for the shipping label in lieu of first/last).",
                        "example": "Jane M Doe"
                      },
                      "businessName": {
                        "type": "string",
                        "description": "If shipping to a business, the name of the company. ",
                        "example": "Logistics Team, T-Mobile(could also be put in attention if preferred)."
                      },
                      "attention": {
                        "type": "string",
                        "description": "An optional line for Attn or care-of instructions, often used to specify a department or person if businessName is used.",
                        "example": "Logistics Team (if businessName is T-Mobile, this could indicate the department)."
                      },
                      "method": {
                        "type": "string",
                        "description": "The shipping service level or method requested. Common values might include STD for standard shipping or OVN for overnight. This is typically a code",
                        "enum": [
                          "STD",
                          "OVN"
                        ],
                        "example": "OVN"
                      },
                      "emailAddress": {
                        "type": "string",
                        "description": "Email address to send shipping notifications to.",
                        "example": "shipping@example.com"
                      },
                      "phoneNumber": {
                        "type": "string",
                        "description": "Phone number of the person or location receiving the shipment, in case the carrier needs to contact. ",
                        "example": "0987654321 ",
                        "minLength": 10,
                        "maxLength": 10
                      },
                      "addressLine1": {
                        "type": "string",
                        "description": "The first line of the shipping street address (street number and name or PO Box).",
                        "example": "123 Test Street"
                      },
                      "addressLine2": {
                        "type": "string",
                        "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.). ",
                        "example": "Suite 500"
                      },
                      "city": {
                        "type": "string",
                        "description": "The city for the shipping address. ",
                        "example": "Tacoma"
                      },
                      "state": {
                        "type": "string",
                        "description": "The state or province for the shipping address (use abbreviation for US states). ",
                        "example": "WA(Washington)."
                      },
                      "zipCode": {
                        "type": "string",
                        "description": "The postal code for the shipping address. ",
                        "example": "98401"
                      },
                      "country": {
                        "type": "string",
                        "description": "The country for the shipping address. Use country name or standard code.",
                        "example": "USA"
                      }
                    }
                  },
                  "agreementAcceptanceDate": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-04-24T08:00:00Z",
                    "description": "Service agreement acceptance date and time.Required only if a service agreement is already generated before the Submit Order call (e.g., when orderAction is SUBMITORDER )."
                  },
                  "redirectUrl": {
                    "type": "string",
                    "description": "The url is required when orderAction is UPDATEINLINESIGN. Once the eSign is completed, user will be navigated to the page as per the redirectUrl."
                  }
                },
                "required": [
                  "account",
                  "orderType",
                  "orderId"
                ]
              },
