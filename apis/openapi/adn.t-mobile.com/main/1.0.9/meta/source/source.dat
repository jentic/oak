      "service-transaction-id": {
        "description": "A unique id generated by server or echoed back by server if received in request.",
        "schema": {
          "type": "string",
          "example": "23409209723"
        }
      },
      "b2b-request-id": {
        "description": "A unique request identifier generated by the server or echoed back from the request, used for tracking and correlation.",
        "schema": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z-1-90]{1,255}$",
          "example": "2af4ba4c-2a47-47dc-a265-5a1d70a06534"
        }
      },
      "interaction-id": {
        "description": "A unique identifier for the API interaction, generated by the server or echoed back from the request.",
        "schema": {
          "type": "string",
          "example": "cc688d54-50d1-49d4-8c5d-95459d1172e8"
        }
      },
      "Strict-Transport-Security": {
        "description": "Security policy indicating HTTP Strict Transport Security (HSTS) settings for the domain.",
        "schema": {
          "type": "string",
          "example": "max-age=31536000; includeSubDomains"
        }
      }
    },
    "responses": {},
    "parameters": {
      "Access-Control-Request-Headers": {
        "description": "Used in CORS pre-flight requests to list custom headers the actual request will include.",
        "in": "header",
        "name": "Access-Control-Request-Headers",
        "required": true,
        "schema": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[\\S ]*$",
          "type": "string",
          "example": "Authorization, Content-Type"
        }
      },
      "Access-Control-Request-Method": {
        "description": "Used in CORS pre-flight (browser) requests to indicate the HTTP method of the actual request. For example, POST. (Typically handled by browsers automatically and not used in direct API calls.)",
        "in": "header",
        "name": "Access-Control-Request-Method",
        "required": false,
        "schema": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "DELETE",
            "CONNECT",
            "OPTIONS",
            "TRACE"
          ],
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "type": "string",
          "example": "POST"
        }
      },
      "activity-id": {
        "in": "header",
        "name": "activity-id",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "example": "c34e7acd-384b-4c22-8b02-ba3963682508"
        },
        "description": "A unique identifier for the request, used for tracing and tracking API activity end-to-end."
      },
      "interaction-id": {
        "in": "header",
        "name": "interaction-id",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "example": "cc688d54-50d1-49d4-8c5d-95459d1172e8"
        },
        "description": "A unique ID for each API request. Use a new value for every call to ensure end-to-end traceability across systems."
      },
      "idempotency-key": {
        "description": "Optional unique key to ensure idempotency of the request.Highly recommended for safely retrying operations to prevent duplicate processing.When provided, the server will recognize repeated requests with the same key and avoid performing the operation multiple times.",
        "example": "c34e7acd-384b-4c22-8b02-ba3963682508",
        "in": "header",
        "name": "idempotency-key",
        "required": false,
        "schema": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "type": "string"
        }
      },
      "service-transaction-id": {
        "in": "header",
        "name": "service-transaction-id",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "example": "470bc1e3-fbe4-91ab-aac4-87415422078f"
        },
        "description": "A unique id for each service/api call between the layer/component. Every component/layer generate unique id for external service call."
      },
      "session-id": {
        "in": "header",
        "name": "session-id",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "example": "350b91ec-4a64-4b10-a3f3-a78c8db3924a"
        },
        "description": "A token that links multiple API calls within the same logical session or workflow, such as a user session or agent interaction."
      },
      "workflow-id": {
        "in": "header",
        "name": "workflow-id",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "example": "ACTIVATION"
        },
        "description": "Identifies the business process or workflow for the API call. Used for reporting and analytics."
      },
      "channel-origin": {
        "in": "header",
        "name": "channel-origin",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 15,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "example": "ServiceNow"
        },
        "description": "Specifies the originating system or platform through which the API request is made.Used for reporting, auditing, and engagement analysis."
      },
      "x-auth-originator": {
        "in": "header",
        "name": "x-auth-originator",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[\\S]*$",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "description": "(Originator-Auth-Token) - A JWT access token representing the original caller in a chain of API calls. Used when one service calls this API on behalf of an end-user or another service. This helps preserve the identity of the originator."
      },
      "x-authorization": {
        "in": "header",
        "name": "x-authorization",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[\\S ]*$",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "description": "(Proof-of-Possession Token) \u2013 A security token proving the caller\u2019s authorization, typically a Proof-of-Possession token or OAuth access token. This header carries the token that authenticates the API caller\u2019s identity and permissions."
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "read"
      ]
    }
  ]
}