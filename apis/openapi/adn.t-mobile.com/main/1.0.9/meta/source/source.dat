{
  "openapi": "3.0.3",
  "info": {
    "contact": {
      "email": "support@t-mobile.com",
      "name": "T-Mobile.",
      "url": "http://www.t-mobile.com"
    },
    "description": "The T-Mobile Order API v2 enables a wide range of orders including device purchases, new line activations, and service modifications. To complement order processing, the queryOrder api offers detailed tracking and visibility into order outcomes, providing insights into status, charges, line configurations, and shipment details for complete order lifecycle transparency.",
    "license": {
      "name": "T-Mobile Inc.",
      "url": "http://www.t-mobile.com"
    },
    "title": "T-Mobile Order API - v2",
    "version": "1.0.9",
    "x-data-sensitivity": "Restricted",
    "x-type-of-consumer": "P",
    "x-breadth-of-consumption": "FC",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/GABECINBIGD/t-mobile-order-api-v2/1.0.9"
  },
  "paths": {
    "/productOrder": {
      "post": {
        "operationId": "submitPartnerOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/Access-Control-Request-Headers"
          },
          {
            "$ref": "#/components/parameters/x-auth-originator"
          },
          {
            "$ref": "#/components/parameters/x-authorization"
          },
          {
            "$ref": "#/components/parameters/interaction-id"
          },
          {
            "$ref": "#/components/parameters/Access-Control-Request-Method"
          },
          {
            "$ref": "#/components/parameters/activity-id"
          },
          {
            "$ref": "#/components/parameters/service-transaction-id"
          },
          {
            "$ref": "#/components/parameters/session-id"
          },
          {
            "$ref": "#/components/parameters/workflow-id"
          },
          {
            "$ref": "#/components/parameters/channel-origin"
          },
          {
            "$ref": "#/components/parameters/idempotency-key"
          }
        ],
        "requestBody": {
          "required": true,
          "description": " Request Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account": {
                    "type": "object",
                    "required": [
                      "billingAccountNumber"
                    ],
                    "properties": {
                      "billingAccountNumber": {
                        "type": "string",
                        "description": "The customer\u2019s T-Mobile account number used for billing. This number identifies which billing account the order applies to.",
                        "minLength": 9,
                        "maxLength": 9,
                        "example": 987654321
                      },
                      "organizationId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 25,
                        "pattern": "^[0-9]$",
                        "description": "A unique identifier assigned to a top-level business account or enterprise customer within T-Mobile systems. Reserved for future use.",
                        "example": "7000000000001016610"
                      },
                      "contact": {
                        "type": "object",
                        "description": "An object with the primary contact details for this order. This is typically the person or entity responsible for the account or receiving communications.",
                        "properties": {
                          "type": {
                            "type": "string",
                            "description": "Indicates the type of contact. Allowed values are PRIMARY (primary account contact) or COMMUNICATIONS (alternate contact for communications). For example, use PRIMARY for the main account holder and COMMUNICATIONS for an alternate point of contact.",
                            "example": "PRIMARY",
                            "enum": [
                              "PRIMARY",
                              "COMMUNICATIONS"
                            ]
                          },
                          "firstName": {
                            "type": "string",
                            "description": "The contact\u2019s first name.\n\nNote : If not provided, the system will attempt to use the billing contact\u2019s first name on file. If no billing contact information is available, an error will be returned and the customer must provide this value.",
                            "example": "Jane"
                          },
                          "middleName": {
                            "type": "string",
                            "description": "The contact\u2019s middle name or initial, if any.",
                            "example": "M"
                          },
                          "lastName": {
                            "type": "string",
                            "description": "The contact\u2019s last name.\n\nNote : If not provided, the system will attempt to use the billing contact\u2019s last name on file. If no billing contact information is available, an error will be returned and the customer must provide this value.",
                            "example": "Doe"
                          },
                          "fullName": {
                            "type": "string",
                            "description": "The full name of the contact.",
                            "example": "Jane M Doe"
                          },
                          "businessName": {
                            "type": "string",
                            "description": "If the account is a business, this is the name of the business or organization.",
                            "example": "Example Corp"
                          },
                          "emailAddress": {
                            "type": "string",
                            "description": "The contact\u2019s Email address. This is used for order notifications or communication.",
                            "example": "contact@example.com"
                          },
                          "phoneNumber": {
                            "type": "string",
                            "description": "The contact\u2019s phone number, used for notifications or verification. Provide as a 10-digit number (no dashes)",
                            "example": "2065551234"
                          }
                        },
                        "required": [
                          "emailAddress"
                        ]
                      }
                    }
                  },
                  "dealerCode": {
                    "type": "string",
                    "description": "A 7-digit numeric identifier uniquely assigned to each authorized T-Mobile dealer.",
                    "example": "1234567",
                    "maxLength": 7,
                    "minLength": 7,
                    "pattern": "^[0-9]{7}$"
                  },
                  "isPortInAddressShared": {
                    "type": "boolean",
                    "description": "A boolean flag indicating whether all line items (if multiple lines are being ordered) use the same port-in address information. If set to true, you can provide one port-in address that will apply to all lines in the order (when porting phone numbers from another carrier).\n\n Note: Default is false",
                    "example": true
                  },
                  "lineItems": {
                    "type": "array",
                    "description": "An array of line item objects, each describing a new line of service or a device/accessory being ordered. This section is used for orders involving new lines or equipment. It is required for orderType values such as PURCHASE, EQUIPMENTONLY, ACCESSORYONLY, SIMONLY, DEVICEFULLPRICE, DEVICEINSTALLMENT, DEVICESUBSIDY, UPGRADEFULLPRICE, UPGRADEINSTALLMENT, UPGRADESUBSIDY, (i.e., when adding or modifying hardware or new service). Each object in the lineItems array represents one line or item package in the order.\n\n Multi line items are supported for DEVICEFULLPRICE, DEVICEINSTALLMENT,DEVICESUBSIDY, UPGRADEFULLPRICE, UPGRADEINSTALLMENT, UPGRADESUBSIDY, EQUIPMENTONLY, ACCESSORYONLY, SIMONLY,PURCHASE.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ratePlan": {
                          "type": "string",
                          "description": "The code of the service plan selected for this line. This is typically the SOC (Service Offer Code) or plan identifier for the mobile plan the customer is purchasing.",
                          "example": "ZBSUNBTE"
                        },
                        "preferredAreaCode": {
                          "type": "string",
                          "maxLength": 3,
                          "description": "If a new phone number is being assigned, this field specifies the preferred 3-digit area code (NPA) for that number. The system will attempt to assign a number within the provided area code when available. For non-voice lines the system may assign a non-geographic area code instead, as these lines are not tied to a specific location.",
                          "example": "425"
                        },
                        "preferredZipCode": {
                          "type": "string",
                          "description": "A 5-digit ZIP code used as an additional hint for assigning a new phone number. The ZIP code helps the system choose a number local to a specific city or region when a preferredAreaCode is not provided. For non-voice lines, this field is ignored, and a non-geographic number may be assigned.",
                          "example": "98001"
                        },
                        "imei": {
                          "type": "string",
                          "description": "The IMEI of the device to be activated on this line. This is required in certain scenarios, for example when eid and simNumber is not provided for a use your own device order. Providing the device\u2019s IMEI (15-digit number) helps verify device compatibility",
                          "example": "356938035643809"
                        },
                        "eid": {
                          "type": "string",
                          "description": "The eSIM identifier of the device (if applicable). This is required in certain scenarios, for example when imei and simNumber is not provided for a use your own device order. It\u2019s a unique identifier for the eSIM chip, used when activating eSIM profiles.",
                          "example": "89049032000000000000000000000001"
                        },
                        "simNumber": {
                          "type": "string",
                          "description": "The ICCID of the SIM card to be used for this line. This is the serial number of a physical SIM card. If you are providing a SIM card in the order (e.g., for use your own device or device orders), include its number.",
                          "example": "89012601234567890120"
                        },
                        "lineItemId": {
                          "type": "string",
                          "description": "A client-defined unique ID for this line item (often used to correlate line items between request and response). If provided, it should be unique within the order. This ID will be returned in responses to help match the order results for each line/package.",
                          "example": "20346654"
                        },
                        "portInDetails": {
                          "type": "array",
                          "description": "List of port in details with information needed to port (transfer) an existing phone number from another carrier for this line. \n\n Note:required for port-in scenarios",
                          "items": {
                            "type": "object",
                            "description": "An object containing information needed to port (transfer) an existing phone number from another carrier for this line. Include this section if the customer is bringing a phone number from another provider.",
                            "properties": {
                              "portInNumber": {
                                "type": "string",
                                "description": "The phone number that the customer wants to port in from the other carrier.",
                                "example": "4042554692"
                              },
                              "otherCarrierAccountNumber": {
                                "type": "string",
                                "description": "The customer\u2019s account number at the current (losing) carrier.",
                                "example": "5432109876"
                              },
                              "otherCarrierPassword": {
                                "type": "string",
                                "description": "The JWE-encrypted PIN or password for the customer\u2019s account at the other carrier. The encryption uses RSA-OAEP as the key encryption algorithm and A256GCM as the content encryption method. Keys are in PKCS#1 format. The encrypted value should be provided as a JWE compact serialization string.",
                                "example": "eyJhbGciOiJSU0EtT0FFUCIsImVuYyI6IkEyNTZHQ00ifQ"
                              },
                              "portInDate": {
                                "type": "string",
                                "format": "date",
                                "description": "The requested UTC date for the port to occur (if scheduling a future port).The port-in will be completed by the end of the specified date. Format is YYYY-MM-DD.",
                                "example": "2025-07-01"
                              },
                              "taxId": {
                                "type": "string",
                                "description": "The JWE-encrypted tax id for the customer\u2019s account at the other carrier. The encryption uses RSA-OAEP as the key encryption algorithm and A256GCM as the content encryption method. Keys are in PKCS#1 format. The encrypted value should be provided as a JWE compact serialization string.",
                                "example": "eyJhbGciOiJSU0EtT0FFUCIsImVuYyI6IkEyNTZHQ00ifQ"
                              },
                              "firstName": {
                                "type": "string",
                                "description": "The first name of the account holder at the other carrier. Used for individual accounts.",
                                "example": "John"
                              },
                              "middleName": {
                                "type": "string",
                                "description": "The middle name or initial of the account holder at the other carrier, if available. Used for individual accounts.",
                                "example": "M"
                              },
                              "lastName": {
                                "type": "string",
                                "description": "The last name (surname) of the account holder at the other carrier. Used for individual accounts.",
                                "example": "Smith"
                              },
                              "fullName": {
                                "type": "string",
                                "description": "The complete name of the individual account holder at the other carrier",
                                "example": "John A. Smith"
                              },
                              "businessName": {
                                "type": "string",
                                "description": "The legal name of the business account holder at the other carrier. Used only for business accounts.",
                                "example": "ACME Corp"
                              },
                              "portInAddress": {
                                "type": "object",
                                "description": "Other Carrier Account Address \u2013 The billing/service address on file with the other carrier, associated with the number being ported.Provide this to ensure the port request matches the other carrier\u2019s records. ",
                                "properties": {
                                  "addressLine1": {
                                    "type": "string",
                                    "description": "The first line of the  street address (street number and name or PO Box).",
                                    "example": "123 Test Street"
                                  },
                                  "addressLine2": {
                                    "type": "string",
                                    "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.)",
                                    "example": "Suite 500"
                                  },
                                  "city": {
                                    "type": "string",
                                    "description": "The city for the address",
                                    "example": "Tacoma"
                                  },
                                  "state": {
                                    "type": "string",
                                    "description": "The state or province for the address (use abbreviation for US states)",
                                    "example": "WA(Washington)."
                                  },
                                  "zipCode": {
                                    "type": "string",
                                    "description": "The postal code for the  address",
                                    "example": "98401"
                                  },
                                  "country": {
                                    "type": "string",
                                    "description": "The country for the  address. Use country name or standard code. ",
                                    "example": "USA"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "ppuAddress": {
                          "type": "object",
                          "description": "The primary place-of-use address for this line. This is the physical location where the device/line will primarily be used (for tax and E911 purposes). If not provided, the system may default to the billing address.",
                          "properties": {
                            "addressLine1": {
                              "type": "string",
                              "description": "The first line of the  street address (street number and name or PO Box).",
                              "example": "456 Test"
                            },
                            "addressLine2": {
                              "type": "string",
                              "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.)",
                              "example": "Apt 100"
                            },
                            "city": {
                              "type": "string",
                              "description": "The city for the address",
                              "example": "Tacoma"
                            },
                            "state": {
                              "type": "string",
                              "description": "The state or province for the address (use abbreviation for US states)",
                              "example": "WA(Washington)."
                            },
                            "zipCode": {
                              "type": "string",
                              "description": "The postal code for the  address",
                              "example": "98401"
                            },
                            "country": {
                              "type": "string",
                              "description": "The country for the  address. Use country name or standard code. ",
                              "example": "USA"
                            }
                          }
                        },
                        "e911Address": {
                          "type": "object",
                          "description": "The address to be used for E911 emergency services for this line. If provided, this is typically the same as the primary use address, but can differ. It uses the same address field structure as above. If not provided, the system may default to the ppu address.",
                          "properties": {
                            "addressLine1": {
                              "type": "string",
                              "description": "The first line of the  street address (street number and name or PO Box).",
                              "example": "456 Test"
                            },
                            "addressLine2": {
                              "type": "string",
                              "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.)",
                              "example": "Apt 100"
                            },
                            "city": {
                              "type": "string",
                              "description": "The city for the address",
                              "example": "Tacoma"
                            },
                            "state": {
                              "type": "string",
                              "description": "The state or province for the address (use abbreviation for US states)",
                              "example": "WA(Washington)."
                            },
                            "zipCode": {
                              "type": "string",
                              "description": "The postal code for the  address",
                              "example": "98401"
                            },
                            "country": {
                              "type": "string",
                              "description": "The country for the  address. Use country name or standard code. ",
                              "example": "USA"
                            }
                          }
                        },
                        "device": {
                          "description": "An object specifying a device being purchased or associated with this line. Include this if the order involves a device (e.g., a phone or tablet). (Optional for use your own device, required for device purchase).",
                          "type": "object",
                          "properties": {
                            "deviceSKU": {
                              "type": "string",
                              "description": "The stock-keeping unit code of the device being ordered. This is T-Mobile\u2019s product code for the specific device model and variant.",
                              "example": "195949035005"
                            },
                            "deviceEnrollmentId": {
                              "type": "string",
                              "description": "A device enrollment ID is a unique identifier required to register mobile devices with automated enrollment platforms, enabling zero-touch setup and remote management. Depending on device type, valid enrollment IDs include Apple DEP ID (or ABM Org ID), Google Zero-Touch Enrollment (ZTE) ID, and Samsung Knox ID.Use this ID to link devices to your organization's device management portal during purchase.\\n\\n Note:If you do not have an enrollment ID,or need help associating your organization's portal or managing enrollment setup Contact the T-Mobile Business Sales department for initial setup and to capture necessary enrollment IDs.\n",
                              "example": "10000"
                            },
                            "deviceEnrollmentOptOut": {
                              "type": "boolean",
                              "description": "A boolean flag indicating if the customer opts out of the device enrollment program. If true, the customer chose not to enroll in an available program for this device. ",
                              "example": "true"
                            },
                            "targetSimType": {
                              "type": "string",
                              "description": "Specifies the type of SIM the customer requests for the line. This value indicates whether the line should be activated using an eSIM, a physical SIM (pSIM). Possible values are: 'eSIM' for embedded SIM, 'pSIM' for physical SIM.",
                              "default": "eSIM"
                            }
                          }
                        },
                        "accessories": {
                          "type": "array",
                          "description": "An array of accessory objects, each representing an accessory item being ordered along with this line. Use this if the order includes accessories (cases, chargers, etc.) tied to the line.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "accessorySKU": {
                                "type": "string",
                                "description": "The product code (SKU) of the accessory item. ",
                                "example": "195949688522"
                              }
                            }
                          }
                        },
                        "addOns": {
                          "type": "array",
                          "description": "Service Add-Ons - An array of add-on service objects for any extra services/features being added on this line.For example, international calling or insurance plans can be add-ons. ",
                          "items": {
                            "type": "object",
                            "properties": {
                              "addOnSKU": {
                                "type": "string",
                                "description": "The code for the add-on service. (This may also be referred to as SOC of the service.) ",
                                "example": "ZBUDT200"
                              }
                            }
                          }
                        },
                        "quantity": {
                          "type": "integer",
                          "description": "The number of identical items (lines or devices) to order in this line item entry. This is typically 1 for most orders. If, for example, a business is ordering multiple lines with the same configuration, this number can be higher.",
                          "example": 1,
                          "default": 1
                        },
                        "lineType": {
                          "type": "string",
                          "description": "Specifies the line type for each line item in the order. Supported lineType values are: EQUIPMENTONLY, ACCESSORYONLY, DEVICEFULLPRICE, DEVICEINSTALLMENT, and DEVICESUBSIDY.\n\nIf a lineType is provided, it takes precedence over the orderType. If lineType is not provided, the system defaults to the value of orderType.\n\nAllowed combinations:\n- If orderType = EQUIPMENTONLY \u2192 allowed lineType values: EQUIPMENTONLY, ACCESSORYONLY, and exactly one of DEVICEFULLPRICE, DEVICEINSTALLMENT, or DEVICESUBSIDY.\n- If orderType = ACCESSORYONLY \u2192 allowed lineType values: EQUIPMENTONLY, ACCESSORYONLY, and exactly one of DEVICEFULLPRICE, DEVICEINSTALLMENT, or DEVICESUBSIDY.\n- If orderType = DEVICEFULLPRICE \u2192 allowed lineType values: EQUIPMENTONLY, ACCESSORYONLY, DEVICEFULLPRICE.\n- If orderType = DEVICEINSTALLMENT \u2192 allowed lineType values: EQUIPMENTONLY, ACCESSORYONLY, DEVICEINSTALLMENT.\n- If orderType = DEVICESUBSIDY \u2192 allowed lineType values: EQUIPMENTONLY, ACCESSORYONLY, DEVICESUBSIDY.",
                          "enum": [
                            "EQUIPMENTONLY",
                            "ACCESSORYONLY",
                            "DEVICEFULLPRICE",
                            "DEVICEINSTALLMENT",
                            "DEVICESUBSIDY"
                          ]
                        }
                      }
                    }
                  },
                  "serviceItems": {
                    "type": "array",
                    "description": "An array of service-item objects, each describing an action on an existing line (such as cancel, suspend, restore service, swap SIM , change service, change phone number). This section is used for orderType values CANCELLINE, SUSPENDLINE, RESTORELINE, SIMSWAP, CHANGESERVICE, CHANGEPHONENUMBER. Include this array when the order is to modify or manage existing lines rather than add new ones. Each object in serviceItems represents one line to be affected by the service action.\n\n Note:Required for orderType - CANCELLINE, SUSPENDLINE, RESTORELINE, SIMSWAP, CHANGESERVICE, CHANGEPHONENUMBER",
                    "items": {
                      "type": "object",
                      "properties": {
                        "phoneNumber": {
                          "type": "string",
                          "description": "The phone number of the line to be changed (cancelled, suspended, restored, SIM swapped , change phone number). Provide the 10-digit phone number for the line.",
                          "example": "2065551234",
                          "minLength": 10,
                          "maxLength": 10
                        },
                        "reasonCode": {
                          "type": "string",
                          "description": "A code indicating the reason for the cancellation, suspension, restoration, SIM swap, or phone number change. Each orderType supports a specific set of reasonCode values as defined by T-Mobile policy.\n\n| Order Type | Allowed Reason Codes | Description |\n|-------------|----------------------|--------------|\n| SIMSWAP  | LS, CR | LS \u2013 Lost, stolen, or damaged SIM; CR \u2013 Customer or employee request |\n| SUSPENDLINE  | ELST, SSQ | ELST \u2013 Equipment lost or stolen; SSQ \u2013 Seasonal suspension |\n| RESTORELINE  | ELST, SSQ | ELST \u2013 Equipment lost or stolen; SSQ \u2013 Seasonal suspension |\n| CANCELLINE  | LOWU, ELST | LOWU \u2013 Low usage or account-related cancellation; ELST \u2013 Equipment lost or stolen |\n| CHANGEPHONENUMBER  | CUSTEMPMOVED, CUSTEMPREQ, HRSPHNCALLS, INCORCTNPANXX, NEWUSER. | CUSTEMPMOVED \u2013 Customer/Employee moved; CUSTEMPREQ \u2013 Customer/Employee request; HRSPHNCALLS \u2013 Harassing phone calls; INCORCTNPANXX \u2013 Incorrect area code/prefix; NEWUSER \u2013 New user |",
                          "example": "ELST",
                          "enum": [
                            "LOWU",
                            "ELST",
                            "CR",
                            "LS",
                            "SSQ",
                            "CUSTEMPMOVED",
                            "CUSTEMPREQ",
                            "HRSPHNCALLS",
                            "INCORCTNPANXX",
                            "NEWUSER"
                          ]
                        },
                        "preferredAreaCode": {
                          "type": "string",
                          "maxLength": 3,
                          "description": "If a new phone number is being assigned, this field specifies the preferred 3-digit area code (NPA) for that number. The system will attempt to assign a number within the provided area code when available. For non-voice lines (such as data-only or IoT lines), the system may assign a non-geographic area code instead, as these lines are not tied to a specific location.",
                          "example": "425"
                        },
                        "preferredZipCode": {
                          "type": "string",
                          "description": " A 5-digit ZIP code used as an additional hint for assigning a new phone number. The ZIP code helps the system choose a number local to a specific city or region when a preferredAreaCode is not provided. For non-voice lines, this field is ignored, and a non-geographic number may be assigned.",
                          "example": "98001"
                        },
                        "effectiveDate": {
                          "type": "string",
                          "format": "date",
                          "description": "The date when the service action should take effect. For a cancellation or suspension, this can be immediate or a future date. If it\u2019s a future date, the action will occur on that date. Format is YYYY-MM-DD",
                          "example": "2025-10-23"
                        },
                        "futureRestoreDate": {
                          "type": "string",
                          "format": "date",
                          "description": "Specifies the date when the line should automatically be restored (reactivated). This field is **mandatory** for reason codes `LOWU`, `CR`, `LS`, and `SSQ`, but **optional** for reason code `ELST`. Format: YYYY-MM-DD. If provided, the line will be automatically reactivated on this date without further intervention.",
                          "example": "2025-11-23"
                        },
                        "waiverNeeded": {
                          "type": "boolean",
                          "description": "Used for line cancellations. A boolean indicating if a fee waiver is being requested as part of the cancellation. For example, if cancelling a line normally incurs a fee (like a device recovery fee), setting this to true indicates a request to waive that fee (often based on some policy or promotion, e.g., a \u201cDRF waiver\u201d).",
                          "example": true
                        },
                        "imei": {
                          "type": "string",
                          "description": "(New Device IMEI for SIM Swap) \u2013 Used for SIMSWAP (eSIM scenario). The IMEI of the device that will receive the new eSIM. This is required when targetSimType is eSIM, to ensure the eSIM can be downloaded/activated on the correct device. ",
                          "example": "356938035643809",
                          "minLength": 1,
                          "maxLength": 15
                        },
                        "eid": {
                          "type": "string",
                          "description": "(New eSIM EID) \u2013 Used for SIMSWAP (eSIM scenario). The embedded SIM identifier for the new eSIM to be activated. Required when targetSimType is eSIM (along with IMEI). ",
                          "example": "89049032000000000000000000000001",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "simNumber": {
                          "type": "string",
                          "description": "(New SIM Card Number) \u2013 Used for SIMSWAP (physical SIM scenario). The serial number of the new physical SIM card to activate on the line. This is required when targetSimType is pSIM (physical SIM).",
                          "example": "89012601234567890120",
                          "minLength": 1,
                          "maxLength": 20
                        },
                        "targetSimType": {
                          "type": "string",
                          "description": "Used for SIMSWAP. Indicates the type of SIM being put onto the line. Allowed values: pSIM for a physical SIM card, or eSIM for an embedded/electronic SIM. This determines which of the above fields (SIM number vs. EID/IMEI) are required.\n\n Note:Required for orderType- SIMSWAP",
                          "example": "eSIM",
                          "enum": [
                            "pSIM",
                            "eSIM"
                          ]
                        },
                        "ratePlan": {
                          "type": "object",
                          "properties": {
                            "currentServiceOfferCode": {
                              "type": "string",
                              "description": "The code of the currently active service plan for this line. This is typically the SOC (Service Offer Code) representing the mobile plan the customer is subscribed to."
                            },
                            "newServiceOfferCode": {
                              "type": "string",
                              "description": "The code of the new service plan selected for this line. This is typically the SOC (Service Offer Code) or plan identifier for the mobile plan the customer is purchasing or switching to."
                            },
                            "effectiveDateType": {
                              "type": "string",
                              "description": "Applicable values T(Today)/N(Next Billing Cycle)/C(Current Billing Cycle)"
                            }
                          }
                        },
                        "services": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "action": {
                                "type": "string",
                                "enum": [
                                  "ADD",
                                  "REMOVE"
                                ],
                                "description": "Specifies whether the given serviceOfferCode should be added or removed from the customer's account."
                              },
                              "serviceOfferCode": {
                                "type": "string",
                                "description": "The code representing an add-on service to be added or removed from the customer's line. This is typically the Service Offer Code (SOC) used to identify optional features such as international calling, hotspot data, or other supplemental services."
                              },
                              "effectiveDateType": {
                                "type": "string",
                                "description": "Applicable values T(Today)/N(Next Billing Cycle)/C(Current Billing Cycle)"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "orderType": {
                    "type": "string",
                    "description": "The type of order or action being performed. This field tells the API what kind of operation to execute. Allowed values are:\n\n- **PURCHASE** \u2013 Add a new line of service to the account (a new phone line with a new number or a port-in from another carrier).\n- **EQUIPMENTONLY** \u2013 Order equipment only with no new line (e.g., purchasing a device without activating a new line).\n- **ACCESSORYONLY** \u2013 Order accessories only, without any devices or lines.\n- **SIMONLY** \u2013 Order a SIM card or eSIM only (typically for BYOS, BYOD activation).\n- **DEVICEFULLPRICE** \u2013 Purchase a device at full retail price (usually without a service contract).\n- **DEVICEINSTALLMENT** \u2013 Purchase a device on an installment plan (equipment installment plan).\n- **DEVICESUBSIDY** \u2013 Purchase a new device with a subsidy (discounted upfront cost), typically tied to a new line or contract.\n- **UPGRADEFULLPRICE** \u2013 Upgrade an existing line\u2019s device by buying a new device at full price (no financing).\n- **UPGRADEINSTALLMENT** \u2013 Upgrade an existing line\u2019s device with a new device on an installment plan.\n- **UPGRADESUBSIDY** \u2013 Upgrade an existing line\u2019s device with a subsidized device (a discounted price, possibly requiring contract renewal).\n- **CANCELLINE** \u2013 Cancel (disconnect) an existing line of service on the account.\n- **SUSPENDLINE** \u2013 Temporarily suspend service on an existing line (e.g., if a device is lost or for seasonal stand-by).\n- **RESTORELINE** \u2013 Restore (re-activate) a line that was previously suspended.\n- **SIMSWAP** \u2013 Perform a SIM swap on an existing line (change the SIM card associated with the line, either to a new physical SIM or to an eSIM).\n- **CHANGESERVICE** \u2013 Perform a Rate Plan change, add or remove services on an existing line.\n- **CHANGEPHONENUMBER** \u2013 Perform a phone number change from existing number to new phone number.",
                    "enum": [
                      "PURCHASE",
                      "EQUIPMENTONLY",
                      "ACCESSORYONLY",
                      "SIMONLY",
                      "DEVICEFULLPRICE",
                      "DEVICEINSTALLMENT",
                      "DEVICESUBSIDY",
                      "UPGRADEFULLPRICE",
                      "UPGRADEINSTALLMENT",
                      "UPGRADESUBSIDY",
                      "CANCELLINE",
                      "SUSPENDLINE",
                      "RESTORELINE",
                      "SIMSWAP",
                      "CHANGESERVICE",
                      "CHANGEPHONENUMBER"
                    ]
                  },
                  "shippingAddress": {
                    "type": "object",
                    "description": "The address where any physical items (devices, SIMs, accessories) in the order should be shipped. Include this object if the order involves shipping hardware to the customer. If all items are digital (or if no shipment is required), this can be omitted.",
                    "properties": {
                      "firstName": {
                        "type": "string",
                        "description": "First name of the person receiving the shipment. ",
                        "example": "Jane"
                      },
                      "middleName": {
                        "type": "string",
                        "description": "Middle name or initial of the recipient. ",
                        "example": "M"
                      },
                      "lastName": {
                        "type": "string",
                        "description": "Last name of the person receiving the shipment. ",
                        "example": "Doe"
                      },
                      "fullName": {
                        "type": "string",
                        "description": "Full name of the recipient (if provided, can be used for the shipping label in lieu of first/last).",
                        "example": "Jane M Doe"
                      },
                      "businessName": {
                        "type": "string",
                        "description": "If shipping to a business, the name of the company. ",
                        "example": "Logistics Team, T-Mobile(could also be put in attention if preferred)."
                      },
                      "attention": {
                        "type": "string",
                        "description": "An optional line for Attn or care-of instructions, often used to specify a department or person if businessName is used.",
                        "example": "Logistics Team (if businessName is T-Mobile, this could indicate the department)."
                      },
                      "method": {
                        "type": "string",
                        "description": "The shipping service level or method requested. Common values might include STD for standard shipping or OVN for overnight. This is typically a code",
                        "enum": [
                          "STD",
                          "OVN"
                        ],
                        "example": "OVN"
                      },
                      "emailAddress": {
                        "type": "string",
                        "description": "Email address to send shipping notifications to.",
                        "example": "shipping@example.com"
                      },
                      "phoneNumber": {
                        "type": "string",
                        "description": "Phone number of the person or location receiving the shipment, in case the carrier needs to contact. ",
                        "example": "2065551234 ",
                        "minLength": 10,
                        "maxLength": 10
                      },
                      "addressLine1": {
                        "type": "string",
                        "description": "The first line of the shipping street address (street number and name or PO Box).",
                        "example": "123 Test Street"
                      },
                      "addressLine2": {
                        "type": "string",
                        "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.). ",
                        "example": "Suite 500"
                      },
                      "city": {
                        "type": "string",
                        "description": "The city for the shipping address. ",
                        "example": "Tacoma"
                      },
                      "state": {
                        "type": "string",
                        "description": "The state or province for the shipping address (use abbreviation for US states). ",
                        "example": "WA(Washington)."
                      },
                      "zipCode": {
                        "type": "string",
                        "description": "The postal code for the shipping address. ",
                        "example": "98401"
                      },
                      "country": {
                        "type": "string",
                        "description": "The country for the shipping address. Use country name or standard code.",
                        "example": "USA"
                      }
                    }
                  },
                  "paymentInfo": {
                    "type": "object",
                    "description": "payment details",
                    "properties": {
                      "paymentType": {
                        "type": "string",
                        "default": "billToBAN",
                        "description": "Indicates the payment method used or how charges are handled. Supported values are:\n- billToBAN \u2014 Bill to the customer\u2019s account.\n- CC \u2014 Pay using a credit card.\n- PO \u2014 Pay using a purchase order.\n\nPayment type rules:\n- For orderType = PURCHASE \u2192 only billToBAN and PO are supported.\n- For all other orderTypes \u2192 all three payment types (billToBAN, CC, PO) are supported."
                      },
                      "paymentAccountId": {
                        "type": "string",
                        "description": "Identifier associated with the payment account or purchase order. Required when `paymentType` is set to `PO` (purchase order) to reference the corresponding account or PO number used for billing.",
                        "example": "PO-123456"
                      }
                    }
                  },
                  "redirectUrl": {
                    "type": "string",
                    "description": "The url is required when paymentType is CC(Credit card). Once the payment is completed in paymentApp, user will be navigated to the page as per the redirectUrl provided."
                  },
                  "reviewCart": {
                    "type": "boolean",
                    "default": false,
                    "description": "Optional flag to trigger cart review before order submission. If true, the response includes the order ID and cart validation status. If false or omitted, the order is processed immediately and, if valid, returns the payment URL."
                  }
                },
                "required": [
                  "account",
                  "orderType"
                ]
              },
