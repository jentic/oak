                "$ref": "#/components/headers/Content-Type"
              },
              "Content-Length": {
                "$ref": "#/components/headers/Content-Length"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "b2b-request-id": {
                "$ref": "#/components/headers/b2b-request-id"
              },
              "service-transaction-id": {
                "$ref": "#/components/headers/service-transaction-id"
              },
              "interaction-id": {
                "$ref": "#/components/headers/interaction-id"
              },
              "Strict-Transport-Security": {
                "$ref": "#/components/headers/Strict-Transport-Security"
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "description": "The T-Mobile Order API v2 enables wireless service orders, including adding new lines, purchasing devices, and handling service actions such as restore, suspend, and cancel. It supports a wide range of order types\u2014from use your own Device and SIM-only activations to full-price device bundles with rate plans and accessories\u2014ensuring flexibility across consumer and business use cases.",
        "summary": "Product order",
        "tags": [
          "Orders"
        ],
        "x-api-pattern": "CreateInCollection"
      }
    },
    "/queryOrder": {
      "post": {
        "operationId": "queryOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/Access-Control-Request-Headers"
          },
          {
            "$ref": "#/components/parameters/x-auth-originator"
          },
          {
            "$ref": "#/components/parameters/x-authorization"
          },
          {
            "$ref": "#/components/parameters/interaction-id"
          },
          {
            "$ref": "#/components/parameters/Access-Control-Request-Method"
          },
          {
            "$ref": "#/components/parameters/activity-id"
          },
          {
            "$ref": "#/components/parameters/service-transaction-id"
          },
          {
            "$ref": "#/components/parameters/session-id"
          },
          {
            "$ref": "#/components/parameters/workflow-id"
          },
          {
            "$ref": "#/components/parameters/channel-origin"
          }
        ],
        "requestBody": {
          "required": true,
          "description": " Request Body",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "billingAccountNumber",
                  "orderId"
                ],
                "properties": {
                  "billingAccountNumber": {
                    "type": "string",
                    "description": "The billing account number of the account for which the order was placed.",
                    "minLength": 9,
                    "maxLength": 9,
                    "example": "987654321"
                  },
                  "orderId": {
                    "type": "string",
                    "description": "The order identifier returned by the original order submission (the ID you want to query)",
                    "example": "d1c3a8e3-0829-4008-ad37-0065cfd8900"
                  },
                  "orderReferenceType": {
                    "type": "string",
                    "description": "Specifies the system that generated the orderId you are submitting. Use 'PIL' if the orderId comes from the PIL system, or 'TFB' if it comes from the TFB Ordering  system. The default is 'PIL'. This value must match the origin of the provided orderId for the query to succeed.",
                    "enum": [
                      "PIL",
                      "TFB"
                    ],
                    "default": "PIL",
                    "example": "TFB"
                  }
                }
              },
              "examples": {
                "QueryOrderRequest": {
                  "summary": "Track order status",
                  "value": {
                    "billingAccountNumber": "687654368",
                    "orderId": "d1c3a8e3-0829-4008-ad37-0065cfd8900"
                  },
                  "x-exampleId": [
                    "trackOrderStatus"
                  ]
                },
                "QueryOrderRequestwithBossId": {
                  "summary": "Track order status - TFB order id",
                  "value": {
                    "billingAccountNumber": "687654376",
                    "orderId": "71234567",
                    "orderReferenceType": "TFB",
                    "emailAddress": "contact@example.com"
                  },
                  "x-exampleId": [
                    "trackOrderStatus"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string",
                      "description": "The unique order identifier, same as provided in the query and originally returned on submission. ",
                      "example": "ORD00012345678"
                    },
                    "externalIdentifiers": {
                      "type": "array",
                      "description": "List of identifiers assigned by external or integrated systems for cross-system order tracking and reconciliation.Each identifier includes the external system name and its corresponding ID",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "The unique identifier assigned by the external system.",
                            "example": "tfbOrder123"
                          },
                          "system": {
                            "type": "string",
                            "description": "The name of the external system providing the identifier.",
                            "example": "TFB"
                          }
                        }
                      }
                    },
                    "status": {
                      "type": "object",
                      "description": "An object describing the status of the order.",
                      "properties": {
                        "statusCode": {
                          "type": "string",
                          "description": "A short code for the current order status. Examples of status codes include: RECEIVED (order received and pending processing), INPROGRESS (order is being processed), COMPLETED (order has finished processing), CANCELLED (order has cancelled).",
                          "example": "RECEIVED"
                        },
                        "statusDescription": {
                          "type": "string",
                          "description": "A human-readable description of the status. This typically elaborates on the statusCode",
                          "example": "Order received successfully for statusCode RECEIVED, or Order completed for a completed order."
                        },
                        "statusUpdateDate": {
                          "type": "string",
                          "format": "date-time",
                          "description": "The date and time when the status was last updated.",
                          "example": "2025-04-24T08:00:00Z"
                        }
                      }
                    },
                    "trackingDetails": {
                      "type": "array",
                      "description": "A list of shipment tracking information for any physical items in the order. Each entry in trackingDetails corresponds to a package shipped. (If no physical shipment, this may be absent or an empty list.) ",
                      "items": {
                        "type": "object",
                        "properties": {
                          "carrier": {
                            "type": "string",
                            "description": "The shipping carrier name. ",
                            "example": "UPS"
                          },
                          "trackingNumber": {
                            "type": "string",
                            "description": "The tracking number provided by the carrier for this shipment.",
                            "example": "1Z9999W99999999999"
                          },
                          "status": {
                            "type": "string",
                            "description": "The delivery status as provided by the carrier. ",
                            "example": "shipped"
                          }
                        }
                      }
                    },
                    "account": {
                      "type": "object",
                      "description": "The account object, echoing the account details from the order. This includes the billingAccountNumber and the contact information that were used for the order. (It reflects what was on the order; if account info changed later, the order still shows the original info at time of order.)",
                      "properties": {
                        "billingAccountNumber": {
                          "type": "string",
                          "description": "The customer\u2019s T-Mobile account number used for billing. This number identifies which billing account the order applies to.",
                          "minLength": 9,
                          "maxLength": 9,
                          "example": 987654321
                        },
                        "contact": {
                          "type": "object",
                          "description": "An object with the primary contact details for this order/account. This is typically the person or entity responsible for the account or receiving communications.",
                          "properties": {
                            "type": {
                              "type": "string",
                              "description": "Indicates the type of contact. Allowed values are PRIMARY (primary account contact) or COMMUNICATIONS (alternate contact for communications). For example, use PRIMARY for the main account holder and COMMUNICATIONS for an alternate point of contact.",
                              "example": "PRIMARY",
                              "enum": [
                                "PRIMARY",
                                "COMMUNICATIONS"
                              ]
                            },
                            "firstName": {
                              "type": "string",
                              "description": "The contact\u2019s first name.",
                              "example": "Jane"
                            },
                            "middleName": {
                              "type": "string",
                              "description": "The contact\u2019s middle name or initial, if any.",
                              "example": "M"
                            },
                            "lastName": {
                              "type": "string",
                              "description": "The contact\u2019s last name.",
                              "example": "Doe"
                            },
                            "fullName": {
                              "type": "string",
                              "description": "The full name of the contact.",
                              "example": "Jane M Doe"
                            },
                            "businessName": {
                              "type": "string",
                              "description": "If the account is a business, this is the name of the business or organization.",
                              "example": "Example Corp"
                            },
                            "emailAddress": {
                              "type": "string",
                              "description": "The contact\u2019s email address. This is used for order notifications or communication.",
                              "example": "contact@example.com"
                            },
                            "phoneNumber": {
                              "type": "string",
                              "description": "The contact\u2019s phone number, used for notifications or verification. Provide as a 10-digit number (no dashes)",
                              "example": "2065551234"
                            }
                          }
                        }
                      }
                    },
                    "dealerCode": {
                      "type": "string",
                      "description": "A 7-digit numeric identifier uniquely assigned to each authorized T-Mobile dealer.",
                      "example": "1234567",
                      "maxLength": 7,
                      "minLength": 7,
                      "pattern": "^[0-9]{7}$"
                    },
                    "lineItems": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LineItem"
                      }
                    },
                    "orderType": {
                      "type": "string",
                      "description": "The type of order (same value as was submitted). This confirms what kind of order was processed ",
                      "example": " PURCHASE, EQUIPMENTONLY, CANCELPORTIN, UPDATEPORTIN, ACCESSORYONLY, SIMONLY, DEVICEFULLPRICE, DEVICEINSTALLMENT, DEVICESUBSIDY, UPGRADEFULLPRICE, UPGRADEINSTALLMENT, UPGRADESUBSIDY "
                    },
                    "shippingAddress": {
                      "type": "object",
                      "description": "The shipping address used for the order, if any. This echoes the address provided, or shows where items were shipped. ",
                      "properties": {
                        "firstName": {
                          "type": "string",
                          "description": "First name of the person receiving the shipment. ",
                          "example": "Jane"
                        },
                        "middleName": {
                          "type": "string",
                          "description": "Middle name or initial of the recipient. ",
                          "example": "M"
                        },
                        "lastName": {
                          "type": "string",
                          "description": "Last name of the person receiving the shipment. ",
                          "example": "Doe"
                        },
                        "fullName": {
                          "type": "string",
                          "description": "Full name of the recipient (if provided, can be used for the shipping label in lieu of first/last).",
                          "example": "Jane M Doe"
                        },
                        "businessName": {
                          "type": "string",
                          "description": "If shipping to a business, the name of the company. ",
                          "example": "Logistics Team, T-Mobile(could also be put in attention if preferred)."
                        },
                        "attention": {
                          "type": "string",
                          "description": "An optional line for Attn or care-of instructions, often used to specify a department or person if businessName is used.",
                          "example": "Logistics Team (if businessName is T-Mobile, this could indicate the department)."
                        },
                        "method": {
                          "type": "string",
                          "description": "The shipping service level or method requested. Common values might include STD for standard shipping or OVN for overnight. This is typically a code",
                          "enum": [
                            "STD",
                            "OVN"
                          ],
                          "example": "OVN"
                        },
                        "emailAddress": {
                          "type": "string",
                          "description": "Email address to send shipping notifications to.",
                          "example": "shipping@example.com"
                        },
                        "phoneNumber": {
                          "type": "string",
                          "description": "Phone number of the person or location receiving the shipment, in case the carrier needs to contact. ",
                          "example": "2065551234 ",
                          "minLength": 10,
                          "maxLength": 10
                        },
                        "addressLine1": {
                          "type": "string",
                          "description": "The first line of the shipping street address (street number and name or PO Box).",
                          "example": "123 Test Street"
                        },
                        "addressLine2": {
                          "type": "string",
                          "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.). ",
                          "example": "Suite 500"
                        },
                        "city": {
                          "type": "string",
                          "description": "The city for the shipping address. ",
                          "example": "Tacoma"
                        },
                        "state": {
                          "type": "string",
                          "description": "The state or province for the shipping address (use abbreviation for US states). ",
                          "example": "WA(Washington)."
                        },
                        "zipCode": {
                          "type": "string",
                          "description": "The postal code for the shipping address. ",
                          "example": "98401"
                        },
                        "country": {
                          "type": "string",
                          "description": "The country for the shipping address. Use country name or standard code.",
                          "example": "USA"
                        }
                      }
                    },
                    "billingAddress": {
                      "type": "object",
                      "description": "The billing address on the account at the time of order, as described earlier. If present, this confirms which billing address was associated with the order. ",
                      "properties": {
                        "addressLine1": {
                          "type": "string",
                          "description": "The first line of the billing street address (street number and name or PO Box).",
                          "example": "123 Test Street"
                        },
                        "addressLine2": {
                          "type": "string",
                          "description": "The second line of the street address, if needed (apartment, suite, unit, floor, etc.). ",
                          "example": "Suite 500"
                        },
                        "city": {
                          "type": "string",
                          "description": "The city for the billing address. ",
                          "example": "Tacoma"
                        },
                        "state": {
                          "type": "string",
                          "description": "The state or province for the billing address (use abbreviation for US states). ",
                          "example": "WA(Washington)."
                        },
                        "zipCode": {
                          "type": "string",
                          "description": "The postal code for the billing address. ",
                          "example": "98401"
                        },
                        "country": {
                          "type": "string",
                          "description": "The country for the billing address. Use country name or standard code.",
                          "example": "USA"
                        }
                      }
                    },
                    "paymentInfo": {
                      "type": "object",
                      "description": "Payment details, if applicable, as described in Payment Information. This will show how the charges were handled (billed or paid). ",
                      "properties": {
                        "paymentType": {
                          "type": "string",
                          "description": "A code indicating the type of payment used or how the charges are handled. Common",
                          "example": "billToBAN (bill to the account \u2013 meaning the charges are added to the customer\u2019s bill) or CC (credit card). "
                        },
                        "paymentMethod": {
                          "type": "string",
                          "description": "A description of the payment method. (e.g., Check, CreditCard,ACH)",
                          "example": "Check"
                        },
                        "paymentReference": {
                          "type": "string",
                          "description": "A reference number for the payment transaction. This could be an authorization code, order number, or any reference that helps identify the payment.",
                          "example": "pay-789123"
                        },
                        "paidAmount": {
                          "type": "number",
                          "format": "float",
                          "description": "The amount paid (or billed) in this transaction, in the specified currency. ",
                          "example": "156.5"
                        },
                        "currency": {
                          "type": "string",
                          "description": "Currency in which the amount is paid",
                          "example": "USD"
                        },
                        "paymentDate": {
                          "type": "string",
                          "format": "date-time",
                          "description": "The date/time when the payment was made or recorded",
                          "example": "2025-05-22T15:30:00Z"
                        }
                      }
                    },
                    "orderTotalPrice": {
                      "type": "object",
                      "description": "An object summarizing the total charges for the order, broken down into one-time charges (due immediately) and recurring charges (monthly), as well as any notes about pricing. This section appears once the order is processed and pricing is finalized.",
                      "properties": {
                        "oneTimeCharges": {
                          "type": "object",
                          "description": "Charges due at the time of order (one-time fees).",
                          "properties": {
                            "deposit": {
                              "type": "number",
                              "format": "float",
                              "description": "Any deposit required (often $0 for consumer orders unless specified)",
                              "example": 0
                            },
                            "fee": {
                              "type": "array",
                              "description": "An array of one-time fee items, each with a type and amount. Common fee types include SHIPPING (shipping cost) and ACTIVATION (activation fee)",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "SHIPPING",
                                      "ACTIVATION"
                                    ]
                                  },
                                  "amount": {
                                    "type": "number",
                                    "format": "float"
                                  }
                                }
                              }
                            },
                            "discountDueNow": {
                              "type": "number",
                              "format": "float",
                              "description": "Any one-time discount applied at purchase (e.g., a promotion waiving fees). This is subtracted from the fees/deposit. ",
                              "example": 5
                            },
                            "tax": {
                              "type": "number",
                              "format": "float",
                              "description": "The total sales tax charged on the one-time items (devices, fees, etc.) in the order.",
                              "example": 5
                            },
                            "totalDueToday": {
                              "type": "number",
                              "format": "float",
                              "description": "The total amount due at checkout (sum of one-time charges minus one-time discounts).",
                              "example": 40
                            }
                          }
                        },
                        "recurringCharges": {
                          "type": "object",
                          "description": "The monthly recurring charges added by this order. ",
                          "properties": {
                            "monthlyCharge": {
                              "type": "number",
                              "format": "float",
                              "description": "The total monthly cost of the new plan(s) or features added.",
                              "example": 87.34
                            },
                            "discountDueMonthly": {
                              "type": "number",
                              "format": "float",
                              "description": "Any recurring discount applied (e.g., promotional discount on the plan every month).",
                              "example": 6
                            },
                            "totalMonthly": {
                              "type": "number",
                              "format": "float",
                              "description": "The net total increase in monthly charges due to this order (monthlyCharge minus discountDueMonthly).",
                              "example": 81.34
                            }
                          }
                        },
                        "notes": {
                          "type": "array",
                          "description": "An array of informational notes about the pricing. This often includes messages such as Shipping and Tax will be calculated based on Shipping Address or other remarks relevant to the order\u2019s charges. These notes help explain how pricing was determined.",
                          "example": [
                            "Shipping and Tax will be calculated based on Shipping Address"
                          ],
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "lineItemDetails": {
                      "type": "array",
                      "description": "Possibly present in responses for complex orders. This is an array that breaks down each item in the order (devices, plans, add-ons) as separate entries.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "An internal item ID linking to the line or item (often matching a lineItemId or another reference)."
                          },
                          "quantity": {
                            "type": "integer",
                            "description": "Quantity of that specific item."
                          },
                          "product": {
                            "type": "object",
                            "description": "Details of the product or service item",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Product identifier (internal catalog ID)."
                              },
                              "sku": {
                                "type": "string",
                                "description": "Stock keeping unit for the product applicable only for hard good products"
                              },
                              "soc": {
                                "type": "string",
                                "description": "If applicable, the SOC/plan code (for plans or add-ons).",
                                "example": "ZBSBUN100"
                              },
                              "name": {
                                "type": "string",
                                "description": "Product name or plan name.",
                                "example": "T-Mobile for Business Unlimited Advanced"
                              },
                              "deviceType": {
                                "type": "string",
                                "description": "(If provided) type of device (phone, tablet, etc.)."
                              },
                              "imageUrl": {
                                "type": "string",
                                "description": "URL to an image of the product (if provided, e.g., device image).",
                                "nullable": true
                              },
                              "productType": {
                                "type": "string",
                                "description": "Type of product (Supported types: Device, RatePlan, Service , Accessory, Sim, SimStarterKit)"
                              },
                              "planType": {
                                "type": "string",
                                "description": "Type of plan associated with this product (e.g.,DigitRatePlan, Mbb, AAL-Pooling, Base-Pooling)"
                              }
                            }
                          },
                          "inventoryStatus": {
                            "type": "string",
                            "description": "Stock/inventory status of the item. Common codes: A meaning Available, O meaning Back-Ordered/Out of stock.",
                            "example": "A",
                            "nullable": true
                          },
                          "isPriceOverride": {
                            "type": "boolean",
                            "description": "Boolean indicating if the price was manually overridden for this item.",
                            "example": false
                          },
                          "itemPrice": {
                            "type": "object",
                            "description": "Pricing for this item",
                            "properties": {
                              "listPrice": {
                                "type": "number",
                                "format": "float",
                                "description": "The regular price of the item",
                                "example": 899.99
                              },
                              "offerPrice": {
                                "type": "number",
                                "format": "float",
                                "description": "The price of the item after promotions/discounts.",
                                "example": 0
                              }
                            }
                          },
                          "appliedPromotions": {
                            "type": "array",
                            "description": "A list of promotions applied to this item (if any). Typically contains promotion identifiers or details if a discount/promotion was applied.",
                            "items": {
                              "type": "string"
                            }
                          },
                          "estimatedShippingDateFrom": {
                            "type": "string",
                            "format": "date",
                            "description": "For back-ordered items, this provide an estimated date range for when the item will ship.",
                            "example": "2025-05-06"
                          },
                          "estimatedShippingDateTo": {
                            "type": "string",
                            "format": "date",
                            "description": "For back-ordered items, this provide an estimated date range for when the item will ship.",
                            "example": "2025-05-20"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "PurchaseWithFullPackageResponse": {
                    "summary": "Track order status",
                    "value": {
                      "orderId": "d1c3a8e3-0829-4008-ad37-0065cfd8900",
                      "externalIdentifiers": [
                        {
                          "id": "71234567",
                          "system": "TFB"
                        }
                      ],
                      "status": {
                        "statusCode": "COMPLETED",
                        "statusDescription": "Order is completed",
                        "statusUpdateDate": "2025-09-18T00:00:00Z"
                      },
                      "orderType": "SIMONLY",
                      "account": {
                        "billingAccountNumber": "687654368",
                        "contact": {
                          "firstName": "Jane",
                          "lastName": "Doe",
                          "type": "COMMUNICATIONS",
                          "emailAddress": "contact@example.com",
                          "phoneNumber": "9876543210"
                        }
                      },
                      "dealerCode": "0000002",
                      "shippingAddress": {
                        "firstName": "Jane",
                        "lastName": "Doe",
                        "emailAddress": "shipping@example.com",
                        "phoneNumber": "2065551234",
                        "addressLine1": "1 RAVINIA DR",
                        "city": "ATLANTA",
                        "state": "GA",
                        "zipCode": "30346"
                      },
                      "billingAddress": {
                        "addressLine1": "1 RAVINIA DR",
                        "country": "USA"
                      },
                      "paymentInfo": {
                        "paymentType": "billToBAN",
                        "paymentMethod": "Check"
                      },
                      "orderTotalPrice": {
                        "oneTimeCharges": {
                          "deposit": 0,
                          "tax": 0,
                          "totalDueToday": 0,
                          "fee": [
                            {
                              "type": "SHIPPING",
                              "amount": 0
                            },
                            {
                              "type": "ACTIVATION",
                              "amount": 0
                            }
                          ]
                        },
                        "recurringCharges": {
                          "monthlyCharge": 25
                        },
                        "notes": [
                          "Shipping and Tax will be calculated based on Shipping Address"
                        ]
                      },
                      "lineItems": [
                        {
                          "ratePlan": "ZUNLSUBB",
                          "quantity": 5,
                          "lineItemId": "12233",
                          "ppuAddress": {
                            "addressLine1": "1 RAVINIA DR",
                            "city": "ATLANTA",
                            "state": "GA",
                            "zipCode": "30346",
                            "country": "US"
                          },
