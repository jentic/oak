{
  "openapi": "3.0.0",
  "info": {
    "title": "Distribution Partner API",
    "description": "Unified API for managing distribution partner accounts (community and individual), product access configuration, content libraries, live events, embed links, and Coro music content.\n## Authentication All endpoints require a Bearer JWT token passed in the `Authorization` header. Coro endpoints additionally require the `CoroApiAccess` role.\n## Content Library Hierarchy\nLibrary > Catalog > Collection > Record\n\n## Archetypes\nContent is organized by archetype. Valid archetype route values:\n`spiro`, `discoverlive`, `stageaccess`, `zinnia`, `memorylane`, `srtechconnect`\n\n## Scoping\nMost Content Library endpoints accept optional `communityId` or `individualId`\nquery parameters to scope results to a specific distribution partner community\nor individual. These are mutually exclusive.\n\n## Pagination\nList endpoints support cursor-free pagination via `page` and `resultsPerPage` query parameters.\n",
    "version": "2.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/tvfreemedia/Distribution_Partner_v2/2.0.0"
  },
  "servers": [
    {
      "url": "https://api.engagementbundle.com/api/v2",
      "description": "Production"
    },
    {
      "url": "https://dev-api.engagementbundle.com/api/v2",
      "description": "Development"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Login",
      "description": "Authenticate and obtain a bearer token"
    },
    {
      "name": "Settings",
      "description": "Retrieve distribution partner configuration and grantable access"
    },
    {
      "name": "Community",
      "description": "Manage community (facility-level) distribution partner accounts"
    },
    {
      "name": "Individual",
      "description": "Manage individual (user-level) distribution partner accounts"
    },
    {
      "name": "Metadata",
      "description": "API metadata and schema discovery"
    },
    {
      "name": "Libraries",
      "description": "Content libraries by archetype"
    },
    {
      "name": "Catalogs",
      "description": "Catalogs within a library"
    },
    {
      "name": "Collections",
      "description": "Collections within a catalog"
    },
    {
      "name": "Records",
      "description": "Content records (video/media)"
    },
    {
      "name": "Live Events",
      "description": "Scheduled live events (parent-level only)"
    },
    {
      "name": "Embed",
      "description": "Embed bypass links for EngagementBundle"
    },
    {
      "name": "Coro: Products",
      "description": "Coro music therapy products"
    },
    {
      "name": "Coro: Libraries",
      "description": "Coro music therapy libraries and categories"
    },
    {
      "name": "Coro: Programs",
      "description": "Coro music therapy programs and media playback"
    },
    {
      "name": "Coro: Announcements",
      "description": "Coro announcements"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "Login"
        ],
        "summary": "Log into the API",
        "description": "Log into the system with an API key to obtain a bearer token for subsequent API calls.",
        "operationId": "apiLogin",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "API key credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access granted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseSuccess"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseFailure"
                }
              }
            }
          }
        }
      }
    },
    "/metadata": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Get API metadata",
        "description": "Returns metadata about all available content including totals, last-updated\ntimestamps, archetype breakdowns, response shapes, and embed product access.\nParent-level requests also include live event metadata.\n",
        "operationId": "getMetadata",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "communityId",
            "in": "query",
            "description": "Scope to a specific DP community (mutually exclusive with individualId)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "individualId",
            "in": "query",
            "description": "Scope to a specific DP individual (mutually exclusive with communityId)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentPartnerParentMetadata"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/libraries": {
      "get": {
        "tags": [
          "Libraries"
        ],
        "summary": "List content libraries",
        "description": "Returns all content libraries the caller has access to.",
        "operationId": "getLibraries",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "communityId",
            "in": "query",
            "description": "Scope to a specific DP community (mutually exclusive with individualId)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "individualId",
            "in": "query",
            "description": "Scope to a specific DP individual (mutually exclusive with communityId)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "updatedAfter",
            "in": "query",
            "description": "Filter to items updated after this UTC datetime",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of libraries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Library"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/{archetype}/catalogs": {
      "get": {
        "tags": [
          "Catalogs"
        ],
        "summary": "List catalogs for an archetype",
        "operationId": "getCatalogs",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "archetype",
            "in": "path",
            "description": "Content archetype: spiro, discoverlive, stageaccess, zinnia, memorylane, srtechconnect",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "spiro",
                "discoverlive",
                "stageaccess",
                "zinnia",
                "memorylane",
                "srtechconnect"
              ]
            }
          },
          {
            "name": "libraryId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "communityId",
            "in": "query",
            "description": "Scope to a specific DP community (mutually exclusive with individualId)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "individualId",
            "in": "query",
            "description": "Scope to a specific DP individual (mutually exclusive with communityId)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "updatedAfter",
            "in": "query",
            "description": "Filter to items updated after this UTC datetime",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "resultsPerPage",
            "in": "query",
            "required": false,
            "schema": {
              "maximum": 100,
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of catalogs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedCatalogResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
