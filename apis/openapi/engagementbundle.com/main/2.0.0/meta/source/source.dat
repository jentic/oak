              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": true,
              "message": "An error occurred. CorrelationId: 3fa85f64-5717-4562-b3fc-2c963f66afa6"
            }
          }
        }
      }
