    "/coro/Programs/{programId}/MediaRequests": {
      "post": {
        "tags": [
          "Coro: Programs"
        ],
        "summary": "Create a media playback request",
        "description": "Passes through to the upstream Coro API to generate a time-signed\nplayback URL. Returns playback metadata including lyrics and trivia.\n",
        "operationId": "createCoroMediaRequest",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "programId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoroMediaRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Media playback data with signed URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoroMediaRequestResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream Coro API failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/distributionpartner": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Get distribution partner settings",
        "description": "Returns the authenticated partner's distribution partner type flags\nand the access levels they are permitted to grant to communities and\nindividuals.\n",
        "operationId": "getSettings",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Partner settings retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistributionPartnerSettingsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing bearer token"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/distributionpartner/community": {
      "get": {
        "tags": [
          "Community"
        ],
        "summary": "List communities",
        "description": "Returns a paginated list of communities belonging to the authenticated partner.",
        "operationId": "listCommunities",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "resultsPerPage",
            "in": "query",
            "required": false,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated community list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Community"
        ],
        "summary": "Create a community",
        "description": "Creates a new community distribution partner account. A facility name\nand facility address are required. Access configuration determines which\nproducts the community can use.\n",
        "operationId": "createCommunity",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommunityCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Community created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
