            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/embed": {
      "get": {
        "tags": [
          "Embed"
        ],
        "summary": "Get embed bypass links",
        "description": "Returns embed bypass URLs for the EngagementBundle application.\nEach enabled product returns two URLs (key pair for rotation).\n\n**Access rules:**\n- Parent `CanEmbed` must be true (master toggle)\n- Parent-level: checks per-product `CanGrant*Embed` flags\n- Community-level: checks per-product `*Embed` flags\n- Individual-level: not supported (no embed flags)\n\n**Supported products:** Spiro, DiscoverLive, DiscoverLiveBooking, StageAccess,\nZinnia, MemoryLane, SrTechConnect, SrTechConnectBooking, Artfull,\nTotalBrainHealth, MemoryCo\n\nReturns 404 if embed is not supported in the current environment\n(EngagementBundle endpoint not configured).\n",
        "operationId": "getEmbedLinks",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "communityId",
            "in": "query",
            "description": "Scope to a specific community's embed access",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Embed bypass links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
