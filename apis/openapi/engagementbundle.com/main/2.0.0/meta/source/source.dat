  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "apikey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginResponseSuccess": {
        "type": "object",
        "properties": {
          "isError": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "tokenData": {
            "$ref": "#/components/schemas/TokenData"
          }
        }
      },
      "LoginResponseFailure": {
        "type": "object",
        "properties": {
          "isError": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Error Message"
          },
          "tokenData": {
            "type": "object",
            "nullable": true
          }
        }
      },
