    "/{archetype}/liveevents": {
      "get": {
        "tags": [
          "Live Events"
        ],
        "summary": "List live events for an archetype",
        "description": "Live events are parent-level only - no communityId or individualId scoping.\nCancelled events are excluded from the response.\n",
        "operationId": "getLiveEvents",
        "parameters": [
          {
            "name": "Ocp-Apim-Subscription-Key",
            "in": "header",
            "description": "Subscription key used to access the API",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "archetype",
            "in": "path",
            "description": "Content archetype: spiro, discoverlive, stageaccess, zinnia, memorylane, srtechconnect",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "spiro",
                "discoverlive",
                "stageaccess",
                "zinnia",
                "memorylane",
                "srtechconnect"
              ]
            }
          },
          {
            "name": "updatedAfter",
            "in": "query",
            "description": "Filter to items updated after this UTC datetime",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "resultsPerPage",
            "in": "query",
