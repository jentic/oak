    "parameters": {
      "archetypePath": {
        "name": "archetype",
        "in": "path",
        "description": "Content archetype: spiro, discoverlive, stageaccess, zinnia, memorylane, srtechconnect",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "spiro",
            "discoverlive",
            "stageaccess",
            "zinnia",
            "memorylane",
            "srtechconnect"
          ]
        }
      },
      "communityId": {
        "name": "communityId",
        "in": "query",
        "description": "Scope to a specific DP community (mutually exclusive with individualId)",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "individualId": {
        "name": "individualId",
        "in": "query",
        "description": "Scope to a specific DP individual (mutually exclusive with communityId)",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "updatedAfter": {
        "name": "updatedAfter",
        "in": "query",
        "description": "Filter to items updated after this UTC datetime",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "minimum": 1,
          "type": "integer",
          "default": 1
        }
      },
      "resultsPerPage": {
        "name": "resultsPerPage",
        "in": "query",
        "required": false,
        "schema": {
          "maximum": 100,
          "type": "integer",
          "default": 100
        }
      },
      "coroLibraryId": {
        "name": "libraryId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "coroCategoryId": {
        "name": "categoryId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "coroProgramId": {
        "name": "programId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
