{
  "openapi": "3.0.3",
  "info": {
    "title": "Mono API",
    "description": "Mono is an open banking platform for Africa enabling account linking, financial data access, payments, identity verification, and data enrichment. Supports NGN (Nigeria), GHC (Ghana), KSH (Kenya), and ZAR (South Africa) currencies. Figures in API responses are in the lowest denomination (e.g. Kobo for NGN).",
    "version": "2.0.0",
    "contact": {
      "name": "Mono",
      "url": "https://docs.mono.co"
    },
    "x-jentic-source-url": "https://docs.mono.co/api",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.withmono.com",
      "description": "Mono API (sandbox and production determined by API key type)"
    }
  ],
  "security": [
    {
      "secretKey": []
    }
  ],
  "paths": {
    "/v2/accounts/initiate": {
      "post": {
        "operationId": "initiateAccountLinking",
        "summary": "Initiate account linking",
        "description": "Starts the account linking flow for connecting a user's bank account.",
        "tags": ["Authorization"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer"],
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "Customer ID"
                  },
                  "institution": {
                    "type": "string",
                    "description": "Institution code"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account linking initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2/accounts/auth": {
      "post": {
        "operationId": "exchangeAuthToken",
        "summary": "Exchange authorization token",
        "description": "Exchanges a temporary authorization code for a permanent account ID.",
        "tags": ["Authorization"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "Temporary authorization code from Connect widget"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token exchanged successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Permanent account ID"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}": {
      "get": {
        "operationId": "getAccountDetails",
        "summary": "Get account details",
        "description": "Retrieves details of a linked bank account.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Account details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Account not found"
          }
        }
      }
    },
    "/v2/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "List all linked accounts",
        "description": "Retrieves all linked bank accounts.",
        "tags": ["Accounts"],
        "responses": {
          "200": {
            "description": "List of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/identity": {
      "get": {
        "operationId": "getAccountIdentity",
        "summary": "Get account identity",
        "description": "Retrieves the identity information associated with a linked account.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Account identity information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/balance": {
      "get": {
        "operationId": "getAccountBalance",
        "summary": "Get account balance",
        "description": "Retrieves the current balance of a linked account. Amount is in lowest denomination.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Account balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/transactions": {
      "get": {
        "operationId": "getAccountTransactions",
        "summary": "Get account transactions",
        "description": "Retrieves transactions for a linked account.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          },
          {
            "name": "start",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date filter"
          },
          {
            "name": "end",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date filter"
          },
          {
            "name": "paginate",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Enable pagination"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Number of records per page"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Page number"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/income": {
      "get": {
        "operationId": "getAccountIncome",
        "summary": "Get income data",
        "description": "Retrieves income information from the linked account.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Income data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/creditworthiness": {
      "post": {
        "operationId": "assessCreditworthiness",
        "summary": "Assess creditworthiness",
        "description": "Performs a creditworthiness assessment based on the account data.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Creditworthiness assessment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/unlink": {
      "post": {
        "operationId": "unlinkAccount",
        "summary": "Unlink account",
        "description": "Unlinks a previously connected bank account.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Account unlinked successfully"
          }
        }
      }
    },
    "/v2/accounts/{id}/statement": {
      "get": {
        "operationId": "getStatement",
        "summary": "Retrieve bank statements",
        "description": "Retrieves bank statements for a linked account.",
        "tags": ["Statements"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Statement period"
          },
          {
            "name": "output",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["json", "pdf"]
            },
            "description": "Output format"
          }
        ],
        "responses": {
          "200": {
            "description": "Statement data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/credits": {
      "get": {
        "operationId": "getCreditTransactions",
        "summary": "Get credit transactions",
        "description": "Retrieves only credit (inflow) transactions for the account.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Credit transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/accounts/{id}/debits": {
      "get": {
        "operationId": "getDebitTransactions",
        "summary": "Get debit transactions",
        "description": "Retrieves only debit (outflow) transactions for the account.",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Debit transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/customers": {
      "post": {
        "operationId": "createCustomer",
        "summary": "Create a customer",
        "description": "Creates a new customer record. Required before using Payments and Connect products.",
        "tags": ["Customers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Customer full name"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["individual", "business"],
                    "description": "Customer type"
                  },
                  "identity": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "Identity type (e.g. bvn, nin)"
                      },
                      "number": {
                        "type": "string",
                        "description": "Identity number"
                      }
                    }
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "street": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string"
                      },
                      "postal_code": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "get": {
        "operationId": "listCustomers",
        "summary": "List all customers",
        "description": "Retrieves a list of all customers.",
        "tags": ["Customers"],
        "responses": {
          "200": {
            "description": "Customer list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/customers/{id}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "Retrieve a customer",
        "description": "Gets details of a specific customer.",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Customer ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found"
          }
        }
      },
      "patch": {
        "operationId": "updateCustomer",
        "summary": "Update a customer",
        "description": "Updates a customer's details.",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Customer ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer updated"
          }
        }
      },
      "delete": {
        "operationId": "deleteCustomer",
        "summary": "Delete a customer",
        "description": "Deletes a customer record.",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Customer ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer deleted"
          },
          "404": {
            "description": "Customer not found"
          }
        }
      }
    },
    "/v2/customers/{id}/transactions": {
      "get": {
        "operationId": "getCustomerTransactions",
        "summary": "Get customer transactions",
        "description": "Retrieves transactions for a specific customer across all linked accounts.",
        "tags": ["Customers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Customer ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/payments/initiate": {
      "post": {
        "operationId": "initiatePayment",
        "summary": "Initiate a one-time payment",
        "description": "Initiates a one-time payment (DirectPay) or a mandate authorization for direct debit.",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "type", "reference"],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Amount in lowest denomination (e.g. kobo)"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["onetime-debit", "recurring-debit"],
                    "description": "Payment type"
                  },
                  "description": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string",
                    "description": "Unique payment reference"
                  },
                  "account": {
                    "type": "string",
                    "description": "Account ID for the payment"
                  },
                  "redirect_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL to redirect after payment"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/v2/payments/verify/{reference}": {
      "get": {
        "operationId": "verifyPayment",
        "summary": "Verify payment status",
        "description": "Checks the status of a payment using its reference.",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Payment reference"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found"
          }
        }
      }
    },
    "/v2/payments/transactions": {
      "get": {
        "operationId": "listPayments",
        "summary": "List all payments",
        "description": "Retrieves all payment transactions.",
        "tags": ["Payments"],
        "responses": {
          "200": {
            "description": "Payment list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/payments/refund": {
      "post": {
        "operationId": "refundPayment",
        "summary": "Refund a payment",
        "description": "Issues a refund for a completed payment.",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reference"],
                "properties": {
                  "reference": {
                    "type": "string",
                    "description": "Original payment reference"
                  },
                  "amount": {
                    "type": "integer",
                    "description": "Refund amount in lowest denomination (optional for partial refund)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund processed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/lookup/bvn/initiate": {
      "post": {
        "operationId": "initiateBvnLookup",
        "summary": "Initiate BVN lookup",
        "description": "Initiates a Bank Verification Number lookup.",
        "tags": ["Lookup"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["bvn"],
                "properties": {
                  "bvn": {
                    "type": "string",
                    "description": "11-digit BVN"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "BVN lookup initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/lookup/banks": {
      "get": {
        "operationId": "listBanks",
        "summary": "List banks (NIP)",
        "description": "Retrieves the list of supported banks via NIP.",
        "tags": ["Lookup"],
        "responses": {
          "200": {
            "description": "Bank list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/lookup/account-number": {
      "post": {
        "operationId": "lookupAccountNumber",
        "summary": "Account number lookup",
        "description": "Verifies a bank account number and returns account holder details.",
        "tags": ["Lookup"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["account_number", "bank_code"],
                "properties": {
                  "account_number": {
                    "type": "string",
                    "description": "Bank account number"
                  },
                  "bank_code": {
                    "type": "string",
                    "description": "Bank code from bank listing"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/institutions": {
      "get": {
        "operationId": "getBankCoverage",
        "summary": "Get bank coverage",
        "description": "Retrieves the list of supported financial institutions and their capabilities.",
        "tags": ["Miscellaneous"],
        "responses": {
          "200": {
            "description": "Institution list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v3/payments/mandates": {
      "post": {
        "operationId": "createMandate",
        "summary": "Create a direct debit mandate",
        "description": "Creates a new direct debit mandate for recurring payments.",
        "tags": ["Direct Debit"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
