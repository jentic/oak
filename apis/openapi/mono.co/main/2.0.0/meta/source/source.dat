                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "Customer ID"
                  },
                  "amount": {
                    "type": "integer",
                    "description": "Mandate amount in lowest denomination"
                  },
                  "reference": {
                    "type": "string",
                    "description": "Unique mandate reference"
                  },
                  "account_number": {
                    "type": "string"
                  },
                  "bank_code": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mandate created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
