{
  "openapi": "3.0.3",
  "info": {
    "title": "Zhipu AI GLM API",
    "description": "Zhipu AI (智谱AI) large language model API platform providing access to GLM series models including GLM-4, GLM-4V (vision), text embeddings, image generation, and more. China-focused AI platform with OpenAI-compatible API structure.",
    "version": "4.0.0",
    "contact": {
      "name": "Zhipu AI",
      "url": "https://open.bigmodel.cn/"
    },
    "x-jentic-source-url": "https://open.bigmodel.cn/dev/api",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://open.bigmodel.cn/api/paas/v4",
      "description": "Zhipu AI GLM API v4 Production Server"
    }
  ],
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "Create chat completion",
        "description": "Creates a model response for the given chat conversation. Supports text, vision (image input), and tool use. Compatible with OpenAI chat completions format.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "ID of the model to use (e.g., glm-4, glm-4v, glm-4-plus, glm-4-air, glm-4-airx, glm-4-long, glm-4-flash, glm-4-flashx)",
                    "example": "glm-4"
                  },
                  "messages": {
                    "type": "array",
                    "description": "A list of messages comprising the conversation so far",
                    "items": {
                      "$ref": "#/components/schemas/ChatMessage"
                    }
                  },
                  "temperature": {
                    "type": "number",
                    "description": "Sampling temperature between 0 and 1. Higher values make output more random.",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.95
                  },
                  "top_p": {
                    "type": "number",
                    "description": "Nucleus sampling parameter. Top-p probability mass.",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.7
                  },
                  "max_tokens": {
                    "type": "integer",
                    "description": "Maximum number of tokens to generate in the response",
                    "default": 1024
                  },
                  "stream": {
                    "type": "boolean",
                    "description": "If true, partial message deltas will be sent as SSE events",
                    "default": false
                  },
                  "stop": {
                    "description": "Up to 4 sequences where the API will stop generating further tokens",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 4
                      }
                    ]
                  },
                  "tools": {
                    "type": "array",
                    "description": "A list of tools the model may call",
                    "items": {
                      "$ref": "#/components/schemas/Tool"
                    }
                  },
                  "tool_choice": {
                    "type": "string",
                    "description": "Controls which tool is called. 'auto' lets the model decide.",
                    "enum": [
                      "auto",
                      "none"
                    ],
                    "default": "auto"
                  },
                  "do_sample": {
                    "type": "boolean",
                    "description": "Whether to use sampling for generation. If false, uses greedy decoding.",
                    "default": true
                  },
                  "request_id": {
                    "type": "string",
                    "description": "A unique identifier for this request, used for troubleshooting"
                  },
                  "user_id": {
                    "type": "string",
                    "description": "A unique identifier representing the end-user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful chat completion response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error - invalid API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/embeddings": {
      "post": {
        "operationId": "createEmbedding",
        "summary": "Create text embeddings",
        "description": "Creates an embedding vector representing the input text. Useful for text similarity, search, and clustering.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "ID of the embedding model to use (e.g., embedding-2, embedding-3)",
                    "example": "embedding-2"
                  },
                  "input": {
                    "type": "string",
                    "description": "Input text to embed. Maximum length varies by model."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful embedding response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "embedding": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          },
                          "index": {
                            "type": "integer"
                          },
                          "object": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "object": {
                      "type": "string"
                    },
                    "usage": {
                      "$ref": "#/components/schemas/Usage"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      }
    },
    "/images/generations": {
      "post": {
        "operationId": "createImageGeneration",
        "summary": "Generate images from text",
        "description": "Creates an image given a prompt. Uses CogView model for image generation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "The model to use for image generation (e.g., cogview-3-plus, cogview-3)",
                    "example": "cogview-3-plus"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "A text description of the desired image"
                  },
                  "size": {
                    "type": "string",
                    "description": "The size of the generated image",
                    "enum": [
                      "1024x1024",
                      "768x1344",
                      "864x1152",
                      "1344x768",
                      "1152x864",
                      "1440x720",
                      "720x1440"
                    ],
                    "default": "1024x1024"
                  },
                  "user_id": {
                    "type": "string",
                    "description": "A unique identifier representing the end-user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful image generation response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "integer",
                      "description": "Unix timestamp of creation"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "description": "URL of the generated image"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      }
    },
    "/videos/generations": {
      "post": {
        "operationId": "createVideoGeneration",
        "summary": "Generate video from text or image",
        "description": "Creates a video generation task given a prompt. Uses CogVideoX model. This is an asynchronous operation - use the task status endpoint to check completion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "The model to use for video generation (e.g., cogvideox-2, cogvideox)",
                    "example": "cogvideox-2"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "A text description of the desired video"
                  },
                  "image_url": {
                    "type": "string",
                    "description": "Optional image URL to use as the first frame for image-to-video generation"
                  },
                  "request_id": {
                    "type": "string",
                    "description": "A unique identifier for this request"
                  },
                  "user_id": {
                    "type": "string",
                    "description": "A unique identifier representing the end-user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video generation task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncTaskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      }
    },
    "/async-result/{task_id}": {
      "get": {
        "operationId": "getAsyncResult",
        "summary": "Get async task result",
        "description": "Retrieves the result of an asynchronous task such as video generation.",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "The ID of the async task to check",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status and result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "task_status": {
                      "type": "string",
                      "enum": [
                        "PROCESSING",
                        "SUCCESS",
                        "FAIL"
                      ],
                      "description": "Current status of the async task"
                    },
                    "video_result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "cover_image_url": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      }
    },
    "/files": {
      "post": {
        "operationId": "uploadFile",
        "summary": "Upload a file",
        "description": "Upload a file that can be used across various endpoints. Supports documents for knowledge retrieval and batch processing.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "purpose"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to upload"
                  },
                  "purpose": {
                    "type": "string",
                    "description": "The intended purpose of the uploaded file (e.g., 'fine-tune', 'batch')",
                    "enum": [
                      "fine-tune",
                      "batch",
                      "retrieval"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileObject"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      },
      "get": {
        "operationId": "listFiles",
        "summary": "List uploaded files",
        "description": "Returns a list of files that have been uploaded.",
        "parameters": [
          {
            "name": "purpose",
            "in": "query",
            "description": "Filter by purpose",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of files to return",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor for pagination - return files after this ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FileObject"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      }
    },
    "/files/{file_id}": {
      "delete": {
        "operationId": "deleteFile",
        "summary": "Delete a file",
        "description": "Delete a previously uploaded file.",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "description": "The ID of the file to delete",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "deleted": {
                      "type": "boolean"
                    },
                    "object": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/files/{file_id}/content": {
      "get": {
        "operationId": "getFileContent",
        "summary": "Get file content",
        "description": "Returns the contents of the specified file.",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "description": "The ID of the file",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File content returned successfully"
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/batches": {
      "post": {
        "operationId": "createBatch",
        "summary": "Create a batch processing job",
        "description": "Creates a new batch processing job for bulk API requests.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input_file_id",
                  "endpoint",
                  "completion_window"
                ],
                "properties": {
                  "input_file_id": {
                    "type": "string",
                    "description": "The ID of the uploaded file containing batch requests"
                  },
                  "endpoint": {
                    "type": "string",
                    "description": "The endpoint to use for the batch (e.g., /v4/chat/completions)",
                    "enum": [
                      "/v4/chat/completions",
                      "/v4/embeddings"
                    ]
                  },
                  "completion_window": {
                    "type": "string",
                    "description": "Time frame for batch completion",
                    "enum": [
                      "24h"
                    ]
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Optional metadata for the batch"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchObject"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      },
      "get": {
        "operationId": "listBatches",
        "summary": "List batch jobs",
        "description": "Returns a list of batch processing jobs.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of batches to return",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Cursor for pagination",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of batches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BatchObject"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      }
    },
    "/batches/{batch_id}": {
      "get": {
        "operationId": "getBatch",
        "summary": "Get batch job details",
        "description": "Retrieves a batch processing job by ID.",
        "parameters": [
          {
            "name": "batch_id",
            "in": "path",
            "required": true,
            "description": "The ID of the batch",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Batch details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchObject"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          },
          "404": {
            "description": "Batch not found"
          }
        }
      }
    },
    "/batches/{batch_id}/cancel": {
      "post": {
        "operationId": "cancelBatch",
        "summary": "Cancel a batch job",
        "description": "Cancels an in-progress batch processing job.",
        "parameters": [
          {
            "name": "batch_id",
            "in": "path",
            "required": true,
            "description": "The ID of the batch to cancel",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Batch cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchObject"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Zhipu AI API key. Obtain from https://open.bigmodel.cn/. Pass as Bearer token in Authorization header."
      }
    },
    "schemas": {
      "ChatMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "description": "The role of the message author"
          },
          "content": {
            "description": "The content of the message. Can be a string or an array of content parts for multimodal input.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image_url"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "image_url": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool calls generated by the model",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "arguments": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "Tool call ID when role is tool"
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function",
              "web_search",
              "retrieval"
            ],
            "description": "The type of tool"
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of the function"
              },
              "description": {
                "type": "string",
                "description": "A description of what the function does"
              },
              "parameters": {
                "type": "object",
                "description": "The parameters the function accepts, described as a JSON Schema object"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the completion"
          },
          "created": {
            "type": "integer",
            "description": "Unix timestamp of when the completion was created"
          },
          "model": {
            "type": "string",
            "description": "The model used for the completion"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls",
                    "sensitive",
                    "network_error"
                  ]
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer"
          },
          "completion_tokens": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          }
        }
      },
      "AsyncTaskResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Task ID for polling the result"
          },
          "request_id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "task_status": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "SUCCESS",
              "FAIL"
            ]
          }
        }
      },
      "FileObject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "created_at": {
            "type": "integer"
          },
          "filename": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      },
      "BatchObject": {
        "type": "object",
        "properties": {
          "id": {
