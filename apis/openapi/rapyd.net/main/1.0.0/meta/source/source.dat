{
  "openapi": "3.0.3",
  "info": {
    "title": "Rapyd Payments Platform API",
    "description": "Rapyd global fintech-as-a-service platform API providing payment processing, refunds, checkout pages, customer management, and e-wallet operations. Supports 900+ payment methods across 100+ countries with unified API access.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.rapyd.net/build-with-rapyd/reference"
  },
  "servers": [
    {
      "url": "https://api.rapyd.net",
      "description": "Rapyd Production Server"
    },
    {
      "url": "https://sandboxapi.rapyd.net",
      "description": "Rapyd Sandbox Server"
    }
  ],
  "security": [
    {
      "rapydSignature": []
    }
  ],
  "paths": {
    "/v1/payments": {
      "post": {
        "operationId": "createPayment",
        "summary": "Create a payment",
        "description": "Creates a new payment with the specified amount, currency, and payment method. Supports card payments, bank transfers, e-wallets, and 900+ local payment methods.",
        "parameters": [
          {
            "name": "idempotency",
            "in": "header",
            "description": "Unique idempotency key to prevent duplicate payment creation",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid signature or access key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listPayments",
        "summary": "List payments",
        "description": "Retrieves a list of payments with optional filtering by customer, payment method, wallet, date range, and other criteria.",
        "parameters": [
          {
            "name": "created_after",
            "in": "query",
            "description": "Payment ID created before the first payment to retrieve",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "description": "Payment ID created after the last payment to retrieve",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customer",
            "in": "query",
            "description": "Filter by customer ID (cus_)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ewallet",
            "in": "query",
            "description": "Filter by wallet ID (ewallet_)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "description": "Include group payments (default false)",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "invoice",
            "in": "query",
            "description": "Filter by invoice ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (1-100, default 10)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "merchant_reference_id",
            "in": "query",
            "description": "Client-defined reference ID (max 45 characters)",
            "schema": {
              "type": "string",
              "maxLength": 45
            }
          },
          {
            "name": "payment_method",
            "in": "query",
            "description": "Filter by payment method ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subscription",
            "in": "query",
            "description": "Filter by subscription ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of payments retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Payment"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid filter parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments/{paymentId}": {
      "get": {
        "operationId": "retrievePayment",
        "summary": "Retrieve a payment",
        "description": "Retrieves the details of a specific payment by its ID.",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "Payment ID starting with payment_",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payment ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelPayment",
        "summary": "Cancel a payment",
        "description": "Cancels a payment. Only works when payment status is ACT and the payment method has is_cancelable set to true.",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "Payment ID starting with payment_",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment canceled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Payment cannot be canceled (already closed or not cancelable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/refunds": {
      "post": {
        "operationId": "createRefund",
        "summary": "Create a refund",
        "description": "Creates a refund for a completed payment. Supports full and partial refunds with optional wallet allocation.",
        "parameters": [
          {
            "name": "idempotency",
            "in": "header",
            "description": "Unique idempotency key to prevent duplicate refund creation",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRefundRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid amount or exceeds payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listRefunds",
        "summary": "List refunds",
        "description": "Retrieves a list of refunds with optional pagination. Date range cannot exceed 90 days.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of refunds to return (1-100, default 10)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "description": "Refund ID (refund_) for forward pagination",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ending_before",
            "in": "query",
            "description": "Refund ID (refund_) for backward pagination",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of refunds retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Refund"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters or date range exceeds 90 days",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/checkout": {
      "post": {
        "operationId": "createCheckoutPage",
        "summary": "Create a checkout page",
        "description": "Creates a hosted checkout page that presents available payment methods to the customer. Returns a redirect URL for the hosted page.",
        "parameters": [
          {
            "name": "idempotency",
            "in": "header",
            "description": "Unique idempotency key to prevent duplicate checkout creation",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout page created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers": {
      "post": {
        "operationId": "createCustomer",
        "summary": "Create a customer",
        "description": "Creates a new customer profile that can be associated with payments, subscriptions, and payment methods.",
        "parameters": [
          {
            "name": "idempotency",
            "in": "header",
            "description": "Unique idempotency key to prevent duplicate customer creation",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing required fields or invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers/{customerId}": {
      "get": {
        "operationId": "retrieveCustomer",
        "summary": "Retrieve a customer",
        "description": "Retrieves the details of a specific customer by their ID.",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer ID starting with cus_",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid customer ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ewallets": {
      "post": {
        "operationId": "createWallet",
        "summary": "Create an e-wallet",
        "description": "Creates a new e-wallet for a person or company. Wallets hold funds in multiple currencies and can be used for payments and payouts.",
        "parameters": [
          {
            "name": "idempotency",
            "in": "header",
            "description": "Unique idempotency key to prevent duplicate wallet creation",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWalletRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Wallet created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid fields or reference ID already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listWallets",
        "summary": "List e-wallets",
        "description": "Retrieves a list of e-wallets with optional filtering by currency, type, balance, and parent wallet.",
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "description": "Filter by currency (three-letter ISO 4217 code)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ewallet_reference_id",
            "in": "query",
            "description": "Filter by customer-defined wallet reference ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_balance",
            "in": "query",
            "description": "Filter for wallets with available balance at least this value",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page_number",
            "in": "query",
            "description": "Page number to retrieve (default 1)",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Number of results per page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "parent_ewallet",
            "in": "query",
            "description": "Filter by parent wallet ID (ewallet_)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by wallet type",
            "schema": {
              "type": "string",
              "enum": ["company", "person", "client"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of wallets retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Wallet"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ewallets/{walletId}": {
      "get": {
        "operationId": "retrieveWallet",
        "summary": "Retrieve an e-wallet",
        "description": "Retrieves the details of a specific e-wallet including balances, contacts, and verification status.",
        "parameters": [
          {
            "name": "walletId",
            "in": "path",
            "required": true,
            "description": "Wallet ID starting with ewallet_",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid wallet ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "rapydSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "signature",
        "description": "Request signature calculated using access_key, secret_key, salt, timestamp, HTTP method, URL path, and request body. Required headers: access_key, salt, signature, timestamp. All requests must include these four authentication headers."
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string",
            "description": "Error code (empty string on success)"
          },
          "status": {
            "type": "string",
            "enum": ["SUCCESS", "ERROR"],
            "description": "Overall request status"
          },
          "message": {
            "type": "string",
            "description": "Human-readable status message"
          },
          "response_code": {
            "type": "string",
            "description": "Response code"
          },
          "operation_id": {
            "type": "string",
            "description": "Unique operation identifier for support"
          }
        }
      },
      "CreatePaymentRequest": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "description": "Payment amount with ISO 4217 decimal precision"
          },
          "currency": {
            "type": "string",
            "description": "Three-letter ISO 4217 currency code"
          },
          "customer": {
            "type": "string",
            "description": "Customer ID (cus_) or customer object"
          },
          "payment_method": {
            "type": "string",
            "description": "Payment method ID or payment method object"
          },
          "description": {
            "type": "string",
            "description": "Transaction description"
          },
          "capture": {
            "type": "boolean",
            "default": true,
            "description": "Immediate capture (true) or authorization only (false)"
          },
          "ewallet": {
            "type": "string",
            "description": "Wallet ID (ewallet_) for fund destination"
          },
          "ewallets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ewallet": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "percentage": {
                  "type": "number"
                }
              }
            },
            "description": "Array of wallet allocations"
          },
          "save_payment_method": {
            "type": "boolean",
            "default": false,
            "description": "Save payment method for future use"
          },
          "statement_descriptor": {
            "type": "string",
            "maxLength": 22,
            "minLength": 5,
            "description": "Text on customer statement"
          },
          "escrow": {
            "type": "boolean",
            "description": "Hold funds in escrow"
          },
          "initiation_type": {
            "type": "string",
            "enum": ["customer_present", "recurring", "installment", "moto"],
            "description": "Transaction initiation type"
          },
          "merchant_reference_id": {
            "type": "string",
            "maxLength": 45,
            "description": "Client-defined reference ID"
          },
          "metadata": {
            "type": "object",
            "description": "Client-defined JSON metadata"
          },
          "address": {
            "type": "object",
            "description": "Billing address object",
            "properties": {
              "name": { "type": "string" },
              "line_1": { "type": "string" },
              "line_2": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "country": { "type": "string" },
              "zip": { "type": "string" }
            }
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Payment ID (payment_)"
          },
          "amount": {
            "type": "number",
            "description": "Payment amount"
          },
          "original_amount": {
            "type": "number",
            "description": "Original amount before FX"
          },
          "is_partial": {
            "type": "boolean",
            "description": "Whether partial payment"
          },
          "currency_code": {
            "type": "string",
            "description": "Three-letter ISO 4217 code"
          },
          "country_code": {
            "type": "string",
            "description": "Country code"
          },
          "status": {
            "type": "string",
            "enum": ["ACT", "CAN", "CLO", "ERR", "EXP", "REV"],
            "description": "Payment status: ACT=Active, CAN=Canceled, CLO=Closed, ERR=Error, EXP=Expired, REV=Reversed"
          },
          "description": {
            "type": "string"
          },
          "merchant_reference_id": {
            "type": "string"
          },
          "customer_token": {
            "type": "string",
            "description": "Customer ID (cus_)"
          },
          "payment_method": {
            "type": "string",
            "description": "Payment method ID"
          },
          "payment_method_data": {
            "type": "object",
            "description": "Detailed payment method information"
          },
          "payment_method_type": {
            "type": "string"
          },
          "payment_method_type_category": {
            "type": "string"
          },
          "auth_code": {
            "type": "string",
            "nullable": true
          },
          "expiration": {
            "type": "integer",
            "description": "Unix timestamp of expiration"
          },
          "captured": {
            "type": "boolean",
            "description": "Whether payment has been captured"
          },
          "refunded": {
            "type": "boolean",
            "description": "Whether payment has been refunded"
          },
          "refunded_amount": {
            "type": "number"
          },
          "receipt_email": {
            "type": "string"
          },
          "redirect_url": {
            "type": "string"
          },
          "complete_payment_url": {
            "type": "string"
          },
          "error_payment_url": {
            "type": "string"
          },
          "statement_descriptor": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string"
          },
          "created_at": {
            "type": "integer",
            "description": "Unix timestamp of creation"
          },
          "paid": {
            "type": "boolean"
          },
          "paid_at": {
            "type": "integer",
            "description": "Unix timestamp of last capture"
          },
          "failure_code": {
            "type": "string"
          },
          "failure_message": {
            "type": "string"
          },
          "ewallet_id": {
            "type": "string",
            "description": "Destination wallet ID (ewallet_)"
          },
          "ewallets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fx_rate": {
            "type": "number"
          },
          "dispute": {
            "type": "object",
            "nullable": true
          },
          "refunds": {
            "type": "object",
            "nullable": true
          },
          "escrow": {
            "type": "object",
            "nullable": true
          },
          "next_action": {
            "type": "string",
            "enum": ["3d_verification", "pending_capture", "pending_confirmation", "not_applicable"],
            "description": "Required next step for the payment"
          },
          "cancel_reason": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "data": {
            "$ref": "#/components/schemas/Payment"
          }
        }
      },
      "CreateRefundRequest": {
        "type": "object",
        "required": [
          "payment"
        ],
        "properties": {
          "payment": {
            "type": "string",
            "description": "Payment ID (payment_) to refund"
          },
          "amount": {
            "type": "number",
            "description": "Refund amount (omit for full refund)"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the refund"
          },
          "merchant_reference_id": {
            "type": "string",
            "maxLength": 45,
            "description": "Client-defined reference ID"
          },
          "ewallets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ewallet": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "percentage": {
                  "type": "number"
                }
              }
            },
            "description": "Wallet allocation for refund"
          },
          "metadata": {
            "type": "object",
            "description": "Client-defined JSON metadata"
          }
        }
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Refund ID (refund_)"
          },
          "amount": {
            "type": "number",
            "description": "Refund amount"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code"
          },
          "status": {
            "type": "string",
            "enum": ["Completed", "Pending", "Rejected", "Error", "Canceled"],
            "description": "Refund status"
          },
          "payment": {
            "type": "string",
            "description": "Associated payment ID"
          },
          "reason": {
            "type": "string"
          },
          "merchant_reference_id": {
            "type": "string"
          },
          "payment_method_type": {
            "type": "string"
          },
          "ewallets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "failure_reason": {
            "type": "string"
          },
          "failure_code": {
            "type": "string"
          },
          "fx_rate": {
            "type": "number"
          },
          "metadata": {
            "type": "object"
          },
          "created_at": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "updated_at": {
            "type": "integer",
            "description": "Unix timestamp"
          }
        }
      },
      "RefundResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "data": {
            "$ref": "#/components/schemas/Refund"
          }
        }
      },
      "CreateCheckoutRequest": {
        "type": "object",
        "required": [
          "currency",
          "country"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "description": "Payment amount (required if cart_items not specified)"
          },
          "currency": {
            "type": "string",
            "description": "Three-letter ISO 4217 code"
          },
          "country": {
            "type": "string",
            "description": "Two-letter ISO 3166-1 ALPHA-2 code"
          },
          "customer": {
            "type": "string",
            "description": "Customer ID (cus_) or customer object"
          },
          "payment_method_types_include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Payment methods to display"
          },
          "payment_method_type_categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Payment categories (card, ewallet, etc.)"
          },
          "complete_payment_url": {
            "type": "string",
            "description": "Redirect URL after successful payment"
          },
          "error_payment_url": {
            "type": "string",
            "description": "Redirect URL for failed payments"
          },
          "cart_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "amount": { "type": "number" },
                "quantity": { "type": "integer" }
              }
            },
            "description": "Cart items with name, amount, quantity"
          },
          "language": {
            "type": "string",
            "description": "Default page language"
          },
          "expiration": {
            "type": "integer",
            "description": "Unix timestamp for checkout expiration"
          },
          "metadata": {
            "type": "object",
            "description": "Client-defined JSON metadata"
          }
        }
      },
      "CheckoutResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Checkout page ID (checkout_)"
              },
              "status": {
                "type": "string",
                "enum": ["NEW", "DON", "EXP", "INP", "DEC"],
                "description": "Page status"
              },
              "redirect_url": {
                "type": "string",
                "description": "Hosted checkout page URL"
              },
              "payment": {
                "type": "object",
                "nullable": true,
                "description": "Payment details (null until submission)"
              },
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreateCustomerRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Customer name or business name"
          },
          "email": {
            "type": "string",
            "maxLength": 512,
            "description": "Customer email"
          },
          "phone_number": {
            "type": "string",
            "description": "E.164 format phone number"
          },
          "business_vat_id": {
            "type": "string",
            "description": "Tax ID number"
          },
          "description": {
            "type": "string",
            "description": "Customer description"
          },
          "invoice_prefix": {
            "type": "string",
            "description": "Custom prefix for invoices"
          },
          "ewallet": {
            "type": "string",
            "description": "Associated wallet ID (ewallet_)"
          },
          "metadata": {
            "type": "object",
            "description": "Client-defined JSON metadata"
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "line_1": { "type": "string" },
                "line_2": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "country": { "type": "string" },
                "zip": { "type": "string" }
              }
            }
          },
          "payment_method": {
            "type": "object",
            "description": "Payment method to create on customer",
            "properties": {
              "type": { "type": "string" },
              "fields": { "type": "object" }
            }
          },
          "date_of_birth": {
            "type": "string",
            "description": "Format: DD/MM/YYYY"
          },
          "birth_country": {
            "type": "string",
            "description": "ISO 3166-1 ALPHA-2 code"
          },
          "nationality": {
            "type": "string",
            "description": "ISO 3166-1 ALPHA-2 code"
          },
          "occupation": {
            "type": "string",
            "maxLength": 35
          },
          "coupon": {
            "type": "string",
            "description": "Coupon ID to assign"
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Customer ID (cus_)"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "default_payment_method": {
            "type": "string"
          },
          "payment_methods": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": { "type": "object" }
              },
              "has_more": { "type": "boolean" },
              "total_count": { "type": "integer" },
              "url": { "type": "string" }
            }
          },
          "addresses": {
            "type": "array",
            "items": { "type": "object" }
          },
          "created_at": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "delinquent": {
            "type": "boolean",
            "description": "Subscription payment failure status"
          },
          "metadata": {
            "type": "object"
          },
          "subscriptions": {
            "type": "array",
            "items": { "type": "object" }
          },
          "ewallet": {
            "type": "string"
          },
          "business_vat_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "date_of_birth": {
            "type": "string"
          },
          "birth_country": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "occupation": {
            "type": "string"
          }
        }
      },
      "CustomerResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "data": {
            "$ref": "#/components/schemas/Customer"
          }
        }
      },
      "CreateWalletRequest": {
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "type"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "description": "Wallet owner first name"
          },
          "last_name": {
            "type": "string",
            "description": "Wallet owner family name"
          },
          "type": {
            "type": "string",
            "enum": ["person", "company"],
            "description": "Wallet type"
          },
          "ewallet_reference_id": {
            "type": "string",
            "description": "Customer-defined unique wallet ID"
          },
          "parent_ewallet": {
            "type": "string",
            "description": "Parent company wallet ID (ewallet_)"
          },
          "contact": {
            "type": "object",
            "description": "Contact details"
          },
          "metadata": {
            "type": "object",
            "description": "Client-defined JSON metadata"
          }
        }
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Wallet ID (ewallet_)"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["person", "company", "client"]
          },
          "status": {
            "type": "string",
            "enum": ["ACT", "DIS", "CLO", "DEL"],
            "description": "Wallet status"
          },
          "verification_status": {
            "type": "string",
            "description": "KYC verification status"
          },
          "ewallet_reference_id": {
            "type": "string"
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "currency": { "type": "string" },
                "alias": { "type": "string" },
                "balance": { "type": "number" },
                "received_balance": { "type": "number" },
                "on_hold_balance": { "type": "number" },
                "reserve_balance": { "type": "number" }
              }
            }
          },
          "contacts": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": { "type": "object" }
              },
              "has_more": { "type": "boolean" },
              "total_count": { "type": "integer" }
            }
          },
          "parent_ewallet": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "WalletResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "data": {
            "$ref": "#/components/schemas/Wallet"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      }
    }
  }
}