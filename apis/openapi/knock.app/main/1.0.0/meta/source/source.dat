{
  "openapi": "3.0.3",
  "info": {
    "title": "Knock API",
    "description": "Knock is a notification system that provides APIs for triggering workflows, managing users, sending messages across channels, and handling notification preferences. Supports cursor-based pagination and idempotent requests.",
    "version": "1.0.0",
    "contact": {
      "name": "Knock",
      "url": "https://knock.app"
    },
    "x-jentic-source-url": "https://docs.knock.app/reference",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.knock.app/v1",
      "description": "Knock API v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/workflows/{key}/trigger": {
      "post": {
        "operationId": "triggerWorkflow",
        "summary": "Trigger a workflow",
        "description": "Triggers a workflow run for one or more recipients.",
        "tags": ["Workflows"],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The workflow key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["recipients"],
                "properties": {
                  "recipients": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of recipient user IDs"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Data payload for the workflow"
                  },
                  "actor": {
                    "type": "string",
                    "description": "The user ID of the actor triggering the workflow"
                  },
                  "cancellation_key": {
                    "type": "string",
                    "description": "Key used to cancel this workflow run later"
                  },
                  "tenant": {
                    "type": "string",
                    "description": "Tenant ID for multi-tenant workflows"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workflow triggered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "workflow_run_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/workflows/{key}/cancel": {
      "post": {
        "operationId": "cancelWorkflow",
        "summary": "Cancel a workflow",
        "description": "Cancels an in-progress workflow run using the cancellation key.",
        "tags": ["Workflows"],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The workflow key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["recipients", "cancellation_key"],
                "properties": {
                  "recipients": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "cancellation_key": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Workflow cancelled successfully" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/messages": {
      "get": {
        "operationId": "listMessages",
        "summary": "List messages",
        "description": "Returns a paginated list of messages with optional filtering.",
        "tags": ["Messages"],
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "schema": { "type": "integer", "default": 50 },
            "description": "Number of items per page"
          },
          {
            "name": "after",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Cursor for forward pagination"
          },
          {
            "name": "before",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Cursor for backward pagination"
          },
          {
            "name": "channel_id",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by channel ID"
          },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["queued", "sent", "delivered", "undelivered", "not_sent"] },
            "description": "Filter by message status"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of messages",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageList" }
              }
            }
          }
        }
      }
    },
    "/messages/{message_id}": {
      "get": {
        "operationId": "getMessage",
        "summary": "Get a message",
        "description": "Retrieves a specific message by ID.",
        "tags": ["Messages"],
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Message details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "404": { "description": "Message not found" }
        }
      }
    },
    "/messages/{message_id}/content": {
      "get": {
        "operationId": "getMessageContent",
        "summary": "Get rendered message content",
        "description": "Returns the rendered content of a specific message.",
