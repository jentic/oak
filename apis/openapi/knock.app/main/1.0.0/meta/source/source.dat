    "/users/{user_id}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get a user",
        "description": "Retrieves a specific user by ID.",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
