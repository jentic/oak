        ],
        "responses": {
          "200": {
            "description": "List of message events",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/messages/{message_id}/activities": {
      "get": {
        "operationId": "listMessageActivities",
