          }
        ],
        "responses": {
          "200": {
            "description": "Rendered message content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "404": { "description": "Message not found" }
        }
      }
    },
    "/messages/{message_id}/events": {
      "get": {
        "operationId": "listMessageEvents",
        "summary": "List message events",
