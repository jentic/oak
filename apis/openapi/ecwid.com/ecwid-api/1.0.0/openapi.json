{
  "openapi": "3.0.3",
  "info": {
    "title": "Ecwid API",
    "version": "1.0.0",
    "description": "Ecwid is an e-commerce platform. The API provides access to products, orders, customers, categories, and store profile.",
    "x-jentic-source-url": "https://developers.ecwid.com/api-documentation/api-features"
  },
  "servers": [
    {
      "url": "https://app.ecwid.com/api/v3/{storeId}",
      "variables": {
        "storeId": {
          "description": "Store ID"
        }
      }
    }
  ],
