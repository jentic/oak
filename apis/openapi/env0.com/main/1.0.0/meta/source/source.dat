{
  "openapi": "3.0.3",
  "info": {
    "title": "env0 API",
    "description": "env0 is a cloud infrastructure governance platform for IaC automation, self-service, and compliance. The API provides programmatic access to manage environments, templates (blueprints), projects, deployments, organizations, teams, variables, and more.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.env0.com/reference"
  },
  "servers": [
    {
      "url": "https://api.env0.com",
      "description": "env0 Production API"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/environments": {
      "get": {
        "operationId": "listEnvironments",
        "summary": "List environments",
        "description": "Returns a paginated list of environments with optional filtering by organization, project, status, and more.",
        "tags": ["Environments"],
        "parameters": [
          { "name": "organizationId", "in": "query", "required": false, "description": "Filter by organization ID", "schema": { "type": "string" } },
          { "name": "projectId", "in": "query", "required": false, "description": "Filter by project ID", "schema": { "type": "string" } },
          { "name": "name", "in": "query", "required": false, "description": "Filter by environment name", "schema": { "type": "string" } },
          { "name": "isActive", "in": "query", "required": false, "description": "Filter by active status", "schema": { "type": "boolean" } },
          { "name": "onlyMy", "in": "query", "required": false, "description": "Show only current user's environments", "schema": { "type": "boolean" } },
          { "name": "isRemoteBackend", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "workspaceName", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "searchText", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "description": "Max 100, default 100", "schema": { "type": "integer", "maximum": 100, "default": 100 } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "List of environments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Environment" }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createEnvironment",
        "summary": "Create an environment",
        "description": "Creates a new environment representing a deployment managed by the platform.",
        "tags": ["Environments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnvironmentCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Environment created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Environment" }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/environments/{id}": {
      "get": {
        "operationId": "getEnvironment",
        "summary": "Get an environment",
        "description": "Returns details of a specific environment.",
        "tags": ["Environments"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Environment details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Environment" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "operationId": "updateEnvironment",
        "summary": "Update an environment",
        "description": "Updates an existing environment's configuration.",
        "tags": ["Environments"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnvironmentUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Environment updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Environment" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteEnvironment",
        "summary": "Delete an environment",
        "description": "Deletes a specific environment.",
        "tags": ["Environments"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Environment deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/environments/{id}/deployments": {
      "post": {
        "operationId": "deployEnvironment",
        "summary": "Deploy an environment",
        "description": "Triggers a deployment for the specified environment.",
        "tags": ["Deployments"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeployRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deployment initiated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeploymentLog" }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "get": {
        "operationId": "listEnvironmentDeployments",
        "summary": "List deployments for an environment",
        "description": "Returns all deployment logs for a specific environment.",
        "tags": ["Deployments"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of deployments",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/DeploymentLog" } }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/environments/{id}/destroy": {
      "post": {
        "operationId": "destroyEnvironment",
        "summary": "Destroy an environment",
        "description": "Triggers destruction of an environment's managed infrastructure.",
        "tags": ["Environments"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "skipStateRefresh", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "requiresApproval", "in": "query", "required": false, "schema": { "type": "boolean" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "triggerName": { "type": "string", "enum": ["user", "terraform-cli", "workflow", "cd", "prPlan", "driftDetection", "ttl", "scheduled", "comment", "import", "driftRemediation"] },
                  "comment": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Destroy initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List projects",
        "description": "Returns all projects for an organization.",
        "tags": ["Projects"],
        "parameters": [
          { "name": "organizationId", "in": "query", "required": true, "description": "Organization ID to filter by", "schema": { "type": "string" } },
          { "name": "isArchived", "in": "query", "required": false, "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createProject",
        "summary": "Create a project",
        "description": "Creates a new project within an organization.",
        "tags": ["Projects"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Project created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "summary": "Get a project",
        "description": "Returns details of a specific project.",
        "tags": ["Projects"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Project details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "operationId": "updateProject",
        "summary": "Update a project",
        "description": "Updates an existing project.",
        "tags": ["Projects"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Project updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "summary": "Delete a project",
        "description": "Archives/deletes a project.",
        "tags": ["Projects"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Project deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/blueprints": {
      "get": {
        "operationId": "listTemplates",
        "summary": "List templates",
        "description": "Returns all templates (blueprints) for an organization or project. At least one of organizationId or projectId must be set.",
        "tags": ["Templates"],
        "parameters": [
          { "name": "organizationId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "projectId", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of templates",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Template" } }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createTemplate",
        "summary": "Create a template",
        "description": "Creates a new template (blueprint) for infrastructure deployments.",
        "tags": ["Templates"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TemplateCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Template created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Template" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/blueprints/{id}": {
      "get": {
        "operationId": "getTemplate",
        "summary": "Get a template",
        "description": "Returns details of a specific template.",
        "tags": ["Templates"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Template details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Template" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "operationId": "updateTemplate",
        "summary": "Update a template",
        "description": "Updates an existing template.",
        "tags": ["Templates"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TemplateCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Template updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Template" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteTemplate",
        "summary": "Delete a template",
        "description": "Deletes a specific template.",
        "tags": ["Templates"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Template deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/organizations": {
      "get": {
        "operationId": "listOrganizations",
        "summary": "List organizations",
        "description": "Returns all organizations the authenticated user has access to.",
        "tags": ["Organizations"],
        "responses": {
          "200": {
            "description": "List of organizations",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Organization" } }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/organizations/{id}": {
      "get": {
        "operationId": "getOrganization",
        "summary": "Get an organization",
        "description": "Returns details of a specific organization.",
        "tags": ["Organizations"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Organization details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Organization" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/configuration": {
      "get": {
        "operationId": "listConfigurationVariables",
        "summary": "List configuration variables",
        "description": "Returns configuration variables for a given scope (organization, project, or environment).",
        "tags": ["Configuration"],
        "parameters": [
          { "name": "organizationId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "environmentId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "blueprintId", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of configuration variables",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ConfigurationVariable" } }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createConfigurationVariable",
        "summary": "Create a configuration variable",
        "description": "Creates a new configuration variable at the specified scope.",
        "tags": ["Configuration"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfigurationVariableCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Variable created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigurationVariable" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/configuration/{id}": {
      "put": {
        "operationId": "updateConfigurationVariable",
        "summary": "Update a configuration variable",
        "description": "Updates an existing configuration variable.",
        "tags": ["Configuration"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfigurationVariableCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Variable updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigurationVariable" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "operationId": "deleteConfigurationVariable",
        "summary": "Delete a configuration variable",
        "description": "Deletes a configuration variable.",
        "tags": ["Configuration"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Variable deleted" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/teams": {
      "get": {
        "operationId": "listTeams",
        "summary": "List teams",
        "description": "Returns all teams in the organization.",
        "tags": ["Teams"],
        "parameters": [
          { "name": "organizationId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of teams",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Team" } }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createTeam",
        "summary": "Create a team",
        "description": "Creates a new team in the organization.",
        "tags": ["Teams"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "organizationId"],
                "properties": {
                  "name": { "type": "string" },
                  "organizationId": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Team created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Team" } } } },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/notifications/endpoints": {
      "get": {
        "operationId": "listNotificationEndpoints",
        "summary": "List notification endpoints",
        "description": "Returns all notification endpoints for the organization.",
        "tags": ["Notifications"],
        "parameters": [
          { "name": "organizationId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of notification endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "value": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api-keys": {
      "get": {
        "operationId": "listApiKeys",
        "summary": "List API keys",
        "description": "Returns all API keys for the organization.",
        "tags": ["API Keys"],
        "parameters": [
          { "name": "organizationId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of API keys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" },
                      "apiKeyId": { "type": "string" },
                      "organizationId": { "type": "string" },
                      "organizationRole": { "type": "string" },
                      "createdAt": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "createApiKey",
        "summary": "Create an API key",
        "description": "Creates a new API key for programmatic access.",
        "tags": ["API Keys"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "organizationId", "organizationRole"],
                "properties": {
                  "name": { "type": "string" },
                  "organizationId": { "type": "string" },
                  "organizationRole": { "type": "string", "enum": ["Admin", "User", "Viewer"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiKeyId": { "type": "string" },
                    "apiKeySecret": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Authentication using API Key ID as username and API Key Secret as password."
      }
    },
    "schemas": {
      "Environment": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organizationId": { "type": "string" },
          "projectId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["CREATED", "INACTIVE", "ACTIVE", "FAILED", "TIMEOUT", "WAITING_FOR_USER", "DEPLOY_IN_PROGRESS", "DESTROY_IN_PROGRESS", "ABORTING", "NEVER_DEPLOYED"]
          },
          "latestDeploymentLog": { "$ref": "#/components/schemas/DeploymentLog" },
          "isArchived": { "type": "boolean" },
          "isLocked": { "type": "boolean" },
          "requiresApproval": { "type": "boolean" },
          "driftStatus": { "type": "string", "enum": ["OK", "DRIFTED", "ERROR", "DISABLED", "NEVER_RUN"] },
          "workspaceName": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "EnvironmentCreate": {
        "type": "object",
        "required": ["name", "projectId"],
        "properties": {
          "name": { "type": "string" },
          "projectId": { "type": "string", "minLength": 1 },
          "deployRequest": { "$ref": "#/components/schemas/DeployRequest" },
          "workspaceName": { "type": "string" },
          "requiresApproval": { "type": "boolean" },
          "ttl": { "$ref": "#/components/schemas/TTL" },
          "continuousDeployment": { "type": "boolean" },
          "pullRequestPlanDeployments": { "type": "boolean" },
          "k8sNamespace": { "type": "string" },
          "isRemoteBackend": { "type": "boolean" }
        }
      },
      "EnvironmentUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "requiresApproval": { "type": "boolean" },
          "ttl": { "$ref": "#/components/schemas/TTL" },
          "continuousDeployment": { "type": "boolean" },
          "pullRequestPlanDeployments": { "type": "boolean" }
        }
      },
      "DeployRequest": {
        "type": "object",
        "properties": {
          "blueprintId": { "type": "string" },
          "blueprintRevision": { "type": "string" },
          "blueprintRepository": { "type": "string" },
          "deploymentType": { "type": "string", "enum": ["deploy", "prPlan", "driftDetection", "task", "remotePlan", "dryRun", "moduleTest"] },
          "configurationChanges": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ConfigurationVariable" }
          },
          "ttl": { "$ref": "#/components/schemas/TTL" },
          "comment": { "type": "string" },
          "userRequiresApproval": { "type": "boolean" },
          "targets": { "type": "array", "items": { "type": "string" } }
        }
      },
      "DeploymentLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "environmentId": { "type": "string" },
          "status": { "type": "string", "enum": ["QUEUED", "IN_PROGRESS", "SUCCESS", "FAILURE", "TIMEOUT", "CANCELLED", "WAITING_FOR_USER", "ABORTING", "ABORTED", "SKIPPED"] },
          "type": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "startedBy": { "type": "string" },
          "startedByUser": { "$ref": "#/components/schemas/User" },
          "blueprintId": { "type": "string" },
          "blueprintRevision": { "type": "string" },
          "blueprintRepository": { "type": "string" },
          "output": { "type": "object" },
          "error": { "type": "string" },
          "planSummary": { "type": "object" }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organizationId": { "type": "string" },
          "description": { "type": "string" },
          "hierarchy": { "type": "string" },
          "parentProjectId": { "type": "string" },
          "isArchived": { "type": "boolean" },
          "createdBy": { "type": "string" },
          "createdByUser": { "$ref": "#/components/schemas/User" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": ["name", "organizationId"],
        "properties": {
          "name": { "type": "string" },
          "organizationId": { "type": "string" },
          "description": { "type": "string" },
          "parentProjectId": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Template": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "organizationId": { "type": "string" },
          "repository": { "type": "string" },
          "revision": { "type": "string" },
          "path": { "type": "string" },
          "fileName": { "type": "string" },
          "type": { "type": "string", "enum": ["terraform", "opentofu", "terragrunt", "pulumi", "k8s", "cloudformation", "helm", "ansible", "module", "workflow", "approval-policy", "custom-flow"] },
          "terraformVersion": { "type": "string" },
          "opentofuVersion": { "type": "string" },
          "terragruntVersion": { "type": "string" },
          "pulumiVersion": { "type": "string" },
          "projectIds": { "type": "array", "items": { "type": "string" } },
          "sshKeys": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
          "author": { "$ref": "#/components/schemas/User" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "isDeleted": { "type": "boolean" },
          "isSingleUse": { "type": "boolean" }
        }
      },
      "TemplateCreate": {
        "type": "object",
        "required": ["name", "organizationId", "repository", "type"],
        "properties": {
          "name": { "type": "string" },
          "organizationId": { "type": "string" },
          "repository": { "type": "string" },
          "type": { "type": "string", "enum": ["terraform", "opentofu", "terragrunt", "pulumi", "k8s", "cloudformation", "helm", "ansible", "module", "workflow", "approval-policy", "custom-flow"] },
          "description": { "type": "string" },
          "revision": { "type": "string" },
          "path": { "type": "string" },
          "fileName": { "type": "string" },
          "terraformVersion": { "type": "string" },
          "opentofuVersion": { "type": "string" },
          "projectIds": { "type": "array", "items": { "type": "string" } },
          "sshKeys": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
          "githubInstallationId": { "type": "integer" },
          "bitbucketClientKey": { "type": "string" },
          "vcsConnectionId": { "type": "string" }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "createdBy": { "type": "string" },
          "role": { "type": "string" },
          "isSelfHostedK8s": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ConfigurationVariable": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "value": { "type": "string" },
          "isSensitive": { "type": "boolean" },
          "scope": { "type": "string", "enum": ["GLOBAL", "BLUEPRINT", "PROJECT", "ENVIRONMENT", "DEPLOYMENT", "WORKFLOW"] },
          "type": { "type": "integer", "description": "0 = environment variable, 1 = terraform variable" },
          "organizationId": { "type": "string" },
          "projectId": { "type": "string" },
          "environmentId": { "type": "string" },
          "isReadOnly": { "type": "boolean" },
          "isRequired": { "type": "boolean" }
        }
      },
      "ConfigurationVariableCreate": {
        "type": "object",
        "required": ["name", "value", "scope", "scopeId", "type"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "isSensitive": { "type": "boolean" },
          "scope": { "type": "string", "enum": ["GLOBAL", "BLUEPRINT", "PROJECT", "ENVIRONMENT", "DEPLOYMENT", "WORKFLOW"] },
          "scopeId": { "type": "string" },
          "type": { "type": "integer" },
          "isReadOnly": { "type": "boolean" },
          "isRequired": { "type": "boolean" }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organizationId": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "TTL": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["INFINITE", "HOURS", "DATE"] },
          "value": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "user_id": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      }
    }
  }
}