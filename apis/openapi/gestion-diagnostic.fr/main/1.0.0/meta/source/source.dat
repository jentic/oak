    "/compte_client/gestion-contact": {
      "post": {
        "tags": [
          "Clients"
        ],
        "summary": "Gestion des contacts",
        "description": "Gestion des contacts associ\u00e9s \u00e0 un compte client",
        "operationId": "gestionContact",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GestionContactRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Op\u00e9ration r\u00e9ussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
