          },
          "toujours_debloquer_rapport": {
            "type": "integer",
            "default": 0
          },
          "ne_pas_demander_reglement": {
            "type": "integer",
            "default": 0
          },
          "facturation_mensualisee": {
            "type": "integer",
            "default": 0
          },
          "commentaire_client": {
            "type": "string"
          },
          "tag_ID": {
            "type": "integer",
            "nullable": true
          },
          "ref_client_etat_demarchage_ID": {
            "type": "integer",
            "nullable": true
          },
          "envoi_espace_client": {
            "type": "boolean",
            "default": false
          },
          "envoi_signature_vip": {
            "type": "boolean",
            "default": false
          },
          "envoi_mail_presentation": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ModificationClientRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NouveauClientRequest"
          },
          {
            "type": "object",
            "required": [
              "ID"
            ],
            "properties": {
              "ID": {
                "type": "integer"
              },
              "acces_compte_client": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "GestionContactRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "liste",
              "get_info",
              "ajout",
              "modif",
              "delete"
            ]
          },
          "ID": {
            "type": "integer",
            "description": "ID du contact (pour modif, delete)"
          },
          "compte_client_ID": {
            "type": "integer",
            "description": "ID du compte client (pour liste, ajout)"
          },
          "nom": {
            "type": "string"
          },
          "tel": {
            "type": "string"
          },
          "mail": {
            "type": "string",
            "format": "email"
          },
          "anniversaire": {
            "type": "string",
            "format": "date"
          },
          "offset": {
            "type": "integer",
            "description": "Pour liste"
          },
          "recherche_general": {
            "type": "string",
            "description": "Pour liste"
          },
          "filter_date_anniversaire": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "Pour liste"
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer"
          },
          "nom": {
            "type": "string"
          },
          "tel": {
            "type": "string"
          },
          "mail": {
            "type": "string",
            "format": "email"
          },
          "anniversaire": {
            "type": "string",
            "format": "date"
          },
          "compte_client_ID": {
            "type": "integer"
          },
          "nom_agence": {
            "type": "string"
          },
          "chiffre_affaire": {
            "type": "number",
            "format": "float"
          },
          "count_rdv": {
            "type": "integer"
          }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer"
          },
          "nom": {
            "type": "string",
            "description": "Nom du tag"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Couleur du tag (format hexad\u00e9cimal)",
            "example": "#3498DB"
          },
          "ref_type_tag_ID": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "Type de tag (1=clients, 2=dossiers, 3=fichiers)"
          },
          "backoffice_ID": {
            "type": "integer"
          }
        }
      },
      "NouveauTagRequest": {
        "type": "object",
        "required": [
          "ref_type_tag_ID",
          "nom",
          "color"
        ],
        "properties": {
          "ref_type_tag_ID": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "Type de tag (1=clients, 2=dossiers, 3=fichiers)"
          },
          "nom": {
            "type": "string",
            "description": "Nom du tag",
            "minLength": 1,
            "example": "VIP"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Couleur du tag (format hexad\u00e9cimal",
            "example": "#9B59B6"
          }
        }
      },
      "ModificationTagRequest": {
        "type": "object",
        "required": [
          "nom",
          "color"
        ],
        "properties": {
          "nom": {
            "type": "string",
            "description": "Nom du tag",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Couleur du tag (format hexad\u00e9cimal"
          }
        }
      },
      "SetUploadTagRequest": {
        "type": "object",
        "required": [
          "ref_type_tag_ID",
          "file_ID",
          "tag_ID",
          "admin"
        ],
        "properties": {
          "ref_type_tag_ID": {
            "type": "integer",
            "enum": [
              3
            ],
            "description": "Type de tag (doit \u00eatre 3 pour fichiers)"
          },
          "file_ID": {
            "type": "integer",
            "description": "ID du fichier dans upload_file"
          },
          "tag_ID": {
            "type": "integer",
            "description": "ID du tag \u00e0 associer"
          },
          "admin": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Visibilit\u00e9 (0=tous, 1=admin uniquement)"
          }
        }
      },
      "SetRdvTagRequest": {
        "type": "object",
        "required": [
          "tag_ID",
          "rdv_id"
        ],
        "properties": {
          "tag_ID": {
            "type": "integer",
            "description": "ID du tag \u00e0 associer (doit \u00eatre un tag de type dossier, ref_type_tag_ID=2)"
          },
          "rdv_id": {
            "type": "integer",
            "description": "ID du dossier/rendez-vous"
          }
        }
      },
      "ListeTechniciensRequest": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "recherche": {
            "type": "string",
            "description": "Recherche globale (nom, soci\u00e9t\u00e9, code postal, t\u00e9l)"
          },
          "filter_date_rdv": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "Plage de dates pour statistiques"
          },
          "filter_salarie": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "1=Tous, 2=Salari\u00e9s, 3=Non salari\u00e9s"
          },
          "filter_actif": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "1=Tous, 2=Actifs, 3=Inactifs"
          }
        }
      },
      "ListeTechniciensResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Technicien"
                }
              }
            }
          }
        ]
      },
      "Technicien": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer"
          },
          "nom": {
            "type": "string"
          },
          "mail": {
            "type": "string",
            "format": "email"
          },
          "code_postal": {
            "type": "string"
          },
          "salarie": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "0=ind\u00e9pendant, 1=salari\u00e9"
          },
          "tel": {
            "type": "string"
          },
          "adresse_pro": {
            "type": "string"
          },
          "nom_societe": {
            "type": "string"
          },
          "rayon_action": {
            "type": "integer",
            "description": "Rayon d'action en km"
          },
          "commission": {
            "type": "number",
            "format": "float",
            "description": "Taux de commission en %"
          },
          "commentaire": {
            "type": "string"
          },
          "ref_departement_IDs": {
            "type": "string",
            "description": "JSON array des num\u00e9ros de d\u00e9partements"
          },
          "active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "backoffice_ID": {
            "type": "integer"
          },
          "sous_traitant_backoffice_ID": {
            "type": "integer",
            "nullable": true
          },
          "utilisateur_ID": {
            "type": "integer",
            "nullable": true
          },
          "nombre_rdv": {
            "type": "integer",
            "description": "Nombre de RDV effectu\u00e9s"
          },
          "chiffre_affaire": {
            "type": "number",
            "format": "float",
            "description": "CA total g\u00e9n\u00e9r\u00e9"
          },
          "montant_encaisse": {
            "type": "number",
            "format": "float",
            "description": "Montant encaiss\u00e9"
          },
          "commission_totale": {
            "type": "number",
            "format": "float",
            "description": "Total des commissions"
          },
          "note_moyenne": {
            "type": "number",
            "format": "float",
            "description": "Note moyenne re\u00e7ue"
          },
          "nombre_notes": {
            "type": "integer",
            "description": "Nombre de notes re\u00e7ues"
          },
          "chiffre_affaire_mission_apporte": {
            "type": "number",
            "format": "float",
            "description": "CA des missions apport\u00e9es"
          }
        }
      },
      "NouveauTechnicienRequest": {
        "type": "object",
        "required": [
          "nom",
          "mail",
          "tel",
          "salarie",
          "active"
        ],
        "properties": {
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "mail": {
            "type": "string",
            "format": "email"
          },
          "code_postal": {
            "type": "string"
          },
          "salarie": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "tel": {
            "type": "string"
          },
          "adresse_pro": {
            "type": "string"
          },
          "nom_societe": {
            "type": "string"
          },
          "rayon_action": {
            "type": "integer",
            "minimum": 0
          },
          "commission": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "commentaire": {
            "type": "string"
          },
          "ref_departement_IDs": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "default": []
          },
          "active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "default": "#3B82F6"
          }
        }
      },
      "ModificationTechnicienRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NouveauTechnicienRequest"
          },
          {
            "type": "object",
            "required": [
              "ID"
            ],
            "properties": {
              "ID": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "Certification": {
