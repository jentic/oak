      "ListeClientsRequest": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "recherche_general": {
            "type": "string",
            "description": "Recherche globale (syntaxe sp\u00e9ciale '>123' pour ID>123)"
          },
          "filter_date_rdv": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "Plage de dates de RDV"
          },
          "filter_statut": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par statuts donneur d'ordre"
          },
