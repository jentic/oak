{
  "openapi": "3.0.3",
  "info": {
    "title": "GestionDiag - OpenAPI 3.0",
    "description": "Les requ\u00eates HTTP doivent inclure dans le header le champs Authorization: Bearer <token>\nLa valeur <token> est obtenue par la requ\u00eate Login dans laquelle doivent \u00eatre ajout\u00e9s au corps de la requ\u00eate le mail et mot de passe de l'utilisateur.\nEn cas d'erreur d'authentification (token invalide ou expir\u00e9), le code http 401 est renvoy\u00e9. Dans ce cas vous devrez g\u00e9n\u00e9rer un nouveau token \u00e0 l'aide de la requ\u00eate Login\nCette documention est encore en cours d'ecriture\nD'autres endpoints seront ajout\u00e9s au fur et \u00e0 mesure.\nDe plus des exemples de r\u00e9ponses seront bient\u00f4t inser\u00e9s \u00e0 chaque requ\u00eate.",
    "contact": {
      "email": "contact@gestion-diagnostic.fr"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CONTACT_125/gestiondiag-api-rendez-vous/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.gestion-diagnostic.fr"
    }
  ],
  "tags": [
    {
      "name": "Dossiers",
      "description": "Gestion des dossiers (rendez-vous et devis)"
    },
    {
      "name": "Clients",
      "description": "Gestion des comptes clients (donneurs d'ordre)"
    },
    {
      "name": "Tags",
      "description": "Gestion des tags/\u00e9tiquettes"
    },
    {
      "name": "Techniciens",
      "description": "Gestion des techniciens et sous-traitants"
    },
    {
      "name": "Login",
      "description": "Authentification et obtention du token"
    },
    {
      "name": "R\u00e9f\u00e9rences",
      "description": "Liste des r\u00e9f\u00e9rences avec leurs IDs"
    },
    {
      "name": "Rapports",
      "description": "Upload et gestion des rapports diagnostics"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/utilisateur/login": {
      "post": {
        "tags": [
          "Login"
        ],
        "summary": "Authentification",
        "description": "Obtenir un token d'authentification pour acc\u00e9der \u00e0 l'API",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentification r\u00e9ussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides"
          }
        }
      }
    },
    "/refs": {
      "get": {
        "tags": [
          "R\u00e9f\u00e9rences"
        ],
        "summary": "Liste des r\u00e9f\u00e9rences",
        "description": "R\u00e9cup\u00e8re toutes les r\u00e9f\u00e9rences n\u00e9cessaires pour cr\u00e9er/modifier des dossiers.\n\nInclut:\n- Types de biens (ref_bien)\n- Types de diagnostics (ref_diagnostique)\n- Types de construction (ref_construction)\n- Plages de surface (ref_surface)\n- Cr\u00e9neaux horaires (ref_creneau)\n- Statuts de num\u00e9ro de lot (ref_numero_de_lot_statut)\n- D\u00e9partements (ref_departement)\n- Sources (ref_source)\n- Et autres r\u00e9f\u00e9rences syst\u00e8me\n",
        "operationId": "getRefs",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des r\u00e9f\u00e9rences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferencesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/upload/{rdv_id}": {
      "get": {
        "tags": [
          "Rapports"
        ],
        "summary": "R\u00e9cup\u00e9rer les rapports",
        "description": "R\u00e9cup\u00e8re tous les fichiers (rapports) associ\u00e9s \u00e0 un dossier",
        "operationId": "getRapports",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "rdv_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID du dossier"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des rapports",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RapportsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Rapports"
        ],
        "summary": "Uploader un rapport",
        "description": "Upload un ou plusieurs fichiers (rapports diagnostics) sur un dossier.\nFormats accept\u00e9s: PDF, images (JPG, PNG)\n",
        "operationId": "uploadRapport",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "rdv_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID du dossier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fichier upload\u00e9 avec succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/upload/{file_id}": {
      "delete": {
        "tags": [
          "Rapports"
        ],
        "summary": "Supprimer un rapport",
        "description": "Supprime un fichier par son ID.\n\n\u26a0\ufe0f Attention: L'ID du fichier est diff\u00e9rent de l'ID du dossier.\nAction irr\u00e9versible.\n",
        "operationId": "deleteRapport",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID du fichier (\u26a0\ufe0f Diff\u00e9rent de l'ID du dossier)"
          }
        ],
        "responses": {
          "200": {
            "description": "Fichier supprim\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/rendez-vous/liste": {
      "post": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Liste des dossiers",
        "description": "R\u00e9cup\u00e8re la liste filtr\u00e9e des dossiers avec pagination",
        "operationId": "listeDossiers",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListeDossiersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Liste r\u00e9cup\u00e9r\u00e9e avec succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListeDossiersResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/rendez-vous/": {
      "post": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Nouveau Dossier",
        "description": "Cr\u00e9ation de rendez-vous/devis",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SecurityToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/NouveauDossierRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Op\u00e9ration r\u00e9ussie",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/NouveauDossierResponse"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/rendez-vous/{id}": {
      "get": {
        "tags": [
          "Dossiers"
        ],
        "summary": "R\u00e9cup\u00e8re un dossier par son ID",
        "description": "R\u00e9cup\u00e8re les d\u00e9tails d'un dossier",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID du dossier"
          }
        ],
        "responses": {
          "200": {
            "description": "Dossier r\u00e9cup\u00e9r\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Archive un dossier",
        "description": "Archive un dossier et cr\u00e9e un avoir si n\u00e9cessaire",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID du dossier"
          }
        ],
        "responses": {
          "200": {
            "description": "Dossier supprim\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/rendez-vous/modification": {
      "post": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Modifie un dossier",
        "description": "Modifie et met \u00e0 jour le suivi client",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SecurityToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModificationDossierRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dossier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/rendez-vous/read": {
      "post": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Marque un dossier comme lu/non lu",
        "description": "Met \u00e0 jour le statut de lecture d'un dossier",
        "operationId": "marquerLu",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ID",
                  "read"
                ],
                "properties": {
                  "ID": {
                    "type": "integer",
                    "description": "ID du dossier"
                  },
                  "read": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "1 pour lu, 0 pour non lu"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Statut mis \u00e0 jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rendez-vous/duplication": {
      "post": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Duplique un dossier",
        "description": "Cr\u00e9e une copie d'un dossier existant",
        "operationId": "duplicationDossier",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ID"
                ],
                "properties": {
                  "ID": {
                    "type": "integer",
                    "description": "ID du dossier \u00e0 dupliquer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dossier dupliqu\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NouveauDossierResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rendez-vous/mail-technicien": {
      "post": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Envoie mail au technicien",
        "description": "Envoie le mail de mission au technicien assign\u00e9",
        "operationId": "mailTechnicien",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "rdv_id"
                ],
                "properties": {
                  "rdv_id": {
                    "type": "integer",
                    "description": "ID du dossier"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mail envoy\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rendez-vous/demande-de-rappel": {
      "post": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Demande de rappel",
        "description": "Enregistre une demande de rappel client",
        "operationId": "demandeRappel",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Demande enregistr\u00e9e",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rendez-vous/gestion-rdv": {
      "put": {
        "tags": [
          "Dossiers"
        ],
        "summary": "Gestion de la date de rendez-vous",
        "description": "Permet de modifier ou supprimer la date d'un rendez-vous.\n\nActions disponibles:\n- `modifier_date_et_creneau`: Modifie la date et le cr\u00e9neau d'un dossier. Si le dossier est un devis, il devient un RDV.\n- `supprimer_date_rdv`: Supprime la date du rendez-vous (le transforme en devis). Supprime \u00e9galement l'\u00e9v\u00e9nement du calendrier Google.\n",
        "operationId": "gestionDateRdv",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ModifierDateCreneauRequest"
                  },
                  {
                    "$ref": "#/components/schemas/SupprimerDateRdvRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Op\u00e9ration r\u00e9ussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/compte_client/listeClients": {
      "post": {
        "tags": [
          "Clients"
        ],
        "summary": "Liste des clients",
        "description": "R\u00e9cup\u00e8re la liste filtr\u00e9e des comptes clients avec pagination",
        "operationId": "listeClients",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListeClientsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Liste r\u00e9cup\u00e9r\u00e9e avec succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListeClientsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/compte_client/infos": {
      "get": {
        "tags": [
          "Clients"
        ],
        "summary": "Informations client",
        "description": "R\u00e9cup\u00e8re les informations d'un client par son email",
        "operationId": "infosClient",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "mail_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Email du client"
          }
        ],
        "responses": {
          "200": {
            "description": "Client r\u00e9cup\u00e9r\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          }
        }
      }
    },
    "/compte_client/ajout": {
      "post": {
        "tags": [
          "Clients"
        ],
        "summary": "Cr\u00e9er un client",
        "description": "Cr\u00e9e un nouveau compte client et son contact principal",
        "operationId": "ajoutClient",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
