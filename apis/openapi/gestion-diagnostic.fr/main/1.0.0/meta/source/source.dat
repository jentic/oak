          "date_obtention": {
            "type": "string",
            "format": "date"
          },
          "date_expiration": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ModificationCertifRequest": {
        "type": "object",
        "required": [
          "diagnostic_ID"
        ],
        "properties": {
          "diagnostic_ID": {
            "type": "integer"
          },
          "date_obtention": {
            "type": "string",
            "format": "date"
          },
          "date_expiration": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "mail",
          "password"
        ],
        "properties": {
          "mail": {
            "type": "string",
            "format": "email",
            "example": "hello@test.fr"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Mon-mot-de-passe"
          }
        }
      },
      "LoginResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Token JWT \u00e0 utiliser dans le header Authorization"
                  },
                  "utilisateur_ID": {
                    "type": "integer"
                  },
                  "backoffice_ID": {
                    "type": "integer"
                  },
                  "nom": {
                    "type": "string"
                  },
                  "mail": {
                    "type": "string"
                  },
                  "ref_permission_ID": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        ]
      },
      "ReferencesResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "ref_bien": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Types de biens"
                  },
                  "ref_diagnostique": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Types de diagnostics"
                  },
                  "ref_construction": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "P\u00e9riodes de construction"
                  },
                  "ref_surface": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Plages de surface"
                  },
                  "ref_creneau": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Creneau"
                    },
                    "description": "Cr\u00e9neaux horaires"
                  },
                  "ref_numero_de_lot_statut": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Statuts de num\u00e9ro de lot"
                  },
                  "ref_departement": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Departement"
                    },
                    "description": "D\u00e9partements"
                  },
                  "ref_source": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Sources de contact"
                  },
                  "ref_transaction": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Types de transaction"
                  },
                  "ref_annexe": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Types d'annexes"
                  },
                  "ref_statut_donneur_ordre": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "description": "Statuts donneur d'ordre"
                  }
                }
              }
            }
          }
        ]
      },
      "Reference": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer"
          },
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Departement": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer"
          },
          "numero": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          }
        }
      },
      "Creneau": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer"
          },
          "nom": {
            "type": "string",
            "description": "Nom du cr\u00e9neau horaire",
            "example": "Matin (8h-12h)"
          },
          "heure_debut": {
            "type": "string",
            "description": "Heure de d\u00e9but",
            "example": "08:00"
          },
          "heure_fin": {
            "type": "string",
            "description": "Heure de fin",
            "example": "12:00"
          }
        }
      },
      "RapportsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Rapport"
                }
              }
            }
          }
        ]
      },
      "Rapport": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "description": "ID du fichier"
          },
          "nom": {
            "type": "string",
            "description": "Nom du fichier"
          },
          "path": {
            "type": "string",
            "description": "Chemin d'acc\u00e8s au fichier"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL compl\u00e8te du fichier"
          },
          "type": {
            "type": "string",
            "description": "Type MIME du fichier"
          },
          "size": {
            "type": "integer",
            "description": "Taille du fichier en octets"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "description": "Date d'upload"
          },
          "tag_ID": {
            "type": "integer",
            "nullable": true,
            "description": "ID du tag associ\u00e9"
          },
          "admin_only": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Fichier visible uniquement par les admins"
          }
        }
      },
      "UploadRequest": {
        "type": "object",
        "properties": {
          "rapport_diagnostic": {
            "type": "string",
            "format": "binary",
            "description": "Fichier \u00e0 uploader (PDF et images uniquement)"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Non autoris\u00e9 - Token invalide ou manquant",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Unauthorized"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Ressource non trouv\u00e9e",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Not found"
                }
              }
            }
          }
        }
      }
    }
  }
}