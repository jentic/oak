  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token d'authentification utilisateur (HTTP_TOKEN header)"
      },
      "SecurityToken": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "Token de s\u00e9curit\u00e9 pour acc\u00e8s public s\u00e9curis\u00e9"
      }
    },
    "schemas": {
      "ListeDossiersRequest": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Offset de pagination"
          },
          "archive": {
            "type": "boolean",
            "default": false,
            "description": "Filtre les dossiers archiv\u00e9s"
          },
          "read": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Filtre par statut de lecture (0=non lu, 1=lu)"
          },
          "recherche_general": {
            "type": "string",
            "description": "Recherche globale dans tous les champs"
          },
          "filter_date_rdv": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "Plage de dates de rendez-vous [date_debut, date_fin]"
          },
          "filter_date_creation": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "Plage de dates de cr\u00e9ation [date_debut, date_fin]"
          },
          "filter_date_paiement": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "Plage de dates de paiement [date_debut, date_fin]"
          },
          "filter_date_facturation": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "Plage de dates de facturation [date_debut, date_fin]"
          },
          "filter_prix": {
            "type": "string",
            "description": "Filtre par prix (recherche LIKE)"
          },
          "filter_num_facture": {
            "type": "string",
            "description": "Filtre par num\u00e9ro de facture"
          },
          "filter_code_postal": {
            "type": "string",
            "description": "Filtre par code postal"
          },
          "filter_adresse": {
            "type": "string",
            "description": "Filtre par adresse"
          },
          "filter_ref_dossier": {
            "type": "string",
            "description": "Filtre par r\u00e9f\u00e9rence du dossier"
          },
          "filter_ID": {
            "type": "integer",
            "description": "Filtre par ID du dossier"
          },
          "filter_proprietaire": {
            "type": "string",
            "description": "Filtre par nom ou t\u00e9l\u00e9phone du propri\u00e9taire"
          },
          "filter_reception": {
            "type": "string",
            "description": "Filtre par nom ou t\u00e9l\u00e9phone de la personne qui re\u00e7oit"
          },
          "filter_donneur_ordre": {
            "type": "string",
            "description": "Filtre par donneur d'ordre (nom, t\u00e9l\u00e9phone, agence, email)"
          },
          "filter_facturation": {
            "type": "string",
            "description": "Filtre par informations de facturation"
          },
          "filter_dernier_rdv": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1=Aujourd'hui, 2=Ce mois"
          },
          "filter_tag": {
            "type": "integer",
            "description": "Filtre par tag"
          },
          "filter_source": {
            "type": "integer",
            "description": "Filtre par source (ref_source_ID)"
          },
          "filter_transaction": {
            "type": "integer",
            "description": "Filtre par type de transaction"
          },
          "filter_cree_par": {
            "type": "integer",
            "description": "Filtre par utilisateur cr\u00e9ateur"
          },
          "filter_rdv_devis": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1=RDV uniquement, 2=Devis sans RDV, 3=RDV \u00e0 fixer, 4=R\u00e9clamations"
          },
          "filter_dossier_complet": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "1=Complets \u00e0 envoyer, 2=Suivi incomplet, 3=Dossier incomplet"
          },
          "filter_diagnostic_pret": {
            "type": "boolean",
            "description": "Diagnostic pr\u00eat mais non envoy\u00e9"
          },
          "filter_devis_facture": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1=Factur\u00e9s, 2=Non factur\u00e9s"
          },
          "filter_rdv_copie": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1=Originaux, 2=Copies"
          },
          "filter_mail_facture": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1=Avec email facturation, 2=Sans email"
          },
          "filter_devis_signe": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1=Sign\u00e9s, 2=Non sign\u00e9s"
          },
          "filter_consentement_dpe": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "1=Sign\u00e9 avec consentement, 2=Sign\u00e9 sans consentement, 3=Non sign\u00e9"
          },
          "filter_devis_envoye": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1=Envoy\u00e9s, 2=Non envoy\u00e9s"
          },
          "filter_lettre_dpe": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par lettres DPE (IDs)"
          },
          "filter_bien": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par types de bien (IDs)"
          },
          "filter_origine": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par origines (ref_rdv_origine_ID)"
          },
          "filter_dossier_envoye": {
            "type": "array",
            "items": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            },
            "description": "1=Non envoy\u00e9, 2=Pr\u00eat mais non envoy\u00e9, 3=Envoy\u00e9"
          },
          "filter_facture": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par statut de facturation (ref_statut_donneur_ordre_ID)"
          },
          "filter_do_statut": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par statut du donneur d'ordre"
          },
          "filter_technicien": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par techniciens (IDs)"
          },
          "filter_envoye_par": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Filtrer par utilisateur cr\u00e9ateur (IDs)"
          },
          "filter_paiement": {
            "type": "integer",
            "description": "Filtre par type de paiement (25=impay\u00e9s)"
          },
          "date_rdv_ordre": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "Tri par date de RDV (1=ASC, 2=DESC)"
          },
          "date_creation_ordre": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "Tri par date de cr\u00e9ation (1=ASC, 2=DESC)"
          },
          "code_postal_ordre": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "Tri par code postal (1=ASC, 2=DESC)"
          },
          "prix_ordre": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "Tri par prix (1=ASC, 2=DESC)"
          },
          "extrait_facture": {
            "type": "boolean",
            "description": "Mode export de factures"
          }
        }
      },
      "ListeDossiersResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StandardResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "rdvs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Dossier"
